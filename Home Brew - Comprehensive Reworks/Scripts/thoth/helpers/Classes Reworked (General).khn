    local entity = entity or context.Target
	return HasAnyStatus({'FAERIE_FIRE','HIDEOUS_LAUGHTER','HOLD_MONSTER','HOLD_PERSON','HUNTERS_MARK','HYPNOTIC_PATTERN','PARALYZED','STUNNED','SURPRISED','IRRESISTIBLE_DANCE','HUNTED','DAZED','DISTRACTED','FRIGHTENED','FEARED','ENTHRALL','MAG_PSYCHIC_MENTAL_FATIGUE','MIND_SLIVER','MIND_SPIKE','INTIMIDATING_PRESENCE','MOTH_DISTRACTED','MOTH_DISTRACTED_STORM','DAMAGEREDUCTION_DISABLED'}, {}, {}, entity)
end

