function HiddenStrikesCheck()
	return HasStringInSpellRoll('MeleeWeaponAttack') & ~HasUseCosts('ReactionActionPoint') & ~NumberOfTargetsGreaterThan(1) & ~AreaRadiusGreaterThan(0) & SpellId('Target_MainHandAttack')
end

function IsAbilityInterruptInteresting(ability, entity)
    local entity = entity or context.Target

    if context.InterruptedRoll.RollCritical ~= RollCritical.None then
        return ConditionResult(false, {ConditionError("IsCriticalFailSuccess")})
    end

    local score = 10

    if ability == "Strength" then
        score = context.Observer.Strength
    elseif ability == "Dexterity" then
        score = context.Observer.Dexterity
    elseif ability == "Constitution" then
        score = context.Observer.Constitution
    elseif ability == "Intelligence" then
        score = context.Observer.Intelligence
    elseif ability == "Wisdom" then
        score = context.Observer.Wisdom
    elseif ability == "Charisma" then
        score = context.Observer.Charisma
    end

    local modifier = math.floor((score - 10) / 2)

    local rollSuccess = context.InterruptedRoll.Total >= context.InterruptedRoll.Difficulty

    if Enemy(context.Observer, entity).Result then
        return ConditionResult(
            rollSuccess and
            ((context.InterruptedRoll.Total - context.InterruptedRoll.Difficulty) < modifier)
        )
    end

    return ConditionResult(
        not rollSuccess and
        ((context.InterruptedRoll.Difficulty - context.InterruptedRoll.Total) <= modifier)
    )
end

function IsAetherSuspended(entity)
    local entity = entity or context.Target
	return HasAnyStatus({'SG_Sleeping_Magical'}, {}, {}, entity)
end

