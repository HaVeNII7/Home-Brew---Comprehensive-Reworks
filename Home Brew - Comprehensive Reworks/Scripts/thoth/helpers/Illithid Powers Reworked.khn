function FreecastCheck()
    return HasUseCosts('Rage')
        | HasUseCosts('BardicInspiration')
        | HasUseCosts('ChannelDivinity')
        | HasUseCosts('WildShape')
        | HasUseCosts('LuckPointCat')
        | HasUseCosts('WildShapeRage')
        | HasUseCosts('FungalInfestationCharge')
        | HasUseCosts('StarMapPoint')
        | HasUseCosts('CosmicOmen')
        | HasUseCosts('SuperiorityDie')
        | HasUseCosts('KiPoint')
        | HasUseCosts('ChannelOath')
        | HasUseCosts('WarPriestActionPoint')
        | HasUseCosts('NaturalRecoveryPoint')
        | HasUseCosts('LuckPoint')
        | HasUseCosts('SorceryPoint')
        | HasUseCosts('WarlockSpellSlot')
        | HasUseCosts('ChainedBonds')
        | HasUseCosts('ArcaneRecoveryPoint')
        | HasUseCosts('FirearmAmmo')
        | HasUseCosts('InfusionSlots')
        | HasUseCosts('SpellSlot')
end
function HasLessHPThanTadpolePowersX4(target, source)
    target = target or context.Target
    source = source or context.Source

    local value = GetTadpolePowersNumber(source) - 1

    if value < 0 then
        value = 0
    elseif value > 25 then
        value = 25
    end

    value = value * 4

    return ConditionResult(target.HP <= value)
end

function TadpolePowersAtLeast(value)
    local result = GetTadpolePowersNumber(context.Source) >= value
    return ConditionResult(result)
end
