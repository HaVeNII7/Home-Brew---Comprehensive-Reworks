		VoiceBarkEnded((VOICEBARKRESOURCE)CAMP_DarkUrge_MurderOfAlfira_GD_IVB_MorningAfter_bfabc085-fb40-4147-e0e3-ef13229f5382, _)
		AND
		DB_ORI_DarkUrge_AlfiraMurderVictim((CHARACTER)S_DEN_Bard_4a405fba-3000-4c63-97e5-a8001ebb883c)
		AND
		DB_GlobalFlag((FLAG)ORI_DarkUrge_State_SuspectedAlfiraMurder_7ef11fbd-70d6-74d7-2679-8d062cd9c3e8)
		AND
		DB_ORI_DarkUrge(_Urge)
		THEN
		SetFlag(TG_DarkUrge_AlfiraMurder_1a1b66f8-68f7-403b-8939-2feae6819e95, _Urge, 0);
		
		
		//END_REGION
		
		//REGION Severing Gale's hand
		
		IF
		FlagSet((FLAG)ORI_DarkUrge_State_HackedGale_a18d0203-6c1e-b758-242a-c01c60b243a6, _, _)
		AND
		DB_ORI_DarkUrge(_DarkUrge)
		THEN
		TemplateAddTo(UNI_LOOT_Darkurge_Gale_Severed_Hand_c8fa7c2f-d34a-4b42-a4fa-c2476fab6c92, _DarkUrge, 1, 1);
		
		IF
		TemplateAddedTo((ROOT)UNI_LOOT_Darkurge_Gale_Severed_Hand_c8fa7c2f-d34a-4b42-a4fa-c2476fab6c92,_Hand,_,_)
		THEN
		DB_ORI_DarkUrge_GaleHand((ITEM)_Hand);
		
		//END_REGION
		
		//REGION Journal
		
		IF
		FlagSet((FLAG)ORI_DarkUrge_State_MurderedAlfiraOrAlternative_6bb5bfcc-e762-40d4-a05b-9bdf860ba099, _, _)
		AND
		DB_ORI_DarkUrge_AlfiraMurderVictim((CHARACTER)S_DEN_Bard_4a405fba-3000-4c63-97e5-a8001ebb883c)
		AND
		DB_ORI_DarkUrge(_DarkUrge)
		THEN
		QuestUpdate(_DarkUrge, "ORI_Avatar_DarkUrge", "KilledAlfira");
		
		IF
		FlagSet((FLAG)ORI_DarkUrge_State_MurderedAlfiraOrAlternative_6bb5bfcc-e762-40d4-a05b-9bdf860ba099, _, _)
		AND
		DB_ORI_DarkUrge_AlfiraMurderVictim((CHARACTER)S_DEN_Bard_Backup_8ef4c8ea-317d-4539-aa5b-c5e899cf0f31)
		AND
		DB_ORI_DarkUrge(_DarkUrge)
		THEN
		QuestUpdate(_DarkUrge, "ORI_Avatar_DarkUrge", "KilledBardBackup");
		
		IF
		FlagSet((FLAG)ORI_DarkUrge_State_ButlerMurderedAlfiraOrAlternative_0e8eb8c5-c5ce-4878-9cf9-4567ba37902a, _, _)
		AND
		DB_ORI_DarkUrge_AlfiraMurderVictim((CHARACTER)S_DEN_Bard_4a405fba-3000-4c63-97e5-a8001ebb883c)
		AND
		DB_ORI_DarkUrge(_DarkUrge)
		THEN
		QuestUpdate(_DarkUrge, "ORI_Avatar_DarkUrge", "FailedKillAlfira");
		
		IF
		DialogEnded((DIALOGRESOURCE)CAMP_FirstNight_AvD_PostEA_69e79939-6148-1b93-d654-e54374ef9353, _ID)
		AND
		DB_DialogPlayers(_ID, _DarkUrge, _)
		AND
		DB_ORI_DarkUrge((CHARACTER)_DarkUrge)
		THEN
		QuestUpdate(_DarkUrge, "ORI_Avatar_DarkUrge", "FirstNight");
		
		
		//END_REGION
	}
	EXIT
	{
	}
}
