	}
	KB
	{
		//REGION Nymph-s Grotto Room
		IF
		DB_WYR_SharessCaress_NymphRoom_SceneCharacters((CHARACTER)_Character)
		THEN
		DB_DoNotFaceDialog(_Character, WYR_SharessCaress_NymphRoom_ThreeWay_NymphFlamingFist_35797ab0-20f8-8cff-896b-ad042cf735fb);
		DB_SceneManager(_Character, "WYR_NymphRoom_Scene");
		DB_SpotPlayers(_Character, "WYR_NymphRoom_Scene", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		DB_SpotPlayers_SpotTrigger(_Character, "WYR_NymphRoom_Scene", S_WYR_SharessCaress_NympRoom_StartTrigger_f08a2fe7-6f76-496b-8c1e-e5c45aca5c26);
		
		PROC
		PROC_SpotPlayers_Spotted(_Spotter, "WYR_NymphRoom_Scene", _Player)
		AND
		NOT QRY_StartDialog(
			WYR_SharessCaress_NymphRoom_ThreeWay_NymphFlamingFist_35797ab0-20f8-8cff-896b-ad042cf735fb,
			S_WYR_SharessCaress_NymphRoom_Nymph_bc3a5dac-3179-4a7c-bd3f-1391eb6d5497,
			S_WYR_SharessCaress_NymphRoom_FlamingFist_b5cb7f36-6ab8-48fb-9ddb-0bcb67807e44,
			S_WYR_SharessCaress_NymphRoom_NetherbrainFlamingFist_a19ad7b2-ef28-4d85-a422-c8abd6fecfc8,
			_Player)
		THEN
		PROC_WYR_SharessCaress_NymphRoomTransform();
		
		PROC
		PROC_SceneInterrupted(_,_,"WYR_NymphRoom_Scene", _Interruption)
		AND
		DB_GLO_GenericSceneManager_ViolenceReason(_Interruption)
		THEN
		PROC_WYR_SharessCaress_NymphRoomTransform();
		
		IF
		DialogEnded(WYR_SharessCaress_NymphRoom_ThreeWay_NymphFlamingFist_35797ab0-20f8-8cff-896b-ad042cf735fb, _)
		THEN
		PROC_WYR_SharessCaress_NymphRoomTransform();
		
		IF
		FlagSet((FLAG)WYR_SharessCaress_NymphRoom_Event_Transformation_a5da5f30-e8fb-1e5e-45d3-9ad1fbb51798,_,_)
		THEN
		PROC_WYR_SharessCaress_NymphRoomTransform();
		
		IF
		FlagSet((FLAG)WYR_SharessCaress_NymphRoom_Event_Transformation_a5da5f30-e8fb-1e5e-45d3-9ad1fbb51798,_,_)
		THEN
		PROC_GlobalClearFlagAndCache(WYR_SharessCaress_NymphRoom_Event_Transformation_a5da5f30-e8fb-1e5e-45d3-9ad1fbb51798);
		
		PROC
		PROC_WYR_SharessCaress_NymphRoomTransform()
		AND
		QRY_OnlyOnce("WYR_NymphRoomTransform_OnlyOnce")
		THEN
		PROC_SceneOver("WYR_NymphRoom_Scene");
		PROC_GlobalSetFlagAndCache(WYR_SharessCaress_NymphRoom_State_Transformed_d3eb0659-c71c-4d59-88fb-e70c68495fb3);
		PROC_TryStopDialogFor(S_WYR_SharessCaress_NymphRoom_FlamingFist_b5cb7f36-6ab8-48fb-9ddb-0bcb67807e44);
		Transform(S_WYR_SharessCaress_NymphRoom_FlamingFist_b5cb7f36-6ab8-48fb-9ddb-0bcb67807e44, Mindflayer_Naked_ede2288a-342d-42ae-8978-34044534a5b0, CEREMORPHOSIS_PLAYER_e6e0499b-c7b7-4f4a-b286-ecede5225ca1);
		PROC_RemoveAllDialogEntriesForSpeaker(S_WYR_SharessCaress_NymphRoom_FlamingFist_b5cb7f36-6ab8-48fb-9ddb-0bcb67807e44);
		PROC_RemoveAllDialogEntriesForSpeaker(S_WYR_SharessCaress_NymphRoom_Nymph_bc3a5dac-3179-4a7c-bd3f-1391eb6d5497);
		DB_Dialogs(S_WYR_SharessCaress_NymphRoom_Nymph_bc3a5dac-3179-4a7c-bd3f-1391eb6d5497,WYR_SharessCaress_NymphRoom_Nymph_77280736-2142-7d35-598c-4ea6babe392a);
		SetFaction(S_WYR_SharessCaress_NymphRoom_FlamingFist_b5cb7f36-6ab8-48fb-9ddb-0bcb67807e44, (FACTION)ACT3_WYR_NymphRoomFlamingFists_Mindflayer_b876063a-a82f-40a4-bc85-85793b6ddf67);
		PROC_GLO_Brainquakes_ShakeGroundAroundCharacter(S_WYR_SharessCaress_NymphRoom_FlamingFist_b5cb7f36-6ab8-48fb-9ddb-0bcb67807e44);
		
		IF
		FlagSet((FLAG)WYR_SharessCaress_NymphRoom_Event_Brainquake_84091ced-b82f-2536-63a9-b1fc2c3f3029,_,_)
		THEN
		PROC_GlobalClearFlagAndCache((FLAG)WYR_SharessCaress_NymphRoom_Event_Brainquake_84091ced-b82f-2536-63a9-b1fc2c3f3029);
		PROC_GLO_Brainquakes_ShakeGroundAroundCharacter(S_WYR_SharessCaress_NymphRoom_FlamingFist_b5cb7f36-6ab8-48fb-9ddb-0bcb67807e44);
		
		IF
		FlagSet(WYR_SharessCaress_NymphRoom_Event_GiveItemReward_374ab492-e536-c80e-7238-875a3fe281df, _Player, _)
		THEN
		QuestUpdate((CHARACTER)_Player, "HIDDEN_BGO_Boosters", "WYR_NymphGrotto_Bliss");
		
		IF
		FlagSet(WYR_SharessCaress_NymphRoom_Event_GiveBuffReward_7476ef6f-e23b-4101-0212-38164415062a, _Player, _)
		THEN
		QuestUpdate((CHARACTER)_Player, "HIDDEN_BGO_Boosters", "WYR_NymphGrotto_Rapture");
		ApplyStatus(_Player, "WYR_NYMPHGROTTO_RAPTURE", -1.0, 1, S_WYR_SharessCaress_Nymph_01_662b787e-d5f1-4bd2-b398-36961bda0ab4);
		
		// Debug
		IF
		TextEvent("WYR_SharessCaress_KillMindFlayer")
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_SharessCaress_NymphRoom_Transformation_a5da5f30-e8fb-1e5e-45d3-9ad1fbb51798);
		Die(S_WYR_SharessCaress_NymphRoom_FlamingFist_b5cb7f36-6ab8-48fb-9ddb-0bcb67807e44,DEATHTYPE.DoT,NULL_00000000-0000-0000-0000-000000000000,1,1,0.0);
		
		IF
		TextEvent("WYR_SharessCaress_KillMindFlayer")
		AND
		DB_Dead(S_WYR_SharessCaress_NymphRoom_Nymph_bc3a5dac-3179-4a7c-bd3f-1391eb6d5497)
		THEN
		Resurrect(S_WYR_SharessCaress_NymphRoom_Nymph_bc3a5dac-3179-4a7c-bd3f-1391eb6d5497);
		PROC_RemoveAllDialogEntriesForSpeaker(S_WYR_SharessCaress_NymphRoom_Nymph_bc3a5dac-3179-4a7c-bd3f-1391eb6d5497);
		DB_Dialogs(S_WYR_SharessCaress_NymphRoom_Nymph_bc3a5dac-3179-4a7c-bd3f-1391eb6d5497, WYR_SharessCaress_NymphRoom_Nymph_77280736-2142-7d35-598c-4ea6babe392a);
		//END_REGION
		
		//REGION Boasting Crooks
		IF
		DB_WYR_BoastingCrooks_Speakers((CHARACTER)_NPC)
		THEN
		DB_SceneManager(_NPC, "WYR_SharessCaress_CrooksScene");
		DB_SceneTriggerManager("WYR_SharessCaress_CrooksScene", WYR_SharessCaress_BoastingCrooks_SceneArea_82bac9a7-ad26-45fc-89c0-dbff4e01d890);
		
		PROC
		PROC_SceneInterrupted(_, _, "WYR_SharessCaress_CrooksScene", _Interruption)
		AND
		_Interruption != "StartedDialog"
		THEN
		PROC_SceneOver("WYR_SharessCaress_CrooksScene");
		
		PROC
		PROC_SceneOver("WYR_SharessCaress_CrooksScene")
		AND
		DB_WYR_BoastingCrooks_Speakers(_Crook)
		AND
		NOT DB_PermaDefeatedOrOffstage(_Crook)
		THEN
		PROC_NotifyWhenReadyToMoveOn(_Crook, "WYR_SharessCaress_CrooksLeaving_Notify");
		
		PROC
		PROC_SceneOver("WYR_SharessCaress_CrooksScene")
		THEN
		PROC_GlobalSetFlagAndCache(WYR_BoastingCrooks_State_Leaving_837d4b7f-b3dc-11ba-f725-2ef927f21916);
		TriggerClearItemsOwner(WYR_SharessCaress_BoastingCrooks_SceneArea_82bac9a7-ad26-45fc-89c0-dbff4e01d890);
		
		PROC
		PROC_ReadyToMoveOn(_Crook, "WYR_SharessCaress_CrooksLeaving_Notify")
		THEN
		PROC_DisappearOutOfSightTo(_Crook, S_WYR_SharessCaress_CrooksExitPoint_57715e29-9538-4c83-a3b5-af813992bafe, "Walk", 0, "");
		
		QRY
		QRY_SelectCustomDialog_AfterGenerics(_NPC, _Player)
		AND
		DB_WYR_BoastingCrooks_Speakers((CHARACTER)_NPC)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_BoastingCrooks_State_MentionedNF_72a3de86-bcf1-7165-d8fd-b217e1ded476)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_BoastingCrooks_State_Leaving_837d4b7f-b3dc-11ba-f725-2ef927f21916)
		AND
		DB_WYR_BoastingCrooks_Speakers(_OtherNPC)
		AND
		_NPC != _OtherNPC
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(_NPC, _OtherNPC)
		THEN
		DB_SelectedDialog(
			WYR_SharessCaress_BoastingCrooks_Threeway_968d248c-af8e-6546-80f4-ba8bd60eea4f,
			S_WYR_SharessCaress_BoastingCrooks_Zhent_b8cc3112-5a9e-4306-b91a-2eb50391fe94,
			S_WYR_SharessCaress_BoastingCrooks_RivingtonRat_59f97331-f6bc-45b5-bf21-03ea4341e99e,
			_Player);
		
		// Clearing if we started the Minsc fight in LOW
		IF
		DB_CurrentLevel("BGO_Main_A")
		AND
		DB_GlobalFlag(LOW_MinscHideout_State_ZhentLeaderEscaping_4333a451-024f-4c41-aea1-7046afdf0b4a)
		AND
		NOT DB_GlobalFlag(WYR_BoastingCrooks_State_Leaving_837d4b7f-b3dc-11ba-f725-2ef927f21916)
		THEN
		PROC_WYR_BoastingCrooks_Clear();
		
		PROC
		PROC_WYR_BoastingCrooks_Clear()
		AND
		DB_WYR_BoastingCrooks_Speakers(_Crook)
		AND
		NOT DB_PermaDefeatedOrOffstage(_Crook)
		THEN
		PROC_SetOnStage(_Crook, 0);
		
		PROC
		PROC_WYR_BoastingCrooks_Clear()
		THEN
		PROC_SceneOver("WYR_SharessCaress_CrooksScene");
		//END_REGION
		
		//REGION Taproom
		// Mamzell
		PROC
		PROC_SpotPlayers_Spotted((CHARACTER)S_WYR_SharessCaress_Mamzell_fff7fecf-d6c0-478d-92fb-3aa854298cd2, "WYR_SharessCaress_Mamzell_WelcomeSpotting", _Player)
		THEN
		LookAtEntity(S_WYR_SharessCaress_Mamzell_fff7fecf-d6c0-478d-92fb-3aa854298cd2, _Player, 2.0);
		PROC_TryStartAD((DIALOGRESOURCE)WYR_SharessCaress_AD_Mamzell_62430b36-9c39-4f5f-f7f6-1c8ca88b0651, S_WYR_SharessCaress_Mamzell_fff7fecf-d6c0-478d-92fb-3aa854298cd2);
		
		IF
		DB_InRegion(_Player, S_WYR_SharessCaress_Mamzell_CancelWelcomeSpotArea_59ac404b-2d8f-4d3c-b93a-f515d8a9b3a4)
		AND
		DB_Sees(S_WYR_SharessCaress_Mamzell_fff7fecf-d6c0-478d-92fb-3aa854298cd2, _Player)
		AND
		QRY_SpotPlayers_IsSpotting(S_WYR_SharessCaress_Mamzell_fff7fecf-d6c0-478d-92fb-3aa854298cd2, "WYR_SharessCaress_Mamzell_WelcomeSpotting")
		THEN
