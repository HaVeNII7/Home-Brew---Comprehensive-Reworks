		DB_GLO_FireBowls(LTS_DUN_Chandelier_A_011_ecbe9f8a-6b0c-4808-b087-1ca46cacb6a6, LTS_DUN_Chandelier_Hinge_A_003_6f4094ea-f3ef-499d-9cd1-d65b4994eddc);
