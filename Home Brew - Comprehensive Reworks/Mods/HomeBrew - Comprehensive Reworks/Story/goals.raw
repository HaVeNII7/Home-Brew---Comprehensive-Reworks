		AND
		DB_AnubisConfigs(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b,_Config)
		AND
		GetAnubisConfig(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b,_Check)
		AND
