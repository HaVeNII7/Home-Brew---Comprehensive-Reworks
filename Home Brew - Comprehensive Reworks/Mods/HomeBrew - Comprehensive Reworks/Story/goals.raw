		THEN
		DB_ExclamationDialog_NeverStop((DIALOGRESOURCE)Test_RelationshipDialog_dbef58ac-27a0-be66-3e67-a5d1dba65325, NULL_00000000-0000-0000-0000-000000000000);
		PROC_RelationshipDialog((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,(DIALOGRESOURCE)Test_RelationshipDialog_dbef58ac-27a0-be66-3e67-a5d1dba65325,(FLAG)NULL_00000000-0000-0000-0000-000000000000,(CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,0);
		
		IF
		TextEvent("wrd3")
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,(DIALOGRESOURCE)ShadowHeart_InParty_95ca3833-09d0-5772-b16a-c7a5e9208fe5,(FLAG)LOW_SorcerousSundries_State_NightOfAradinAttack_680a27a3-c15c-4e8d-8c39-f9bc781c1feb,(CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,0);
		
		IF
		DB_RelationshipDialogsFinished(_Companion,(DIALOGRESOURCE)Test_RelationshipDialog_dbef58ac-27a0-be66-3e67-a5d1dba65325,_Flag)
		THEN
		NOT DB_RelationshipDialogsFinished(_Companion,(DIALOGRESOURCE)Test_RelationshipDialog_dbef58ac-27a0-be66-3e67-a5d1dba65325,_Flag);
		
		
		IF
		TextEvent("skillchecktest")
		AND
		GetHostCharacter(_Player)
		AND
		QRY_StartDialog_Fixed(DIALOGRESOURCEGUID_SkillCheckTest_8fa7e9db-19c6-76a2-ee9c-35ef4a75c7bc,S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba,_Player)
		THEN
		DB_NOOP(1);
		
		IF
		TextEvent("gd")
		AND
		GetHostCharacter(_Player)
		THEN
		StartInteractiveVoiceBark(GroupDiscussion_IVB_c4aa59f6-0865-d21b-b2c0-879c55f3a8ad,_Player);
		
		IF
		TextEvent("igd")
		AND
		GetHostCharacter(_Player)
		AND
		GetTextEventParamUUID(1,_GDDiag)
		THEN
		NOT DB_GroupDiscussion_HasPlayed((VOICEBARKRESOURCE)_GDDiag);
		PROC_GroupDiscussion_InstantStart(_Player,_GDDiag);
		
		IF
		TextEvent("dgd")
		AND
		GetHostCharacter(_Player)
		AND
		GetTextEventParamUUID(1,_GDDiag)
		THEN
		NOT DB_GroupDiscussion_HasPlayed((VOICEBARKRESOURCE)_GDDiag);
		PROC_GroupDiscussion_DelayedStart(_Player,_GDDiag);
		
		IF
		TextEvent("tadpolereaction")
		AND
		GetHostCharacter(_Player)
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)GLO_Tadpole_TrueSoulCorpse_8ceb5646-8c9b-f8f9-cfea-7e6a9f94159e,_Player)
		THEN
		DB_NOOP(1);
		
		IF
		TextEvent("gd3")
		AND
		GetHostCharacter(_Player)
		THEN
		StartInteractiveVoiceBark((VOICEBARKRESOURCE)GLO_Astarion_GD_IVB_VampireRevelation_0b2fc87f-0258-585c-d7f1-f458c0b03c78,_Player);
		
		IF
		TextEvent("gd4")
		AND
		GetHostCharacter(_Player)
		THEN
		StartInteractiveVoiceBark((VOICEBARKRESOURCE)DEN_Apprentice_GD_IVB_Cyanide_298d2a94-2731-8f9a-2e46-adc89b1ee695,_Player);
		
		IF
		Falling(_Item,_)
		THEN
		DB_DEBUG_Falling(_Item);
		
		IF
		TextEvent("showfalling")
		AND
		GetHostCharacter(_Player)
		THEN
		PROC_StopLoopBeamEffect(_Player,"DEBUG_FALLING_ITEM_BEAMS");
		
		IF
		TextEvent("showfalling")
		AND
		GetHostCharacter(_Player)
		AND
		DB_DEBUG_Falling(_Item)
		AND
		GetDistanceTo(_Player,_Item,_Dist)
		AND
		_Dist < 100.0
		THEN
		PROC_LoopBeamEffect(VFX_Script_SCL_BrainPuzzle_Untyped_Beam_01_5d83ff09-90a0-1743-67bd-edfe72068bff,_Player,_Item, "Dummy_HeadFX", "", "DEBUG_FALLING_ITEM_BEAMS", "__ANY__");
		
		IF
		TextEvent("dialogfail")
		AND
		GetHostCharacter(_Player)
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)TEST_Greever_e15eda4c-7c4b-d72f-4cca-0f92a9e9111b,_Player)
		THEN
		PROC_ForceStopDialog(_Player);
	}
	EXIT
	{
	}
}
