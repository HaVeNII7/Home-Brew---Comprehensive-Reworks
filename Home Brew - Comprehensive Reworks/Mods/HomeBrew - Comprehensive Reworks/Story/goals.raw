		DB_HAV_Siege_LowHP((CHARACTER)S_SCL_Drider_Harper_Ranger_000_ce089a64-1a91-4ab0-ac71-a2712680780d,"LowHP",S_HAV_Siege_CombatPos_LowHP_000_e482bfe7-fb79-4a61-9d56-2867fedf920c);
		DB_HAV_Siege_LowHP((CHARACTER)S_SCL_Drider_Harper_Ranger_001_71c140fa-0ebd-4f36-8728-6e28a445a6ff,"LowHP",S_HAV_Siege_CombatPos_LowHP_001_59b6bc7c-f263-4423-8a69-95c653fcefce);
		DB_HAV_Siege_LowHP((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3,"LowHP",S_HAV_Siege_CombatPos_LowHP_002_20966826-c5c0-4a4a-9b53-4adbdffd074f);
	}
	KB
	{
		//REGION DEBUG
		
		IF
		TextEvent("siege_lowhp")
		AND
		DB_HAV_Siege_LowHP(_Harper,_,_)
		THEN
		ApplyStatus(_Harper,"HAV_SELUNEOINTMENT",-1.0,1,NULL_00000000-0000-0000-0000-000000000000);
		
		//END_REGION DEBUG
		
		
		IF
		DB_HAV_Siege_EnemyWaves(_Wave,_Enemy)
		THEN
		//SetCombatGroupID(_Enemy,"8b9709d7-b7b9-47c7-b277-32a6592794d7");
		SetOnStage(_Enemy,0);
		
		
		IF
		DB_PermaDefeated(_NPC)
		AND
		DB_HAV_Siege_NPC_CombatPos((CHARACTER)_NPC)
		THEN
		NOT DB_HAV_Siege_NPC_CombatPos(_NPC);
		
		
		PROC
		PROC_HAV_Siege_FillDBsFromOtherGoals()
		AND
		DB_HAV_TakingIsobel_FlyingGhouls((CHARACTER)_Char)
		THEN
		DB_HAV_Siege_NPCs_Exclude(_Char);
		
		PROC
		PROC_HAV_Siege_FillDBsFromOtherGoals()
		AND
		DB_HAV_EnteringHaven_Claws(_Char)
		THEN
		DB_HAV_Siege_NPCs_Exclude(_Char);
		
		IF
		DB_HAV_TakingIsobel_FlyingGhouls((CHARACTER)_Char)
		THEN
		DB_HAV_Siege_NPCs_Exclude(_Char);
		
		IF
		DB_HAV_EnteringHaven_Claws(_Char)
		THEN
		DB_HAV_Siege_NPCs_Exclude(_Char);
		
		IF
		StatusApplied(_Harper,"HAV_SELUNEOINTMENT",_,_)
		AND
		DB_HAV_Siege_LowHP((CHARACTER)_Harper,_,_)
		THEN
		DB_HAV_Siege_NPCs_Custom(_Harper);
		
		IF
		StatusRemoved(_Harper,"HAV_SELUNEOINTMENT",_,_)
		AND
		DB_HAV_Siege_LowHP((CHARACTER)_Harper,_,_)
		THEN
		NOT DB_HAV_Siege_NPCs_Custom(_Harper);
		
		
		//REGION Siege pre-combat setup
		
		// iterate characters in Haven
		PROC
		PROC_HAV_Siege_PrepareForSiege()
		AND
		DB_HAV_Siege_PrepareCharactersInZones(_Trigger) // don't overlap => no initing twice
		THEN
		TriggerLaunchIterator(_Trigger,"HAV_Siege_PrepareIterateCharacters", "");
		
		PROC
		PROC_HAV_Siege_PrepareForSiege()
		THEN
		SetEntityEvent(S_HAV_SiegeStateObject_c4524ae3-32cd-4c7a-bfb5-b682785c6b88,"HAV_Siege_PrepareIterateCharacters_Finished");
		
		IF
		EntityEvent(_Char,"HAV_Siege_PrepareIterateCharacters")
		AND
		DB_Children((CHARACTER)_Char)
		THEN
		SetOnStage(_Char,0);
		
		IF
		EntityEvent(_Char,"HAV_Siege_PrepareIterateCharacters")
		AND
		NOT DB_PermaDefeated(_Char)
		AND
		NOT DB_HAV_Siege_NPCs_Exclude((CHARACTER)_Char)
		AND
		NOT DB_HAV_Siege_EnemyWaves(_,(CHARACTER)_Char)
		AND
		NOT DB_Children(_Char)
		AND
		IsOnStage(_Char,1)
		AND
		GetTemplate(_Char,_CharTemplate)
		AND
		_CharTemplate != Humans_InvisibleHelper_d5589336-4ca7-4ef7-9f6d-ebfea51001fe
		THEN
		PROC_HAV_Siege_PrepareIterateCharacters(_Char);
		
		// PARTY MEMBERS TO YARD
		PROC
		PROC_HAV_Siege_PrepareIterateCharacters((CHARACTER)_PartyMember)
		AND
		DB_PartyMembers((CHARACTER)_PartyMember)
		THEN
		PROC_HAV_Siege_PrepareNPCs_TPToYard(_PartyMember);
		
		// SPECIAL TREATMENT: CUSTOM
		PROC
		PROC_HAV_Siege_PrepareIterateCharacters((CHARACTER)_NPC)
		AND
		DB_HAV_Siege_NPCs_Custom(_NPC)
		THEN
		PROC_HAV_Siege_CustomNPCFate(_NPC);
		
		// SPECIAL TREATMENT: DEATH
		PROC
		PROC_HAV_Siege_PrepareIterateCharacters((CHARACTER)_NPC)
		AND
		DB_HAV_Siege_NPCs_Die(_NPC)
		THEN
		Die(_NPC,DEATHTYPE.Necrotic,1);
		
		
		// BLESSED TO YARD
		PROC
		PROC_HAV_Siege_PrepareIterateCharacters((CHARACTER)_NPC)
		AND
		NOT DB_HAV_Siege_NPCs_Custom(_NPC)
		AND
		NOT DB_HAV_Siege_NPCs_Die(_NPC)
		AND
		NOT DB_PartyMembers(_NPC)
		AND
		DB_HAV_Siege_NPCs(_NPC)
		AND
		HasAppliedStatus(_NPC,"HAV_SELUNEOINTMENT",1)
		THEN
		PROC_HAV_Siege_PrepareNPCs_TPToYard(_NPC);
		
		
		// NON-BLESSED IN LIGHT DIE
		PROC
		PROC_HAV_Siege_PrepareIterateCharacters((CHARACTER)_NPC)
		AND
		NOT DB_HAV_Siege_NPCs_Custom(_NPC)
		AND
		NOT DB_HAV_Siege_NPCs_Die(_NPC)
		AND
		NOT DB_PartyMembers(_NPC)
		AND
		HasAppliedStatus(_NPC,"HAV_SELUNEOINTMENT",0)
		AND
		QRY_HAV_Siege_IsInsideInn(_NPC)
		THEN
		Die(_NPC,DEATHTYPE.Necrotic,1);
		
		// NON-BLESSED IN DARKNESS TURN INTO UNDEAD
		PROC
		PROC_HAV_Siege_PrepareIterateCharacters((CHARACTER)_NPC)
		AND
		NOT DB_HAV_Siege_NPCs_Custom(_NPC)
		AND
		NOT DB_HAV_Siege_NPCs_Die(_NPC)
		AND
		NOT DB_PartyMembers(_NPC)
		AND
		HasAppliedStatus(_NPC,"HAV_SELUNEOINTMENT",0)
		AND
		NOT DB_HAV_Siege_IsInsideInn(_NPC)
		THEN
		DB_GLO_DefeatCounter(_NPC,"HAV_Siege");
		PROC_IncreaseCounter("HAV_Siege_EnemyCount");
		SetCombatGroupID(_NPC,"8b9709d7-b7b9-47c7-b277-32a6592794d7");
		SetFaction(_NPC,ACT2_HAV_ShadowCreatures_b0b8d20c-89f8-4433-bd62-5cbcbae2e9bc);
		PROC_HAV_Siege_SetSwarmGroup(_NPC);
		ApplyStatus(_NPC,"SCL_SHADOW_CURSE_UNDEAD_NEW",-1.0,1);
		PROC_HAV_Siege_PrepareTeleportIfHasSpot(_NPC);
		DB_HAV_Siege_NPCTurnedIntoShadows(_NPC);
		
		PROC
		PROC_HAV_Siege_PrepareIterateCharacters((CHARACTER)_NPC)
		AND
		NOT DB_HAV_Siege_NPCs_Custom(_NPC)
		AND
		NOT DB_HAV_Siege_NPCs_Die(_NPC)
		AND
		NOT DB_PartyMembers(_NPC)
		AND
		HasAppliedStatus(_NPC,"HAV_SELUNEOINTMENT",0)
		AND
		NOT DB_HAV_Siege_IsInsideInn(_NPC)
		AND
		IsTagged(_NPC,(TAG)ACT2_HAV_SIEGE_SHADOWCURSED_PRESERVE_HP_54d84ff5-73f6-4eaf-aa92-0fec99cdace0,0)
		THEN
		ApplyStatus(_NPC,"HAV_SIEGE_HITPOINTS_NERF",-1.0,1);
		
		IF
		FlagSet((FLAG)VISITEDREGION_INT_Main_A_a2e1a618-d211-484e-9389-6b37308b8da1, _,_)
		AND
		DB_HAV_Siege_NPCTurnedIntoShadows(_NPC)
		THEN
		DB_CustomDefeatedState(_NPC, "SCL_Shadowcurse");
		DB_PermanentlyEvil(_NPC);
		
		PROC
		PROC_HAV_Siege_SetSwarmGroup((CHARACTER)_NPC)
		AND
		DB_HAV_Siege_Undead_Swarms(_NPC,_Swarm)
		THEN
		RequestSetSwarmGroup(_NPC,_Swarm);
		
		PROC
		PROC_HAV_Siege_PrepareTeleportIfHasSpot((CHARACTER)_NPC)
		AND
		DB_HAV_Siege_NPCs_Teleport(_NPC,_Position)
		THEN
		TeleportTo(_NPC,_Position);
		
		QRY
		QRY_HAV_Siege_IsInsideInn((CHARACTER)_NPC)
		AND
		IsInTrigger(_NPC,S_HAV_InsideInn_Floor1_69a889f7-2dad-43cf-86e4-e4f2331e54cc,1)
		THEN
		DB_HAV_Siege_IsInsideInn(_NPC);
		
		QRY
		QRY_HAV_Siege_IsInsideInn((CHARACTER)_NPC)
		AND
		IsInTrigger(_NPC,S_HAV_InsideInn_Floor2_01b3e82a-6e82-4c6d-9213-ddd67439826b,1)
		THEN
		DB_HAV_Siege_IsInsideInn(_NPC);
		
		// try to find random valid position in the yard, otherwise just throw onto a predefined trigger
		PROC
		PROC_HAV_Siege_PrepareNPCs_TPToYard((CHARACTER)_Char)
		AND
		NOT QRY_HAV_Siege_PrepareNPCs_TPToPresetPos(_Char)
		AND
		NOT QRY_HAV_Siege_PrepareNPCs_TPToYard(_Char)
		THEN
		TeleportTo(_Char,S_HAV_Siege_Cine_PlayersPos_be08583b-092a-469d-b6fe-d908f99de8bb,"HAV_Siege_PrepareNPCs_TPToYard",0,0,0,1,1);
		
		QRY
		QRY_HAV_Siege_PrepareNPCs_TPToPresetPos((CHARACTER)_Char)
		AND
		DB_HAV_Siege_NPC_CombatPos(_Char,_Trigger)
		THEN
		TeleportTo(_Char,_Trigger,"HAV_Siege_PrepareNPCs_TPToPresetPos",0,0,0,1,1);
		
		QRY
		QRY_HAV_Siege_PrepareNPCs_TPToYard((CHARACTER)_Char)
		AND
		TriggerGetRandomPosition(S_HAV_Siege_TPAfterCinematic_OutsideZone_d4d2d0fe-7644-4056-85a7-4c1a0d654110,_X,_Y,_Z)
		AND
		FindValidPosition(_X,_Y,_Z,5.0,_Char,1,_VX,_VY,_VZ)
		THEN
		TeleportToPosition(_Char,_VX,_VY,_VZ,"HAV_Siege_PrepareNPCs_TPToYard",0,0,0,1,1);
		
		
		IF
		EntityEvent(_Char,"HAV_Siege_PrepareNPCs_TPToPresetPos")
		AND
		DB_HAV_Siege_NPC_CombatPos((CHARACTER)_Char,_Trigger)
		THEN
		LookFromTrigger(_Char,_Trigger,0);
		
		
		//REGION Low hp doomed harpers
		
		PROC
		PROC_HAV_Siege_CustomNPCFate((CHARACTER)_Harper)
		AND
		DB_HAV_Siege_LowHP(_Harper,"Dead",_Trigger)
		THEN
		Die(_Harper,DEATHTYPE.Necrotic,1);
		TeleportTo(_Harper,_Trigger);
		
		PROC
		PROC_HAV_Siege_CustomNPCFate((CHARACTER)_Harper)
		AND
		DB_HAV_Siege_LowHP(_Harper,"LowHP",_Trigger)
		THEN
		SetHitpointsPercentage(_Harper,40.0);
		TeleportTo(_Harper,_Trigger);
		
		//END_REGION Low hp doomed harpers
		
		//END_REGION Siege pre-combat setup
		
		
		//REGION Waves switches
		
		// spawn tentacles right away if there's no shadow zombies
		IF
		EntityEvent(_,"HAV_Siege_PrepareIterateCharacters_Finished")
		AND
		DB_GlobalCounter("HAV_Siege_EnemyCount",_EnemyCount)
		AND
		DB_HAV_Siege_SpawnWhenEnemiesLeft(1,_MinEnemyCount)
		AND
		_EnemyCount < _MinEnemyCount
		THEN
		PROC_HAV_Siege_SpawnWave(1);
		
		IF
		CombatRoundStarted(_CombatID,_Round)
		AND
		DB_HAV_Siege_CombatID(_CombatID)
		AND
		DB_HAV_Siege_SpawnAfterTurn(_Wave,_AfterRound)
		AND
		_Round > _AfterRound
		THEN
		PROC_HAV_Siege_SpawnWave(_Wave);
		
		PROC
		PROC_CounterDecreased("HAV_Siege_EnemyCount",_EnemyCount)
		AND
		DB_HAV_Siege_SpawnWhenEnemiesLeft(_Wave,_LimitCount)
		AND
		_EnemyCount <= _LimitCount
		THEN
		PROC_HAV_Siege_SpawnWave(_Wave);
		
		PROC
		PROC_HAV_Siege_SpawnWave(1)
		AND
		NOT DB_HAV_Siege_EnemyWaveSpawned(1)
		AND
		DB_HAV_Siege_CombatID(_CombatID)
		AND
		DB_CMB_RoundCounter(_CombatID,_Round)
		AND
		IntegerSum(_Round,2,_SpawnAt)
		THEN
		DB_HAV_Siege_SpawnAfterTurn(2,_SpawnAt);
		
		PROC
		PROC_HAV_Siege_SpawnWave((INTEGER)_Wave)
		AND
		NOT DB_HAV_Siege_EnemyWaveSpawned(_Wave)
		AND
		DB_HAV_Siege_EnemyWaves(_Wave,_Enemy)
		THEN
		DB_HAV_Siege_EnemyWaveSpawned(_Wave);
		AppearAt((CHARACTER)_Enemy,_Enemy,1,NULL_00000000-0000-0000-0000-000000000000,"HAV_Siege_EnemySpawned",0); // TODO: place proper animation
		
		IF
		EntityEvent(_Enemy,"HAV_Siege_EnemySpawned")
		THEN
		DB_GLO_DefeatCounter(_Enemy,"HAV_Siege");
		PROC_IncreaseCounter("HAV_Siege_EnemyCount");
		
		IF
		DB_PermaDefeated(_Enemy)
		AND
		DB_GLO_DefeatCounter(_Enemy,"HAV_Siege")
		THEN
		PROC_DecreaseCounter("HAV_Siege_EnemyCount");
		//END_REGION Waves switches
		
		
		//REGION Entering combat
		
		IF
		WentOnStage(_Enemy,1)
		AND
		DB_HAV_Siege_EnemyWaves(_,_Enemy)
		THEN
		DB_GLO_DefeatCounter(_Enemy,"HAV_Siege");
		
		IF
		DB_GLO_DefeatCounter(_Enemy,"HAV_Siege")
		AND
		DB_PartyMembers((CHARACTER)_PartyMember)
		AND
		NOT DB_PermaDefeated(_PartyMember)
		AND
		IsInTrigger(_PartyMember,S_HAV_Siege_CinematicIncludeZone_9d4fc4ac-870d-48df-b5b4-05e168238a45,1)
		AND
		NOT DB_HiddenCharacters(_PartyMember,_)
		AND
		NOT DB_Is_InCombat(_PartyMember,_)
		THEN
		DB_SCL_ShadowCurse_CursedCharacters(_Enemy);
		SetCombatGroupID(_Enemy, "26d8b49a-3b9f-d511-ad32-bc764d2d7600");
		PROC_EnterCombat(_Enemy, _PartyMember);
		
		IF
		DB_GLO_DefeatCounter(_Enemy,"HAV_Siege")
		AND
		IsInTrigger(S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a,S_HAV_Siege_CinematicIncludeZone_9d4fc4ac-870d-48df-b5b4-05e168238a45,1)
		AND
		NOT DB_PermaDefeated(S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a)
		AND
		NOT DB_Is_InCombat(S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a,_)
		THEN
		PROC_EnterCombat(_Enemy,S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a);
		
		
		IF
		DB_Is_InCombat(_Enemy,_CombatID)
		AND
		DB_GLO_DefeatCounter(_Enemy,"HAV_Siege")
		AND
		DB_Is_InCombat(_Player,_CombatID)
		AND
		DB_Players((CHARACTER)_Player)
		THEN
		SysClear("DB_HAV_Siege_CombatID",1);
		DB_HAV_Siege_CombatID(_CombatID);
		
		//END_REGION Entering combat
		
		
		//Ends HAV Siege Combat and plays outro just in case there are some lingering enemies outside the combat
		IF
		CombatEnded(_ID)
		AND
		DB_Was_InCombat(S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a, _ID)
		AND
		DB_Was_InCombat(S_HAV_Siege_W3_Boss_37223ef4-2293-4a2a-a1e2-88367d241fcf, _ID)
		AND
		DB_Was_InCombat(S_HAV_Siege_W3_Boss_02_3588d24b-ead5-4e87-9ff9-3eb508466a16, _ID)
		AND
		DB_PermaDefeated(S_HAV_Siege_W3_Boss_37223ef4-2293-4a2a-a1e2-88367d241fcf)
		AND
		DB_PermaDefeated(S_HAV_Siege_W3_Boss_02_3588d24b-ead5-4e87-9ff9-3eb508466a16)
		AND
		QRY_OnlyOnce("HAV_Siege_TryPlayEnd")
		THEN
		SetFlag(HAV_Siege_Event_SiegeEnd_1939fc49-17fd-49f8-9030-8c3d627a05df);
		
		
		
		
		PROC
		PROC_GLO_DefeatCounter_AllDefeated("HAV_Siege")
		THEN
		SetFlag(HAV_Siege_Event_SiegeEnd_1939fc49-17fd-49f8-9030-8c3d627a05df);
		
		PROC
		PROC_HAV_Siege_CustomNPCFate((CHARACTER)S_GLO_DevilishOx_49eb5b4b-c6ed-4d37-8f68-97b1128b7d56)
		THEN
		SetOnStage(S_GLO_DevilishOx_49eb5b4b-c6ed-4d37-8f68-97b1128b7d56,0);
		SetFlag(HAV_DevilishOx_State_Fled_aa1fff72-16df-4269-abda-61e5120a8623);
		
		
		PROC
		PROC_HAV_Siege_CustomNPCFate((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		AND
		DB_State_Current(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, "SCL_LiftingTheCurse", "SCL_LiftingTheCurse_State_HalsinAtHaven")
		AND
		NOT DB_PartyMembers(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		THEN
		PROC_ORI_SetupCamp(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1);
		
		PROC
		PROC_HAV_Siege_CustomNPCFate((CHARACTER)S_HAV_AncientFist_MartCullagh_378938e2-2193-49a3-a06e-8e26cc128055)
		THEN
		SetTag(S_HAV_AncientFist_MartCullagh_378938e2-2193-49a3-a06e-8e26cc128055, (TAG)ACT2_SHADOW_CURSE_IMMUNE_b47643e0-583c-4808-b108-f6d3b605b0a9);
		Die(S_HAV_AncientFist_MartCullagh_378938e2-2193-49a3-a06e-8e26cc128055, DEATHTYPE.Physical, NULL_00000000-0000-0000-0000-000000000000, 1, 1, 0.0);
	}
	EXIT
	{
	}
}
Goal(361).Title("Act2_HAV_TakingIsobel");
Goal(361)
{
	INIT
	{
		DB_GLO_CharacterCorpseDialog(S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211, (DIALOGRESOURCE)HAV_Isobel_Dead_20dadd7f-e5cb-1e5d-f3d7-fe021892ea01);
		DB_DeadOnceFlag(S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211, HAV_Isobel_State_IsDead_af8b23d8-d04d-4e42-8a56-be909226e706);
		DB_PreventKnockedOutPermaDefeated((CHARACTER)S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211);
		
		//REGION States
		DB_State_Current(S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211, "HAV_Isobel", "HAV_Isobel_State_Brief_InRoom");
		
		DB_State_Priority(S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211, "HAV_Isobel", "HAV_Isobel_State_Brief_InRoom", 1000); //On balcony or in room, hasn't given protection yet.
		DB_State_Priority(S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211, "HAV_Isobel", "HAV_Isobel_State_Capture", 2000); //During capture scene, after the protection spell.
		DB_State_Priority(S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211, "HAV_Isobel", "HAV_Isobel_State_FollowUp_Protection", 3000); //She's safe, the spy has been defeated. Cue thanks.
		DB_State_Priority(S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211, "HAV_Isobel", "HAV_Isobel_State_PostFollowUpProtection", 4000);
		DB_State_Priority(S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211, "HAV_Isobel", "HAV_Isobel_State_FollowUp_Capture", 6000); //Was captured and sent to Moonrise.
		DB_State_Priority(S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211, "HAV_Isobel", "HAV_Isobel_State_DefeatedInHaven", 7000); //tbd
		DB_State_Priority(S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211, "HAV_Isobel", "HAV_Isobel_State_AtMoonrise", 8000); //At moonrise, followup done.
		DB_State_Priority(S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211, "HAV_Isobel", "HAV_Isobel_State_KethericShowdown", 9000); //tbd
