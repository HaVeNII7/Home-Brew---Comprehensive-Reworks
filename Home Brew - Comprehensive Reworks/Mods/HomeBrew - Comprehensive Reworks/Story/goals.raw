		DB_Debug_TeleportFlags((FLAG)Debug_Teleport_DuergarCamp_deb0f4ee-d078-08ca-9c3f-ef74bf32e289,S_Debug_DuergarCamp_bf6e6f0b-0e6c-47e6-bff4-474a427372a0);
