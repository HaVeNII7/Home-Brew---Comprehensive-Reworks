		AND
		DB_DialogName((DIALOGRESOURCE)CAMP_WyllConfrontation_IVB_CFM_a63c30b4-9812-7d7d-ec3b-bd0fda090686, _DialogID)
		THEN
		PROC_TopicalGreeting_UnlockTopic((FLAG)TG_ORI_Karlach_WyllConfrontation_572ec281-3785-4fb1-824d-3ac2f6295366);
