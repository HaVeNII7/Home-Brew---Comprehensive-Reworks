		PROC_END_General_ApplyMindFlayerForm((CHARACTER)_Char);
		
		PROC
		PROC_END_General_ApplyMindFlayerForm((CHARACTER)_Char)
		AND
		QRY_END_General_ValidPlayerMindFlayerCandidate(_Char)
