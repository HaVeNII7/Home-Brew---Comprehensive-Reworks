	}
}
Goal(463).Title("Act2_TWN_ArabellasPowers");
Goal(463)
{
	INIT
	{
		DB_TWN_ArabellasPowers_FirstEncounterShadows((CHARACTER)S_TWN_ArabellaPowers_Shadow_1_6f78bd45-cd89-499d-af09-de331e945ad4);
