	KB
	{
		//REGION Debug
		IF
		TextEvent("LOW_Sewer_GiveSkull")
		AND
		GetHostCharacter(_Player)
		THEN
		ToInventory(S_LOW_ForsakenSkull_f956820a-2f54-4b5f-8894-a403f78921f5, _Player, 1, 1, 1);
		
		IF
		TextEvent("LOW_Sewer_OrinDeal")
		THEN
		SetFlag((FLAG)GLO_Orin_State_AgreedToKillGortash_39af75d8-2442-8667-551e-6a0dc699398b);
		//END_REGION
		
		//REGION Shooting practice
		IF
		DB_LOW_Sewer_BhaalistShooters(_Bhaalist)
		THEN
		DB_GLO_DefeatCounter(_Bhaalist, "LOW_Sewer_TargetPractice_Bhaalist");
		
		IF
		DB_LOW_Sewer_Refugees(_Refugee)
		THEN
		DB_GLO_DefeatCounter(_Refugee, "LOW_Sewer_TargetPractice_Refugee");
		ApplyStatus(_Refugee, "FRIGHTENED", -1.0, 1, S_LOW_Bhaalist01_336fe388-afbe-4b9b-a86e-aec927658019);
		
		PROC
		PROC_GLO_DefeatCounter_AllDefeated("LOW_Sewer_TargetPractice_Bhaalist")
		AND
		DB_LOW_Sewer_Refugees(_Refugee)
		THEN
		RemoveStatus(_Refugee, "FRIGHTENED", NULL_00000000-0000-0000-0000-000000000000);
		PROC_CharacterMoveTo((CHARACTER)_Refugee, S_LOW_RefugeeExitPoint_12ec402d-bcb6-4e0f-9f5a-7a676acc34bc, "Run", "LOW_Sewer_Refugees_ArrivedAtExit");
		
		IF
		EntityEvent(_Refugee, "LOW_Sewer_Refugees_ArrivedAtExit")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)LOW_Sewers_AD_RefugeesFleeing_d9e3068b-de5c-357f-a825-5fd61487221f, S_LOW_Refugee01_b79264f9-cbd0-4cbc-a5de-6c33ed5c2c19);
		PROC_DisappearOutOfSight((CHARACTER)_Refugee, "Run", 1, "");
		
		//Picking the next AD speaker (Flag is cleared in Anubis)
		IF
		FlagCleared((FLAG)LOW_Sewer_State_ShootingPracticeAD_ShouldSpeak_c7b48cbd-77a9-4a42-818b-bd1db1ee44fe, _, _)
		THEN
		TimerLaunch("LOW_Sewer_ShootingPacticeADCooldownTimer", 2500);
		
		IF
		TimerFinished("LOW_Sewer_ShootingPacticeADCooldownTimer")
		THEN
		PROC_LOW_Sewers_SelectRandomADSpeaker();
		
		
		PROC
		PROC_LOW_Sewers_SelectRandomADSpeaker()
		AND
		QRY_GetRandom("DB_LOW_Sewers_ShootingPractice_ADSpeakers", 1, "DB_LOW_Sewers_ShootingPractice_NextSpeaker")
		AND
		DB_LOW_Sewers_ShootingPractice_NextSpeaker(_Speaker)
		THEN
		SetFlag((FLAG)LOW_Sewer_State_ShootingPracticeAD_ShouldSpeak_c7b48cbd-77a9-4a42-818b-bd1db1ee44fe, _Speaker);
		NOT DB_LOW_Sewers_ShootingPractice_NextSpeaker(_Speaker);
		
		//This is so story editor shuts up about never checking the DB (I do, in the QRY_GetRandom(), but it doesn't understand that)
		IF
		DB_LOW_Sewers_ShootingPractice_ADSpeakers(_)
		THEN
		DB_NOOP(1);
		
		//Bhaalist cultist spotting (results in hostility if it fails)
		
		PROC
		PROC_SpotPlayers_Spotted(S_LOW_Bhaalist01_336fe388-afbe-4b9b-a86e-aec927658019, "LOW_Sewers_Bhaalist01", _Player)
		AND
		NOT DB_GlobalFlag(GLO_Orin_State_AgreedToKillGortash_39af75d8-2442-8667-551e-6a0dc699398b)
		AND
		NOT QRY_StartDialog(LOW_Sewers_Bhaalist01_036c1c73-0d36-b970-1722-778a14d32333, S_LOW_Bhaalist01_336fe388-afbe-4b9b-a86e-aec927658019, _Player)
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT3_LOW_Sewers_BhaalCultists_a16ae322-c7d5-428f-a569-dad9f0715c61, 0);
		
		PROC
		PROC_SpotPlayers_Spotted(S_LOW_Bhaalist01_336fe388-afbe-4b9b-a86e-aec927658019, "LOW_Sewers_Bhaalist01", _Player)
		AND
		DB_GlobalFlag((FLAG)GLO_Orin_State_BrokeDealToKillGortash_2283f315-5fda-481c-87a1-635d04253759)
		AND
		NOT QRY_StartDialog(LOW_Sewers_Bhaalist01_036c1c73-0d36-b970-1722-778a14d32333, S_LOW_Bhaalist01_336fe388-afbe-4b9b-a86e-aec927658019, _Player)
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT3_LOW_Sewers_BhaalCultists_a16ae322-c7d5-428f-a569-dad9f0715c61, 0);
		
		PROC
		PROC_SpotPlayers_Spotted(S_LOW_Bhaalist01_336fe388-afbe-4b9b-a86e-aec927658019, "LOW_Sewers_Bhaalist01", _Player)
		AND
		DB_GlobalFlag((FLAG)LOW_MurderTribunal_Sarevok_State_Dead_e9d30711-af25-4ba9-813e-cc7c131b17b6)
		AND
		NOT QRY_StartDialog(LOW_Sewers_Bhaalist01_036c1c73-0d36-b970-1722-778a14d32333, S_LOW_Bhaalist01_336fe388-afbe-4b9b-a86e-aec927658019, _Player)
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT3_LOW_Sewers_BhaalCultists_a16ae322-c7d5-428f-a569-dad9f0715c61, 0);
		
		//Spotting flag combinations that result in them staying neutral and going after the refugees instead - since you've proven your worth to Bhaal
		
		PROC
		PROC_SpotPlayers_Spotted(S_LOW_Bhaalist01_336fe388-afbe-4b9b-a86e-aec927658019, "LOW_Sewers_Bhaalist01", _Player)
		AND
		DB_GlobalFlag((FLAG)LOW_MurderTribunal_State_BecameUnholyAssassin_75ba9b20-e08b-f48e-6f70-5c93586ec729)
		AND
		NOT QRY_StartDialog(LOW_Sewers_Bhaalist01_036c1c73-0d36-b970-1722-778a14d32333, S_LOW_Bhaalist01_336fe388-afbe-4b9b-a86e-aec927658019, _Player)
		THEN
		PROC_LOW_Sewers_ResolveCultists();
		
		PROC
		PROC_SpotPlayers_Spotted(S_LOW_Bhaalist01_336fe388-afbe-4b9b-a86e-aec927658019, "LOW_Sewers_Bhaalist01", _Player)
		AND
		DB_GlobalFlag(GLO_Orin_State_AgreedToKillGortash_39af75d8-2442-8667-551e-6a0dc699398b)
		AND
		DB_GlobalFlag(GLO_Gortash_State_PermaDefeated_74dd56ff-7e00-42a6-a0f3-0d122f364769)
		AND
		NOT QRY_StartDialog(LOW_Sewers_Bhaalist01_036c1c73-0d36-b970-1722-778a14d32333, S_LOW_Bhaalist01_336fe388-afbe-4b9b-a86e-aec927658019, _Player)
		THEN
		PROC_LOW_Sewers_ResolveCultists();
		
		IF
		DialogRequestFailed(LOW_Sewers_Bhaalist01_036c1c73-0d36-b970-1722-778a14d32333, _)
		AND
		NOT DB_GlobalFlag(GLO_Orin_State_AgreedToKillGortash_39af75d8-2442-8667-551e-6a0dc699398b)
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT3_LOW_Sewers_BhaalCultists_a16ae322-c7d5-428f-a569-dad9f0715c61, 0);
		
		IF
		DialogRequestFailed(LOW_Sewers_Bhaalist01_036c1c73-0d36-b970-1722-778a14d32333, _)
		AND
		DB_GlobalFlag((FLAG)GLO_Orin_State_BrokeDealToKillGortash_2283f315-5fda-481c-87a1-635d04253759)
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT3_LOW_Sewers_BhaalCultists_a16ae322-c7d5-428f-a569-dad9f0715c61, 0);
		
		IF
		AttackedBy(_Refugee, _Player, _, _, _, _, _)
		AND
		DB_GlobalFlag(GLO_Orin_State_AgreedToKillGortash_39af75d8-2442-8667-551e-6a0dc699398b)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_Orin_State_BrokeDealToKillGortash_2283f315-5fda-481c-87a1-635d04253759)
		AND
		DB_LOW_Sewer_Refugees(_Refugee)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		NOT DB_GlobalFlag(LOW_Sewers_State_AttackedRefugees_ea81f059-3f1c-ca27-04e4-c472ce5fd592)
		THEN
		SetFlag(LOW_Sewers_State_AttackedRefugees_ea81f059-3f1c-ca27-04e4-c472ce5fd592);
		
		IF
		FlagSet(LOW_Sewers_State_AttackedRefugees_ea81f059-3f1c-ca27-04e4-c472ce5fd592, _, _)
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT3_LOW_Sewers_Refugees_9f862d9a-a94c-43c7-b1b0-8c6f1faf3991, 0);
		
		IF
		FlagSet(LOW_Sewers_State_AttackedRefugees_ea81f059-3f1c-ca27-04e4-c472ce5fd592, _, _)
		AND
		DB_LOW_Sewer_Refugees(_Refugee)
		THEN
		SetCanFight(_Refugee, 1);
		SetCanJoinCombat(_Refugee, 1);
		
		IF
		FlagSet(LOW_Sewer_State_CultistsFightRefugees_55c312c3-d36f-4cc8-8483-ac2e18168381, _, _)
		AND
		DB_LOW_Sewer_Refugees(_Refugee)
		THEN
		SetCanFight(_Refugee, 1);
		SetCanJoinCombat(_Refugee, 1);
		
		IF
		FlagSet(LOW_Sewer_State_CultistsFightRefugees_55c312c3-d36f-4cc8-8483-ac2e18168381, _, _)
		THEN
		PROC_SetRelationMutual((FACTION)ACT3_LOW_Sewers_Refugees_9f862d9a-a94c-43c7-b1b0-8c6f1faf3991, (FACTION)ACT3_LOW_Sewers_BhaalCultists_a16ae322-c7d5-428f-a569-dad9f0715c61, 0);
		
		IF
		FlagSet(LOW_Sewer_State_RefugeesDefeated_1fa74fb8-2da7-43bd-8724-72e774a5e809, _, _)
		AND
		DB_GlobalFlag(LOW_Sewer_State_CultistsFightRefugees_55c312c3-d36f-4cc8-8483-ac2e18168381)
		AND
		DB_LOW_Sewer_BhaalistShooters(_Bhaalist)
		THEN
		PROC_DisappearOutOfSight((CHARACTER)_Bhaalist, "Run", 0, "");
		
		PROC
		PROC_LOW_Sewers_ResolveCultists()
		THEN
		PROC_TryStartAD(LOW_Sewers_AD_Bhaalist01OrinAppeased_1eaca29c-a268-bc5a-9a87-9d5a33313b91, S_LOW_Bhaalist01_336fe388-afbe-4b9b-a86e-aec927658019);
		
		//Set them hostile to each other
		//make them fight
		//once the refugees are dead, disappear out of sight
		
		//Edge-case handling: if the player flees the combat, the Baneites join the combat and finish the fight
		IF
		EnteredCombat(_Refugee, _ID)
		AND
		DB_LOW_Sewer_Refugees(_Refugee)
		THEN
		DB_LOW_Sewer_RefugeeFight(_ID);
		
		IF
		LeftCombat(_Player, _ID)
		AND
		DB_LOW_Sewer_RefugeeFight(_ID)
		AND
		DB_Players((CHARACTER)_Player)
		THEN
		PROC_SetRelationMutual((FACTION)ACT3_LOW_Sewers_Refugees_9f862d9a-a94c-43c7-b1b0-8c6f1faf3991, (FACTION)ACT3_LOW_Sewers_BhaalCultists_a16ae322-c7d5-428f-a569-dad9f0715c61, 0);
		//END_REGION
		
		
		//REGION Vampire Boyfriend
		PROC
		PROC_GlobalFlagReactionAfterDialog(LOW_Sewers_VampireBoyFriend_LadyLeaves_14f89a73-28c0-8013-3f64-8d71e0aa5fbb)
		THEN
		PROC_DisappearOutOfSight(S_LOW_VampireBoyfriend_Lady_18c2525c-e9dd-4e48-881f-29a9657c5075, "Walk", 0, "");
		//END_REGION
		
		//REGION Arabella Tableau
		//debug
		IF
		TextEvent("LOW_Sewers_ArabellaSetup")
		THEN
		PROC_GlobalSetFlagAndCache(TWN_ArabellasPowers_State_ToldParentsDead_cc1a3765-9334-cb88-602f-49ca052de39c);
		PROC_LOW_Sewers_ArabellaSetup();
		
		//setup
		PROC
		PROC_LOW_Sewers_ArabellaSetup()
		AND
		NOT DB_PermaDefeated(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f)
		AND
		DB_GlobalFlag(TWN_ArabellasPowers_State_ToldParentsDead_cc1a3765-9334-cb88-602f-49ca052de39c)
		THEN
		DB_LOW_Sewers_ArabellaPresent(1);
		TeleportTo(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f, S_LOW_ArabellaTableu_Position_6ebaa7b7-4bf4-4e45-b791-365c9e4df6c5, "", 0, 0, 0, 1, 1);
		PROC_RemoveAllDialogEntriesForSpeaker(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f);
		DB_Dialogs(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f, (DIALOGRESOURCE)LOW_ArabellaPowers_Arabella_b6acbc79-8e0c-bdda-447d-f1ff9f00db04);
		PROC_SetOnStage(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f, 1);
		PROC_CharacterFullRestore((CHARACTER)S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f);
		
		PROC
		PROC_LOW_Sewers_ArabellaSetup()
		AND
		NOT DB_LOW_Sewers_ArabellaPresent(1)
		AND
		DB_LOW_Sewers_ArabellaBrigands(_Brigand)
		THEN
		SetOnStage(_Brigand, 0);
		
		PROC
		PROC_LOW_Sewers_ArabellaSetup()
		AND
		DB_LOW_Sewers_ArabellaPresent(1)
		AND
		DB_LOW_Sewers_ArabellaBrigands(_Brigand)
		THEN
		SetOnStage(_Brigand, 1);
		
		PROC
		PROC_LOW_Sewers_ArabellaSetup()
		AND
		NOT DB_LOW_Sewers_ArabellaPresent(1)
		THEN
		TimerLaunch("LOW_Sewer_Arabella_BrigandBloodCleanup", 2000);
		
		IF
		TimerFinished("LOW_Sewer_Arabella_BrigandBloodCleanup")
		THEN
		CreateSurface(S_LOW_ArabellaTableu_Position_6ebaa7b7-4bf4-4e45-b791-365c9e4df6c5, "SurfaceNone", 10.0, -1.0, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		DialogEnded(LOW_ArabellaPowers_Arabella_b6acbc79-8e0c-bdda-447d-f1ff9f00db04, _)
		THEN
		DB_TriggerEvents_AllPlayersLeft(S_LOW_ArabellTableu_ArabellaRegion_3baf180b-7b9d-4dc5-a070-c766527e2697, "LOW_ArabellaTableu_AllPlayerLeftArabella");
		
		IF
		EntityEvent(_, "LOW_ArabellaTableu_AllPlayerLeftArabella")
		THEN
		PROC_DisappearOutOfSight(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f, "Run", 0, "");
		DB_LOW_Sewers_ArabellaWaitingForEndgame(1);
		//END_REGION
		
		//REGION Voiceless Penitent
		//First time the player gets the skull, the ghost appears when the player has left the trigger around the voiceless penitent. This time the ghost also plays a silent begging animation
		IF
		LeftTrigger(_Player, (TRIGGER)S_LOW_VoicelessPenitentVicinity_f8c27b88-d70b-472f-8761-762d7067fc43)
		AND
		Exists(S_LOW_ForsakenSkull_f956820a-2f54-4b5f-8894-a403f78921f5, 1)
		AND
		IsInInventoryOf(S_LOW_ForsakenSkull_f956820a-2f54-4b5f-8894-a403f78921f5, _Player, 1)
		AND
		NOT DB_Is_InCombat(_Player, _)
		AND
		NOT DB_OnlyOnce("LOW_Sewers_CommentedOnForsakenSkull")
		THEN
		PROC_TriggerUnregisterForPlayers((TRIGGER)S_LOW_VoicelessPenitentVicinity_f8c27b88-d70b-472f-8761-762d7067fc43);
		PROC_TryStartAD((DIALOGRESOURCE)LOW_Sewers_AD_SkullActivating_1bed484c-14c8-1c82-73fd-77af82a40618,_Player);
		DB_OnlyOnce("LOW_Sewers_CommentedOnForsakenSkull");
		
		IF
		AutomatedDialogStarted((DIALOGRESOURCE)LOW_Sewers_AD_SkullActivating_1bed484c-14c8-1c82-73fd-77af82a40618, _ID)
		AND
		DB_DialogPlayers(_ID, _Player, 1)
		THEN
		ObjectTimerLaunch(_Player, "LOW_Sewer_GhostAppearDelay", 2500, 0);
		
		IF
		ObjectTimerFinished(_Player, "LOW_Sewer_GhostAppearDelay")
		THEN
		PROC_LOW_Sewers_MakeGhostFollow((CHARACTER)_Player);
		DebugText(S_LOW_HeadlessGhost_e9af0a05-9a9b-43aa-a2bd-d5f58d84de9c, "Play Begging Animation");
		
		
		
		//When added to the player's inventory (not near the penitent) the ghost apppears and starts following the player
		IF
		AddedTo(S_LOW_ForsakenSkull_f956820a-2f54-4b5f-8894-a403f78921f5, _Player, _)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		DB_InRegion(_Player, (TRIGGER)S_LOW_SewerZone_54cf146f-7f9f-4743-85fa-2be39b6a31e1)
		AND
		NOT DB_InRegion(_Player, (TRIGGER)S_LOW_VoicelessPenitentVicinity_f8c27b88-d70b-472f-8761-762d7067fc43)
		AND
		NOT DB_Is_InCombat(_Player, _)
		THEN
		PROC_LOW_Sewers_MakeGhostFollow((CHARACTER)_Player);
		
		//If the player drops the skull (or transfers it to another inventory) the ghost stops following them
		IF
		RemovedFrom(S_LOW_ForsakenSkull_f956820a-2f54-4b5f-8894-a403f78921f5, _Player)
		AND
		DB_Players((CHARACTER)_Player)
		THEN
		PROC_LOW_Sewers_StopGhostFollow();
		
		//If the player enters combat, the ghost stops following them
		IF
		EnteredCombat(_Player, _)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		DB_InRegion(_Player, (TRIGGER)S_LOW_SewerZone_54cf146f-7f9f-4743-85fa-2be39b6a31e1)
		AND
		Exists(S_LOW_ForsakenSkull_f956820a-2f54-4b5f-8894-a403f78921f5, 1)
		AND
		IsInInventoryOf(S_LOW_ForsakenSkull_f956820a-2f54-4b5f-8894-a403f78921f5, _Player, 1)
		AND
		IsOnStage((CHARACTER)S_LOW_HeadlessGhost_e9af0a05-9a9b-43aa-a2bd-d5f58d84de9c, 1)
		THEN
		PROC_LOW_Sewers_StopGhostFollow();
		
		//If the player leaves a combat with the skull on them, the ghost returns
		IF
		LeftCombat(_Player, _)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		DB_InRegion(_Player, (TRIGGER)S_LOW_SewerZone_54cf146f-7f9f-4743-85fa-2be39b6a31e1)
		AND
		Exists(S_LOW_ForsakenSkull_f956820a-2f54-4b5f-8894-a403f78921f5, 1)
		AND
		IsInInventoryOf(S_LOW_ForsakenSkull_f956820a-2f54-4b5f-8894-a403f78921f5, _Player, 1)
		AND
		IsOnStage((CHARACTER)S_LOW_HeadlessGhost_e9af0a05-9a9b-43aa-a2bd-d5f58d84de9c, 0)
		THEN
		PROC_LOW_Sewers_MakeGhostFollow((CHARACTER)_Player);
		
		//If the player enters the sewers, the ghost returns
		IF
		EnteredTrigger(_Player, (TRIGGER)S_LOW_SewerZone_54cf146f-7f9f-4743-85fa-2be39b6a31e1)
		AND
		Exists(S_LOW_ForsakenSkull_f956820a-2f54-4b5f-8894-a403f78921f5, 1)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		IsInInventoryOf(S_LOW_ForsakenSkull_f956820a-2f54-4b5f-8894-a403f78921f5, _Player, 1)
		AND
		NOT DB_Is_InCombat(_Player, _)
		AND
		IsOnStage((CHARACTER)S_LOW_HeadlessGhost_e9af0a05-9a9b-43aa-a2bd-d5f58d84de9c, 0)
		THEN
		PROC_LOW_Sewers_MakeGhostFollow((CHARACTER)_Player);
		
		//if the player leaves the sewers the ghost stops following
		IF
		LeftTrigger(_Player, (TRIGGER)S_LOW_SewerZone_54cf146f-7f9f-4743-85fa-2be39b6a31e1)
		AND
		Exists(S_LOW_ForsakenSkull_f956820a-2f54-4b5f-8894-a403f78921f5, 1)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		IsInInventoryOf(S_LOW_ForsakenSkull_f956820a-2f54-4b5f-8894-a403f78921f5, _Player, 1)
		AND
		IsOnStage((CHARACTER)S_LOW_HeadlessGhost_e9af0a05-9a9b-43aa-a2bd-d5f58d84de9c, 1)
		THEN
		PROC_LOW_Sewers_StopGhostFollow();
		
		PROC
		PROC_LOW_Sewers_MakeGhostFollow((CHARACTER)_Player)
		AND
		GetPosition(_Player, _X, _Y, _Z)
		AND
		FindValidPosition(_X, _Y, _Z, 2.0, _Player, 0, _ValidX, _ValidY, _ValidZ)
		THEN
		DB_LOW_Sewers_GhostIsFollowing(_Player);
		TeleportToPosition(S_LOW_HeadlessGhost_e9af0a05-9a9b-43aa-a2bd-d5f58d84de9c, _ValidX, _ValidY, _ValidZ, "", 0,0,0,1,1);
		SetOnStage((CHARACTER)S_LOW_HeadlessGhost_e9af0a05-9a9b-43aa-a2bd-d5f58d84de9c, 1);
		DebugText(_Player, "Ghost following");
		
		IF
		WentOnStage(S_LOW_HeadlessGhost_e9af0a05-9a9b-43aa-a2bd-d5f58d84de9c, 1)
		THEN
		PROC_PlayLoopingAnimation(S_LOW_HeadlessGhost_e9af0a05-9a9b-43aa-a2bd-d5f58d84de9c, CUST_Begging_Silent_01_Start_bfc158f3-c385-4e80-bb6b-7dcb75899715, CUST_Begging_Silent_01_Loop_9fd137c9-1811-4cbf-b4e5-65d020b90885, CUST_Begging_Silent_01_End_22dcaed0-8583-4135-b097-fe0fa49709be);
		RealtimeObjectTimerLaunch(S_LOW_HeadlessGhost_e9af0a05-9a9b-43aa-a2bd-d5f58d84de9c, "LOW_Sewer_GhostBegging", 5000);
		
		IF
		ObjectTimerFinished(_, "LOW_Sewer_GhostBegging")
		THEN
		StopAnimation(S_LOW_HeadlessGhost_e9af0a05-9a9b-43aa-a2bd-d5f58d84de9c, 0);
		
		PROC
		PROC_LOW_Sewers_StopGhostFollow()
		AND
		DB_LOW_Sewers_GhostIsFollowing(_Player)
		THEN
		SetOnStage((CHARACTER)S_LOW_HeadlessGhost_e9af0a05-9a9b-43aa-a2bd-d5f58d84de9c, 0);
		DebugText(_Player, "Ghost stopped following");
		NOT DB_LOW_Sewers_GhostIsFollowing(_Player);
		
		PROC
		PROC_StateSet_Defeated(S_LOW_HeadlessGhost_e9af0a05-9a9b-43aa-a2bd-d5f58d84de9c)
		THEN
		PROC_LOW_Sewers_StopGhostFollow();
		
		//Sending entity event about who to follow to ghost anubis
		IF 
		AddedTo(S_LOW_ForsakenSkull_f956820a-2f54-4b5f-8894-a403f78921f5, _Player, _)
		AND
		DB_Players((CHARACTER)_Player)
		THEN
		SetDualEntityEvent(S_LOW_HeadlessGhost_e9af0a05-9a9b-43aa-a2bd-d5f58d84de9c, _Player, "LOW_Sewers_HeadlessGhost_FollowingUpdate", 1);
		
		IF
		RemovedFrom(S_LOW_ForsakenSkull_f956820a-2f54-4b5f-8894-a403f78921f5, _Player)
		AND
		DB_PartOfTheTeam((CHARACTER)_Player)
		THEN
		SetDualEntityEvent(S_LOW_HeadlessGhost_e9af0a05-9a9b-43aa-a2bd-d5f58d84de9c, _Player, "LOW_Sewers_HeadlessGhost_StopFollow", 1);
		//END_REGION
		
		//REGION Fire Wizard
		IF
		Combined(S_LOW_ForsakenSkeleton_7d0bd540-c724-44d4-bbb6-32678d30f93f, S_LOW_ForsakenSkull_f956820a-2f54-4b5f-8894-a403f78921f5, _, _, _, _Player, _CompleteSkeleton)
		THEN
		DebugText(S_LOW_HeadlessGhost_e9af0a05-9a9b-43aa-a2bd-d5f58d84de9c, "Play Bow Animation");
		DB_LOW_Sewer_SkeletonCombinedBy(_Player);
		PROC_LOW_Sewers_StopGhostFollow();
		SetOnStage(S_LOW_GhostWithHead_d2da80e2-bf45-41d3-88e7-3650740b13a6, 1);
		LookAtEntity(S_LOW_GhostWithHead_d2da80e2-bf45-41d3-88e7-3650740b13a6, _Player, 0.5);
		PlayAnimation(S_LOW_GhostWithHead_d2da80e2-bf45-41d3-88e7-3650740b13a6, CUST_Bowing_01_97a6f123-20ab-4470-a17b-11c004e795b9, "LOW_Sewers_GhostBow");
		RealtimeObjectTimerLaunch(S_LOW_GhostWithHead_d2da80e2-bf45-41d3-88e7-3650740b13a6, "LOW_Sewers_GhostBowTimer", 6000);
		
		IF
		AnimationEvent(S_LOW_GhostWithHead_d2da80e2-bf45-41d3-88e7-3650740b13a6, "AnimationSetOffStage", _)
		AND
		DB_LOW_Sewer_SkeletonCombinedBy(_Player)
		THEN
		QuestUpdate(_Player,"HIDDEN_CTY_Boosters", "LOW_ForsakenSkull");
		PROC_SetOnStage(S_LOW_GhostWithHead_d2da80e2-bf45-41d3-88e7-3650740b13a6, 0);
		NOT DB_LOW_Sewer_SkeletonCombinedBy(_Player);
		
		//Whent the Wizard joins combat make all Elementals join combat - on hold until combat figures out what is needed from this
		IF
		EnteredCombat(S_LOW_FireWizard_5a4f7f77-43c9-4f84-b3f4-4076d876ccde, _CombatID)
		AND
		DB_LOW_Sewer_FireWizard_Elementals(_Elemental)
		AND
		GetCombatGroupID(S_LOW_FireWizard_5a4f7f77-43c9-4f84-b3f4-4076d876ccde, _CombatGroup)
		THEN
		SetCombatGroupAndEnterCombat(_Elemental, _CombatGroup, S_LOW_FireWizard_5a4f7f77-43c9-4f84-b3f4-4076d876ccde);
		
		//FireWizard ADs For spells
		IF
		CastSpell(S_LOW_FireWizard_5a4f7f77-43c9-4f84-b3f4-4076d876ccde, _Spell, _, _, _)
		AND
		DB_LOW_Sewer_FireWizard_SpellADFlags(_Spell, _Flag)
		THEN
		SetFlag((FLAG)_Flag);
		
		//AD for taking damage for the first time
		IF
		HitpointsChanged(S_LOW_FireWizard_5a4f7f77-43c9-4f84-b3f4-4076d876ccde, _HP)
		AND
		_HP<100
		AND
		QRY_OnlyOnce("LOW_Sewer_FirewizardHurt")
		THEN
		SetFlag(LOW_Sewer_Event_FireWizard_HurtAD_8088d665-032d-481b-8817-528a991751f1);
		
		//AD for dipping under half HP
		IF
		HitpointsChanged(S_LOW_FireWizard_5a4f7f77-43c9-4f84-b3f4-4076d876ccde, _HP)
		AND
		_HP<50
		AND
		QRY_OnlyOnce("LOW_Sewer_FirewizardHalfHP")
		THEN
		SetFlag(LOW_Sewer_Event_FireWizard_HalfHPAD_ed0270a6-d636-4c87-9b70-405f5d5f16d9);
		
		IF
		FlagSet(_Flag, _, _)
		AND
		DB_LOW_Sewer_FireWizard_ADFlags(_Flag)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)LOW_Sewers_AD_Combat_FireWizard_3cd3f241-07e4-4498-03c8-9afbcc8d5d0a, S_LOW_FireWizard_5a4f7f77-43c9-4f84-b3f4-4076d876ccde);
		
		IF
		AutomatedDialogEnded(LOW_Sewers_AD_Combat_FireWizard_3cd3f241-07e4-4498-03c8-9afbcc8d5d0a, _)
		AND
		DB_LOW_Sewer_FireWizard_ADFlags(_Flag)
		AND
		DB_GlobalFlag((FLAG)_Flag)
		THEN
		ClearFlag(_Flag);
		
		IF
		AutomatedDialogRequestFailed(LOW_Sewers_AD_Combat_FireWizard_3cd3f241-07e4-4498-03c8-9afbcc8d5d0a, _)
		AND
		DB_LOW_Sewer_FireWizard_ADFlags(_Flag)
		AND
		DB_GlobalFlag((FLAG)_Flag)
		THEN
		ClearFlag(_Flag);
		
		//Elementals always keep an eye out for approaching dangers (players)
		IF
		DB_LOW_Sewer_FireWizard_Elementals(_Elemental)
		THEN
		DB_SpotPlayers((CHARACTER)_Elemental, "LOW_Sewers_FireWizard_ElementalsSpotting", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		DB_SpotPlayers_SpotTrigger((CHARACTER)_Elemental, "LOW_Sewers_FireWizard_ElementalsSpotting", S_LOW_FireWizard_DialogZone_2a83816e-bb9a-428d-a76a-380810a8c625);
		
		//when the player is spotted, the firewizard starts a dialog
		PROC
		PROC_SpotPlayers_Spotted(_, "LOW_Sewers_FireWizard_ElementalsSpotting", _Player)
		AND
		NOT DB_LOW_Sewer_FireWizardDialogStarted(1)
		AND
		QRY_StartDialogCustom((DIALOGRESOURCE)LOW_Sewers_FireWizard_e4f29705-a5f0-af36-cbf5-3788b2b90488, S_LOW_FireWizard_5a4f7f77-43c9-4f84-b3f4-4076d876ccde, _Player,S_LOW_GreaseElemental_001_f4e06895-6aa1-4fb0-9118-097e3e250cb2,0, 0, 0, 0)
		THEN
		DB_NOOP(1);
		
		IF
		DialogStarted(LOW_Sewers_FireWizard_e4f29705-a5f0-af36-cbf5-3788b2b90488, _)
		THEN
		DB_LOW_Sewer_FireWizardDialogStarted(1);
		
		//Add latecomers to the ongoing wizard dialog
		IF
		DB_InRegion(_Player, S_LOW_FireWizard_DialogZone_2a83816e-bb9a-428d-a76a-380810a8c625)
		AND
		DB_Players(_Player)
		AND
		DB_DialogName((DIALOGRESOURCE)LOW_Sewers_FireWizard_e4f29705-a5f0-af36-cbf5-3788b2b90488,_Inst)
		AND
		QRY_SpeakerIsAvailable(_Player)
		THEN
		PROC_DialogAddListeningActor(_Inst,_Player);
		
		//Peaceful resolution
		IF
		DB_GlobalFlag(LOW_Sewer_State_FireWizardPeace_dc00f52a-cbc2-c709-80a5-a291a97829da)
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT3_LOW_FireWizard_5ed8ba69-020f-444b-a5b5-d9d3b7a9e393, 100);
		PROC_PeacefulResolve((CHARACTER)S_LOW_FireWizard_5a4f7f77-43c9-4f84-b3f4-4076d876ccde);
		
		IF
		DB_GlobalFlag(LOW_Sewer_State_FireWizardPeace_dc00f52a-cbc2-c709-80a5-a291a97829da)
		AND
		DB_LOW_Sewer_FireWizard_Elementals(_Elemental)
		THEN
		PROC_PeacefulResolve((CHARACTER)_Elemental);
		
		IF
		FlagSet(LOW_Sewer_State_FireWizardPeace_dc00f52a-cbc2-c709-80a5-a291a97829da, _, _)
		THEN
		DB_TriggerEvents_AllPlayersLeft(S_LOW_FireWizard_AggroTrigger_15055c68-3d03-430b-b96c-761875f1ee2b, "LOW_Sewers_AllPlayersLeftFireWizardAggroTrigger");
		
		IF
		EntityEvent(_, "LOW_Sewers_AllPlayersLeftFireWizardAggroTrigger")
		AND
		DB_GlobalFlag(LOW_Sewer_State_FireWizardPeace_dc00f52a-cbc2-c709-80a5-a291a97829da)
		THEN
		DB_SpotPlayers((CHARACTER)S_LOW_FireWizard_5a4f7f77-43c9-4f84-b3f4-4076d876ccde, "LOW_Sewers_FireWizardAggro", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		DB_SpotPlayers_SpotTrigger((CHARACTER)S_LOW_FireWizard_5a4f7f77-43c9-4f84-b3f4-4076d876ccde, "LOW_Sewers_FireWizardAggro", S_LOW_FireWizard_AggroTrigger_15055c68-3d03-430b-b96c-761875f1ee2b);
		
		PROC
		PROC_SpotPlayers_Spotted(_ ,"LOW_Sewers_FireWizardAggro", _Player)
		AND
		DB_Players(_Player)
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT3_LOW_FireWizard_5ed8ba69-020f-444b-a5b5-d9d3b7a9e393, 0);
		ClearFlag(LOW_Sewer_State_FireWizardPeace_dc00f52a-cbc2-c709-80a5-a291a97829da);
		
		IF
		StatusApplied(_Ooze, "BURNING", _, _)
		AND
		HasActiveStatus(_Ooze, "LOW_SEWER_OOZING", 1)
		THEN
		RemoveStatus(_Ooze, "LOW_SEWER_OOZING", NULL_00000000-0000-0000-0000-000000000000);
		DB_LOW_Sewer_BurningOoze(_Ooze);
		
		IF
		StatusRemoved(_Ooze, "BURNING", _, _)
		AND
		DB_LOW_Sewer_BurningOoze(_Ooze)
		THEN
		ApplyStatus(_Ooze, "LOW_SEWER_OOZING", -1.0, 1, NULL_00000000-0000-0000-0000-000000000000);
		NOT DB_LOW_Sewer_BurningOoze(_Ooze);
		//END_REGION
		
		//REGION Sewer Raft
		IF
		DualEntityEvent(_, _StationLever, "LOW_SewerRaft_StationLever")
		AND
		DB_LOW_Sewer_Raft_Stations(_Num, _Trigger, _StationLever, _String)
		AND
		NOT DB_LOW_Sewer_Raft_CurrentStation(_Num)
		AND
		NOT DB_LOW_Sewer_Raft_InMotion(1)
		THEN
		PROC_Sewer_Raft_GoToStation((INTEGER)_Num);
		
		IF
		DualEntityEvent(_, _, "LOW_SewerRaft_RaftLever_Forward")
		AND
		NOT DB_LOW_Sewer_Raft_InMotion(1)
		AND
		DB_LOW_Sewer_Raft_CurrentStation(_Current)
		AND
		IntegerSum(_Current, 1, _TargetStation)
		AND
		_TargetStation<4
		THEN
		PROC_Sewer_Raft_GoToStation((INTEGER)_TargetStation);
		
		IF
		DualEntityEvent(_, _, "LOW_SewerRaft_RaftLever_Back")
		AND
		NOT DB_LOW_Sewer_Raft_InMotion(1)
		AND
		DB_LOW_Sewer_Raft_CurrentStation(_Current)
		AND
		IntegerSubtract(_Current, 1, _TargetStation)
		AND
		_TargetStation>0
		THEN
		PROC_Sewer_Raft_GoToStation((INTEGER)_TargetStation);
		
		PROC
		PROC_Sewer_Raft_GoToStation((INTEGER)_TargetStation)
		AND
		DB_LOW_Sewer_Raft_Stations(_TargetStation, _Trigger, _, _String)
		AND
		GetPosition(_Trigger, _X, _Y, _Z)
		AND
		DB_LOW_Sewer_Raft_CurrentStation(_Current)
		THEN
		NOT DB_LOW_Sewer_Raft_CurrentStation(_Current);
		PlatformMoveTo(PLT_UC_SewerRaft_000_7003d87e-efb9-448c-b55b-c8b2ff03e914, _X, _Y, _Z, 3.0, _String, 1);
		DB_LOW_Sewer_Raft_InMotion(1);
		
		IF
		PlatformMovementFinished(_, _String)
		AND
		DB_LOW_Sewer_Raft_Stations(_Num, _Trigger, _StationLever, _String)
		THEN
		DB_LOW_Sewer_Raft_CurrentStation(_Num);
		NOT DB_LOW_Sewer_Raft_InMotion(1);
		//END_REGION
		
		//REGION Topical greeting flag
		IF
		EnteredTrigger(_Player, (TRIGGER)S_LOW_SewerZone_54cf146f-7f9f-4743-85fa-2be39b6a31e1)
		AND
		DB_Avatars(_Player)
		THEN
		PROC_TopicalGreeting_UnlockTopic((FLAG)TG_LOW_Sewers_353bd76a-0bd3-41d0-a9c8-7ddd4d312093);
		//END_REGION
	}
	EXIT
	{
	}
}
