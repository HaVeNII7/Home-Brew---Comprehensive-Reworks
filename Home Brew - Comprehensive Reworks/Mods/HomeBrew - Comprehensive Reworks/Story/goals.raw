		DB_GLO_FireBowls((ITEM)S_MOO_Bowl_07_9ee0dc03-a3f8-436c-81da-29167733cf93,S_MOO_Hinge_07_d131b035-352c-4f62-9461-edc9c5ce4db0);
		DB_GLO_FireBowls((ITEM)S_MOO_Bowl_08_1fe4a7c7-c3a4-4603-9cee-40c666800a70,S_MOO_Hinge_08_727e850f-b951-4842-b405-184e85041d53);
		DB_GLO_FireBowls((ITEM)S_MOO_Bowl_09_dc8e33e2-4053-4845-876b-72fa81571bbb,S_MOO_Hinge_09_3475c146-6904-4e4e-9239-a49afb341aff);
		DB_GLO_FireBowls((ITEM)S_MOO_Bowl_10_3a6b1c04-3e58-4666-a48c-16372133441c,S_MOO_Hinge_10_ce9ff321-f472-4841-a02b-64a986d20915);
		DB_GLO_FireBowls((ITEM)S_MOO_Bowl_11_3f27153c-0c0b-4464-8d46-d1c0ab08fa46,S_MOO_Hinge_11_3bb1028e-6506-465d-a564-13c1c51b3c4d);
		DB_GLO_FireBowls((ITEM)S_MOO_Bowl_12_544adfab-8af4-48d8-be10-39ac147d4359,S_MOO_Hinge_12_a01dcf23-e822-432a-bb2b-caba067e4747);
		DB_GLO_FireBowls((ITEM)S_MOO_Bowl_13_c11b18ef-4258-4e17-9597-c9ad3aeb2093,S_MOO_Hinge_13_6bb93661-1a31-4eff-b515-6cf5251323c8);
		DB_GLO_FireBowls((ITEM)S_MOO_Bowl_14_23a2d2fa-cc44-4017-8bb5-c8a55c37fae9,S_MOO_Hinge_14_b1c7b1c8-5bbf-4e17-81ff-4ab134756d08);
	}
	KB
	{
		//REGION Debug
		IF
		TextEvent("mootoroof")
		AND
		GetHostCharacter(_Player)
		THEN
		SetFlag(Debug_Teleport_MOO_Roof_1e88aa9a-c17b-48aa-b98d-0ca26afdd13a, _Player);
		
		IF
		TextEvent("mootokitchen")
		AND
		GetHostCharacter(_Player)
		THEN
		SetFlag(Debug_Teleport_MOO_Kitchen_5232db34-b5a2-4d2f-b848-d45bc371cfcf, _Player);
		
		IF
		TextEvent("mootoprison")
		AND
		GetHostCharacter(_Player)
		THEN
		SetFlag(Debug_Teleport_MOO_Prison_b8d2c7ac-e50e-4d0d-80d8-b3ce8267df7b, _Player);
		
		IF
		TextEvent("mootoisobelroom")
		AND
		GetHostCharacter(_Player)
		THEN
		SetFlag(Debug_Teleport_MOO_IsobelRoom_896ea504-0f00-4d17-87a0-ffe74ea804de, _Player);
		
		IF
		TextEvent("mootobalthroom")
		AND
		GetHostCharacter(_Player)
		THEN
		SetFlag(Debug_Teleport_MOO_BalthazarRoom_ca8a8595-aa2e-4427-893f-ee31376716c1, _Player);
		
		IF
		TextEvent("mootodocks")
		AND
		GetHostCharacter(_Player)
		THEN
		SetFlag(Debug_Teleport_MOO_Docks_6ec11b6e-a7fe-4712-b80c-cd76f81c0354, _Player);
		
		IF
		TextEvent("moo_daisyaudience")
		AND
		GetHostCharacter(_Player)
		THEN
		SetFlag(MOO_Daisy_Event_MentionedAbsoluteAudience_3b9d9d5f-3274-4315-99de-e6435085bd72, _Player);
		//END_REGION
		
		IF
		DB_InRegion(_Player,S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6)
		AND
		NOT DB_GlobalFlag(GLO_MoonriseTower_EverEnteredBefore_26aeabb0-7644-4897-9bbd-7a95e3e8930f)
		THEN 
		PROC_GlobalSetFlagAndCache(GLO_MoonriseTower_EverEnteredBefore_26aeabb0-7644-4897-9bbd-7a95e3e8930f);
		
		//REGION Block InParties
		PROC
		PROC_State_Changed(S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6, "MOO", "MOO_State_Assault")
		THEN
		PROC_MOO_Assault_SetPartyDialogSuppression();
		
		PROC
		PROC_MOO_Assault_SetPartyDialogSuppression()
		AND
		DB_MOO_InMOOTriggers((TRIGGER)_Trigger)
		THEN
		DB_PartyDialogSuppressionZone(_Trigger);
		DB_PartyDialogSuppression_CustomDialogForParty(_Trigger, (DIALOGRESOURCE)GLO_AD_CompanionCantTalk_5b47f078-c7c2-3f21-d96f-93c0652aa2f2);
		
		PROC
		PROC_MOO_Assault_SetPartyDialogSuppression()
		AND
		DB_MOO_InsideMoonriseTowerTriggers((TRIGGER)_Trigger)
		THEN
		DB_PartyDialogSuppressionZone(_Trigger);
		DB_PartyDialogSuppression_CustomDialogForParty(_Trigger, (DIALOGRESOURCE)GLO_AD_CompanionCantTalk_5b47f078-c7c2-3f21-d96f-93c0652aa2f2);
		
		IF
		FlagSet(MOO_Assault_Event_KethericTeleportedAway_ba71e8cd-8922-61a4-a2ff-8c5f5ff8aac6, _, _)
		THEN
		PROC_MOO_Assault_ClearPartyDialogSuppression();
		
		PROC
		PROC_MOO_Assault_ClearPartyDialogSuppression()
		AND
		DB_MOO_InMOOTriggers((TRIGGER)_Trigger)
		THEN
		NOT DB_PartyDialogSuppressionZone(_Trigger);
		NOT DB_PartyDialogSuppression_CustomDialogForParty(_Trigger, (DIALOGRESOURCE)GLO_AD_CompanionCantTalk_5b47f078-c7c2-3f21-d96f-93c0652aa2f2);
		
		PROC
		PROC_MOO_Assault_ClearPartyDialogSuppression()
		AND
		DB_MOO_InsideMoonriseTowerTriggers((TRIGGER)_Trigger)
		THEN
		NOT DB_PartyDialogSuppressionZone(_Trigger);
		NOT DB_PartyDialogSuppression_CustomDialogForParty(_Trigger, (DIALOGRESOURCE)GLO_AD_CompanionCantTalk_5b47f078-c7c2-3f21-d96f-93c0652aa2f2);
		//END_REGION
		
		
		//REGION Tower States
		
		//PostExecution = Execution scene is over
		IF
		FlagSet(MOO_GroundFloor_State_ExecutionOver_1560c0ae-5fec-4e7c-a6e7-35e9c33bbbeb, _, _)
		THEN
		PROC_State_Progress(S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6, "MOO", "MOO_State_PostExecution");
		
		//Outcast = Ketheric hostile in the Execution or on Roof
		IF
		FlagSet(MOO_MoonriseTower_State_Outcast_93565546-9052-4776-8563-2a1aca8d899e, _, _ID)
		AND
		_ID != 0
		AND
		QRY_OnlyOnce("MOO_State_PrepareOutcast")
		THEN
		DB_MOO_Misc_PrepareOutcastState(_ID);
		
		IF
		FlagSet(MOO_MoonriseTower_State_Outcast_93565546-9052-4776-8563-2a1aca8d899e, _, 0)
		AND
		QRY_OnlyOnce("MOO_State_PrepareOutcast")
		THEN
		PROC_State_Progress(S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6, "MOO", "MOO_State_Outcast");
		
		IF
		DialogEnded(_, _ID)
		AND
		DB_MOO_Misc_PrepareOutcastState(_ID)
		THEN
		NOT DB_MOO_Misc_PrepareOutcastState(_ID);
		PROC_State_Progress(S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6, "MOO", "MOO_State_Outcast");
		
		//Audience = Returned Nightsong to Ketheric
		PROC
		PROC_State_Changed(S_GLO_Nightsong_6c55edb0-901b-4ba4-b9e8-3475a8392d9b, "SHA_Nightsong", "SHA_State_Nightsong_AtMoo")
		THEN
		SetFlag(MOO_Audience_State_Ready_b53bc2df-d3b9-73a7-c1d2-b47b0ecdc722);
		
		IF
		FlagSet(MOO_Audience_State_Ready_b53bc2df-d3b9-73a7-c1d2-b47b0ecdc722, _, _)
		THEN
		PROC_State_Progress(S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6, "MOO", "MOO_State_Audience");
		
		//Assault = freed Nightsong
		IF
		FlagSet(SHA_NightsongPrison_State_NightsongFreed_24f27b06-6665-79ed-d7bf-e4bf356ca2fa,_,_)
		THEN
		PROC_State_Progress(S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6, "MOO", "MOO_State_Assault");
		RemoveStatus(S_MOO_Ketheric_e9918f3e-5b87-40a3-a9bd-61545151573f, "MOO_KETHERIC_INVULNERABLE", NULL_00000000-0000-0000-0000-000000000000);
		
		//NightsongDeath = Killed Nightsong permanently with the spear
		IF
		DB_PermaDefeated(S_GLO_Nightsong_6c55edb0-901b-4ba4-b9e8-3475a8392d9b)
		THEN
		PROC_State_Progress(S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6, "MOO", "MOO_State_NightsongDeath");
		RemoveStatus(S_MOO_Ketheric_e9918f3e-5b87-40a3-a9bd-61545151573f, "MOO_KETHERIC_INVULNERABLE", NULL_00000000-0000-0000-0000-000000000000);
		//END_REGION
		
		//REGION SCL Caravaneers transition from SCL to MOO
		IF
		EntityEvent(_Caravaneer, "MOO_DriderCaravan_Event_Arrived")
		THEN
		SetFaction(_Caravaneer, ACT2_MOO_GroundFloor_948faabe-f0e5-40e7-afcf-22e1d5119b88);
		DB_MOO_Denizens((CHARACTER)_Caravaneer);
		//END_REGION
		
		//REGION Is In MOO checking
		
		IF
		DB_MOO_InMOOTriggers(_Trigger)
		THEN
		PROC_TriggerRegisterForPlayers(_Trigger);
		
		//--- Checking if a character is in any of the subregion of MOO
		// QRY_MOO_IsInMOO((CHARACTER)_Char, (INTEGER)_CheckDB, (TRIGGER)_ExcludedTrigger)
		//	_Char : character to check
		// 	_CheckDB == 1 : checks the DB_InRegion (more efficient). Used by default on players
		//	_CheckDB == 0 : uses IsInTrigger (better for frame sensitive checks or for NPCs). Used by default on NPCs.
		// _ExcludedTrigger : this trigger won't be checked and won't count (this has no effect if the trigger isn't in the list DB_MOO_InMOOTriggers, so NULL is used when no trigger is passed)
		
		QRY
		QRY_MOO_IsInMOO((CHARACTER)_Char)
		AND
		DB_Players(_Char)
		AND
		QRY_MOO_IsInMOO(_Char, 1)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_MOO_IsInMOO((CHARACTER)_Char)
		AND
		NOT DB_Players(_Char)
		AND
		QRY_MOO_IsInMOO(_Char, 0)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_MOO_IsInMOO((CHARACTER)_Char, (INTEGER)_CheckDB)
		AND
		QRY_MOO_IsInMOO(_Char, _CheckDB, NULL_00000000-0000-0000-0000-000000000000)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_MOO_IsInMOO((CHARACTER)_Char, 1, (TRIGGER)_ExcludedTrigger)
		AND
		DB_MOO_InMOOTriggers(_Trigger)
		AND
		_Trigger != _ExcludedTrigger
		AND
		DB_InRegion(_Char, _Trigger)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_MOO_IsInMOO((CHARACTER)_Char, 0, (TRIGGER)_ExcludedTrigger)
		AND
		DB_MOO_InMOOTriggers(_Trigger)
		AND
		_Trigger != _ExcludedTrigger
		AND
		IsInTrigger(_Char, _Trigger, 1)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_MOO_IsInMOO((CHARACTER)_Char, 1, (TRIGGER)_ExcludedTrigger1, (TRIGGER)_ExcludedTrigger2)
		AND
		DB_MOO_InMOOTriggers(_Trigger)
		AND
		_Trigger != _ExcludedTrigger1
		AND
		_Trigger != _ExcludedTrigger2
		AND
		DB_InRegion(_Char, _Trigger)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_MOO_IsInMOO((CHARACTER)_Char, 0, (TRIGGER)_ExcludedTrigger1, (TRIGGER)_ExcludedTrigger2)
		AND
		DB_MOO_InMOOTriggers(_Trigger)
		AND
		_Trigger != _ExcludedTrigger1
		AND
		_Trigger != _ExcludedTrigger2
		AND
		IsInTrigger(_Char, _Trigger, 1)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_MOO_AnyPlayerInMOO()
		AND
		DB_Players(_Player)
		AND
		QRY_MOO_IsInMOO(_Player)
		THEN
		DB_NOOP(1);
		
		IF
		EnteredTrigger(_Char,_Trigger)
		AND
		DB_MOO_InMOOTriggers(_Trigger)
		AND
		IsPlayer(_Char,1)
		AND
		NOT DB_MOO_PlayerInMOO(_Char)
		THEN
		DB_MOO_PlayerInMOO(_Char);
		PROC_MOO_PlayerEnteredMOO(_Char);
		
		IF
		LeftTrigger(_Char,_Trigger)
		AND
		DB_MOO_InMOOTriggers(_Trigger)
		AND
		DB_MOO_PlayerInMOO(_Char)
		AND
		IsPlayer(_Char,1)
		AND
		NOT QRY_MOO_IsInMOO(_Char,0,_Trigger)
		THEN
		NOT DB_MOO_PlayerInMOO(_Char);
		PROC_MOO_PlayerLeftMOO(_Char);
		
		IF
		CharacterJoinedParty(_Char)
		AND
		QRY_MOO_IsInMOO(_Char,1)
		AND
		NOT DB_MOO_PlayerInMOO(_Char)
		THEN
		DB_MOO_PlayerInMOO(_Char);
		PROC_MOO_PlayerEnteredMOO(_Char);
		
		IF
		CharacterLeftParty(_Char)
		AND
		QRY_MOO_IsInMOO(_Char,1)
		AND
		DB_MOO_PlayerInMOO(_Char)
		THEN
		NOT DB_MOO_PlayerInMOO(_Char);
		PROC_MOO_PlayerLeftMOO(_Char);
		
		//General PROC to call whenever MOO is emptied of all players (useful for updating boosters)
		PROC
		PROC_MOO_PlayerLeftMOO((CHARACTER)_Char)
		AND
		NOT DB_MOO_PlayerInMOO(_)
		THEN
		PROC_MOO_AllPlayersLeftMOO();
		
		PROC
		PROC_MOO_AllPlayersLeftMOO()
		THEN
		DB_NOOP(1);
		
		IF
		DB_MOO_PlayerInMOO(_Char)
		AND
		NOT DB_Players((CHARACTER)_Char)
		THEN
		NOT DB_MOO_PlayerInMOO(_Char);
		
		//END_REGION
		
		//REGION Outcast State
		IF
		AttackedBy(S_MOO_Ketheric_e9918f3e-5b87-40a3-a9bd-61545151573f, _Player, _, _, _, _, _)
		AND
		NOT DB_GlobalFlag(GLO_Ketheric_State_PlayerAttacked_2f4e2c6d-b461-4492-b2f0-dd06febb215b)
		AND
		DB_Players((CHARACTER)_Player)
		THEN
		SetFlag(GLO_Ketheric_State_PlayerAttacked_2f4e2c6d-b461-4492-b2f0-dd06febb215b);
		
		PROC
		PROC_State_Changed(S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6, "MOO", "MOO_State_Outcast")
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT2_MOO_Absolute_6b0751e2-fbd4-45e1-92ac-d5edb31649d8, 0);
		
		PROC
		PROC_State_Changed(S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6, "MOO", "MOO_State_Outcast")
		AND
		DB_MOO_Denizens(_Character)
		AND
		DB_DialogNPCs(_ID, _Character, _)
		AND
		DB_DialogPlayers(_ID, _, _)
		THEN
		PROC_ForceStopDialog(_Character);
		
		//Ketheric and Z'rell outcast ADs
		IF
		TurnStarted(S_MOO_Ketheric_e9918f3e-5b87-40a3-a9bd-61545151573f)
		AND
		DB_State_Current(S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6, "MOO", "MOO_State_Outcast")
		AND
		QRY_OnlyOnce("MOO_Outcast_KethericCombatAD")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)MOO_Outcast_AD_KethericCombat_4852d97f-feed-0251-226e-176cb70f1bfc, S_MOO_Ketheric_e9918f3e-5b87-40a3-a9bd-61545151573f);
		
		IF
		TurnStarted(S_MOO_Executioner_8e75eb3b-7551-485e-8f98-2bf2e51d3e84)
		AND
		DB_State_Current(S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6, "MOO", "MOO_State_Outcast")
		AND
		QRY_OnlyOnce("MOO_Outcast_ZrellCombatAD")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)MOO_Outcast_AD_ZrellCombat_4fe29f95-ada9-250c-f128-c9d90c50886f, S_MOO_Executioner_8e75eb3b-7551-485e-8f98-2bf2e51d3e84);
		
		//END_REGION
		
		//REGION Daisy ADs
		IF
		EnteredTrigger(_Avatar, _Trigger)
		AND
		DB_MOO_InsideMoonriseTowerTriggers(_Trigger)
		AND
		DB_Avatars(_Avatar)
		AND
		QRY_State_IsBeforeState(S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6, "MOO", "MOO_State_Audience")
		THEN
		SetFlag(MOO_Daisy_Event_MentionedAbsoluteAudience_3b9d9d5f-3274-4315-99de-e6435085bd72, _Avatar);
		
		IF
		FlagSet(MOO_Daisy_Event_MentionedAbsoluteAudience_3b9d9d5f-3274-4315-99de-e6435085bd72, _Avatar, _)
		AND
		DB_Avatars((CHARACTER)_Avatar)
		THEN
		DB_MOO_Daisy_MentionAbsoluteAudience(_Avatar);
		
		IF
		DB_MOO_Daisy_MentionAbsoluteAudience(_Avatar)
		AND
		NOT DB_CantAct(_Avatar)
		AND
		NOT DB_DaisyAD_Played((CHARACTER)_Avatar,(DIALOGRESOURCE)MOO_Misc_DaisyAD_Audience_b461b657-a83c-fb87-7a38-6173ef08b6f9)
		THEN
		PROC_DaisyAD((CHARACTER)_Avatar, MOO_Misc_DaisyAD_Audience_b461b657-a83c-fb87-7a38-6173ef08b6f9);
		
		//END_REGION
		
		//REGION Audience Behaviour
		IF
		DB_Defeated(S_MOO_BazaarStander_003_efcf317a-dc82-4776-80ef-0f463b09fefe)
		AND
		DB_GlobalFlag(MOO_Audience_State_SulAvailable_5d070fc1-5ec6-4fbe-8694-fe37d3295002)
		THEN
		ClearFlag(MOO_Audience_State_SulAvailable_5d070fc1-5ec6-4fbe-8694-fe37d3295002);
		//END_REGION
		
		//REGION Waypoint
		
		IF
		FlagSet((FLAG)MOO_EntranceCheckpoint_State_HasEnteredInterior_13ffee84-f71d-4356-b257-8716f28c990a, _, _)
		THEN
		PROC_UnlockWaypointForAll("WAYP_MOO_TowerExterior");
		
		//END_REGION
		
		//REGION Crimes
		
		PROC
		PROC_CharacterRegisterCrime_Success(_Criminal, _CrimeType, _StoryActionID, _Evidence, _Victim, _CrimeID)
		AND
		DB_InRegion(_Criminal, S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6)
		AND
		GetFaction(_Victim, ACT2_MOO_Assault_Hostile_68597716-e217-4777-a391-026263f291b4)
		AND
		DB_SCE_Debrief_CharactersInEpilogue(_Character)
		THEN
		CrimeIgnoreCrime(_CrimeID, _Character);
		
		PROC
		PROC_CharacterRegisterCrime_Success(_Criminal, _CrimeType, _StoryActionID, _Evidence, _Victim, _CrimeID)
		AND
		DB_InRegion(_Criminal, S_MOO_Prison_SUB_b262cbea-f40c-47da-9f34-ba8ce5bf782b)
		AND
		GetFaction(_Victim, ACT2_MOO_Assault_Hostile_68597716-e217-4777-a391-026263f291b4)
		AND
		DB_SCE_Debrief_CharactersInEpilogue(_Character)
		THEN
		CrimeIgnoreCrime(_CrimeID, _Character);
		
		PROC
		PROC_CharacterRegisterCrime_Success(_Criminal, _CrimeType, _StoryActionID, _Evidence, _Victim, _CrimeID)
		AND
		DB_InRegion(_Criminal, S_MOO_UpperFloorInterior_SUB_93c522d3-04c4-4f71-a1dc-043478c51301)
		AND
		GetFaction(_Victim, ACT2_MOO_Assault_Hostile_68597716-e217-4777-a391-026263f291b4)
		AND
		DB_SCE_Debrief_CharactersInEpilogue(_Character)
		THEN
		CrimeIgnoreCrime(_CrimeID, _Character);
		
		
		//END_REGION
		
		//REGION Assault Body Clean up
		//We don't want to clear any corpses till the player has proceeded to colony or long rested after Ketheric escaped
		IF
		DB_CorpseCleanup_ReadyToBeRemoved(_Corpse)
		AND
		DB_MOO_AssaultPositions((CHARACTER)_Corpse, _, _Group)
		AND
		NOT DB_MOO_Assault_AllyGroups(_Group)
		AND
		DB_State_Current(S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6, "MOO", "MOO_State_Assault")
		AND
		NOT DB_GlobalFlag(COL_PartyProgress_EnteredColony_666abe92-f197-4c38-85a8-d879a9e258b6)
		THEN
		DB_MOO_Assault_CorpseCleanup(_Corpse);
		
		PROC
		PROC_MOO_Assault_KillCharacter((CHARACTER)_Char, (DEATHTYPE)_)
		AND
		NOT DB_MOO_Assault_CorpseCleanup(_Char)
		THEN
		DB_MOO_Assault_CorpseCleanup(_Char);
		
		PROC
		PROC_LongRest()
		AND
		DB_GlobalFlag(MOO_Assault_Event_KethericTeleportedAway_ba71e8cd-8922-61a4-a2ff-8c5f5ff8aac6)
		AND
		QRY_OnlyOnce("MOO_Assault_BodyCleanup")
		THEN
		PROC_MOO_Assault_CleanUpDeadBodies();
		
		PROC
		PROC_COL_TeleportPartiesToColony(_)
		AND
		QRY_OnlyOnce("MOO_Assault_BodyCleanup")
		THEN
		PROC_MOO_Assault_CleanUpDeadBodies();
		
		PROC
		PROC_MOO_Assault_CleanUpDeadBodies()
		AND
		DB_MOO_Assault_CorpseCleanup(_Corpse)
		THEN
		PROC_MOO_Assault_AllyGnollsLeave();
		PROC_MOO_Assault_TryCorpseCleanUp(_Corpse);
		NOT DB_MOO_Assault_CorpseCleanup(_Corpse);
		
		PROC
		PROC_MOO_Assault_TryCorpseCleanUp((CHARACTER)_Corpse)
		AND
		DB_Dead(_Corpse) 
		AND
		NOT DB_CanBeResurrected(_Corpse) 
		AND
		IsInInventory(_Corpse, 0)
		AND
		GetRegion(_Corpse,_Region)
		AND
		DB_CurrentLevel(_Region) 
		AND
		NOT DB_OffStage(_Corpse)
		THEN
		PROC_CorpseCleanup_RemoveCorpse((CHARACTER)_Corpse);
		
		PROC
		PROC_MOO_Assault_AllyGnollsLeave()
		AND
		QRY_OnlyOnce("MOO_AllyGnollsLeaveOnce")
		AND
		DB_MOO_AssaultPositions(_Gnoll, _, "MOO_Assault_GnollAlly")
		AND
		NOT DB_PermaDefeated(_Gnoll)
		THEN
		SetOnStage(_Gnoll, 0);
		
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(394).Title("Act2_MOO_NecromancerRoom");
Goal(394)
{
	INIT
	{
		//REGION Balthazar's Secrets
		SetOnStage(S_MOO_HeartKey_12303d80-c793-4fea-93f0-73e57d57e56f, 0);
		
		SetCanInteract(S_MOO_HeartBox_93307c10-c4ac-4b05-aa8e-bc1436f21bb3, 0);
		
		DB_BookFlags(S_MOO_BalthazarSecretBook_8f90de22-6a7c-4579-a966-73c0d80d7a54,MOO_BalthazarsSecrets_Knows_NightsongSecret_3599ecf9-382d-46b7-8c72-c7d99303d7c4);
		
		/*
		DB_MOO_BalthazarsSecrets_ValidPart((ITEMROOT)DEC_GEN_Corpse_Body_Part_DecapitedHead_A_06fb21d6-d53d-4f97-9d1f-3598191618bc);
		DB_MOO_BalthazarsSecrets_ValidPart((ITEMROOT)DEC_GEN_Corpse_Body_Part_DecapitedHead_B_fc6a7f8a-f673-4126-9441-4aae62ae48ba);
		DB_MOO_BalthazarsSecrets_ValidPart((ITEMROOT)DEC_GEN_Corpse_Body_Part_DecapitedHead_C_72f8dff6-076c-4ff4-b53b-75cde0fde28e);
		DB_MOO_BalthazarsSecrets_ValidPart((ITEMROOT)LOOT_BODYPART_HeadElfFemale_05a9cbf9-cc11-4f48-b3ad-ef04f6723fc0);
		DB_MOO_BalthazarsSecrets_ValidPart((ITEMROOT)DEC_GEN_Corpse_Body_Part_HeadFemale_A_80469bc6-d30e-4f96-b483-58245ef92b6f);
		DB_MOO_BalthazarsSecrets_ValidPart((ITEMROOT)DEC_GEN_Corpse_Body_Part_HeadFemale_A_Githyanki_73a92602-a779-47c3-9c92-408d2225daf6);
		DB_MOO_BalthazarsSecrets_ValidPart((ITEMROOT)DEC_GEN_Corpse_Body_Part_HeadFemale_A_Tiefling_afe2be1f-d8c6-4615-8cef-c7106086daf0);
		DB_MOO_BalthazarsSecrets_ValidPart((ITEMROOT)DEC_GEN_Corpse_Body_Part_HeadMale_A_d691066b-8592-49a4-8e94-a32b6433997c);
		DB_MOO_BalthazarsSecrets_ValidPart((ITEMROOT)DEC_GEN_Corpse_Body_Part_HeadMale_A_Githyanki_03d94b9b-3926-4570-a95f-cfb2da22678d);
		DB_MOO_BalthazarsSecrets_ValidPart((ITEMROOT)DEC_GEN_Corpse_Body_Part_HeadMale_A_Tiefling_5f18ac06-e4df-488b-97c7-162bdb522555);
		DB_MOO_BalthazarsSecrets_ValidPart((ITEMROOT)LOOT_GEN_Heart_A_ce6d496d-f5f3-4e21-8ca6-1255824078de);
		DB_MOO_BalthazarsSecrets_ValidPart((ITEMROOT)UNI_UND_MyconidRevenge_NereHead_6acd3cfa-3dcc-4b42-ad25-ca898ce237f7);
		*/
		
		DB_MOO_BalthazarsSecrets_TrapBooks((ITEM) S_MOO_TrapBook_001_bb48a971-aad4-4c10-8907-addb6d32ba94);
		DB_MOO_BalthazarsSecrets_TrapBooks(S_MOO_TrapBook_002_55f57258-967e-4137-95a3-be396121a308);
		DB_MOO_BalthazarsSecrets_TrapBooks(S_MOO_TrapBook_003_760c687e-1412-4845-9060-9b7eba5f5f01);
		DB_MOO_BalthazarsSecrets_TrapBooks(S_MOO_TrapBook_004_02691ba1-8698-4b61-ab35-47f2bd5bb3f1);
		
		PROC_TriggerRegisterForPlayers((TRIGGER)S_MOO_NecroDiscoverBox_5cdda27f-d3ce-4e6d-b6d0-e08499aa9fe6);
		
		DB_MOO_BalthazarsSecrets_Spikes((ITEM)S_BookSpikes_001_e32a8860-c9e0-4b8b-ad3b-7da437929c16);
		DB_MOO_BalthazarsSecrets_Spikes((ITEM)S_BookSpikes_002_b9372af3-bbcb-4783-b617-1a70bf0181a3);
		
		PlayAnimation(S_BookSpikes_001_e32a8860-c9e0-4b8b-ad3b-7da437929c16, OBJ_Use_Deactivate_01_bb1e8405-8773-46d1-92c8-9f42d900922b, "");
		PlayAnimation(S_BookSpikes_002_b9372af3-bbcb-4783-b617-1a70bf0181a3, OBJ_Use_Deactivate_01_bb1e8405-8773-46d1-92c8-9f42d900922b, "");
		//END_REGION
		
		DB_OneShotPlayerTrigger((TRIGGER)S_MOO_Necromancer_Chamber_Daisy_3040403d-cd2c-4312-8045-6e06efe74dcf);
	}
	KB
	{
		//REGION Debug
		IF
		TextEvent("balthsecrets_openbookdoor")
		THEN
		SetFlag(MOO_BalthazarsSecrets_State_BookcaseOpened_f24ceb4a-5095-4509-8daa-406dbf8f8685);
		
		IF
		TextEvent("balthsecrets_allowdoors")
		THEN
		PROC_MOO_BalthazarsSecrets_AllowDoors();
		
		IF
		FlagSet(Debug_MOO_BalthazarsSecrets_AddBook_1f0cb439-fab0-4ecf-9c70-7072304588bf, _Player, _)
		THEN
		ClearFlag(Debug_MOO_BalthazarsSecrets_AddBook_1f0cb439-fab0-4ecf-9c70-7072304588bf, _Player);
		ToInventory(S_MOO_BalthazarSecretBook_8f90de22-6a7c-4579-a966-73c0d80d7a54,_Player,1,0,1);
		
		IF
		TextEvent("balthsecrets_getheartkey")
		AND
		GetHostCharacter(_Player)
		THEN
		PROC_ToInventoryAndOnStage(S_MOO_HeartKey_79c71f06-0999-48b3-bed8-eca4e1e8c1a1, _Player, 1, 0, 1);
		
		IF
		FlagSet(Debug_MOO_BalthazarsSecrets_AddBook_1f0cb439-fab0-4ecf-9c70-7072304588bf, _Player, _)
		THEN
		ClearFlag(Debug_MOO_BalthazarsSecrets_AddBook_1f0cb439-fab0-4ecf-9c70-7072304588bf, _Player);
		ToInventory(S_MOO_BalthazarSecretBook_8f90de22-6a7c-4579-a966-73c0d80d7a54,_Player,1,0,1);
		//END_REGION
		//REGION Lever Door
		IF
		EntityEvent(S_MOO_BalthazarLever_40f9b074-b09e-423f-973f-75b62a0e9af0, "MOO_BalthazarLever_Unlock")
		THEN
		PROC_ItemUnlockAndOpen(S_MOO_NecroRoomDoor_003_99432bb0-3ca4-4d42-ae2d-648cbb63edff);
		
		IF
		EntityEvent(S_MOO_BalthazarLever_40f9b074-b09e-423f-973f-75b62a0e9af0, "MOO_BalthazarLever_Lock")
		THEN
		PROC_ItemCloseAndLock(S_MOO_NecroRoomDoor_003_99432bb0-3ca4-4d42-ae2d-648cbb63edff, "STORYLOCK");
		//END_REGION
		//REGION Allowing access
		//When Z'rell gives the mission to find Balthazar and allows players to search his room
		PROC
		PROC_MOO_BalthazarsSecrets_AllowDoors()
		AND
		NOT DB_Destroyed(S_MOO_NecroRoomDoor_001_fa33a896-363c-49a0-8618-7d9555bafaae)
		THEN
		ClearOwnership(S_MOO_NecroRoomDoor_001_fa33a896-363c-49a0-8618-7d9555bafaae);
		//END_REGION
		//REGION Perception Book Levers
		//3 of the 4 books have thier perception distance at 0, so the character should only roll for the one,
		//but apply that result for all. 
		PROC
		PROC_HiddenPerceptionCheckSucceeded(_,(CHARACTER)_Player,S_MOO_TrapBook_001_bb48a971-aad4-4c10-8907-addb6d32ba94)
		AND
		QRY_OnlyOnce("MOO_BalthazarsSecrets_BookPerceptionAD")
		THEN
		PROC_MOO_BalthazarsSecrets_HiddenCheckAllBooks(_Player,S_MOO_TrapBook_001_bb48a971-aad4-4c10-8907-addb6d32ba94, 1);
		
		PROC 
		PROC_RollResult("GLO_HiddenItemCheck", _Player, S_MOO_TrapBook_001_bb48a971-aad4-4c10-8907-addb6d32ba94, 0)
		AND
		NOT DB_PerceptionSkillCheck((CHARACTER)_Player,(ITEM)S_MOO_TrapBook_001_bb48a971-aad4-4c10-8907-addb6d32ba94,_)
		THEN
		PROC_MOO_BalthazarsSecrets_HiddenCheckAllBooks(_Player,S_MOO_TrapBook_001_bb48a971-aad4-4c10-8907-addb6d32ba94, 0);
		
		PROC
		PROC_MOO_BalthazarsSecrets_HiddenCheckAllBooks((CHARACTER)_Player, (ITEM)_RevealedBook, (INTEGER)_Succeeded)
		AND
		DB_MOO_BalthazarsSecrets_TrapBooks(_Book)
		AND
		_Book != _RevealedBook
		THEN
		DB_PerceptionSkillCheck(_Player,_Book, _Succeeded);
		
		PROC
		PROC_MOO_BalthazarsSecrets_HiddenCheckAllBooks((CHARACTER)_Player, (ITEM)_RevealedBook, 1)
		AND
		DB_MOO_BalthazarsSecrets_TrapBooks(_Book)
		AND
		_Book != _RevealedBook
		THEN
		SetEntityEvent(_Book,"StoryReveal");
		//END_REGION
		//REGION Balthazar's Secrets - Traps
		IF
		DualEntityEvent( _, S_MOO_TrapBook_001_bb48a971-aad4-4c10-8907-addb6d32ba94, "MOO_BalthazarsSecrets_ActivateHeartBox")
		AND
		NOT DB_GlobalFlag(MOO_BalthazarsSecrets_State_HeartBoxActive_23f22a42-3fc4-491b-aefd-4a4b52257735)
		THEN
		PROC_PlayPerceptionRevealEffect(S_MOO_HeartBox_93307c10-c4ac-4b05-aa8e-bc1436f21bb3, "MOO_BalthazarsSecrets_HeartBoxVFX");
		SetFlag(MOO_BalthazarsSecrets_State_HeartBoxActive_23f22a42-3fc4-491b-aefd-4a4b52257735);
		
		PROC
		PROC_BlockUseOfItem(_Player, S_MOO_TrapBook_001_bb48a971-aad4-4c10-8907-addb6d32ba94)
		AND
		DB_GlobalFlag(MOO_BalthazarsSecrets_State_HeartBoxActive_23f22a42-3fc4-491b-aefd-4a4b52257735)
		THEN
		DB_CustomUseItemResponse(_Player, S_MOO_TrapBook_001_bb48a971-aad4-4c10-8907-addb6d32ba94, 0);
		PROC_TryStartAD((DIALOGRESOURCE)GEN_AD_ItemBlocked_a4eb2e7b-809a-a9e4-94da-955a8ac9b8c6, _Player);
		
		IF
		DualEntityEvent(_, S_MOO_TrapBook_003_760c687e-1412-4845-9060-9b7eba5f5f01, "MOO_BalthazarsSecrets_Spikes")
		AND
		DB_MOO_BalthazarsSecrets_Spikes((ITEM)_Spike)
		THEN
		PlayAnimation(_Spike, OBJ_Use_Activate_01_42c02cc0-0503-4ca9-9ea0-45564bd0e5d4, "");
		UseSpell(_Spike, "Projectile_MOO_BookSpikeTrap", _Spike);
		
		IF
		EntityEvent(_Spike, "MOO_BalthazarsSecrets_SpikesOff")
		AND
		DB_MOO_BalthazarsSecrets_Spikes((ITEM)_Spike)
		THEN
		PlayAnimation(_Spike, OBJ_Use_Deactivate_01_bb1e8405-8773-46d1-92c8-9f42d900922b, "");
		//END_REGION
		//REGION Balthazar's Secrets - Spike Altar
		IF
		FlagSet(MOO_BalthazarsSecrets_State_HeartBoxActive_23f22a42-3fc4-491b-aefd-4a4b52257735, _, _)
		THEN
		SetCanInteract(S_MOO_HeartBox_93307c10-c4ac-4b05-aa8e-bc1436f21bb3, 1);
		PROC_TryStartAD((DIALOGRESOURCE)GLO_AD_MechanicalClick_fc8d3dc5-b947-6354-3aa9-d1f02fd51af4,S_MOO_HeartBox_93307c10-c4ac-4b05-aa8e-bc1436f21bb3);
		
		IF
		Combined(S_MOO_HeartBox_93307c10-c4ac-4b05-aa8e-bc1436f21bb3,_BodyPart,_,_,_,_Player,_)
		THEN
		SetFlag(MOO_BalthazarsSecrets_State_BookcaseOpened_f24ceb4a-5095-4509-8daa-406dbf8f8685);
		PlayEffect(S_MOO_PlacedBodypartPoint_efe932f9-13d0-4034-84e2-98d4abdc67ef, (EFFECTRESOURCE)VFX_Script_DestroyAction_BodyPart_01_3f8410a6-f5c8-02f5-4c2a-2da18df8728b);
		PROC_TryStartAD(GLO_PerceptionSuccess_48825dbe-a320-7c4c-fe3e-372b717d5bc9, _Player); //Some reactivity to the door opening
		
		//END_REGION
		//REGION Balthazar's Secrets - Bookcase Door
		IF
		FlagSet(MOO_BalthazarsSecrets_State_BookcaseOpened_f24ceb4a-5095-4509-8daa-406dbf8f8685, _, _)
		THEN
		Open(S_MOO_BookcaseDoor_e6f5e44f-dda9-4a92-9d39-d8675b31af67);
		//END_REGION
		//REGION Secret Book Dialog
		PROC
		PROC_BookFlags_FlagSet((ITEM)S_MOO_BalthazarSecretBook_8f90de22-6a7c-4579-a966-73c0d80d7a54,(FLAG)MOO_BalthazarsSecrets_Knows_NightsongSecret_3599ecf9-382d-46b7-8c72-c7d99303d7c4,(CHARACTER)_Player)
		AND
		DB_Players(_Player)
		AND
		NOT DB_GlobalFlag(SHA_Nightsong_HasMet_6b56f4b8-8bb3-5393-de12-d320fbb55218) //No point in this dialog if the player met Nightsong
		THEN
		DB_MOO_BalthazarsSecrets_ReadyVB(_Player);
		
		IF
		DB_MOO_BalthazarsSecrets_ReadyVB((CHARACTER)_Player)
		AND
		NOT DB_CantAct(_Player)
		AND
		QRY_OnlyOnce("MOO_BalthazarsSecrets_NightsongInfoVB")
		THEN
		StartVoiceBark(MOO_BalthazarsSectrets_VB_NightsongInfo_05767661-c649-6b6d-c0c8-7be13cabb470, _Player);
		NOT DB_MOO_BalthazarsSecrets_ReadyVB((CHARACTER)_Player);
		//END_REGION
		
		PROC
		PROC_OneShotTriggerEntered(_Player,(TRIGGER)S_MOO_Necromancer_Chamber_Daisy_3040403d-cd2c-4312-8045-6e06efe74dcf)
		THEN
		PROC_DaisyAD(_Player,(DIALOGRESOURCE)COL_Necromancer_DaisyAD_Balthazar_b2437b3c-8491-c1e9-9e60-04592903e367);
		
		PROC
		PROC_COL_TeleportPartiesToColony(_)
		THEN
		NOT DB_OneShotPlayerTrigger((TRIGGER)S_MOO_Necromancer_Chamber_Daisy_3040403d-cd2c-4312-8045-6e06efe74dcf);
	}
	EXIT
	{
	}
}
Goal(395).Title("Act2_MOO_NightsongDeath");
Goal(395)
{
	INIT
	{
		//A simplified variation of Act2_MOO_Assault/PreAssault
		
		//Possible functions:
		//  - Move some characters to new locations (like DB_MOO_AssaultPositions, but simplified)
		//  - Close loose ends (Prisoners killed, cancel execution)
		//  - Destroy Haven (handled by HAV scripters)
		
		DB_MOO_NightsongDeath_Positions((CHARACTER)S_MOO_Executioner_8e75eb3b-7551-485e-8f98-2bf2e51d3e84,(TRIGGER)S_MOO_NSDeathZrellPoint_ff75df90-edac-49f6-9f0f-915f2b2ba135);
		DB_MOO_NightsongDeath_Positions(S_MOO_EntranceGuard_001_b302d246-59ff-48ee-8247-0e3bcfd4b38e, S_MOO_NSDeathPositionPoint_001_704e464f-5095-41fe-96af-ada650f47e36);
		DB_MOO_NightsongDeath_Positions(S_MOO_EntranceGuard_002_2ab30cea-d3f1-4aa4-8c83-b8b700ef0048, S_MOO_NSDeathPositionPoint_002_fb97e463-a5c4-41d5-9a50-4081740daec4);
		DB_MOO_NightsongDeath_Positions(S_MOO_EntranceGhoul_001_c9b6a714-491a-40aa-b5b6-3fe608a4efb5, S_MOO_NSDeathPositionPoint_003_ce918830-0812-4f08-b398-951c5325a72d);
		DB_MOO_NightsongDeath_Positions(S_MOO_EntranceGhoul_002_2e7447e5-35dd-4cdd-8426-43a6afe0edc7, S_MOO_NSDeathPositionPoint_004_b2472290-39bb-4db0-a086-03edeb8d3bbc);
		DB_MOO_NightsongDeath_Positions(S_MOO_EntranceGhoul_003_019af169-5366-4a1f-8392-35df658b2e8e, S_MOO_NSDeathPositionPoint_005_4854821b-6959-471a-a8c0-ceb20428ed7a);
		DB_MOO_NightsongDeath_Positions(S_MOO_BazEntranceGuard_002_1a7719bc-9f42-4405-a07d-5d54af11ef0b, S_MOO_NSDeathPositionPoint_006_336460ac-86b2-4ce4-8b0c-245beada2d39);
		DB_MOO_NightsongDeath_Positions(S_MOO_BazEntranceGuard_001_8fdd2eba-9e1e-48b6-a201-787616541dd9, S_MOO_NSDeathPositionPoint_007_4f1780d4-1061-495d-9c50-8fe8aeb67cf1);
		DB_MOO_NightsongDeath_Positions(S_MOO_BazaarGuard_000_1d5cdba7-f2e4-4568-9bb8-94abcf9081d6, S_MOO_NSDeathPositionPoint_008_e71ee06b-a02f-4c72-8831-2c8712d087ad);
		DB_MOO_NightsongDeath_Positions(S_MOO_BazaarGuard_001_8843e9dc-b0dc-4c64-991f-7f512dd12dc0, S_MOO_NSDeathPositionPoint_009_3c504581-d109-452e-b232-8b02e6c99df2);
		
		DB_MOO_NightsongDeath_Positions(S_MOO_AccessCultist_7f0f8d11-9d1e-4210-bbcb-41aa05666d58, S_MOO_NSDeathPositionPoint_010_7bdc914b-aa27-4066-be9a-e118a9f1e1dc);
		DB_MOO_NightsongDeath_Positions(S_MOO_AudienceGuard_002_50eed113-2a6a-469d-ba8e-a9fd44be681b, S_MOO_NSDeathPositionPoint_011_b4972c23-7b1a-4533-9c87-6fbccdfad468);
		DB_MOO_NightsongDeath_Positions(S_MOO_AudienceGuard_001_f986110c-7451-417a-89e2-b2628e200c4d, S_MOO_NSDeathPositionPoint_012_670a672c-092a-461a-bc2c-10533d046900);
		DB_MOO_NightsongDeath_Positions(S_MOO_AudienceGuard_003_c9c185bb-ca0d-46b7-b0da-bf6364a96e15, S_MOO_NSDeathPositionPoint_013_37f09999-02b2-492b-8347-63e6ea285bc3);
		
		//Any character we would want to set off stage like merchants
		DB_NightsongDeath_OffStage((CHARACTER)S_GOB_Quartermaster_646936f3-8d8d-484e-9361-cd1ed484c615);
		DB_NightsongDeath_OffStage(S_GOB_ZhentarimGuard_Ranger_01_4b9818fa-cca6-4bad-b382-4c01334ef22a);
		DB_NightsongDeath_OffStage(S_GOB_ZhentarimGuard_Ranger_02_afc5350d-dc9f-4808-b6ce-d7b1bb7c8229);
		DB_NightsongDeath_OffStage(S_MOO_InfernalVendor_511c9413-25fe-449c-a81d-4b09bc20745a);
		DB_NightsongDeath_OffStage(S_MOO_BazaarStander_007_f152d3c1-fe32-403f-9d7f-2f1049912e0f);
		DB_NightsongDeath_OffStage(S_MOO_BazaarStander_006_5e4c22f4-1122-4822-bc16-ba49d3cb701e);
		DB_NightsongDeath_OffStage(S_MOO_BazaarStander_005_c31c6739-c991-490e-9857-2a3367042727);
		DB_NightsongDeath_OffStage(S_MOO_BazaarStander_004_a6211285-d412-42c5-8c1c-ffe7feca2e09);
		
		DB_MOO_NightsongDeath_ZrellEntranceGroup((CHARACTER)S_MOO_EntranceGuard_001_b302d246-59ff-48ee-8247-0e3bcfd4b38e);
		DB_MOO_NightsongDeath_ZrellEntranceGroup(S_MOO_EntranceGuard_002_2ab30cea-d3f1-4aa4-8c83-b8b700ef0048);
		DB_MOO_NightsongDeath_ZrellEntranceGroup(S_MOO_EntranceGhoul_001_c9b6a714-491a-40aa-b5b6-3fe608a4efb5);
		DB_MOO_NightsongDeath_ZrellEntranceGroup(S_MOO_EntranceGhoul_002_2e7447e5-35dd-4cdd-8426-43a6afe0edc7);
		DB_MOO_NightsongDeath_ZrellEntranceGroup(S_MOO_EntranceGhoul_003_019af169-5366-4a1f-8392-35df658b2e8e);
		DB_MOO_NightsongDeath_ZrellEntranceGroup(S_MOO_Executioner_8e75eb3b-7551-485e-8f98-2bf2e51d3e84);
		
		//Characters that shouldn't attack the player
		DB_MOO_NightsongDeath_NeutralCharacters((CHARACTER)NULL_00000000-0000-0000-0000-000000000000);
		NOT DB_MOO_NightsongDeath_NeutralCharacters((CHARACTER)NULL_00000000-0000-0000-0000-000000000000);
		
		DB_MOO_NightsongDeath_DaisyADTriggers((TRIGGER)S_MOO_DaisyADWarningBox_001_1f452dfa-b490-45eb-9baf-2d4f3523090a);
		DB_MOO_NightsongDeath_DaisyADTriggers((TRIGGER)S_MOO_DaisyADWarningBox_002_cc3f6f71-d929-4af6-affb-d194c5c8c046);
	}
	KB
	{
		//REGION Debug
		
		IF
		TextEvent("moonightsongdeath_alive")
		THEN
		PROC_MOO_NightsongDeath_DEBUG_Setup();
		
		IF
		TextEvent("moonightsongdeath_dead")
		THEN
		PROC_MOO_NightsongDeath_DEBUG_Setup();
		Die(S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211, DEATHTYPE.Physical, NULL_00000000-0000-0000-0000-000000000000, 0, 1, 0.0);
		PROC_State_Progress(S_HAV_Haven_SUB_6ac001f4-9c56-4a1b-963d-a509e158ffab, "HAV_Mood", "HAV_Mood_State_Siege");
		PROC_MOO_NightsongDeath_DEBUG_Setup();
		
		IF
		TextEvent("moonightsongdeath_tadpole")
		THEN
		PROC_State_Progress(S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211, "HAV_Isobel", "HAV_Isobel_State_AtMoonrise");
		PROC_MOO_ZrellBriefing_SetupFlamingSpy();
		SysCompleteGoal("Act2_HAV_TakingIsobel_FlamingSpy");
		PROC_MOO_NightsongDeath_DEBUG_Setup();
		
		PROC
		PROC_MOO_NightsongDeath_DEBUG_Setup()
		AND
		GetHostCharacter(_Player)
		THEN
		TeleportTo(_Player, S_MOO_TowerExterior_Waypoint_Pos_8fd66a2b-7b29-44f9-b6dd-cd957c91d19c);
		PROC_MOO_Execution_ForceResolve();
		PROC_SceneOver("SHA_NightsongPrison_MeetingNightsong");
		PROC_SHA_Nightsong_PermaKill((CHARACTER)_Player);
		Die(S_SHA_Nightsong_6c55edb0-901b-4ba4-b9e8-3475a8392d9b, DEATHTYPE.Physical, NULL_00000000-0000-0000-0000-000000000000, 0, 1, 0.0);
		SetFlag(SHA_Nightsong_State_PermaDefeated_d02e8ea4-dec7-4824-8117-efc075dee4ba); //Manually setting to unblock writers, as triggering this debug while Nightsone is not active will not properly change her state from her status change
		SetFlag(SHA_NightsongPrison_State_NightsongFateDecided_4a61bbda-83ef-2738-e366-d3d3a4fa75e3);
		SetFlag((FLAG)SHA_NightsongPrison_State_ShadowheartKilledNightsong_3cac3cd6-4c16-44a6-8246-a91922821169);
		//END_REGION
		
		//REGION Setup
		PROC
		PROC_State_Changed(S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6, "MOO", "MOO_State_Assault")
		THEN
		GoalCompleted;
		
		IF
		FlagSet(MOO_Necromancer_State_AtMoonrise_f64507bf-aa53-6de9-0b59-c19d649bb0a5, _, _)
		THEN
		GoalCompleted;
		
		PROC
		PROC_State_Changed(S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6, "MOO", "MOO_State_NightsongDeath")
		THEN
		PROC_SpotPlayers_StopSpotting(S_MOO_RoofCultist_ebfd7bc7-0fd5-4dee-8fd5-308ded4d0a65, "MOO_Audience_GreetingAD");
		PROC_MOO_NightsongDeath_AddDriderCaravan();
		PROC_MOO_Assault_ForceResolveFlamingSpy();
		PROC_MOO_Execution_ForceResolve();
		PROC_TWN_MarchingArmy_RemoveArmyArrest();
		DB_DangerZone((TRIGGER)S_MOO_DangerZoneTrigger_31e89040-1673-46df-b12c-227f1714475a, "MOO_Assault_DangerZone");
		DB_DangerZone((TRIGGER)S_MOO_Prison_SUB_b262cbea-f40c-47da-9f34-ba8ce5bf782b, "MOO_Assault_DangerZone");
		PROC_SetRelationToPlayers((FACTION)ACT2_MOO_Absolute_6b0751e2-fbd4-45e1-92ac-d5edb31649d8, 0);
		Close(S_MOO_MainTowerEntrance_c9007d4d-8dfe-4b1a-a8cd-7b489710d29e);
		PROC_MOO_NightsongDeath_CheckSetupZrell();
		PROC_MOO_NightsongDeath_SetTower();
		PROC_MOO_NightsongDeath_SetRoofTop();
		
		PROC
		PROC_MOO_NightsongDeath_AddDriderCaravan()
		AND
		DB_SCL_Drider_CaravanMemberInTower(_Char)
		AND
		NOT DB_PermaDefeated(_Char)
		AND
		_Char != S_SCL_Drider_aa59ce01-3d2e-42e8-a539-c07e0ea292ab
		AND
		NOT DB_MOO_NightsongDeath_Positions(_Char, _)
		THEN
		DB_NightsongDeath_OffStage(_Char);
		
		PROC
		PROC_MOO_NightsongDeath_CheckSetupZrell()
		AND
		NOT DB_PermaDefeated(S_MOO_Executioner_8e75eb3b-7551-485e-8f98-2bf2e51d3e84)
		AND
		QRY_MOO_NightsongDeath_ZrellWillTalk()
		THEN
		DB_SpotPlayers(S_MOO_Executioner_8e75eb3b-7551-485e-8f98-2bf2e51d3e84, "MOO_NightsongDeath_ZrellGreeting", (FLAG)NULL_00000000-0000-0000-0000-000000000000, (FLAG)NULL_00000000-0000-0000-0000-000000000000);
		DB_SpotPlayers_SpotTrigger(S_MOO_Executioner_8e75eb3b-7551-485e-8f98-2bf2e51d3e84, "MOO_NightsongDeath_ZrellGreeting", S_MOO_NSDeathZrellGreetingBox_01bb6c46-f8d3-428c-a03c-eea0d2fbb26a);
		
		PROC
		PROC_MOO_NightsongDeath_CheckSetupZrell()
		AND
		NOT DB_PermaDefeated(S_MOO_Executioner_8e75eb3b-7551-485e-8f98-2bf2e51d3e84)
		THEN
		ApplyStatus(S_MOO_Executioner_8e75eb3b-7551-485e-8f98-2bf2e51d3e84,"MIRROR_IMAGE_3",-1.0,1,S_MOO_Executioner_8e75eb3b-7551-485e-8f98-2bf2e51d3e84); //Combat statuses for Z'Rell when Assault starts
		ApplyStatus(S_MOO_Executioner_8e75eb3b-7551-485e-8f98-2bf2e51d3e84,"MIRROR_IMAGE_2",-1.0,1,S_MOO_Executioner_8e75eb3b-7551-485e-8f98-2bf2e51d3e84);
		ApplyStatus(S_MOO_Executioner_8e75eb3b-7551-485e-8f98-2bf2e51d3e84,"MIRROR_IMAGE_1",-1.0,1,S_MOO_Executioner_8e75eb3b-7551-485e-8f98-2bf2e51d3e84);
		
		PROC
		PROC_MOO_NightsongDeath_CheckSetupZrell()
		AND
		NOT DB_PermaDefeated(S_MOO_Executioner_8e75eb3b-7551-485e-8f98-2bf2e51d3e84)
		AND
		DB_Defeated(S_MOO_Executioner_8e75eb3b-7551-485e-8f98-2bf2e51d3e84)
		THEN
		PROC_CharacterFullRestore(S_MOO_Executioner_8e75eb3b-7551-485e-8f98-2bf2e51d3e84);
		
		//If Zrell is dead, it would not make sense to have the characters to be set up as if she was there
		PROC
		PROC_MOO_NightsongDeath_CheckSetupZrell()
		AND
		DB_PermaDefeated(S_MOO_Executioner_8e75eb3b-7551-485e-8f98-2bf2e51d3e84)
		AND
		DB_MOO_NightsongDeath_Positions(_Char, _Trigger)
		AND
		DB_MOO_NightsongDeath_ZrellEntranceGroup(_Char)
		THEN
		NOT DB_MOO_NightsongDeath_Positions(_Char, _Trigger);
		NOT DB_MOO_NightsongDeath_ZrellEntranceGroup(_Char);
		
		//Move around a few characters. Bulk will not be changed 
		PROC
		PROC_MOO_NightsongDeath_SetTower()
		AND
		DB_MOO_NightsongDeath_Positions(_Char, _Point)
		AND
		NOT DB_PermaDefeated(_Char)
		THEN
		PROC_MOO_NightsongDeath_SetPositions((CHARACTER)_Char,(TRIGGER)_Point);
		
		//Set some characters off stage
		PROC
		PROC_MOO_NightsongDeath_SetTower()
		AND
		DB_NightsongDeath_OffStage(_Char)
		AND
		NOT DB_PermaDefeated(_Char)
		THEN
		SetOnStage(_Char, 0);
		NOT DB_NightsongDeath_OffStage(_Char);
		
		//Set some characters as neutral
		PROC
		PROC_MOO_NightsongDeath_SetTower()
		AND
		DB_MOO_NightsongDeath_NeutralCharacters(_Char)
		THEN
		SetFaction(_Char, (FACTION)ACT2_MOO_Assault_Neutral_495e3f88-4e4d-47b0-b275-5daf3442430b);
		
		PROC
		PROC_MOO_NightsongDeath_SetTower()
		AND
		DB_MOO_NightsongDeath_DaisyADTriggers(_Trigger)
		THEN
		PROC_TriggerRegisterForPlayers(_Trigger);
		
		//Use existing Assault layout for rooftop (might want to use it's own DB? If so, will need to make small adjustments to Assault_BossFight)
		PROC
		PROC_MOO_NightsongDeath_SetRoofTop()
		AND
		DB_MOO_AssaultPositions((CHARACTER)_Char,(TRIGGER)_Point, "MOO_Assault_RooftopEnemies")
		AND
		NOT DB_PermaDefeated(_Char)
		THEN
		SetOnStage(_Char, 1);
		PROC_MOO_NightsongDeath_SetPositions((CHARACTER)_Char,(TRIGGER)_Point);
		SetFaction(_Char, (FACTION)ACT2_MOO_Assault_Neutral_495e3f88-4e4d-47b0-b275-5daf3442430b);
		SetCombatGroupID(_Char, "MOO_Assault_RooftopEnemies");
		
		PROC
		PROC_MOO_NightsongDeath_SetPositions((CHARACTER)_Char,(TRIGGER)_Point)
		THEN
		SetOnStage(_Char, 1);
		PurgeOsirisQueue(_Char);
		TeleportTo(_Char, _Point);
		LookFromTrigger(_Char, _Point, 0);
		PROC_MOO_NightsongDeath_UpdateIdlePoint((CHARACTER)_Char, (TRIGGER)_Point);
		PROC_MOO_NightsongDeath_SetZrellGroup((CHARACTER)_Char);
		
		PROC
		PROC_MOO_NightsongDeath_SetPositions(S_HAV_FlamingSpy_acb1dd9e-952b-4281-8e30-ec6f671493a6, _)
		THEN
		ApplyStatus(S_HAV_FlamingSpy_acb1dd9e-952b-4281-8e30-ec6f671493a6, "HAV_FLAMINGSPYDISGUISE", -1.0, 0, NULL_00000000-0000-0000-0000-000000000000);
		AddSpell((CHARACTER)S_HAV_FlamingSpy_acb1dd9e-952b-4281-8e30-ec6f671493a6,"Target_HAV_TakingIsobel_SearingSmite_Marcus",0,0);
		AddSpell((CHARACTER)S_HAV_FlamingSpy_acb1dd9e-952b-4281-8e30-ec6f671493a6,"Shout_HAV_FlamingSpy_VampiricShout",0,0);
		AddSpell((CHARACTER)S_HAV_FlamingSpy_acb1dd9e-952b-4281-8e30-ec6f671493a6,"Projectile_HAV_TakingIsobel_Fly_Marcus",0,0);
		
		PROC
		PROC_MOO_NightsongDeath_UpdateIdlePoint((CHARACTER)_Char, (TRIGGER)_Point)
		THEN
		SetDualEntityEvent(_Char, _Point, "MOO_Assault_IdlePointChange", 1);
		
		PROC
		PROC_MOO_NightsongDeath_SetZrellGroup((CHARACTER)_Char)
		AND
		QRY_MOO_NightsongDeath_ZrellWillTalk()
		AND
		DB_MOO_NightsongDeath_ZrellEntranceGroup(_Char)
		AND
		NOT DB_PermaDefeated(_Char)
		THEN
		SetFaction(_Char, (FACTION)ACT2_MOO_Assault_Neutral_495e3f88-4e4d-47b0-b275-5daf3442430b);
		SetCombatGroupID(_Char, "MOO_NightsongDeath_ZrellEntrance");
		
		PROC
		PROC_MOO_NightsongDeath_SetZrellGroup((CHARACTER)_Char)
		AND
		NOT QRY_MOO_NightsongDeath_ZrellWillTalk()
		AND
		DB_MOO_NightsongDeath_ZrellEntranceGroup(_Char)
		AND
		NOT DB_PermaDefeated(_Char)
		THEN
		SetFaction(_Char, (FACTION)ACT2_MOO_Assault_Hostile_68597716-e217-4777-a391-026263f291b4);
		SetCombatGroupID(_Char, "MOO_NightsongDeath_ZrellEntrance");
		
		QRY
		QRY_MOO_NightsongDeath_ZrellWillTalk()
		AND
		DB_GlobalFlag(MOO_Execution_Knows_Executioner_53052e40-df9b-90a0-ad65-f2c06f996666) 
		AND
		NOT DB_GlobalFlag(MOO_MoonriseTower_State_Outcast_93565546-9052-4776-8563-2a1aca8d899e)
		THEN
		DB_NOOP(1);
		//END_REGION
		
		//REGION Zrell Intro
		PROC
		PROC_SpotPlayers_Spotted(S_MOO_Executioner_8e75eb3b-7551-485e-8f98-2bf2e51d3e84, "MOO_NightsongDeath_ZrellGreeting", (CHARACTER)_Player)
		AND
		NOT QRY_StartDialog(MOO_Assault_Executioner_d85920d4-073a-ccf2-68dd-c50697b2d1ad, S_MOO_Executioner_8e75eb3b-7551-485e-8f98-2bf2e51d3e84, _Player)
		THEN
		DB_NOOP(1);
		
		IF
		DialogEnded(MOO_Assault_Executioner_d85920d4-073a-ccf2-68dd-c50697b2d1ad, _)
		AND
		DB_MOO_NightsongDeath_ZrellEntranceGroup((CHARACTER)_Char)
		THEN
		SetFaction(_Char, (FACTION)ACT2_MOO_Assault_Hostile_68597716-e217-4777-a391-026263f291b4);
		
		IF
		EnteredCombat(_Char, _ID)
		AND
		DB_MOO_NightsongDeath_ZrellEntranceGroup((CHARACTER)_Char)
		AND
		GetFaction(_Char, (FACTION)ACT2_MOO_Assault_Neutral_495e3f88-4e4d-47b0-b275-5daf3442430b)
		THEN
		SetFaction(_Char, (FACTION)ACT2_MOO_Assault_Hostile_68597716-e217-4777-a391-026263f291b4);
		
		IF
		EnteredTrigger(_Player, _Trigger)
		AND
		DB_State_Current(S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6, "MOO", "MOO_State_NightsongDeath")
		AND
		DB_PartyMembers(_Player)
		AND
		DB_MOO_InsideMoonriseTowerTriggers(_Trigger)
		AND
		DB_MOO_NightsongDeath_ZrellEntranceGroup((CHARACTER)_Char)
		AND
		GetFaction(_Char, (FACTION)ACT2_MOO_Assault_Neutral_495e3f88-4e4d-47b0-b275-5daf3442430b)
		THEN
		SetFaction(_Char, (FACTION)ACT2_MOO_Assault_Hostile_68597716-e217-4777-a391-026263f291b4);
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(396).Title("Act2_MOO_Oubliette");
Goal(396)
{
	INIT
	{
		PROC_TriggerRegisterForPlayers((TRIGGER)S_MOO_Oubliette_Entry_Box_b157662d-991f-4a3e-9076-a36b9593c200);
		PROC_TriggerRegisterForPlayers((TRIGGER)S_MOO_Oubliette_HorrorScreech_Box_c70cdda1-8479-4adc-9ddf-6091515e4da5);
		PROC_TriggerRegisterForPlayers((TRIGGER)S_MOO_Oubliette_Escape_Box_022573bb-94ce-40b2-94d8-f2e67de368a9);
		PROC_TriggerRegisterForPlayers((TRIGGER)S_MOO_Oubliette_Escape_Box_022573bb-94ce-40b2-94d8-f2e67de368a9);
		PROC_TriggerRegisterForPlayers((TRIGGER)S_MOO_Oubliette_Escape_Box_022573bb-94ce-40b2-94d8-f2e67de368a9);
		
		DB_GLO_CharacterCorpseDialog(S_MOO_Oubliette_Corpse_Membranes_ebcb2820-6eb4-41ee-aa0e-e01fd90f2b08,MOO_Oubliette_CorpseMembranes_Dead_c2c5fe7f-fbdc-7cf3-08fa-808d9ac51e39);
		
		DB_OneShot_VoiceBarkTrigger(S_MOO_Oubliette_ColonyComment_PAD_Trigger_35d72bf5-4d80-4fe1-a41f-9e301693d6f9,MOO_Oubliette_VB_ColonyComment_d4022045-85b7-a962-b66c-f984bf0cdf92);
		
		DB_OneShotPlayerTrigger((TRIGGER)S_COL_Oubliette_Daisy_8419194d-e67a-4290-be4f-b72c91e1a3b9);
		DB_OneShotPlayerTrigger((TRIGGER)S_MOO_Oubliette_ShoutFX_Box_2a8615af-ed27-43bc-8fff-fe289d25146f);
	}
	KB
	{
		//REGION Debug hooks
		
		IF
		TextEvent("Oubliette_Enter")
		AND
		GetHostCharacter(_Character)
		THEN
		TeleportTo(_Character,S_MOO_OublietteAppearPos_da5c04d6-6b54-43ac-b171-4c8157f1c9d4, "",1,1,1,1,1);
		
		IF
		TextEvent("Oubliette_Enter_Cell")
		AND
		GetHostCharacter(_Character)
		THEN
		TeleportTo(_Character,S_MOO_OublietteEntranceCell_27c6761c-0dec-48b8-9349-da687a603005, "",1,1,1,1,1);
		
		IF
		TextEvent("Oubliette_Enter_Fall")
		AND
		GetHostCharacter(_Character)
		THEN
		TeleportTo(_Character,S_MOO_OublietteAppearPos_da5c04d6-6b54-43ac-b171-4c8157f1c9d4, "",1,1,1,1,0);
		
		IF
		TextEvent("Oubliette_Enter_Cell_Fall")
		AND
		GetHostCharacter(_Character)
		THEN
		TeleportTo(_Character,S_MOO_OublietteEntranceCell_27c6761c-0dec-48b8-9349-da687a603005, "",1,1,1,1,0);
		
		IF
		TextEvent("Oubliette_Entrance_Cell")
		AND
		GetHostCharacter(_Character)
		THEN
		TeleportTo(_Character,S_MOO_PrisonSpawnPoint_aaf10d5a-4018-4a7b-84d5-52f276857eed, "",1,1,1,1,1);
		
		IF
		TextEvent("Oubliette_Entrance_Escape")
		AND
		GetHostCharacter(_Character)
		THEN
		TeleportTo(_Character,TeleportTrigger_Prison_OublietteReturnToMoonriseTower_745875e1-e453-43a3-991c-bc4a610edd11, "",1,1,1,1,1);
		
		IF
		TextEvent("Oubliette_Entrance")
		AND
		GetHostCharacter(_Character)
		THEN
		TeleportTo(_Character,S_MOO_Oubliette_Entrance_Point_f9d4c07f-cfa8-4eb5-84b0-953c277afbed, "",1,1,1,1,1);
		
		IF
		TextEvent("Oubliette_Reset")
		THEN
		NOT DB_MOO_Oubliette_HorrorScreech(1);
		
		IF
		TextEvent("Oubliette_Reset")
		AND
		DB_MOO_Oubliette_IsInside(_Player)
		THEN
		NOT DB_MOO_Oubliette_IsInside(_Player);
		
		IF
		TextEvent("Oubliette_Reset")
		AND
		DB_OnlyOnce_PerUser(_ProfileID,_SituationID)
		AND
		QRY_MOO_Oubliette_SituationID_ShouldReset(_SituationID)
		THEN
		NOT DB_OnlyOnce_PerUser(_ProfileID,_SituationID);
		
		QRY
		QRY_MOO_Oubliette_SituationID_ShouldReset("MOO_Oubliette_Entry_Once")
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_MOO_Oubliette_SituationID_ShouldReset("MOO_Oubliette_Entry_Twice")
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_MOO_Oubliette_SituationID_ShouldReset("MOO_Oubliette_HorrorScreech")
		THEN
		DB_NOOP(1);
		
		//END_REGION
		
		//REGION Moonrise Tower prison to oubliette entry
		
		IF
		EnteredTrigger(_Char, S_MOO_OublietteEntrance_5fc9baa7-135c-4d19-a2b6-ec93bed76854)
		AND
		NOT DB_Is_InCombat(_Char, _)
		THEN
		PROC_MOO_Oubliette_TeleportDown(_Char, S_MOO_OublietteAppearPos_da5c04d6-6b54-43ac-b171-4c8157f1c9d4);
		SetCombatGroupID(_Char, "");
		
		IF
		EnteredTrigger(_Char, S_MOO_OublietteEntrance_5fc9baa7-135c-4d19-a2b6-ec93bed76854)
		AND
		DB_Is_InCombat(_Char, _)
		THEN
		PROC_MOO_Oubliette_TeleportDown((CHARACTER)_Char,(TRIGGER)S_MOO_OublietteAppearPos_da5c04d6-6b54-43ac-b171-4c8157f1c9d4);
		SetCombatGroupID(_Char, "");
		
		IF
		EnteredTrigger(_Char, S_MOO_OublietteEntranceCell_27c6761c-0dec-48b8-9349-da687a603005)
		AND
		NOT DB_Is_InCombat(_Char, _)
		THEN
		SetFlag(MOO_Oubliette_State_EnteredThroughJailShaft_4b1b86b4-a2ae-44e9-9a96-ce1199264ebb);
		PROC_MOO_Oubliette_TeleportDown(_Char, S_MOO_OublietteAppearCellPos_b1f1929e-1fe7-4561-8a9a-f59277c4e5eb);
		SetCombatGroupID(_Char, "");
		
		IF
		EnteredTrigger(_Char, S_MOO_OublietteEntranceCell_27c6761c-0dec-48b8-9349-da687a603005)
		AND
		DB_Is_InCombat(_Char, _)
		THEN
		SetFlag(MOO_Oubliette_State_EnteredThroughJailShaft_4b1b86b4-a2ae-44e9-9a96-ce1199264ebb);
		PROC_MOO_Oubliette_TeleportDown(_Char, S_MOO_OublietteAppearCellPos_b1f1929e-1fe7-4561-8a9a-f59277c4e5eb);
		SetCombatGroupID(_Char, "");
		
		PROC
		PROC_MOO_Oubliette_TeleportDown((CHARACTER)_Char,(TRIGGER)_Trigger)
		AND
		IsImmuneToFallDamage(_Char,1)
		THEN
		DB_MOO_Oubliette_ShouldNegateFallDamage((CHARACTER)_Char,1);
		
		PROC
		PROC_MOO_Oubliette_TeleportDown((CHARACTER)_Char,(TRIGGER)_Trigger)
		AND
		NOT DB_MOO_Oubliette_ShouldNegateFallDamage((CHARACTER)_Char,(INTEGER)_)
		AND
		HasActiveStatus(_Char,"FLY",1)
		THEN
		DB_MOO_Oubliette_ShouldNegateFallDamage((CHARACTER)_Char,1);
		
		PROC
		PROC_MOO_Oubliette_TeleportDown((CHARACTER)_Char,(TRIGGER)_Trigger)
		AND
		NOT DB_MOO_Oubliette_ShouldNegateFallDamage((CHARACTER)_Char,(INTEGER)_)
		THEN
		DB_MOO_Oubliette_ShouldNegateFallDamage((CHARACTER)_Char,0);
		
		PROC
		PROC_MOO_Oubliette_TeleportDown((CHARACTER)_Char,(TRIGGER)_Trigger)
		AND
		DB_MOO_Oubliette_ShouldNegateFallDamage((CHARACTER)_Char,(INTEGER)_NegateFallDamage)
		THEN
		TeleportTo(_Char,_Trigger, "",1,0,0,1,_NegateFallDamage);
		NOT DB_MOO_Oubliette_ShouldNegateFallDamage((CHARACTER)_Char,(INTEGER)_NegateFallDamage);
		
		//END_REGION
		
		//REGION Automated Dialogs
		
		//REGION First/second visit PAD
		//Play first/second visit PAD
		IF
		EnteredTrigger(_Player,S_MOO_Oubliette_Entry_Box_b157662d-991f-4a3e-9076-a36b9593c200)
		AND
		NOT DB_MOO_Oubliette_IsInside(_Player)
		AND
		QRY_OncePerUserAndNearbyPlayers_IsSet(_Player,"MOO_Oubliette_Entry_Once")
		AND
		NOT QRY_OncePerUserAndNearbyPlayers_IsSet(_Player,"MOO_Oubliette_Entry_Twice")
		THEN
		PROC_MOO_Oubliette_Entry_CueDialog(_Player);
		
		IF
		EnteredTrigger(_Player,S_MOO_Oubliette_Entry_Box_b157662d-991f-4a3e-9076-a36b9593c200)
		AND
		NOT DB_MOO_Oubliette_IsInside(_Player)
		AND
		NOT QRY_OncePerUserAndNearbyPlayers_IsSet(_Player,"MOO_Oubliette_Entry_Once")
		THEN
		PROC_MOO_Oubliette_Entry_CueDialog(_Player);
		
		PROC
		PROC_MOO_Oubliette_Entry_CueDialog((CHARACTER)_Player)
		AND
		NOT DB_MOO_Oubliette_IsInside(_Player)
		THEN
		DB_MOO_Oubliette_IsInside(_Player);
		DB_MOO_Oubliette_Entry_Players(_Player);
		TimerCancel("MOO_Oubliette_Entry");
		TimerLaunch("MOO_Oubliette_Entry",3000);
		//Delay dialog to avoid being obscured by fade in
		//or allow other players to enter in the meantime
		
		IF
		TimerFinished("MOO_Oubliette_Entry")
		AND
		DB_MOO_Oubliette_IsInside(_Player)
		AND
		QRY_OncePerUserAndNearbyPlayers_IsSet(_Player,"MOO_Oubliette_Entry_Once")
		AND
		NOT QRY_OncePerUserAndNearbyPlayers_IsSet(_Player,"MOO_Oubliette_Entry_Twice")
		THEN
		PROC_OncePerUserAndNearbyPlayers_Set(_Player,"MOO_Oubliette_Entry_Twice", 10.0);
		
		IF
		TimerFinished("MOO_Oubliette_Entry")
		AND
		DB_MOO_Oubliette_IsInside(_Player)
		AND
		NOT QRY_OncePerUserAndNearbyPlayers_IsSet(_Player,"MOO_Oubliette_Entry_Once")
		THEN
		PROC_OncePerUserAndNearbyPlayers_Set(_Player,"MOO_Oubliette_Entry_Once", 10.0);
		
		//Determine entry speaker (if any available)
		IF
		TimerFinished("MOO_Oubliette_Entry")
		AND
		DB_MOO_Oubliette_Entry_Players(_Player)
		AND
		NOT DB_MOO_Oubliette_Entry_Speaker(_)
		AND
		QRY_SpeakerIsAvailable(_Player)
		THEN
		DB_MOO_Oubliette_Entry_Speaker(_Player);
		
		//Clear obsolete database
		IF
		TimerFinished("MOO_Oubliette_Entry")
		AND
		DB_MOO_Oubliette_Entry_Players(_Player)
		THEN
		NOT DB_MOO_Oubliette_Entry_Players(_Player);
		
		//Start entry dialog
		IF
		TimerFinished("MOO_Oubliette_Entry")
		AND
		DB_MOO_Oubliette_Entry_Speaker(_Player)
		AND
		QRY_StartDialog(MOO_Oubliette_PAD_Entry_49f75387-4bc8-0d5f-6a71-bba91d98e4d3,_Player)
		THEN
		NOT DB_MOO_Oubliette_Entry_Speaker(_Player);
		
		//END_REGION
		
		//REGION Escape PAD
		
		//Left Oubliette flag
		IF
		LeftTrigger(_Player,S_MOO_Oubliette_SUB_c6f54de0-1c8f-4cf8-bcf9-b13c8f53b05b)
		AND
		DB_MOO_Oubliette_IsInside(_Player)
		AND
		GetFlag((FLAG)MOO_Oubliette_State_HasEntered_b0a61423-10d0-34b4-b4e7-eb422f5a5664,_Player,0)
		THEN
		SetFlag((FLAG)MOO_Oubliette_State_HasEntered_b0a61423-10d0-34b4-b4e7-eb422f5a5664,_Player);
		
		//Trigger timer
		IF
		LeftTrigger(_Player,S_MOO_Oubliette_SUB_c6f54de0-1c8f-4cf8-bcf9-b13c8f53b05b)
		AND
		DB_MOO_Oubliette_IsInside(_Player)
		THEN
		NOT DB_MOO_Oubliette_IsInside(_Player);
		DB_MOO_Oubliette_Escaping(_Player);
		TimerCancel("MOO_Oubliette_Escape");
		TimerLaunch("MOO_Oubliette_Escape",3000);
		
		//Escape AD
		IF
		TimerFinished("MOO_Oubliette_Escape")
		AND
		DB_MOO_Oubliette_Escaping(_Player)
		AND
		DB_InRegion(_Player,S_MOO_Oubliette_Escape_Box_022573bb-94ce-40b2-94d8-f2e67de368a9)
		AND
		NOT DB_InRegion(_Player,S_MOO_Oubliette_SUB_c6f54de0-1c8f-4cf8-bcf9-b13c8f53b05b)
		AND
		QRY_SpeakerIsAvailable(_Player)
		AND
		QRY_OncePerUserAndNearbyPlayers(_Player,"MOO_Oubliette_Escape")
		AND
		QRY_StartDialog(MOO_Oubliette_PAD_Escape_8b3608ed-5cd7-fe82-0082-8412e653a43b,_Player)
		THEN
		DB_NOOP(1);
		
		IF
		TimerFinished("MOO_Oubliette_Escape")
		AND
		DB_MOO_Oubliette_Escaping(_Player)
		THEN
		NOT DB_MOO_Oubliette_Escaping(_Player);
		
		//Delay with timer to allow for escape AD to play above
		//(allows escape box EnteredTrigger to happen after area trigger LeftTrigger happens)
		//also allows nearby player to catch up
		IF
		TimerFinished("MOO_Oubliette_Escape")
		AND
		DB_MOO_Oubliette_IsInside(_Player)
		AND
		NOT DB_InRegion(_Player,S_MOO_Oubliette_SUB_c6f54de0-1c8f-4cf8-bcf9-b13c8f53b05b)
		THEN
		NOT DB_MOO_Oubliette_IsInside(_Player);
		
		//END_REGION
		
		//REGION Hook horror screech + PAD
		//If the patrolling hook horror is still patrolling, play screech and AD
		IF
		EnteredTrigger(_Player,S_MOO_Oubliette_HorrorScreech_Box_c70cdda1-8479-4adc-9ddf-6091515e4da5)
		AND
		NOT DB_MOO_Oubliette_HorrorScreech(_)
		AND
		QRY_OncePerUserAndNearbyPlayers(_Player,"MOO_Oubliette_HorrorScreech")
		THEN
		PROC_MOO_Oubliette_Start_HorrorScreech(_Player);
		
		PROC
		PROC_MOO_Oubliette_Start_HorrorScreech((CHARACTER)_)
		AND
		DB_InRegion(_Player,S_MOO_Oubliette_SUB_c6f54de0-1c8f-4cf8-bcf9-b13c8f53b05b)
		THEN
		PlayHUDSound(_Player,"S_MOO_Oubliette_HorrorScreech");
		
		PROC
		PROC_MOO_Oubliette_Start_HorrorScreech((CHARACTER)_Player)
		THEN
		DB_MOO_Oubliette_HorrorScreech_Speaker((CHARACTER)_Player);
		TimerLaunch("MOO_Oubliette_HorrorScreech",4000);
		
		IF
		TimerFinished("MOO_Oubliette_HorrorScreech")
		AND
		DB_MOO_Oubliette_HorrorScreech_Speaker((CHARACTER)_Player)
		THEN
		StartVoiceBark(MOO_Oubliette_VB_HorrorScreech_ffd7dcbb-a9fc-a110-5130-2d40261dd750,_Player);
		NOT DB_MOO_Oubliette_HorrorScreech_Speaker((CHARACTER)_Player);
		
		//Disturbing the hook horror will prevent the screech + PAD from playing again
		IF
		EnteredCombat(S_MOO_OublietteHookHorror_000_eda129f0-b54b-4b05-95a3-ba626e4b765a,_)
		AND
		NOT DB_MOO_Oubliette_HorrorScreech(_)
		THEN
		DB_MOO_Oubliette_HorrorScreech(1);
		
		IF
		Dying(S_MOO_OublietteHookHorror_000_eda129f0-b54b-4b05-95a3-ba626e4b765a)
		AND
		NOT DB_MOO_Oubliette_HorrorScreech(_)
		THEN
		DB_MOO_Oubliette_HorrorScreech(1);
		
		//END_REGION
		
		//END_REGION
		
		//Bloodbath: covered in blood status effect
		IF
		EnteredTrigger(_Character,S_MOO_Oubliette_BloodBath_Box_001_fa16ff6c-fcca-46a1-b0bf-f2331855c0d4)
		AND
		HasActiveStatus(_Character,"BLOOD_COVERED_FULL",0)
		THEN
		ApplyStatus(_Character, "BLOOD_COVERED_FULL", -1.0, 1, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		EnteredTrigger(_Character,S_MOO_Oubliette_BloodBath_Box_002_052fb5de-8815-4652-ab78-fd2aa8902725)
		AND
		HasActiveStatus(_Character,"BLOOD_COVERED_FULL",0)
		THEN
		ApplyStatus(_Character, "BLOOD_COVERED_FULL", -1.0, 1, NULL_00000000-0000-0000-0000-000000000000);
		
		PROC
		PROC_OneShotTriggerEntered(_Player,S_COL_Oubliette_Daisy_8419194d-e67a-4290-be4f-b72c91e1a3b9)
		THEN
		PROC_DaisyAD(_Player,(DIALOGRESOURCE)COL_Arrival_DaisyAD_ThroughPrison_d3901325-9eac-1ea0-887e-c2ba286f2d48);
		
		PROC
		PROC_COL_TeleportPartiesToColony(_)
		THEN
		NOT DB_OneShotPlayerTrigger((TRIGGER)S_COL_Oubliette_Daisy_8419194d-e67a-4290-be4f-b72c91e1a3b9);
		
		PROC
		PROC_OneShotTriggerEntered(_,S_MOO_Oubliette_ShoutFX_Box_2a8615af-ed27-43bc-8fff-fe289d25146f)
		AND
		GetPosition(S_MOO_Oubliette_ShoutFX_Point_a83379dc-a2b6-4e7e-936e-a27559708fd9,_X,_Y,_Z)
		THEN
		PlayEffectAtPosition(VFX_Environment_SCL_MoonrisePrison_Scream_01_8ce13b2d-bee6-fd05-e6a8-ac73080a06e8,_X,_Y,_Z,1.0);
		
		// If player entered elsewhere
		IF
		EnteredTrigger(_Player,S_MOO_Oubliette_Entry_Box_b157662d-991f-4a3e-9076-a36b9593c200)
		AND
		DB_OneShotPlayerTrigger((TRIGGER)S_MOO_Oubliette_ShoutFX_Box_2a8615af-ed27-43bc-8fff-fe289d25146f)
		THEN
		NOT DB_OneShotPlayerTrigger((TRIGGER)S_MOO_Oubliette_ShoutFX_Box_2a8615af-ed27-43bc-8fff-fe289d25146f);
		
		PROC
		PROC_COL_OnFirstEntry()
		THEN
		PROC_RemoveOneShotVoiceBarkTrigger(S_MOO_Oubliette_ColonyComment_PAD_Trigger_35d72bf5-4d80-4fe1-a41f-9e301693d6f9,MOO_Oubliette_VB_ColonyComment_d4022045-85b7-a962-b66c-f984bf0cdf92);
	}
	EXIT
	{
	}
}
Goal(397).Title("Act2_MOO_PreAssault");
Goal(397)
{
	INIT
	{
		//This goal is for stuff that needs to be define before the Assault goal becomes active
		//Related goals: Act2_MOO_Audience, Act2_MOO_Assault, Act2_MOO_Misc
		
		//DB_MOO_AssaultPositions(_Character, _Position, _Group)
		//REGION Assault Positions -- ENEMIES --
		//Bridge - Dead
		DB_MOO_AssaultPositions((CHARACTER)S_MOO_EntranceGuard_001_b302d246-59ff-48ee-8247-0e3bcfd4b38e,(TRIGGER)S_MOO_AssaultDeadEntranceGuardPoint_001_fa273009-7c0c-4d82-9c0f-26f9be51f877, "MOO_Assault_DeadEnemy");
		DB_MOO_AssaultPositions((CHARACTER)S_MOO_EntranceGuard_002_2ab30cea-d3f1-4aa4-8c83-b8b700ef0048,(TRIGGER)S_MOO_AssaultDeadEntranceGuardPoint_002_5495118d-1c71-4926-92b2-000225888cbd, "MOO_Assault_DeadEnemy");
		DB_MOO_AssaultPositions((CHARACTER)S_MOO_EntranceGhoul_001_c9b6a714-491a-40aa-b5b6-3fe608a4efb5,(TRIGGER)S_MOO_AssaultDeadEntranceGhoulPoint_001_b4999c1c-2e27-4efc-9a44-fd80c0a067fa, "MOO_Assault_DeadEnemy_Radiant");
		DB_MOO_AssaultPositions((CHARACTER)S_MOO_EntranceGhoul_002_2e7447e5-35dd-4cdd-8426-43a6afe0edc7,(TRIGGER)S_MOO_AssaultDeadEntranceGhoulPoint_002_0f5d33a7-1540-4f01-bec3-3ff1e4ae86b4, "MOO_Assault_DeadEnemy");
		DB_MOO_AssaultPositions((CHARACTER)S_MOO_EntranceGhoul_003_019af169-5366-4a1f-8392-35df658b2e8e,(TRIGGER)S_MOO_AssaultDeadEntranceGhoulPoint_003_b11c70f1-c25c-4bb6-bc8c-dbe001598a57, "MOO_Assault_DeadEnemy_Radiant");
		DB_MOO_AssaultPositions((CHARACTER)S_MOO_WarehouseGuard_001_30de3349-7bcb-4a6e-be2e-3ae7a4c89e6a, (TRIGGER)S_MOO_AssaultDeadEntranceGuardPoint_003_505143a4-26e6-40d9-85e5-edca757d6ba3, "MOO_Assault_DeadEnemy");
