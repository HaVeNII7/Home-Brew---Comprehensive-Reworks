		AND
		DB_SceneManager_DisturbanceRegistering(_Char,_Reason,_,_,_,_ID)
		AND
		QRY_CRIME_IsCrimeFamilyMember(_Reason, "Murder")
		THEN
		DB_HAG_Hagspawn_ResurrectionInterrupted(_ID);
		PROC_SceneOver("HAG_Hagspawn_ResurrectionScene");
		
