		PROC
		PROC_LOW_OskarsBeloved_HandleDuelSceneInterruption((CHARACTER)_Player)
		AND
		DB_Players(_Player)
		AND
		QRY_StartDialog((DIALOGRESOURCE)LOW_OskarsBeloved_DuelInterruption_45686d7c-d7d3-cef8-11fa-08e420b484df, S_LOW_AngryNoble_001_4707eca2-13b3-4912-9f5f-7a8ae5307aeb, S_LOW_AngryNoble_002_24376c44-ee3e-4131-86b1-25b738aee446,_Player)
