		DB_InRegionFlag((TRIGGER)S_CRE_LanceEscapeRightRoofArea_5d3d7410-6c7e-4741-b4e5-151a835bfc08, (FLAG)CRE_Lance_State_CharOnRightRoof_6c2ad82e-ac8f-43f9-9704-16b8f16a0f68);
