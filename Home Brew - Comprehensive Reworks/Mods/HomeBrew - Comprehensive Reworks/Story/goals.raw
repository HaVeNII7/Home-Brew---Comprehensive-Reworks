	KB
	{
		//REGION Cheat
		IF
		TextEvent("PLA_SaveGnollZhent")
		THEN
		SetEntityEvent(S_PLA_ZhentShipment_Agent_001_fd9b4edd-7828-4e22-85a9-ead2ba9d29e4, "PLA_ZhentShipment_Event_LeftCave");
