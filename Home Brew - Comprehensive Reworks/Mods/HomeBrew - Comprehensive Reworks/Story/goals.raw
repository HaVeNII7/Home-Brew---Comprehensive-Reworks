		DB_FOR_SlaughteredTieflingTriggers((CHARACTER)S_GLO_ProdigySister_44d09b0b-0568-456c-b18d-559a0a3f981d, (TRIGGER)S_DEN_TieflingCorpse_034_78c9d576-bbb8-48f2-8b4f-7979f10e2a6a);
		DB_FOR_SlaughteredTieflingTriggers((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, (TRIGGER)S_DEN_TieflingCorpse_035_0dcd3468-2711-4f09-94d7-cb3c915fdcda);
		DB_FOR_SlaughteredTieflingTriggers((CHARACTER)S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f, (TRIGGER)S_DEN_TieflingCorpse_036_8dbe1cf8-3371-4e8d-ace2-ecba5d1dbf32);
		DB_FOR_SlaughteredTieflingTriggers((CHARACTER)S_DEN_PickpocketTrader_e1fda08b-45d4-41db-84b5-20e9931ba5af, (TRIGGER)S_DEN_TieflingCorpse_037_6fe49745-9b23-4dcd-adb6-f2fa9bfed568);
		DB_FOR_SlaughteredTieflingTriggers((CHARACTER)S_GLO_GruntingKid_0f8ef61e-cb63-49e1-a242-677173bff5e0, (TRIGGER)S_DEN_TieflingCorpse_038_8da94198-aecb-4610-a995-8378b88eadbd);
		DB_FOR_SlaughteredTieflingTriggers((CHARACTER)S_DEN_RobberKid_94e865e9-790d-4633-a378-8fb50832b5e9, (TRIGGER)S_DEN_TieflingCorpse_039_d4b3e3d3-2e12-40df-9fa7-fa63e9b2ae69);
		
		DB_DEN_ProtectedChildren((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925);
		DB_DEN_ProtectedChildren((CHARACTER)S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f);
		DB_DEN_ProtectedChildren((CHARACTER)S_DEN_PickpocketTrader_e1fda08b-45d4-41db-84b5-20e9931ba5af);
		DB_DEN_ProtectedChildren((CHARACTER)S_GLO_GruntingKid_0f8ef61e-cb63-49e1-a242-677173bff5e0);
		DB_DEN_ProtectedChildren((CHARACTER)S_DEN_RobberKid_94e865e9-790d-4633-a378-8fb50832b5e9);
		//END_REGION
		
		//REGION Topical Greeting
		
		DB_TopicalGreeting((FLAG)TG_DEN_Entered_aed4b025-f290-4ec5-b8f1-34b0b9b56576);
		DB_TopicalGreetingEndCondition_FlagSet((FLAG)TG_DEN_Entered_aed4b025-f290-4ec5-b8f1-34b0b9b56576, (FLAG)DEN_General_Event_AllPlayersLeftGroveOnce_57e4753f-ce94-4592-b877-4a64c9914008);
		
		//END_REGION
		
	}
	KB
	{
		//REGION Generic Grove
		IF
		EnteredTrigger(_Char,S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211)
		AND
		DB_Players(_Char)
		AND
		NOT DB_GlobalFlag((FLAG)DEN_General_State_Entered_26b2dc6a-e5eb-4d99-a4bd-3ecaa3b86a9e) // flagType: Global
		THEN
		SetFlag((FLAG)DEN_General_State_Entered_26b2dc6a-e5eb-4d99-a4bd-3ecaa3b86a9e, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		
		IF
		EnteredTrigger(_Char,S_DEN_Cave_SUB_adecafa4-27c6-4b2f-bf9e-6ffd7c81a766)
		AND
		DB_Players(_Char)
		AND
		NOT DB_GlobalFlag((FLAG)DEN_General_State_EnteredCave_186c7091-f2ad-4c76-98f2-898202afc0d3) // flagType: Global
		THEN
		SetFlag((FLAG)DEN_General_State_EnteredCave_186c7091-f2ad-4c76-98f2-898202afc0d3, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		
		//--- Checking if a character is in any of the subregion of the DEN
		// QRY_DEN_IsInDen((CHARACTER)_Char, (INTEGER)_CheckDB, (TRIGGER)_ExcludedTrigger)
		//	_Char : character to check
		// 	_CheckDB == 1 : checks the DB_InRegion (more efficient). Used by default on players
		//	_CheckDB == 0 : uses IsInTrigger (better for frame sensitive checks or for NPCs). Used by default on NPCs.
		// _ExcludedTrigger : this trigger won't be checked and won't count (this has no effect if the trigger isn't in the list DB_DEN_InDenTriggers, so NULL is used when no trigger is passed)
		QRY
		QRY_DEN_IsInDen((CHARACTER)_Char)
		AND
		DB_Players(_Char)
		AND
		QRY_DEN_IsInDen(_Char, 1)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_DEN_IsInDen((CHARACTER)_Char)
		AND
		NOT DB_Players(_Char)
		AND
		QRY_DEN_IsInDen(_Char, 0)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_DEN_IsInDen((CHARACTER)_Char, (INTEGER)_CheckDB)
		AND
		QRY_DEN_IsInDen(_Char, _CheckDB, NULL_00000000-0000-0000-0000-000000000000)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_DEN_IsInDen((CHARACTER)_Char, 1, (TRIGGER)_ExcludedTrigger)
		AND
		DB_DEN_InDenTriggers(_Trigger)
		AND
		_Trigger != _ExcludedTrigger
		AND
		DB_InRegion(_Char, _Trigger)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_DEN_IsInDen((CHARACTER)_Char, 0, (TRIGGER)_ExcludedTrigger)
		AND
		DB_DEN_InDenTriggers(_Trigger)
		AND
		_Trigger != _ExcludedTrigger
		AND
		IsInTrigger(_Char, _Trigger, 1)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_DEN_IsInDen((CHARACTER)_Char, 1, (TRIGGER)_ExcludedTrigger1, (TRIGGER)_ExcludedTrigger2)
		AND
		DB_DEN_InDenTriggers(_Trigger)
		AND
		_Trigger != _ExcludedTrigger1
		AND
		_Trigger != _ExcludedTrigger2
		AND
		DB_InRegion(_Char, _Trigger)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_DEN_IsInDen((CHARACTER)_Char, 0, (TRIGGER)_ExcludedTrigger1, (TRIGGER)_ExcludedTrigger2)
		AND
		DB_DEN_InDenTriggers(_Trigger)
		AND
		_Trigger != _ExcludedTrigger1
		AND
		_Trigger != _ExcludedTrigger2
		AND
		IsInTrigger(_Char, _Trigger, 1)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_DEN_AnyPlayerInDen()
		AND
		DB_Players(_Player)
		AND
		QRY_DEN_IsInDen(_Player)
		THEN
		DB_NOOP(1);
		
		IF
		EnteredTrigger(_Char,_Trigger)
		AND
		DB_DEN_InDenTriggers(_Trigger)
		AND
		IsPlayer(_Char,1)
		AND
		NOT DB_DEN_PlayerInDen(_Char)
		THEN
		DB_DEN_PlayerInDen(_Char);
		SetFlag((FLAG)DEN_General_State_PlayerInDen_392262e7-4918-475e-9a13-65627400859d, _Char);
		
		IF
		LeftTrigger(_Char,_Trigger)
		AND
		DB_DEN_InDenTriggers(_Trigger)
		AND
		DB_DEN_PlayerInDen(_Char)
		AND
		IsPlayer(_Char,1)
		AND
		NOT QRY_DEN_IsInDen(_Char,0,_Trigger)
		THEN
		NOT DB_DEN_PlayerInDen(_Char);
		PROC_DEN_PlayerLeftDen(_Char);
		
		IF
		CharacterJoinedParty(_Char)
		AND
		QRY_DEN_IsInDen(_Char,1)
		AND
		NOT DB_DEN_PlayerInDen(_Char)
		THEN
		DB_DEN_PlayerInDen(_Char);
		
		IF
		CharacterLeftParty(_Char)
		AND
		QRY_DEN_IsInDen(_Char,1)
		AND
		DB_DEN_PlayerInDen(_Char)
		THEN
		NOT DB_DEN_PlayerInDen(_Char);
		PROC_DEN_PlayerLeftDen(_Char);
		
		//General PROC to call whenever the grove is emptied of all players (useful for updating boosters)
		PROC
		PROC_DEN_PlayerLeftDen((CHARACTER)_Char)
		AND
		NOT DB_DEN_PlayerInDen(_)
		THEN
		PROC_DEN_AllPlayersLeftDen();
		
		PROC
		PROC_DEN_PlayerLeftDen((CHARACTER)_Char)
		THEN
		ClearFlag((FLAG)DEN_General_State_PlayerInDen_392262e7-4918-475e-9a13-65627400859d, _Char);
		
		IF
		DB_DEN_PlayerInDen(_Char)
		AND
		NOT DB_Players((CHARACTER)_Char)
		THEN
		NOT DB_DEN_PlayerInDen(_Char);
		
		IF
		DB_Is_InCombat(_Player, _)
		AND
		DB_DEN_PlayerInDen((CHARACTER)_Player)
		THEN
		DB_DEN_OngoingGroveCombat((CHARACTER)_Player);
		
		IF
		DB_DEN_OngoingGroveCombat(_Player)
		AND
		NOT DB_Is_InCombat(_Player, _)
		THEN
		NOT DB_DEN_OngoingGroveCombat((CHARACTER)_Player);
		
		IF
		DB_DEN_OngoingGroveCombat(_Player)
		AND
		NOT DB_DEN_PlayerInDen(_Player)
		THEN
		NOT DB_DEN_OngoingGroveCombat((CHARACTER)_Player);
		
		//Banter Region
		IF
		DB_DEN_InDenTriggers(_Trigger)
		AND
		NOT DB_WorldGossip_RegionTrigger(_Trigger,(FLAG)BANTERREGION_Den_b89a1ac0-6800-48a3-ba35-0b607efe914e)
		THEN
		DB_WorldGossip_RegionTrigger(_Trigger,(FLAG)BANTERREGION_Den_b89a1ac0-6800-48a3-ba35-0b607efe914e);
		
		IF
		DB_DEN_NPC(_NPC, _, _)
		THEN
		DB_DEN_NPCIsOrWasInDen(_NPC);
		//END_REGION
		
		//REGION Generic Grove: permanent state change
		
		
		PROC
		PROC_DEN_GroveRefugeesEmptied()
		AND
		QRY_OnlyOnce("DEN_GroveEmptiedPartyBanterTrigger")
		THEN
		PROC_RegisterWorldGossipTrigger(S_PartyBanterTrigger_DEN_CaveCleared_6e769be6-3a1c-48c6-9bec-ccfe48d6facb);
		PROC_RegisterWorldGossipTrigger(S_PartyBanterTrigger_DEN_VistaCleared_1f8b62d5-ee43-4003-bfc6-38087d2b1b92);
		PROC_RegisterWorldGossipTrigger(S_PartyBanterTrigger_DEN_HillsCleared_f356dcf1-3c03-43af-b17b-07b9275e47f1);
		
		//Final state of the den. 
		PROC
		PROC_State_Changed(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", _FinalState)
		AND
		DB_DEN_FinalStates(_FinalState)
		THEN
		PROC_State_Progress(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_Final");
		
		//Check Grove is in a 'Default' non-hostile or transformative state. This is necessary for a number of situations that can be started during a peace state, 
		//but then ended in a non-peace state due to multiplayer.
		QRY
		QRY_DEN_CheckPeaceState()
		AND
		DB_State_Current(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", _State)
		AND
		DB_DEN_DefaultStates(_State)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_DEN_CheckBeforeState((STRING)_StateToCheck)
		AND
		DB_State_Priority(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", _StateToCheck, _Priority)
		AND
		DB_State_Current(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", _Current)
		AND
		DB_State_Priority(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", _Current, _OtherPriority)
		AND
		_OtherPriority < _Priority
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_DEN_ForceStopDialogAllDenPlayers()
		AND
		DB_DEN_PlayerInDen(_Player)
		THEN
		PROC_ForceStopDialog(_Player);
		
		//END_REGION
		
		//REGION Dangerzone States
		
		PROC
		PROC_State_Changed(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", _DangerState)
		AND
		DB_DEN_DangerzoneStates(_DangerState)
		AND
		DB_DEN_InDenTriggers(_Trigger)
		THEN
		DB_DangerZone(_Trigger, "DEN_DangerStateActive");
		
		PROC
		PROC_State_Changed(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", _State)
		AND
		NOT DB_DEN_DangerzoneStates(_State)
		THEN
		PROC_DangerZone_Safe("DEN_DangerStateActive");
		
		//END_REGION
		
		//REGION Squirrel
		IF
		FlagSet(DEN_General_Squirrel_PCPunchedSquirrel_00e726da-7014-4b80-8a70-364172442fe8,_,_)
		AND
		DB_DialogNPCs(_ID,S_DEN_Squirrel_35ed8eab-1e0b-4ec8-92f2-1b8510cb3ad8,_)
		AND
		DialogRemoveActorFromDialog(_ID,S_DEN_Squirrel_35ed8eab-1e0b-4ec8-92f2-1b8510cb3ad8,_)
		THEN
		Die(S_DEN_Squirrel_35ed8eab-1e0b-4ec8-92f2-1b8510cb3ad8,DEATHTYPE.Physical,NULL_00000000-0000-0000-0000-000000000000,0,1);
		
		IF
		DB_GlobalFlag(DEN_TieflingRefugees_State_LeftDen_003b304b-f058-4f8a-b9fa-a097e1b6b395)
		AND
		NOT DB_Sees(_,S_DEN_Squirrel_35ed8eab-1e0b-4ec8-92f2-1b8510cb3ad8)
		AND
		NOT DB_Defeated(S_DEN_Squirrel_35ed8eab-1e0b-4ec8-92f2-1b8510cb3ad8)
		THEN
		SetOnStage(S_DEN_Squirrel_35ed8eab-1e0b-4ec8-92f2-1b8510cb3ad8,1);
		TeleportTo(S_DEN_Squirrel_35ed8eab-1e0b-4ec8-92f2-1b8510cb3ad8,S_DEN_SafeEntryPos_3612bd97-71ea-4a3d-bdad-b10cb05f12e7);
		
		PROC
		PROC_State_Changed(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", _State)
		AND
		NOT DB_DEN_DefaultStates(_State)
		AND
		NOT DB_Defeated(S_DEN_Squirrel_35ed8eab-1e0b-4ec8-92f2-1b8510cb3ad8)
		THEN
		PROC_DisappearOutOfSight(S_DEN_Squirrel_35ed8eab-1e0b-4ec8-92f2-1b8510cb3ad8, "Run", 0, "");
		
		IF
		FlagSet((FLAG)DEN_General_Squirrel_MadeFriends_d229cc26-22bc-d9ff-09fc-0554b2975699, (CHARACTER)_Player, _)
		AND
		NOT DB_PermaDefeated((FLAG)S_DEN_Squirrel_35ed8eab-1e0b-4ec8-92f2-1b8510cb3ad8)
		THEN
		QuestUpdate(_Player, "HIDDEN_WLD_Rewards", "DEN_Squirrel_Reward");
		
		//END_REGION
		
		//REGION Greeting reaction
		
		IF
		DB_GlobalFlag((FLAG)DEN_RaidingParty_Quest_ConfrontationResolved_dc97da68-5ed9-ffe2-7582-2533be0efbcd) // flagType: Global
		AND
		NOT DB_GlobalFlag((FLAG)GLO_AttackOnDen_State_RaidReady_eb361773-da88-dee4-f4c8-a22acae60948) // flagType: Global
		AND
		NOT QRY_DEN_GreetingReactorsCheck()
		AND
		DB_DEN_PlayerInDen(_Char)
		AND
		NOT DB_DEN_GreetingReaction_Player(_Char)
		THEN
		PROC_DEN_GreetingReaction_Register(_Char);
		
		QRY
		QRY_DEN_GreetingReactorsCheck()
		AND
		NOT DB_DEN_GreetingReaction(_,_)
		THEN
		DB_NOOP(1);
		 
		IF
		DB_DEN_GreetingReaction_Player(_Char)
		AND
		NOT DB_DEN_PlayerInDen(_Char)
		THEN
		PROC_DEN_GreetingReaction_Stop(_Char);
		
		IF
		DB_DEN_GreetingReaction_Player(_Char)
		AND
		NOT DB_Players(_Char)
		THEN
		PROC_DEN_GreetingReaction_Stop(_Char);
		
		
		// Register / stop
		PROC
		PROC_DEN_GreetingReaction_Register((CHARACTER)_Char)
		AND
		DB_Players(_Char)
		AND
		NOT DB_DEN_GreetingReaction_Player(_Char)
		AND
		DB_DEN_PlayerInDen(_Char)
		THEN
		DB_DEN_GreetingReaction_Player(_Char);
		PROC_CharacterRegisterCrime(_Char,"DEN_GreetingAD",NULL_00000000-0000-0000-0000-000000000000,NULL_00000000-0000-0000-0000-000000000000,0);
		
		PROC
		PROC_DEN_GreetingReaction_Stop((CHARACTER)_Char)
		THEN
		NOT DB_DEN_GreetingReaction_Player(_Char);
		CharacterStopCrime(_Char, "DEN_GreetingAD", NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		CharacterOnCrimeSensibleActionNotification(_NPC,_Region,_CrimeID,_PriorityName,_Dialog,_Criminal,_Criminal2,_Criminal3,_Criminal4,1)
		AND
		DB_DEN_GreetingReaction(_NPC,_)
		AND
		CrimeGetType(_CrimeID,"DEN_GreetingAD")
		THEN
		PROC_CharacterDisableCrime(_NPC, "DEN_GreetingAD");
		
		// Override normal crime warning flow
		QRY
		QRY_CrimeGetCustomWarning((CHARACTER)_Warner, "DEN_GreetingAD", (DIALOGRESOURCE)_WarningDialog,_)
		THEN
		DB_CrimeWarning_Block(_Warner, "DEN_GreetingAD", _WarningDialog, 1);
		
		QRY
		QRY_CrimeGetCustomWarning((CHARACTER)_NPC, "DEN_GreetingAD", (DIALOGRESOURCE)_WarningDialog,_)
		AND
		DB_DEN_GreetingReaction(_NPC,_Dialog)
		AND
		NOT DB_DialogNPCs(_,_NPC,_)
		AND
		QRY_DEN_CheckPeaceState()
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)_Dialog,_NPC)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_CrimeSelectWarning(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,_,_,"DEN_GreetingAD",_,_Player,_,_,_)
		THEN
		SetDualEntityEvent(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, _Player, "DEN_GreetPlayer");
		
		IF
		DialogStarted(_, _Inst)
		AND
		DB_DialogNPCs(_Inst, _NPC, _)
		AND
		DB_DEN_GreetingReaction((CHARACTER)_NPC, _AD)
		AND
		NOT DB_CharacterCrimeDisabled(_NPC, "DEN_GreetingAD")
		THEN
		NOT DB_DEN_GreetingReaction(_NPC,_AD);
		
		//END_REGION
		
		//REGION Chef + Gruel
		
		IF
		FlagSet(DEN_Thieflings_Event_TookGruel_e9166e18-05a7-16da-0b43-dd1ff8674e0a, _Player, _ID)
		AND
		// Prevent from triggering when set from Osiris below
		_ID != 0
		THEN
		TemplateAddTo(f91f8f13-44d0-4fd0-8cc1-1ec08356f98a,_Player,1);
		
		IF
		FlagSet(DEN_Thieflings_Event_TookGruel2_cbf45767-7dac-0bdc-1f0f-8203b44798d9, _Player, _ID) // flagType: Object
		AND
		_ID != 0
		THEN
		TemplateAddTo(f91f8f13-44d0-4fd0-8cc1-1ec08356f98a,_Player,1);
		
		// When trying to trade by picking up an item from the shop trigger
		QRY
		QRY_CrimeGetCustomWarning((CHARACTER)S_DEN_Tiefling_FoodTrader_001_1b35671b-e5d7-4943-bbd0-4c816b69b7cb, _CrimeName, _, _CrimeID)
		AND
		QRY_CRIME_IsCrimeFamilyMember(_CrimeName, "BuyFromTrader")
		AND
		CrimeGetCriminal(_CrimeID, 1, _Player)
		AND
		GetFlag((FLAG)DEN_Thieflings_HasMet_Chef_04aa838b-08ce-66e4-9daa-c451b2ab5857, _Player, 1)
		THEN
		DB_CrimeWarning_CustomDialog((CHARACTER)S_DEN_Tiefling_FoodTrader_001_1b35671b-e5d7-4943-bbd0-4c816b69b7cb, _CrimeID, DEN_General_RefugeeChef_2a4f00f2-fbfe-93cd-119e-13a6e72582c8);
		
		// If you trade with her, immediately skip to the branches in her dialog after you had the option to get gruel from her
		IF
		MovedFromTo(_Item, (CHARACTER)S_DEN_Tiefling_FoodTrader_001_1b35671b-e5d7-4943-bbd0-4c816b69b7cb, _Player, 1)
		THEN
		SetFlag((FLAG)DEN_Thieflings_HasMet_Chef_04aa838b-08ce-66e4-9daa-c451b2ab5857, _Player);
		// And also prevent trading like when you got gruel through her dialogue
		DB_ManualTradeNPC((CHARACTER)S_DEN_Tiefling_FoodTrader_001_1b35671b-e5d7-4943-bbd0-4c816b69b7cb);
		DB_PreventTradeBetween((CHARACTER)S_DEN_Tiefling_FoodTrader_001_1b35671b-e5d7-4943-bbd0-4c816b69b7cb,_Player);
		
		IF
		MovedFromTo(_Item, (CHARACTER)S_DEN_Tiefling_FoodTrader_001_1b35671b-e5d7-4943-bbd0-4c816b69b7cb, _Player, 1)
		AND
		IsTagged(_Item, (TAG)FOOD_c86e0114-a5ab-48f6-b497-de321ebff577, _WasFood)
		THEN
		SetFlag((FLAG)DEN_Thieflings_Event_TookGruel_e9166e18-05a7-16da-0b43-dd1ff8674e0a, _Player);
		//END_REGION
		
		//REGION General Rat
		
		//Move the rat into the shack if the grove state changes at all - it doesn't have dialog reactive to the grove states, only to its current situation
		PROC
		PROC_State_Changed(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", _State)
		AND
		NOT DB_DEN_DefaultStates(_State)
		AND
		QRY_OnlyOnce("DEN_General_Rat_ShackMove")
		THEN
		SetOnStage(S_DEN_Rat_b61c2b37-da0d-47ad-ba9f-a4f8230f3b53, 0);
		
		IF
		DialogEnded(DEN_General_Rat_1e8b2638-5cbe-d1f1-83f6-3c345067368c, _Id)
		THEN
		PROC_DEN_General_Rat_Movement();
		
		PROC
		PROC_DEN_General_Rat_Movement()
		AND
		DB_GlobalFlag((FLAG)DEN_Rat_Event_MoveToShack_47c82d69-904d-c4be-3977-bead6659cfd0)
		AND
		QRY_OnlyOnce("DEN_General_Rat_ShackMove")
		THEN
		SetHasDialog(S_DEN_Rat_b61c2b37-da0d-47ad-ba9f-a4f8230f3b53, 0);
		PROC_CharacterMoveTo(S_DEN_Rat_b61c2b37-da0d-47ad-ba9f-a4f8230f3b53, S_DEN_Rat_TeleOutShack_408715a4-a94d-4453-8554-82a07a3de380, "Run", "DEN_General_Rat_EnteredShack");
		
		PROC
		PROC_DEN_General_Rat_Movement()
		AND
		DB_GlobalFlag((FLAG)DEN_Rat_Event_EnteredPotatoCrate_0c7fa837-6030-06b8-3744-760e2660ce3b)
		AND
		IsInTrigger(S_DEN_PotatoDispenser_fb5b898f-6f7b-424c-8dd0-09fb353688f2, S_DEN_Storage_SUB_28361464-314c-474e-96f2-cf56a9eb8afd, 1)
		AND
		QRY_OnlyOnce("DEN_General_Rat_PotatoMove")
		THEN
		PROC_CharacterMoveTo(S_DEN_Rat_b61c2b37-da0d-47ad-ba9f-a4f8230f3b53, S_DEN_PotatoDispenser_fb5b898f-6f7b-424c-8dd0-09fb353688f2, "Run", "DEN_General_Rat_EnteredPotatoes");
		
		//Fake the rat climbing up through the floor boards with a teleport (player needs to enter the building via the roof or by breaking in)
		IF
		EntityEvent((CHARACTER)_Rat, "DEN_General_Rat_EnteredShack")
		THEN
		TeleportTo(_Rat, S_DEN_Rat_TeleInShack_258dae73-20a7-430d-afeb-add848b7f71f, "", 0, 0, 0);
		SetHasDialog(S_DEN_Rat_b61c2b37-da0d-47ad-ba9f-a4f8230f3b53, 1);
		
		IF
		EntityEvent(_, "DEN_General_Rat_EnteredPotatoes")
		THEN
		SetOnStage(S_DEN_Rat_b61c2b37-da0d-47ad-ba9f-a4f8230f3b53, 0);
		
		IF
		RemovedFrom((ITEM)S_DEN_DruidLairKey_002_24648a3d-fc5b-4b92-86c1-4b22353e1064, (ITEM)S_DEN_PotatoDispenser_fb5b898f-6f7b-424c-8dd0-09fb353688f2)
		AND
		IsInTrigger(S_DEN_PotatoDispenser_fb5b898f-6f7b-424c-8dd0-09fb353688f2, S_DEN_Storage_SUB_28361464-314c-474e-96f2-cf56a9eb8afd, 1)
		AND
		IsInInventory(S_DEN_PotatoDispenser_fb5b898f-6f7b-424c-8dd0-09fb353688f2, 0)
		THEN
		SetFlag((FLAG)DEN_Rat_Event_RemovedKey_15ec04be-720c-7390-0884-ff80aa0a167c, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		AddedTo((ITEM)S_DEN_DruidLairKey_002_24648a3d-fc5b-4b92-86c1-4b22353e1064, (ITEM)S_DEN_PotatoDispenser_fb5b898f-6f7b-424c-8dd0-09fb353688f2, _)
		THEN
		ClearFlag((FLAG)DEN_Rat_Event_RemovedKey_15ec04be-720c-7390-0884-ff80aa0a167c, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		ItemLeftTrigger(S_DEN_PotatoDispenser_fb5b898f-6f7b-424c-8dd0-09fb353688f2, S_DEN_Storage_SUB_28361464-314c-474e-96f2-cf56a9eb8afd, _)
		THEN
		ClearFlag((FLAG)DEN_Rat_Event_RemovedKey_15ec04be-720c-7390-0884-ff80aa0a167c, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		ItemEnteredTrigger(S_DEN_PotatoDispenser_fb5b898f-6f7b-424c-8dd0-09fb353688f2, S_DEN_Storage_SUB_28361464-314c-474e-96f2-cf56a9eb8afd, _)
		AND
		IsInInventoryOf(S_DEN_DruidLairKey_002_24648a3d-fc5b-4b92-86c1-4b22353e1064, S_DEN_PotatoDispenser_fb5b898f-6f7b-424c-8dd0-09fb353688f2, 0)
		AND
		IsInInventory(S_DEN_PotatoDispenser_fb5b898f-6f7b-424c-8dd0-09fb353688f2, 0)
		THEN
		SetFlag((FLAG)DEN_Rat_Event_RemovedKey_15ec04be-720c-7390-0884-ff80aa0a167c, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		RemovedFrom((ITEM)S_DEN_PotatoDispenser_fb5b898f-6f7b-424c-8dd0-09fb353688f2, _Player)
		AND
		IsInTrigger(S_DEN_PotatoDispenser_fb5b898f-6f7b-424c-8dd0-09fb353688f2, S_DEN_Storage_SUB_28361464-314c-474e-96f2-cf56a9eb8afd, 1)
		AND
		IsInInventoryOf(S_DEN_DruidLairKey_002_24648a3d-fc5b-4b92-86c1-4b22353e1064, S_DEN_PotatoDispenser_fb5b898f-6f7b-424c-8dd0-09fb353688f2, 0)
		THEN
		SetFlag((FLAG)DEN_Rat_Event_RemovedKey_15ec04be-720c-7390-0884-ff80aa0a167c, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		//END_REGION
		
		//REGION Elevator
		
		//Tuffet wakes up when joining combat.
		IF
		EnteredCombat(S_DEN_ElevatorBear_04b7ef23-1002-4682-b962-33a2328bcd5c, _)
		AND
		HasActiveStatus(S_DEN_ElevatorBear_04b7ef23-1002-4682-b962-33a2328bcd5c, "SLEEPING", 1)
		THEN
		RemoveStatus(S_DEN_ElevatorBear_04b7ef23-1002-4682-b962-33a2328bcd5c, "SLEEPING");
		
		// blocked by the bear
		PROC
		PROC_BlockUseOfItem(_Player, _ElevatorLever)
		AND
		DB_DEN_General_ElevatorLevers(_ElevatorLever)
		AND
		DB_Players(_Player)
		AND
		NOT DB_DEN_General_ElevatorIsMoving(1)
		AND
		DB_InRegion(S_DEN_ElevatorBear_04b7ef23-1002-4682-b962-33a2328bcd5c, DEN_BearElevatorArea_5b6e4f15-6005-41fd-80ac-6cdbb6a7ed40)
		AND
		IsInTrigger(S_PLT_DEN_ElevatorLever_66e3c440-2f6b-8cd3-4860-e24e0548298d, DEN_BearElevatorArea_5b6e4f15-6005-41fd-80ac-6cdbb6a7ed40, 1)
		THEN
		DB_CustomUseItemResponse(_Player,_ElevatorLever,0);
		PROC_DEN_General_ElevatorPAD(_Player);
		
		PROC
		PROC_DEN_General_ElevatorPAD((CHARACTER)_Player)
		AND
		NOT DB_DEN_General_ElevatorPAD(1)
		AND
		QRY_StartDialog_Fixed(DEN_General_PAD_ElevatorUnusable_1966a3d8-2e07-24fb-e7af-f0446efb7df6, _Player)
		THEN
		DB_DEN_General_ElevatorPAD(1);
		
		IF
		AutomatedDialogEnded(DEN_General_PAD_ElevatorUnusable_1966a3d8-2e07-24fb-e7af-f0446efb7df6,_)
		AND
		DB_DEN_General_ElevatorPAD(1)
		THEN
		NOT DB_DEN_General_ElevatorPAD(1);
		
		
		// blocked because moving
		PROC
		PROC_BlockUseOfItem(_Player, _ElevatorLever)
		AND
		DB_DEN_General_ElevatorLevers(_ElevatorLever)
		AND
		DB_Players(_Player)
		AND
		DB_DEN_General_ElevatorIsMoving(1)
		THEN
		DB_CustomUseItemResponse(_Player,_ElevatorLever,0);
		PROC_PlayCantUseItemAD(_Player);
		
		
		// usable
		IF
		UseStarted(_Player, _ElevatorLever)
		AND
		DB_DEN_General_ElevatorLevers(_ElevatorLever)
		AND
		DB_DEN_ElevatorPosition(_IsDown)
		AND
		DB_DEN_ElevatorPoints(_IsDown, _Point)
		AND
		GetPosition(_Point,_X,_Y,_Z)
		THEN
		DB_DEN_General_ElevatorIsMoving(1);
		PlatformMoveTo(S_DEN_ElevatorPLT_dbd2352b-90fc-4d73-9aab-445a58840ee0,_X,_Y,_Z,3.0,"DEN_Elevation_Moved", 0);
		
		IF
		PlatformMovementFinished(S_DEN_ElevatorPLT_dbd2352b-90fc-4d73-9aab-445a58840ee0,"DEN_Elevation_Moved")
		AND
		DB_DEN_ElevatorPosition(_OldPosition)
		AND
		DB_Negate(_OldPosition,_NewPosition)
		THEN
		NOT DB_DEN_ElevatorPosition(_OldPosition);
		DB_DEN_ElevatorPosition(_NewPosition);
		NOT DB_DEN_General_ElevatorIsMoving(1);
		
		IF
		FlagSet(DEN_General_Event_ElevatorBearMoves_1c1694b8-c0b9-edad-9fdc-cdeedff0512e, _, _)
		AND
		DB_State_Current(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", _PeaceState)
		AND
		DB_DEN_DefaultStates(_State)
		AND
		DB_Players(_Player)
		THEN
		QuestUpdate(_Player, "HIDDEN_WLD_Boosters", "DEN_ElevatorBear_Moved");
		
		IF
		FlagSet(DEN_General_Event_GaveBearFish_aae6d263-f9fe-7b81-cea5-20164d1daf78, _Player, _)
		THEN
		MagicPocketsMoveToByTag(_Player, "FISH_ec16c2d2-2943-41cf-9796-0439ef65b2cf", 1, S_DEN_ElevatorBear_04b7ef23-1002-4682-b962-33a2328bcd5c, 1, 1);
		//END_REGION
		
		//REGION Bugbear Scout
		PROC
		PROC_SceneOver("DEN_RaidingParty_PleaAtGate")
		AND
		NOT DB_PermaDefeated(S_GLO_Stargazer_cd442e20-a6de-4497-ac51-8466433a758e)
		THEN
		SetOnStage(S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523, 1);
		
		//Bugbear scene automatically ends if the grove state changes away from default peace
		PROC
		PROC_State_Changed(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", _State)
		AND
		NOT DB_DEN_DefaultStates(_State)
		AND
		DB_SceneManager(S_GLO_Stargazer_cd442e20-a6de-4497-ac51-8466433a758e, "DEN_BugbearScout_Ambush")
		THEN
		PROC_DEN_BugbearAmbushOver();
		
		PROC
		PROC_DEN_BugbearAmbushOver()
		AND
		NOT DB_DEN_PlayerInDen(_)
		THEN
		Die(S_GLO_Stargazer_cd442e20-a6de-4497-ac51-8466433a758e,DEATHTYPE.DoT, S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523, 1, 1);
		
		PROC
		PROC_DEN_BugbearAmbushOver()
		THEN
		PROC_SceneOver("DEN_BugbearScout_Ambush");
		DB_OnlyOnce("DEN_BugbearNinja_Activate");
		SetOnStage(S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523,0);
		
		//approaching the area triggers bugbear to start moving towards the stargazer
		IF
		EnteredTrigger(_Player, S_DEN_BugbearNinjaActivateArea_3112588e-833d-4f11-82e5-e2ac4547560d)
		AND
		DB_Players(_Player)
		AND
		DB_SceneManager(S_GLO_Stargazer_cd442e20-a6de-4497-ac51-8466433a758e, "DEN_BugbearScout_Ambush")
		AND
		IsOnStage(S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523, 1)
		AND
		QRY_OnlyOnce("DEN_BugbearNinja_Activate")
		THEN
		SetEntityEvent(S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523, "DEN_BugbearNinja_Activate");
		
		PROC
		PROC_SceneInterrupted(_Member, _Player, "DEN_BugbearScout_Ambush", _Interrupt)
		THEN
		SetEntityEvent(S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523,"DEN_BugbearNinja_TurnHostile", 1);
		
		PROC
		PROC_SceneInterrupted(_Member, _Player, "DEN_BugbearScout_Ambush", _Interrupt)
		AND
		DB_DialogNPCs(_,S_GLO_Stargazer_cd442e20-a6de-4497-ac51-8466433a758e,_)
		THEN
		PROC_ForceStopDialog(S_GLO_Stargazer_cd442e20-a6de-4497-ac51-8466433a758e);
		
		IF
		FlagSet(DEN_BugbearNinja_Dead_cc673032-ad3b-484e-b2cb-57f67c901b3d,NULL_00000000-0000-0000-0000-000000000000,_)
		THEN
		PROC_SceneOver("DEN_BugbearScout_Ambush");
		
		PROC
		PROC_LongRestOrLevelUnloading("WLD_Main_A")
		AND
		DB_KnockedOut(S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523)
		THEN
		Die(S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523,DEATHTYPE.DoT,NULL_00000000-0000-0000-0000-000000000000,1,1);
		SetOnStage(S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523,0);
		
		IF
		EntityEvent(S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523,"DEN_BugbearNinja_TurnHostile")
		AND
		GetRelation(ACT1_DEN_BugbearNinja_90ca2daa-c81b-4eb5-bdf0-e0480f9ae5fa,ACT1_DEN_Tieflings_ca9de2d9-9022-9215-6d9b-676d916dcb5a,50)
		THEN
		PROC_MakeNPCHostile(S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523,S_GLO_Stargazer_cd442e20-a6de-4497-ac51-8466433a758e);
		PROC_ForceStopDialog(S_GLO_Stargazer_cd442e20-a6de-4497-ac51-8466433a758e);
		
		//attacking the bugbear from a significant distance will also trigger the scene
		IF
		AttackedBy(S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523, _AttackerOwner, _Attacker, _DamageType, _DamageAmount, _DamageCause, _StoryActionID)
		AND
		_DamageAmount > 0
		AND
		GetRelation(ACT1_DEN_BugbearNinja_90ca2daa-c81b-4eb5-bdf0-e0480f9ae5fa,ACT1_DEN_Tieflings_ca9de2d9-9022-9215-6d9b-676d916dcb5a,50)
		THEN
		PROC_MakeNPCHostile(S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523,(CHARACTER)_AttackerOwner);
		PROC_MakeNPCHostile(S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523,S_GLO_Stargazer_cd442e20-a6de-4497-ac51-8466433a758e);
		PROC_ForceStopDialog(S_GLO_Stargazer_cd442e20-a6de-4497-ac51-8466433a758e);
		
		//NPCs don't react to bugbear being attacked/killed
		QRY
		QRY_CRIME_BlockRegisterCrime(_NPC,_Crime,_Evidence,S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523,_)
		AND
		DB_DEN_NPC(_NPC,_,_)
		AND
		_NPC!=S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523
		THEN
		DB_NOOP(1);
		
		IF
		EntityEvent(S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523,"DEN_BugbearNinja_Escape")
		THEN
		PROC_DisappearOutOfSightTo(S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523,S_DEN_BugbearNinja_DisappearTarget_81a2dd3a-ab5a-45ce-b8df-56777126ce9f,"Run",1,"");
		//END_REGION
		
		//REGION Combat
		
		//Bugbear prioritizes the stargazer and has poison damage to weapon
		IF
		EntityEvent(S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523, "DEN_BugbearNinja_Activate")
		AND
		GetEquippedWeapon(S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523,_Weapon)
		AND
		NOT DB_Is_InCombat(S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523,_)
		AND
		TemplateIsInInventory(GRN_Poison_vial_C_4678c044-06b2-4ec9-9ae3-126983c95b91,S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523,_Count)
		AND
		_Count != 0
		AND
		HasAppliedStatus(_Weapon,"DIPPED_POISON",0)
		AND
		HasActiveStatus(_Weapon,"DIPPED_POISON",0)
		THEN
		LookAtEntity(S_GLO_Stargazer_cd442e20-a6de-4497-ac51-8466433a758e,S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523);
		SetFlag(GLO_StatusOverrides_NoFleeMove_ec2e86bc-fcb9-4e1c-871b-f7a696a717e1, S_GLO_Stargazer_cd442e20-a6de-4497-ac51-8466433a758e);
		SetTag(S_GLO_Stargazer_cd442e20-a6de-4497-ac51-8466433a758e,(TAG)AI_PREFERRED_TARGET_64bc9da1-9262-475a-a397-157600b7debd);
		ApplyStatus(S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523,"DIPPED_POISON",-1.0,1);
		ApplyStatus(_Weapon,"DIPPED_POISON",-1.0,1);
		TemplateRemoveFrom(GRN_Poison_vial_C_4678c044-06b2-4ec9-9ae3-126983c95b91,S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523,1);
		
		//Remove prio tag when resolved (else she is dead and the does not matter)
		IF
		FlagSet(DEN_BugbearNinja_Dead_cc673032-ad3b-484e-b2cb-57f67c901b3d, NULL_00000000-0000-0000-0000-000000000000,_)
		THEN
		ClearFlag(GLO_StatusOverrides_NoFleeMove_ec2e86bc-fcb9-4e1c-871b-f7a696a717e1, S_GLO_Stargazer_cd442e20-a6de-4497-ac51-8466433a758e);
		ClearTag(S_GLO_Stargazer_cd442e20-a6de-4497-ac51-8466433a758e,(TAG)AI_PREFERRED_TARGET_64bc9da1-9262-475a-a397-157600b7debd);
		
		//Stargazer gains frightened when combat starts for 2 turns, this prevents her AI from getting close to the bugbear and trying to attack him, defeating the purpose of the situation
		IF
		DB_Is_InCombat(S_GLO_Stargazer_cd442e20-a6de-4497-ac51-8466433a758e,_Id)
		AND
		DB_Is_InCombat(S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523,_BId)
		AND
		_Id == _BId
		AND
		QRY_OnlyOnce("GLO_Stargazer_EnteredCombatWithBugbear")
		THEN
		ApplyStatus(S_GLO_Stargazer_cd442e20-a6de-4497-ac51-8466433a758e,"FEARED",-1.0,1,S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523);
		
		IF
		DB_PermaDefeated((CHARACTER)S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523)
		AND
		HasActiveStatus((CHARACTER)S_GLO_Stargazer_cd442e20-a6de-4497-ac51-8466433a758e, "FEARED", 1)
		THEN
		RemoveStatus(S_GLO_Stargazer_cd442e20-a6de-4497-ac51-8466433a758e, "FEARED", S_GLO_Stargazer_cd442e20-a6de-4497-ac51-8466433a758e);
		
		//END_REGION
		
		//REGION Adventurer Gear Ownership Swap
		
		//An adventurer died in the grove - swap who 'owns' their camp gear
		PROC
		PROC_StateSet_PermaDefeated(_Adventurer)
		AND
		DB_DEN_AdventurerOwnership((CHARACTER)_Adventurer,1)
		THEN
		NOT DB_DEN_AdventurerOwnership((CHARACTER)_Adventurer,1);
		PROC_DEN_SwapAdventurerCampOwnership(_Adventurer);
		
		//Set next available adventurer as the owner
		PROC
		PROC_DEN_SwapAdventurerCampOwnership((CHARACTER)_Adventurer)
		AND
		DB_DEN_AdventurerOwnership(_OtherAdventurer,0)
		AND
		NOT DB_PermaDefeated((CHARACTER)_OtherAdventurer)
		AND
		NOT DB_DEN_AdventurerOwnership(_,1)
		THEN
		NOT DB_DEN_AdventurerOwnership((CHARACTER)_OtherAdventurer,0);
		DB_DEN_AdventurerOwnership((CHARACTER)_OtherAdventurer,1);
		DB_ItemOwnerShipTriggers("WLD_Main_A", TRIGGERGUID_S_DEN_AdventurersOwnership_cae8006a-7681-40a9-a30f-226a98222f11, (CHARACTER)_OtherAdventurer);
		
		//No adventurers left alive - clear ownership
		PROC
		PROC_DEN_SwapAdventurerCampOwnership((CHARACTER)_Adventurer)
		AND
		NOT DB_DEN_AdventurerOwnership(_,_)
		THEN
		TriggerClearItemsOwner(TRIGGERGUID_S_DEN_AdventurersOwnership_cae8006a-7681-40a9-a30f-226a98222f11);
		
		//Adventurers left grove - clear ownership
		PROC
		PROC_DEN_RaidingParty_AdventurersLeaveDen()
		THEN
		TriggerClearItemsOwner(TRIGGERGUID_S_DEN_AdventurersOwnership_cae8006a-7681-40a9-a30f-226a98222f11);
		
		PROC
		PROC_State_Changed(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", _State)
		AND
		NOT DB_DEN_DefaultStates(_State)
		THEN
		TriggerClearItemsOwner(TRIGGERGUID_S_DEN_AdventurersOwnership_cae8006a-7681-40a9-a30f-226a98222f11);
		
		//END_REGION
		
		//REGION Young Lovers Dialog Swapping
		//If possible, the young lovers have a shared dialog together. If either dies/is unavailable, play their backup solo instead.
		
		QRY
		QRY_SelectCustomDialog_AfterGenerics(S_GLO_YoungLover_01_dd9178e7-1e3f-43bc-8a38-666dfcac7d0c, _Player)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_GLO_YoungLover_02_dcf597c0-36c5-4c81-957a-6fe9fca50a68, _Player)
		AND
		DB_Dialogs(S_GLO_YoungLover_01_dd9178e7-1e3f-43bc-8a38-666dfcac7d0c, DEN_General_YoungLover_1_e9c0afe0-919f-e0c4-63e6-0f2dbb25da99)
		THEN
		DB_SelectedDialog(DEN_General_YoungLover1_2_89296c28-6d0a-d639-43d8-0d63bb7a868c,S_GLO_YoungLover_01_dd9178e7-1e3f-43bc-8a38-666dfcac7d0c, S_GLO_YoungLover_02_dcf597c0-36c5-4c81-957a-6fe9fca50a68, _Player);
		
		QRY
		QRY_SelectCustomDialog_AfterGenerics(S_GLO_YoungLover_01_dd9178e7-1e3f-43bc-8a38-666dfcac7d0c, _Player)
		AND
		NOT QRY_SpeakerIsAvailableAndInDialogRange(S_GLO_YoungLover_02_dcf597c0-36c5-4c81-957a-6fe9fca50a68, _Player)
		AND
		DB_Dialogs(S_GLO_YoungLover_01_dd9178e7-1e3f-43bc-8a38-666dfcac7d0c, DEN_General_YoungLover_1_e9c0afe0-919f-e0c4-63e6-0f2dbb25da99)
		THEN
		DB_SelectedDialog(DEN_General_YoungLover_1_e9c0afe0-919f-e0c4-63e6-0f2dbb25da99,S_GLO_YoungLover_01_dd9178e7-1e3f-43bc-8a38-666dfcac7d0c, _Player);
		
		QRY
		QRY_SelectCustomDialog_AfterGenerics(S_GLO_YoungLover_02_dcf597c0-36c5-4c81-957a-6fe9fca50a68, _Player)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_GLO_YoungLover_01_dd9178e7-1e3f-43bc-8a38-666dfcac7d0c, _Player)
		AND
		DB_Dialogs(S_GLO_YoungLover_02_dcf597c0-36c5-4c81-957a-6fe9fca50a68, DEN_General_YoungLover_2_5749ab40-51da-b8c0-6105-2f5f89d55f12)
		THEN
		DB_SelectedDialog(DEN_General_YoungLover1_2_89296c28-6d0a-d639-43d8-0d63bb7a868c,S_GLO_YoungLover_01_dd9178e7-1e3f-43bc-8a38-666dfcac7d0c, S_GLO_YoungLover_02_dcf597c0-36c5-4c81-957a-6fe9fca50a68, _Player);
		
		QRY
		QRY_SelectCustomDialog_AfterGenerics(S_GLO_YoungLover_02_dcf597c0-36c5-4c81-957a-6fe9fca50a68, _Player)
		AND
		NOT QRY_SpeakerIsAvailableAndInDialogRange(S_GLO_YoungLover_01_dd9178e7-1e3f-43bc-8a38-666dfcac7d0c, _Player)
		AND
		DB_Dialogs(S_GLO_YoungLover_02_dcf597c0-36c5-4c81-957a-6fe9fca50a68, DEN_General_YoungLover_2_5749ab40-51da-b8c0-6105-2f5f89d55f12)
		THEN
		DB_SelectedDialog(DEN_General_YoungLover_2_5749ab40-51da-b8c0-6105-2f5f89d55f12,S_GLO_YoungLover_02_dcf597c0-36c5-4c81-957a-6fe9fca50a68, _Player);
		
		//END_REGION
		
		//REGION Young Lovers death reaction
		
		IF
		DB_PermaDefeated(_Lover1)
		AND
		DB_DEN_YoungLovers((CHARACTER)_Lover1)
		AND
		QRY_State_IsBeforeState(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_Final")
		AND
		DB_DEN_YoungLovers(_Lover2)
		AND
		_Lover2 != _Lover1
		THEN
		ObjectTimerLaunch(_Lover2, "DEN_LoverStartsLeaving", 1000, 1);
		
		IF
		ObjectTimerFinished((CHARACTER)_Lover2, "DEN_LoverStartsLeaving")
		THEN
		PROC_DEN_LeaveDen(_Lover2);
		
		//END_REGION
		
		//REGION Irritated Tiefling
		
		IF
		DialogEnded(DEN_IrritatedTiefling_5b0bd225-2326-0794-7a25-ef56cb3c26f0, _)
		AND
		DB_GlobalFlag(DEN_IrritatedTiefling_State_Improved_279efec5-2bfe-4272-c0cd-e53ef228341b)
		THEN
		NOT DB_HasItemEvent(S_DEN_IrritatedReward_c79f5527-afd4-4a2b-9b73-0867c832e5ef, DEN_IrritatedTiefling_State_HasReward_4fa6bc00-978e-b1f5-cfaf-dcb7e0cf0529);
		NOT DB_GiveItemToEvent(S_DEN_IrritatedReward_c79f5527-afd4-4a2b-9b73-0867c832e5ef, DEN_IrritatedTiefling_Event_GiveReward_6f11ac41-9b28-2ab9-e4c1-7b03aaa4f026);
		
		IF
		DialogEnded(DEN_IrritatedTiefling_5b0bd225-2326-0794-7a25-ef56cb3c26f0, _)
		AND
		DB_GlobalFlag(DEN_IrritatedTiefling_State_NoImprovement_d6dba26c-fd6b-ab13-960d-7bb4df49e193)
		THEN
		NOT DB_HasItemEvent(S_DEN_IrritatedReward_c79f5527-afd4-4a2b-9b73-0867c832e5ef, DEN_IrritatedTiefling_State_HasReward_4fa6bc00-978e-b1f5-cfaf-dcb7e0cf0529);
		NOT DB_GiveItemToEvent(S_DEN_IrritatedReward_c79f5527-afd4-4a2b-9b73-0867c832e5ef, DEN_IrritatedTiefling_Event_GiveReward_6f11ac41-9b28-2ab9-e4c1-7b03aaa4f026);
		
		//END_REGION
		
		//REGION Hay Chest
		IF
		FlagSet(DEN_General_Knows_HayChest_2e45e632-290b-5561-7f51-af5400a93dbc,_,_)
		AND
		QRY_OnlyOnce("DEN_General_HayReveal")
		THEN
		SetEntityEvent(S_DEN_TieflingRefugee004_Hay_a7c96f0a-dfc0-4c4f-a762-af09ae2bff24,"StoryReveal");
		
		IF
		UseStarted(_Char,S_DEN_TieflingRefugee004_Hay_a7c96f0a-dfc0-4c4f-a762-af09ae2bff24)
		AND
		QRY_OnlyOnce("DEN_General_HayReveal")
		THEN
		SetFlag(DEN_General_Knows_HayChest_2e45e632-290b-5561-7f51-af5400a93dbc,NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		UseStarted(_Char,S_DEN_TieflingRefugee004_Hay_a7c96f0a-dfc0-4c4f-a762-af09ae2bff24)
		AND
		DB_Players(_Char)
		AND
		QRY_OnlyOnce("DEN_General_HayReward")
		THEN
		QuestUpdate(_Char,"HIDDEN_WLD_Boosters","DEN_OxHayStack_Looted");
		//END_REGION
		
		//REGION Tieflings Gone / Only Druids Setup
		
		PROC
		PROC_State_Changed(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", _State)
		AND
		DB_DEN_OnlyDruidStates(_State)
		AND
		DB_DEN_TieflingsGone_GroveNPCs(_Druid,_Target)
		AND
		NOT DB_Defeated(_Druid)
		AND
		_Target!=NULL_00000000-0000-0000-0000-000000000000
		THEN
		PurgeOsirisQueue(_Druid);
		TeleportTo(_Druid,_Target);
		
		//END_REGION
		
		//REGION State transitions for too few tieflings in the Grove.
		
		//Check if too many tieflings have left or have been defeated whenever all players have left the Grove.
		PROC
		PROC_CounterIncreased("DEN_MissingTieflings", _Count)
		AND
		DB_DEN_Misc_TieflingCountTreshold(_Treshold)
		AND
		_Count >= _Treshold 
		AND
		QRY_DEN_CheckBeforeState("DEN_State_GoblinHuntVictory")
		THEN
		PROC_RemoveCounter("DEN_MissingTieflings");
		PROC_GlobalSetFlagAndCache(DEN_GroveConflict_State_TooLowTieflings_ed9fe6c4-5037-4f74-968c-a166aeb29d9c);
		
		PROC
		PROC_DEN_AllPlayersLeftDen()
		AND
		DB_GlobalFlag(DEN_GroveConflict_State_TooLowTieflings_ed9fe6c4-5037-4f74-968c-a166aeb29d9c)
		AND
		QRY_DEN_CheckBeforeState("DEN_State_GoblinHuntVictory")
		THEN
		PROC_DEN_Misc_TryChangeTooLowTieflingsState();
		
		PROC
		PROC_DEN_Misc_TryChangeTooLowTieflingsState()
		AND
		QRY_DEN_Lockdown_CanDoRitual()
		THEN
		PROC_State_Progress(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_Lockdown");
		
		PROC
		PROC_DEN_Misc_TryChangeTooLowTieflingsState()
		THEN
		PROC_State_IfCurrentProgress(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_RitualStopped", "DEN_State_RitualStoppedNoTieflings");
		
		PROC
		PROC_DEN_Misc_TryChangeTooLowTieflingsState()
		THEN
		PROC_State_IfCurrentProgress(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_PostDruidAttack", "DEN_State_RitualStoppedNoTieflings");
		
		PROC
		PROC_DEN_Misc_TryChangeTooLowTieflingsState()
		AND
		DB_DEN_NPC(S_DEN_CapturedGoblin_783d7572-a846-455f-b686-247a95263ebb, _, _)
		THEN
		Die(S_DEN_CapturedGoblin_783d7572-a846-455f-b686-247a95263ebb, DEATHTYPE.DoT, NULL_00000000-0000-0000-0000-000000000000, 1, 1);
		
		PROC
		PROC_State_Changed(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_RitualStoppedNoTieflings")
		THEN
		SetFlag(DEN_General_State_RitualStoppedNoTieflings_f4712c06-ae76-4ba3-87e8-a3f71d9b621c, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		PROC
		PROC_State_Changed(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_RitualStoppedNoTieflings")
		AND
		DB_DEN_NPC(_Character, _, _)
		AND
		NOT DB_DEN_TieflingsGone_GroveNPCs(_Character, _)
		AND
		NOT DB_Defeated(_Character)
		THEN
		SetOnStage(_Character, 0);
		SetEntityEvent(_Character, "DEN_NPC_LeftDen");
		
		PROC
		PROC_State_Changed(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_RitualStoppedNoTieflings")
		THEN
		//Macoryl needs to change dialogs.
		PROC_RemoveAllDialogEntriesForSpeaker(S_DEN_ServantIntolerant_002_6f36c7a1-edfd-4e99-bd90-6d874f68c9b8);
		DB_Dialogs(S_DEN_ServantIntolerant_002_6f36c7a1-edfd-4e99-bd90-6d874f68c9b8, DEN_AttackOnDen_Servant002_a26efdf1-4eba-d7dc-f335-b585a530c2da);
		
		IF
		FlagSet(DEN_GroveConflict_State_TooLowTieflings_ed9fe6c4-5037-4f74-968c-a166aeb29d9c, _, _)
		THEN
		PROC_DEN_Misc_NoTieflings_JournalHook();
		
		//Keep count of the amount of tieflings that have been defeated in the Grove or have left the Grove.
		PROC
		PROC_DEN_RemoveFromDenNPCs((CHARACTER)_Char)
		AND
		IsTagged(_Char,TIEFLING_aaef5d43-c6f3-434d-b11e-c763290dbe0c,1)
		THEN
		PROC_IncreaseCounter("DEN_MissingTieflings");
		
		PROC
		PROC_StateSet_PermaDefeated(_Char)
		AND
		DB_DEN_NPC((CHARACTER)_Char,_,_)
		AND
		IsTagged(_Char,TIEFLING_aaef5d43-c6f3-434d-b11e-c763290dbe0c,1)
		THEN
		PROC_IncreaseCounter("DEN_MissingTieflings");
		
		//END_REGION
		
		//REGION Tieflings become hostile to the players and kids leave the grove if too many of them have been killed in peace state.
		
		IF
		FlagSet(DEN_GroveConflict_State_TooLowTieflings_ed9fe6c4-5037-4f74-968c-a166aeb29d9c, _, _)
		THEN
		PROC_DEN_Misc_AdjustRemainingTieflings();
		
		PROC
		PROC_DEN_Misc_AdjustRemainingTieflings()
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT1_DEN_Tieflings_ca9de2d9-9022-9215-6d9b-676d916dcb5a, 0);
		
		//Children flee
		PROC
		PROC_DEN_Misc_AdjustRemainingTieflings()
		AND
		DB_DEN_NPC(_Child, "Hideout", _)
		AND
		DB_Children(_Child)
		THEN
		PROC_ForceStopDialog(_Child);
		PROC_DisappearOutOfSight(_Child, "Run", 1, "DEN_NPC_LeftDen");
		
		//END_REGION
		
		//REGION DEN NPC management
		
		IF
		DB_DEN_NPC(_Character, _, _)
		THEN
		DB_DEN_WasInDen(_Character);
		
		IF
		EntityEvent((CHARACTER)_Character, "DEN_NPC_LeftDen")
		AND
		NOT DB_PermaDefeated(_Character)
		AND
		NOT DB_Players(_Character)
		THEN
		PROC_DEN_RemoveFromDenNPCs(_Character);
		
		//Update
		PROC
		PROC_DEN_AddOrUpdateDenNPC((CHARACTER)_Character, (STRING)_Role, (DIALOGRESOURCE)_AttackOnDenDialog)
		AND
		DB_DEN_NPC(_Character, _InitialRole, _InitialAttackOnDenDialog)
		THEN
		NOT DB_DEN_NPC(_Character, _InitialRole, _InitialAttackOnDenDialog);
		DB_DEN_NPC(_Character, _Role, _AttackOnDenDialog);
		
		//Add a character to the NPC DB and include them into the attack on den situation by providing a location and dialog.
		PROC
		PROC_DEN_AddOrUpdateDenNPC((CHARACTER)_Character, (STRING)_Role, (DIALOGRESOURCE)_AttackOnDenDialog)
		AND
		NOT DB_DEN_NPC(_Character, _, _)
		THEN
		DB_DEN_NPC(_Character, _Role, _AttackOnDenDialog);
		
		
		PROC
		PROC_DEN_RemoveFromDenNPCs((CHARACTER)_Character)
		AND
		DB_DEN_NPC(_Character, _Role, _AttackOnDenDialog)
		THEN
		NOT DB_DEN_WasInDen(_Character);
		NOT DB_DEN_NPC(_Character, _Role, _AttackOnDenDialog);
		
		PROC
		PROC_DEN_RemoveFromDenNPCs((CHARACTER)_Character)
		AND
		DB_DEN_LeaveEvents(_Character,_Event)
		THEN
		NOT DB_DEN_LeaveEvents(_Character,_Event);
		SetEntityEvent(_Character, _Event);
		
		PROC
		PROC_StateSet_PermaDefeated(_Character)
		AND
		_Character != S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d	//Wyll exception. Does not get removed by death since he can be resurrected. He gets removed when recruited instead.
		AND
		DB_DEN_NPC((CHARACTER)_Character, _Role, _AttackOnDenDialog)
		THEN
		NOT DB_DEN_NPC((CHARACTER)_Character, _Role, _AttackOnDenDialog);
		
		IF
		WentOnStage(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, 0)
		AND
		DB_DEN_NPC(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, _Role, _Dialog)
		THEN
		NOT DB_DEN_NPC(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, _Role, _Dialog);
		
		//END_REGION
		
		//REGION Topical Greeting
		
		PROC
		PROC_DEN_AllPlayersLeftDen()
		AND
		DB_GlobalFlag(DEN_General_State_Entered_26b2dc6a-e5eb-4d99-a4bd-3ecaa3b86a9e)
		THEN
		SetFlag(DEN_General_Event_AllPlayersLeftGroveOnce_57e4753f-ce94-4592-b877-4a64c9914008, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		FlagSet(DEN_General_State_Entered_26b2dc6a-e5eb-4d99-a4bd-3ecaa3b86a9e, _, _)
		AND
		DB_Avatars(_Avatar)
		AND
		QRY_OnlyOnce("TG_DEN_Entered")
		THEN
		SetFlag(TG_DEN_Entered_aed4b025-f290-4ec5-b8f1-34b0b9b56576, _Avatar, 0);
		
		
		
		//END_REGION
		
		//REGION Place Tiefling corpses on Bridge
		IF
		LevelLoaded("WLD_Main_A")
		AND
		NOT DB_DEN_UnhelpedTieflingsSlaughtered(1)
		AND
		NOT DB_GlobalFlag((FLAG)DEN_AttackOnDen_State_DenVictory_71c7f23e-3ff1-c9b8-3ef5-d75fa1b42c8d)
		AND
		QRY_DEN_LeftWilderness()
		THEN
		PROC_DEN_KillHalsin();
		PROC_DEN_DechildTielfingKids();
		PROC_DEN_KillTieflings();
		DB_DEN_UnhelpedTieflingsSlaughtered(1);
		
		QRY
		QRY_DEN_LeftWilderness()
		AND
		DB_GlobalFlag((FLAG)VISITEDREGION_CRE_Main_A_c22062f9-2a42-4e19-8c72-34a2d9ff9c0a)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_DEN_LeftWilderness()
		AND
		DB_GlobalFlag((FLAG)VISITEDREGION_SCL_Main_A_f6e72539-9bc6-42e1-a20f-390f3a17ad8d)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_DEN_DechildTielfingKids()
		AND
		DB_PermaDefeated((CHARACTER)S_DEN_TieflingLeader_475200ee-cc3c-4dbe-84b1-1820c02ea26a)
		AND
		DB_Children((CHARACTER)_TieflingKid)
		AND
		IsTagged(_TieflingKid, (TAG)TIEFLING_aaef5d43-c6f3-434d-b11e-c763290dbe0c, 1)
		THEN
		PROC_Children_RemoveNPC(_TieflingKid);
		
		PROC
		PROC_DEN_DechildTielfingKids()
		AND
		NOT DB_PermaDefeated((CHARACTER)S_DEN_TieflingLeader_475200ee-cc3c-4dbe-84b1-1820c02ea26a)
		AND
		DB_Children((CHARACTER)_TieflingKid)
		AND
		NOT DB_DEN_ProtectedChildren(_TieflingKid)
		AND
		IsTagged(_TieflingKid, (TAG)TIEFLING_aaef5d43-c6f3-434d-b11e-c763290dbe0c, 1)
		THEN
		PROC_Children_RemoveNPC(_TieflingKid);
		
		PROC
		PROC_DEN_KillTieflings()
		AND
		DB_PermaDefeated((CHARACTER)S_DEN_TieflingLeader_475200ee-cc3c-4dbe-84b1-1820c02ea26a)
		AND
		DB_FOR_SlaughteredTieflingTriggers((CHARACTER)_Tiefling, (TRIGGER)_Trigger)
		AND
		NOT DB_Dead(_Tiefling)
		AND
		IsTagged(_Tiefling, (TAG)TIEFLING_aaef5d43-c6f3-434d-b11e-c763290dbe0c, 1)
		THEN
		SetOnStage(_Tiefling, 1);
		TeleportTo(_Tiefling, _Trigger);
		Die(_Tiefling, DEATHTYPE.Physical, 1);
		
		PROC
		PROC_DEN_KillTieflings()
		AND
		NOT DB_PermaDefeated((CHARACTER)S_DEN_TieflingLeader_475200ee-cc3c-4dbe-84b1-1820c02ea26a)
		AND
		DB_FOR_SlaughteredTieflingTriggers((CHARACTER)_Tiefling, (TRIGGER)_Trigger)
		AND
		NOT DB_Dead(_Tiefling)
		AND
		NOT DB_DEN_ProtectedChildren(_Tiefling)
		AND
		IsTagged(_Tiefling, (TAG)TIEFLING_aaef5d43-c6f3-434d-b11e-c763290dbe0c, 1)
		THEN
		TeleportTo(_Tiefling, _Trigger);
		Die(_Tiefling, DEATHTYPE.Physical, 1);
		
		PROC
		PROC_DEN_KillTieflings()
		AND
		QRY_DEN_CheckBeforeState("DEN_State_GoblinHuntVictory")
		THEN
		PROC_DEN_Misc_TryChangeTooLowTieflingsState();
		
		PROC
		PROC_DEN_KillHalsin()
		AND
		NOT DB_InCamp(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		AND
		NOT DB_PartOfTheTeam(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		THEN
		Die(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, DEATHTYPE.Physical, 1);
		
		PROC
		PROC_DEN_AttackOnDen_RaidersGoInsideDen()
		AND
		IsTagged(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, (TAG)AI_BLOCKWEAPONACTIONS_53c3304c-032d-4c49-86df-00b3b03a6b13, 1)
		THEN
		ClearTag(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, (TAG)AI_BLOCKWEAPONACTIONS_53c3304c-032d-4c49-86df-00b3b03a6b13);
		//END_REGION
		
		//REGION Gale/Shadowheart entrance banter
		
		IF
		FlagSet(DEN_PartyProgress_EnteredGrove_18cfaaeb-c0df-46ac-962d-0c300f816d73, _, _)
		AND
		NOT DB_GlobalFlag((FLAG)DEN_GroveConflict_State_TooLowTieflings_ed9fe6c4-5037-4f74-968c-a166aeb29d9c)
		AND
		QRY_DEN_CheckPeaceState()
		THEN
		SetFlag(DEN_General_State_EntranceBanterAvailable_43136ce2-1f9a-404c-af9e-8904b480255e, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		FlagSet(DEN_GroveConflict_State_TooLowTieflings_ed9fe6c4-5037-4f74-968c-a166aeb29d9c, _, _)
		AND
		DB_GlobalFlag(DEN_General_State_EntranceBanterAvailable_43136ce2-1f9a-404c-af9e-8904b480255e)
		THEN
		ClearFlag(DEN_General_State_EntranceBanterAvailable_43136ce2-1f9a-404c-af9e-8904b480255e, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		PROC
		PROC_State_Changed(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", _State)
		AND
		DB_GlobalFlag(DEN_General_State_EntranceBanterAvailable_43136ce2-1f9a-404c-af9e-8904b480255e)
		AND
		NOT QRY_DEN_CheckPeaceState()
		THEN
		ClearFlag(DEN_General_State_EntranceBanterAvailable_43136ce2-1f9a-404c-af9e-8904b480255e, NULL_00000000-0000-0000-0000-000000000000, 0);
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(122).Title("Act1_DEN_Paralyzed");
Goal(122)
{
	INIT
	{
		//REGION Paralyzed Tiefling General
		SetVisible(S_DEN_Tiefling005_ParalyzedSeat_54d5ccc0-e453-48f6-89d5-d02a6b884420, 0);
		PROC_DEN_Tiefling5_Init();
		
		TriggerRegisterForItems(S_DEN_Storage_SUB_28361464-314c-474e-96f2-cf56a9eb8afd);
		
		DB_DialogMoneyTransfer(1,DEN_General_TieflingGuard5_7d3ed8cb-6b82-ccdf-3030-9f97de65b219,5,1);
		DB_DialogMoneyTransfer(2,DEN_General_TieflingGuard5_7d3ed8cb-6b82-ccdf-3030-9f97de65b219,5,1);
		
		DB_HasItemEvent((ITEM)S_DEN_Tiefling5Bag_d714d2fe-8344-4982-a110-f0bd2f3b2312,(FLAG)DEN_Tiefling5_State_HasBag_cac9d1d7-22fd-46c4-a5c1-93b4369d23b4);
		DB_GiveItemToEvent((ITEM)S_DEN_Tiefling5Bag_d714d2fe-8344-4982-a110-f0bd2f3b2312,(FLAG)DEN_Tiefling5_Event_GaveBag_267db127-2fb3-4b8f-8bc7-dbbddb19741f);
		
		DB_DEN_Paralyzed_AngeredFlags((FLAG)DEN_Tiefling5_State_TurnedHostile_4b77b883-d393-f092-61ab-36439f1c73ac);
		DB_DEN_Paralyzed_AngeredFlags(DEN_Event_TieflingGuard5_Threatened_14c555a3-43a6-8494-400d-5be65ddc2760);
		
		DB_GLO_Plague_Cures("Target_LesserRestoration",(FLAG)DEN_General_State_HasLesserRestoration_b9e84d98-54aa-d5a5-2505-d1ba61e1b296,(FLAG)DEN_General_Event_TryLesserRestoration_83bcd658-6ac9-8d03-c306-57428dcd0c9d,"DEN_Tiefling_005");
		
		//END_REGION
		
		//REGION Paralyzed Custom Crimes
		DB_CrimeType_CustomWarning((CHARACTER)S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,"MoveForbiddenItem",(DIALOGRESOURCE)DEN_General_TieflingGuard5_7d3ed8cb-6b82-ccdf-3030-9f97de65b219);
		DB_CrimeType_CustomWarning((CHARACTER)S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,"UseForbiddenItem",(DIALOGRESOURCE)DEN_General_TieflingGuard5_7d3ed8cb-6b82-ccdf-3030-9f97de65b219);
		DB_CrimeType_CustomWarning((CHARACTER)S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,"SneakUseForbiddenItem",(DIALOGRESOURCE)DEN_General_TieflingGuard5_7d3ed8cb-6b82-ccdf-3030-9f97de65b219);
		DB_CrimeType_CustomWarning((CHARACTER)S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,"Steal",(DIALOGRESOURCE)DEN_General_TieflingGuard5_7d3ed8cb-6b82-ccdf-3030-9f97de65b219);
		DB_CrimeType_CustomWarning((CHARACTER)S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,"PickPocketFailed",(DIALOGRESOURCE)DEN_General_TieflingGuard5_7d3ed8cb-6b82-ccdf-3030-9f97de65b219);
		DB_CrimeType_CustomWarning((CHARACTER)S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,"Vandalise",(DIALOGRESOURCE)DEN_General_TieflingGuard5_7d3ed8cb-6b82-ccdf-3030-9f97de65b219);
		DB_CrimeType_CustomWarning((CHARACTER)S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,"ItemDestroy",(DIALOGRESOURCE)DEN_General_TieflingGuard5_7d3ed8cb-6b82-ccdf-3030-9f97de65b219);
		
		DB_TrespassTrigger(S_DEN_Tiefling005_Trespassing_a2f33199-1006-4371-ac62-3dbfbd6513fb,NULL_00000000-0000-0000-0000-000000000000,"DEN_StorageRoomTrespass");
		
		DB_DEN_Tiefling5_TrespassEndFlags((FLAG)DEN_Tiefling5_Event_PersuadeSuccess_399baaf0-33a1-6ebd-a6a3-08dcc4fc67fe);
		DB_DEN_Tiefling5_TrespassEndFlags(DEN_Event_TieflingGuard5_Threatened_14c555a3-43a6-8494-400d-5be65ddc2760);
		DB_DEN_Tiefling5_TrespassEndFlags(DEN_TieflingGuard5_Event_CharlatanPersuade_8a5159be-f4d6-02f0-2142-08b561c88517);
		//END_REGION
		
		//REGION Curing Paralysis In Dialog
		
		DB_GLO_Plague_CureFlags((FLAG)DEN_General_State_HasTiefling005Cure_0434ab65-b09e-c718-9aec-49cd2247f76a,(FLAG)DEN_General_State_PartyHasTiefling005Cure_efad0a21-a792-abe7-45b5-997bf8ef9bb4,"DEN_Tiefling_005");
		DB_GLO_Plague_CureCheck((FLAG)DEN_General_Event_TryTiefling005Cure_52f69933-c121-449e-bfa9-10bff44392a7,(FLAG)DEN_General_State_PotionTieflingHealed_0dece41d-7a76-193e-1a6b-1efc7e4497ab,"DEN_Tiefling_005");
		
		PROC_TriggerRegisterForPlayers(S_DEN_RatWander_Shack_683b9c3a-3568-4d8f-83e2-0de771b716d1);
		//END_REGION
	}
	KB
	{
		//REGION Paralyzed Guard Setup
		
		PROC
		PROC_DEN_Tiefling5_Init()
		THEN
		PROC_CharacterDisableAllCrimes(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492, 1); //only react to certain crimes (can't react to everything because paralyzed off start)
		PROC_CharacterEnableCrime(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,"MoveForbiddenItem");
		PROC_CharacterEnableCrime(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,"UseForbiddenItem");
		PROC_CharacterEnableCrime(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,"SneakUseForbiddenItem");
		PROC_CharacterEnableCrime(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,"Steal");
		PROC_CharacterEnableCrime(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,"PickPocketFailed");
		PROC_CharacterEnableCrime(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,"Vandalise");
		PROC_CharacterEnableCrime(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,"ItemDestroy");
		PROC_CharacterEnableCrime(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,"DEN_StorageRoomTrespass");
		PROC_CharacterEnableCrime(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,"DEN_StorageRoomTrespass_CallForHelp");
		PROC_CharacterEnableCrime(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,"WaitingForCalledGuard");
		
		//force remove paralysis when states advance far enough
		PROC
		PROC_State_Changed(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", _State)
		AND
		DB_State_Priority(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", _State, _Priority)
		AND
		_Priority > 4000
		THEN
		PROC_DEN_Tiefling5_RemoveParalysis();
		
		//END_REGION
		
		//REGION Custom Paralyzed Crime Handling
		
		PROC
		PROC_CharacterRegisterCrime_Success(_, "DEN_StorageRoomTrespass",_,(TRIGGER)S_DEN_Tiefling005_Trespassing_a2f33199-1006-4371-ac62-3dbfbd6513fb,_,_)
		THEN
		DB_DEN_Tiefling5_IgnoreOtherCharactersTrespassing(1);
		
		IF
		LeftTrigger(_Player, S_DEN_Tiefling005_Trespassing_a2f33199-1006-4371-ac62-3dbfbd6513fb)
		AND
		DB_DEN_Tiefling5_IgnoreOtherCharactersTrespassing(1)
		AND
		NOT QRY_TriggerEvents_AnyPlayerInTrigger(S_DEN_Tiefling005_Trespassing_a2f33199-1006-4371-ac62-3dbfbd6513fb)
		THEN
		NOT DB_DEN_Tiefling5_IgnoreOtherCharactersTrespassing(1);
		
		QRY
		QRY_CRIME_BlockRegisterCrime(_Player, "DEN_StorageRoomTrespass", _, _, _)
		AND
		DB_DEN_Tiefling5_IgnoreOtherCharactersTrespassing(1)
		THEN
		DB_NOOP(1);
		
		
		QRY
		QRY_CRIME_BlockRegisterCrime(_Player, "DEN_StorageRoomTrespass", _, _, _)
		AND
		DB_Players(_Player)
		AND
		DB_DEN_Tiefling5_TrespassEndFlags(_Flag)
		AND
		DB_GlobalFlag(_Flag)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_CRIME_BlockRegisterCrime(_Player, "DEN_StorageRoomTrespass", _, _, _)
		AND
		DB_Players(_Player)
		AND
		GetFlag(DEN_General_State_PotionTieflingHealed_0dece41d-7a76-193e-1a6b-1efc7e4497ab,S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,1)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_CRIME_BlockRegisterCrime(_Player, "DEN_StorageRoomTrespass_CallForHelp", _, _, _)
		AND
		DB_Players(_Player)
		AND
		GetFlag(DEN_General_State_PotionTieflingHealed_0dece41d-7a76-193e-1a6b-1efc7e4497ab,S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,1)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_CRIME_BlockGenericInvestigation(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492)
		AND
		GetFlag(DEN_General_State_PotionTieflingHealed_0dece41d-7a76-193e-1a6b-1efc7e4497ab,S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,0)
		THEN
		SetEntityEvent(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492, "CRIME_StartLookingForInterrogationSuspects");
		
		//Clear trespassing crime if state changes beyond default grove state
		PROC
		PROC_State_Changed(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", _State)
		AND
		NOT DB_DEN_DefaultStates(_State)
		THEN
		PROC_DEN_Tiefling5_ClearTrespassing();
		
		PROC
		PROC_DEN_Tiefling5_ClearTrespassing()
		THEN
		PROC_RemoveDBTrespassTrigger(S_DEN_Tiefling005_Trespassing_a2f33199-1006-4371-ac62-3dbfbd6513fb,NULL_00000000-0000-0000-0000-000000000000);
		PROC_TriggerUnregisterForParty(S_DEN_Tiefling005_Trespassing_a2f33199-1006-4371-ac62-3dbfbd6513fb);
		
		// Distinguish between DEN_StorageRoomTrespass (-> generic dialog flow) and other crimes (-> custom crime dialog flow)
		PROC
		PROC_CrimeDialogSetupFlags((INTEGER)_CrimeID,S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,(CHARACTER)_Criminal1,(CHARACTER)_Criminal2,(CHARACTER)_Criminal3,(CHARACTER)_Criminal4,(DIALOGRESOURCE)DEN_General_TieflingGuard5_7d3ed8cb-6b82-ccdf-3030-9f97de65b219)
		AND
		CrimeGetType(_CrimeID, "DEN_StorageRoomTrespass")
		THEN
		SetFlag((FLAG)DEN_State_TieflingGuard5_StorageRoomTrespass_6bbc0fb4-9ac5-4b32-bcbd-0e2cad946133,(CHARACTER)S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,0);
		
		IF
		DialogEnded((DIALOGRESOURCE)DEN_General_TieflingGuard5_7d3ed8cb-6b82-ccdf-3030-9f97de65b219, _)
		THEN
		ClearFlag((FLAG)DEN_State_TieflingGuard5_StorageRoomTrespass_6bbc0fb4-9ac5-4b32-bcbd-0e2cad946133,(CHARACTER)S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,0);
		//END_REGION
		
		//REGION Dialog Handling + Outcomes
		
		IF
		DialogEnded(DEN_General_TieflingGuard5_7d3ed8cb-6b82-ccdf-3030-9f97de65b219, _Id)
		THEN
		PROC_DEN_Tiefling5_DialogEnded(_Id);
		
		PROC
		PROC_DEN_Tiefling5_DialogEnded((INTEGER)_Id)
		AND
		GetFlag(DEN_Tiefling5_State_TurnedHostile_4b77b883-d393-f092-61ab-36439f1c73ac, S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492, 1)
		AND
		QRY_OnlyOnce("DEN_Tiefling5_TurnedHostile")
		THEN
		PROC_DEN_Tiefling5_HostileTrespassSetup();
		
		PROC
		PROC_DEN_Tiefling5_DialogEnded((INTEGER)_Id)
		AND
		DB_DEN_Tiefling5_TrespassEndFlags(_Flag)
		AND
		DB_GlobalFlag(_Flag)
		AND
		QRY_OnlyOnce("DEN_Tiefling5_NoMoreTrespass")
		THEN
		PROC_DEN_Tiefling5_ClearTrespassing();
		PROC_DEN_Tiefling5_TrespassingEndExtras(_Id);
		
		PROC
		PROC_DEN_Tiefling5_TrespassingEndExtras((INTEGER)_Id)
		AND
		DB_GlobalFlag(DEN_Event_TieflingGuard5_Threatened_14c555a3-43a6-8494-400d-5be65ddc2760)
		THEN
		DB_DEN_Tiefling5_NewCrimeReactionsBlocked(1);
		BlockNewCrimeReactions(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,1); //guard won't react to any new crimes if threatened
		
		PROC
		PROC_DEN_Tiefling5_TrespassingEndExtras((INTEGER)_Id)
		AND
		DB_GlobalFlag(DEN_TieflingGuard5_Event_CharlatanPersuade_8a5159be-f4d6-02f0-2142-08b561c88517)
		AND
		DB_DialogPlayers(_Id,_Player,1)
		THEN
		PROC_ItemOwnership_SetNewTriggerOwner(S_DEN_Tiefling005_Trespassing_a2f33199-1006-4371-ac62-3dbfbd6513fb,(CHARACTER)_Player); //guard believes the player is supposed to be there
		
		//END_REGION
		
		//REGION Paralyzed Hostility
		
		IF
		AttackedBy((CHARACTER)S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,(CHARACTER)_Player,_,_,_,_,_)
		AND
		NOT DB_Defeated(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492)
		AND
		CanSee(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492, _Player, 1)
		AND
		GetFlag(DEN_General_State_PotionTieflingHealed_0dece41d-7a76-193e-1a6b-1efc7e4497ab,S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,0)
		THEN
		PROC_DEN_Tiefling5_UnblockCrimeReactions();
		SetFlag(DEN_Tiefling5_State_TurnedHostile_4b77b883-d393-f092-61ab-36439f1c73ac, S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492);
		
		PROC
		PROC_DEN_Tiefling5_UnblockCrimeReactions()
		AND
		DB_DEN_Tiefling5_NewCrimeReactionsBlocked(1)
		THEN
		NOT DB_DEN_Tiefling5_NewCrimeReactionsBlocked(1);
		BlockNewCrimeReactions(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,0);
		
		IF
		FlagSet(DEN_Tiefling5_State_TurnedHostile_4b77b883-d393-f092-61ab-36439f1c73ac, S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,_)
		AND
		NOT DB_GlobalFlag(DEN_Tiefling5_Event_Warned_d75de198-ec1c-18bf-b981-aa1ad6baa63c)
		THEN
		SetFlag(DEN_Tiefling5_Event_Warned_d75de198-ec1c-18bf-b981-aa1ad6baa63c);
		
		IF
		FlagSet(_Flag, _, _)
		AND
		DB_DEN_Paralyzed_AngeredFlags(_Flag)
		THEN
		SetFlag(DEN_AttackOnDen_State_AngeredPandirnaBefore_55cb1d5b-4035-6241-5b1b-29ae7800944e);
		
		//if turning hostile specifically outside of dialog (preventing overlap)
		IF
		FlagSet(DEN_Tiefling5_State_TurnedHostile_4b77b883-d393-f092-61ab-36439f1c73ac, S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,_)
		AND
		NOT QRY_DEN_Tiefling005_CheckDialog()
		AND
		QRY_OnlyOnce("DEN_Tiefling5_TurnedHostile")
		THEN
		PROC_DEN_Tiefling5_HostileTrespassSetup();
		
		QRY
		QRY_DEN_Tiefling005_CheckDialog()
		AND
		DB_DialogNPCs(_Id,S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,_)
		AND
		DB_DialogName(DEN_General_TieflingGuard5_7d3ed8cb-6b82-ccdf-3030-9f97de65b219,_Id)
		THEN
		DB_NOOP(1);
		
		//reset trespassing trigger to use new crime that calls guards to area
		PROC
		PROC_DEN_Tiefling5_HostileTrespassSetup()
		AND
		GetFlag(DEN_General_State_PotionTieflingHealed_0dece41d-7a76-193e-1a6b-1efc7e4497ab,S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,0)
		THEN
		PROC_DEN_Tiefling5_ClearTrespassing();
		DB_TrespassTrigger(S_DEN_Tiefling005_Trespassing_a2f33199-1006-4371-ac62-3dbfbd6513fb,NULL_00000000-0000-0000-0000-000000000000,"DEN_StorageRoomTrespass_CallForHelp");
		PROC_ItemOwnership_SetNewTriggerOwner(S_DEN_Tiefling005_Trespassing_a2f33199-1006-4371-ac62-3dbfbd6513fb,S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492);
		
		PROC
		PROC_StateSet_Defeated(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492)
		THEN
		EndRepose(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492);
		//BlockNewCrimeReactions(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,1); //was using this because pickpocketing the KO body was throwing a crime during GP presentation, still needed?
		SetHasDialog(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,0);
		
		//END_REGION
		
		//REGION Healing In+Out of Dialog
		
		IF
		DialogActorJoined(DEN_General_TieflingGuard5_7d3ed8cb-6b82-ccdf-3030-9f97de65b219,_ID,S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,_)
		THEN
		PROC_GLO_Plague_PartyCheckCure(_ID,"DEN_Tiefling_005");
		
		PROC
		PROC_DEN_Tiefling5_RemoveParalysis()
		THEN
		DB_DEN_Paralyzed_Healed(1);
		SetFlag(DEN_General_State_PotionTieflingHealed_0dece41d-7a76-193e-1a6b-1efc7e4497ab,S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,0);
		PROC_SelfHealing_Enable(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492);
		PROC_DEN_Tiefling_005_HealedProcessing();
		
		PROC
		PROC_DEN_Tiefling5_RemoveParalysis()
		AND
		HasAppliedStatus(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492, "DEN_PANDIMA_PARALYZED", 1)
		THEN
		RemoveStatus(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492, "DEN_PANDIMA_PARALYZED");
		
		//guard unparalyzed outside of dialog
		IF
		StatusRemoved(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492, "DEN_PANDIMA_PARALYZED", (CHARACTER)_Player, _)
		AND
		DB_Players(_Player)
		AND
		QRY_OnlyOnce("DEN_General_Tiefling5StandUp")
		THEN
		SetFlag(DEN_General_State_PotionTieflingHealer_428d007f-401c-538e-e018-7b72d42c7ff6,_Player,0);
		ClearFlag(DEN_Tiefling5_HasMet_7f5af9c5-10a6-279b-fad9-35674b74b0b0,_Player);
		PROC_DEN_Tiefling5_RemoveParalysis();
		PROC_DEN_Tiefling5_TryRespondToHeal((CHARACTER)_Player, 0);
		
		//0 == Non-hostile response
		PROC
		PROC_DEN_Tiefling5_TryRespondToHeal((CHARACTER)_Player, 0)
		AND
		NOT DB_CantTalk(_Player)
		AND
		QRY_StartDialog_Fixed(DEN_General_TieflingGuard5_7d3ed8cb-6b82-ccdf-3030-9f97de65b219, S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492, _Player)
		THEN
		DB_NOOP(1);
		
		//1 == hostile response
		PROC
		PROC_DEN_Tiefling5_TryRespondToHeal((CHARACTER)_Player, 1)
		AND
		NOT QRY_StartDialog_Fixed(DEN_General_TieflingGuard5_7d3ed8cb-6b82-ccdf-3030-9f97de65b219, S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492, _Player)
		THEN
		SetFlag(DEN_Tiefling5_State_TurnedHostile_4b77b883-d393-f092-61ab-36439f1c73ac, S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492);
		PROC_SetRelationTemporaryHostile(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,_Player);
		
		IF
		StatusRemoved(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492, "DEN_PANDIMA_PARALYZED", (CHARACTER)_Player, _)
		AND
		NOT DB_Players(_Player)
		AND
		QRY_OnlyOnce("DEN_General_Tiefling5StandUp")
		THEN
		PROC_DEN_Tiefling5_RemoveParalysis();
		
		//Player used healing spell that did not remove the status
		IF
		StatusApplied(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492, "HEAL", _Player, _ID)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		HasActiveStatus(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492, "DEN_PANDIMA_PARALYZED", 1)
		AND
		DB_GlobalFlag(DEN_General_State_TieflingGuardWaitingForHeal_aba4b17f-42d3-437c-a018-0838f43c96ce)
		AND
		NOT DB_GlobalFlag(DEN_General_Event_WaitingForHealCastedNonHeal_ec79f887-8447-4f22-825c-fe337ada3aac)
		THEN
		SetFlag(DEN_General_Event_WaitingForHealCastedNonHeal_ec79f887-8447-4f22-825c-fe337ada3aac);
		PROC_DEN_Tiefling5_TryRespondToHeal((CHARACTER)_Player, 0);
		
		// Knocked tiefling shouldn't have the dialogue available
		
		IF
		StatusApplied(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,"KNOCKED_DOWN",_,_)
		THEN
		SetHasDialog(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,0);
		
		//knocking the tiefling over while paralyzed will set the knocked_down status on them. when healed they should lose this if it was applied (if not considered defeated).
		PROC
		PROC_DEN_Tiefling_005_HealedProcessing()
		AND
		HasActiveStatus(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,"KNOCKED_DOWN",1)
		AND
		NOT DB_Defeated(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492)
		THEN
		RemoveStatus(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492, "KNOCKED_DOWN");
		SetHasDialog(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,1);
		
		//the forced trespassing custom crime is removed when the guard is healed in favor of the regular guard reactions via the crimes system
		PROC
		PROC_DEN_Tiefling_005_HealedProcessing()
		THEN
		PROC_DEN_Tiefling5_ClearTrespassing();
		
		//clear the custom crime behaviors on healing
		PROC
		PROC_DEN_Tiefling_005_HealedProcessing()
		AND
		DB_CrimeType_CustomWarning(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,_Crime,_Dialog)
		THEN
		NOT DB_CrimeType_CustomWarning(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,_Crime,_Dialog);
		
		PROC
		PROC_DEN_Tiefling_005_HealedProcessing()
		THEN
		PROC_CharacterEnableAllCrimes(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492);
		PROC_DEN_Tiefling5_UnblockCrimeReactions();
		PROC_RemoveDBTrespassTrigger(S_DEN_Tiefling005_Trespassing_a2f33199-1006-4371-ac62-3dbfbd6513fb,NULL_00000000-0000-0000-0000-000000000000);
		PROC_SetCanFight(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,1);
		SetCanJoinCombat(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,1);
		
		
		//healing the guard while she's 'hostile' to the party will result in her trying to attack right after
		PROC
		PROC_DEN_Tiefling_005_HealedProcessing()
		AND
		GetFlag(DEN_Tiefling5_State_TurnedHostile_4b77b883-d393-f092-61ab-36439f1c73ac, S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492, 1)
		AND
		DB_Players(_Player)
		AND
		DB_InRegion(_Player,S_DEN_Storage_SUB_28361464-314c-474e-96f2-cf56a9eb8afd)
		THEN
		PROC_SetRelationTemporaryHostile(S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,_Player);
		
		IF
		LeftTrigger(_Player, S_DEN_RatWander_Shack_683b9c3a-3568-4d8f-83e2-0de771b716d1)
		AND
		GetFlag(DEN_General_State_MadeParalyzedTieflingPay_7fb10f5d-f4a5-44e7-b53b-96978a866e7e, _Player, 1)
		AND
		GetFlag(DEN_General_State_PotionTieflingHealed_0dece41d-7a76-193e-1a6b-1efc7e4497ab,S_DEN_Tiefling_005_e5319db6-ea86-43cc-9fd0-5ec1e0eab492,0)
		THEN
		SetFlag(DEN_General_Event_PlayerLeftWithoutHealingTiefling_be102d36-bf07-4132-9c04-6a2f40ca7bcb);
		PROC_DEN_Tiefling5_TryRespondToHeal((CHARACTER)_Player, 1);
		//END_REGION
		
		//REGION Debug
		
		IF
		TextEvent("curepandirna")
		THEN
		PROC_DEN_Tiefling5_RemoveParalysis();
		
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(123).Title("Act1_DEN_Prison");
Goal(123)
{
	INIT
	{
		PROC_TriggerRegisterForPlayers(S_DEN_PrisonTrapSetBox_ffb03d40-8e8e-4907-aa52-0fc4b557979d);
		PROC_TriggerRegisterForPlayers(S_DEN_PrisonTrapSpawnBox_000_4647d10e-4eac-42db-936c-e7ce807df880);
		PROC_TriggerRegisterForPlayers(S_DEN_PrisonTrapSpawnBox_001_9c83e771-5d14-4042-8a69-11a39028651e);
		PROC_TriggerRegisterForPlayers(S_DEN_PrisonTrapSpawnBox_002_3d7c9bb1-bccb-4db2-b1cc-6956716dfcb7);
		PROC_TriggerRegisterForPlayers(S_DEN_PrisonTrapSpawnBox_003_23415d44-4e8b-439e-841e-7838d282a121);
		
		DB_DEN_Jailbreak_AllTraps((ITEM)S_DEN_PrisonMushroomTrap_000_1eada771-1fd1-40d8-9105-f597f6e973d0);
		DB_DEN_Jailbreak_AllTraps(S_DEN_PrisonMushroomTrap_001_fc1c12c8-4d08-4701-8d79-b2c45ae13387);
		DB_DEN_Jailbreak_AllTraps(S_DEN_PrisonMushroomTrap_002_06db30ab-b6ac-4f98-a372-e76e5302fc79);
		DB_DEN_Jailbreak_AllTraps(S_DEN_PrisonMushroomTrap_003_ea32a798-7ffd-45e1-bc84-a3c967f4c4bf);
		DB_DEN_Jailbreak_AllTraps(S_DEN_PrisonMushroomTrap_004_58023cd0-80c8-4894-8e91-22b1b3c1ea18);
		
		//Traps manually placed on the platforms, which are replaced after first long rest
		DB_DEN_Jailbreak_FirstPlatformTraps((ITEM)S_DEN_PrisonMushroomTrap_000_1eada771-1fd1-40d8-9105-f597f6e973d0);
		DB_DEN_Jailbreak_FirstPlatformTraps(S_DEN_PrisonMushroomTrap_002_06db30ab-b6ac-4f98-a372-e76e5302fc79);
		
		DB_DEN_Jailbreak_TrapSpawnArea((TRIGGER)S_DEN_PrisonTrapSpawnBox_000_4647d10e-4eac-42db-936c-e7ce807df880);
		DB_DEN_Jailbreak_TrapSpawnArea(S_DEN_PrisonTrapSpawnBox_001_9c83e771-5d14-4042-8a69-11a39028651e);
		DB_DEN_Jailbreak_TrapSpawnArea(S_DEN_PrisonTrapSpawnBox_002_3d7c9bb1-bccb-4db2-b1cc-6956716dfcb7);
		DB_DEN_Jailbreak_TrapSpawnArea(S_DEN_PrisonTrapSpawnBox_003_23415d44-4e8b-439e-841e-7838d282a121);
		
		DB_DEN_Jailbreak_SelectedSpawn((TRIGGER)NULL_00000000-0000-0000-0000-000000000000);
		NOT DB_DEN_Jailbreak_SelectedSpawn((TRIGGER)NULL_00000000-0000-0000-0000-000000000000);
		DB_DEN_Jailbreak_TempSpawnList((TRIGGER)NULL_00000000-0000-0000-0000-000000000000);
		NOT DB_DEN_Jailbreak_TempSpawnList((TRIGGER)NULL_00000000-0000-0000-0000-000000000000);
		DB_DEN_Jailbreak_SpawnedTraps((ITEM)NULL_00000000-0000-0000-0000-000000000000);
		NOT DB_DEN_Jailbreak_SpawnedTraps((ITEM)NULL_00000000-0000-0000-0000-000000000000);
		
		SetHitpoints(S_DEN_PrisonDestructWall_e4436c10-57db-4e25-ab9f-a9abbb221be8, 4);
	}
	KB
	{
		//REGION Platform Traps
		IF
		EnteredTrigger(_Player, S_DEN_PrisonTrapSetBox_ffb03d40-8e8e-4907-aa52-0fc4b557979d)
		AND
		DB_Players(_Player)
		THEN
		SetFlag((FLAG)DEN_Crime_State_EscapedByPlatform_e6de8669-3209-4874-8f69-3c3ec2ec2985, NULL_00000000-0000-0000-0000-000000000000);
		
		PROC
		PROC_LongRest()
		AND
		DB_GlobalFlag((FLAG)DEN_Crime_State_EscapedByPlatform_e6de8669-3209-4874-8f69-3c3ec2ec2985)
		THEN
		NOT DB_OnlyOnce("DEN_Jailbreak_CommentOnFoundTrap");
		NOT DB_OnlyOnce("DEN_Jailbreak_CommentOnTrapDeactivate");
		DB_ExecuteInLevel("DEN_Jailbreak_Reset","WLD_Main_A");
		
		PROC
		PROC_ExecuteInLevel("DEN_Jailbreak_Reset","WLD_Main_A")
		THEN
		PROC_DEN_Jailbreak_ClearInitialTraps();
		PROC_DEN_Jailbreak_ClearTraps();
		PROC_DEN_Jailbreak_SetSpawnList();
		PROC_DEN_Jailbreak_CheckSpawns();
		PROC_DEN_Jailbreak_ClearTempList();
		
		PROC
		PROC_DEN_Jailbreak_ClearInitialTraps()
		AND
		DB_DEN_Jailbreak_FirstPlatformTraps(_Trap)
		THEN
		SetOnStage(_Trap, 0);
		NOT DB_DEN_Jailbreak_AllTraps(_Trap);
		
		PROC
		PROC_DEN_Jailbreak_ClearTraps()
		AND
		DB_DEN_Jailbreak_SpawnedTraps((ITEM)_Trap)
		THEN
		RequestDelete(_Trap);
		NOT DB_DEN_Jailbreak_SpawnedTraps(_Trap);
		NOT DB_DEN_Jailbreak_AllTraps(_Trap);
		
		PROC
		PROC_DEN_Jailbreak_ClearTempList()
		AND
		DB_DEN_Jailbreak_TempSpawnList(_Trigger)
		THEN
		NOT DB_DEN_Jailbreak_TempSpawnList(_Trigger);
		
		PROC
		PROC_DEN_Jailbreak_SetSpawnList()
		AND
		DB_DEN_Jailbreak_TrapSpawnArea(_Trigger)
		THEN
		DB_DEN_Jailbreak_TempSpawnList(_Trigger);
		
		IF
		DB_DEN_Jailbreak_TempSpawnList(_Trigger)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_DEN_Jailbreak_CheckSpawns()
		AND
		QRY_DoNTimes(3)
		AND
		DB_QRY_RTN_DoNTimes(_Index)
		AND
		QRY_GetRandom("DB_DEN_Jailbreak_TempSpawnList", 1, "DB_DEN_Jailbreak_SelectedSpawn")
		AND
		DB_DEN_Jailbreak_SelectedSpawn((TRIGGER)_Trigger)
		THEN
		NOT DB_DEN_Jailbreak_SelectedSpawn(_Trigger);
		NOT DB_DEN_Jailbreak_TempSpawnList(_Trigger);
		PROC_DEN_Jailbreak_CheckForPlayer(_Trigger);
		
		PROC
		PROC_DEN_Jailbreak_CheckForPlayer((TRIGGER)_Trigger)
		AND
		NOT QRY_CheckOtherPlayersInTrigger(NULL_00000000-0000-0000-0000-000000000000, _Trigger)
		THEN
		PROC_DEN_Jailbreak_SpawnTrap(_Trigger);
		
		PROC
		PROC_DEN_Jailbreak_SpawnTrap((TRIGGER)_Trigger)
		AND
		TriggerGetRandomPosition(_Trigger, _X, _Y, _Z)
		AND
		CreateAt((ITEMROOT)PUZ_Underdark_Mushroom_Exploding_Small_A_64e2fdce-a46f-4fd6-8d9c-204f078b873d, _X, _Y, _Z, 0, 0, "", _Trap)
		THEN
		DB_DEN_Jailbreak_SpawnedTraps((ITEM)_Trap);
		DB_DEN_Jailbreak_AllTraps((ITEM)_Trap);
		
		IF
		DB_DEN_Jailbreak_AllTraps((ITEM)_Trap)
		THEN
		DB_PerceptionSkillCheckADBlocked(_Trap);
		
		PROC
		PROC_HiddenPerceptionCheckSucceeded((CHARACTER)_Character,(CHARACTER) _Player,(GUIDSTRING) _Trap)
		AND
		DB_DEN_Jailbreak_AllTraps((ITEM)_Trap)
		THEN
		PROC_DEN_Jailbreak_RevealAD(_Player);
		
		PROC
		PROC_DEN_Jailbreak_RevealAD((CHARACTER)_Player)
		AND
		NOT DB_GlobalFlag(GLO_Mushroom_Knows_Torchstalk_274534be-89c5-40f6-ab58-f91af5a33923)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)DEN_Jailbreak_PAD_DiscoverTrap_3cc24fee-d6b7-7750-cbfd-f7937707f6e2, _Player);
		SetFlag(GLO_Mushroom_Knows_Torchstalk_274534be-89c5-40f6-ab58-f91af5a33923);
		
		//REGION Debug
		IF
		TextEvent("denresettraps")
		THEN
		SetFlag((FLAG)DEN_Crime_State_EscapedByPlatform_e6de8669-3209-4874-8f69-3c3ec2ec2985, NULL_00000000-0000-0000-0000-000000000000);
		PROC_DEN_Jailbreak_ClearInitialTraps();
		PROC_DEN_Jailbreak_ClearTraps();
		PROC_DEN_Jailbreak_SetSpawnList();
		PROC_DEN_Jailbreak_CheckSpawns();
		PROC_DEN_Jailbreak_ClearTempList();
		
		IF
		TextEvent("denspawntraps")
		THEN
		PROC_DEN_Jailbreak_SetSpawnList();
		PROC_DEN_Jailbreak_CheckSpawns();
		
		IF
		TextEvent("dencleartraps")
		THEN
		PROC_DEN_Jailbreak_ClearInitialTraps();
		PROC_DEN_Jailbreak_ClearTraps();
		
		IF
		TextEvent("denrevealtraps")
		AND
		DB_DEN_Jailbreak_AllTraps(_Trap)
		THEN
		SetEntityEvent(_Trap, "StoryReveal");
		
		IF
		TextEvent("gotodenprison")
		AND
		DB_Players(_Player)
		AND
		DB_RegionPrison("WLD_Main_A_DEN", _PrisonCell, _PrisonSpawnPoint)
		AND
		DB_PlayerPrison(_PrisonTrigger, _, _, _FugitiveStatus)
		THEN
		PROC_CrimeTeleportCharacterToPrison(S_DEN_Tiefling_011_77439e86-3f60-4456-bd55-931e2f45654f, _Player, _PrisonCell, _PrisonSpawnPoint, _FugitiveStatus);
		
		
		//END_REGION
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(124).Title("Act1_DEN_RaidingParty");
Goal(124)
{
	INIT
	{
		//REGION Default Dialog 
		
		DB_Dialogs(S_DEN_AdventurerLeader_82d1b843-9e8c-48a5-9d87-caddea5c193c, DEN_RaidingParty_AdventurerLeader_0f2f631a-f47b-eee0-6025-2b814050d453);
		DB_Dialogs(S_DEN_RaidAdventurer_4faf77a0-b883-4f7b-acbf-4500973f446d, DEN_RaidingParty_Adventurer2_8b5b6c19-b64c-9aa9-504d-da47901340b5);
		DB_Dialogs(S_DEN_RobbedAdventurer_534bceaf-678c-40a0-8ca9-e1134f95ba0d, DEN_RaidingParty_Adventurer1_0c9c15fb-cf0a-fb3b-f196-d23a30afc269);
		
		//END_REGION
		
		//REGION Goblin Fight 
		DB_DoNotFaceDialog(S_DEN_AdventurerLeader_82d1b843-9e8c-48a5-9d87-caddea5c193c, DEN_RaidingParty_PleaAtGate_2e71ecd7-3a8e-2d46-8b37-716f6064417e);
		DB_Crime_DoNotStopDialog(DEN_RaidingParty_PleaAtGate_2e71ecd7-3a8e-2d46-8b37-716f6064417e);
		DB_DoNotFaceDialog(S_DEN_RaidAdventurer_4faf77a0-b883-4f7b-acbf-4500973f446d, DEN_RaidingParty_PleaAtGate_2e71ecd7-3a8e-2d46-8b37-716f6064417e);
		DB_DoNotFaceDialog(S_DEN_RobbedAdventurer_534bceaf-678c-40a0-8ca9-e1134f95ba0d, DEN_RaidingParty_PleaAtGate_2e71ecd7-3a8e-2d46-8b37-716f6064417e);
		
		DB_OneShotPartyTrigger(S_DEN_EntranceAreaMain_ee125fea-bd62-4f5c-8fde-04f02a7b6a74);
		DB_AddCharactersInTriggerToDialog(DEN_RaidingParty_PleaAtGate_2e71ecd7-3a8e-2d46-8b37-716f6064417e, S_DEN_FallbackPleaSphere_b18fcf59-ea21-4f14-8ba2-af2d29b81d2f, 1, 1, 1);
		DB_IgnoreMutingStatussesDialog((DIALOGRESOURCE)DEN_RaidingParty_PleaAtTheGate_2e71ecd7-3a8e-2d46-8b37-716f6064417e);
		DB_IgnoreMutingStatussesDialog((DIALOGRESOURCE)DEN_RaidingParty_OpenGate_0310abff-a694-177e-1aa0-a431556a3f3c);
		PROC_TriggerRegisterForPlayers(S_DEN_FallbackPleaSphere_b18fcf59-ea21-4f14-8ba2-af2d29b81d2f);
		
		DB_DEN_RaidingParty_GoblinRaidParticipants((CHARACTER)S_DEN_AdventurerLeader_82d1b843-9e8c-48a5-9d87-caddea5c193c);
		DB_DEN_RaidingParty_GoblinRaidParticipants(S_DEN_RobbedAdventurer_534bceaf-678c-40a0-8ca9-e1134f95ba0d);
		DB_DEN_RaidingParty_GoblinRaidParticipants(S_DEN_RaidAdventurer_4faf77a0-b883-4f7b-acbf-4500973f446d);
		DB_DEN_RaidingParty_GoblinRaidParticipants(S_DEN_TieflingLeader_475200ee-cc3c-4dbe-84b1-1820c02ea26a);
		DB_DEN_RaidingParty_GoblinRaidParticipants(S_DEN_GoblinRaider_001_6a03d0ff-a930-4347-bba2-9f3fd6bc317a);
		DB_DEN_RaidingParty_GoblinRaidParticipants(S_DEN_GoblinRaider_002_7fbfb1b0-184b-4889-935b-f916a7ad1177);
		DB_DEN_RaidingParty_GoblinRaidParticipants(S_DEN_GoblinRaider_003_f1a7c5a6-27e7-4164-a31d-d18b4064df85);
		DB_DEN_RaidingParty_GoblinRaidParticipants(S_DEN_GoblinRaider_004_c3fb3a30-a1a7-4d8a-8b3c-b101657a0a3d);
		DB_DEN_RaidingParty_GoblinRaidParticipants(S_DEN_GoblinRaider_Melee_004_51e9e140-04c2-4598-83c0-787dac74ce61);
		DB_DEN_RaidingParty_GoblinRaidParticipants(S_DEN_GoblinRaider_Ranger_003_442fddf8-875a-4099-8725-12042f9e3ebd);
		DB_DEN_RaidingParty_GoblinRaidParticipants(S_DEN_GoblinRaider_Captain_22d80f21-7f31-4240-b981-9137d53ad77d);
		DB_DEN_RaidingParty_GoblinRaidParticipants(S_DEN_GoblinRaider_Bugbear_01_cde6e700-9c2a-4dec-9081-689881198639);
		
		PROC_DEN_RaidingParty_SetupPleaExtras();
		
		DB_DEN_RaidingParty_RaidingGoblins((CHARACTER)S_DEN_GoblinRaider_Ranger_01_7fbfb1b0-184b-4889-935b-f916a7ad1177, (TRIGGER)S_DEN_GoblinRaiderPos_001_d9627561-c4a2-46d7-8f3c-7fda4c9ad7b5, (TRIGGER)S_DEN_GoblinRaiderAppearPos_001_ae477b7b-c50e-4242-b13a-ec5f3ae82b23); //
		DB_DEN_RaidingParty_RaidingGoblins(S_DEN_GoblinRaider_Ranger_02_c3fb3a30-a1a7-4d8a-8b3c-b101657a0a3d, S_DEN_GoblinRaiderPos_002_80e20d51-344b-4395-92d8-6cd693ac7a8a, S_DEN_GoblinRaiderAppearPos_008_194c17fd-d000-4499-a498-6ee33c9ace37);
		DB_DEN_RaidingParty_RaidingGoblins(S_DEN_GoblinRaider_Melee_01_6a03d0ff-a930-4347-bba2-9f3fd6bc317a, S_DEN_GoblinRaiderPos_003_6040ee51-ac44-4f57-9770-c099c2d3307a, S_DEN_GoblinRaiderAppearPos_003_a699070b-4675-4d20-8a93-30d372d76fe7); //
		DB_DEN_RaidingParty_RaidingGoblins(S_DEN_GoblinRaider_Melee_02_f1a7c5a6-27e7-4164-a31d-d18b4064df85, S_DEN_GoblinRaiderPos_004_a0274b7b-e30c-4b1c-b447-17e081e514c4, S_DEN_GoblinRaiderAppearPos_007_3ced2bc5-7e5a-4ad2-857b-fef2df42475e); //
		DB_DEN_RaidingParty_RaidingGoblins(S_DEN_GoblinRaider_Ranger_003_442fddf8-875a-4099-8725-12042f9e3ebd, S_DEN_GoblinRaiderPos_006_ccf45eac-23c7-4934-9a72-fb089d78b973, S_DEN_GoblinRaiderAppearPos_009_8d7c5687-9400-4be9-8211-141b1ab62ee0); //
		DB_DEN_RaidingParty_RaidingGoblins(S_DEN_GoblinRaider_Worg_01_51e9e140-04c2-4598-83c0-787dac74ce61, S_DEN_GoblinRaiderPos_007_e1f2d63a-1f6a-4f10-8271-2a3553736590, S_DEN_GoblinRaiderAppearPos_002_78887aa6-5e29-4be5-b425-2fef63aec97a);
		DB_DEN_RaidingParty_RaidingGoblins(S_DEN_GoblinRaider_Captain_22d80f21-7f31-4240-b981-9137d53ad77d, S_DEN_GoblinRaiderPos_008_6925a317-d4dc-46a5-a617-638a0e02837a, S_DEN_GoblinRaiderAppearPos_004_19f9e9f8-1698-427b-bc60-3dde19d3f84e); //
		DB_DEN_RaidingParty_RaidingGoblins(S_DEN_GoblinRaider_Bugbear_01_cde6e700-9c2a-4dec-9081-689881198639, S_DEN_GoblinRaiderPos_009_d9fbcc1c-dc46-43ab-9682-5c4a4336b8d0, S_DEN_GoblinRaiderAppearPos_010_0e3a934d-211c-4ccd-b8f4-3e7d680a9708); //
		
		DB_GLO_DefeatCounter((CHARACTER)S_DEN_GoblinRaider_Ranger_01_7fbfb1b0-184b-4889-935b-f916a7ad1177, "DEN_RaidingParty_Goblins");
		
		DB_DEN_RaidingParty_WyllGoblins((CHARACTER)S_DEN_GoblinRaider_Melee_003_0d9a9811-27b3-48ae-84a6-8a85c65a092e);
		DB_DEN_RaidingParty_WyllGoblins(S_DEN_GoblinRaider_Ranger_004_dfcc8342-4357-4b3f-9fb4-0d3eb2542830);
		
		PROC_DeclareCounter("DEN_RaidingParty_Goblins");
