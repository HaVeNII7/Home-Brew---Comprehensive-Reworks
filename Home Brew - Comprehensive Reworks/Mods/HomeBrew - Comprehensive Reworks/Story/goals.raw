		DB_Dialogs((CHARACTER)S_PLA_FlamingFist8_c7dbb25b-69c0-4fb7-b4ba-f398b3e0e30a, (DIALOGRESOURCE)PLA_FlamingFist8_8b84fbc5-db69-85a4-afd7-b2108150a832);
		
		IF
		EnteredTrigger(S_PLA_Tavern_DeadFF6_8c93ab9c-9717-4a89-a7df-afbb033436a7, S_PLA_FlamingFist8_CorpseBox_bdbbb67a-19ae-4fd6-86eb-eae30ce864d9)
		AND
		DB_GlobalFlag((FLAG)PLA_TavernInvestigation_State_BurntDown_ad34c392-4499-402c-ae51-8c3d40985f8b)
		AND
		DB_InRegion(S_PLA_FlamingFist8_c7dbb25b-69c0-4fb7-b4ba-f398b3e0e30a, S_PLA_FlamingFist8Home_25d8f28d-fbf5-4971-bde0-b25cbdebeed1)
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker((CHARACTER)S_PLA_FlamingFist8_c7dbb25b-69c0-4fb7-b4ba-f398b3e0e30a);
		DB_Dialogs((CHARACTER)S_PLA_FlamingFist8_c7dbb25b-69c0-4fb7-b4ba-f398b3e0e30a, (DIALOGRESOURCE)PLA_FlamingFist8_8b84fbc5-db69-85a4-afd7-b2108150a832);
		
		IF
		DB_GlobalFlag((FLAG)PLA_TavernInvestigation_State_BurntDown_ad34c392-4499-402c-ae51-8c3d40985f8b)
		AND
		NOT DB_InRegion(S_PLA_FlamingFist8_c7dbb25b-69c0-4fb7-b4ba-f398b3e0e30a, S_PLA_FlamingFist8Home_25d8f28d-fbf5-4971-bde0-b25cbdebeed1)
		AND
		NOT DB_PermaDefeated(S_PLA_FlamingFist8_c7dbb25b-69c0-4fb7-b4ba-f398b3e0e30a)
		AND
		NOT DB_Dialogs((CHARACTER)S_PLA_FlamingFist8_c7dbb25b-69c0-4fb7-b4ba-f398b3e0e30a, (DIALOGRESOURCE)PLA_FlamingFist8_AwayFromCorpse_767207ed-fd6f-910a-0665-739dc3e45724)
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker((CHARACTER)S_PLA_FlamingFist8_c7dbb25b-69c0-4fb7-b4ba-f398b3e0e30a);
		DB_Dialogs((CHARACTER)S_PLA_FlamingFist8_c7dbb25b-69c0-4fb7-b4ba-f398b3e0e30a, (DIALOGRESOURCE)PLA_FlamingFist8_AwayFromCorpse_767207ed-fd6f-910a-0665-739dc3e45724);
		
		IF
