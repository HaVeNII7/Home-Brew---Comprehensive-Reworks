		PROC_Poof(S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f);
		TriggerUnregisterForCharacter((TRIGGER)S_LOW_GriefAltarBounds_a957fc20-5cbf-482b-ae3b-85ac9ef644ed, (CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679);
		PROC_State_Progress(S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f, "LOW_MappingOfTheHeart", "LOW_HouseOfGrief_ViconiaLeft");
		
		PROC
		PROC_LOW_HouseOfGrief_AttackedIllusion()
		THEN
		PROC_LoopEffect((EFFECTRESOURCE)VFX_Script_MagicMouth_01_39272314-0666-1b46-ece8-565d69b391d5, S_LOW_ViconiaHelper_4fb9bf6c-f6b4-4c55-838f-1401fc9d98d3, "LOW_FemaleBust_MagicMouth", "CTY_Main_A", "", 1.0);
		PROC_TryStartAD((DIALOGRESOURCE)LOW_HouseOfGrief_AD_AttackedIllusion_f2e97f63-5e10-9d21-505f-dd024677971c, (ITEM)S_LOW_ViconiaHelper_4fb9bf6c-f6b4-4c55-838f-1401fc9d98d3);
		
		IF
		AutomatedDialogEnded((DIALOGRESOURCE)LOW_HouseOfGrief_AD_AttackedIllusion_f2e97f63-5e10-9d21-505f-dd024677971c, _)
		AND
		DB_LoopEffect(S_LOW_ViconiaHelper_4fb9bf6c-f6b4-4c55-838f-1401fc9d98d3, _, "LOW_FemaleBust_MagicMouth", _, _, _, _)
		THEN
		PROC_LOW_HouseOfGrief_OpenDoor();
		PROC_StopLoopEffect(S_LOW_ViconiaHelper_4fb9bf6c-f6b4-4c55-838f-1401fc9d98d3, "LOW_FemaleBust_MagicMouth");
		
		IF
		AutomatedDialogRequestFailed((DIALOGRESOURCE)LOW_HouseOfGrief_AD_AttackedIllusion_f2e97f63-5e10-9d21-505f-dd024677971c, _)
		AND
		DB_LoopEffect(S_LOW_ViconiaHelper_4fb9bf6c-f6b4-4c55-838f-1401fc9d98d3, _, "LOW_FemaleBust_MagicMouth", _, _, _, _)
		THEN
		PROC_LOW_HouseOfGrief_OpenDoor();
		PROC_StopLoopEffect(S_LOW_ViconiaHelper_4fb9bf6c-f6b4-4c55-838f-1401fc9d98d3, "LOW_FemaleBust_MagicMouth");
		
		IF
		DialogEnded((DIALOGRESOURCE)LOW_HouseOfGrief_ViconiaMapping_81568711-7b8f-d188-ee16-e9436c7b009f, _)
		THEN
		PROC_State_Progress(S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f, "LOW_MappingOfTheHeart", "LOW_HouseOfGrief_MappingDone");
		
		IF
		DialogEnded((DIALOGRESOURCE)LOW_HouseOfGrief_MeetingViconia_OM_Shadowheart_COM_7faa8762-49df-5912-49cd-79f8bb626e57, _)
		THEN
		PROC_State_Progress(S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f, "LOW_MappingOfTheHeart", "LOW_HouseOfGrief_MappingDone");
		
		IF
		DialogEnded((DIALOGRESOURCE)LOW_HouseOfGrief_MeetingViconia_OM_Shadowheart_AOM_OOM_acd28654-5731-e7ef-5d83-ce0c5f76cbc0, _)
		THEN
		PROC_State_Progress(S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f, "LOW_MappingOfTheHeart", "LOW_HouseOfGrief_MappingDone");
		
		IF
		WentOnStage(S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f, 0)
		AND
		DB_OnlyOnce("LOW_HouseOfGrief_MappingStarted")
		THEN
		PROC_State_Progress(S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f, "LOW_MappingOfTheHeart", "LOW_HouseOfGrief_ViconiaLeft");
		
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)LOW_HouseOfGrief_Event_ViconiaVanish_7fe5f6da-016e-458a-b181-5bd3bba75158)
		THEN
		ApplyStatus(S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f, "INVISIBILITY", 6.0, 1, S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f);
		SetOnStage(S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f, 0);
		
		//END_REGION
		
		//REGION Secret Door
		
		IF
		DialogStarted((DIALOGRESOURCE)LOW_HouseOfGrief_ViconiaMapping_81568711-7b8f-d188-ee16-e9436c7b009f, _)
		AND
		NOT DB_PartOfTheTeam((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)ORI_Shadowheart_State_PermaUnavailable_068b6f26-6b5e-4ad7-991b-fac10f96000d);
		
		IF
		DB_GlobalFlag((FLAG)LOW_HouseOfGrief_State_WaitingforShadowheartForDoor_f487f9f0-9f28-47c7-b818-a3c352657ed9)
		AND
		NOT DB_PartOfTheTeam((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)ORI_Shadowheart_State_PermaUnavailable_068b6f26-6b5e-4ad7-991b-fac10f96000d);
		PROC_GlobalClearFlagAndCache((FLAG)LOW_HouseOfGrief_State_WaitingforShadowheartForDoor_f487f9f0-9f28-47c7-b818-a3c352657ed9);
		
		IF
		UseFinished(_, (ITEM)S_LOW_GriefAltarButton_804ab809-13dc-45ac-84a7-4faff8f6f6a9, _)
		AND
		IsOpened((ITEM)S_LOW_SecretDoor_309650e9-6013-449e-a487-6d6d348d82bd, 0)
		THEN
		PROC_LOW_HouseOfGrief_OpenDoor();
		
		IF
		EnteredTrigger((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679, (TRIGGER)S_LOW_GriefAltarBounds_a957fc20-5cbf-482b-ae3b-85ac9ef644ed)
		AND
		DB_GlobalFlag((FLAG)LOW_HouseOfGrief_State_WaitingforShadowheartForDoor_f487f9f0-9f28-47c7-b818-a3c352657ed9)
		THEN
		PROC_GlobalClearFlagAndCache((FLAG)LOW_HouseOfGrief_State_WaitingforShadowheartForDoor_f487f9f0-9f28-47c7-b818-a3c352657ed9);
		TriggerUnregisterForCharacter((TRIGGER)S_LOW_GriefAltarBounds_a957fc20-5cbf-482b-ae3b-85ac9ef644ed, (CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679);
		PROC_LOW_HouseOfGrief_OpenDoor();
		
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)LOW_HouseOfGrief_Event_OpenSecretDoor_88a7aecb-095e-4a4e-aed4-8a0e6d04bd02)
		THEN
		TriggerUnregisterForCharacter((TRIGGER)S_LOW_GriefAltarBounds_a957fc20-5cbf-482b-ae3b-85ac9ef644ed, (CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679);
		PROC_GlobalClearFlagAndCache((FLAG)LOW_HouseOfGrief_Event_OpenSecretDoor_88a7aecb-095e-4a4e-aed4-8a0e6d04bd02);
		PROC_LOW_HouseOfGrief_OpenDoor();
		
		PROC
		PROC_LOW_HouseOfGrief_OpenDoor()
		AND
		IsOpened((ITEM)S_LOW_SecretDoor_309650e9-6013-449e-a487-6d6d348d82bd, 0)
		AND
		GetPosition((TRIGGER)S_LOW_AltarSinkPoint_51c4ebd4-22d1-44f2-ad1e-d89dc9d1c58c, _X, _Y, _Z)
		THEN
		PlatformMoveTo(LT_PLT_LOW_GriefAltar_000_1d9b200c-d66f-4437-a283-a7258504bc5e, _X, _Y, _Z, 1.5, "LOW_HouseOfGrief_MovePlatform", 0);
		Open((ITEM)S_LOW_SecretDoor_309650e9-6013-449e-a487-6d6d348d82bd);
		
		IF
		Opened((ITEM)S_LOW_SecretDoor_309650e9-6013-449e-a487-6d6d348d82bd)
		THEN
		SetCanInteract((ITEM)S_DOOR_Invisible_A_ToGrotto_fb614206-fede-4849-969c-a2f71ab33c6a, 1);
		
		//END_REGION
		
		//REGION Hostile Players
		
		IF
		RelationChanged((FACTION)ACT3_LOW_SharCultist_House_a97a8fce-e4ba-43ac-b3e3-60ff9d273d72, _PlayerFaction, 0, _)
		AND
		DB_Players(_AnyPlayer)
		AND
		GetFaction(_AnyPlayer, _PlayerFaction)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_Grotto_State_ViconiaDefeated_8e27eb4e-8d52-4966-8aa4-e658ff595097)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)LOW_HouseOfGrief_State_PlayerHostile_dc16eca3-584a-4847-9664-c51222410abc);
		PROC_SetRelationToPlayers((FACTION)ACT3_LOW_SharCultist_Unaligned_8309bb65-7dcd-4a4b-b9de-bd0d5cda4731, 0);
		PROC_SetRelationToPlayers((FACTION)ACT3_LOW_SharCultist_Grotto_415731a9-1e23-4873-afe9-a4619a973bfa, 0);
		
		IF
		EnteredTrigger(_Player, (TRIGGER)S_LOW_ButtonSpot_81a0a68e-9e27-4304-8948-0df42c833c7e)
		AND
		DB_GlobalFlag((FLAG)LOW_HouseOfGrief_State_PlayerHostile_dc16eca3-584a-4847-9664-c51222410abc)
		AND
		IsOpened((ITEM)S_LOW_SecretDoor_309650e9-6013-449e-a487-6d6d348d82bd, 0)
		AND
		QRY_OnlyOnce("LOW_HouseOfGrief_EmergencyButton")
		THEN
		SetEntityEvent((ITEM)S_LOW_GriefAltarButton_804ab809-13dc-45ac-84a7-4faff8f6f6a9, "RevealFromStory");
		PROC_TriggerUnregisterForPlayers((TRIGGER)S_LOW_ButtonSpot_81a0a68e-9e27-4304-8948-0df42c833c7e);
		
		//END_REGION
		
		//REGION Misc
		
		PROC
		PROC_SpotPlayers_Spotted((CHARACTER)S_LOW_GriefGuard_000_e2a86aa9-3d65-4517-a946-f1ad851b6ef1, "LOW_HouseOfGrief_GuardGreet", _Player)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)LOW_HouseOfGrief_AD_GuardGreeting_7609df83-bb91-5805-f983-8ae0857c5921, (CHARACTER)S_LOW_GriefGuard_000_e2a86aa9-3d65-4517-a946-f1ad851b6ef1);
		
		PROC
		PROC_SpotPlayers_Spotted((CHARACTER)S_LOW_GriefAttendant_2d74b412-6ed8-438a-b229-6cee7a48acca, "LOW_HouseOfGrief_AttendantGreet", _Player)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)LOW_HouseOfGrief_AD_AttendantGreeting_a9d00b7c-11b3-e287-dc71-fed7d387ca34, (CHARACTER)S_LOW_GriefAttendant_2d74b412-6ed8-438a-b229-6cee7a48acca);
		
		IF
		DB_GlobalFlag((FLAG)ORI_Shadowheart_State_BecamePontiff_4c521953-3277-4a59-9e3d-8e161916ed8b)
		THEN
		ClearOwnership((ITEM)S_LOW_CollectionsBox_d2b08796-481b-4fc4-8554-ccd60fc7e8df);
		
		//END_REGION
		
		//REGION JOURNAL - Investigate the Sharrans
		
		IF
		FlagSet((FLAG)LOW_HouseOfGrief_Knows_UnburdeningOffered_7011aecb-2d62-40d2-860a-81355b87b86b, _, _)
		AND
		NOT DB_QuestIsOpened("LOW_InvestigateSharrans")
		THEN
		QuestUpdate("LOW_InvestigateSharrans", "MetGriefAttendant");
		
		IF
		FlagSet((FLAG)LOW_HouseOfGrief_Knows_UnburdeningOffered_7011aecb-2d62-40d2-860a-81355b87b86b, _, _)
		AND
		DB_QuestIsOpened("LOW_InvestigateSharrans")
		AND
		DB_GlobalFlag((FLAG)LOW_HouseOfGrief_State_LearnedAboutHouse_0dd5322c-700d-4369-81df-f75986d53d24)
		THEN
		QuestUpdate("LOW_InvestigateSharrans", "UnburdeningMentioned");
		
		IF
		EnteredTrigger(_, (TRIGGER)S_LOW_GriefBackroom_5e52bac2-3cb6-488b-be9a-59599692acda)
		AND
		DB_QuestIsOpened("LOW_InvestigateSharrans")
		AND
		NOT DB_GlobalFlag((FLAG)LOW_HouseOfGrief_Event_AttendantShowToRoom_bcadad71-c096-4e8d-8d96-0c80139bd4fc)
		THEN
		PROC_TriggerUnregisterForParty((TRIGGER)S_LOW_GriefBackroom_5e52bac2-3cb6-488b-be9a-59599692acda);
		QuestUpdate("LOW_InvestigateSharrans", "AltBackroomEntry");
		
		IF
		Opened((ITEM)S_LOW_SecretDoor_309650e9-6013-449e-a487-6d6d348d82bd)
		AND
		NOT DB_QuestIsOpened("LOW_InvestigateSharrans")
		THEN
		QuestUpdate("LOW_InvestigateSharrans", "AltViolenceEntry");
		
		IF
		FlagSet((FLAG)LOW_Grotto_State_ViconiaDefeated_8e27eb4e-8d52-4966-8aa4-e658ff595097, _, _)
		AND
		QuestUpdateIsUnlocked(NULL_00000000-0000-0000-0000-000000000000, "LOW_InvestigateSharrans", "AltViolenceEntry", 1)
		THEN
		QuestUpdate("LOW_InvestigateSharrans", "SharCultDestroyed_Violent");
		
		IF
		FlagSet((FLAG)LOW_Grotto_State_ViconiaDefeated_8e27eb4e-8d52-4966-8aa4-e658ff595097, _, _)
		AND
		QuestUpdateIsUnlocked(NULL_00000000-0000-0000-0000-000000000000, "LOW_InvestigateSharrans", "AltViolenceEntry", 0)
		THEN
		QuestUpdate("LOW_InvestigateSharrans", "SharCultDestroyed");
		
		IF
		EnteredCombat(S_LOW_Viconia_b1ea974d-96fb-47ca-b6d9-9c85fcb69313, _)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_SharGrotto_ConfrontViconia_SharranAlliance_ea829b7c-5f69-c4fc-6b4c-b8a190d31a86)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_SharGrotto_State_PromisedBringShadowheart_ba85fccc-c09b-41c3-82ec-69693db59204)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_SharGrotto_State_FailedDeal_ec315b8d-dda0-4aac-ba23-3d311282b7c9)
		THEN
		QuestUpdate("LOW_InvestigateSharrans", "ViconiaAttacked");
		
		IF
		EnteredCombat(S_LOW_Viconia_b1ea974d-96fb-47ca-b6d9-9c85fcb69313, _)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_SharGrotto_ConfrontViconia_SharranAlliance_ea829b7c-5f69-c4fc-6b4c-b8a190d31a86)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_SharGrotto_State_PromisedBringShadowheart_ba85fccc-c09b-41c3-82ec-69693db59204)
		AND
		DB_GlobalFlag((FLAG)LOW_SharGrotto_State_FailedDeal_ec315b8d-dda0-4aac-ba23-3d311282b7c9)
		THEN
		QuestUpdate("LOW_InvestigateSharrans", "ViconiaDealFailed");
		
		
		//END_REGION
	}
	EXIT
	{
	}
}
