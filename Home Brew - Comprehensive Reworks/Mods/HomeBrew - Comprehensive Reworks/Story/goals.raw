		NOT DB_Hirelings_CampPositions("",0,(TRIGGER)NULL_00000000-0000-0000-0000-000000000000);
		DB_Hirelings_CampPositions("WLDMAIN",1,S_CAMP_Hireling_000_e31135c0-a0df-4f75-8c88-4895f76bb5bb);
