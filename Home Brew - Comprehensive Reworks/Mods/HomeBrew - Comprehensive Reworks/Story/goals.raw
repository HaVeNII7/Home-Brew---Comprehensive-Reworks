		ObjectTimerCancel(S_END_CrownProxy_b06e8326-a034-4480-8652-6a66b3bd7d0a,"END_BrainBattle_EnnervationRay_SpellCastTimer");
		
		
		//Ennervation Ray
		//Reset camera to the crown and play VFX
		IF
