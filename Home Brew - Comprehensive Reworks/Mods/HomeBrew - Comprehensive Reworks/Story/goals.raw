		PROC_TriggerUnregisterForPlayers(S_WYR_SharessCaress_Mamzell_CancelWelcomeSpotArea_59ac404b-2d8f-4d3c-b93a-f515d8a9b3a4);
		
		// Bartender
		IF
		FlagSet((FLAG)WYR_SharessCaress_Bartender_Event_UnlockPotentTrade_1a8cdb70-5ffe-4400-a8eb-be9971b65e30,_,_)
		AND
		QRY_OnlyOnce("WYR_SharessCaress_Bartender_PotentDrinkTrade_OnlyOnce")
		THEN
		PROC_SetCustomTradeTreasure((CHARACTER)S_WYR_SharessCaress_Bartender_ab24945c-268d-4f90-b8ea-bbb11cd50157, "WYR_SharessCaress_Bartender_Trade_Potent");
		
		IF
		RemovedFrom(S_WYR_SharessCaress_PotentDrink_01_585e1f38-4383-4071-86e2-e0f0208f89b5, S_WYR_SharessCaress_Bartender_ab24945c-268d-4f90-b8ea-bbb11cd50157)
		THEN
		SetStoryItem(S_WYR_SharessCaress_PotentDrink_01_585e1f38-4383-4071-86e2-e0f0208f89b5, 0);
		
		// Basement rat
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)WYR_SharessCaress_Event_RatLeaves_776f59b9-fa4a-eec2-9ed5-339830950b93)
		THEN
		PROC_DisappearOutOfSight((CHARACTER)S_WYR_SharessCaress_BasementRat_33aaee0d-037b-4e21-9f26-2d1751bc78d8, "Run", 0, "");
		//END_REGION
		
		//REGION Drunk Flaming Fist and Nymph
		IF
		DialogEnded(WYR_SharessCaress_Taproom_Threeway_NymphDrunkFist_1f5cc409-0306-6115-089a-a70810944a1e,_)
		THEN
		PROC_SceneOver("WYR_Taproom_DrunkFistThreeway");
		
		PROC
		PROC_SceneOver("WYR_Taproom_DrunkFistThreeway")
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_WYR_SharessCaress_Nymph_01_662b787e-d5f1-4bd2-b398-36961bda0ab4);
		PROC_RemoveAllDialogEntriesForSpeaker(S_WYR_SharessCaress_FlamingFist_01_350212e9-a8d6-43aa-8595-61e0d69b46f1);
		DB_Dialogs(S_WYR_SharessCaress_Nymph_01_662b787e-d5f1-4bd2-b398-36961bda0ab4, WYR_SharessCaress_Taproom_NymphWaitress_45c3c4ec-e416-b7fa-7603-615149d2cd87);
		DB_Dialogs(S_WYR_SharessCaress_FlamingFist_01_350212e9-a8d6-43aa-8595-61e0d69b46f1, WYR_SharessCaress_Taproom_DrunkFist_cc1c37a0-03f1-01eb-7708-0a5db9c6f0a3);
		
		// we can't SceneOver on scene interruption because it will block a crime that interrupted it.
		IF
		DB_CantTalk(_Character)
		AND
		DB_SceneManager((CHARACTER)_Character, "WYR_Taproom_DrunkFistThreeway") 
		THEN
		PROC_SceneOver("WYR_Taproom_DrunkFistThreeway");
		
		QRY
		QRY_CrimeBribes_GetEludedMethodAvailability_Custom("Bribe",(INTEGER)_CrimeID,(CHARACTER)S_WYR_SharessCaress_FlamingFist_01_350212e9-a8d6-43aa-8595-61e0d69b46f1,(CHARACTER)_Criminal,(STRING)_Race,(DIALOGRESOURCE)_Dialog)
		AND
		CrimeGetVictim(_CrimeID, S_WYR_SharessCaress_Nymph_01_662b787e-d5f1-4bd2-b398-36961bda0ab4)
		THEN
		DB_QRYRTN_CrimeBribes_GetEludedMethodAvailability_Custom("no");
		
		// leaving
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)WYR_FlamingFistNymph_State_FFLeft_798c8029-9b0e-4f1e-d4f9-0282b5366bd1)
		THEN
		PROC_NotifyWhenReadyToMoveOn(S_WYR_SharessCaress_FlamingFist_01_350212e9-a8d6-43aa-8595-61e0d69b46f1, "WYR_Taproom_DrunkFistDisappear_Notify");
		
		IF
		DB_Defeated(S_WYR_SharessCaress_Nymph_01_662b787e-d5f1-4bd2-b398-36961bda0ab4)
		AND
		NOT DB_PermaDefeated(S_WYR_SharessCaress_FlamingFist_01_350212e9-a8d6-43aa-8595-61e0d69b46f1)
		AND
		NOT DB_NotifyWhenReadyToMoveOn(S_WYR_SharessCaress_FlamingFist_01_350212e9-a8d6-43aa-8595-61e0d69b46f1, _)
		AND
		QRY_OnlyOnce("WYR_Taproom_DrunkFistDisappear_NotifyOnlyOnce")
		THEN
		RealtimeObjectTimerLaunch(S_WYR_SharessCaress_FlamingFist_01_350212e9-a8d6-43aa-8595-61e0d69b46f1, "WYR_Taproom_DrunkFistDisappear_Wait", 2000);
		
		IF
		ObjectTimerFinished(S_WYR_SharessCaress_FlamingFist_01_350212e9-a8d6-43aa-8595-61e0d69b46f1, "WYR_Taproom_DrunkFistDisappear_Wait")
		AND
		NOT DB_PermaDefeated(S_WYR_SharessCaress_FlamingFist_01_350212e9-a8d6-43aa-8595-61e0d69b46f1)
		AND
		NOT DB_NotifyWhenReadyToMoveOn(S_WYR_SharessCaress_FlamingFist_01_350212e9-a8d6-43aa-8595-61e0d69b46f1, _)
		THEN
		PROC_GlobalSetFlagAndCache(WYR_SharessCaress_State_NymphFlamingFistLeft_798c8029-9b0e-4f1e-d4f9-0282b5366bd1);
		PROC_NotifyWhenReadyToMoveOn(S_WYR_SharessCaress_FlamingFist_01_350212e9-a8d6-43aa-8595-61e0d69b46f1, "WYR_Taproom_DrunkFistDisappear_Notify");
		
		PROC
		PROC_ReadyToMoveOn(S_WYR_SharessCaress_FlamingFist_01_350212e9-a8d6-43aa-8595-61e0d69b46f1, "WYR_Taproom_DrunkFistDisappear_Notify")
		THEN
		PROC_DisappearOutOfSightTo(S_WYR_SharessCaress_FlamingFist_01_350212e9-a8d6-43aa-8595-61e0d69b46f1, S_WYR_SharessCaress_DrunkFistLeaveSpot_d9c57198-70a1-4009-a8a1-571148901ee0, "Stroll", 0, "");
		//END_REGION
		
		//REGION Hollyphant Detective
		IF
		EntityEvent(S_GLO_HollyphantDetective_acf70307-3bb9-4b91-b894-fa2120916f58, "WYR_OpenHand_HollyphantArrivedAtTavern")
		THEN
		DB_Dialogs(S_GLO_HollyphantDetective_acf70307-3bb9-4b91-b894-fa2120916f58, (DIALOGRESOURCE)WYR_SharessCaress_HollyphantDetective_710444e8-5786-08e5-a1b3-2d2c2a1b88b5);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)WYR_SerialKiller_State_ValeriaSendToDevella_65f1a97d-1656-da36-6417-be1e44a87663)
		THEN
		PROC_DisappearOutOfSightTo((CHARACTER)S_GLO_HollyphantDetective_acf70307-3bb9-4b91-b894-fa2120916f58, S_WYR_SharessCaress_ValeriaExitPoint_fb92fefc-c309-4499-9d7a-27943a851386, "Walk", 0, "WYR_SharessCaress_ValeriaLeft");
		
		IF
		LevelLoaded("BGO_Main_A")
		AND
		DB_LOW_MurderTribunal_DoValeriaSharessCaressSetup(1)
		THEN
		NOT DB_LOW_MurderTribunal_DoValeriaSharessCaressSetup(1);
		SetOnStage(S_WYR_SerialKiller_ValeriaUnpaidTab_72d4d297-7041-4e84-a246-b2d4d4cd7a96,1);
		SetOnStage(S_WYR_SerialKIller_ValeriaSleepWine_2eb87325-78c0-4676-acf3-8b1e9e10a431,1);
		
		//END_REGION
		
		//REGION Debug
		// debug
		IF
		TextEvent("WYR_SharessCaress_TestTrade")
		THEN
		PROC_SetCustomTradeTreasure((CHARACTER)S_WYR_SharessCaress_Bartender_ab24945c-268d-4f90-b8ea-bbb11cd50157, "WYR_SharessCaress_Bartender_Trade_Potent");
		//END_REGION
	}
	EXIT
	{
	}
}
