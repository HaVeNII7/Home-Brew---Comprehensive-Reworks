		DB_QuestDef_State((FLAG)LOW_BhaalTemple_State_WasAbductedLaezel_2f0ad86d-e4c7-47f9-bb8b-bb7b8f3ebc40, 									"LOW_FindBhaalTemple", "WasAbducted_Laezel");
