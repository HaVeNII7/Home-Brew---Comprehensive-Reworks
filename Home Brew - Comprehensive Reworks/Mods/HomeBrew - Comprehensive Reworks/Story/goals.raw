		PROC_CAMP_Laezel_Romance2_DuelFinished();
		
		IF
		HitpointsChanged(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _Percentage)
		AND
		DB_CAMP_Laezel_Romance2_DuelOngoing(1)
		AND
		_Percentage <= 20.0
		AND
