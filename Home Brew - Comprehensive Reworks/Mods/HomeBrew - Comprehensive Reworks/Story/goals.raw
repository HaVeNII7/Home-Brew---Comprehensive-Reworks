		DB_QuestDef_BookReadState("ORI_COM_Wyll","WyrmwaySubStarted",(ITEM)S_GLO_AnsurGhost_LegendOfAnsurBook_b0ecc3d5-85ad-48fa-bc47-988107507e6c);
		
