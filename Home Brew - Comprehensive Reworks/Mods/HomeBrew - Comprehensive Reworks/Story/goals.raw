		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)SCL_Drider_HarpersAndPlayersAmbush_a65813ee-9656-3e30-b34e-b1d0b3e9bc6b, (INTEGER)_DialogID)
		AND
