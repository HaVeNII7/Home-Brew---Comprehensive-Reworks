		//REGION Paladins of Tyr
		// Edge case for avatar not seeing Anders when COM tries to start (upper floor, behind walls).
		QRY
		QRY_OriginMoment_OutsideCOMTrigger((CHARACTER)_Avatar, (DIALOGRESOURCE)PLA_PaladinsOfTyr_OM_Karlach_COM_96ec1de3-d465-d2e0-6c62-aa184174d5f4)
		AND
		_Avatar != S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c
		AND
		NOT HasLineOfSight(_Avatar, S_PLA_Refugee_001_a43d1d6c-d397-4d2d-adb4-ead3b10cb189, 1)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_OriginMoment_PreventRelaunchDialog(PLA_PaladinsOfTyr_OM_Karlach_AOM_OOM_5dbad566-142e-9459-2238-629ccd8cd339, S_PLA_Refugee_001_a43d1d6c-d397-4d2d-adb4-ead3b10cb189, _Player)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_OriginMoment_PreventRelaunchDialog(PLA_PaladinsOfTyr_OM_Karlach_COM_96ec1de3-d465-d2e0-6c62-aa184174d5f4, S_PLA_Refugee_001_a43d1d6c-d397-4d2d-adb4-ead3b10cb189, _Player)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog(PLA_PaladinsOfTyr_Event_KarlachLeavesHostile_f178f9f1-cf9e-2956-20aa-2a5857f1c285)
		THEN
		PROC_Origins_CompanionLeavePermanently((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "CompanionHostile");
		SetFaction(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (FACTION)Origin_Karlach_Hostile_941ee2f1-775a-4418-80db-79f354a1c173);
		
		IF
		DB_Players((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		DB_Is_InCombat(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _CombatID)
		AND
		DB_Is_InCombat(_Refugee, _CombatID)
		AND
		DB_PLA_KarlachRecruitmentTollhouse_Refugee(_Refugee)
		AND
		NOT DB_GlobalFlag(PLA_PaladinsOfTyr_State_KarlachFoughtPaladins_fc42d7cb-b525-4a93-80eb-7898dbc3ee40)
		THEN
		SetFlag(PLA_PaladinsOfTyr_State_KarlachFoughtPaladins_fc42d7cb-b525-4a93-80eb-7898dbc3ee40, NULL_00000000-0000-0000-0000-000000000000);
		
		PROC
		PROC_CheckFirstTimeRecruited((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		DB_GlobalFlag((FLAG)PLA_KarlachRecruitmentTollhouse_State_PaladinsPermaDefeated_d78dbc95-8d8e-4b3a-b618-ccfb48c31375)
		THEN
		PROC_TriggerUnregisterForPlayers((TRIGGER)S_PLA_PaladinsOfTyr_TollHouseArea_c76e3401-5608-4e33-82a8-a541f40b038c);
		
		IF
		FlagSet(PLA_KarlachRecruitmentTollhouse_State_PaladinsPermaDefeated_d78dbc95-8d8e-4b3a-b618-ccfb48c31375, _, _)
		AND
		NOT DB_CantTalk(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		NOT DB_OnlyOnce("PLA_PaladinsOfTyr_BurningTheTollhouseStart")
		THEN
		PROC_PLA_PaladinsOfTyr_TryKarlachsRage();
		
		PROC
		PROC_StateCleared_CantTalk(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		DB_GlobalFlag(PLA_KarlachRecruitmentTollhouse_State_PaladinsPermaDefeated_d78dbc95-8d8e-4b3a-b618-ccfb48c31375)
		AND
		NOT DB_OnlyOnce("PLA_PaladinsOfTyr_BurningTheTollhouseStart")
		THEN
		PROC_PLA_PaladinsOfTyr_TryKarlachsRage();
		
		PROC
		PROC_PLA_PaladinsOfTyr_TryKarlachsRage()
		AND
		DB_InRegion(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, S_PLA_PaladinsOfTyr_TollHouseArea_c76e3401-5608-4e33-82a8-a541f40b038c)
		AND
		DB_Players((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		DB_OnlyOnce("PLA_PaladinsOfTyr_BurningTheTollhouseStart");
		PROC_PLA_PaladinsOfTyr_KarlachsRage();
		
		PROC
		PROC_PLA_PaladinsOfTyr_KarlachsRage()
		THEN
		PROC_TriggerUnregisterForPlayers(S_PLA_PaladinsOfTyr_TollHouseArea_c76e3401-5608-4e33-82a8-a541f40b038c);
		TriggerRegisterForItems(S_PLA_PaladinsOfTyr_TollHouse_c16587fd-4a00-40e5-a106-2170068e98ed);
		TeleportTo(S_PLA_PaladinsOfTyr_TollHouse_c16587fd-4a00-40e5-a106-2170068e98ed, S_PLA_PaladinsOfTyr_TollHousePos_bbfe2ea7-6ae5-48f2-ac0d-024be312feff);
		PROC_PLA_PaladinsOfTyr_StartKarlachsRageDialog();
		
		PROC
		PROC_PLA_PaladinsOfTyr_StartKarlachsRageDialog()
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		TimerLaunch("ORI_Karlach_EnrageWRD", 500); // If Karlach was down and is revived let some time pss for the defeated DBs to update for the WRD to be valid.
		
		IF
		TimerFinished("ORI_Karlach_EnrageWRD")
		AND
		IsInTrigger(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, S_PLA_PaladinsOfTyr_TollHouseArea_c76e3401-5608-4e33-82a8-a541f40b038c, 1)
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, DEN_PaladinsOfTyr_WRD_Karlach_ac852532-8218-d8fa-7389-b14c20b824a1, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		
		IF
		DialogEnded(DEN_PaladinsOfTyr_WRD_Karlach_ac852532-8218-d8fa-7389-b14c20b824a1, _DialogID)
		AND
		NOT DB_DialogRequestFailed(DEN_PaladinsOfTyr_WRD_Karlach_ac852532-8218-d8fa-7389-b14c20b824a1, _DialogID)
		THEN
		ApplyStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_ENRAGE", 60.0, 1, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		
		PROC
		PROC_PLA_PaladinsOfTyr_StartKarlachsRageDialog()
		AND
		DB_Avatars((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		TimerLaunch("ORI_AvatarKarlach_Enrage", 500); // If Karlach was down and is revived let some time pass for the defeated DBs to update for the dialog to be valid.
		
		IF
		TimerFinished("ORI_AvatarKarlach_Enrage")
		AND
		IsInTrigger(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, S_PLA_PaladinsOfTyr_TollHouseArea_c76e3401-5608-4e33-82a8-a541f40b038c, 1)
		AND
		NOT QRY_StartDialog_Fixed(PLA_PaladinsOfTyr_AvatarKarlachBeforeEnrage_f28a15b2-e04c-4da4-6eaa-0df4b5b240e9, (CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		ApplyStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_ENRAGE", 60.0, 1, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		
		IF
		DialogEnded(PLA_PaladinsOfTyr_AvatarKarlachBeforeEnrage_f28a15b2-e04c-4da4-6eaa-0df4b5b240e9, _DialogID) // Also pass for DialogRequestFailed()
		THEN
		ApplyStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_ENRAGE", 60.0, 1, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		
		IF
		StatusApplied(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_ENRAGE", _, _)
		THEN
		SetHasDialog(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 0);
		SetFlag(PLA_PaladinsOfTyr_State_KarlachWentBerserk_c1d0d47c-6947-4e9c-b205-eeef18f2aa80, NULL_00000000-0000-0000-0000-000000000000);
		PROC_TopicalGreeting_UnlockTopic((FLAG)TG_ORI_Karlach_Enrage_821acc4a-5090-48ca-baf2-eb7f19b4c380);
		
		IF
		StatusRemoved(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_ENRAGE", _, _)
		THEN
		TriggerUnregisterForItems(S_PLA_PaladinsOfTyr_TollHouse_c16587fd-4a00-40e5-a106-2170068e98ed);
		SetHasDialog(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 1);
		SetFlag(ORI_Karlach_Event_SetLowLevelBurningState_e693ee79-85af-4940-8ab4-8a9a10a8635f, NULL_00000000-0000-0000-0000-000000000000);
		PROC_RelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_Enrage_68790c64-811d-4e4e-9ff8-02c3b69dd6e6, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 0);
		
		IF
		StatusRemoved(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_ENRAGE", _, _)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		ObjectTimerLaunch(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_PaladinsOfTyr_AfterEnragePAD", 3000); // Give her some time and start PAD
		
		IF
		ObjectTimerFinished(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_PaladinsOfTyr_AfterEnragePAD")
		THEN
		PROC_TryStartAD(PLA_PaladinsOfTyr_PAD_KarlachAfterEnraged_8bd127ae-a4ce-e8b3-6c25-bd91e773079f, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		
		IF
		StatusRemoved(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_ENRAGE", _, _)
		AND
		DB_Avatars((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		QRY_StartDialog_Fixed(PLA_PaladinsOfTyr_AvatarKarlachAfterEnrage_b44b7e9a-aaf6-9200-16fd-4a3fd6c2c5a0, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		DB_NOOP(1);
		
		//END_REGION Paladins of Tyr
		
		//REGION Forging of the Heart Act 1
		QRY
		QRY_OriginMoment_PreventRelaunchDialog(DEN_ForgingOfTheHeart_OM_Karlach_AOM_OOM_COM_61ffefa2-22fd-2f44-cfd1-29abbba4a2fd, S_DEN_Weaponsmith_e2ad06ec-8034-479a-9f69-b86faea6dc79, _Player)
		THEN
		DB_NOOP(1);
		
		// HowTo define a conditional repeatable OM.
		QRY
		QRY_GLO_Karlach_BlockForgingOfTheHeartFollowUp()
		AND
		GetFlag(GLO_ForgingOfTheHeart_State_DammonInAct1_6fc4fcde-01a8-474e-b0d1-a37960b76037, S_DEN_Weaponsmith_e2ad06ec-8034-479a-9f69-b86faea6dc79, 1)
		AND
		QRY_DEN_ForgingOfTheHeart_InAttackOnDenState()
		THEN
		DB_NOOP(1);
		
		// Goblin attack
		QRY
		QRY_DEN_ForgingOfTheHeart_InAttackOnDenState()
		AND
		QRY_DEN_ForgingOfTheHeart_InAttackOnDenState_GoblinAttack()
		/*AND
		NOT QRY_OnlyOnce("DEN_ForgingOfTheHeart_TriggeredOM")*/
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_DEN_ForgingOfTheHeart_InAttackOnDenState_GoblinAttack()
		AND
		DB_State_Current(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_AttackOnDen")
		AND
		DB_GlobalFlag((FLAG)GLO_ForgingOfTheHeart_State_SpokeToDammonDuringGoblinAttack_345d3264-2404-5ad9-6d8d-73e88819098c)
		THEN
		DB_NOOP(1);
		
		// Druid attack
		QRY
		QRY_DEN_ForgingOfTheHeart_InAttackOnDenState()
		AND
		QRY_DEN_ForgingOfTheHeart_InAttackOnDenState_DruidAttack()
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_DEN_ForgingOfTheHeart_InAttackOnDenState_DruidAttack()
		AND
		DB_State_Current(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_DruidAttack")
		THEN
		DB_NOOP(1);
		
		//Druid attack: redefine OM if Karlach doesn't know she can be upgraded
		IF
		FlagSet(DEN_DruidAttack_State_PrepAfterDeathOfDruids_b4754af7-07ec-433c-87d2-e78ef4c79e6e, _, _)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_ForgingOfTheHeart_Knows_DammonCanUpgradeKarlach_226d82fb-711b-64ac-e59a-b4361ce2204e)
		THEN
		PROC_DefineSingleOriginMoment((DIALOGRESOURCE)DEN_DruidAttack_Weaponsmith_PostEA_23532629-93cf-a224-d39d-f29825c49025, (TAG)KARLACH_9aab4bcd-e1f7-4008-8f7b-f1203789ae9b, (DIALOGRESOURCE)DEN_ForgingOfTheHeart_OM_Karlach_AOM_OOM_COM_61ffefa2-22fd-2f44-cfd1-29abbba4a2fd);
		
		//Goblin attack: redefine OM if Karlach doesn't know she can be upgraded
		IF
		FlagSet(DEN_AttackOnDen_State_UnderAttack_4ebba932-b9cf-41c5-b897-e77a63b93511, _, _)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_ForgingOfTheHeart_Knows_DammonCanUpgradeKarlach_226d82fb-711b-64ac-e59a-b4361ce2204e)
		THEN
		PROC_DefineSingleOriginMoment((DIALOGRESOURCE)DEN_AttackOnDen_Weaponsmith_f74a35e9-5895-dd0f-5c83-52009f6b0379, (TAG)KARLACH_9aab4bcd-e1f7-4008-8f7b-f1203789ae9b, (DIALOGRESOURCE)DEN_ForgingOfTheHeart_OM_Karlach_AOM_OOM_COM_61ffefa2-22fd-2f44-cfd1-29abbba4a2fd);
		
		IF
		FlagSet(DEN_AttackOnDen_State_DenVictory_71c7f23e-3ff1-c9b8-3ef5-d75fa1b42c8d, _, _)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_ForgingOfTheHeart_Knows_DammonCanUpgradeKarlach_226d82fb-711b-64ac-e59a-b4361ce2204e)
		THEN
		PROC_DefineSingleOriginMoment((DIALOGRESOURCE)DEN_AttackOnDen_Weaponsmith_f74a35e9-5895-dd0f-5c83-52009f6b0379, (TAG)KARLACH_9aab4bcd-e1f7-4008-8f7b-f1203789ae9b, (DIALOGRESOURCE)DEN_ForgingOfTheHeart_OM_Karlach_AOM_OOM_COM_61ffefa2-22fd-2f44-cfd1-29abbba4a2fd);
		
		IF
		DialogEnded(DEN_ForgingOfTheHeart_OM_Karlach_AOM_OOM_COM_61ffefa2-22fd-2f44-cfd1-29abbba4a2fd, _DialogID)
		AND
		NOT DB_DialogRequestFailed(_, _DialogID)
		AND
		QRY_DEN_ForgingOfTheHeart_InAttackOnDenState_GoblinAttack()
		THEN
		DB_OnlyOnce("DEN_ForgingOfTheHeart_TriggeredOM");
		
		//END_REGION Forging of the Heart Act 1
		
		//REGION GOB events
		IF
		DialogEnded((DIALOGRESOURCE)GOB_GoblinPriest_Chapel_a5ab8ece-6d80-b110-4d8f-886420d0914d, _DialogID)
		AND
		NOT DB_DialogRequestFailed((DIALOGRESOURCE)GOB_GoblinPriest_Chapel_a5ab8ece-6d80-b110-4d8f-886420d0914d, _DialogID)
		AND
		GetFlag((FLAG)ORI_Karlach_Event_SetUpGoblinPriestBranch_9cdf180d-12f7-bc09-5409-14346ae7e103, NULL_00000000-0000-0000-0000-000000000000, 1)
		AND
		DB_DialogPlayers(_DialogID, _Player, 1)
		AND
		DB_Avatars((CHARACTER)_Player)
		AND
		_Player != S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c
		AND
		GetReservedUserID(_Player, _PID)
		AND
		GetReservedUserID((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _PID)
		THEN
		DB_ORI_Karlach_CheckWithPlayerOnSight(_Player);
		
		IF
		DialogEnded((DIALOGRESOURCE)GOB_GoblinPriest_Chapel_a5ab8ece-6d80-b110-4d8f-886420d0914d, _DialogID)
		THEN
		ClearFlag((FLAG)ORI_Karlach_Event_SetUpGoblinPriestBranch_9cdf180d-12f7-bc09-5409-14346ae7e103, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		DB_Sees((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _Avatar)
		AND
		DB_ORI_Karlach_CheckWithPlayerOnSight(_Avatar)
		AND
		DB_GlobalFlag((FLAG)GOB_GoblinPriest_State_Defeated_78f21b35-a10a-4db2-9230-025691645103)
		THEN
		NOT DB_ORI_Karlach_CheckWithPlayerOnSight(_Avatar);
		PROC_ORI_Karlach_TryUnlockGoblinPriestBranch(_Avatar);
		
		PROC
		PROC_ORI_Karlach_TryUnlockGoblinPriestBranch((CHARACTER)_Avatar)
		AND
		NOT DB_Is_InCombat(_Avatar, _)
		AND
		NOT DB_Is_InCombat(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _)
		AND
		DB_Players((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_GoblinPriestOutcome_51f7bb02-9432-4f8c-bb97-db7eed8a2515, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 0);
		
		// Sending goblins to raid.
		IF
		FlagSet((FLAG)GOB_DrowCommander_Event_RaidersSortie_26816b01-2d64-b50c-3bf6-bffd7dc5f0b9, _, _DialogID)
		AND
		NOT DB_DialogPlayers(_DialogID, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 1) // Make sure she isn't the one making the decision.
		AND
		DB_Players((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_SendingGoblinsToDEN_0f7b4437-24c5-4b61-9054-07d73d744099, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 0);
		
		// Reacting to Oktas' gruel
		PROC
		PROC_FlagReactionAfterDialog(_, (FLAG)DEN_Thieflings_Event_TookGruel_e9166e18-05a7-16da-0b43-dd1ff8674e0a)
		AND
		DB_Players((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, S_DEN_Tiefling_FoodTrader_001_1b35671b-e5d7-4943-bbd0-4c816b69b7cb)
		AND
		QRY_OnlyOnce("ORI_Karlach_ReactedToGruel")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)DEN_RefugeeChef_PAD_KarlachReactsToFood_4bcd3159-c8a1-eb55-17b5-e47319d74ea0, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		
		PROC
		PROC_FlagReactionAfterDialog(_, (FLAG)DEN_Thieflings_Event_TookGruel2_cbf45767-7dac-0bdc-1f0f-8203b44798d9)
		AND
		DB_Players((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, S_DEN_Tiefling_FoodTrader_001_1b35671b-e5d7-4943-bbd0-4c816b69b7cb)
		AND
		QRY_OnlyOnce("ORI_Karlach_ReactedToGruel")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)DEN_RefugeeChef_PAD_KarlachReactsToFood_4bcd3159-c8a1-eb55-17b5-e47319d74ea0, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		//END_REGION
		
		//REGION Engine Problems Night
		// Companion Karlach
		PROC
		PROC_ORI_Karlach_EngineProblemsNight()
		THEN
		DB_CampNight((FLAG)NIGHT_Karlach_EngineProblems_b25f5638-342e-4b82-9462-3d8c7612c115, 5500);
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_b25f5638-342e-4b82-9462-3d8c7612c115, "WLDMAIN");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_b25f5638-342e-4b82-9462-3d8c7612c115, "WLDCAVGRN");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_b25f5638-342e-4b82-9462-3d8c7612c115, "WLDCAVSND");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_b25f5638-342e-4b82-9462-3d8c7612c115, "WLDDUNSHA");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_b25f5638-342e-4b82-9462-3d8c7612c115, "WLDDUNABB");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_b25f5638-342e-4b82-9462-3d8c7612c115, "WLDUND");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_b25f5638-342e-4b82-9462-3d8c7612c115, "WLDBAS");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_b25f5638-342e-4b82-9462-3d8c7612c115, "CREMAIN");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_b25f5638-342e-4b82-9462-3d8c7612c115, "CREINSIDE");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_b25f5638-342e-4b82-9462-3d8c7612c115, "SCLMAIN");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_b25f5638-342e-4b82-9462-3d8c7612c115, "HAVEN");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_b25f5638-342e-4b82-9462-3d8c7612c115, "MOONRISE");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_b25f5638-342e-4b82-9462-3d8c7612c115, "SHARTEMPLE");
		DB_CampNight_Requirement((FLAG)NIGHT_Karlach_EngineProblems_b25f5638-342e-4b82-9462-3d8c7612c115, (FLAG)VISITEDREGION_CRE_Main_A_c22062f9-2a42-4e19-8c72-34a2d9ff9c0a);
		DB_CampNight_Requirement((FLAG)NIGHT_Karlach_EngineProblems_b25f5638-342e-4b82-9462-3d8c7612c115, (FLAG)VISITEDREGION_SCL_Main_A_f6e72539-9bc6-42e1-a20f-390f3a17ad8d);
		DB_CampNight_CancelledBy((FLAG)NIGHT_Karlach_EngineProblems_b25f5638-342e-4b82-9462-3d8c7612c115, (FLAG)GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade_f6dc0de4-1089-43c0-b392-306a9a44387c);
		DB_CampNight_CRD((FLAG)NIGHT_Karlach_EngineProblems_b25f5638-342e-4b82-9462-3d8c7612c115, (CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)CAMP_EngineProblems_CRD_Karlach_c4106533-d3e8-72bf-84e4-61f7787541aa, (FLAG)NULL_00000000-0000-0000-0000-000000000000);
		
		// Avatar Karlach
		PROC
		PROC_ORI_Karlach_EngineProblemsNight()
		THEN
		DB_CampNight((FLAG)NIGHT_Karlach_EngineProblems_Avatar_d177bb44-3d39-4c45-8325-fd1ee0556ca1, 6500);
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_Avatar_d177bb44-3d39-4c45-8325-fd1ee0556ca1, "WLDMAIN");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_Avatar_d177bb44-3d39-4c45-8325-fd1ee0556ca1, "WLDCAVGRN");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_Avatar_d177bb44-3d39-4c45-8325-fd1ee0556ca1, "WLDCAVSND");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_Avatar_d177bb44-3d39-4c45-8325-fd1ee0556ca1, "WLDDUNSHA");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_Avatar_d177bb44-3d39-4c45-8325-fd1ee0556ca1, "WLDDUNABB");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_Avatar_d177bb44-3d39-4c45-8325-fd1ee0556ca1, "WLDUND");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_Avatar_d177bb44-3d39-4c45-8325-fd1ee0556ca1, "WLDBAS");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_Avatar_d177bb44-3d39-4c45-8325-fd1ee0556ca1, "CREMAIN");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_Avatar_d177bb44-3d39-4c45-8325-fd1ee0556ca1, "CREINSIDE");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_Avatar_d177bb44-3d39-4c45-8325-fd1ee0556ca1, "SCLMAIN");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_Avatar_d177bb44-3d39-4c45-8325-fd1ee0556ca1, "HAVEN");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_Avatar_d177bb44-3d39-4c45-8325-fd1ee0556ca1, "MOONRISE");
		DB_CampNight_Camp((FLAG)NIGHT_Karlach_EngineProblems_Avatar_d177bb44-3d39-4c45-8325-fd1ee0556ca1, "SHARTEMPLE");
		DB_CampNight_Requirement((FLAG)NIGHT_Karlach_EngineProblems_Avatar_d177bb44-3d39-4c45-8325-fd1ee0556ca1, (FLAG)VISITEDREGION_CRE_Main_A_c22062f9-2a42-4e19-8c72-34a2d9ff9c0a);
		DB_CampNight_Requirement((FLAG)NIGHT_Karlach_EngineProblems_Avatar_d177bb44-3d39-4c45-8325-fd1ee0556ca1, (FLAG)VISITEDREGION_SCL_Main_A_f6e72539-9bc6-42e1-a20f-390f3a17ad8d);
		DB_CampNight_CancelledBy((FLAG)NIGHT_Karlach_EngineProblems_Avatar_d177bb44-3d39-4c45-8325-fd1ee0556ca1, (FLAG)GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade_f6dc0de4-1089-43c0-b392-306a9a44387c);
		DB_CampNight_SoloDream((FLAG)NIGHT_Karlach_EngineProblems_Avatar_d177bb44-3d39-4c45-8325-fd1ee0556ca1, (CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)CAMP_EngineProblems_SD_Karlach_c53a35be-2ea9-164c-e125-088ba93e5aa4);
		
		//END_REGION Engine Problems Night
	}
	EXIT
	{
	}
}
Goal(219).Title("Act1_OriginMoments_Laezel");
Goal(219)
{
	INIT
	{
		//REGION Laezel Origin Moments
		TriggerRegisterForCharacter((TRIGGER)S_DEN_General_Laezel_CommentAfterVisitingGrove_ea4a466a-7449-4630-81ef-86fb1204dd02,(CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		
		PROC_DefineSingleOriginMoment(DEN_General_TieflingGuard11_5285ea7c-7994-ba01-02c7-fa05017342ee,(TAG)LAEZEL_3b07eac7-fab3-4120-a46c-51dbb3ec500b,(DIALOGRESOURCE)DEN_ThingLikeMe_OM_Laezel_AOM_OOM_ee6c3da5-c872-803e-77c5-79f4f22795a8,(DIALOGRESOURCE)DEN_ThingLikeMe_OM_Laezel_COM_b1e7f9b2-9726-8868-f1e4-c3a6cf574e2c,(DIALOGRESOURCE)DEN_ThingLikeMe_OM_Laezel_AOM_OOM_ee6c3da5-c872-803e-77c5-79f4f22795a8);
		DB_DEN_ThingLikeMe_TieflingPositions((FLAG)DEN_ThingLikeMe_State_TieflingStand_d4869137-9586-2f01-292c-78909b45e3f8, "DEN_ThingLikeMe_HideFear");
		DB_DEN_ThingLikeMe_TieflingPositions((FLAG)DEN_ThingLikeMe_State_TieflingBow_438787a5-d483-a51b-4a57-668f7956dcc2, "DEN_ThingLikeMe_KneelHideFear");
		DB_DEN_ThingLikeMe_TieflingPositions((FLAG)DEN_ThingLikeMe_State_TieflingKneel_fdfebaa6-dbfa-35ff-8e52-28c603bad645, "DEN_ThingLikeMe_LowBowFearful");
		DB_DEN_ThingLikeMe_CurrentPosition((FLAG)DEN_ThingLikeMe_State_TieflingStand_d4869137-9586-2f01-292c-78909b45e3f8, "DEN_ThingLikeMe_HideFear");
		
		DB_DEN_ThingLikeMe_OriginDialogs((DIALOGRESOURCE)DEN_ThingLikeMe_OM_Laezel_AOM_OOM_ee6c3da5-c872-803e-77c5-79f4f22795a8);
		DB_DEN_ThingLikeMe_OriginDialogs(DEN_ThingLikeMe_OM_Laezel_COM_b1e7f9b2-9726-8868-f1e4-c3a6cf574e2c);
		
		DB_PermaDefeatedFlag(S_DEN_Tiefling_011_77439e86-3f60-4456-bd55-931e2f45654f, (FLAG)ORI_Laezel_Quest_ZorruIsPermaDefeated_209f9a35-5e97-4f13-bd6e-25b05fc85975);
		DB_SeenDeadNPCGlobalFlag(S_DEN_Tiefling_011_77439e86-3f60-4456-bd55-931e2f45654f, (FLAG)ORI_Laezel_Quest_SawDeadZorru_10783903-034f-41be-ad6a-e2cbbb73242a);
		//END_REGION
		
		DB_CampNight((FLAG)NIGHT_Laezel_GithChokepoint_63990fd7-ff59-4c1b-b9e5-5961cde235d5,2030 /*3030 for avatar*/,(CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		DB_CampNight_Camp((FLAG)NIGHT_Laezel_GithChokepoint_63990fd7-ff59-4c1b-b9e5-5961cde235d5,"WLDMAIN");
		DB_CampNight_Camp((FLAG)NIGHT_Laezel_GithChokepoint_63990fd7-ff59-4c1b-b9e5-5961cde235d5,"WLDCAVGRN");
		DB_CampNight_Camp((FLAG)NIGHT_Laezel_GithChokepoint_63990fd7-ff59-4c1b-b9e5-5961cde235d5,"WLDCAVSND");
		DB_CampNight_Camp((FLAG)NIGHT_Laezel_GithChokepoint_63990fd7-ff59-4c1b-b9e5-5961cde235d5,"WLDDUNABB");
		DB_CampNight_Camp((FLAG)NIGHT_Laezel_GithChokepoint_63990fd7-ff59-4c1b-b9e5-5961cde235d5,"WLDDUNSHA");
		DB_CampNight_Camp((FLAG)NIGHT_Laezel_GithChokepoint_63990fd7-ff59-4c1b-b9e5-5961cde235d5,"WLDUND");
		DB_CampNight_Camp((FLAG)NIGHT_Laezel_GithChokepoint_63990fd7-ff59-4c1b-b9e5-5961cde235d5,"WLDBAS");
		DB_CampNight_ExpiresAfter((FLAG)NIGHT_Laezel_GithChokepoint_63990fd7-ff59-4c1b-b9e5-5961cde235d5,1);
		DB_CampNight_Requirement((FLAG)NIGHT_Laezel_GithChokepoint_63990fd7-ff59-4c1b-b9e5-5961cde235d5,(FLAG)GLO_GithChokepoint_Event_LaezelOMStarted_84283682-101d-1531-7aae-33aa56999a70);
		DB_CampNight_CancelledBy(NIGHT_Laezel_GithChokepoint_63990fd7-ff59-4c1b-b9e5-5961cde235d5, (FLAG)ORI_laezel_State_HadAfterChokepointDiscussion_e90acc28-3c0c-476c-ac2d-2d074a666b96);
		DB_CampNight_CRD((FLAG)NIGHT_Laezel_GithChokepoint_63990fd7-ff59-4c1b-b9e5-5961cde235d5,(CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12,(DIALOGRESOURCE)PLA_GithChokepoint_WRD_LaezelAfterVossAtChokepoint_05b0a5cc-5ea2-1c67-acff-a048b3eeb679,(FLAG)NULL_00000000-0000-0000-0000-000000000000);
		
		SetFlag((FLAG)ORI_Laezel_State_HasNotPassedCreche_946ca251-adb9-4177-9e12-64499d02cff1, NULL_00000000-0000-0000-0000-000000000000, 0);
	}
	KB
	{
		//REGION Laezel waking up
		
		// Delete when it becomes possible to start as Lae'zel (the trick is to call that during the intro cutscene)
		IF
		TextEvent("laezelwakingup")
		AND
		GetHostCharacter(_Player)
		THEN
		SetFlag(Debug_AddGith_39ecbda9-cb44-becf-57b9-c3b631a5517b, _Player);
		SetFlag(Debug_BecomeAvatar_34371b8e-a34b-3354-54e7-fcda800d703a, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		SetFlag(Debug_BecomeCompanion_4670c626-a52f-aeed-c18a-dc8d9c78b7cb, _Player);
		
		//END_REGION
		
		//REGION Fighting in Raiding Party
		
		IF
		DB_DEN_GoblinRaidCombatID(_ID)
		AND
		DB_Is_InCombat(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _ID)
		AND
		NOT DB_GlobalFlag(ORI_Laezel_State_FoughtInRaidingParty_079d3597-a944-46f5-9e74-8abaf9ea3262)
		THEN
		//gossip condition:
		SetFlag(ORI_Laezel_State_FoughtInRaidingParty_079d3597-a944-46f5-9e74-8abaf9ea3262, NULL_00000000-0000-0000-0000-000000000000);
		
		
		//END_REGION
		
		//REGION Thing Like Me (Laezel Origin Moment)
		
		//Started game without Lae'zel Avatar,send kid to hideout 
		PROC
		PROC_GLO_Origins_SetupRecruitment("WLD_Main_A")
		AND
		NOT DB_Avatars(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		THEN
		SetEntityEvent(S_DEN_TieflingKid_004_6644185d-385e-4dfc-973c-bb854cbfd540, "DEN_TieflingKid_004_NoAvatar", 1);
		
		//Started game with Lae'zel Avatar,stop Zorru patrolling, make stand in corner for scene 
		PROC
		PROC_GLO_Origins_SetupRecruitment("WLD_Main_A")
		AND
		DB_Avatars(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		THEN
		SetFlag(DEN_ThingLikeMe_State_BeforeOM_9e9cecdb-44ee-4b32-970c-535d1e7a5496, NULL_00000000-0000-0000-0000-000000000000);
		
		//Companion Lae'zel joined party,stop Zorru patrolling, make stand in corner for scene 
		IF
		CharacterJoinedParty(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		NOT DB_GlobalFlag(DEN_ThingLikeMe_State_OMPlayed_43e9e5e6-8445-489b-b062-453cf8c47b49)
		THEN
		SetFlag(DEN_ThingLikeMe_State_BeforeOM_9e9cecdb-44ee-4b32-970c-535d1e7a5496, NULL_00000000-0000-0000-0000-000000000000);
		
		//Companion Lae'zel left party,start Zorru patrolling
		IF
		CharacterLeftParty(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		NOT DB_GlobalFlag(DEN_ThingLikeMe_State_OMPlayed_43e9e5e6-8445-489b-b062-453cf8c47b49)
		THEN
		ClearFlag(DEN_ThingLikeMe_State_BeforeOM_9e9cecdb-44ee-4b32-970c-535d1e7a5496, NULL_00000000-0000-0000-0000-000000000000);
		
		//Tiefling Kid finished his AD, have Avatar Lae'zel VB in response
		IF
		EntityEvent((CHARACTER)_Laezel, "DEN_TieflingKid_004_FinishedAD")
		AND
		IsTagged(_Laezel, (TAG)REALLY_LAEZEL_b5682d1d-c395-489c-9675-1f9b0c328ea5, 1)
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)DEN_ThingLikeMe_VB_AfterKid_c4e842c6-3901-1072-b868-2cd3622097ab, _Laezel);
		
		//Don't have Zorru do a followup default dialog after the origin moment
		QRY
		QRY_OriginMoment_PreventRelaunchDialog(_Dialog, S_DEN_Tiefling_011_77439e86-3f60-4456-bd55-931e2f45654f, _Player)
		AND
		DB_DEN_ThingLikeMe_OriginDialogs(_Dialog)
		THEN
		DB_NOOP(1);
		
		//Zorru won't react to most crimes Lae'zel does, as he's afraid of her
		QRY
		QRY_CRIME_BlockRegisterCrime((CHARACTER)_Char,_Type,_,(CHARACTER)S_DEN_Tiefling_011_77439e86-3f60-4456-bd55-931e2f45654f,_)
		AND
		IsTagged(_Char, (TAG)LAEZEL_3b07eac7-fab3-4120-a46c-51dbb3ec500b, 1)
		AND
		QRY_CRIME_GetCrimeFamily(_Type)
		AND
		DB_QRYRTN_CRIME_GetCrimeFamily(_Family)
		AND
		_Family!="Assault"
		AND
		_Family!="Murder"
		AND
		DB_GlobalFlag(DEN_ThingLikeMe_State_OMPlayed_43e9e5e6-8445-489b-b062-453cf8c47b49)
		THEN
		DB_NOOP(1);
		
		//OM done
		IF
		DialogEnded(_Dialog, _Id)
		AND
		DB_DEN_ThingLikeMe_OriginDialogs(_Dialog)
		THEN
		PROC_DEN_ThingLikeMe_OriginDialogEnded(_Id);
		PROC_DEN_ThingLikeMe_OMEndedJournalHook();
		
		PROC
		PROC_DEN_ThingLikeMe_OMEndedJournalHook()
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_DEN_ThingLikeMe_OriginDialogEnded((INTEGER)_Id)
		AND
		NOT DB_GlobalFlag(DEN_ThingLikeMe_State_OMPlayed_43e9e5e6-8445-489b-b062-453cf8c47b49)
		THEN
		SetFlag((FLAG)DEN_ThingLikeMe_State_OMPlayed_43e9e5e6-8445-489b-b062-453cf8c47b49, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		//Trigger Lae'zel followup RD after OM
		PROC
		PROC_DEN_ThingLikeMe_OriginDialogEnded((INTEGER)_Id)
		AND
		GetFlag(DEN_ThingLikeMe_Event_Followup_9e143f99-e9fe-16e5-2632-ec4393639d4d, NULL_00000000-0000-0000-0000-000000000000, 1)
		AND
		DB_DialogPlayers(_Id,_Laezel,1)
		AND
		IsTagged(_Laezel, (TAG)REALLY_LAEZEL_b5682d1d-c395-489c-9675-1f9b0c328ea5, 1)
		AND
		QRY_OnlyOnce("DEN_ThingLikeMe_RD_LaezelCreche")
		THEN
		PROC_RelationshipDialog((CHARACTER)_Laezel, (DIALOGRESOURCE)DEN_ThingLikeMe_RD_LaezelCreche_0ff96e33-eeac-3fb6-54bd-bbee82f8db46, _Laezel);
		
		//Zorru saw Lae'zel, figure out which animation to switch into if any
		IF
		Saw(S_DEN_Tiefling_011_77439e86-3f60-4456-bd55-931e2f45654f, (CHARACTER)_Char, _)
		AND
		IsTagged(_Char, (TAG)LAEZEL_3b07eac7-fab3-4120-a46c-51dbb3ec500b, 1)
		AND
		DB_GlobalFlag((FLAG)DEN_ThingLikeMe_State_OMPlayed_43e9e5e6-8445-489b-b062-453cf8c47b49)
		AND
		DB_DEN_ThingLikeMe_CurrentPosition(_Flag, _Animation)
		AND
		GetFlag(_Flag, S_DEN_Tiefling_011_77439e86-3f60-4456-bd55-931e2f45654f, 1)
		THEN
		PROC_DEN_ThingLikeMe_ChangeDialogPosition((STRING)_Animation, (CHARACTER)_Char);
		SetFlag((FLAG)DEN_ThingLikeMe_State_AnimateForLaezel_6acad37a-9107-45fd-be56-47f1396085b3, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		//Zorru lost sight of Lae'zel, return to default animation
		IF
		LostSightOf((CHARACTER)S_DEN_Tiefling_011_77439e86-3f60-4456-bd55-931e2f45654f, (CHARACTER)_Char)
		AND
		IsTagged(_Char, (TAG)LAEZEL_3b07eac7-fab3-4120-a46c-51dbb3ec500b, 1)
		THEN
		PROC_DEN_ThingLikeMe_ChangeDialogPosition("DEN_ThingLikeMe_HideFear", (CHARACTER)_Char);
		ClearFlag((FLAG)DEN_ThingLikeMe_State_AnimateForLaezel_6acad37a-9107-45fd-be56-47f1396085b3, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		//Zorru animates externally while in the timeline
		IF
		FlagSet((FLAG)_Flag, S_DEN_Tiefling_011_77439e86-3f60-4456-bd55-931e2f45654f, _Id)
		AND
		DB_DEN_ThingLikeMe_TieflingPositions(_Flag, _Animation)
		AND
		NOT DB_DEN_ThingLikeMe_CurrentPosition(_Flag, _Animation)
		AND
		DB_DialogPlayers(_Id,_Char,_)
		AND
		IsTagged(_Char, (TAG)LAEZEL_3b07eac7-fab3-4120-a46c-51dbb3ec500b, 1)
		THEN
		SysClear("DB_DEN_ThingLikeMe_CurrentPosition", 2);
		DB_DEN_ThingLikeMe_CurrentPosition(_Flag, _Animation);
		PROC_DEN_ThingLikeMe_ChangeDialogPosition((STRING)_Animation, (CHARACTER)_Char);
		SetFlag((FLAG)DEN_ThingLikeMe_State_AnimateForLaezel_6acad37a-9107-45fd-be56-47f1396085b3, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		//Event caught in Anubis
		PROC
		PROC_DEN_ThingLikeMe_ChangeDialogPosition((STRING)_Animation, (CHARACTER)_Char)
		AND
		_Animation!=""
		THEN
		SetDualEntityEvent(S_DEN_Tiefling_011_77439e86-3f60-4456-bd55-931e2f45654f,_Char,_Animation);
		//END_REGION
		
		//REGION General Grove Moments (Laezel Origin Moment)
		IF
		EnteredTrigger((CHARACTER)_Laezel, (TRIGGER)S_DEN_Cave_SUB_adecafa4-27c6-4b2f-bf9e-6ffd7c81a766)
		AND
		IsTagged(_Laezel, (TAG)REALLY_LAEZEL_b5682d1d-c395-489c-9675-1f9b0c328ea5, 1)
		AND
		GetFlag(DEN_LaezelGeneral_Event_ExploredGrove_f175174d-d17c-4cc7-8f6c-e53d5d966c7c, _Laezel, 0)
		THEN
		SetFlag(DEN_LaezelGeneral_Event_ExploredGrove_f175174d-d17c-4cc7-8f6c-e53d5d966c7c, _Laezel, 0);
		
		IF
		EnteredTrigger((CHARACTER)_Laezel, (TRIGGER)S_DEN_General_Laezel_CommentAfterVisitingGrove_ea4a466a-7449-4630-81ef-86fb1204dd02)
		AND
		GetFlag(DEN_LaezelGeneral_Event_ExploredGrove_f175174d-d17c-4cc7-8f6c-e53d5d966c7c, _Laezel, 1)
		AND
		NOT DB_GlobalFlag((FLAG)DEN_AttackOnDen_Event_Start_c641da6a-b3f5-4873-bd34-c53768d30d6f)
		AND
		NOT DB_GlobalFlag((FLAG)DEN_TieflingRefugees_State_LeftDen_003b304b-f058-4f8a-b9fa-a097e1b6b395)
		AND
		NOT DB_GlobalFlag((FLAG)DEN_ShadowDruid_State_CourtHostile_b79f3102-f47e-339c-23f2-1de2c38d4e6e)
		AND
		NOT DB_GlobalFlag((FLAG)DEN_Lockdown_State_Active_0b54c7d2-b7b1-4d0f-b8e4-0cf1ee32b1eb)
		AND
		NOT DB_GlobalFlag((FLAG)DEN_TieflingLeader_State_PermaDefeated_b8eac5ee-2c63-9924-91c2-668d5bffa74c)
		AND
		NOT DB_OnlyOnce("DEN_LaezelGeneral_WRD_LeftGrove")
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)DEN_LaezelGeneral_VB_FishOutofWater_100ec4a4-238c-de7e-59c0-62f6361ecc61, _Laezel);
		TriggerUnregisterForCharacter((TRIGGER)S_DEN_General_Laezel_CommentAfterVisitingGrove_ea4a466a-7449-4630-81ef-86fb1204dd02,(CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		//END_REGION
		
		IF
		TextEvent("thinglikemedone")
		THEN
		SetFlag(DEN_ThingLikeMe_State_TieflingBow_438787a5-d483-a51b-4a57-668f7956dcc2,S_DEN_Tiefling_011_77439e86-3f60-4456-bd55-931e2f45654f,0);
		SysClear("DB_DEN_ThingLikeMe_CurrentPosition", 2);
		DB_DEN_ThingLikeMe_CurrentPosition(DEN_ThingLikeMe_State_TieflingBow_438787a5-d483-a51b-4a57-668f7956dcc2, "DEN_ThingLikeMe_KneelHideFear");
		SetFlag(DEN_ThingLikeMe_State_OMPlayed_43e9e5e6-8445-489b-b062-453cf8c47b49, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetEntityEvent(S_DEN_Tiefling_011_77439e86-3f60-4456-bd55-931e2f45654f, "DEN_ThingLikeMe_KneelHideFear");
	}
	EXIT
	{
	}
}
Goal(220).Title("Act1_OriginMoments_Shadowheart");
Goal(220)
{
	INIT
	{
		PROC_TriggerRegisterForPlayers(S_FOR_ShadowheartOM_FindStatue_8c59dd2a-9c26-4fee-abdd-2e0ce2f1a19b);
		PROC_TriggerRegisterForPlayers(S_GOB_TempleBox_001_754d69fd-f1aa-486d-8f9f-ee8957215780);
		PROC_TriggerRegisterForPlayers(S_GOB_TempleBox_OM_Trigger_032e964d-1a38-4bce-8a6d-f5df80efc4e7);
	}
	KB
	{
		//REGION GOB_SeluneTemple
		PROC
		PROC_LongRest()
		THEN
		ClearFlag(ORI_Shadowheart_State_DailySharAsked_83d60840-bb71-4d22-9e98-3e7a81cfc384,NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		DB_InRegion(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,S_GOB_TempleBox_OM_Trigger_032e964d-1a38-4bce-8a6d-f5df80efc4e7)
		AND
		NOT DB_OnlyOnce("GOB_SeluneTemple_OM_Shadowheart")
		AND
		NOT DB_CantTalk(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		AND
		NOT QRY_ORI_Shadowheart_COM("SeluneTemple")
		AND
		QRY_StartDialog_Fixed(GOB_SeluneTemple_OM_ShadowHeart_AOM_OOM_e5b60eb6-bfa8-b36c-1bcf-7ac1537636a4,S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		THEN
		DB_OnlyOnce("GOB_SeluneTemple_OM_Shadowheart");
		
		QRY
		QRY_ORI_Shadowheart_COM("SeluneTemple")
		AND
		QRY_GetBestAvatarForCompanion((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,1,1)
		AND
		DB_QRYRTN_GetBestAvatarForCompanion((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,_Avatar)
		AND
		QRY_StartDialog_Fixed(GOB_SeluneTemple_OM_ShadowHeart_COM_e24b3ed5-82f8-6799-aa35-17ad5921e711,S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,_Avatar)
		THEN
		DB_OnlyOnce("GOB_SeluneTemple_OM_Shadowheart");
		//END_REGION
		
		//REGION
		IF
		TextEvent("FOR_MoonhavenOM_AddCrown")
		AND
		DB_Players(_Player)
		THEN
		ToInventory(QUEST_FOR_ShadowheartOM_SharCrown_e3783967-575a-83c7-0a07-5c80a938fdf9, _Player, 1, 1, 1);
		//END_REGION
		
	}
	EXIT
	{
	}
}
Goal(221).Title("Act1_OriginMoments_Shadowheart_PostEA");
Goal(221)
{
	INIT
	{
		// DEN - MURALS
		DB_OneShot_VoiceBarkTrigger((TRIGGER)S_DEN_ShadowheartMuralSpot_72a4b7aa-f225-4429-8e16-88accfd0033e, (VOICEBARKRESOURCE)DEN_DarkJusticiar_VB_MuralHint_1c1c191b-cc19-4546-cebd-08b3274a0910, "Global");
		
		// UND - SHAR VISTA
		DB_OneShot_VoiceBarkTrigger((TRIGGER)S_UND_SharTempleVista_77fb985c-36ee-47b6-8d5e-b2304613e13f, (VOICEBARKRESOURCE)UND_DarkJusticiar_VB_SharTempleVista_e44419f4-b158-c634-a18c-ad9fa7d26fb9, "Global");
		
		// FOR - MOONHAVEN OM - Overriding EA moment.
		DB_OnlyOnce("FOR_MoonhavenOM_MomentStarted");
		
		// UND - Idol of Shar
		DB_HasItemEvent((ITEM)S_UND_IdolOfShar_18d2c483-c9eb-49be-a6d1-0d8961c13e87, (FLAG)UND_IdolOfShar_State_HasIdol_f5858c41-cb2a-45c6-8093-8a0545979cc6);
		DB_GiveItemToEvent((ITEM)S_UND_IdolOfShar_18d2c483-c9eb-49be-a6d1-0d8961c13e87, (FLAG)UND_IdolOfShar_Event_GiveIdol_70188c82-5e67-4215-b8cb-e47bd69a8f65);
		
		// GLO - Dark Justiciar Hints
		DB_ORI_Shadowheart_DarkJusticiarHints_Trigger((TRIGGER)S_UND_DarkJusticiarHints_TempleBounds_67d036fb-151e-4198-9a92-bf95a059ab44, (FLAG)ORI_Shadowheart_State_AtTempleVista_a89becc9-6378-420b-b6d0-cfc5a901a67f);
		DB_ORI_Shadowheart_DarkJusticiarHints_Trigger((TRIGGER)S_UND_DarkJusticiarHints_IdolBounds_9581ef83-3e4c-428f-8481-d5420a2a39b3, (FLAG)ORI_Shadowheart_State_AtIdol_75bd8e12-6884-44de-8c30-94b8c090367f);
		DB_ORI_Shadowheart_DarkJusticiarHints_Trigger((TRIGGER)S_DEN_AtShadowheartMuralSpot_c755eb1e-8057-4c08-9e51-63aaf7d5c75d, (FLAG)ORI_Shadowheart_State_AtMural_183a6f1e-90e5-4eb1-9b8d-3d1b5a5931eb);
		
		
		// GLO - Incurable Wound Fallback
		DB_ORI_Shadowheart_IncurableWound_OriginRelations((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, (FLAG)ORI_Shadowheart_State_AstarionApproval_f03a4b29-f88f-4d08-ac12-3d023dc081ed);
		DB_ORI_Shadowheart_IncurableWound_OriginRelations((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, (FLAG)ORI_Shadowheart_State_GaleApproval_3e31f887-def0-406c-92f4-3931993ff1d4);
		DB_ORI_Shadowheart_IncurableWound_OriginRelations((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (FLAG)ORI_Shadowheart_State_KarlachApproval_499841c5-dc05-4106-b53a-b0448cbcab17);
