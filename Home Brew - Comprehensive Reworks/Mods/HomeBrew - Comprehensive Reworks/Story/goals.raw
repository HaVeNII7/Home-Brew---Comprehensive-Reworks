		DB_CombatReact_AD_OnCast(S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265, (DIALOGRESOURCE)UND_MyconidSovereign_AD_Combat_AnimatingSpores_01_819a0931-4014-0eaa-f0af-4b53cd9068c4, "Target_AnimatingSpores");
		DB_CombatReact_AD_OnCast(S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265, (DIALOGRESOURCE)UND_MyconidSovereign_AD_Combat_AnimatingSpores_02_fbec7571-da9f-c03e-44b4-6a50cfb482f2, "Target_AnimatingSpores");
		DB_CombatReact_AD_OnCast(S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265, (DIALOGRESOURCE)UND_MyconidSovereign_AD_Combat_AnimatingSpores_03_f3fc2a28-4b99-108b-81d3-39ba2d26788e, "Target_AnimatingSpores");
		DB_CombatReact_AD_OnNextTurn(S_UND_Myconid_003_167dde09-95d6-4fbe-9fc1-ef961129e1cb, (DIALOGRESOURCE)UND_MyconidCircle_AD_Myconid_003_Combat_722c9685-fd13-4d2a-c34f-35f38c919764);
		DB_CombatReact_AD_OnNextTurn(S_UND_Myconid_004_c676520b-86bf-46ef-80f9-14e04088b136, (DIALOGRESOURCE)UND_MyconidCircle_AD_Myconid_004_Combat_fb577f6e-a7b0-8eee-6f24-134624d9e4c9);
		DB_CombatReact_AD_OnNextTurn(S_UND_Myconid_005_0339346e-6ccc-4855-b6b2-a021e2e0b4bf, (DIALOGRESOURCE)UND_MyconidCircle_AD_Myconid_005_Combat_d325f858-4350-6ee7-dcbc-35f70386d346);
		
		DB_GLO_DefeatCounter_AllPermaDefeatedGlobalFlag("UND_MyconidCircle_KillCounter",(FLAG)UND_MyconidCircle_State_Wiped_bf1fa066-a4cf-d28a-59a4-4adadb605bdd);
		
		DB_UND_MyconidCircle_CrimeDialogs((DIALOGRESOURCE)NGB_Myconids_Crimes_03ae7a90-8857-cb30-0399-7dc606f14f9b);
		DB_UND_MyconidCircle_CrimeDialogs((DIALOGRESOURCE)NGB_Myconids_Trespass_96142562-d495-9262-8133-9da2bb86817b);
	}
	KB
	{
		//REGION Spaw enters combat with players, change ATM.
		IF
		EnteredCombat(S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265, _CombatID)
		AND
		DB_Players(_Player)
		AND
		DB_Is_InCombat(_Player, _CombatID)
		THEN
		TriggerSetAtmosphere((TRIGGER)ATM_WLD_Underdark_C_MyconidVillage_2344f54e-fd13-4387-a128-c94157e08376,"c1e1b75f-7f82-6d72-38ac-30994113d7c2"); //ATM_Dungeon_Grading_Underdark_MyconidHostile
		
		IF
		DB_PermaDefeated((CHARACTER)S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265)
		THEN
		TriggerResetAtmosphere((TRIGGER)ATM_WLD_Underdark_C_MyconidVillage_2344f54e-fd13-4387-a128-c94157e08376);
		
		IF
		TextEvent("UNDAtmosphereChange")
		AND
		GetHostCharacter(_Char)
		THEN
		DebugText(_Char, "UNDAtmosphereChange");
		TriggerSetAtmosphere((TRIGGER)ATM_WLD_Underdark_C_MyconidVillage_2344f54e-fd13-4387-a128-c94157e08376,"c1e1b75f-7f82-6d72-38ac-30994113d7c2"); //ATM_Dungeon_Grading_Underdark_MyconidHostile
		
		IF
		TextEvent("UNDAtmosphereReset")
		AND
		GetHostCharacter(_Char)
		THEN
		DebugText(_Char, "UNDAtmosphereReset");
		TriggerResetAtmosphere((TRIGGER)ATM_WLD_Underdark_C_MyconidVillage_2344f54e-fd13-4387-a128-c94157e08376);
		
		//END_REGION
		
		//REGION Current sorvereign
		PROC
		PROC_StateSet_PermaDefeated(_Sovereign)
		AND
		DB_UND_MyconidCircle_CurrentSovereign((CHARACTER)_Sovereign)
		THEN
		NOT DB_UND_MyconidCircle_CurrentSovereign((CHARACTER)_Sovereign);
		
		IF
		FlagSet(UND_MyconidCircle_BroodingSovereign_Done_f80e93f9-53b5-4537-96a7-583508ba1cb8,_,_)
		AND
		NOT DB_PermaDefeated(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46)
		AND
		NOT DB_UND_MyconidCircle_CurrentSovereign(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46)
		THEN
		DB_UND_MyconidCircle_CurrentSovereign((CHARACTER)S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46);
		//END_REGION
		
		//REGION killcounts
		
		IF
		DB_UND_MyconidCircle_Myconids(_Myconid)
		AND
		_Myconid != S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46
		THEN
		DB_GLO_DefeatCounter(_Myconid, "UND_MyconidCircle_KillCounter");
		
		IF
		DB_GlobalFlag(UND_MyconidCircle_Sovereign_State_PermaDefeated_bcfa3d32-7250-4c44-9eff-fbf30cef2b6e)
		AND
		DB_GlobalFlag(UND_MyconidCircle_BroodingSovereign_State_PermaDefeated_da7ae2b1-fa67-0889-6003-48d6aef7271d)
		THEN
		PROC_GlobalSetFlagAndCache(UND_MyconidCircle_State_BothSovereignsDead_84a1008e-f3a0-4136-b085-8eb43be8aa93);
		//END_REGION
		
		//REGION silence
		
		IF
		DB_UND_MyconidCircle_Dialogs(_,(DIALOGRESOURCE)_Dialog)
		THEN
		DB_IgnoreMutingStatussesDialog((DIALOGRESOURCE)_Dialog);
		
		IF
		DB_UND_MyconidCircle_CheckpointDialogues(_,(DIALOGRESOURCE)_Dialog)
		THEN
		DB_IgnoreMutingStatussesDialog((DIALOGRESOURCE)_Dialog);
		
		//END_REGION
		
		//REGION Hidden Cave
		
		IF
		DB_GlobalFlag((FLAG)UND_DuergarGuards_State_PermaDefeated_b2211d1b-3dea-9b74-b19c-71938ac4b218) // flagType: Global
		AND
		DB_PermaDefeated(S_UND_LoneDuergar_05c338d9-4590-4c4b-b87e-8c27ea2c2b18)
		THEN
		SetFlag((FLAG)UND_MyconidCircle_Quest_KilledAllDuergars_a3cbbc8f-4e42-4b40-9286-80b4e321cc84, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		
		//END_REGION Hidden Cave
		
		//REGION farms
		IF
		EntityEvent(_Bucket,"UND_MyconidCircle_Event_FillBucket")
		THEN
		SetTag(_Bucket,ACT1_UND_FULLBUCKET_c5d2d42f-8204-4dc4-a4d3-241f2241496d);
		
		IF
		EntityEvent(_Bucket,"UND_MyconidCircle_Event_EmptyBucket")
		THEN
		ClearTag(_Bucket,ACT1_UND_FULLBUCKET_c5d2d42f-8204-4dc4-a4d3-241f2241496d);
		//END_REGION
		
		//REGION Dialogs and dialog replacements
		IF
		DB_UND_MyconidCircle_Dialogs(_Myconid,_)
		AND
		NOT DB_PermaDefeated(_Myconid)
		AND
		IsTagged(_Myconid, (TAG)DWARF_486a2562-31ae-437b-bf63-30393e18cbdd, 0) // we cant show the spore servant VFX on them, so its better to not use this dialog on them.
		THEN
		DB_Dialogs(_Myconid,UND_MyconidCircle_DirectToSovereign_2c551ac0-c261-2268-c0d0-bdd251c99b89);
		
		IF
		DB_UND_MyconidCircle_Dialogs(_Myconid,_Dialog)
		AND
		NOT DB_PermaDefeated(_Myconid)
		AND
		IsTagged(_Myconid, (TAG)DWARF_486a2562-31ae-437b-bf63-30393e18cbdd, 1)
		THEN
		DB_Dialogs(_Myconid, _Dialog);
		
		IF
		FlagSet(UND_MyconidCircle_State_GainedAccess_fb9b0ee2-a499-cef2-fd3e-d9556050ea6a,_,_)
		AND
		NOT DB_GlobalFlag(UND_MyconidCircle_SpokeWithSovereign_155b4ce9-fd7b-445a-afbd-64cb5bf2d707)
		AND
		DB_UND_MyconidCircle_CheckpointDialogues(_Myconid,_Dialog)
		AND
		NOT DB_PermaDefeated(_Myconid)
		THEN
		PROC_RemoveDialogEntryForSpeaker(_Myconid,_Dialog);
		DB_Dialogs(_Myconid,UND_MyconidCircle_DirectToSovereign_2c551ac0-c261-2268-c0d0-bdd251c99b89);
		
		IF
		DB_GlobalFlag((FLAG)UND_MyconidCircle_SpokeWithSovereign_155b4ce9-fd7b-445a-afbd-64cb5bf2d707)
		AND
		DB_UND_MyconidCircle_Dialogs(_Myconid,_Dialog)
		AND
		NOT DB_PermaDefeated(_Myconid)
		AND
		IsTagged(_Myconid, (TAG)DWARF_486a2562-31ae-437b-bf63-30393e18cbdd, 0)
		THEN
		PROC_RemoveDialogEntryForSpeaker(_Myconid,UND_MyconidCircle_DirectToSovereign_2c551ac0-c261-2268-c0d0-bdd251c99b89);
		DB_Dialogs(_Myconid,_Dialog);
		
		IF
		FlagSet((FLAG)UND_MyconidCircle_SpokeWithSovereign_155b4ce9-fd7b-445a-afbd-64cb5bf2d707,_,_)
		AND
		DB_UND_MyconidCircle_CheckpointDialogues(_Myconid,_Dialog)
		THEN
		PROC_RemoveDialogEntryForSpeaker(_Myconid,UND_MyconidCircle_DirectToSovereign_2c551ac0-c261-2268-c0d0-bdd251c99b89);
		DB_Dialogs(_Myconid,_Dialog);
		
		IF
		FlagSet(UND_MyconidCircle_State_GainedAccess_fb9b0ee2-a499-cef2-fd3e-d9556050ea6a,_,_)
		AND
		NOT DB_GlobalFlag(UND_MyconidCircle_SpokeWithSovereign_155b4ce9-fd7b-445a-afbd-64cb5bf2d707)
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_UND_MyconidCircle_ServantHookHorror_01_6ccbf16f-4c9f-4975-b43d-e8569fd1c566);
		DB_Dialogs(S_UND_MyconidCircle_ServantHookHorror_01_6ccbf16f-4c9f-4975-b43d-e8569fd1c566,UND_MyconidCircle_DirectToSovereign_HookHorror_d071b1f9-d2f2-a2d5-6729-c5b7627f0ac7);
		
		IF
		FlagSet((FLAG)UND_MyconidCircle_SpokeWithSovereign_155b4ce9-fd7b-445a-afbd-64cb5bf2d707,_,_)
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_UND_MyconidCircle_ServantHookHorror_01_6ccbf16f-4c9f-4975-b43d-e8569fd1c566);
		DB_Dialogs(S_UND_MyconidCircle_ServantHookHorror_01_6ccbf16f-4c9f-4975-b43d-e8569fd1c566,UND_MyconidCircle_ServantHookHorror_01_10b6ac34-7414-6e0d-0ba1-61a8a808e7f5);
		
		IF
		FlagSet(UND_MyconidSovereign_Event_BlissSpores_dd49aa7f-7f09-dde3-1719-56be08820a9a, (CHARACTER)_Player, _)
		AND
		DB_Players(_Player)
		THEN
		ApplyStatus(_Player, "UND_BLISS_SPORES", -1.0, 1, S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265);
		
		PROC
		PROC_SpotPlayers_Spotted(S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265, "UND_MyconidSovereign_BypassSpot", _Player)
		AND
		QRY_StartDialog(UND_MyconidSovereign_934d97d0-922c-7c31-05fe-054bcc630447, S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265, _Player)
		THEN
		PROC_SpotPlayers_StopSpotting((CHARACTER)S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265, "UND_MyconidSovereign_BypassSpot");
		
		//END_REGION
		
		//REGION RDs
		IF
		DialogEnded(_Dialog, _ID)
		AND
		DB_DialogNPCs(_ID,_Slave,1)
		AND
		DB_UND_MyconidCircle_DuergarSlaves(_Slave)
		AND
		DB_DialogPlayers(_ID, _Player, 1)
		AND
		QRY_OnlyOnce("UND_SporeServant_VB")
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)UND_SporeServant_VB_9f675a2e-b082-4b79-313e-41989f0dfbfc, (CHARACTER)_Player);
		
		IF
		DialogEnded(UND_MyconidCircle_InjuredGnome_SporeServant_3d6c85c2-e7bb-cd0e-8728-88c3f8eecce7, _ID)
		AND
		DB_DialogPlayers(_ID, _Player, 1)
		AND
		QRY_OnlyOnce("UND_SporeServant_VB")
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)UND_SporeServant_VB_9f675a2e-b082-4b79-313e-41989f0dfbfc, (CHARACTER)_Player);
		
		//END_REGION
		
		//REGION dialog with invis helpers
		
		QRY
		QRY_UND_MyconidCircle_TeleportHelper((CHARACTER)_Player)
		AND
		DB_UND_MyconidCircle_SovereignHelpers((ITEM)_Helper)
		AND
		NOT DB_UND_MyconidCircle_SovereignHelpers_InDialog(_Helper,_)
		AND
		NOT DB_UND_MyconidCircle_SovereignHelpers_InDialog(_,_Player)
		THEN
		TeleportTo(_Helper,_Player, "UND_MyconidCircle_SovereignHelper_Teleport");
		DB_UND_MyconidCircle_SovereignHelpers_InDialog(_Helper,_Player);
		
		//keeping _Helper as last speaker to not break current cinematics
		
		QRY
		QRY_SelectCustomDialog_AfterGenerics(_Myconid,(CHARACTER)_Player)
		AND
		DB_Dialogs(_Myconid,UND_MyconidCircle_DirectToSovereign_2c551ac0-c261-2268-c0d0-bdd251c99b89)
		AND
		QRY_UND_MyconidCircle_TeleportHelper(_Player)
		AND
		DB_UND_MyconidCircle_SovereignHelpers_InDialog((ITEM)_Helper,_Player)
		THEN
		DB_SelectedDialog(UND_MyconidCircle_DirectToSovereign_2c551ac0-c261-2268-c0d0-bdd251c99b89, _Myconid, _Player, _Helper);
		
		QRY
		QRY_SelectCustomDialog_AfterGenerics(_Myconid,(CHARACTER)_Player)
		AND
		DB_Dialogs(_Myconid,UND_MyconidCircle_DirectToSovereign_HookHorror_d071b1f9-d2f2-a2d5-6729-c5b7627f0ac7)
		AND
		QRY_UND_MyconidCircle_TeleportHelper(_Player)
		AND
		DB_UND_MyconidCircle_SovereignHelpers_InDialog((ITEM)_Helper,_Player)
		THEN
		DB_SelectedDialog(UND_MyconidCircle_DirectToSovereign_HookHorror_d071b1f9-d2f2-a2d5-6729-c5b7627f0ac7, _Myconid, _Player, _Helper);
		
		IF
		DialogRequestFailed(UND_MyconidCircle_DirectToSovereign_HookHorror_d071b1f9-d2f2-a2d5-6729-c5b7627f0ac7,_ID)
		AND
		DialogGetInvolvedPlayer(_ID,1,(CHARACTER)_Player)
		AND
		DB_UND_MyconidCircle_SovereignHelpers_InDialog((ITEM)_Helper,_Player)
		THEN
		NOT DB_UND_MyconidCircle_SovereignHelpers_InDialog((ITEM)_Helper,_Player);
		
		IF
		DialogRequestFailed(UND_MyconidCircle_DirectToSovereign_2c551ac0-c261-2268-c0d0-bdd251c99b89,_ID)
		AND
		DialogGetInvolvedPlayer(_ID,1,(CHARACTER)_Player)
		AND
		DB_UND_MyconidCircle_SovereignHelpers_InDialog((ITEM)_Helper,_Player)
		THEN
		NOT DB_UND_MyconidCircle_SovereignHelpers_InDialog((ITEM)_Helper,_Player);
		
		IF
		DialogEnded(_,_ID)
		AND
		DialogGetInvolvedPlayer(_ID,1,(CHARACTER)_Player)
		AND
		DB_UND_MyconidCircle_SovereignHelpers_InDialog((ITEM)_Helper,_Player)
		THEN
		NOT DB_UND_MyconidCircle_SovereignHelpers_InDialog((ITEM)_Helper,_Player);
		
		IF
		DialogEnded(_,_ID)
		AND
		DialogGetInvolvedPlayer(_ID,1,(CHARACTER)_Player)
		AND
		DB_UND_MyconidCircle_SovereignHelpers_InDialog((ITEM)_Helper,_Player)
		THEN
		NOT DB_UND_MyconidCircle_SovereignHelpers_InDialog((ITEM)_Helper,_Player);
		//END_REGION
		
		//REGION spores offer
		
		IF
		FlagSet((FLAG)UND_MyconidCircle_SovereignOfferedSpores_593897e0-3322-4dd3-d70d-2f92e1e6db3d,_Player,_)
		THEN
		TemplateAddTo((ITEMROOT)ALCH_Solution_Grenade_SporesHaste_6008231b-9f5a-44f6-8050-14586b7626fd,_Player,2,1);
		
		
		//END_REGION
		
		//REGION journal
		
		IF
		Saw(_Player,S_UND_LoneDuergar_05c338d9-4590-4c4b-b87e-8c27ea2c2b18,0)
		AND
		DB_Players(_Player)
		THEN
		SetFlag((FLAG)UND_MyconidCircle_FoundDuergar_9ca447d6-f40a-4e47-9d1e-dbe980cb6efa,NULL_00000000-0000-0000-0000-000000000000,0);
		
		IF
		EnteredCombat(S_UND_LoneDuergar_05c338d9-4590-4c4b-b87e-8c27ea2c2b18,_ID)
		AND
		CombatGetInvolvedPlayersCount(_ID,_Num)
		AND
		_Num>0
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)UND_MyconidCircle_FoundDuergar_9ca447d6-f40a-4e47-9d1e-dbe980cb6efa);
		QuestUpdate("UND_MyconidCircle", "Found"); // even so we have QuestDef for this, triggering it right away here so Found will appear before Combat in the journal.
		QuestUpdate("UND_MyconidCircle", "Combat");
		
		IF
		DB_InRegion(_Player,(TRIGGER)S_UND_MyconidCircle_RewardOwnershipArea_398fe91d-40ef-4021-a0e9-3ace2abd87ec)
		AND
		DB_Players(_Player)
		AND
		QuestUpdateIsUnlocked(_Player,"UND_MyconidCircle","ToldReward",1)
		THEN
		QuestUpdate(_Player,"UND_MyconidCircle","GotReward");
		
		IF
		Dying(S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265)
		AND
		DB_Players(_Players)
		AND
		QuestUpdateIsUnlocked(_Players,"UND_MyconidCircle","ToldReward",0)
		THEN
		QuestUpdate(_Players,"UND_MyconidCircle","SpawDead");
		
		//END_REGION
		
		//REGION opening secret door
		IF
		FlagSet((FLAG)UND_MyconidCircle_HasSpawKey_aa1ba100-9098-498e-8062-f5b01d7d6754, _Char,_)
		AND
		DB_InRegion((CHARACTER)_Char,S_UND_MyconidCircle_UnderdarkRegion_Main_fdf3b75f-4488-449d-bced-a936b0590bf1)
		THEN
		ApplyStatus(_Char, "UND_SOVEREIGNKEY", -1.0, 1, S_UND_MyconidVillage_SpawKey_ccab604d-6f44-4687-ad89-ad159cacb413);
		
		IF
		FlagCleared((FLAG)UND_MyconidCircle_HasSpawKey_aa1ba100-9098-498e-8062-f5b01d7d6754, _Char,_)
		AND
		HasActiveStatus(_Char, "UND_SOVEREIGNKEY", 1)
		THEN
		RemoveStatus(_Char, "UND_SOVEREIGNKEY", _Char);
		
		IF
		EnteredTrigger(_Char,S_UND_MyconidCircle_UnderdarkRegion_Main_fdf3b75f-4488-449d-bced-a936b0590bf1)
		AND
		GetFlag((FLAG)UND_MyconidCircle_HasSpawKey_aa1ba100-9098-498e-8062-f5b01d7d6754, _Char,1)
		AND
		HasActiveStatus(_Char, "UND_SOVEREIGNKEY", 0)
		THEN
		ApplyStatus(_Char, "UND_SOVEREIGNKEY", -1.0, 1, S_UND_MyconidVillage_SpawKey_ccab604d-6f44-4687-ad89-ad159cacb413);
		
		IF
		LeftTrigger(_Char,S_UND_MyconidCircle_UnderdarkRegion_Main_fdf3b75f-4488-449d-bced-a936b0590bf1)
		AND
		HasActiveStatus(_Char, "UND_SOVEREIGNKEY", 1)
		THEN
		RemoveStatus(_Char, "UND_SOVEREIGNKEY", _Char);
		
		IF
		FlagSet(UND_MyconidCircle_Event_RevealHiddenCave_14a6d661-846f-466d-34d3-bac126a44061, _, _)
		THEN
		PROC_UND_MyconidCircle_OpenTreasureDoor();
		
		IF
		DB_InRegion(_Player, (TRIGGER)S_UND_MyconidCircle_DoorOpenTrigger_e3ac4b0d-d4c1-4866-9a2e-080435af4d17)
		AND
		HasActiveStatus(_Player, "UND_SOVEREIGNKEY", 1)
		THEN
		PROC_UND_MyconidCircle_OpenTreasureDoor();
		
		IF
		DestroyingBy(S_UND_MyconidCircle_HiddenCaveDoor_95edc590-7d30-41bc-8625-932b122bde86,_,_,_)
		THEN
		PlayEffect(S_UND_MyconidCircle_HiddenCaveDoor_95edc590-7d30-41bc-8625-932b122bde86,VFX_Item_Underdark_Myconid_A_Door_Dissolve_Default_01_68f68668-4696-7099-c636-c9b5840f75d3);
		SetFlag(UND_MyconidCircle_State_DestroyedDoor_aae5f31d-8143-4e79-9c87-e26f674aae21,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_TriggerUnregisterForPlayers(S_UND_MyconidCircle_DoorOpenTrigger_e3ac4b0d-d4c1-4866-9a2e-080435af4d17);
		
		IF
		UseStarted(_,(ITEM)S_UND_MyconidCircle_HiddenCaveDoor_95edc590-7d30-41bc-8625-932b122bde86) // fallback for trigger not working for some reason, event doesn't proc if players don't have a key
		THEN
		PROC_UND_MyconidCircle_OpenTreasureDoor();
		
		
		PROC
		PROC_UND_MyconidCircle_OpenTreasureDoor()
		THEN
		SetEntityEvent(S_UND_MyconidCircle_HiddenCaveDoor_95edc590-7d30-41bc-8625-932b122bde86,"StoryReveal");
		TriggerClearItemsOwner((TRIGGER)S_UND_MyconidCircle_RewardOwnershipArea_398fe91d-40ef-4021-a0e9-3ace2abd87ec);
		PROC_ClearCorpseOwner((CHARACTER)S_UND_MyconidCircle_DeadDrow_a38523e2-7630-402e-8036-17cfe5397fe0);
		ClearOwnership(S_UND_MyconidCircle_HiddenCaveDoor_95edc590-7d30-41bc-8625-932b122bde86);
		Die(S_UND_MyconidCircle_HiddenCaveDoor_95edc590-7d30-41bc-8625-932b122bde86);
		
		//END_REGION
		
		//REGION Hooks
		
		IF
		TextEvent("UND_MyconidCircle_DoorReveal")
		THEN
		SetEntityEvent((ITEM)S_UND_MyconidCircle_HiddenCaveDoor_95edc590-7d30-41bc-8625-932b122bde86,"UND_MyconidCircle_DoorReveal");
		
		IF
		TextEvent("debug_UND_MyconidCircle_CrimeCheck")
		AND
		CharacterGetCrimeRegion(S_UND_PlantDuergar_002_0028d0c1-1fb1-4c0f-baad-bf44eeae6dc1,_Region)
		THEN
		DebugText(S_UND_PlantDuergar_002_0028d0c1-1fb1-4c0f-baad-bf44eeae6dc1,_Region);
		
		IF
		TextEvent("debug_UND_MyconidCircle_CrimeCheck")
		AND
		CharacterGetCrimeRegion(S_UND_MyconidCricle_Corpses_MyconidCorpse_002_ed5fdd4b-11c0-4bd2-abec-28bdb0bac435,_Region)
		THEN
		DebugText(S_UND_MyconidCricle_Corpses_MyconidCorpse_002_ed5fdd4b-11c0-4bd2-abec-28bdb0bac435,_Region);
		
		IF
		TextEvent("MyconidCircle_SevantsRD")
		AND
		QRY_OnlyOnce_Reset("debug_UND_SevantsRD")
		AND
		DB_Players(_Player)
		AND
		QRY_OnlyOnce("debug_UND_SevantsRD")
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)UND_SporeServant_VB_9f675a2e-b082-4b79-313e-41989f0dfbfc, _Player);
		
		IF
		TextEvent("debug_UND_DuergarCheck")
		THEN
		SetFlag(UND_MyconidCircle_Quest_LoneDuergar_PermaDefeated_414e8493-33b0-25e8-c83b-a34b8f128394,NULL_00000000-0000-0000-0000-000000000000,0);
		
		IF
		TextEvent("debug_UND_DoorCheck")
		THEN
		SetFlag(UND_MyconidCircle_Event_RevealHiddenCave_14a6d661-846f-466d-34d3-bac126a44061, (CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255,0);
		
		IF
		TextEvent("debug_UND_DoorReset")
		THEN
		ClearFlag(UND_MyconidCircle_Event_RevealHiddenCave_14a6d661-846f-466d-34d3-bac126a44061, (CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255,0);
		ClearFlag(UND_MyconidCircle_Quest_LoneDuergar_PermaDefeated_414e8493-33b0-25e8-c83b-a34b8f128394,NULL_00000000-0000-0000-0000-000000000000,0);
		
		IF
		TextEvent("UND_MyconidCircle_Event_Interrupt")
		THEN
		SetEntityEvent(S_UND_Myconid_001_36445147-7484-44aa-8593-6fd1144a857d,"UND_MyconidCircle_Event_Interrupt");
		
		IF
		TextEvent("debug_UND_AgreeKillDuergars")
		AND
		GetHostCharacter(_Player)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)UND_MyconidCircle_State_GainedAccess_fb9b0ee2-a499-cef2-fd3e-d9556050ea6a);
		PROC_GlobalSetFlagAndCache((FLAG)UND_MyconidCircle_SpokeWithSovereign_155b4ce9-fd7b-445a-afbd-64cb5bf2d707);
		PROC_GlobalSetFlagAndCache((FLAG)UND_MyconidCircle_State_OfferedQuest_0dacced0-1395-c7e6-6d2c-427348c70011);
		PROC_GlobalSetFlagAndCache((FLAG)UND_MyconidCircle_AcceptedQuest_3aa48080-074b-457d-acbc-fcb970d9912b);
		QuestUpdate(_Player,"UND_BroodingSovereign","Start");
		PROC_GlobalSetFlagAndCache((FLAG)UND_MyconidCircle_BroodingSovereign_State_AcceptedHelp_642e8dfe-867b-c408-bf0b-7b2392e44472);
		PROC_GlobalSetFlagAndCache((FLAG)UND_MyconidCircle_BroodingSovereign_State_InParty_a2571718-2bbd-48f7-8ea6-d3ef4c5b5210);
		PROC_UND_BroodingSovereign_Join((CHARACTER)_Player);
		//END_REGION
		
		//REGION Spore servants handling
		// Rename after resurrect
		PROC
		PROC_CMB_SporeServant_Create(_Duergar, S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265)
		AND
		DB_UND_MyconidCircle_DuergarToResurrect(_Duergar)
		AND
		NOT DB_UND_MyconidCircle_RenamedDuergar(_Duergar)
		THEN
		SetStoryDisplayName(_Duergar, "UND_MyconidCircle_DuergarServant");
		DB_UND_MyconidCircle_RenamedDuergar(_Duergar);
		
		// We really dont want to handle Nere staying as a Spore Servant in the quest at this point
		IF
		LeftCombat(S_UND_TheDrowNere_06bf05c5-216b-4eaf-91f5-8f1dd3d57f30,_)
		AND
		NOT DB_Is_InCombat(S_UND_TheDrowNere_06bf05c5-216b-4eaf-91f5-8f1dd3d57f30, _)
		AND
		DB_CMB_SporeServantNPCFollower(S_UND_TheDrowNere_06bf05c5-216b-4eaf-91f5-8f1dd3d57f30, _)
		AND
		NOT DB_Dead(S_UND_TheDrowNere_06bf05c5-216b-4eaf-91f5-8f1dd3d57f30)
		THEN
		Die(S_UND_TheDrowNere_06bf05c5-216b-4eaf-91f5-8f1dd3d57f30, DEATHTYPE.DoT, 0);
		
		IF
		CharacterLeftParty(_Caster)
		AND
		DB_CMB_SporeServantFollower((CHARACTER)S_UND_TheDrowNere_06bf05c5-216b-4eaf-91f5-8f1dd3d57f30, _, _Caster)
		THEN
		Die(S_UND_TheDrowNere_06bf05c5-216b-4eaf-91f5-8f1dd3d57f30, DEATHTYPE.DoT, 0);
		//END_REGION
		
		//REGION Controntation with Glut
		IF
		DB_GlobalFlag(UND_MyconidCircle_Quest_LoneDuergar_PermaDefeated_414e8493-33b0-25e8-c83b-a34b8f128394)
		AND
		NOT DB_PermaDefeated((CHARACTER)S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46)
		THEN
		DB_Inclusion_NPCDialog((DIALOGRESOURCE)UND_MyconidSovereign_934d97d0-922c-7c31-05fe-054bcc630447,(CHARACTER)S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46);
		
		IF
		DB_GlobalFlag(UND_MyconidCircle_BroodingSovereign_State_PermaDefeated_da7ae2b1-fa67-0889-6003-48d6aef7271d)
		AND
		DB_GlobalFlag(UND_MyconidCircle_BroodingSovereign_Event_BetrayGlut_bc02af6d-dc65-7322-a28c-9e68dc4ea875)
		AND
		NOT DB_GlobalFlag(UND_MyconidSovereign_State_SaidKilledGlut_c6b29371-ed02-9cb5-8785-bad032d063de)
		AND
		NOT DB_Is_InCombat(S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265, _)
		THEN
		DB_SpotPlayers(S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265, "UND_MyconidSovereign_AfterKilledGlut", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		DB_SpotPlayers_TargetIgnoreCantTalk(S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265, "UND_MyconidSovereign_AfterKilledGlut");
		DB_SpotPlayers_SpotterIgnoreCantTalk(S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265, "UND_MyconidSovereign_AfterKilledGlut");
		
		PROC
		PROC_SpotPlayers_Spotted(S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265, "UND_MyconidSovereign_AfterKilledGlut", _Player)
		AND
		QRY_GLO_SelectFavouredSpeaker_SingleTag((GUIDSTRING)_Player, S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265, (TAG)AVATAR_306b9b05-1057-4770-aa17-01af21acd650, 1)
		AND
		DB_QRYRTN_GLO_SelectFavouredSpeaker(_Speaker)
		AND
		QRY_StartDialogCustomWithAvailableSpeakerInRange_TryTargetFirst(UND_MyconidSovereign_934d97d0-922c-7c31-05fe-054bcc630447,S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265,_Speaker,15.0,0,1,1,0)
		THEN
		DB_NOOP(1);
		//END_REGION
		
		//REGION Ownership
		IF
		DB_ItemOwnerShipTriggers("WLD_Main_A", _Trigger, S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265)
		THEN
		DB_ItemOwnerShipTriggersFallback(_Trigger, S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46);
		
		IF
		DB_UND_MyconidCircle_ToxicWall(_Item)
		THEN
		SetOwner(_Item, S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265);
		
		IF
		DB_UND_MyconidCircle_ToxicWall(_Item)
		AND
		DB_PermaDefeated(S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265)
		AND
		NOT DB_PermaDefeated(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46)
		THEN
		SetOwner(_Item, S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46);
		//END_REGION Ownership
		
		//REGION Happy Dancing
		// After killing lone duergar
		PROC
		PROC_GlobalFlagReactionAfterDialog(UND_MyconidCircle_MyconidSovereignReward_bba639f4-7dde-fccb-2572-f88fdaf67af5, UND_MyconidSovereign_934d97d0-922c-7c31-05fe-054bcc630447)
		AND
		NOT DB_GlobalFlag((FLAG)UND_MyconidCircle_State_Hostile_d0fe87bc-0b67-e446-1543-ac3b5e07e16d)
		AND
		DB_PartyMembers(_PartyMember)
		AND
		DB_InRegion(_PartyMember, S_UND_Underdark_SUB_b379a862-a59f-4e52-9166-23fbe0e8976e)
		AND
		NOT DB_UND_MyconidCircle_PeaceBringerCrime(_PartyMember)
		THEN
		DB_UND_MyconidCircle_PeaceBringerCrime(_PartyMember);
		PROC_CharacterRegisterCrime(_PartyMember, "UND_MyconidCircle_PeaceBringer", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		// After bringing Nere's head to Glut
		IF
		FlagSet(UND_MyconidRevenge_State_HasNereHead_2eacf3d4-e7ce-4f76-8228-954ff5bfd6a4, S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46, _)
		AND
		DB_PartyMembers(_PartyMember)
		AND
		DB_InRegion(_PartyMember, S_UND_Underdark_SUB_b379a862-a59f-4e52-9166-23fbe0e8976e)
		AND
		NOT DB_UND_MyconidCircle_PeaceBringerCrime(_PartyMember)
		THEN
		DB_UND_MyconidCircle_PeaceBringerCrime(_PartyMember);
		PROC_CharacterRegisterCrime(_PartyMember, "UND_MyconidCircle_PeaceBringer", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		LeftTrigger(_Character, S_UND_MyconidCircle_SUB_4b5cc8fc-88f4-465e-bf82-4c20b055c019)
		AND
		DB_PartyMembers(_Character)
		AND
		DB_UND_MyconidCircle_PeaceBringerCrime(_)
		AND
		NOT QRY_CheckOtherPartyMembersInTrigger(_Character, S_UND_MyconidCircle_SUB_4b5cc8fc-88f4-465e-bf82-4c20b055c019)
		AND
		DB_UND_MyconidCircle_PeaceBringerCrime(_AnyCharacter)
		THEN
		PROC_UND_MyconidCircle_EndPeaceBringerCrime(_AnyCharacter); 
		
		PROC
		PROC_LongRestOrLevelUnloading("WLD_Main_A")
		AND
		DB_UND_MyconidCircle_PeaceBringerCrime(_Character)
		THEN
		PROC_UND_MyconidCircle_EndPeaceBringerCrime(_Character); 
		
		PROC
		PROC_StateSet_Defeated(_Myconid)
		AND
		DB_UND_MyconidCircle_Myconids((CHARACTER)_Myconid)
		AND
		DB_UND_MyconidCircle_PeaceBringerCrime((CHARACTER)_Character)
		THEN
		PROC_UND_MyconidCircle_EndPeaceBringerCrime(_Character); 
		
		IF
		EnteredCombat(_Myconid, _)
		AND
		DB_UND_MyconidCircle_Myconids((CHARACTER)_Myconid)
		AND
		DB_UND_MyconidCircle_PeaceBringerCrime((CHARACTER)_Character)
		THEN
		PROC_UND_MyconidCircle_EndPeaceBringerCrime(_Character); 
		
		PROC
		PROC_UND_MyconidCircle_EndPeaceBringerCrime((CHARACTER)_Character)
		AND
		DB_UND_MyconidCircle_PeaceBringerCrime(_Character)
		THEN
		NOT DB_UND_MyconidCircle_PeaceBringerCrime(_Character);
		CharacterStopCrime(_Character, "UND_MyconidCircle_PeaceBringer", NULL_00000000-0000-0000-0000-000000000000); 
		
		// Myconid party (see UND_MyconidCircle_Dancing in anubis)
		// - after bringing Nere's head to Spaw
		IF
		FlagSet(UND_MyconidRevenge_State_HasNereHead_2eacf3d4-e7ce-4f76-8228-954ff5bfd6a4, S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265, _)
		AND
		NOT DB_GlobalFlag((FLAG)UND_MyconidCircle_State_Hostile_d0fe87bc-0b67-e446-1543-ac3b5e07e16d)
		AND
		NOT DB_GlobalFlag((FLAG)UND_BroodingSovereign_Event_MyconidsCelebrate_dc56b8e2-07e5-48a8-80ea-d71f1a8fbdb1)
		AND
		QRY_OnlyOnce("UND_BroodingSovereign_Event_MyconidsCelebrate")
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)UND_BroodingSovereign_Event_MyconidsCelebrate_dc56b8e2-07e5-48a8-80ea-d71f1a8fbdb1);
		
		// - after killing Spaw with Glut
		IF
		DialogStarted(UND_MyconidCircle_BroodingSovereign_4a1577b3-2d32-68a1-3092-e9014053b35c, _)
		AND
		DB_GlobalFlag((FLAG)UND_MyconidCircle_BroodingSovereign_Done_f80e93f9-53b5-4537-96a7-583508ba1cb8)
		AND
		NOT DB_GlobalFlag((FLAG)UND_BroodingSovereign_Event_MyconidsCelebrate_dc56b8e2-07e5-48a8-80ea-d71f1a8fbdb1)
		AND
		QRY_OnlyOnce("UND_BroodingSovereign_Event_MyconidsCelebrate")
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)UND_BroodingSovereign_Event_MyconidsCelebrate_dc56b8e2-07e5-48a8-80ea-d71f1a8fbdb1);
		
		IF
		LeftTrigger(_Character, S_UND_MyconidCircle_SUB_4b5cc8fc-88f4-465e-bf82-4c20b055c019)
		AND
		DB_PartyMembers(_Character)
		AND
		DB_GlobalFlag((FLAG)UND_BroodingSovereign_Event_MyconidsCelebrate_dc56b8e2-07e5-48a8-80ea-d71f1a8fbdb1)
		AND
		NOT QRY_CheckOtherPartyMembersInTrigger(_Character, S_UND_MyconidCircle_SUB_4b5cc8fc-88f4-465e-bf82-4c20b055c019)
		THEN
		PROC_GlobalClearFlagAndCache((FLAG)UND_BroodingSovereign_Event_MyconidsCelebrate_dc56b8e2-07e5-48a8-80ea-d71f1a8fbdb1);
		//END_REGION
		
		//REGION Paladin betraying sovereign
		IF
		DB_GlobalFlag((FLAG)UND_BroodingSovereign_State_AskedCircle_1d4839de-a9f1-72e2-2ae4-45579ad49309)
		AND
		NOT DB_GlobalFlag((FLAG)UND_BroodingSovereign_State_RefusedCircle_d0237569-b266-24c9-60f8-06eda3131892)
		AND
		NOT DB_GlobalFlag((FLAG)UND_MyconidCircle_BroodingSovereign_State_PermaDefeated_da7ae2b1-fa67-0889-6003-48d6aef7271d)
		THEN
		DB_GLO_PaladinOathbreaker_ProtectedNPCs((TAG)PALADIN_ANCIENTS_7c89622b-4194-41df-b2ff-145a5056ee49, (CHARACTER)S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265);
		DB_GLO_PaladinOathbreaker_ProtectedNPCs((TAG)PALADIN_DEVOTION_2de0a4fc-5831-4439-94d3-a7ff9b7aacf6, (CHARACTER)S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265);
		
		IF
		DB_GlobalFlag((FLAG)UND_MyconidCircle_Event_BetraySpaw_2d4dfc5d-fcd1-281d-c397-002c57a975db)
		THEN
		DB_GLO_PaladinOathbreaker_ProtectedNPCs((TAG)PALADIN_ANCIENTS_7c89622b-4194-41df-b2ff-145a5056ee49, (CHARACTER)S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265);
		DB_GLO_PaladinOathbreaker_ProtectedNPCs((TAG)PALADIN_DEVOTION_2de0a4fc-5831-4439-94d3-a7ff9b7aacf6, (CHARACTER)S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265);
		
		IF
		DB_GlobalFlag((FLAG)UND_BroodingSovereign_State_RefusedCircle_d0237569-b266-24c9-60f8-06eda3131892)
		AND
		NOT DB_GlobalFlag((FLAG)UND_MyconidCircle_Event_BetraySpaw_2d4dfc5d-fcd1-281d-c397-002c57a975db)
		THEN
		NOT DB_GLO_PaladinOathbreaker_ProtectedNPCs((TAG)PALADIN_ANCIENTS_7c89622b-4194-41df-b2ff-145a5056ee49, (CHARACTER)S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265);
		NOT DB_GLO_PaladinOathbreaker_ProtectedNPCs((TAG)PALADIN_DEVOTION_2de0a4fc-5831-4439-94d3-a7ff9b7aacf6, (CHARACTER)S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265);
		
		IF
		DB_GlobalFlag((FLAG)UND_MyconidCircle_BroodingSovereign_State_PermaDefeated_da7ae2b1-fa67-0889-6003-48d6aef7271d)
		AND
		NOT DB_GlobalFlag((FLAG)UND_MyconidCircle_Event_BetraySpaw_2d4dfc5d-fcd1-281d-c397-002c57a975db)
		THEN
		NOT DB_GLO_PaladinOathbreaker_ProtectedNPCs((TAG)PALADIN_ANCIENTS_7c89622b-4194-41df-b2ff-145a5056ee49, (CHARACTER)S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265);
		NOT DB_GLO_PaladinOathbreaker_ProtectedNPCs((TAG)PALADIN_DEVOTION_2de0a4fc-5831-4439-94d3-a7ff9b7aacf6, (CHARACTER)S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265);
		//END_REGION Paladin betraying sovereign
		
		//REGION Spore Servant VFX for Generic Crimes
		PROC
		PROC_DialogFlagSetup(_Dialog, _SporeServant, _Player, NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000)
		AND
		DB_UND_MyconidCircle_CrimeDialogs(_Dialog)
		AND
		HasActiveStatus(_SporeServant, "CREATURE_SPORE_SERVANT", 1)
		THEN
		SetFlag((FLAG)UND_MyconidCircle_State_SporeServant_9454d21e-a302-47be-8ccf-0069ec226cb8, _SporeServant);
		
		IF
		DialogEnded(_Dialog, _ID)
		AND
		DB_DialogNPCs(_ID, _SporeServant, 1)
		AND
		DB_UND_MyconidCircle_CrimeDialogs(_Dialog)
		AND
		HasActiveStatus(_SporeServant, "CREATURE_SPORE_SERVANT", 1)
		THEN
		ClearFlag((FLAG)UND_MyconidCircle_State_SporeServant_9454d21e-a302-47be-8ccf-0069ec226cb8, _SporeServant);
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(272).Title("Act1_UND_MyconidCircle_BroodingMyconid");
Goal(272)
{
	INIT
	{
		DB_Dialogs(
		     S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,
		    (DIALOGRESOURCE)UND_MyconidCircle_BroodingSovereign_4a1577b3-2d32-68a1-3092-e9014053b35c);
		
		DB_HostileToPlayerGroupCancelFlag(UND_MyconidCircle_BroodingSovereign_Done_f80e93f9-53b5-4537-96a7-583508ba1cb8, ACT1_UND_Myconids_5a3114c3-1a49-4cd8-2b4e-92f536913e30);
		
		DB_DropMutingStatussesDialog((DIALOGRESOURCE)UND_MyconidCircle_BroodingSovereign_4a1577b3-2d32-68a1-3092-e9014053b35c);
		DB_DropMutingStatussesDialog((DIALOGRESOURCE)UND_Myconid_BroodingSovereign_Raft_f6f33683-5889-e6b0-e6a9-0810856ec3ea);
		DB_DropMutingStatussesDialog((DIALOGRESOURCE)UND_MyconidCircle_BroodingSovereign_Leave_d7968940-c47a-7f64-28d6-6cd9a6c0aaca);
		
		DB_GlobalFlagReactionAfterDialog(
		    (FLAG)UND_MyconidCircle_BroodingSovereign_State_InParty_a2571718-2bbd-48f7-8ea6-d3ef4c5b5210,
		    (DIALOGRESOURCE)UND_MyconidCircle_BroodingSovereign_4a1577b3-2d32-68a1-3092-e9014053b35c);
		
		
		DB_GlobalFlagReactionAfterDialog(
		    (FLAG)UND_MyconidCircle_BroodingSovereign_State_InParty_a2571718-2bbd-48f7-8ea6-d3ef4c5b5210,
		    (DIALOGRESOURCE)UND_MyconidCircle_BroodingSovereign_Leave_d7968940-c47a-7f64-28d6-6cd9a6c0aaca);
		
		DB_GlobalFlagReactionAfterDialog(
		    (FLAG)UND_MyconidCircle_BroodingSovereign_State_InParty_a2571718-2bbd-48f7-8ea6-d3ef4c5b5210,
		    (DIALOGRESOURCE)UND_Myconid_BroodingSovereign_Raft_f6f33683-5889-e6b0-e6a9-0810856ec3ea);
		
		DB_GlobalFlagReactionAfterDialog(
		    (FLAG)UND_MyconidCircle_BroodingSovereign_Event_BetrayGlut_bc02af6d-dc65-7322-a28c-9e68dc4ea875,
		    (DIALOGRESOURCE)UND_MyconidSovereign_934d97d0-922c-7c31-05fe-054bcc630447);
		
		DB_GlobalFlagReactionAfterDialog(
		    (FLAG)UND_BroodingSovereign_State_RefusedCircle_d0237569-b266-24c9-60f8-06eda3131892,
		    (DIALOGRESOURCE)UND_MyconidCircle_BroodingSovereign_4a1577b3-2d32-68a1-3092-e9014053b35c);
		
		DB_UND_BroodingSovereign_Home((TRIGGER)S_UND_MyconidCircle_BroodingSovereign_Home_ad46b61d-35f3-40e7-a010-62a9d89b30e3);
		
		DB_UND_BroodingSpovereign_FollowingRegions((TRIGGER)S_UND_MyconidCircle_UnderdarkRegion_Main_fdf3b75f-4488-449d-bced-a936b0590bf1);
		DB_UND_BroodingSpovereign_FollowingRegions(S_UND_MyconidCircle_UnderdarkRegion_KuoToa_d5626641-d631-4983-b5a5-77d5c07c872a);
		
		DB_UND_BroodingSovereign_ExitPoints((ITEM)S_SHA_TempleAccess_StairsDownstairs_3780fa8f-9257-4998-81c4-1b28c293b26e);
		DB_UND_BroodingSovereign_ExitPoints(S_UND_Elevator_ToCaravanserai_b0bafa5b-ca00-4c94-af1c-12ced8562b4e);
		DB_UND_BroodingSovereign_ExitPoints(S_UND_FairyRings_Main_MushroomRing_ToSwamp_b71a59f4-52c6-4ed2-9d91-8c76815280e6);
		
		DB_UND_BroodingSovereign_ExitPoints_WithinUnderdark((ITEM)S_UND_EbonLake_RaftAtCave_FullRaft_a24aa852-9f72-48bc-8d94-7a92da7ca4c1);
		DB_UND_BroodingSovereign_ExitPoints_WithinUnderdark(S_UND_DuergarCamp_BoatAtCave_f350ecc8-67ab-4ffa-ba0f-2ca6a4bc9845);
		
		
		DB_GLO_DefeatCounter(S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265, "UND_BroodingSovereign_DefeatCounter_Spaw");
		DB_GLO_DefeatCounter(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46, "UND_BroodingSovereign_DefeatCounter_Glut");
		
		TriggerRegisterForCharacter(S_UND_MyconidCircle_SUB_4b5cc8fc-88f4-465e-bf82-4c20b055c019, S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46);
		
		//REGION Journal
		
		DB_UND_BroodingSovereign_LeftUNDEntries(0, "KillDuergar_LeftUND"); // before or after killing Gekh Coal - checks UND_MyconidCircle_Quest_LoneDuergar_PermaDefeated_414e8493-33b0-25e8-c83b-a34b8f128394
		DB_UND_BroodingSovereign_LeftUNDEntries(1, "AfterKill_LeftUND");
		
		DB_QuestDef_State(UND_MyconidCircle_Quest_LoneDuergar_PermaDefeated_414e8493-33b0-25e8-c83b-a34b8f128394, "UND_BroodingSovereign", "KilledDuergar");
			//These DB_QuestDef_State_ConditionalFlag are cleared when the lone duergar is defeated
		DB_QuestDef_State_ConditionalFlag(UND_MyconidCircle_BroodingSovereign_State_InParty_a2571718-2bbd-48f7-8ea6-d3ef4c5b5210, "UND_BroodingSovereign", "RefusedThenAccepted", 1, UND_MyconidCircle_State_DeclinedBroodingSovereign_a8d48927-5819-08af-fc29-502c5751e3c9);
		DB_QuestDef_State_ConditionalFlag(UND_MyconidCircle_BroodingSovereign_State_InParty_a2571718-2bbd-48f7-8ea6-d3ef4c5b5210, "UND_BroodingSovereign", "AcceptedJoin", 0, UND_MyconidCircle_State_DeclinedBroodingSovereign_a8d48927-5819-08af-fc29-502c5751e3c9);
		
		DB_UND_BroodingSovereign_CantReachSuspectibleEntries("RefusedEscort");
		DB_UND_BroodingSovereign_CantReachSuspectibleEntries("AcceptedEscort");
		DB_UND_BroodingSovereign_CantReachSuspectibleEntries("AfterKill_LeftUND");
		
		DB_QuestDef_State(UND_MyconidCircle_BroodingSovereign_State_PermaDefeated_da7ae2b1-fa67-0889-6003-48d6aef7271d, "UND_BroodingSovereign", "GlutDead");
		DB_QuestDef_State((FLAG)Act2_PointOfNoReturnReached_a3155f30-b8f3-4db5-ac21-d3036f4426e3, "UND_BroodingSovereign", "Left");
		//END_REGION
		
		
		DB_DeadOnceFlag((CHARACTER)S_UND_LoneDuergar_05c338d9-4590-4c4b-b87e-8c27ea2c2b18,UND_MyconidCircle_BroodingSovereign_State_LoneDuergar_IsDead_5f622802-d6d9-48df-8cb2-8b5a3ec573c2);
		DB_PermaDefeatedFlag(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,UND_MyconidCircle_BroodingSovereign_State_PermaDefeated_da7ae2b1-fa67-0889-6003-48d6aef7271d);
	}
	KB
	{
		//REGION Glut grows more powerful after confirming that the duegar has been wiped out.
		IF
		FlagSet((FLAG)UND_BroodingSovereign_Event_Enlarged_cab76d90-68b1-40d9-95ce-74274c425d85, NULL_00000000-0000-0000-0000-000000000000,_)
		THEN
		SetIsBoss(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,1);
		ApplyStatus(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46, "UND_GLUT_ENRAGE", -1.0, 0, S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46);
		//END_REGION
		
		//REGION init
		IF
		DB_UND_BroodingSpovereign_FollowingRegions(_Trigger)
		THEN
		TriggerRegisterForCharacter(_Trigger,S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46);
		//END_REGION
		
		//REGION Following
		
		QRY
		QRY_UND_BroodingSovereign_StillUND((GUIDSTRING)_Waypoint)
		AND
		DB_UND_BroodingSpovereign_FollowingRegions(_Trigger)
		AND
		GetPosition(_Waypoint,_X,_Y,_Z)
		AND
		PositionIsInTrigger(_X,_Y,_Z,_Trigger,1)
		THEN
		DB_NOOP(1);
		
		IF
		DB_UND_BroodingSovereign_Leader(_Player)
		AND
		DB_UND_BroodingSovereign_Leader(_Player2)
		AND
		_Player!=_Player2
		THEN
		NOT DB_UND_BroodingSovereign_Leader(_Player2);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog(
		    UND_MyconidCircle_BroodingSovereign_State_InParty_a2571718-2bbd-48f7-8ea6-d3ef4c5b5210,
		    _, _Id)
		AND
		NOT DB_UND_BroodingSoveign_PrepareLeave_Leader(_)
		AND
		DialogGetInvolvedPlayer(_Id,1,_Player)
		THEN
		PROC_UND_BroodingSovereign_Join((CHARACTER)_Player);
		
		//if he rejoins during LeaveDialog he rejoins the same player
		PROC
		PROC_GlobalFlagReactionAfterDialog(
		    UND_MyconidCircle_BroodingSovereign_State_InParty_a2571718-2bbd-48f7-8ea6-d3ef4c5b5210,
		    _, _Id)
		AND
		DB_UND_BroodingSoveign_PrepareLeave_Leader(_Player)
		THEN
		PROC_UND_BroodingSovereign_Join((CHARACTER)_Player);
		
		PROC
		PROC_UND_BroodingSovereign_Join((CHARACTER)_Player)
		THEN
		AddPartyFollower(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,(CHARACTER)_Player);
		
		PROC 
		PROC_UND_BroodingSovereign_Join((CHARACTER)_Player)
		AND
		NOT DB_UND_BroodingSovereign_Leader((CHARACTER)_Player)
		THEN
		DB_UND_BroodingSovereign_Leader((CHARACTER)_Player);
		
		PROC
		PROC_UND_BroodingSovereign_Join((CHARACTER)_Player)
		AND
		DB_UND_NecroMushrooms_Corpse(_Corpse,S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46)
		AND
		NOT DB_PermaDefeated(_Corpse)
		THEN
		AddPartyFollower(_Corpse,(CHARACTER)_Player);
		
		PROC
		PROC_UND_BroodingSovereign_LeaveDialog((DIALOGRESOURCE)_Dialog,(CHARACTER)_Player,(CHARACTER)_Leader)
		AND
		QRY_StartDialog_Fixed(_Dialog,(CHARACTER)S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,_Player)
		THEN
		DB_UND_BroodingSoveign_PrepareLeave_Leader((CHARACTER)_Leader);
		
		IF
		DB_PermaDefeated(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46)
		AND
		DB_UND_BroodingSovereign_Leader(_Player)
		THEN
		PROC_UND_BroodingSovereign_GoHome(_Player);
		
		IF
		DB_PermaDefeated(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46)
		AND
		DB_UND_NecroMushrooms_Corpse(_Corpse,S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46)
		THEN
		NOT DB_UND_NecroMushrooms_Corpse(_Corpse,S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46);
		
		PROC
		PROC_GLO_PostReassignFollowerHook(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46, (CHARACTER)_OldLeader, (CHARACTER)_NewLeader)
		THEN
		DB_UND_BroodingSovereign_Leader(_NewLeader); // will replace DB (singleton) and register new leader for triggers
		PROC_UND_BroodingSovereign_Triggers(_OldLeader, 0); // manually unregister old leader from triggers
		
		IF
		FlagCleared(UND_MyconidCircle_BroodingSovereign_State_InParty_a2571718-2bbd-48f7-8ea6-d3ef4c5b5210,_,_)
		AND
		DB_UND_BroodingSovereign_Leader(_Player)
		THEN
		PROC_UND_BroodingSovereign_GoHome((CHARACTER)_Player);
		
		PROC
		PROC_UND_BroodingSovereign_GoHome((CHARACTER)_Player)
		THEN
		ClearFlag(
		    UND_MyconidCircle_BroodingSovereign_State_InParty_a2571718-2bbd-48f7-8ea6-d3ef4c5b5210,
		    _Player, 0);
		NOT DB_UND_BroodingSovereign_Leader(_Player);
		PROC_RemovePartyFollower(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46);
		PROC_UND_BroodingSovereign_Triggers(_Player,0);
		ClearFlag(
		    (FLAG)UND_MyconidCircle_BroodingSovereign_Event_Leave_60785a26-f4dd-4353-8963-4b44283bb7d3,
		    NULL_00000000-0000-0000-0000-000000000000,0);
		
		PROC
		PROC_UND_BroodingSovereign_GoHome((CHARACTER)_Player)
		AND
		DB_UND_NecroMushrooms_Corpse(_Corpse,S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46)
		AND
		IsPartyMember(_Corpse,1,1)
		THEN
		PROC_RemovePartyFollower(_Corpse);
		
		IF
		DB_UND_BroodingSovereign_Leader(_Player)
		THEN
		PROC_UND_BroodingSovereign_Triggers(_Player,1);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog(
		    (FLAG)UND_MyconidCircle_BroodingSovereign_Event_Leave_60785a26-f4dd-4353-8963-4b44283bb7d3)
		AND
		DB_UND_BroodingSovereign_Leader((CHARACTER)_Player)
		THEN
		PROC_UND_BroodingSovereign_GoHome(_Player);
		
		IF
		EnteredTrigger(_Player,(TRIGGER)S_UND_BroodingSovereign_LeaveAreaLift_602be009-55bb-4b2a-a086-339169e3d4fd)
		AND
		IsPartyFollower(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,1)
		AND
		QRY_StartDialog_Fixed(
		    (DIALOGRESOURCE)UND_MyconidCircle_BroodingSovereign_Leave_d7968940-c47a-7f64-28d6-6cd9a6c0aaca,
		    S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,
		    _Player)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_UND_BroodingSovereign_Triggers((CHARACTER)_Player,1) // 0 to unregister, 1 to register
		THEN
		TriggerRegisterForCharacter(
		    S_UND_BroodingSovereign_LeaveAreaLift_602be009-55bb-4b2a-a086-339169e3d4fd,
		    _Player);
		
		PROC
		PROC_UND_BroodingSovereign_Triggers((CHARACTER)_Player,0) // 0 to unregister, 1 to register
		THEN
		TriggerUnregisterForCharacter(
		    S_UND_BroodingSovereign_LeaveAreaLift_602be009-55bb-4b2a-a086-339169e3d4fd,
		    _Player);
		
		
		PROC
		PROC_UND_BroodingSovereign_Triggers((CHARACTER)_Player,1) // 0 to unregister, 1 to register
		AND
		DB_UND_BroodingSpovereign_FollowingRegions(_Trigger)
		THEN
		TriggerRegisterForCharacter(
		    _Trigger,
		    _Player);
		
		PROC
		PROC_UND_BroodingSovereign_Triggers((CHARACTER)_Player,0) // 0 to unregister, 1 to register
		AND
		DB_UND_BroodingSpovereign_FollowingRegions(_Trigger)
		THEN
		TriggerUnregisterForCharacter(
		    _Trigger,
		    _Player);
		
		
		
		//just in case
		IF
		LeftTrigger(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,_)
		AND
		NOT QRY_UND_BroodingSovereign_StillUND(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46)
		AND
		DB_UND_BroodingSovereign_Leader((CHARACTER)_Player)
		THEN
		PROC_UND_BroodingSovereign_QuestUpdate_LeftUND(_Player);
		PROC_UND_BroodingSovereign_GoHome(_Player);
		
		//END_REGION
		
		//REGION Corpses
		IF
		UsingSpellOnTarget(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,(CHARACTER)_Corpse,"Target_AnimatingSpores",_,_,_)
		THEN
		DB_UND_NecroMushrooms_Corpse(_Corpse,S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46);
		
		
		IF
		DB_UND_NecroMushrooms_Corpse(_Corpse,S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46)
		AND
		DB_GlobalFlag(UND_MyconidCircle_BroodingSovereign_State_InParty_a2571718-2bbd-48f7-8ea6-d3ef4c5b5210) // making sure that this AD is played only when BroodingMyconid is in the party.
		AND
		QRY_OnlyOnce("UND_BroodyngSovereign_CorpseAD")
		THEN
		PROC_TryStartAD(
		    (DIALOGRESOURCE)UND_BroodingMyconid_AD_Resurrecting_573eb343-94fc-676e-699b-371c849659a8,
		    S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46);
		
		IF
		EntityEvent((CHARACTER)_Corpse,"UND_NecroMushrooms_Event_CorpseResurrected")
		AND
		DB_UND_NecroMushrooms_Corpse(_Corpse,S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46)
		AND
		DB_UND_BroodingSovereign_Leader(_Player)
		AND
		IsInTrigger(_Player,S_UND_BroodingSovereign_FollowingRegion_fdf3b75f-4488-449d-bced-a936b0590bf1,1)
		THEN
		AddPartyFollower(_Corpse,_Player);
		
		//Actual resurrections are done in Act1_UND_MyconidCircle_NecroMushrooms to have both Sovereigns revive consistenly
		//END_REGION
		
		//REGION first dialog
		
		
		IF
		DialogEnded(UND_MyconidSovereign_934d97d0-922c-7c31-05fe-054bcc630447,_ID)
		AND
		DB_GlobalFlag((FLAG)UND_MyconidCircle_AcceptedQuest_3aa48080-074b-457d-acbc-fcb970d9912b)
		AND
		NOT DB_GlobalFlag(UND_MyconidCircle_BroodingSovereign_State_AcceptedHelp_642e8dfe-867b-c408-bf0b-7b2392e44472)
		THEN
		DB_SpotPlayers(
			(CHARACTER)S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,
			"UND_MyconidCircle_BroodingSovereignSpot",
			NULL_00000000-0000-0000-0000-000000000000,
			(FLAG)UND_MyconidCircle_BroodingSovereign_Spoke_b22db7e4-ee0f-4621-a242-c6f5cfbae1ce);
		
		
		PROC
		PROC_SpotPlayers_Spotted(_,"UND_MyconidCircle_BroodingSovereignSpot",_Player)
		AND
		DB_Players(_Player)
		AND
		QRY_StartDialog(
			(DIALOGRESOURCE)UND_MyconidCircle_BroodingSovereign_4a1577b3-2d32-68a1-3092-e9014053b35c,
			(CHARACTER)S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,_Player)
		THEN
		DB_NOOP(1);
		
		IF
		DialogStarted(UND_MyconidCircle_BroodingSovereign_4a1577b3-2d32-68a1-3092-e9014053b35c,_)
		THEN
		SetFlag(UND_MyconidCircle_BroodingSovereign_Spoke_b22db7e4-ee0f-4621-a242-c6f5cfbae1ce,NULL_00000000-0000-0000-0000-000000000000,0);
		//END_REGION
		
		//REGION Reacting to Lone Duergars death
		
		//Regular situation - Gekh dies near his initial position
		
		PROC
		PROC_DialogFlagSetup(UND_MyconidCircle_BroodingSovereign_4a1577b3-2d32-68a1-3092-e9014053b35c,S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,(CHARACTER)_Player)
		AND
		DB_GlobalFlag(UND_MyconidCircle_Quest_LoneDuergar_PermaDefeated_414e8493-33b0-25e8-c83b-a34b8f128394)
		AND
		DB_UND_BroodingSovereign_Leader(_Player)
		AND
		IsInTrigger(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,S_UND_BroodingSovereign_LoneDuergarNoticeArea_1370c6a0-d6e6-4ca7-a64c-fc11829e6138,1)
		THEN
		SetFlag((FLAG)UND_MyconidCircle_BroodingSovereign_State_SawDuergar_3ed49391-a703-466c-819e-1c1a5c10c6d9,NULL_00000000-0000-0000-0000-000000000000,0);
		
		//Edge case for when lone duergar is pulled away
		
		
		IF
		EnteredCombat(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,_Guid)
		AND
		NOT DB_UND_BroodingSovereign_DuergarFight(_Guid)
		AND
		CombatGetGuidFor(S_UND_LoneDuergar_05c338d9-4590-4c4b-b87e-8c27ea2c2b18,_Guid2)
		AND 
		_Guid==_Guid2
		THEN
		DB_UND_BroodingSovereign_DuergarFight(_Guid);
		
		IF
		EnteredCombat(S_UND_LoneDuergar_05c338d9-4590-4c4b-b87e-8c27ea2c2b18,_Guid)
		AND
		NOT DB_UND_BroodingSovereign_DuergarFight(_Guid)
		AND
		CombatGetGuidFor(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,_Guid2)
		AND 
		_Guid==_Guid2
		THEN
		DB_UND_BroodingSovereign_DuergarFight(_Guid);
		
		PROC
		PROC_StateSet_Defeated(S_UND_LoneDuergar_05c338d9-4590-4c4b-b87e-8c27ea2c2b18)
		AND
		CombatGetGuidFor(S_UND_LoneDuergar_05c338d9-4590-4c4b-b87e-8c27ea2c2b18,_Guid)
		AND
		DB_UND_BroodingSovereign_DuergarFight(_Guid)
		THEN
		DB_UND_BroodingSovereign_DuergarFight_PrepareFlag(_Guid);
		NOT DB_UND_BroodingSovereign_DuergarFight(_Guid);
		
		IF
		CombatEnded(_Guid)
		AND
		DB_UND_BroodingSovereign_DuergarFight_PrepareFlag(_Guid)
		THEN
		NOT DB_UND_BroodingSovereign_DuergarFight_PrepareFlag(_Guid);
		SetFlag((FLAG)UND_MyconidCircle_BroodingSovereign_State_SawDuergar_3ed49391-a703-466c-819e-1c1a5c10c6d9,NULL_00000000-0000-0000-0000-000000000000,0);
		
		IF
		LeftCombat(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,_Guid)
		AND
		DB_UND_BroodingSovereign_DuergarFight(_Guid)
		THEN
		NOT DB_UND_BroodingSovereign_DuergarFight(_Guid);
		
		IF
		LeftCombat(S_UND_LoneDuergar_05c338d9-4590-4c4b-b87e-8c27ea2c2b18,_Guid)
		AND
		DB_UND_BroodingSovereign_DuergarFight(_Guid)
		THEN
		NOT DB_UND_BroodingSovereign_DuergarFight(_Guid);
		
		IF
		FlagSet(UND_MyconidCircle_Quest_LoneDuergar_PermaDefeated_414e8493-33b0-25e8-c83b-a34b8f128394,_,_)
		AND
		GetDistanceTo(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,S_UND_LoneDuergar_05c338d9-4590-4c4b-b87e-8c27ea2c2b18,_dist)
		AND
		_dist<=20.0
		THEN
		SetFlag((FLAG)UND_MyconidCircle_BroodingSovereign_State_SawDuergar_3ed49391-a703-466c-819e-1c1a5c10c6d9,NULL_00000000-0000-0000-0000-000000000000,0);
		
		IF
		Saw((CHARACTER)S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,(CHARACTER)S_UND_LoneDuergar_05c338d9-4590-4c4b-b87e-8c27ea2c2b18,_)
		AND
		DB_GlobalFlag(UND_MyconidCircle_Quest_LoneDuergar_PermaDefeated_414e8493-33b0-25e8-c83b-a34b8f128394)
		THEN
		SetFlag((FLAG)UND_MyconidCircle_BroodingSovereign_State_SawDuergar_3ed49391-a703-466c-819e-1c1a5c10c6d9,NULL_00000000-0000-0000-0000-000000000000,0);
		
		//edge-case: becomes impossible to show the body to Glut
		//TBD: it might be safer to use the trigger S_UND_BroodingSovereign_LoneDuergarNoticeArea_1370c6a0-d6e6-4ca7-a64c-fc11829e6138
			// if LoneDuergar leaves this trigger, then it's 'Can't Reach' and Glut automatically 'sees' it. 
		IF
		EnteredChasm(S_UND_LoneDuergar_05c338d9-4590-4c4b-b87e-8c27ea2c2b18, _, _, _, _, _) // reported in #gen-help that we currently don't get this event when a dead character enters a chasm
		THEN
		SetFlag((FLAG)UND_MyconidCircle_BroodingSovereign_State_SawDuergar_3ed49391-a703-466c-819e-1c1a5c10c6d9,NULL_00000000-0000-0000-0000-000000000000,0);
		SetFlag(UND_MyconidCircle_BroodingSovereign_State_CantReachDuergar_68069e1d-a9e5-4fdd-8664-22942b1afa96,NULL_00000000-0000-0000-0000-000000000000,0);
		
		PROC
		PROC_Surrender_Fled(S_UND_LoneDuergar_05c338d9-4590-4c4b-b87e-8c27ea2c2b18)
		THEN
		SetFlag((FLAG)UND_MyconidCircle_BroodingSovereign_State_SawDuergar_3ed49391-a703-466c-819e-1c1a5c10c6d9,NULL_00000000-0000-0000-0000-000000000000,0);
		SetFlag(UND_MyconidCircle_BroodingSovereign_State_CantReachDuergar_68069e1d-a9e5-4fdd-8664-22942b1afa96,NULL_00000000-0000-0000-0000-000000000000,0);
		
		IF
		DB_IronFlasked(S_UND_LoneDuergar_05c338d9-4590-4c4b-b87e-8c27ea2c2b18)
		THEN
		SetFlag((FLAG)UND_MyconidCircle_BroodingSovereign_State_SawDuergar_3ed49391-a703-466c-819e-1c1a5c10c6d9,NULL_00000000-0000-0000-0000-000000000000,0);
		SetFlag(UND_MyconidCircle_BroodingSovereign_State_CantReachDuergar_68069e1d-a9e5-4fdd-8664-22942b1afa96,NULL_00000000-0000-0000-0000-000000000000,0);
		
		//dialog with glut
		IF
		FlagSet((FLAG)UND_MyconidCircle_BroodingSovereign_State_SawDuergar_3ed49391-a703-466c-819e-1c1a5c10c6d9,_,_)
		AND
		DB_UND_BroodingSovereign_Leader(_Player)
		AND
		IsInCombat(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,0)
		AND
		QRY_OnlyOnce("UND_BroodingSovereign_DuergarDead_Reaction")
		THEN
		PROC_TryStartAD(UND_BroodingMyconid_AD_DuergarDead_0e3153d0-7539-3e6f-9e8d-c442f877fba6, S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46);
		
		IF
		LeftCombat(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,_)
		AND
		DB_GlobalFlag((FLAG)UND_MyconidCircle_BroodingSovereign_State_SawDuergar_3ed49391-a703-466c-819e-1c1a5c10c6d9)
		AND
		QRY_OnlyOnce("UND_BroodingSovereign_DuergarDead_Reaction")
		AND
		DB_UND_BroodingSovereign_Leader(_Player)
		THEN
		PROC_TryStartAD(UND_BroodingMyconid_AD_DuergarDead_0e3153d0-7539-3e6f-9e8d-c442f877fba6, S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46);
		
		PROC
		PROC_DialogFlagSetup(UND_MyconidCircle_BroodingSovereign_4a1577b3-2d32-68a1-3092-e9014053b35c,S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,(CHARACTER)_Player)
		AND
		DB_GlobalFlag(UND_MyconidCircle_Quest_LoneDuergar_PermaDefeated_414e8493-33b0-25e8-c83b-a34b8f128394)
		AND
		DB_UND_BroodingSovereign_Leader(_Player)
		AND
		GetDistanceTo(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,S_UND_LoneDuergar_05c338d9-4590-4c4b-b87e-8c27ea2c2b18,_dist)
		AND
		_dist<=25.0
		THEN
		SetFlag((FLAG)UND_MyconidCircle_BroodingSovereign_State_SawDuergar_3ed49391-a703-466c-819e-1c1a5c10c6d9,NULL_00000000-0000-0000-0000-000000000000,0);
		//END_REGION
		
		//REGION Killing Circle
		//Wait until players actually attack circle - otherwise it's confusing
		IF
		AttackedBy(_Defender,_Player,_,_,_,_,_)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		DB_GlobalFlag((FLAG)UND_MyconidCircle_BroodingSovereign_Quest_AcceptedCircleWipe_279e0906-6562-4542-9799-8ca79175f2be)
		AND
		NOT DB_GlobalFlag((FLAG)UND_MyconidCircle_BroodingSovereign_Done_f80e93f9-53b5-4537-96a7-583508ba1cb8)
		AND
		DB_UND_MyconidCircle_Myconids((CHARACTER)_Defender)
		AND
		_Defender != S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46
		THEN
		SetFaction(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,ACT1_UND_BroodingSovereign_CircleEnemy_60b2534f-a05e-4768-8410-14d988201c5b);
		PROC_SetRelationToPlayers((FACTION)ACT1_UND_Myconids_5a3114c3-1a49-4cd8-2b4e-92f536913e30,0);
		
		IF
		AttackedBy(_Defender,_Player,_,_,_,_,_)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		DB_UND_MyconidCircle_DuergarSlaves((CHARACTER)_Defender) 
		AND
		DB_GlobalFlag((FLAG)UND_MyconidCircle_BroodingSovereign_Quest_AcceptedCircleWipe_279e0906-6562-4542-9799-8ca79175f2be)
		AND
		NOT DB_GlobalFlag((FLAG)UND_MyconidCircle_BroodingSovereign_Done_f80e93f9-53b5-4537-96a7-583508ba1cb8)
		THEN
		SetFaction(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,ACT1_UND_BroodingSovereign_CircleEnemy_60b2534f-a05e-4768-8410-14d988201c5b);
		PROC_SetRelationToPlayers((FACTION)ACT1_UND_Myconids_5a3114c3-1a49-4cd8-2b4e-92f536913e30,0);
		
		IF
		FlagSet((FLAG)UND_MyconidCircle_Event_CombatWithPlayers_0f8aee24-7971-4de4-9294-9ab91d63bb3c,_,_)
		AND
		DB_GlobalFlag((FLAG)UND_MyconidCircle_BroodingSovereign_Quest_AcceptedCircleWipe_279e0906-6562-4542-9799-8ca79175f2be)
		AND
		NOT DB_GlobalFlag((FLAG)UND_MyconidCircle_BroodingSovereign_Done_f80e93f9-53b5-4537-96a7-583508ba1cb8)
		THEN
		SetFaction(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,ACT1_UND_BroodingSovereign_CircleEnemy_60b2534f-a05e-4768-8410-14d988201c5b);
		
		// Killing the sovereign
		IF
		DB_PermaDefeated((CHARACTER)S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265)
		AND
		NOT DB_PermaDefeated((CHARACTER)S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46)
		AND
		DB_GlobalFlag(UND_MyconidCircle_BroodingSovereign_Quest_AcceptedCircleWipe_279e0906-6562-4542-9799-8ca79175f2be)
		AND
		DB_InRegion((CHARACTER)S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46, (TRIGGER)S_UND_MyconidCircle_SUB_4b5cc8fc-88f4-465e-bf82-4c20b055c019)
		THEN
		SetFlag(UND_MyconidCircle_BroodingSovereign_Done_f80e93f9-53b5-4537-96a7-583508ba1cb8,NULL_00000000-0000-0000-0000-000000000000,0);
		
		IF
		DB_GlobalFlag(UND_MyconidCircle_BroodingSovereign_Done_f80e93f9-53b5-4537-96a7-583508ba1cb8)
		THEN
		SetFaction(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,(FACTION)ACT1_UND_Myconids_BroodingMyconid_d12b2d24-f7fe-43f6-b267-30082c324400);
		PROC_SetRelationToPlayers((FACTION)ACT1_UND_Myconids_5a3114c3-1a49-4cd8-2b4e-92f536913e30,50);
		ClearFlag(UND_MyconidCircle_BroodingSovereign_State_InParty_a2571718-2bbd-48f7-8ea6-d3ef4c5b5210, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		DB_GlobalFlag(UND_MyconidCircle_BroodingSovereign_Done_f80e93f9-53b5-4537-96a7-583508ba1cb8)
		AND
		NOT DB_PartyMembers(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46)
		AND
		QRY_OnlyOnce("UND_BroodingSovereign_CelebrationSpotting_OnlyOnce")
		THEN
		DB_SpotPlayers((CHARACTER)S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46, "UND_BroodingSovereign_CelebrationSpotting", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		
		// betraying Glut
		PROC
		PROC_GlobalFlagReactionAfterDialog(UND_MyconidCircle_BroodingSovereign_Event_BetrayGlut_bc02af6d-dc65-7322-a28c-9e68dc4ea875, UND_MyconidSovereign_934d97d0-922c-7c31-05fe-054bcc630447)
		THEN
		SetFaction(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,ACT1_UND_BroodingSovereign_CircleEnemy_60b2534f-a05e-4768-8410-14d988201c5b);
		
		IF
		BaseFactionChanged(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,_,ACT1_UND_BroodingSovereign_CircleEnemy_60b2534f-a05e-4768-8410-14d988201c5b)
		AND
		DB_GlobalFlag(UND_MyconidCircle_BroodingSovereign_Event_BetrayGlut_bc02af6d-dc65-7322-a28c-9e68dc4ea875)
		THEN
		PROC_SetRelationToPlayers(ACT1_UND_BroodingSovereign_CircleEnemy_60b2534f-a05e-4768-8410-14d988201c5b,0);
		
		// refuse helping Glut
		PROC
		PROC_GlobalFlagReactionAfterDialog(UND_BroodingSovereign_State_RefusedCircle_d0237569-b266-24c9-60f8-06eda3131892, UND_MyconidCircle_BroodingSovereign_4a1577b3-2d32-68a1-3092-e9014053b35c)
		AND
		NOT DB_GlobalFlag(UND_MyconidCircle_BroodingSovereign_Event_BetrayGlut_bc02af6d-dc65-7322-a28c-9e68dc4ea875)
		THEN
		SetFaction(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46, Act1_UND_BroodingSovereign_Refused_25b89bcf-68ce-4327-820f-780d714b398f);
		//END_REGION
		
		//REGION waypoints and preventing players from leaving und
		//Glut will teleport with players to waypoints in UND
		
		PROC
		PROC_WaypointTeleported((CHARACTER)_Player,(TRIGGER)_)
		AND
		DB_UND_BroodingSovereign_Leader((CHARACTER)_Player)
		THEN
		DB_UND_BroodingSovereign_WaypointWait((CHARACTER)_Player);
		TimerLaunch("UND_BroodingSovereign_Waypoint_Teleport",500);
		
		IF
		TimerFinished("UND_BroodingSovereign_Waypoint_Teleport")
		AND
		DB_UND_BroodingSovereign_WaypointWait((CHARACTER)_Player)
		AND
		QRY_UND_BroodingSovereign_StillUND((CHARACTER)_Player)
		THEN
		TeleportTo(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,_Player,"UND_BroodingSovereign_Event_WaypointTeleport");
		
		IF
		TimerFinished("UND_BroodingSovereign_Waypoint_Teleport")
		AND
		DB_UND_BroodingSovereign_WaypointWait((CHARACTER)_Player)
		THEN
		NOT DB_UND_BroodingSovereign_WaypointWait((CHARACTER)_Player);
		
		//prevent players from leaving underdark
		//custom dialog for raft
		PROC
		PROC_BlockUseOfItem(_Player, _Item)
		AND
		DB_UND_BroodingSovereign_ExitPoints_WithinUnderdark(_Item)
		AND
		DB_GlobalFlag(UND_MyconidCircle_BroodingSovereign_State_InParty_a2571718-2bbd-48f7-8ea6-d3ef4c5b5210)
		AND
		CharacterGetOwner(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46, _Leader)
		AND
		QRY_UND_BroodingSovereign_NeedsToStopPlayer(_Player,_Leader)
		THEN
		DB_CustomUseItemResponse(_Player,_Item,0);
		PROC_UND_BroodingSovereign_GoHome(_Leader);
		PROC_UND_BroodingSovereign_LeaveDialog(UND_Myconid_BroodingSovereign_Raft_f6f33683-5889-e6b0-e6a9-0810856ec3ea,_Player,_Leader);
		
		//multi-purpose dialog for other cases
		PROC
		PROC_BlockUseOfItem(_Player,_Item)
		AND
		DB_UND_BroodingSovereign_ExitPoints(_Item)
		AND
		DB_GlobalFlag(UND_MyconidCircle_BroodingSovereign_State_InParty_a2571718-2bbd-48f7-8ea6-d3ef4c5b5210)
		AND
		CharacterGetOwner(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46, _Leader)
		AND
		QRY_UND_BroodingSovereign_NeedsToStopPlayer(_Player,_Leader)
		THEN
		DB_CustomUseItemResponse(_Player,_Item,0);
		PROC_UND_BroodingSovereign_GoHome(_Leader);
		PROC_UND_BroodingSovereign_LeaveDialog(UND_MyconidCircle_BroodingSovereign_Leave_d7968940-c47a-7f64-28d6-6cd9a6c0aaca,_Player,_Leader);
		
		// If Waypoint user is actually the BroodingSovereign humself, or another one of his Leader's minions.
		QRY
		QRY_GLO_BlockTeleportToWaypoint(_Player,_Waypoint)
		AND
		DB_GlobalFlag(UND_MyconidCircle_BroodingSovereign_State_InParty_a2571718-2bbd-48f7-8ea6-d3ef4c5b5210)
		AND
		NOT QRY_UND_BroodingSovereign_StillUND((TRIGGER)_Waypoint)
		AND
		CharacterGetOwner(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46, _Leader)
		AND
		QRY_UND_BroodingSovereign_HimselfOrLeadersMinion(_Player, _Leader)
		AND
		QRY_UND_BroodingSovereign_NeedsToStopPlayer(NULL_00000000-0000-0000-0000-000000000000, (CHARACTER)_Leader)
		THEN
		PROC_UND_BroodingSovereign_GoHome(_Leader);
		PROC_UND_BroodingSovereign_LeaveDialog(UND_MyconidCircle_BroodingSovereign_Leave_d7968940-c47a-7f64-28d6-6cd9a6c0aaca,_Leader,_Leader);
		
		//can't use QRY_REALLY_BlockFastTravel because I want sovereign to teleport around UND, but not out
		QRY
		QRY_GLO_BlockTeleportToWaypoint(_Player,_Waypoint)
		AND
		DB_GlobalFlag(UND_MyconidCircle_BroodingSovereign_State_InParty_a2571718-2bbd-48f7-8ea6-d3ef4c5b5210)
		AND
		NOT QRY_UND_BroodingSovereign_StillUND((TRIGGER)_Waypoint)
		AND
		CharacterGetOwner(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46, _Leader)
		AND
		NOT QRY_UND_BroodingSovereign_HimselfOrLeadersMinion(_Player, _Leader)
		AND
		QRY_UND_BroodingSovereign_NeedsToStopPlayer((CHARACTER)_Player, (CHARACTER)_Leader)
		THEN
		PROC_UND_BroodingSovereign_GoHome(_Leader);
		PROC_UND_BroodingSovereign_LeaveDialog(UND_MyconidCircle_BroodingSovereign_Leave_d7968940-c47a-7f64-28d6-6cd9a6c0aaca,_Player,_Leader);
		
		
		
		// Check to make sure its not himself or his own minion
		QRY
		QRY_UND_BroodingSovereign_HimselfOrLeadersMinion((CHARACTER)S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46, (CHARACTER)_Leader)
		THEN
		DB_NOOP(1);
		
		// If its another of his leader's minions.
		QRY
		QRY_UND_BroodingSovereign_HimselfOrLeadersMinion((CHARACTER)_Player, (CHARACTER)_GlutLeader)
		AND
		CharacterGetOwner(_Player, _PlayerLeader)
		AND
		_GlutLeader == _PlayerLeader
		THEN
		DB_NOOP(1);
		
		
		IF
		TeleportedToCamp(_Leader)
		AND
		DB_GlobalFlag(UND_MyconidCircle_BroodingSovereign_State_InParty_a2571718-2bbd-48f7-8ea6-d3ef4c5b5210)
		AND
		CharacterGetOwner(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46, _Leader)
		THEN
		SetFlag(UND_MyconidCircle_BroodingSovereign_State_WaitingForParty_acaea6bf-9bf1-436f-ab41-c2f77ded4a41,NULL_00000000-0000-0000-0000-000000000000,0);
		DB_UND_BroodingSovereign_WaitingForLeader(_Leader);
		PROC_UND_BroodingSovereign_GoHome(_Leader);
		
		IF
		TeleportedFromCamp(_Player)
		AND
		DB_GlobalFlag(UND_MyconidCircle_BroodingSovereign_State_WaitingForParty_acaea6bf-9bf1-436f-ab41-c2f77ded4a41)
		AND
		DB_UND_BroodingSovereign_WaitingForLeader(_Player)
		AND
		QRY_UND_BroodingSovereign_StillUND(_Player)
		THEN
		PROC_UND_BroodingSovereign_AfterCamp_Teleport(_Player);
		PROC_UND_BroodingSovereign_Join(_Player);
		SetFlag(UND_MyconidCircle_BroodingSovereign_State_InParty_a2571718-2bbd-48f7-8ea6-d3ef4c5b5210,NULL_00000000-0000-0000-0000-000000000000,0); 
		
		PROC
		PROC_UND_BroodingSovereign_AfterCamp_Teleport((CHARACTER)_Player)
		AND
		GetDistanceTo(_Player,S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,_dist)
		AND
		_dist>=10.0
		THEN
		PlayEffect(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,VFX_Script_Stub_Poof_01_f0cf792a-0f74-d17e-ad0d-6052a6131416);
		TeleportTo(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,_Player,"UND_BroodingSovereign_Event_WaypointTeleport");
		PlayEffect(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,VFX_Script_Stub_Poof_01_f0cf792a-0f74-d17e-ad0d-6052a6131416);
		
		IF
		TeleportedFromCamp(_Player)
		AND
		DB_GlobalFlag(UND_MyconidCircle_BroodingSovereign_State_WaitingForParty_acaea6bf-9bf1-436f-ab41-c2f77ded4a41)
		AND
		DB_UND_BroodingSovereign_WaitingForLeader(_Player)
		AND
		NOT QRY_UND_BroodingSovereign_StillUND(_Player)
		THEN
		PROC_UND_BroodingSovereign_QuestUpdate_LeftUND(_Player);
		
		IF
		TeleportedFromCamp(_Player)
		AND
		DB_UND_BroodingSovereign_WaitingForLeader(_Player)
		THEN
		ClearFlag(UND_MyconidCircle_BroodingSovereign_State_WaitingForParty_acaea6bf-9bf1-436f-ab41-c2f77ded4a41,NULL_00000000-0000-0000-0000-000000000000,0);
		NOT DB_UND_BroodingSovereign_WaitingForLeader(_Player);
		
		QRY
		QRY_UND_BroodingSovereign_NeedsToStopPlayer(NULL_00000000-0000-0000-0000-000000000000, (CHARACTER)_BroodingLeader)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_UND_BroodingSovereign_NeedsToStopPlayer((CHARACTER)_Player, (CHARACTER)_BroodingLeader)
		AND
		_Player == _BroodingLeader
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_UND_BroodingSovereign_NeedsToStopPlayer((CHARACTER)_Player, (CHARACTER)_BroodingLeader)
		AND
		_Player != _BroodingLeader
		AND
		IsInPartyWith(_BroodingLeader, _Player, 1)
		AND
		InSamePartyGroup(_BroodingLeader, _Player, 1)
		THEN
		DB_NOOP(1);
		
		//END_REGION
		
		//REGION Quest progression
		IF
		FlagSet(UND_MyconidCircle_Sovereign_State_PermaDefeated_bcfa3d32-7250-4c44-9eff-fbf30cef2b6e,_,_)
		THEN
		DB_UND_BroodingSovereign_Home((TRIGGER)S_UND_MyconidCircle_SovereignIdlePoint_304a2732-9882-4084-b7ad-4e38c3b4e989);
		
		IF
		DB_UND_BroodingSovereign_Home(_NewHome)
		AND
		DB_UND_BroodingSovereign_Home(_PrevHome)
		AND
		_NewHome!=_PrevHome
		THEN
		SetDualEntityEvent(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46, _NewHome, "UND_BroodingSovereign_NewHome", 1); //letting anubis know about the new trigger
		NOT DB_UND_BroodingSovereign_Home(_PrevHome);
		
		IF
		EntityEvent(_,"UND_BroodingSovereign_GetHome")
		AND
		DB_UND_BroodingSovereign_Home(_NewHome)
		THEN
		SetDualEntityEvent(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46, _NewHome, "UND_BroodingSovereign_NewHome", 1); //letting anubis know about the new trigger
		
		PROC
		PROC_SpotPlayers_Spotted(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46, "UND_BroodingSovereign_CelebrationSpotting", _Player)
		AND
		QRY_SpeakerIsInDialogRange((CHARACTER)S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46, _Player)
		AND
		QRY_StartDialog(UND_MyconidCircle_BroodingSovereign_4a1577b3-2d32-68a1-3092-e9014053b35c,S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,_Player)
		THEN
		DB_NOOP(1);
		
		IF
		TextEvent("UND_BroodingSovereign_KillLoneDuergar")
		THEN
		PROC_UND_BroodingSovereign_Join((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255);
		Die(S_UND_LoneDuergar_05c338d9-4590-4c4b-b87e-8c27ea2c2b18,DEATHTYPE.DoT,NULL_00000000-0000-0000-0000-000000000000,1,1);
		TeleportTo(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255,S_UND_LoneDuergar_05c338d9-4590-4c4b-b87e-8c27ea2c2b18,"",1,1,1);
		
		IF
		TextEvent("Debug_UND_GetGlut")
		AND
		GetHostCharacter(_Player)
		THEN
		TeleportTo(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46, _Player, "Debug_UND_GlutTeleportedToPlayer");
		
		IF
		EntityEvent(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46, "Debug_UND_GlutTeleportedToPlayer")
		AND
		GetHostCharacter(_Player)
		THEN
		PROC_UND_BroodingSovereign_Join((CHARACTER)_Player);
		
		//END_REGION
		
		//REGION post-quest behavior
		// He'll be walking around, playing fake revive spell on corpses
		
		IF
		TextEvent("UND_BroodingSovereign_AddSpell")
		THEN
		AddSpell(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,"Target_UND_MyconidSovereign_FakeAnimatingSpores",1,1);
		
		IF
		TextEvent("UND_BroodingSovereign_TestPostCircle")
		THEN
		SetEntityEvent((CHARACTER)S_UND_SocietyOfBrilliance_Hobgoblin_db424bf6-81ad-463d-8974-f73f1df5af09,"UND_BroodingSovereign_MyconidCorpse");
		SetEntityEvent((CHARACTER)S_UND_MyconidCricle_Corpses_DuergarCorpse_000_ad1c88ec-9f08-405a-9b35-38f0e0b6da15,"UND_BroodingSovereign_MyconidCorpse_OnMushroom");
		PROC_GlobalSetFlagAndCache((FLAG)UND_MyconidCircle_BroodingSovereign_Done_f80e93f9-53b5-4537-96a7-583508ba1cb8);
		
		IF
		TextEvent("UND_BroodingSovereign_TestPostCircle_Big")
		AND
		DB_UND_MyconidCircle_Myconids(_Myconid)
		AND
		_Myconid != S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46
		THEN
		Die(_Myconid,DEATHTYPE.DoT,NULL_00000000-0000-0000-0000-000000000000,1,1);
		
		
		IF
		FlagSet(UND_MyconidCircle_BroodingSovereign_Done_f80e93f9-53b5-4537-96a7-583508ba1cb8,_,_)
		THEN
		IterateCharactersAround((TRIGGER)S_UND_BroodingSovereign_Mushroom_21e8275f-5bd9-4bf7-9dd2-0e0704f22067,25.0,"UND_BroodingSovereign_GetMushroomCorpses","UND_BroodingSovereign_GetMushroomCorpses_Done");
		
		IF
		EntityEvent((CHARACTER)_Char,"UND_BroodingSovereign_GetMushroomCorpses")
		AND
		NOT DB_Players(_Char)
		AND
		_Char != S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265
		AND
		_Char != S_UND_TheDrowNere_06bf05c5-216b-4eaf-91f5-8f1dd3d57f30
		AND
		IsPartyMember(_Char,1,0)
		AND
		DB_PermaDefeated(_Char)
		AND
		DB_Dead(_Char)
		THEN
		PROC_BroodingSovereign_SendMyconidCorpseEvent(_Char);
		
		PROC
		PROC_BroodingSovereign_SendMyconidCorpseEvent((CHARACTER)_Char)
		AND
		GetDistanceTo(_Char, S_UND_BroodingSovereign_Mushroom_21e8275f-5bd9-4bf7-9dd2-0e0704f22067, _dist)
		AND
		_dist > 7.0
		THEN
		SetDualEntityEvent(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46, _Char, "UND_BroodingSovereign_MyconidCorpse", 1);
		
		PROC
		PROC_BroodingSovereign_SendMyconidCorpseEvent((CHARACTER)_Char)
		AND
		GetDistanceTo(_Char, S_UND_BroodingSovereign_Mushroom_21e8275f-5bd9-4bf7-9dd2-0e0704f22067, _dist)
		AND
		_dist<=7.0
		THEN
		SetDualEntityEvent(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46, _Char, "UND_BroodingSovereign_MyconidCorpse_OnMushroom", 1);
		
		//END_REGION
		
		//REGION journal
		
		PROC
		PROC_UND_BroodingSovereign_QuestUpdate_LeftUND((CHARACTER)_Player)
		AND
		GetFlag(UND_MyconidCircle_Quest_LoneDuergar_PermaDefeated_414e8493-33b0-25e8-c83b-a34b8f128394, NULL_00000000-0000-0000-0000-000000000000, _BeforeKillingDuergar)
		AND
		DB_UND_BroodingSovereign_LeftUNDEntries(_BeforeKillingDuergar, _Entry)
		THEN
		QuestUpdate(_Player, "UND_BroodingSovereign", _Entry);
		
		IF
		FlagSet((FLAG)UND_MyconidCircle_Quest_LoneDuergar_PermaDefeated_414e8493-33b0-25e8-c83b-a34b8f128394,_,_)
		THEN
		NOT DB_QuestDef_State_ConditionalFlag(UND_MyconidCircle_BroodingSovereign_State_InParty_a2571718-2bbd-48f7-8ea6-d3ef4c5b5210, "UND_BroodingSovereign", "RefusedThenAccepted", 1, UND_MyconidCircle_State_DeclinedBroodingSovereign_a8d48927-5819-08af-fc29-502c5751e3c9);
		NOT DB_QuestDef_State_ConditionalFlag(UND_MyconidCircle_BroodingSovereign_State_InParty_a2571718-2bbd-48f7-8ea6-d3ef4c5b5210, "UND_BroodingSovereign", "AcceptedJoin", 0, UND_MyconidCircle_State_DeclinedBroodingSovereign_a8d48927-5819-08af-fc29-502c5751e3c9);
		DB_QuestDef_State(UND_MyconidCircle_BroodingSovereign_State_InParty_a2571718-2bbd-48f7-8ea6-d3ef4c5b5210, "UND_BroodingSovereign", "AcceptedEscort");
		DB_QuestDef_State(UND_MyconidCircle_Event_CombatWithPlayers_0f8aee24-7971-4de4-9294-9ab91d63bb3c, "UND_BroodingSovereign", "AttackedCircle");
		
		IF
		DB_PermaDefeated((CHARACTER)S_UND_MyconidSovereign_ea0f222f-eaad-4d83-bbcd-cbae51ccf265)
		AND
		DB_GlobalFlag((FLAG)UND_MyconidCircle_BroodingSovereign_Quest_AcceptedCircleWipe_279e0906-6562-4542-9799-8ca79175f2be)
		THEN
		QuestUpdate("UND_BroodingSovereign", "KilledCircle");
		
		IF
		QuestUpdateUnlocked(_, "UND_BroodingSovereign", _Entry)
		AND
		DB_UND_BroodingSovereign_CantReachSuspectibleEntries(_Entry)
		THEN
		DB_UND_BroodingSovereign_PossiblyCantReach(1);
		
		IF
		QuestUpdateUnlocked(_, "UND_BroodingSovereign", _Entry)
		AND
		DB_UND_BroodingSovereign_CantReachSuspectibleEntries(_Entry)
		AND
		DB_UND_BroodingSovereign_CantReachSuspectibleEntries(_ClearEntry)
		THEN
		NOT DB_UND_BroodingSovereign_CantReachSuspectibleEntries(_ClearEntry);
		
		IF
		DB_UND_BroodingSovereign_PossiblyCantReach(1)
		AND
		DB_GlobalFlag(UND_MyconidCircle_BroodingSovereign_State_CantReachDuergar_68069e1d-a9e5-4fdd-8664-22942b1afa96)
		THEN
		NOT DB_UND_BroodingSovereign_PossiblyCantReach(1);
		QuestUpdate("UND_BroodingSovereign", "CantReachDuergar");
		
		IF
		EnteredCombat(_Myconid,_id)
		AND
		NOT DB_UND_MyconidCircleCombat(_id)
		AND
		DB_UND_MyconidCircle_Myconids((CHARACTER)_Myconid)
		AND
		_Myconid != S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46
		AND
		CombatGetInvolvedPlayer(_id,1,_Player)
		AND
		IsEnemy(_Player,_Myconid,1)
		THEN
		SetFlag((FLAG)UND_MyconidCircle_Event_CombatWithPlayers_0f8aee24-7971-4de4-9294-9ab91d63bb3c,NULL_00000000-0000-0000-0000-000000000000,0);
		DB_UND_MyconidCircleCombat(_id);
		
		IF
		CombatEnded(_id)
		AND
		DB_UND_MyconidCircleCombat(_id)
		THEN
		NOT DB_UND_MyconidCircleCombat(_id);
		ClearFlag((FLAG)UND_MyconidCircle_Event_CombatWithPlayers_0f8aee24-7971-4de4-9294-9ab91d63bb3c,NULL_00000000-0000-0000-0000-000000000000,0);
		
		
		IF
		DB_PermaDefeated(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46)
		AND
		DB_Players(_Player)
		THEN
		QuestUpdate(_Player,"UND_BroodingSoverign","GlutDead");
		
		//END_REGION
		
		//REGION Debug
		IF
		FlagSet((FLAG)Debug_Teleport_UND_MyconidCircle_854f7d8a-bd2f-4655-85ee-1e7244f2ed82,_,_)
		AND
		DB_Players(_Player)
		THEN
		TeleportTo(_Player,S_Debug_Teleport_UND_MyconidCircle_77d4a413-b784-45d1-92b5-324e52f709a5,"Debug_Teleport_MyconidCircle",1,1,1);
		ClearFlag(Debug_Teleport_UND_MyconidCircle_854f7d8a-bd2f-4655-85ee-1e7244f2ed82,NULL_00000000-0000-0000-0000-000000000000,0);
		
		IF
		TextEvent("UND_BroodingSovereign_LoneDuergar_KO")
		THEN
		SetFlag(UND_MyconidCircle_Quest_LoneDuergar_PermaDefeated_414e8493-33b0-25e8-c83b-a34b8f128394,
			NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_GlobalSetFlagAndCache(UND_MyconidCircle_BroodingSovereign_State_LoneDuergar_IsDead_5f622802-d6d9-48df-8cb2-8b5a3ec573c2);
		SetFlag((FLAG)UND_MyconidCircle_AcceptedQuest_3aa48080-074b-457d-acbc-fcb970d9912b,NULL_00000000-0000-0000-0000-000000000000,0);
		
		//END_REGION
		
		//REGION VB after Gluts death
		
		PROC
		PROC_GLO_DefeatCounter_AllDead("UND_BroodingSovereign_DefeatCounter_Glut")
		AND
		DB_GlobalFlag((FLAG)UND_BroodingSovereign_State_RefusedCircle_d0237569-b266-24c9-60f8-06eda3131892)
		AND
		GetClosestAlivePlayer(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46,_Player,_dist)
		AND
		_dist <=20.0
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)UND_MyconidCircle_VB_GlutDead_0b731b59-928b-83ac-36ee-68a2ad5d94b2,_Player);
		
		//END_REGION
		
		//REGION Spore Servant doesn't teleport to Brooding Sovereign after a long rest
		// Brooding Sovereign leaves the party when we go to camp and joins back when we leave
		// It's done in scripting, so we need to add custom scripting for his servant as well
		IF
		CharacterJoinedParty(_SporeServant)
		AND
		DB_CMB_SporeServantFollower(_SporeServant, _, (CHARACTER)S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46)
		AND
		GetDistanceTo(S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46, _SporeServant, _Dist)
		AND
		_Dist >= 10.0
		THEN
		PlayEffect(_SporeServant, VFX_Script_Stub_Poof_01_f0cf792a-0f74-d17e-ad0d-6052a6131416);
		TeleportTo(_SporeServant, S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46, "");
		PlayEffect(_SporeServant, VFX_Script_Stub_Poof_01_f0cf792a-0f74-d17e-ad0d-6052a6131416);
		//END_REGION
		
		//REGION
		PROC
		PROC_LevelBecameUnreachable("WLD_Main_A")
		THEN
		GoalCompleted;
		//END_REGION
	}
	EXIT
	{
		PROC_RemoveAllDialogEntriesForSpeaker(
		     S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46);
		
		NOT DB_GlobalFlagReactionAfterDialog(
		    (FLAG)UND_MyconidCircle_BroodingSovereign_State_InParty_a2571718-2bbd-48f7-8ea6-d3ef4c5b5210,
		    (DIALOGRESOURCE)UND_MyconidCircle_BroodingSovereign_4a1577b3-2d32-68a1-3092-e9014053b35c);
		
		NOT DB_GlobalFlagReactionAfterDialog(
		    (FLAG)UND_MyconidCircle_BroodingSovereign_Event_Leave_60785a26-f4dd-4353-8963-4b44283bb7d3,
		    (DIALOGRESOURCE)UND_MyconidCircle_BroodingSovereign_Leave_d7968940-c47a-7f64-28d6-6cd9a6c0aaca);
		
		NOT DB_GlobalFlagReactionAfterDialog(    
		    (FLAG)UND_MyconidCircle_BroodingSovereign_State_PreparingArmy_d21dba46-e9c1-4332-8f97-350bd89dafcd,
		    (DIALOGRESOURCE)UND_MyconidCircle_BroodingSovereign_4a1577b3-2d32-68a1-3092-e9014053b35c);
		
		TriggerUnregisterForCharacter(S_UND_BroodingSovereign_FollowingRegion_fdf3b75f-4488-449d-bced-a936b0590bf1,S_UND_Myconid_BroodingSovereign_82af0858-d739-4c9d-84c8-5e6760e22e46);
		
		SysClear("DB_UND_BroodingSovereign_Home",1);
	}
}
Goal(273).Title("Act1_UND_MyconidCircle_Checkpoints");
Goal(273)
{
	INIT
	{
		DB_CheckPoint((CHARACTER)S_UND_CheckpointMyconid_000_8b3007b5-33e5-4b62-b390-66d2307267a4,
			(CHARACTER)S_UND_CheckpointMyconid_001_610d4f48-4cca-46c6-9677-13b6c2309acf,
			(TRIGGER)S_UND_MyconidCircle_FirstCheckpoint_Warning_001_82720a55-5133-4a3e-a8b8-15a433b71b7a,
			(TRIGGER)NULL_00000000-0000-0000-0000-000000000000,
			(TRIGGER)S_UND_MyconidCircle_FirstCheckpoint_Tresspassing_5e58c38f-91a9-4209-8bd3-a88c8906eede, 
			"UND_Checkpoint_01", 
			(FLAG)UND_MyconidCircle_State_GainedAccess_fb9b0ee2-a499-cef2-fd3e-d9556050ea6a,"Trespassing", (TRIGGER)S_UND_MyconidCircle_FirstCheckpoint_OutPoint_5125eaef-a53d-4526-b91d-a185826cd519);
		
		DB_CheckPoint((CHARACTER)S_UND_CheckpointMyconid_002_82c4e48d-a058-430a-b538-9cfbf883c070,
			(CHARACTER)S_UND_CheckpointMyconid_003_82a62ddf-f80a-4606-81b8-652e677ccf13,
			(TRIGGER)S_UND_MyconidCircle_SecondCheckpoint_Warning_001_a9ee4e73-778a-4126-94c1-72df59071b42,
			(TRIGGER)NULL_00000000-0000-0000-0000-000000000000,
			(TRIGGER)S_UND_MyconidCircle_SecondCheckpoint_Tresspassing_61e2fba1-5e69-4b3d-9798-64b6c656c3ff, 
			"UND_Checkpoint_02",
			(FLAG)UND_MyconidCircle_State_GainedAccess_fb9b0ee2-a499-cef2-fd3e-d9556050ea6a,"Trespassing", (TRIGGER)S_UND_MyconidCircle_SecondCheckpoint_OutPoint_daae0603-aa76-4ae8-b79e-dab3bd2c4506);
		
		//UND_MyconidCircle_State_SovereignInDialog
		DB_Dialogs(S_UND_CheckpointMyconid_000_8b3007b5-33e5-4b62-b390-66d2307267a4, UND_MyconidCircle_CheckpointGuard_000_047d6b4a-8a65-5f04-75bb-0ec619703f66);
		DB_Dialogs(CHARACTERGUID_S_UND_CheckpointMyconid_001_610d4f48-4cca-46c6-9677-13b6c2309acf, DIALOGRESOURCEGUID_UND_MyconidCircle_CheckpointGuard_001_704f22a3-42ae-fdac-e329-6ffae81b354c);
		DB_Dialogs(CHARACTERGUID_S_UND_CheckpointMyconid_002_82c4e48d-a058-430a-b538-9cfbf883c070, DIALOGRESOURCEGUID_UND_MyconidCircle_CheckpointGuard_002_1960c702-c597-520f-ad29-011b0b0bc473);
		DB_Dialogs(CHARACTERGUID_S_UND_CheckpointMyconid_003_82a62ddf-f80a-4606-81b8-652e677ccf13, DIALOGRESOURCEGUID_UND_MyconidCircle_CheckpointGuard_003_8cb3b0c9-c71c-7507-f631-3318f9a60aec);
		DB_Dialogs(S_UND_MyconidCircle_ServantHookHorror_01_6ccbf16f-4c9f-4975-b43d-e8569fd1c566, (DIALOGRESOURCE)UND_MyconidCircle_ServantHookHorror_01_10b6ac34-7414-6e0d-0ba1-61a8a808e7f5);
		
		
		DB_UND_MyconidCircle_CheckpointDialogues((CHARACTER)S_UND_CheckpointMyconid_000_8b3007b5-33e5-4b62-b390-66d2307267a4, (DIALOGRESOURCE)UND_MyconidCircle_CheckpointGuard_000_047d6b4a-8a65-5f04-75bb-0ec619703f66);
		DB_UND_MyconidCircle_CheckpointDialogues(CHARACTERGUID_S_UND_CheckpointMyconid_001_610d4f48-4cca-46c6-9677-13b6c2309acf, DIALOGRESOURCEGUID_UND_MyconidCircle_CheckpointGuard_001_704f22a3-42ae-fdac-e329-6ffae81b354c);
		DB_UND_MyconidCircle_CheckpointDialogues(CHARACTERGUID_S_UND_CheckpointMyconid_002_82c4e48d-a058-430a-b538-9cfbf883c070, DIALOGRESOURCEGUID_UND_MyconidCircle_CheckpointGuard_002_1960c702-c597-520f-ad29-011b0b0bc473);
		DB_UND_MyconidCircle_CheckpointDialogues(CHARACTERGUID_S_UND_CheckpointMyconid_003_82a62ddf-f80a-4606-81b8-652e677ccf13, DIALOGRESOURCEGUID_UND_MyconidCircle_CheckpointGuard_003_8cb3b0c9-c71c-7507-f631-3318f9a60aec);
		DB_UND_MyconidCircle_CheckpointDialogues((CHARACTER)S_UND_CheckpointMyconid_004_530a07bf-56f7-467e-80a0-70a1ed800c96, UND_MyconidCircle_CheckpointGuard_004_9be12cdf-4b50-05a2-aebe-55e40b811ea3);
		
		DB_UND_MyconidCircle_CheckpointHelpers(
			(CHARACTER)S_UND_CheckpointMyconid_000_8b3007b5-33e5-4b62-b390-66d2307267a4,
			(CHARACTER)S_UND_CheckpointMyconid_001_610d4f48-4cca-46c6-9677-13b6c2309acf,
			(TRIGGER)S_UND_MyconidCircle_FirstCheckpoint_SovereignSpot_0eb6af0b-d618-46e1-b5ad-bd87f7bd74bd);
		
		DB_UND_MyconidCircle_CheckpointHelpers(
			(CHARACTER)S_UND_CheckpointMyconid_002_82c4e48d-a058-430a-b538-9cfbf883c070,
			(CHARACTER)S_UND_CheckpointMyconid_003_82a62ddf-f80a-4606-81b8-652e677ccf13,
			(TRIGGER)UND_MyconidCircle_SecondCheckpoint_SovereignSpot_f7937bb6-5ec2-4a6c-a3da-4ed05a295b12);
		
		
		DB_UND_MyconidCircle_ToxicWall((ITEM)S_UND_MyconidCircle_Checkpoint_LiftSide_ToxicWall_1_6c70c6cc-bcf5-44c9-8d08-5bb5ab1d06c3);
		DB_UND_MyconidCircle_ToxicWall((ITEM)S_UND_MyconidCircle_Checkpoint_LiftSide_ToxicWall_2_c7df0ae6-bd21-48d2-8c9c-2014d052acdb);
		DB_UND_MyconidCircle_ToxicWall((ITEM)S_UND_MyconidCircle_Checkpoint_LakeSide_ToxicWall_1_b2720c34-4937-41e7-8bd7-eb6b2833af58);
		DB_UND_MyconidCircle_ToxicWall((ITEM)S_UND_MyconidCircle_Checkpoint_LakeSide_ToxicWall_2_7fbc1d31-c70e-4d84-8909-d9be9c21b8fe);
		DB_UND_MyconidCircle_ToxicWall((ITEM)S_PUZ_MyconidVillage_ToxicWall_01_25f99560-e4b7-470b-ac75-d035f067080e);
		DB_UND_MyconidCircle_ToxicWall((ITEM)S_PUZ_MyconidVillage_ToxicWall_02_9c2c8c05-4419-4bf4-a295-086d8d389a9d);
		DB_UND_MyconidCircle_ToxicWall((ITEM)S_PUZ_MyconidVillage_ToxicWall_03_dbc660ea-5043-4ddc-a3a8-d57025aba1df);
		DB_UND_MyconidCircle_ToxicWall((ITEM)S_PUZ_MyconidVillage_ToxicWall_04_114167fb-c7d5-453b-81ef-9e50adec5d46);
		DB_UND_MyconidCircle_ToxicWall((ITEM)S_PUZ_MyconidVillage_ToxicWall_05_11798d57-156a-4789-9003-b9502868c192);
		DB_UND_MyconidCircle_ToxicWall((ITEM)S_PUZ_MyconidVillage_ToxicWall_06_727ed90e-9bd6-4249-81e2-f54550f076a8);
		DB_UND_MyconidCircle_ToxicWall((ITEM)S_PUZ_MyconidVillage_ToxicWall_07_fb7ee980-e464-4dcf-84ca-4760f7a0c2c1);
		DB_UND_MyconidCircle_ToxicWall((ITEM)S_PUZ_MyconidVillage_ToxicWall_08_fcb75a15-c828-4199-b6aa-5237f31a90fa);
		DB_UND_MyconidCircle_ToxicWall((ITEM)S_PUZ_MyconidVillage_ToxicWall_09_655386c3-3506-4839-bc9a-b2755f69ffa6);
		DB_UND_MyconidCircle_ToxicWall((ITEM)S_PUZ_MyconidVillage_ToxicWall_10_a2543ce0-c6ab-43e8-afae-c706c2f1275c);
		
		
		
		PROC_TriggerRegisterForPlayers(S_UND_MyconidCircle_ExplosiveFields_142df808-70a2-462e-8d70-98f2e463a2ea);
		PROC_TriggerRegisterForPlayers((TRIGGER)S_UND_ExplosiveMushrooms_Warning_4244a728-f1b7-42a7-84b9-8fb1c70f00ec);
		
		// Combat NPC Reactivity
		DB_CombatReact_AD_OnNextTurn(S_UND_CheckpointMyconid_000_8b3007b5-33e5-4b62-b390-66d2307267a4, (DIALOGRESOURCE)UND_MyconidCircle_AD_CheckpointGuard_000_Combat_b0986eda-f522-426d-0390-176402d17b87);
		DB_CombatReact_AD_OnNextTurn(S_UND_CheckpointMyconid_004_530a07bf-56f7-467e-80a0-70a1ed800c96, (DIALOGRESOURCE)UND_MyconidCircle_AD_CheckpointGuard_004_Combat_5dbf479e-a75a-0286-065f-93dbe5f5f131);
		DB_CombatReact_AD_OnNextTurn(S_UND_CheckpointMyconid_002_82c4e48d-a058-430a-b538-9cfbf883c070, (DIALOGRESOURCE)UND_MyconidCircle_AD_CheckpointGuard_002_Combat_3dcbf4ae-e643-4fcc-7c5f-0c73017e3b0b);
		DB_CombatReact_AD_OnNextTurn(S_UND_CheckpointMyconid_003_82a62ddf-f80a-4606-81b8-652e677ccf13, (DIALOGRESOURCE)UND_MyconidCircle_AD_CheckpointGuard_003_Combat_42a6e3a1-3435-668b-ef0e-65e26c203135);
	}
	KB
	{
		//REGION Checkpoint dialogs
		PROC
		PROC_CheckPointDialogue((CHARACTER)_Player, _Myconid)
		AND
		DB_UND_MyconidCircle_CheckpointDialogues((CHARACTER)_Myconid, (DIALOGRESOURCE)_Dialog)
		AND
		QRY_UND_MyconidCircle_ChooseHelper((CHARACTER)_Myconid)
		AND
		QRY_StartDialog_Fixed(_Dialog, _Myconid,_Player, S_UND_MyconidCircle_FakeSovereign_c7e544f8-2842-4a03-a4a6-94e673a0d1a4)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_DialogFlagSetup(_dialog, _NPC, _)
		AND
		DB_UND_MyconidCircle_CheckpointDialogues(_,_dialog)
		AND
		DB_Players(_PartyPlayer)
		AND
		CanSee((CHARACTER)_NPC, (CHARACTER)_PartyPlayer, 1)
		AND
		IsTagged(_PartyPlayer, (TAG)REALLY_DUERGARDWARF_45b007f7-f4f6-46e2-9480-395a49b87ef3, 1)
		THEN
		SetFlag((FLAG)UND_MyconidCircle_State_DuergarInParty_ce94122a-53d4-2d1d-c37c-4f5e27e7c7b7, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		
		QRY
		QRY_UND_MyconidCircle_ChooseHelper((CHARACTER)_NPC)
		AND
		DB_UND_MyconidCircle_CheckpointHelpers((CHARACTER)_NPC,_,(TRIGGER)_Trigger)
		THEN
		TeleportTo(
		    (ITEM)S_UND_MyconidCircle_FakeSovereign_c7e544f8-2842-4a03-a4a6-94e673a0d1a4,
		    _Trigger,"UND_MyconidCircle_SovereignTeleport",0,0,1);
		
		QRY
		QRY_UND_MyconidCircle_ChooseHelper((CHARACTER)_NPC)
		AND
		DB_UND_MyconidCircle_CheckpointHelpers(_,(CHARACTER)_NPC,(TRIGGER)_Trigger)
		THEN
		TeleportTo(
		    (ITEM)S_UND_MyconidCircle_FakeSovereign_c7e544f8-2842-4a03-a4a6-94e673a0d1a4,
		    _Trigger,"UND_MyconidCircle_SovereignTeleport",0,0,1);
		
		
		//END_REGION
		
		//REGION Toxic wall
		PROC
		PROC_UND_ToxicWall_On((CHARACTER)_User, (ITEM)_ToxicWall)
		THEN
		SetDualEntityEvent(_User, _ToxicWall,"UND_ToxicWall_On", 1);
		SetFlag(UND_MyconidCircle_State_WallActive_c0d66b03-cec5-4ac1-915b-8c612c8d1594, _ToxicWall, 0);
		
		PROC
		PROC_UND_ToxicWall_Off((CHARACTER)_User, (ITEM)_ToxicWall)
		THEN
		SetDualEntityEvent(_User, _ToxicWall,"UND_ToxicWall_Off", 1);
		ClearFlag(UND_MyconidCircle_State_WallActive_c0d66b03-cec5-4ac1-915b-8c612c8d1594, _ToxicWall, 0);
		
		PROC
		PROC_UND_ToxicWall_Switch((CHARACTER)_User, (ITEM)_ToxicWall)
		AND
		NOT QRY_UND_ToxicWall_DeactivateWallIfActive(_User, _ToxicWall)
		THEN
		PROC_UND_ToxicWall_On(_User, _ToxicWall);
		
		PROC
		PROC_UND_ToxicWall_MyconidsDeactivate()
		AND
		DB_UND_MyconidCircle_CheckpointDialogues(_Myconid, _)
		THEN
		SetEntityEvent(_Myconid, "UND_MyconidCircle_DeactivateWall", 1);
		
		QRY
		QRY_UND_ToxicWall_DeactivateWallIfActive((CHARACTER)_User, (ITEM)_ToxicWall)
		AND
		GetFlag(UND_MyconidCircle_State_WallActive_c0d66b03-cec5-4ac1-915b-8c612c8d1594, _ToxicWall, 1)
		THEN
		PROC_UND_ToxicWall_Off(_User, _ToxicWall);
		
		IF
		DB_UND_MyconidCircle_ToxicWall(_ToxicWall)
		THEN
		PROC_UND_ToxicWall_On(NULL_00000000-0000-0000-0000-000000000000, _ToxicWall);
		DB_KnowledgeCheckItem_AD("UND_MyconidCircle_ToxicWall",  _ToxicWall, "Nature", (DIFFICULTYCLASS)DC_Legacy_10_625be976-7a67-4394-97c8-14c69715ae4b, (DIALOGRESOURCE)UND_BarrelstalkInteraction_b8fa4b05-58f3-5424-a968-232ca3987d8c, (FLAG)UND_MyconidCircle_Knows_Barrelstalks_30a6f4fa-22d3-d7ca-9048-c8bc0164c648);
		
		IF
		UseStarted(_User,_ToxicWall)
		AND
		DB_UND_MyconidCircle_ToxicWall(_ToxicWall)
		AND
		IsTagged(_User, (TAG)PLANT_125b3d94-3997-4fc4-8211-1768b67dbe4a, 1)
		THEN
		PROC_UND_ToxicWall_Switch(_User, (ITEM)_ToxicWall);
		
		IF
		DialogEnded(_Dialog, _)
		AND
		DB_UND_MyconidCircle_CheckpointDialogues(_, _Dialog)
		AND
		DB_GlobalFlag(UND_MyconidCircle_State_GainedAccess_fb9b0ee2-a499-cef2-fd3e-d9556050ea6a)
		AND
		QRY_OnlyOnce("UND_MyconidCircle_PlayerGainedAccess")
		THEN
		PROC_UND_ToxicWall_MyconidsDeactivate();
		
		IF
		DialogEnded(UND_MyconidSovereign_934d97d0-922c-7c31-05fe-054bcc630447, _)
		AND
		DB_GlobalFlag(UND_MyconidCircle_State_GainedAccess_fb9b0ee2-a499-cef2-fd3e-d9556050ea6a)
		AND
		QRY_OnlyOnce("UND_MyconidCircle_PlayerGainedAccess")
		THEN
		PROC_UND_ToxicWall_MyconidsDeactivate();
		//END_REGION
		
		//REGION Combat
		//Using a spell that looks like a use animation so that the mayconids can reason about the 
		//stalks while in combat.
		
		PROC
		PROC_CastedSpellOnTarget((GUIDSTRING)_Caster,(GUIDSTRING)_BarrelStalk,"Target_UND_Myconid_UseBarrelStalk",(STRING)_SpellType,(STRING)_SpellElement,(INTEGER)_StoryActionID)
		AND
		DB_UND_MyconidCircle_ToxicWall((ITEM)_BarrelStalk)
		THEN
		PROC_UND_ToxicWall_Switch(NULL_00000000-0000-0000-0000-000000000000,(ITEM)_BarrelStalk);
		
		IF
		DB_UND_MyconidCircle_ToxicWall(_BarrelStalk)
		THEN
		SetTag(_BarrelStalk,AI_USEITEM_A_f532d904-4e7c-469f-8e47-67a639cd1ae1);
		
		IF
		FlagSet(UND_MyconidCircle_State_WallActive_c0d66b03-cec5-4ac1-915b-8c612c8d1594, _BarrelStalk,_) 
		AND
		DB_UND_MyconidCircle_ToxicWall((ITEM)_BarrelStalk)
		AND
		DB_UND_MyconidCircle_Myconids(_Myconid)
		AND
		IsDead(_Myconid,0)
		THEN
		AiRemoveInterestingItem(_Myconid,_BarrelStalk);
		
		IF
		FlagCleared(UND_MyconidCircle_State_WallActive_c0d66b03-cec5-4ac1-915b-8c612c8d1594, _BarrelStalk,_)
		AND
		DB_UND_MyconidCircle_ToxicWall((ITEM)_BarrelStalk)
		AND
		IsDestroyed(_BarrelStalk,0)
		AND
		DB_UND_MyconidCircle_Myconids(_Myconid)
		AND
		IsDead(_Myconid,0)
		AND
		HasSpell(_Myconid,"Target_UND_Myconid_UseBarrelStalk",1)
		THEN
		AiAddInterestingItem(_Myconid,_BarrelStalk);
		
		IF
		DestroyedBy(_BarrelStalk,_,_,_)
		AND
		DB_UND_MyconidCircle_ToxicWall(_BarrelStalk)
		AND
		DB_UND_MyconidCircle_Myconids(_Myconid)
		AND
		IsDead(_Myconid,0)
		AND
		HasSpell(_Myconid,"Target_UND_Myconid_UseBarrelStalk",1)
		THEN
		AiRemoveInterestingItem(_Myconid,_BarrelStalk);
		
		//END_REGION
		
		
		//REGION Explosive mushroom fields
		IF
		EnteredTrigger((CHARACTER)_Player,S_UND_ExplosiveMushrooms_Warning_4244a728-f1b7-42a7-84b9-8fb1c70f00ec)
		AND
		DB_GlobalFlag((FLAG)UND_MyconidCircle_State_GainedAccess_fb9b0ee2-a499-cef2-fd3e-d9556050ea6a)
		AND
		NOT DB_OnlyOnce("UND_MyconidCircle_UnregisterWarningTriggers")
		AND
		QRY_StartDialog(
			(DIALOGRESOURCE)UND_MyconidCircle_MushroomField_Warning_ddaea548-ed92-5de9-4615-f46282d1c91c,
			(CHARACTER)S_UND_CheckpointMyconid_000_8b3007b5-33e5-4b62-b390-66d2307267a4,
			(CHARACTER)_Player)
		AND
		QRY_OnlyOnce("UND_MyconidCircle_UnregisterWarningTriggers")
		THEN
		PROC_TriggerUnregisterForPlayers(S_UND_MyconidCircle_ExplosiveFields_142df808-70a2-462e-8d70-98f2e463a2ea);
		PROC_TriggerUnregisterForPlayers((TRIGGER)S_UND_ExplosiveMushrooms_Warning_4244a728-f1b7-42a7-84b9-8fb1c70f00ec);
		
		IF
		EnteredTrigger((CHARACTER)_Player,S_UND_MyconidCircle_ExplosiveFields_142df808-70a2-462e-8d70-98f2e463a2ea)
		AND
		QRY_OnlyOnce("UND_MyconidCircle_UnregisterWarningTriggers")
		THEN
		PROC_TriggerUnregisterForPlayers(S_UND_MyconidCircle_ExplosiveFields_142df808-70a2-462e-8d70-98f2e463a2ea);
		PROC_TriggerUnregisterForPlayers((TRIGGER)S_UND_ExplosiveMushrooms_Warning_4244a728-f1b7-42a7-84b9-8fb1c70f00ec);
		
		//END_REGION
		
		//REGION Marker on the Myconid Sovereign after he invites you to meet him
		// meeting the Sovereign also sets his flag, so we need to only react
		// when it is set in a checkpoint dialog and you get invited to meet him
		IF
		FlagSet((FLAG)UND_MyconidCircle_State_GainedAccess_fb9b0ee2-a499-cef2-fd3e-d9556050ea6a, _, _ID)
		AND
		DB_DialogName(_Dialog, _ID)
		AND
		DB_UND_MyconidCircle_CheckpointDialogues(_, _Dialog)
		AND
		NOT DB_GlobalFlag((FLAG)UND_MyconidCircle_SpokeWithSovereign_155b4ce9-fd7b-445a-afbd-64cb5bf2d707)
		AND
		NOT DB_GlobalFlag((FLAG)UND_MyconidCircle_Sovereign_State_PermaDefeated_bcfa3d32-7250-4c44-9eff-fbf30cef2b6e)
		THEN
		PROC_UnlockPartyMarker("UND_MyconidCircle_Spaw");
		
		IF
		FlagSet((FLAG)UND_MyconidCircle_SpokeWithSovereign_155b4ce9-fd7b-445a-afbd-64cb5bf2d707, _, _)
		THEN
		PROC_HidePartyMarker("UND_MyconidCircle_Spaw");
		
		IF
		FlagSet((FLAG)UND_MyconidCircle_Sovereign_State_PermaDefeated_bcfa3d32-7250-4c44-9eff-fbf30cef2b6e, _, _)
		THEN
		PROC_HidePartyMarker("UND_MyconidCircle_Spaw");
		//END_REGION
		
		//REGION debug
		IF
		TextEvent("UND_Debug_MCC_CheckFlags")
		AND
		GetHostCharacter(_Gustav)
		AND
		GetFlag((FLAG)UND_MyconidCircle_State_GainedAccess_fb9b0ee2-a499-cef2-fd3e-d9556050ea6a,NULL_00000000-0000-0000-0000-000000000000,_Int1)
		AND
		GetFlag((FLAG)UND_MyconidCircle_State_DuergarInParty_ce94122a-53d4-2d1d-c37c-4f5e27e7c7b7,NULL_00000000-0000-0000-0000-000000000000,_Int2)
		AND
		IntegerToString(_Int1,_Str1)
		AND
		IntegerToString(_Int2,_Str2)
		THEN
		DebugText(_Gustav,"GainedAccess");
		DebugText(_Gustav,_Str1);
		DebugText(_Gustav,"DuergarInParty");
		DebugText(_Gustav,_Str2);
		
		IF
		TextEvent("UND_Debug_MCC_ClearFlags")
		THEN
		ClearFlag((FLAG)UND_MyconidCircle_State_DuergarInParty_ce94122a-53d4-2d1d-c37c-4f5e27e7c7b7,NULL_00000000-0000-0000-0000-000000000000,0);
		ClearFlag((FLAG)UND_MyconidCircle_State_GainedAccess_fb9b0ee2-a499-cef2-fd3e-d9556050ea6a,NULL_00000000-0000-0000-0000-000000000000,0);
		
		IF
		TextEvent("UND_Debug_ToxicWall_Check")
		AND
		DB_UND_MyconidCircle_ToxicWall(_ToxicWall)
		AND
		GetFlag(UND_MyconidCircle_State_WallActive_c0d66b03-cec5-4ac1-915b-8c612c8d1594, _ToxicWall, _Int)
		AND
		IntegerToString(_Int,_Out)
		THEN
		DebugText(_ToxicWall,_Out);
		
		IF
		TextEvent("UND_MyconidCircle_GainAccess")
		THEN
		SetFlag(UND_MyconidCircle_State_GainedAccess_fb9b0ee2-a499-cef2-fd3e-d9556050ea6a, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		TextEvent("UND_Debug_ToxicWall_Switch")
		AND
		DB_UND_MyconidCircle_ToxicWall(_ToxicWall)
		THEN
		PROC_UND_ToxicWall_Switch(NULL_00000000-0000-0000-0000-000000000000, (ITEM)_ToxicWall);
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(274).Title("Act1_UND_MyconidCircle_InjuredGnome");
Goal(274)
{
	INIT
	{
		DB_Dialogs(
			(CHARACTER)S_GLO_InjuredGnome_fcf53ac7-1805-4e57-b6ed-4f7b0f90cf96,
			(DIALOGRESOURCE)UND_MyconidCircle_InjuredGnome_7752324a-db86-dfd3-30b5-4a2edde65d6c);
		
		Equip(	
			S_GLO_InjuredGnome_fcf53ac7-1805-4e57-b6ed-4f7b0f90cf96,
			S_UND_MyconidCircle_BootsOfSpeed_fca76ec8-f3dd-446c-bd69-dc2f6ccca285,
			1);
		PROC_UND_InjuredGnome_UnequipCurrentWeapon();
		
		PROC_SetHitpointsPercentage_BlockSelfHealing(S_GLO_InjuredGnome_fcf53ac7-1805-4e57-b6ed-4f7b0f90cf96,25.0);
		
		//REGION Item events for Gnome's dialog
		DB_HasItemEvent(
			S_UND_MyconidCircle_BootsOfSpeed_fca76ec8-f3dd-446c-bd69-dc2f6ccca285,
			UND_MyconidCircle_InjuredGnome_HasBoots_162c2df2-dd25-407d-a5f1-0c78d09ef515);
		
		DB_GiveItemToEvent(S_UND_MyconidCircle_BootsOfSpeed_fca76ec8-f3dd-446c-bd69-dc2f6ccca285, UND_InjuredGnome_Event_GiveBoots_c917e56b-1335-481c-9062-6f46dfa90cea);
		
		// Different poison cures the player can give to the gnome:
		DB_HasItemEvent((ITEM)S_UND_InjuredGnome_DuergarAntidote_a176e33f-37f4-4035-a172-310749dcebfa,(FLAG)UND_InjuredGnome_HasAntidote_21aaaceb-b2f6-4c7b-83c9-68dba011ecc5);
		DB_GiveItemToEvent(S_UND_InjuredGnome_DuergarAntidote_a176e33f-37f4-4035-a172-310749dcebfa,(FLAG)UND_InjuredGnome_GiveAntidote_541d149c-ba4f-41f3-9e02-409c1daeb4e0);
		
