		DB_Debug_TeleportFlags((FLAG)Debug_Teleport_UND_AdamantineForge_095c6986-7c76-4731-8f0a-9cf61e572b71,(TRIGGER)S_Debug_UND_AdamantineForge_7aa5d364-f3e1-46e5-a49c-42aec1f0fc86);
