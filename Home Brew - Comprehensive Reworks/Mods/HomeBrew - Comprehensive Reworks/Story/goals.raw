		GetTemplate(_Item, (ITEMROOT)ALCH_Ingredient_Herb_NightOrchid_11f6de17-4682-419c-808f-8a328d2cce15)
		AND
		NOT QRY_LOW_KurwinCoffer_HasNightOrchid((ITEM)_Item)
		AND
		DB_GlobalFlag((FLAG)LOW_KurwinCoffer_State_HasNightOrchid_be45d224-d346-41c5-9b00-45c42dcdc029)
		THEN
		PROC_GlobalClearFlagAndCache((FLAG)LOW_KurwinCoffer_State_HasNightOrchid_be45d224-d346-41c5-9b00-45c42dcdc029);
		
		QRY
		QRY_LOW_KurwinCoffer_HasNightOrchid((ITEM)_Item)
		AND
		DB_LOW_KurwinCoffer_ObjectPlaced(_Orchid)
		AND
		_Item != _Orchid
		AND
		GetTemplate(_Orchid, (ITEMROOT)ALCH_Ingredient_Herb_NightOrchid_11f6de17-4682-419c-808f-8a328d2cce15)
		THEN
		DB_NOOP(1);
		
		IF
		DB_LOW_KurwinCoffer_ObjectPlaced(_Item)
		AND
		GetTemplate(_Item, (ITEMROOT)ALCH_Ingredient_Herb_NightOrchid_11f6de17-4682-419c-808f-8a328d2cce15)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_KurwinCoffer_State_HasNightOrchid_be45d224-d346-41c5-9b00-45c42dcdc029)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)LOW_KurwinCoffer_State_HasNightOrchid_be45d224-d346-41c5-9b00-45c42dcdc029);
		
		IF
		DB_LOW_KurwinCoffer_ObjectPlaced(_Item)
		AND
		DB_OnlyOnce("LOW_Shadowheart_GraveSeen")
		AND
		DB_InRegion((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679, (TRIGGER)S_LOW_FlowerSpot_af2605bb-3708-4a00-9248-3bbe9f78d8f8)
		AND
		DB_LOW_KurwinCoffer_ObjectPlaced(_AllItem)
		THEN
		NOT DB_LOW_KurwinCoffer_ObjectPlaced(_AllItem);
		TriggerUnregisterForCharacter((TRIGGER)S_LOW_FlowerSpot_af2605bb-3708-4a00-9248-3bbe9f78d8f8, (CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679);
		TriggerUnregisterForItems((TRIGGER)S_LOW_TeacherGrave_7a3d3cbd-3b7c-4da9-a058-537456b090a5);
		PROC_TryStartAD((DIALOGRESOURCE)LOW_Shadowheart_PAD_TeacherGraveFlower_3b1f34f7-51df-af7b-8577-3a71447e8370, (CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679);
		
		//END_REGION
		
		//REGION Grief Attendant
		QRY
		QRY_OriginMoment_PreventRelaunchDialog(LOW_HouseOfGrief_OM_Shadowheart_AOM_OOM_63272393-7816-186d-0ebc-6eb0df97f119, _, _)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_OriginMoment_PreventRelaunchDialog(LOW_HouseOfGrief_OM_Shadowheart_COM_57295937-510c-6a02-14c3-97ac66e20da1, _, _)
		THEN
		DB_NOOP(1);
		//END_REGION
		
		
		//REGION Viconia Illusion
		
		QRY
		QRY_OriginMoment_PreventRelaunchDialog((DIALOGRESOURCE)LOW_HouseOfGrief_MeetingViconia_OM_Shadowheart_AOM_OOM_acd28654-5731-e7ef-5d83-ce0c5f76cbc0, _, _)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_OriginMoment_PreventRelaunchDialog((DIALOGRESOURCE)LOW_HouseOfGrief_MeetingViconia_OM_Shadowheart_COM_7faa8762-49df-5912-49cd-79f8bb626e57, _, _)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_HouseOfGrief_State_RefusedSHMeeting_708c8c0e-b370-4ce8-9b04-a2e35334deb2)
		THEN
		DB_NOOP(1);
		
		//END_REGION
		
		//REGION Shadowheart - Reject Shar/Shar Path (Saved Parents) - Post Grotto Camp Night
		
		IF
		FlagSet((FLAG)ORI_Shadowheart_State_ConcludedGrotto_438098b7-3b50-48d6-ac53-6960b2849e10, _, _)
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679, (DIALOGRESOURCE)ShadowHeart_InParty_95ca3833-09d0-5772-b16a-c7a5e9208fe5, (CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679);
		
		IF
		FlagSet((FLAG)ORI_Shadowheart_State_ConcludedGrotto_438098b7-3b50-48d6-ac53-6960b2849e10, _, _)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Shadowheart_State_Shar_KilledParents_3a3b0ecf-a1ed-4733-8548-0348befc6bac)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_SharGrotto_State_DefeatedParents_a97d7fe5-340d-4b78-b38a-1949627698bf)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		AND
		QRY_GetBestAvatarForCompanion((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		AND
		DB_QRYRTN_GetBestAvatarForCompanion((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679, _Avatar)
		THEN
		NOT DB_CampNight_SoloDream((FLAG)NIGHT_Shadowheart_DaughterTears_f9b1fa94-deef-4927-ad7d-3e1b0c393c13, (CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679, (DIALOGRESOURCE)CAMP_Shadowheart_DaughterTears_SD_c0f0d040-7590-fbd6-26fd-760874706059);
		DB_CampNight_SoloDream((FLAG)NIGHT_Shadowheart_DaughterTears_f9b1fa94-deef-4927-ad7d-3e1b0c393c13, _Avatar, (DIALOGRESOURCE)CAMP_Shadowheart_DaughterTears_SD_c0f0d040-7590-fbd6-26fd-760874706059);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)CAMP_Shadowheart_DaughterTears_SD_c0f0d040-7590-fbd6-26fd-760874706059, _Inst)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		THEN
		PROC_DialogAddSpeakingActor(_Inst, S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)CAMP_Shadowheart_DaughterTears_SD_c0f0d040-7590-fbd6-26fd-760874706059, _Inst)
		AND
		QRY_SpeakerIsAvailable(S_LOW_ShadowheartFather_c12d561f-beae-4ef6-917e-0bec2f829449)
		THEN
		PROC_DialogAddSpeakingActor(_Inst, S_LOW_ShadowheartFather_c12d561f-beae-4ef6-917e-0bec2f829449);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)CAMP_Shadowheart_DaughterTears_SD_c0f0d040-7590-fbd6-26fd-760874706059, _Inst)
		AND
		QRY_SpeakerIsAvailable(S_LOW_ShadowheartMother_d085272a-f1d0-4ff8-a498-80728030f83e)
		THEN
		PROC_DialogAddSpeakingActor(_Inst, S_LOW_ShadowheartMother_d085272a-f1d0-4ff8-a498-80728030f83e);
		//END_REGION
		
		//REGION Shadowheart TG
		
		//TG - 111 - Sold Shadowheart out
		IF
		FlagSet((FLAG)LOW_SharGrotto_ConfrontViconia_SharranAlliance_ea829b7c-5f69-c4fc-6b4c-b8a190d31a86, NULL_00000000-0000-0000-0000-000000000000, _)
		AND
		DB_Avatars(_Avatar)
		THEN
		SetFlag((FLAG)TG_ORI_Shadowheart_ShadowheartBetrayed_f78e829a-55cb-4dbf-859e-2f125471fbdc, _Avatar);
		
		//TG - 164 - Freed Parents
		IF
		FlagSet((FLAG)ORI_Shadowheart_State_RejectShar_SavedParents_486d69d4-a7c2-4cb5-8fcb-8f2cb738ada9, NULL_00000000-0000-0000-0000-000000000000, _)
		AND
		DB_Avatars(_Avatar)
		THEN
		SetFlag((FLAG)TG_ORI_Shadowheart_RejectShar_SavedParents_44d31128-754f-4fc5-bc33-db89db198bb9, _Avatar);
		
		//TG - 165 - Freed Parents Last Minute
		IF
		FlagSet((FLAG)ORI_Shadowheart_State_Shar_SavedParents_8a0fad17-1615-4a0d-a045-21661d9a2aa0, NULL_00000000-0000-0000-0000-000000000000, _)
		AND
		DB_Avatars(_Avatar)
		THEN
		SetFlag((FLAG)TG_ORI_Shadowheart_SharPath_SavedParents_62ef9fd5-f57c-43ff-a524-290051ce8add, _Avatar);
		
		//TG - 166 - Mercy Killed Parents
		IF
		FlagSet((FLAG)ORI_Shadowheart_State_RejectShar_KilledParents_e9060caf-66b0-4701-8dfd-5ae1125f5afd, NULL_00000000-0000-0000-0000-000000000000, _)
		AND
		DB_Avatars(_Avatar)
		THEN
		SetFlag((FLAG)TG_ORI_Shadowheart_RejectShar_KilledParents_512f135e-4341-4266-ac57-a4421363d82b, _Avatar);
		
		//TG - 167 - Sacrifices Parents
		IF
		FlagSet((FLAG)ORI_Shadowheart_State_Shar_KilledParents_3a3b0ecf-a1ed-4733-8548-0348befc6bac, NULL_00000000-0000-0000-0000-000000000000, _)
		AND
		DB_Avatars(_Avatar)
		THEN
		SetFlag((FLAG)TG_ORI_Shadowheart_SharPath_KilledParents_a5d31da9-d01e-46e0-b3df-8eb9f62d0c0f, _Avatar);
		
		//END_REGION
	}
	EXIT
	{
	}
}
