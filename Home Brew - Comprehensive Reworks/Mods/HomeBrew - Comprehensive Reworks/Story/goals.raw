		DB_LOW_HouseOfHope_SpiritSouls((CHARACTER)S_LOW_HouseOfHope_SoulSpirit12_3b91c966-5748-4c3f-a90c-0cd28ed63be9,(TRIGGER)S_LOW_HouseOfHope_SoulSpirit12_Point_cbff47fa-0d7a-4f3b-99ba-9c5ef1144178,(TRIGGER)S_LOW_HouseOfHope_SoulSpirit12_Box_50596b83-1840-43d4-9345-319283b23bc9,(DIALOGRESOURCE)LOW_HouseOfHope_AD_DamnedSoul12_1baac23a-c8cb-ab5d-845a-c1bd817fc8b2);
		DB_LOW_HouseOfHope_SpiritSouls((CHARACTER)S_LOW_HouseOfHope_SoulSpirit14_7987935d-d347-4516-98fb-129836d3aa23,(TRIGGER)S_LOW_HouseOfHope_SoulSpirit14_Point_79ddee3d-eafe-42f5-a62c-b034fd46407a,(TRIGGER)S_LOW_HouseOfHope_SoulSpirit14_Box_9b3fbdfe-a830-4dc1-9a0e-9c8bbb2fb62c,(DIALOGRESOURCE)LOW_HouseOfHope_AD_DamnedSoul14_f519a58e-7325-3f1a-e34c-b9b9bd33bafb);
