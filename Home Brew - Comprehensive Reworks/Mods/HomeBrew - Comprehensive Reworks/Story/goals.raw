	}
	KB
	{
		//REGION OM_Sharran Informer
		
		//REGION Entering the city
		
		PROC
		PROC_DialogFlagSetup((DIALOGRESOURCE)WYR_RefugeeCamp_SharranInformer_f114c457-76fc-0b4a-28b6-4052a59cb948, _, _)
		AND
		NOT DB_PartOfTheTeam((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)ORI_Shadowheart_State_PermaUnavailable_068b6f26-6b5e-4ad7-991b-fac10f96000d);
		
		IF
		DB_GlobalFlag((FLAG)CURRENTREGION_BGO_Main_A_11239767-48ad-4879-8312-b9164b6e4978)
		AND
		DB_Players((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		AND
		QRY_OnlyOnce("WYR_SharranInformer_EnteredCity")
		THEN
		PROC_TriggerRegisterForPlayers((TRIGGER)S_WYR_EnterCity_82015dfc-108d-43ef-a129-43b51ff58ded);
		
		IF
		LeftTrigger(_Player, (TRIGGER)S_WYR_EnterCity_82015dfc-108d-43ef-a129-43b51ff58ded)
		AND
		QRY_OnlyOnce("WYR_SharranInformer_MentionedHandler")
		THEN
		PROC_TriggerUnregisterForPlayers((TRIGGER)S_WYR_EnterCity_82015dfc-108d-43ef-a129-43b51ff58ded);
		PROC_TryStartAD((DIALOGRESOURCE)WYR_RefugeeCamp_PAD_Handler_46f813a1-face-e325-d142-0e5bd634a4d7, S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679);
		
		PROC
		PROC_CAMP_LeftCamp((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		AND
		DB_Players((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		AND
		QRY_OnlyOnce("WYR_SharranInformer_MentionedHandler")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)WYR_RefugeeCamp_PAD_Handler_46f813a1-face-e325-d142-0e5bd634a4d7, S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679);
		
		IF
		DB_GlobalFlag((FLAG)LOW_HouseOfGrief_Knows_IsSharCult_6aa0816f-5827-4669-b3d3-b6dd71a6b95e)
		THEN
		NOT DB_OneShot_ADTrigger((TRIGGER)S_WYR_RefugeeCamp_CampArea_a63c8d3c-02ec-4a74-94d5-4d1718b2af66, (DIALOGRESOURCE)WYR_RefugeeCamp_PAD_NearHandler_031716ad-b9f2-95bf-6ec6-a149247bdbe1, S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679);
		PROC_TriggerUnregisterForPlayers((TRIGGER)S_WYR_EnterCity_82015dfc-108d-43ef-a129-43b51ff58ded);
		DB_OnlyOnce("WYR_SharranInformer_MentionedHandler");
		
		//END_REGION
		
		PROC
		PROC_SpotPlayers_Spotted((CHARACTER)S_GLO_SharranInformer_b2cf2efe-ec06-48cd-8fb7-ad596d61164f, "WYR_RefugeeCamp_HandlerSpot", _Player)
		AND
		NOT DB_CantTalk((CHARACTER)S_GLO_SharranInformer_b2cf2efe-ec06-48cd-8fb7-ad596d61164f)
		AND
		QRY_StartDialog((DIALOGRESOURCE)WYR_RefugeeCamp_AD_Handler_2c1c74b3-eb8c-6ed6-1d08-4131b7547f4a, (CHARACTER)S_GLO_SharranInformer_b2cf2efe-ec06-48cd-8fb7-ad596d61164f)
		THEN
		PROC_SpotPlayers_StopSpotting("WYR_RefugeeCamp_HandlerSpot");
		
		
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)ORI_Shadowheart_Event_InformerLeaves_dff4a662-897b-486d-aa5c-221f1f2217d5)
		THEN
		PROC_DisappearOutOfSight((CHARACTER)S_GLO_SharranInformer_b2cf2efe-ec06-48cd-8fb7-ad596d61164f, "Walk", 0, "");
		
		IF
		RequestPickpocket(_Player, (CHARACTER)S_GLO_SharranInformer_b2cf2efe-ec06-48cd-8fb7-ad596d61164f)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_SharessCaress_State_SuspectInformer_d04cdaac-c9d6-4330-a2f6-35f3b6b19244)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_SharessCaress_State_SuspectInformer_d04cdaac-c9d6-4330-a2f6-35f3b6b19244);
		
		QRY
		QRY_OriginMoment_PreventRelaunchDialog((DIALOGRESOURCE)WYR_RefugeeCamp_OM_Shadowheart_AOM_OOM_ab6223f9-eeca-ef54-8c63-92b9f1a6eba9, _, _)
		AND
		DB_GlobalFlag((FLAG)ORI_Shadowheart_Event_InformerLeaves_dff4a662-897b-486d-aa5c-221f1f2217d5)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_OriginMoment_PreventRelaunchDialog((DIALOGRESOURCE)WYR_RefugeeCamp_OM_Shadowheart_COM_64277eb5-3c13-6da6-9184-0cfe7805c5c3, _, _)
		AND
		DB_GlobalFlag((FLAG)ORI_Shadowheart_Event_InformerLeaves_dff4a662-897b-486d-aa5c-221f1f2217d5)
		THEN
		DB_NOOP(1);
		
		IF
		AddedTo(_RingPart, _Player, _)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_RefugeeCamp_Knows_StolenRing_a0ee6871-475e-4964-922c-7119099f4506)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		DB_WYR_RefugeeCamp_RingPart((ITEM)_RingPart)
		AND
		NOT DB_WYR_RefugeeCamp_RingPartsRecovered(_RingPart, _)
		THEN
		DB_WYR_RefugeeCamp_RingPartsRecovered(_RingPart, _Player);
		
		IF
		DB_WYR_RefugeeCamp_RingPartsRecovered(_RingPart, _Player)
		AND
		DB_WYR_RefugeeCamp_RingPartsRecovered(_OtherRingPart, _)
		AND
		_OtherRingPart != _RingPart
		AND
		NOT DB_GlobalFlag((FLAG)WYR_RefugeeCamp_Knows_StolenRing_a0ee6871-475e-4964-922c-7119099f4506)
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)WYR_RefugeeCamp_VB_RecoveredRing_029471d3-6db9-87dc-a236-6587d80e3949, (CHARACTER)_Player);
		PROC_GlobalSetFlagAndCache((FLAG)WYR_RefugeeCamp_Knows_StolenRing_a0ee6871-475e-4964-922c-7119099f4506);
		
		IF
		FlagSet((FLAG)WYR_RefugeeCamp_State_InformerGoodsAvailable_a8b387b1-c404-48ef-840f-0d23af63083e, _, _)
		THEN
		PROC_SetCustomTradeTreasure((CHARACTER)S_GLO_SharranInformer_b2cf2efe-ec06-48cd-8fb7-ad596d61164f, "WYR_SharranInformer_Extended");
		
		
		//END_REGION
		
		
		//REGION Random Incurable Wound Flare-Ups
		
		//RANDOM INCURABLE WOUND FLARES
		
		IF
		DB_InRegion(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679, _WorldGossipTrigger)
		AND
		DB_WorldGossipTrigger(_WorldGossipTrigger, 0, _)
		AND
		IsTagged(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679, (TAG)SHADOWHEART_ENEMYOFSHARPATH_8eca8027-996c-4c61-bec6-77f853de295b, 1)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Shadowheart_State_RejectShar_KilledParents_e9060caf-66b0-4701-8dfd-5ae1125f5afd)
		AND
		NOT DB_ORI_Shadowheart_IncurableWound_RandomFlareQueued(_)
		AND
		NOT QRY_ORI_Shadowheart_PartyUnavailable()
		AND
		Random(10, _Random)
		AND
		_Random >= 8
		THEN
		PROC_IncreaseCounter("ORI_Shadowheart_IncurableWoundFlares");
		DB_ORI_Shadowheart_IncurableWound_RandomFlareQueued(1);
		TimerLaunch("ORI_Shadowheart_IncurableWound_RandomFlareUp", 5000);
		
		IF
		TimerFinished("ORI_Shadowheart_IncurableWound_RandomFlareUp")
		AND
		DB_ORI_Shadowheart_IncurableWound_RandomFlareQueued(_)
		THEN
		NOT DB_ORI_Shadowheart_IncurableWound_RandomFlareQueued(1);
		PROC_ORI_Shadowheart_IncurableWound_TryAutomatedFlareUp();
		
		QRY
		QRY_ORI_Shadowheart_PartyUnavailable()
		AND
		DB_Players(_Player)
		AND
		DB_Is_InCombat(_Player, _)
		AND
		QRY_SpeakerIsInDialogRange(_Player, S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_ORI_Shadowheart_PartyUnavailable()
		AND
		DB_Players(_Player)
		AND
		NOT QRY_SpeakerIsAvailable(_Player)
		AND
		QRY_SpeakerIsInDialogRange(_Player, S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		THEN
		DB_NOOP(1);
		
		//END_REGION
	}
	EXIT
	{
	}
}
