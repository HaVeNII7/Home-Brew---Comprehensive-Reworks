		DB_GLO_ScryingEye_PerRegionCrime((FLAG)GOB_ScryingEyes_State_ActedHostile_6d856772-02c4-4d20-812a-99af5c6dde37,(TRIGGER)S_GOB_PriestDungeon_SUB_d693268c-84c9-44c2-ac7d-11ebc5524764);
