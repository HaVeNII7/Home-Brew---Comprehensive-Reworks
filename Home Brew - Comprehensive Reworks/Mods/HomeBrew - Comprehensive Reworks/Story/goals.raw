		DB_DEN_InDenTriggers((TRIGGER)S_DEN_DruidVault_SUB_f4c22466-5963-4192-b939-f1056f4f806a);
		DB_DEN_InDenTriggers((TRIGGER)S_DEN_EntranceArea_27796261-6c41-4fa2-8afe-6616d7d3e176);
		DB_DEN_InDenTriggers((TRIGGER)S_DEN_TieflingLeader_SUB_f667e6fe-2b30-4509-9bba-7918bb71a2a7);
		
