		DB_SCL_HarperScouts_WarningTriggers((TRIGGER)S_SCL_WrongLeaveWarningBounds_baca064d-7be3-44e7-8f4d-3540d6a21c95, (CHARACTER)S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b, (DIALOGRESOURCE)SCL_HarperScouts_AD_HarperScout_003_WrongWarning_128b9da4-14a9-225a-04e5-2967fe2529a4, "SCL_HarperScouts_WrongWarning");
		
		DB_SCL_HarperScouts_WarningTriggers((TRIGGER)S_SCL_LeaveWarningBounds_cab70241-a1f2-44a5-8909-504076731bc6, (CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (DIALOGRESOURCE)SCL_HarperScouts_AD_HarperScout_000_LeaveWarning_65e172d6-4d6d-e695-33be-8ccd7828e061, "SCL_HarperScouts_LeaveWarning");
		DB_SCL_HarperScouts_WarningTriggers((TRIGGER)S_SCL_LeaveWarningBounds_cab70241-a1f2-44a5-8909-504076731bc6, (CHARACTER)S_SCL_HarperScout_001_25e154f6-d762-4bea-862e-98c48d7ebe3e, (DIALOGRESOURCE)SCL_HarperScouts_AD_HarperScout_001_LeaveWarning_9f66356a-26f4-7e0f-4423-c2440fc2819c, "SCL_HarperScouts_LeaveWarning");
		DB_SCL_HarperScouts_WarningTriggers((TRIGGER)S_SCL_LeaveWarningBounds_cab70241-a1f2-44a5-8909-504076731bc6, (CHARACTER)S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b, (DIALOGRESOURCE)SCL_HarperScouts_AD_HarperScout_003_LeaveWarning_e9459f73-26e3-b1e2-6031-8e037af6bcef, "SCL_HarperScouts_LeaveWarning");
		
		DB_GlobalFlagReactionAfterDialog((FLAG)SCL_HarperScouts_State_ReadyToDepart_cb5da596-761f-402c-a52f-9d9137cae70b, (DIALOGRESOURCE)SCL_HarperScouts_PostCombat_HarperScout_000_46f295a9-f1b2-afcc-fea8-610b19c6266d);
		DB_GlobalFlagReactionAfterDialog((FLAG)SCL_HarperScouts_State_ReadyToDepart_cb5da596-761f-402c-a52f-9d9137cae70b, (DIALOGRESOURCE)SCL_HarperScouts_PostCombat_HarperScout_001_38fb86ee-e741-7f16-527f-98ad593e1093);
		DB_GlobalFlagReactionAfterDialog((FLAG)SCL_HarperScouts_State_ReadyToDepart_cb5da596-761f-402c-a52f-9d9137cae70b, (DIALOGRESOURCE)SCL_HarperScouts_PostCombat_HarperScout_003_72227de3-d142-e47a-ef4c-1810468690a9);
		
		DB_HasItemEvent((ITEM)S_SCL_HarperBlade_ae92ab6e-f0dc-4d4c-a1b2-b84f01325db6,(FLAG)SCL_HarperScouts_State_HasHarperBlade_2da5704d-ed58-4963-b60a-82d4b7d2a29a);
		DB_GiveItemToEvent((ITEM)S_SCL_HarperBlade_ae92ab6e-f0dc-4d4c-a1b2-b84f01325db6, (FLAG)SCL_HarperScouts_Event_GiveHarperBlade_3542bf04-5052-4dfc-8efc-fe52ddf7ef9d);
		DB_DialogMoneyTransfer(1, (DIALOGRESOURCE)HAV_HarperScouts_Harper_001_b9717f5c-9afa-5338-0411-9049bb3b921c, 500, 1, 1);
		
		DB_SCL_HarperScouts_ReturnLassandraToRitualFlags((FLAG)SCL_Drider_State_HarpersBackAtInn_9e0b8ee1-ccf7-4645-92da-4ec8be45508e);
		
		DB_SpotPlayers_SpotTrigger_ManualRegistering(S_SCL_HarperScoutBoundary_848ffc59-2524-4df0-a4c8-b6067741ee2a);
		
		PROC_SCL_HarperScouts_Init();
		
		// Combat NPC Reactivity
		DB_CombatReact_AD_OnNextTurn(S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (DIALOGRESOURCE)SCL_HarperScouts_AD_HarperScout_000_Combat_9495459c-cf6f-1e44-ea3d-641da8ebe19b);
		DB_CombatReact_AD_OnNextTurn(S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (DIALOGRESOURCE)SCL_HarperScouts_AD_HarperScout_000_Combat2_9c278c13-063e-df6a-c7fc-b843b67b3731);
		DB_CombatReact_AD_OnNextTurn(S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (DIALOGRESOURCE)SCL_HarperScouts_AD_HarperScout_000_Combat3_99988a3d-1baa-73c4-f21b-31f7fa23e168);
		DB_CombatReact_AD_OnNextTurn(S_SCL_HarperScout_001_25e154f6-d762-4bea-862e-98c48d7ebe3e, (DIALOGRESOURCE)SCL_HarperScouts_AD_HarperScout_001_Combat_98b745d0-cfcb-8b11-2913-2a94411da5cb);
		DB_CombatReact_AD_OnNextTurn(S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b, (DIALOGRESOURCE)SCL_HarperScouts_AD_HarperScout_003_Combat_d51ef7d9-4449-0fb9-53b5-08946ab565ea);
	}
	KB
	{
		//REGION Init
		
		PROC
		PROC_SCL_HarperScouts_Init()
		AND
		DB_SCL_HarperScouts_ShadowCreatures(_Creature)
		THEN
		DB_GLO_DefeatCounter(_Creature, "SCL_HarperScouts_ShadowsDefeated");
		SetOnStage(_Creature, 0);
		
		PROC
		PROC_SCL_HarperScouts_Init()
		AND
		DB_SCL_HarperScouts_Scouts(_Harper)
		THEN
		TriggerRegisterForCharacter(S_SCL_HarperBridge_b68e6789-b6d3-4b39-866c-78dcfb37e7f0, _Harper);
		DB_GLO_DefeatCounter(_Harper, "SCL_HarperScouts_HarpersDefeated");
		DB_SceneManager(_Harper, "SCL_HarperScouts_PreShadowsEncounter");
		
		PROC
		PROC_SCL_HarperScouts_Init()
		THEN
		PROC_SCL_HarperScouts_StartSpotting();
		//END_REGION
		
		//REGION Dialogue
		IF
		EnteredTrigger(_Player, S_SCL_HarperScoutBoundary_848ffc59-2524-4df0-a4c8-b6067741ee2a)
		AND
		NOT DB_HiddenCharacters(_Player, _)
		AND
		QRY_SCL_HarperScouts_TryStartShadowCreaturesDialog((CHARACTER)_Player)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_SCL_HarperScouts_StartSpotting()
		AND
		NOT DB_OnlyOnce("SCL_HarperScouts_ScoutsFight")
		AND
		NOT DB_GlobalFlag((FLAG)SCL_HarperScouts_State_InspectionFinished_5356e1fa-6d0b-43cd-9635-62a309096ad1)
		AND
		NOT DB_GlobalFlag((FLAG)SCL_HarperScouts_State_HostileTowardsPlayers_9db27c4a-7fdd-46fc-b290-bc9258364078)
		AND
		QRY_OnlyOnce("SCL_HarperScouts_SetSpotEventsPreShadows")
		AND
		DB_SCL_HarperScouts_AllScouts(_Scout)
		THEN
		DB_SpotPlayers(_Scout, "SCL_ScoutHarpers_WaitingAtShadowsEncounter", NULL_00000000-0000-0000-0000-000000000000, (FLAG)SCL_HarperScouts_Event_StopShadowsEncounterSpotEvents_2b3951c8-4074-4e77-b8b3-db7e3321c75f);
		DB_SpotPlayers_Continuous(_Scout, "SCL_ScoutHarpers_WaitingAtShadowsEncounter");
		DB_SpotPlayers_SpotTrigger(_Scout, "SCL_ScoutHarpers_WaitingAtShadowsEncounter", S_SCL_HarperScoutBoundary_848ffc59-2524-4df0-a4c8-b6067741ee2a);
		
		PROC
		PROC_SpotPlayers_Spotted(_, "SCL_ScoutHarpers_WaitingAtShadowsEncounter", _Player)
		AND
		NOT DB_SCL_HarperScouts_TrackedPlayers(_Player)
		THEN
		DB_SCL_HarperScouts_TrackedPlayers(_Player);
		SetFlag(SCL_HarperScouts_State_PlayerBeingSeen_d7c2103b-032f-4491-a4a2-fb2aea7ae7ff, _Player);
		
		PROC
		PROC_SpotPlayers_Spotted(_, "SCL_ScoutHarpers_WaitingAtShadowsEncounter", _Player)
		AND
		QRY_SCL_HarperScouts_TryStartShadowCreaturesDialog((CHARACTER)_Player)
		THEN
		DB_NOOP(1);
		
		IF
		LeftTrigger(_Player, S_SCL_HarperScoutBoundary_848ffc59-2524-4df0-a4c8-b6067741ee2a)
		THEN
		ClearFlag(SCL_HarperScouts_State_PlayerBeingSeen_d7c2103b-032f-4491-a4a2-fb2aea7ae7ff, _Player);
		
		// Flag cleanup
		IF
		DialogEnded(SCL_HarperScouts_ShadowCreatures_f0f39648-db0f-8153-e626-185cae06033f, _DialogID)
		AND
		NOT DB_DialogRequestFailed(SCL_HarperScouts_ShadowCreatures_f0f39648-db0f-8153-e626-185cae06033f, _DialogID) 
		AND
		DB_SCL_HarperScouts_TrackedPlayers(_Player)
		THEN
		ClearFlag(SCL_HarperScouts_State_PlayerBeingSeen_d7c2103b-032f-4491-a4a2-fb2aea7ae7ff, _Player);
		
		IF
		FlagCleared(SCL_HarperScouts_State_PlayerBeingSeen_d7c2103b-032f-4491-a4a2-fb2aea7ae7ff, (CHARACTER)_Player, _)
		THEN
		NOT DB_SCL_HarperScouts_TrackedPlayers(_Player);
		
		QRY
		QRY_SCL_HarperScouts_TryStartShadowCreaturesDialog((CHARACTER)_Player)
		AND
		NOT DB_GlobalFlag((FLAG)SCL_HarperScouts_State_HostileTowardsPlayers_9db27c4a-7fdd-46fc-b290-bc9258364078)
		AND
		QRY_SpeakerIsAvailable(_Player)
		AND
		QRY_SCL_HarperScouts_CheckEntry((CHARACTER)_Player)
		AND
		QRY_StartDialogCustom((DIALOGRESOURCE)SCL_HarperScouts_ShadowCreatures_f0f39648-db0f-8153-e626-185cae06033f, (CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (CHARACTER)S_SCL_HarperScout_001_25e154f6-d762-4bea-862e-98c48d7ebe3e, (CHARACTER)S_SCL_HarperScout_002_a0fecf82-7dde-4dd7-af67-eb0ef5aa67e0, (CHARACTER)S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b, _Player, 1, 1, 0, 0)
		THEN
		PROC_SceneOver("SCL_HarperScouts_PreShadowsEncounter");
		SetFlag((FLAG)SCL_HarperScouts_Event_StopShadowsEncounterSpotEvents_2b3951c8-4074-4e77-b8b3-db7e3321c75f, NULL_00000000-0000-0000-0000-000000000000);
		DB_OnlyOnce("SCL_HarperScouts_ScoutsFight");
		
		IF
		DialogEnded((DIALOGRESOURCE)SCL_HarperScouts_ShadowCreatures_f0f39648-db0f-8153-e626-185cae06033f, _DialogID)
		AND
		NOT DB_DialogRequestFailed((DIALOGRESOURCE)SCL_HarperScouts_ShadowCreatures_f0f39648-db0f-8153-e626-185cae06033f, _DialogID)
		THEN
		PROC_TriggerUnregisterForPlayers((TRIGGER)S_SCL_HarperScoutBoundary_848ffc59-2524-4df0-a4c8-b6067741ee2a);
		
		QRY
		QRY_SCL_HarperScouts_CheckEntry((CHARACTER)_Player)
		AND
		DB_InRegion(_Player, (TRIGGER)S_SCL_JumpEntryBounds_3a79de8a-ce23-4a01-8e02-7eebbb49b79c)
		THEN
		SetFlag((FLAG)SCL_HarperScouts_State_EnteredAbove_fc7d57fa-8c08-4e5a-8a88-67bd60887f14, NULL_00000000-0000-0000-0000-000000000000);
		
		QRY
		QRY_SCL_HarperScouts_CheckEntry((CHARACTER)_Player)
		AND
		NOT DB_InRegion(_Player, (TRIGGER)S_SCL_JumpEntryBounds_3a79de8a-ce23-4a01-8e02-7eebbb49b79c)
		THEN
		DB_NOOP(1);
		
		IF
		FlagSet((FLAG)SCL_HarperScouts_Event_ScoutVanishes_ffdee55f-1908-41cf-be3b-559ea382db71, NULL_00000000-0000-0000-0000-000000000000, _)
		THEN
		PROC_Poof((CHARACTER)S_SCL_HarperScout_002_a0fecf82-7dde-4dd7-af67-eb0ef5aa67e0);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)SCL_HarperScouts_Event_ShadowCreaturesAppear_8fdb80e6-59fa-4582-8cb0-f44c7f646004)
		AND
		DB_SCL_HarperScouts_ShadowCreatures(_Creature)
		THEN
		PROC_Appear(_Creature);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)SCL_HarperScouts_Event_ShadowCreaturesAppear_8fdb80e6-59fa-4582-8cb0-f44c7f646004)
		THEN
		DB_SCL_HarperScouts_ResurrectingHarperScout(1);
		Resurrect(S_SCL_HarperScout_002_a0fecf82-7dde-4dd7-af67-eb0ef5aa67e0, NULL_00000000-0000-0000-0000-000000000000, 1);
		
		IF
		Resurrected(S_SCL_HarperScout_002_a0fecf82-7dde-4dd7-af67-eb0ef5aa67e0)
		AND
		DB_SCL_HarperScouts_ResurrectingHarperScout(1)
		THEN
		NOT DB_SCL_HarperScouts_ResurrectingHarperScout(1);
		PROC_Foop((CHARACTER)S_SCL_HarperScout_002_a0fecf82-7dde-4dd7-af67-eb0ef5aa67e0);
		ApplyStatus(S_SCL_HarperScout_002_a0fecf82-7dde-4dd7-af67-eb0ef5aa67e0, "SCL_SHADOW_CURSE_UNDEAD_NEW", -1.0, 1);
		//END_REGION
		
		//REGION Fight
		// We need the harpers for the shadowcurse scene. If any of them is defeated they become hostile towards the player.
		IF
		DB_Defeated(_Scout)
		AND
		DB_SceneManager((CHARACTER)_Scout, "SCL_HarperScouts_PreShadowsEncounter")
		THEN
		PROC_SceneOver("SCL_HarperScouts_PreShadowsEncounter");
		PROC_SetRelationToPlayers((FACTION)Act2_SCL_HarperScouts_4581a713-8023-4ceb-b4ae-2c740e7f1e73, 0);
		SetFlag((FLAG)SCL_HarperScouts_State_HostileTowardsPlayers_9db27c4a-7fdd-46fc-b290-bc9258364078, NULL_00000000-0000-0000-0000-000000000000);
		SetFlag((FLAG)SCL_HarperScouts_Event_StopShadowsEncounterSpotEvents_2b3951c8-4074-4e77-b8b3-db7e3321c75f, NULL_00000000-0000-0000-0000-000000000000);
		PROC_TriggerUnregisterForPlayers((TRIGGER)S_SCL_HarperScoutBoundary_848ffc59-2524-4df0-a4c8-b6067741ee2a);
		
		//REGION Shadow Mechanic AD
		
		IF
		TurnStarted((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3)
		AND
		DB_Is_InCombat((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, _CombatID)
		AND
		DB_SCL_HarperScouts_ShadowCreatures(_Shade)
		AND
		DB_Is_InCombat(_Shade, _CombatID)
		AND
		QRY_OnlyOnce("SCL_HarperScouts_ExplainedShadows")
		AND
		NOT QRY_StartDialogCustom((DIALOGRESOURCE)SCL_HarperScouts_AD_HarperScout000_ExplainShadows_6dce778d-37a4-1cbb-1743-da2b84a35e3d, (CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, 1, 1, 0, 0)
		THEN
		NOT DB_OnlyOnce("SCL_HarperScouts_ExplainedShadows");
		
		//END_REGION
		
		//Defeated Shadow Creatures
		PROC 
		PROC_GLO_DefeatCounter_AllPermaDefeated("SCL_HarperScouts_ShadowsDefeated")
		THEN
		NOT DB_OnlyOnce("SCL_HarperScouts_ScoutsFight");
		
		IF
		DB_GlobalFlag((FLAG)SCL_HarperScouts_State_ShadowsDefeated_bae50f7d-7347-4fb7-ae8a-9fda8f84fc9f)
		AND
		DB_SCL_HarperScouts_Scouts(_Harper)
		AND
		NOT DB_Defeated(_Harper)
		AND
		QRY_OnlyOnce("SCL_HarperScouts_StartedSpotting")
		THEN
		DB_SpotPlayers((CHARACTER)_Harper, "SCL_HarperScouts_LookForPlayer", NULL_00000000-0000-0000-0000-000000000000, (FLAG)SCL_HarperScouts_Event_StopSpotting_0e891f30-c522-4882-a05b-f444eb320a55);
		DB_SpotPlayers_TargetIgnoreCantTalk((CHARACTER)_Harper, "SCL_HarperScouts_LookForPlayer");
		
		PROC
		PROC_SpotPlayers_Spotted((CHARACTER)_Harper, "SCL_HarperScouts_LookForPlayer", (CHARACTER)_Party)
		AND
		QRY_OnlyOnce("SCL_HarperScouts_PlayerFound")
		THEN
		SetFlag((FLAG)SCL_HarperScouts_Event_StopSpotting_0e891f30-c522-4882-a05b-f444eb320a55, NULL_00000000-0000-0000-0000-000000000000);
		PROC_DCL_HarperScouts_PlayerFoundDialogue((CHARACTER)_Harper, (CHARACTER)_Party);
		
		PROC
		PROC_DCL_HarperScouts_PlayerFoundDialogue((CHARACTER)_Harper, (CHARACTER)_Party)
		AND
		DB_SCL_HarperScouts_AfterCombatDialogues(_Harper, _Dialog)
		AND
		QRY_StartDialog(_Dialog, _Harper, _Party)
		THEN
		DB_NOOP(1);
		
		IF
		FlagSet(SCL_HarperScouts_State_ShadowsDefeated_bae50f7d-7347-4fb7-ae8a-9fda8f84fc9f, _, _)
		THEN
		NOT DB_CombatReact_AD_OnNextTurn(S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (DIALOGRESOURCE)SCL_HarperScouts_AD_HarperScout_000_Combat_9495459c-cf6f-1e44-ea3d-641da8ebe19b);
		NOT DB_CombatReact_AD_OnNextTurn(S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (DIALOGRESOURCE)SCL_HarperScouts_AD_HarperScout_000_Combat2_9c278c13-063e-df6a-c7fc-b843b67b3731);
		NOT DB_CombatReact_AD_OnNextTurn(S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (DIALOGRESOURCE)SCL_HarperScouts_AD_HarperScout_000_Combat3_99988a3d-1baa-73c4-f21b-31f7fa23e168);
		NOT DB_CombatReact_AD_OnNextTurn(S_SCL_HarperScout_001_25e154f6-d762-4bea-862e-98c48d7ebe3e, (DIALOGRESOURCE)SCL_HarperScouts_AD_HarperScout_001_Combat_98b745d0-cfcb-8b11-2913-2a94411da5cb);
		NOT DB_CombatReact_AD_OnNextTurn(S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b, (DIALOGRESOURCE)SCL_HarperScouts_AD_HarperScout_003_Combat_d51ef7d9-4449-0fb9-53b5-08946ab565ea);
		
		
		//END_REGION
		
		//REGION
		
		//REGION Leave Warnings
		
		QRY
		QRY_SCL_HarperScouts_CheckForPlayers((CHARACTER)_Char)
		AND
		DB_Players(_Player)
		AND
		_Player != _Char
		AND
		DB_InRegion(_Char, (TRIGGER)S_SCL_WarningBounds_ffb1bcd4-3549-4369-be68-f4499aec87a1)
		THEN
		DB_NOOP(1);
		
		IF
		EnteredTrigger(_Char, _Trigger)
		AND
		DB_SCL_HarperScouts_WarningTriggers(_Trigger, _Harper, _AD, _OnlyOnce)
		AND
		NOT DB_OnlyOnce(_OnlyOnce)
		AND
		DB_GlobalFlag((FLAG)SCL_HarperScouts_State_ShadowsDefeated_bae50f7d-7347-4fb7-ae8a-9fda8f84fc9f)
		AND
		NOT DB_GlobalFlag((FLAG)SCL_HarperScouts_Event_DepartFromBattle_4705c3d6-b8fd-4486-827e-d100e6b5c5fd)
		AND
		DB_InRegion(_Char, (TRIGGER)S_SCL_WarningBounds_ffb1bcd4-3549-4369-be68-f4499aec87a1)
		AND
		NOT QRY_SCL_HarperScouts_CheckForPlayers((CHARACTER)_Char)
		AND
		QRY_SpeakerIsAvailable(_Harper)
		AND
		QRY_OnlyOnce(_OnlyOnce)
		THEN
		PROC_TryStartAD(_AD, _Harper);
		
		IF
		LeftTrigger(_Player, (TRIGGER)S_SCL_LeaveWarningBounds_cab70241-a1f2-44a5-8909-504076731bc6)
		AND
		DB_GlobalFlag((FLAG)SCL_HarperScouts_State_ShadowsDefeated_bae50f7d-7347-4fb7-ae8a-9fda8f84fc9f)
		AND
		NOT DB_GlobalFlag((FLAG)SCL_HarperScouts_Event_DepartFromBattle_4705c3d6-b8fd-4486-827e-d100e6b5c5fd)
		AND
		NOT QRY_SCL_HarperScouts_CheckForPlayers((CHARACTER)_Player)
		AND
		DB_OnlyOnce("SCL_HarperScouts_LeaveWarning")
		AND
		QRY_OnlyOnce("SCL_HarperScouts_HarpersFollowing")
		THEN
		PROC_RemoveDialog((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3);
		PROC_RemoveDialog((CHARACTER)S_SCL_HarperScout_001_25e154f6-d762-4bea-862e-98c48d7ebe3e);
		PROC_RemoveDialog((CHARACTER)S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b);
		SetFlag((FLAG)SCL_HarperScouts_Event_DepartFromBattle_4705c3d6-b8fd-4486-827e-d100e6b5c5fd, NULL_00000000-0000-0000-0000-000000000000);
		PROC_SCL_HarperScouts_Update();
		
		
		//END_REGION
		
		PROC 
		PROC_GLO_DefeatCounter_AllPermaDefeated("SCL_HarperScouts_ShadowsDefeated")
		THEN
		DB_Dialogs((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (DIALOGRESOURCE)SCL_HarperScouts_PostCombat_HarperScout_000_46f295a9-f1b2-afcc-fea8-610b19c6266d);
		DB_Dialogs((CHARACTER)S_SCL_HarperScout_001_25e154f6-d762-4bea-862e-98c48d7ebe3e, (DIALOGRESOURCE)SCL_HarperScouts_PostCombat_HarperScout_001_38fb86ee-e741-7f16-527f-98ad593e1093);
		DB_Dialogs((CHARACTER)S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b, (DIALOGRESOURCE)SCL_HarperScouts_PostCombat_HarperScout_003_72227de3-d142-e47a-ef4c-1810468690a9);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)SCL_HarperScouts_State_ReadyToDepart_cb5da596-761f-402c-a52f-9d9137cae70b)
		THEN
		NOT DB_GLO_CharacterCorpseDialog((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (DIALOGRESOURCE)SCL_HarperScouts_Dead_HarperScout_000_af5dc334-616f-1716-de74-59fa2a603e15);
		PROC_RemoveDialog((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3);
		PROC_RemoveDialog((CHARACTER)S_SCL_HarperScout_001_25e154f6-d762-4bea-862e-98c48d7ebe3e);
		PROC_RemoveDialog((CHARACTER)S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b);
		SetFlag((FLAG)SCL_HarperScouts_Event_DepartFromBattle_4705c3d6-b8fd-4486-827e-d100e6b5c5fd, NULL_00000000-0000-0000-0000-000000000000);
		PROC_SCL_HarperScouts_Update();
		
		PROC
		PROC_SCL_HarperScouts_Update()
		AND
		DB_SCL_HarperScouts_Scouts((CHARACTER)_Scout)
		AND
		NOT DB_SCL_HarperScouts_ForceUpdatedScouts(_Scout)
		THEN
		DB_SCL_HarperScouts_ForceUpdatedScouts(_Scout);
		SetForceUpdate(_Scout, 1);
		
		IF
		LeftTrigger(_Player, (TRIGGER)S_SCL_ScoutLeaveBounds_fac2013e-649b-43e0-aafe-9dca0257dc6d)
		AND
		NOT DB_InRegion(_, (TRIGGER)S_SCL_ScoutLeaveBounds_fac2013e-649b-43e0-aafe-9dca0257dc6d)
		THEN
		PROC_SCL_HarperScouts_HarpersDepartAlone();
		
		IF
		FlagSet(HAV_EnteringHaven_State_GainedAccess_07c776da-353a-9050-e9be-c42d51a99412, _, _)
		THEN
		PROC_SCL_HarperScouts_HarpersDepartAlone();
		
		PROC
		PROC_SCL_HarperScouts_HarpersDepartAlone()
		AND
		NOT DB_OnlyOnce("SCL_HarperScouts_ScoutsFight")
		AND
		NOT DB_GlobalFlag((FLAG)SCL_HarperScouts_State_HarpersDefeated_40be395c-f852-49ee-a30c-6531fbacd59c)
		AND
		NOT DB_InRegion(_, (TRIGGER)S_SCL_ScoutLeaveBounds_fac2013e-649b-43e0-aafe-9dca0257dc6d)
		AND
		NOT DB_GlobalFlag((FLAG)SCL_HarperScouts_Event_DepartFromBattle_4705c3d6-b8fd-4486-827e-d100e6b5c5fd)
		AND
		NOT DB_GlobalFlag((FLAG)SCL_HarperScouts_State_HostileTowardsPlayers_9db27c4a-7fdd-46fc-b290-bc9258364078)
		THEN
		PROC_SCL_HarperScouts_Update();
		SetFlag((FLAG)SCL_HarperScouts_Event_StopShadowsEncounterSpotEvents_2b3951c8-4074-4e77-b8b3-db7e3321c75f, NULL_00000000-0000-0000-0000-000000000000);
		SetFlag((FLAG)SCL_HarperScouts_Event_StopSpotting_0e891f30-c522-4882-a05b-f444eb320a55, NULL_00000000-0000-0000-0000-000000000000);
		SetFlag((FLAG)SCL_HarperScouts_Event_DepartFromBattle_4705c3d6-b8fd-4486-827e-d100e6b5c5fd, NULL_00000000-0000-0000-0000-000000000000);
		SetFlag((FLAG)SCL_HarperScouts_State_LeftBehind_b2c44b59-7484-482b-90d9-3605bf93ba3d, NULL_00000000-0000-0000-0000-000000000000);
		SetFlag((FLAG)SCL_HarperScouts_State_InspectionFinished_5356e1fa-6d0b-43cd-9635-62a309096ad1, NULL_00000000-0000-0000-0000-000000000000);
		SetFlag((FLAG)SCL_HarperScouts_State_ShadowsDefeated_bae50f7d-7347-4fb7-ae8a-9fda8f84fc9f, NULL_00000000-0000-0000-0000-000000000000);
		SetOnStage(S_SCL_HarperScout_002_a0fecf82-7dde-4dd7-af67-eb0ef5aa67e0, 0);
		PROC_TriggerUnregisterForPlayers((TRIGGER)S_SCL_HarperScoutBoundary_848ffc59-2524-4df0-a4c8-b6067741ee2a);
		
		IF
		FlagSet((FLAG)SCL_HarperScout_State_ArrivedAtBridge_f7204d3b-5abc-40ad-989d-dcc39f77bcca, _Harper, _)
		AND
		NOT DB_GlobalFlag((FLAG)SCL_HarperScouts_State_LeftBehind_b2c44b59-7484-482b-90d9-3605bf93ba3d)
		AND
		DB_SCL_HarperScouts_BridgeDialogues((CHARACTER)_Harper, _Dialogue)
		THEN
		DB_Dialogs(_Harper, _Dialogue);
		
		IF
		FlagSet((FLAG)SCL_HarperScouts_State_InspectionFinished_5356e1fa-6d0b-43cd-9635-62a309096ad1, _Harper, _)
		THEN
		//PROC_RemoveDialog((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3);
		PROC_RemoveDialog((CHARACTER)S_SCL_HarperScout_001_25e154f6-d762-4bea-862e-98c48d7ebe3e);
		PROC_RemoveDialog((CHARACTER)S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b);
		
		IF
		FlagSet((FLAG)SCL_HarperScouts_State_InspectionFinished_5356e1fa-6d0b-43cd-9635-62a309096ad1, _Harper, _)
		AND
		NOT DB_PermaDefeated((CHARACTER)S_SCL_HarperScout_001_25e154f6-d762-4bea-862e-98c48d7ebe3e)
		THEN
		AddGold((CHARACTER)S_SCL_HarperScout_001_25e154f6-d762-4bea-862e-98c48d7ebe3e, 500); // Give her the money for the sword reward.
		
		IF
		DialogEnded((DIALOGRESOURCE)HAV_EnteringHaven_TadpoleCheckpoint_e51408cc-4f7a-5a5f-52e8-caf1359c1d6c, _)
		THEN
		SetFlag((FLAG)SCL_HarperScouts_State_InspectionFinished_5356e1fa-6d0b-43cd-9635-62a309096ad1, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		FlagSet(SCL_HarperScouts_State_Ritual_752f9d97-907d-44f0-b879-478b5c74a353, _, _)
		THEN
		DB_Dialogs((CHARACTER)S_SCL_HarperScout_001_25e154f6-d762-4bea-862e-98c48d7ebe3e, (DIALOGRESOURCE)HAV_HarperScouts_Harper_001_b9717f5c-9afa-5338-0411-9049bb3b921c);
		DB_Dialogs((CHARACTER)S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b, (DIALOGRESOURCE)HAV_HarperScouts_Harper_003_73cb85d0-79f2-bde3-db25-a141c92afd05);
		
		IF
		DB_SCL_ShadowCurse_InSafeZone(S_SCL_HarperScout_001_25e154f6-d762-4bea-862e-98c48d7ebe3e, (TRIGGER)S_ShadowCurse_SafeZone_Haven_f4f81c2b-5428-4d06-a65e-3ba21e105cba)
		AND
		DB_GlobalFlag(SCL_HarperScouts_State_InspectionFinished_5356e1fa-6d0b-43cd-9635-62a309096ad1)
		AND
		DB_EquippedItemSlots(_Slot)
		AND
		GetEquippedItem(S_SCL_HarperScout_001_25e154f6-d762-4bea-862e-98c48d7ebe3e, _Slot, _Torch)
		AND
		IsTagged(_Torch, (TAG)TORCH_a8139e1a-c593-4e0b-88cd-f703f888db83, 1)
		THEN
		DB_SCL_HarperScouts_SheathedAfterUnequipped(_Torch);
		Unequip(S_SCL_HarperScout_001_25e154f6-d762-4bea-862e-98c48d7ebe3e, _Torch);
		
		//Avoids Meygan from turning around while praying if she speaks with the player.
		IF
		DB_SCL_ShadowCurse_InSafeZone(S_SCL_HarperScout_001_25e154f6-d762-4bea-862e-98c48d7ebe3e, (TRIGGER)S_ShadowCurse_SafeZone_Haven_f4f81c2b-5428-4d06-a65e-3ba21e105cba)
		AND
		DB_GlobalFlag(SCL_HarperScouts_State_InspectionFinished_5356e1fa-6d0b-43cd-9635-62a309096ad1)
		AND
		NOT DB_DoNotFace(S_SCL_HarperScout_001_25e154f6-d762-4bea-862e-98c48d7ebe3e)
		THEN
		DB_DoNotFace(S_SCL_HarperScout_001_25e154f6-d762-4bea-862e-98c48d7ebe3e);
		
		IF
		Unequipped(_Torch, S_SCL_HarperScout_001_25e154f6-d762-4bea-862e-98c48d7ebe3e)
		AND
		DB_SCL_HarperScouts_SheathedAfterUnequipped(_Torch)
		THEN
		NOT DB_SCL_HarperScouts_SheathedAfterUnequipped(_Torch);
		SetWeaponUnsheathed(S_SCL_HarperScout_001_25e154f6-d762-4bea-862e-98c48d7ebe3e, 0, 0);
		
		IF
		FlagSet(SCL_HarperScouts_State_Ritual_752f9d97-907d-44f0-b879-478b5c74a353, _, _)
		AND
		NOT DB_Dialogs((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (DIALOGRESOURCE)SCL_Drider_HarperScout_PreparingForAmbush_e499227c-700e-832c-c727-3aa7ebaffa8f)
		THEN
		PROC_RemoveDialog((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3);
		DB_Dialogs((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (DIALOGRESOURCE)HAV_HarperScouts_Harper_000_2741f2b2-7747-3f0d-9801-b018337527be);
		
		IF
		FlagSet(SCL_HarperScouts_State_Ritual_752f9d97-907d-44f0-b879-478b5c74a353, _, _)
		AND
		DB_SCL_HarperScouts_Scouts((CHARACTER)_Scout)
		THEN
		PROC_SCL_HarperScouts_StopForceUpdate(_Scout);
		
		IF
		DB_PermaDefeated(_Scout)
		AND
		DB_SCL_HarperScouts_ForceUpdatedScouts((CHARACTER)_Scout)
		THEN
		PROC_SCL_HarperScouts_StopForceUpdate(_Scout);
		
		PROC
		PROC_SCL_HarperScouts_StopForceUpdate((CHARACTER)_Scout)
		AND
		DB_SCL_HarperScouts_ForceUpdatedScouts(_Scout)
		THEN
		NOT DB_SCL_HarperScouts_ForceUpdatedScouts(_Scout);
		SetForceUpdate(_Scout, 0);
		
		PROC
		PROC_SCL_HarperScouts_StopAllForceUpdate()
		AND
		DB_SCL_HarperScouts_ForceUpdatedScouts(_Scout)
		THEN
		NOT DB_SCL_HarperScouts_ForceUpdatedScouts(_Scout);
		SetForceUpdate(_Scout, 0);
		//END_REGION
		
		//REGION Karrow's torch
		// Equip torch when:
		// 		Lassandra defeated AND Meygan defeated AND not in combat AND not in safe area AND no torch equipped
		IF
		DB_Defeated(S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3)
		AND
		DB_Defeated(S_SCL_HarperScout_001_25e154f6-d762-4bea-862e-98c48d7ebe3e)
		AND
		NOT DB_Is_InCombat(S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b, _)
		AND
		NOT DB_SCL_ShadowCurse_InSafeZone(S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b)
		AND
		NOT DB_CantAct(S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b)
		AND
		NOT DB_SCL_HarperScouts_KarrowWithTorchEquipped(1)
		AND
		IsInInventoryOf((ITEM)S_SCL_HarperScout_003_Torch_e991cf68-de7c-4466-9170-c95e97a3dc10, S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b, 1)
		THEN
		Equip((CHARACTER)S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b, (ITEM)S_SCL_HarperScout_003_Torch_e991cf68-de7c-4466-9170-c95e97a3dc10);
		
		// Unequip torch when
		//	Lassandra not defeated OR Meygan not defeated OR (in safe area AND in combat AND torch equipped)
		PROC
		PROC_StateCleared_Defeated(S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3)
		AND
		DB_SCL_HarperScouts_KarrowWithTorchEquipped(1)
		AND
		NOT DB_CantAct(S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b)
		THEN
		Unequip((CHARACTER)S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b, (ITEM)S_SCL_HarperScout_003_Torch_e991cf68-de7c-4466-9170-c95e97a3dc10);
		
		PROC
		PROC_StateCleared_Defeated(S_SCL_HarperScout_001_25e154f6-d762-4bea-862e-98c48d7ebe3e)
		AND
		DB_SCL_HarperScouts_KarrowWithTorchEquipped(1)
		AND
		NOT DB_CantAct(S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b)
		THEN
		Unequip((CHARACTER)S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b, (ITEM)S_SCL_HarperScout_003_Torch_e991cf68-de7c-4466-9170-c95e97a3dc10);
		
		PROC
		PROC_StateCleared_CantAct(S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b)
		AND
		DB_SCL_HarperScouts_KarrowWithTorchEquipped(1)
		AND
		QRY_SCL_HarperScouts_LassandraOrMeyganNotDefeated()
		THEN
		Unequip((CHARACTER)S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b, (ITEM)S_SCL_HarperScout_003_Torch_e991cf68-de7c-4466-9170-c95e97a3dc10);
		
		IF
		DB_SCL_ShadowCurse_InSafeZone(S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b)
		AND
		DB_SCL_HarperScouts_KarrowWithTorchEquipped(1)
		AND
		NOT DB_CantAct(S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b)
		THEN
		Unequip((CHARACTER)S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b, (ITEM)S_SCL_HarperScout_003_Torch_e991cf68-de7c-4466-9170-c95e97a3dc10);
		
		QRY
		QRY_SCL_HarperScouts_LassandraOrMeyganNotDefeated()
		AND
		NOT DB_Defeated(S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_SCL_HarperScouts_LassandraOrMeyganNotDefeated()
		AND
		NOT DB_Defeated(S_SCL_HarperScout_001_25e154f6-d762-4bea-862e-98c48d7ebe3e)
		THEN
		DB_NOOP(1);
		
		IF
		Equipped((ITEM)S_SCL_HarperScout_003_Torch_e991cf68-de7c-4466-9170-c95e97a3dc10, S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b)
		THEN
		DB_SCL_HarperScouts_KarrowWithTorchEquipped(1);
		
		IF
		Unequipped((ITEM)S_SCL_HarperScout_003_Torch_e991cf68-de7c-4466-9170-c95e97a3dc10, S_SCL_HarperScout_003_9bebec18-ca66-42e9-abce-8d6a5f9d2a1b)
		THEN
		NOT DB_SCL_HarperScouts_KarrowWithTorchEquipped(1);
		//END_REGION Karrow's torch
		
		
		//REGION Lassandra joins the ambush party
		IF
		DB_GlobalFlag(SCL_HarperScouts_State_InspectionFinished_5356e1fa-6d0b-43cd-9635-62a309096ad1) // Only add her when she is at the inn doing the ritual.
		AND
		NOT DB_GlobalFlag(SCL_Drider_State_HarpersAmbushQuestPathBlocked_8d633cd0-5dd6-4732-9cf4-7e6f36911900)
		AND
		NOT DB_GlobalFlag(SCL_Drider_State_HarpersMovingToAmbush_5bde3cff-5e95-4c86-b368-75c744e02411)
		AND
		NOT DB_GlobalFlag(SCL_Drider_State_HarpersBackAtInn_9e0b8ee1-ccf7-4645-92da-4ec8be45508e)
		AND
		NOT DB_Defeated(S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3)
		AND
		NOT DB_SCL_HarperScouts_EndedSituation(1)
		AND
		QRY_OnlyOnce("SCL_HarperScouts_AddLassandraToAmbush")
		THEN
		SetFaction(S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (FACTION)ACT2_SCL_HarpersAmbush_f9940d88-f049-4522-a2ae-4b8304e4563c);
		PROC_RemoveDialog((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3);
		SetFlag(SCL_Drider_State_ScoutJoinedAmbush_ae2912ea-6ee2-42db-b0bf-d0bfa77d70bd, S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3);
		DB_SCL_Drider_HarpersGroup((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (TRIGGER)S_HAV_RitualPoint_000_e0055365-211f-4ab7-80ba-bf2b378da245, (TRIGGER)S_SCL_Drider_HarperScout_000_AmbushPos_a5424473-1b9e-43ff-924c-392783d8ae19);
		DB_SCL_Drider_HarpersGroup_RightBeforeAmbushPos((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (TRIGGER)S_SCL_Drider_HarperScout_000_BeforeAmbushPos_0f25029b-ce51-46bb-88ee-0f91f7f5065c);
		DB_SCL_Drider_HarperBridgePositions((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (TRIGGER)S_SCL_Drider_HarperAtBridge_004_52ed194a-ed83-4a54-8a39-f347304fb846);
		DB_SCL_Drider_HarpersDialoguesAfterAmbush((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (DIALOGRESOURCE)SCL_Drider_HarperScout_AfterAmbush_837cb921-88ab-0b9c-4113-bc092e2dbb1b);
		DB_Inclusion_NPCDialog((DIALOGRESOURCE)SCL_Drider_AD_AllHarpersWaitingAtAmbush_d96f2437-7f6e-58cf-9f0e-052e99886514, (CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3);
		DB_Inclusion_NPCDialog((DIALOGRESOURCE)SCL_Drider_HarpersAtInn_3149228e-e915-8aa7-e9be-daa9880067bf, (CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3);
		DB_SCL_Drider_HarpersDialogues((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (DIALOGRESOURCE)SCL_Drider_HarperScout_PreparingForAmbush_e499227c-700e-832c-c727-3aa7ebaffa8f);
		
		IF
		FlagSet(_Flag, _, _)
		AND
		DB_SCL_HarperScouts_ReturnLassandraToRitualFlags(_Flag)
		THEN
		PROC_SCL_HarperScouts_RemoveLassandraFromAmbush();
		
		PROC
		PROC_SCL_HarperScouts_RemoveLassandraFromAmbush()
		THEN
		SetFaction(S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (FACTION)Act2_SCL_HarperScouts_HarperScout_4581a713-8023-4ceb-b4ae-2c740e7f1e73);
		SetHasDialog(S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, 1);
		ClearFlag(SCL_Drider_State_ScoutJoinedAmbush_ae2912ea-6ee2-42db-b0bf-d0bfa77d70bd, S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3);
		NOT DB_SCL_Drider_HarpersGroup((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (TRIGGER)S_HAV_RitualPoint_000_e0055365-211f-4ab7-80ba-bf2b378da245, (TRIGGER)S_SCL_Drider_HarperScout_000_AmbushPos_a5424473-1b9e-43ff-924c-392783d8ae19);
		NOT DB_SCL_Drider_HarperBridgePositions((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (TRIGGER)S_SCL_Drider_HarperAtBridge_004_52ed194a-ed83-4a54-8a39-f347304fb846);
		NOT DB_SCL_Drider_HarpersDialoguesAfterAmbush((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (DIALOGRESOURCE)SCL_Drider_HarperScout_AfterAmbush_837cb921-88ab-0b9c-4113-bc092e2dbb1b);
		NOT DB_Inclusion_NPCDialog((DIALOGRESOURCE)SCL_Drider_AD_AllHarpersWaitingAtAmbush_d96f2437-7f6e-58cf-9f0e-052e99886514, (CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3);
		NOT DB_SCL_Drider_HarpersDialogues((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (DIALOGRESOURCE)SCL_Drider_HarperScout_PreparingForAmbush_e499227c-700e-832c-c727-3aa7ebaffa8f);
		
		IF
		EntityEvent(S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, "SCL_Drider_HarperReturnsToInn")
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3);
		DB_Dialogs((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, (DIALOGRESOURCE)HAV_HarperScouts_Harper_000_2741f2b2-7747-3f0d-9801-b018337527be);
		//END_REGION
		
		//REGION Assault starts - end quest
		PROC
		PROC_MOO_Assault_SetupMoonrise()
		THEN
		PROC_SCL_HarperScouts_End();
		
		// Logic DB to know when we have to cancel the situation and remove the harpers from Haven checkpoint
		PROC
		PROC_SCL_HarperScouts_End()
		THEN
		DB_SCL_HarperScouts_EndedSituation(1); 
		PROC_SCL_HarperScouts_HarpersDepartAlone();
		SetFlag(SCL_HarperScouts_State_InspectionFinished_5356e1fa-6d0b-43cd-9635-62a309096ad1, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		DB_SCL_HarperScouts_EndedSituation(1)
		AND
		DB_SCL_Drider_HarpersGroup((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, _, _)
		AND
		DB_State_Current((CHARACTER)S_SCL_HarperScout_000_c6dfb2aa-809f-4b3e-8b32-968c10184ec3, "SCL_DriderHarpers", _State)
		AND
		NOT DB_SCL_Drider_HarperDuringAmbushStates(_State)
		THEN
		PROC_SCL_HarperScouts_RemoveLassandraFromAmbush();
		
		IF
		DB_SCL_HarperScouts_EndedSituation(1)
		AND
		DB_SCL_HarperScouts_EndQuestTeleports(_Scout, _Pos)
		AND
		NOT DB_PermaDefeated(_Scout)
		AND
		NOT DB_CustomDefeatedState(_Scout, "SCL_Shadowcurse")
		AND
		NOT DB_GlobalFlag(SCL_HarperScouts_State_Ritual_752f9d97-907d-44f0-b879-478b5c74a353)
		AND
		NOT QRY_SCL_HarperScouts_InDriderAmbush(_Scout)
		AND
		GetFlag(SCL_HarperScout_State_ArrivedAtBridge_f7204d3b-5abc-40ad-989d-dcc39f77bcca, _Scout, 0)
		THEN
		TeleportTo(_Scout, _Pos, "");
		
		QRY
		QRY_SCL_HarperScouts_InDriderAmbush((CHARACTER)_Scout)
		AND
		DB_State_Current(_Scout, "SCL_DriderHarpers", _State)
		AND
		DB_SCL_Drider_HarperDuringAmbushStates(_State)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_SCL_HarperScouts_End()
		AND
		DB_SCL_HarperScouts_AllScouts(_Scout)
		THEN
		TriggerUnregisterForCharacter(S_SCL_HarperBridge_b68e6789-b6d3-4b39-866c-78dcfb37e7f0, _Scout);
		PROC_SCL_HarperScouts_StopForceUpdate(_Scout);
		//END_REGION
		
		// Goal completion
		IF
		LevelLoaded("INT_Main_A")
		THEN
		GoalCompleted;
	}
	EXIT
	{
		PROC_SpotPlayers_CleanupSpotting("SCL_ScoutHarpers_WaitingAtShadowsEncounter");
		PROC_SpotPlayers_CleanupSpotting("SCL_HarperScouts_LookForPlayer");
		PROC_SceneOver("SCL_HarperScouts_PreShadowsEncounter");
		PROC_SCL_HarperScouts_StopAllForceUpdate();
		
		SysClear("DB_SCL_HarperScouts_ShadowCreatures", 1);
		SysClear("DB_SCL_HarperScouts_Scouts", 1);
		SysClear("DB_SCL_HarperScouts_EndQuestTeleports", 2);
		SysClear("DB_SCL_HarperScouts_AllScouts", 1);
		SysClear("DB_SCL_HarperScouts_AfterCombatDialogues", 2);
		SysClear("DB_SCL_HarperScouts_BridgeDialogues", 4);
		SysClear("DB_SCL_HarperScouts_WarningTriggers", 4);
		NOT DB_SCL_HarperScouts_ReturnLassandraToRitualFlags((FLAG)SCL_Drider_State_HarpersBackAtInn_9e0b8ee1-ccf7-4645-92da-4ec8be45508e);
		
		
	}
}
Goal(430).Title("Act2_SCL_Journal");
Goal(430)
{
	INIT
	{
		//REGION Lifting the Curse
		
		DB_QuestDef_State((FLAG)SCL_ShadowCurse_Knows_HeartOfTheLandPurpose_0563ee5c-69c1-4282-8348-1fecda57c475, "SCL_LiftingTheCurse", "HelpHalsin");
		DB_QuestDef_State((FLAG)SCL_AncientFist_Event_PlayerAcknowledgedThanielConnection_b1b27344-cbc6-48e2-a07f-57985ad0b1fc, "SCL_LiftingTheCurse", "ArtMentionsThaniel");
		DB_QuestDef_State((FLAG)HAV_LiftingTheCurse_State_HalsinGoToLake_bc4cd1f7-5e60-40e1-a583-aa886fe5b682, "SCL_LiftingTheCurse", "HalsinRitualReady");
		DB_QuestDef_State((FLAG)HAV_LiftingTheCurse_Event_PortalAppears_333d9c5e-501a-470d-9708-90b9d9b1ec01, "SCL_LiftingTheCurse", "HalsinRitualCombat");
		DB_QuestDef_State((FLAG)SCL_ShadowCurse_Knows_Oliver_Is_Thaniel_56af8bbd-eafe-3861-22a2-c253f16952e2, "SCL_LiftingTheCurse", "SeekOliver");
		DB_QuestDef_State((FLAG)SCL_LiftingTheCurse_State_OliverAgreedToReturnToThaniel_3073ae92-8e87-42d1-a426-fe3e6c5e6deb, "SCL_LiftingTheCurse", "TalkToThaniel");
		//END_REGION
		
		//REGION
		DB_QuestDef_State((FLAG)HAV_CursedFist_Quest_StartedNoFlamingFist_659617b2-a09f-4432-b3c2-6fc455d18894, "SCL_CursedFist", "MetArtNoJehlar");
		DB_QuestDef_State((FLAG)HAV_CursedFist_Quest_StartedWithFlamingFist_4f55c635-19a1-4ef0-96bf-916f87150f8b, "SCL_CursedFist", "MetArt");
		DB_QuestDef_State((FLAG)HAV_Florrick_State_ToldPlayerAboutArt_ce6a6e8e-1cd7-4847-b5ff-ec2504da4ab7, "SCL_CursedFist", "MetFlorrick");
		DB_QuestDef_State((FLAG)HAV_CursedFist_Knows_HalsinNotAvailable_4a9daf4b-d651-9f4a-ecf7-ee57c53c1b36, "SCL_CursedFist", "HalsinAlreadyDead");
		DB_QuestDef_State((FLAG)SCL_AncientFist_Event_PlayerAcknowledgedThanielConnection_b1b27344-cbc6-48e2-a07f-57985ad0b1fc, "SCL_CursedFist", "HeardMentionThaniel");
		DB_QuestDef_State((FLAG)GLO_LiftingTheCurse_Event_TravelToHaven_a946f0b8-badb-435d-915d-2e6a45845c7c, "SCL_CursedFist", "HalsinAtSleepingArt");
		DB_QuestDef_ChainedState("SCL_LiftingTheCurse", "HalsinMetArt", "SCL_CursedFist", "LearnArtsPast");
		
		DB_QuestDef_BookReadState("SCL_CursedFist", "FoundNote", (ITEM)S_HAV_AncientFist_WritOfCommand_80b54d25-5274-4b70-b405-d979eb43a454);
		//END_REGION
	}
	KB
	{
		//REGION Lifting the Curse
		
		IF
		FlagSet((FLAG)CAMP_HalsinQuest_HasMet_WakedThaniel_c7e24553-7c8d-4580-9707-3996e6b37fb3, _, _)
		THEN
		QuestUpdate("SCL_LiftingTheCurse", "KillKetheric");
		
		IF
		DialogEnded(HAV_HalsinQuest_PortalEmerge_603c48af-cffb-2998-f1ee-6f6ece03a4f2, _)
		AND
		NOT DB_Defeated(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		THEN
		QuestUpdate("SCL_LiftingTheCurse", "HalsinRitualComplete");
		
		IF
		FlagSet(HAV_CursedFist_Event_HalsinReactsToThanielMention_57c83dde-fbdb-84ba-363f-9a01f31461e7, _, _)
		THEN
		QuestUpdate("SCL_LiftingTheCurse", "HalsinMetArt");
		
		IF
		DialogEnded(HAV_CursedFist_d19739b9-c366-4272-7306-6ad04076916d, _)
		AND
		NOT DB_GlobalFlag(HAV_LiftingTheCurse_State_HalsinAvailableForFist_38bd3ada-29d4-4a1d-900b-c58799aad3df)
		AND
		NOT DB_GlobalFlag(GLO_Halsin_State_PermaDefeated_86bc3df1-08b4-fbc4-b542-6241bcd03df1)
		AND
		DB_GlobalFlag(SCL_AncientFist_State_HasWokenUpFist_45cddb53-edf5-4a9e-9943-898f55b29af3)
		THEN
		QuestUpdate("SCL_LiftingTheCurse", "GetHalsinForArt");
		
		//SwD path
		IF
		DialogEnded(HAV_CursedFist_Dead_CursedFist_64ae5a17-7924-1ac2-0490-7b2d3f40c057, _)
		AND
		DB_GlobalFlag(HAV_LiftingTheCurse_State_KnowsBreathLocation_cb21724a-b0ee-4aea-a866-2d5f6b55423c)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		NOT DB_PermaDefeated(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		AND
		QuestUpdateIsUnlocked(_Player, "SCL_LiftingTheCurse", "HalsinRitualReady", 0)
		THEN
		QuestUpdate("SCL_LiftingTheCurse", "TellHalsinArt_SwD");
		
		
		IF
		DestroyedBy(S_HAV_HalsinPortal_f2b5ad7f-013c-4c9e-a755-5fe9ff3287f6, _, _, _)
		AND
		NOT DB_GlobalFlag((FLAG)HAV_LiftingTheCurse_State_ChannelingComplete_1afd47bc-e8d5-464d-823a-7dba82fcf5c3)
		THEN
		QuestUpdate("SCL_LiftingTheCurse", "HalsinDied");
		
		PROC
		PROC_LevelLoadedOnce("INT_Main_A")
		AND
		NOT DB_GlobalFlag((FLAG)GLO_LiftingTheCurse_State_BreathHasBeenRestored_2113b54e-a140-4aa0-97ac-219fa7b7d038)
		THEN
		QuestUpdate("SCL_LiftingTheCurse", "OliverNotFound");
		
		IF
		DialogEnded((DIALOGRESOURCE)TWN_Finale_LeavingAct_06d434ac-008b-1994-5dc5-f8fcd681553d, _)
		AND
		DB_GlobalFlag((FLAG)GLO_LiftingTheCurse_State_BreathHasBeenRestored_2113b54e-a140-4aa0-97ac-219fa7b7d038)
		THEN
		QuestUpdate("SCL_LiftingTheCurse", "CurseLifted");
		//END_REGION
		
		//REGION SCL_CursedFist
		IF
		DialogEnded(HAV_CursedFist_d19739b9-c366-4272-7306-6ad04076916d, _)
		AND
		DB_GlobalFlag(HAV_CursedFist_State_CursedFistNotAlone_4d268b7e-76cd-4a54-9878-f86135b24ab8)
		AND
		QRY_OnlyOnce("SCL_CursedFist_QuestStart")
		THEN
		SetFlag(HAV_CursedFist_Quest_StartedWithFlamingFist_4f55c635-19a1-4ef0-96bf-916f87150f8b, NULL_00000000-0000-0000-0000-000000000000, 1);
		
		IF
		DialogEnded(HAV_CursedFist_d19739b9-c366-4272-7306-6ad04076916d, _)
		AND
		NOT DB_GlobalFlag(HAV_CursedFist_State_CursedFistNotAlone_4d268b7e-76cd-4a54-9878-f86135b24ab8)
		AND
		QRY_OnlyOnce("SCL_CursedFist_QuestStart")
		THEN
		SetFlag(HAV_CursedFist_Quest_StartedNoFlamingFist_659617b2-a09f-4432-b3c2-6fc455d18894, NULL_00000000-0000-0000-0000-000000000000, 1);
		
		IF
		AddedTo(S_HAV_AncientFist_ImportantItem_Surgeon_1329c22c-d23a-4d31-96b0-6b734074f1dc,_Player, _)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		QuestUpdateIsUnlocked(_Player, "SCL_CursedFist", "FoundNote", 1)
		AND
		QRY_OnlyOnce("SCL_CursedFist_FoundLute")
		THEN
		QuestUpdate("SCL_CursedFist", "FoundLute");
		PROC_GlobalSetFlagAndCache(SCL_AncientFist_State_KnowsLuteImportant_713fdc97-387d-4baa-8152-a6617d630e44);
		
		IF
		DialogStarted(HAV_CursedFist_d19739b9-c366-4272-7306-6ad04076916d, _ID)
		AND
		DB_DialogRequestCache_SpeakerList_Players(HAV_CursedFist_d19739b9-c366-4272-7306-6ad04076916d, _ID, _Player, _)
		AND
		QuestUpdateIsUnlocked((CHARACTER)_Player, "SCL_CursedFist", "MetArt", 0)
		AND
		QuestUpdateIsUnlocked((CHARACTER)_Player, "SCL_CursedFist", "MetArtNoJehlar", 0)
		AND
		GetFlag(SCL_AncientFist_ItemCollected_e04f808d-6a51-4597-800e-306fdb4f825a, _Player, 1)
		AND
		QRY_OnlyOnce("SCL_CursedFist_FoundLute")
		THEN
		QuestUpdate("SCL_CursedFist", "FoundLuteBeforeArt");
		PROC_GlobalSetFlagAndCache(SCL_AncientFist_State_KnowsLuteImportant_713fdc97-387d-4baa-8152-a6617d630e44);
		
		
		IF
		FlagSet(SCL_AncientFist_FluteHandover_ac2f9c5a-c853-4569-949b-dea5e2c806ea, _, _)
		AND
		DB_GlobalFlag(HAV_LiftingTheCurse_State_HalsinAvailableForFist_38bd3ada-29d4-4a1d-900b-c58799aad3df)
		THEN
		QuestUpdate("SCL_CursedFist", "HalsinThereWhenWoken");
		
		IF
		FlagSet(SCL_AncientFist_FluteHandover_ac2f9c5a-c853-4569-949b-dea5e2c806ea, _, _)
		AND
		DB_PermaDefeated(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		THEN
		QuestUpdate("SCL_CursedFist", "HalsinAlreadyDead");
		
		IF
		DialogEnded(HAV_CursedFist_d19739b9-c366-4272-7306-6ad04076916d,_)
		AND
		GetFlag(SCL_AncientFist_FluteHandover_ac2f9c5a-c853-4569-949b-dea5e2c806ea, S_HAV_AncientFist_MartCullagh_378938e2-2193-49a3-a06e-8e26cc128055, 1)
		AND
		NOT DB_GlobalFlag(HAV_LiftingTheCurse_State_HalsinAvailableForFist_38bd3ada-29d4-4a1d-900b-c58799aad3df)
		THEN
		QuestUpdate("SCL_CursedFist", "BringHalsin");
		
		IF
		DB_PermaDefeated(S_HAV_AncientFist_MartCullagh_378938e2-2193-49a3-a06e-8e26cc128055)
		AND
		DB_QuestIsOpened("SCL_CursedFist")
		THEN
		QuestUpdate("SCL_CursedFist", "ArtDead");
		//END_REGION
		
		//REGION Switch Nightsong Quest to SCL
		IF
		QuestUpdateUnlocked(_, "SHA_Nightsong", "BalthazarSentForNightsong")
		THEN
		QuestSetCategory("SHA_Nightsong", "Shadowcurse");
		
		IF
		QuestUpdateUnlocked(_, "SHA_Nightsong", "FoundSHA")
		THEN
		QuestSetCategory("SHA_Nightsong", "Shadowcurse");
		//END_REGION
		
		//REGION Setting the correct ends for Arabella if her parents were not interacted with after SnakeCourt
		PROC
		PROC_LevelLoadedOnce("SCL_Main_A")
		AND
		DB_GlobalFlag(DEN_ShadowDruid_State_KidFreed_8d9e9065-7bb5-a516-15c3-c9d8c1f4f5e2)
		THEN
		QuestUpdate("DEN_SnakeCourt", "ParentAutoReunited");
		
		PROC
		PROC_LevelLoadedOnce("SCL_Main_A")
		AND
		NOT DB_GlobalFlag(DEN_ShadowDruid_State_KidFreed_8d9e9065-7bb5-a516-15c3-c9d8c1f4f5e2)
		AND
		DB_Avatars(_Avatar)
		AND
		QuestUpdateIsUnlocked((CHARACTER)_Avatar, "DEN_SnakeCourt", "KidDied", 1)
		THEN
		QuestUpdate("DEN_SnakeCourt", "LeftRegion");
		
		PROC
		PROC_LevelLoadedOnce("SCL_Main_A")
		AND
		NOT DB_GlobalFlag(DEN_ShadowDruid_State_KidFreed_8d9e9065-7bb5-a516-15c3-c9d8c1f4f5e2)
		AND
		DB_Avatars(_Avatar)
		AND
		QuestUpdateIsUnlocked((CHARACTER)_Avatar, "DEN_SnakeCourt", "KidDiedFirst", 1)
		THEN
		QuestUpdate("DEN_SnakeCourt", "LeftRegion");
		
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(431).Title("Act2_SCL_LiftingTheCurse_Confrontation");
Goal(431)
{
	INIT
	{
		PROC_TriggerRegisterForPlayers((TRIGGER)S_SCL_OliverHouse_4286e8d8-a8f4-4cc3-be2f-0c3e937c9e40);
