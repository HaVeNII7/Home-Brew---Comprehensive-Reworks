		DB_CustomDialogRange(S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a,157);
		PROC_HAV_Siege_PlayOutro();
		
		PROC
		PROC_HAV_Siege_PlayOutro()
		AND
