		PROC_GLO_KnowledgeCheckEnded(_Player,  _Identifier, _Reference, _AD, 0)
		AND
		NOT DB_KnowledgeSkillCheck_AwaitingResult(_, _Identifier, _Reference, _, _, _) //If you're out of characters (and this is a fail), do the AD.
		AND
