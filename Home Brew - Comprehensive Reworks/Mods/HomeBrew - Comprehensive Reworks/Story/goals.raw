		DB_AddCharactersInTriggerToDialog((DIALOGRESOURCE)SHA_Mausoleum_CINE_DescendingIntoTemple_32499e0a-9705-686a-e670-6c672b7420c2, (TRIGGER)S_SHA_Mausoleum_TeleportToTempleCinematic_94f1090e-22b4-47b7-bde4-cafa7d95d678, 1, 1, 1);
