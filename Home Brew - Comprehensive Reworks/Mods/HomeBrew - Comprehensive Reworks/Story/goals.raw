		DB_BookTemplateFlags((ITEMROOT)UNI_BOOK_LOW_GortashHome_LettersBook_960378af-2689-42d3-9f82-c075eff02bb9, (FLAG)LOW_DevilsFee_Knows_HelsikDiabolistBecauseReportsAndBook_11909130-2e3a-4904-91d4-4567b3f31dea);
		DB_BookTemplateFlags((ITEMROOT)BOOK_LOW_DevilsFee_DiabolistLetter_Ninefingers_63f6945c-0f59-444d-b6f0-b22340b51e38, (FLAG)LOW_DevilsFee_Knows_HelsikDiabolistBecauseReportsAndBook_11909130-2e3a-4904-91d4-4567b3f31dea);
		DB_BookTemplateFlags((ITEMROOT)BOOK_LOW_DevilsFee_ReportActivitesEnverGortash_09d22fe2-20f9-4568-b891-140a595f0bff, (FLAG)LOW_DevilsFee_Knows_HelsikDiabolistBecauseReportsAndBook_11909130-2e3a-4904-91d4-4567b3f31dea);
		DB_BookTemplateFlags((ITEMROOT)BOOK_LOW_DevilsFee_ObserversReport_aa021f7f-d134-4e79-b20a-b3fe248c8e7c, (FLAG)LOW_DevilsFee_Knows_HelsikDiabolistBecauseReportsAndBook_11909130-2e3a-4904-91d4-4567b3f31dea);
		
		DB_BookFlags(S_WYR_RaphaelTango_WarlockRecords_aa42c2a0-2ddd-400e-9cb2-32a7f5f796b6, (FLAG)LOW_DevilsFee_Knows_HelsikWayHoH_6beeb7f7-53ec-c6dc-0261-95b8d7c2fb4e);
		DB_BookFlags(S_WYR_RaphaelTango_WarlockRecords_aa42c2a0-2ddd-400e-9cb2-32a7f5f796b6, (FLAG)LOW_DevilsFee_Knows_HelsikDiabolistBecauseReportsAndBook_11909130-2e3a-4904-91d4-4567b3f31dea);
		
		DB_HasItemEvent((ITEM)S_WYR_KillDirectorGortash_NoticeFromHelsik_95ce82fe-4652-477d-9129-296a82e4a6da, (FLAG)LOW_Helsik_State_PlayersHaveNoticeFromHelsik_158ef353-5eee-44c7-8bf2-8fb89539c358);
		
	}
	KB
	{
		IF
		GameBookInterfaceClosed(_Book, _Player)
		AND
		DB_LOW_DevilsFee_NotesHouseOfHope(_Book)
		AND
