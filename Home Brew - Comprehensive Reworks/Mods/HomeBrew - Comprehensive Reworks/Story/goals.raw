		DB_CrimeDialogFlags(_CrimeFamily,(FLAG)_Flag)
		THEN
		SetFlag((FLAG)_Flag,_NPC);
		
		QRY
		QRY_CRIME_CrimeTypeResolveSourceInvestigation((INTEGER)_CrimeID)
		AND
