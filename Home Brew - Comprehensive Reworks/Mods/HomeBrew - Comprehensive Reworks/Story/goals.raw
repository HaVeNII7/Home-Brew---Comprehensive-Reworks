		DB_LOW_StormshoreTabernacle_Offerings((CHARACTER)S_LOW_Gruumsh_InvisibleHelper_0a7b3a41-e3ee-40ee-96a0-6ae883ecadcf,(FLAG)LOW_StormshoreTabernacle_State_GruumshOfferingGiven_7ef5134c-8773-403e-a25c-d89f7e7cbd74, (TAG)ACT3_LOW_STORMSHORETABERNACLE_GRUUMSH_033b0956-aa65-4cff-9b57-b800d0a3cdc4);
		DB_LOW_StormshoreTabernacle_Offerings((CHARACTER)S_LOW_StormshoreTabernacle_Shar_b61259ec-5aef-4187-84f4-b183b7e7a3b8,(FLAG)LOW_StormshoreTabernacle_State_SharOfferingGiven_742966f3-330f-48d7-86a6-935532991943, (TAG)ACT3_LOW_STORMSHORETABERNACLE_SHAR_2387e65f-1135-401c-b539-310de48d6a85);
		DB_LOW_StormshoreTabernacle_Offerings((CHARACTER)S_LOW_Yondalla_InvisibleHelper_5bf652cd-3714-4427-80b1-a78976b908a9,(FLAG)LOW_StormshoreTabernacle_State_YondallaOfferingGiven_b77a123f-4ac1-4f1b-aa78-db87479d853f, (TAG)ACT3_LOW_STORMSHORETABERNACLE_YONDALLA_9fe3ca2b-0c57-46bb-b5df-98740725cb6f);
		DB_LOW_StormshoreTabernacle_Offerings((CHARACTER)S_LOW_Bhaal_InvisibleHelper_ff31fcbd-e103-40d2-852d-9624e5bb8aa3,(FLAG)LOW_StormshoreTabernacle_State_BhaalOfferingGiven_a2210af2-a37d-4521-a5cd-fed34f044529, (TAG)ACT3_LOW_STORMSHORETABERNACLE_BHAAL_2089f8fe-f812-42a5-be72-8a0739a53f69);
		DB_LOW_StormshoreTabernacle_Offerings((CHARACTER)S_LOW_CorellonLarethian_InvisibleHelper_45fc9b9d-c2ca-4a5f-92a3-4dc52c9ae7ba,(FLAG)LOW_StormshoreTabernacle_State_CorellonLarethianOfferingGiven_54334a50-02dd-4db1-836a-61cd1083ec51, (TAG)ACT3_LOW_STORMSHORETABERNACLE_CORELLON_1e113ed2-99cb-4012-90cd-2be84e5a0ae2);
		DB_LOW_StormshoreTabernacle_Offerings((CHARACTER)S_LOW_Myrkul_InvisibleHelper_43821111-893a-4c2f-b62a-60b47cba1939,(FLAG)LOW_StormshoreTabernacle_State_MyrkulOfferingGiven_a4339775-10d8-4293-a1be-e427e01cd681, (TAG)ACT3_LOW_STORMSHORETABERNACLE_MYRKUL_daf0d9f4-6adf-4b92-ad01-9a2146ec1fed);
		DB_LOW_StormshoreTabernacle_Offerings((CHARACTER)S_LOW_Lathander_InvisibleHelper_ea7befd9-3909-473a-bdc4-7caf159ab841,(FLAG)LOW_StormshoreTabernacle_State_LathanderOfferingGiven_3e9cf14b-b2fa-49a8-935b-7a0b8d1514e3, (TAG)ACT3_LOW_STORMSHORETABERNACLE_LATHANDER_a8877ac1-91ae-4828-a2e7-0e1c39596269);
		DB_LOW_StormshoreTabernacle_Offerings((CHARACTER)S_LOW_Tymora_InvisibleHelper_a1ca2a2b-0516-4d8f-a862-b538a9aa01cd,(FLAG)LOW_StormshoreTabernacle_State_TymoraOfferingGiven_c2e79249-4960-4e3f-a0ba-9335eb6b486c, (TAG)ACT3_LOW_STORMSHORETABERNACLE_TYMORA_81c97b80-afc6-4410-8a08-1183b0efaf09);
		DB_LOW_StormshoreTabernacle_Offerings((CHARACTER)S_LOW_Talos_InvisibleHelper_3d556ae8-d342-49bf-a52a-f92202f44fa5,(FLAG)LOW_StormshoreTabernacle_State_TalosOfferingGiven_55812d41-f79d-46cf-b02a-2c1cc789911b, (TAG)ACT3_LOW_STORMSHORETABERNACLE_TALOS_21cf6608-e7f7-4bf6-b441-dddf9c0b373b);
		DB_LOW_StormshoreTabernacle_Offerings((CHARACTER)S_LOW_Bane_InvisibleHelper_db4d8f7c-a730-447b-8575-669e121908f5,(FLAG)LOW_StormshoreTabernacle_State_BaneOfferingGiven_28d3865c-2938-40fc-b501-cd68a9faa965, (TAG)ACT3_LOW_STORMSHORETABERNACLE_BANE_12f4c348-31ab-423b-a21f-dbe42e18dd44);
		
		//END_REGION
		
		//REGION Reactivity, blessing and crimes
		DB_LOW_StormshoreTabernacle_ReactivityToUseChests((ITEM)S_LOW_TyrChest_8deff203-fc4c-4af0-8964-760570a6f0b6);
		DB_LOW_StormshoreTabernacle_ReactivityToUseChests((ITEM)S_LOW_SeluneChest_f78b817a-6077-4f02-85e6-9de0538655c8);
		DB_LOW_StormshoreTabernacle_ReactivityToUseChests((ITEM)S_LOW_HelmChest_7c134a77-9e01-4505-a0e8-d17618433198);
		DB_LOW_StormshoreTabernacle_ReactivityToUseChests((ITEM)S_LOW_MystraChest_9d264e11-9a5a-4e42-bf80-e3db095b50a9);
		DB_LOW_StormshoreTabernacle_ReactivityToUseChests((ITEM)S_LOW_GenericGodChest_8c43197d-6bfa-4ddf-9ee5-d3f75b1444d3);
		
		DB_Dialogs(S_LOW_TempleGuardian_32ec6ad3-c085-4fc5-943b-e2e3a05d9f2b, (DIALOGRESOURCE)LOW_StormshoreTabernacle_TempleGuardian_6f28350f-f1d6-73f8-3cb3-4bfa834037a5);
		
		DB_CrimeType_CustomWarning((CHARACTER)S_LOW_TempleGuardian_32ec6ad3-c085-4fc5-943b-e2e3a05d9f2b,"Steal",(DIALOGRESOURCE)LOW_StormshoreTabernacle_TempleGuardian_ReactStealAction_c33eeeac-1fd4-4060-6152-90aceeffbc24);
		
		DB_ItemOwnerShipTriggers("CTY_Main_A", (TRIGGER)S_LOW_StormshoreTabernacle_OwnershipTrigger_02b74f3f-9d63-44c8-abd6-da5e92e8a55b, (CHARACTER)S_LOW_TempleGuardian_32ec6ad3-c085-4fc5-943b-e2e3a05d9f2b);
		DB_ItemOwnerShipTriggers("CTY_Main_A", (TRIGGER)S_LOW_StormshoreTabernacle_Basement_SUB_56a077c3-c98d-418b-85c0-7932bceac66b, (CHARACTER)S_LOW_TempleGuardian_32ec6ad3-c085-4fc5-943b-e2e3a05d9f2b);
		
		DB_ItemOwnerShipClearItem("CTY_Main_A", S_LOW_GenericGodStatue_d71704b6-24b6-46b7-982c-89acb3edfc20);
		
		
		//VoiceBarks
		DB_OneShot_VoiceBarkTrigger((TRIGGER)S_LOW_StormshoreTabernacle_VB_RespectsToMystra_277ab143-0e43-4046-951b-2880c628ca36, (VOICEBARKRESOURCE)LOW_StormshoreTabernacle_VB_RespectsToMystra_6daab9ff-6c1a-38da-11a1-191455502263, "PerUserAndNearbyPlayers");
		
		//END_REGION
		
		//REGION GODCURSE surprise
		DB_LOW_StormshoreTabernacle_CurseSummons((CHARACTERROOT)LOW_Cambion_Male_StormshoreTabernacle_Curse_2f2f3a4a-ebaa-4dba-9b14-47c6af82ffc6);
		DB_LOW_StormshoreTabernacle_CurseSummons((CHARACTERROOT)LOW_Deva_Male_StormshoreTabernacle_Curse_c1095e3a-96f6-400b-95c2-fa6316d06a83);
		DB_LOW_StormshoreTabernacle_CurseSummons((CHARACTERROOT)LOW_Djinni_StormshoreTabernacle_Curse_9db24399-3c91-4702-a267-5ead21a64f80);
		//END_REGION GODCURSE surprise
		
		DB_ItemDialog_NarratorAD(DEC_GEN_Plaque_Stone_A_004_efb0ef90-dc8e-486d-b8b6-59fa9373a955, (DIALOGRESOURCE)LOW_AD_Sign_StormshoreTabernacle_6181ac6a-b333-d910-1eb9-8d72ae153d56);
		
	}
	KB
	{
		//REGION Initialize
		IF
		DB_LOW_StormshoreTabernacle_SingleGods(_Item, _, _, _, _)
		THEN
		DB_ItemOwnerShipClearItem("CTY_Main_A", _Item);
		//END_REGION
		
		//REGION Candles
		PROC
		PROC_LOW_StormshoreTabernacle_TurnOffCandles()
		AND
		DB_LOW_StormshoreTabernacle_Candles(_Candle)
		THEN
		SetEntityEvent(_Candle,"turnOff", 1);
		
		PROC
		PROC_LOW_StormshoreTabernacle_TurnOnCandles()
		AND
		DB_LOW_StormshoreTabernacle_Candles(_Candle)
		THEN
		SetEntityEvent(_Candle,"turnOn",1);
		//END_REGION
		
		//REGION Interacting with shrines / offerings
		
		IF
		DB_LOW_StormshoreTabernacle_Offerings(_Helper, _, _)
		THEN
		PROC_CharacterDisableAllCrimes(_Helper);
		
		//Using the single-god shrines
		IF
		UseStarted(_Player,_Shrine)
		AND
		DB_LOW_StormshoreTabernacle_SingleGods(_Shrine, _Helper,_Dialog, _, _)
		AND
		NOT QRY_StartDialog_Fixed(_Dialog,_Shrine,_Player)
		THEN
		PROC_PlayCantUseItemAD(_Player);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers(_Dialog, _ID)
		AND
		DB_LOW_StormshoreTabernacle_SingleGods(_Shrine, _Helper, _Dialog, _, _)
		THEN
		PROC_DialogAddSpeakingActor(_ID, _Helper);
		
		//Using the generic shrine
		IF
		UseStarted(_Player, (ITEM)S_LOW_GenericGodStatue_d71704b6-24b6-46b7-982c-89acb3edfc20)
		AND
		DB_LOW_StormshoreTabernacle_ExtraGods(_God, _ClericTag)
		THEN
		DB_LOW_StormshoreTabernacle_TryStartDialogWithGod(_Player, _God);
		
		//Add this instead of DB_Dialogs because the priorities in Osiris: the DB_LOW_StormshoreTabernacle_TryStartDialogWithGod was always being added after the dialog actually starts
		IF
		UseStarted(_Player, (ITEM)S_LOW_GenericGodStatue_d71704b6-24b6-46b7-982c-89acb3edfc20)
		AND
		NOT QRY_StartDialog_Fixed((DIALOGRESOURCE)LOW_StormshoreTabernacle_GenericShrine_001a8f0c-d946-f5cf-1118-efaf18357cfd, S_LOW_GenericGodStatue_d71704b6-24b6-46b7-982c-89acb3edfc20, _Player)
		THEN
		PROC_PlayCantUseItemAD(_Player);
		
		IF
		DialogStarted(_Dialog, _ID)
		AND
		DB_LOW_StormshoreTabernacle_StatuesDialogs(_Statue, _Dialog)
		THEN
		SetCanInteract(_Statue, 0);
		
		IF
		DialogEnded(_Dialog, _ID)
		AND
		DB_LOW_StormshoreTabernacle_StatuesDialogs(_Statue, _Dialog)
		THEN
		SetCanInteract(_Statue, 1);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)LOW_StormshoreTabernacle_GenericShrine_001a8f0c-d946-f5cf-1118-efaf18357cfd,_ID)
		AND
		DB_LOW_StormshoreTabernacle_TryStartDialogWithGod(_Player, _God)
		THEN
		NOT DB_LOW_StormshoreTabernacle_TryStartDialogWithGod(_Player, _God);
		PROC_DialogAddSpeakingActor(_ID, _God);
		
		//Checking if player donate something at all
		IF
		Donated(_MovedItem, _Player, _Helper, _ItemValue)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		DB_LOW_StormshoreTabernacle_Offerings((CHARACTER)_Helper, _, _)
		THEN
		PROC_EvaluateTradeDeal(_Player, _Helper, _ItemValue, 0);
		SetFlag(LOW_StormshoreTabernacle_Event_GiveSomething_ab4c1e95-f8f2-48ef-8978-96497288a1d5, _Player);
		
		//Checking if attitude with god reaches max
		IF
		TradeEnds( _Player,_Helper)
		AND
		DB_Players(_Player)
		AND
		DB_LOW_StormshoreTabernacle_Offerings(_Helper, _OfferingFlag, _OfferingTag)
		AND
		GetAttitudeTowardsPlayer(_Helper, _Player, 100)
		AND
		GetFlag(_OfferingFlag, _Player, 0)
		THEN
		SetFlag(_OfferingFlag, _Player);
		SetTag(_Player, _OfferingTag);
		
		//Automatically moving gold and items to generic chest
		IF
		AddedTo(_Object, _Helper, _)
		AND
		DB_LOW_StormshoreTabernacle_ExtraGods((CHARACTER)_Helper, _)
		AND
		GetStackAmount((ITEM)_object, _ExactItemAmount, _TotalAmount)
		THEN
		ToInventory((ITEM)_Object, S_LOW_GenericGodChest_8c43197d-6bfa-4ddf-9ee5-d3f75b1444d3, _ExactItemAmount, 0, 1);
		
		
		//Automatically moving gold and items to respective chest, take into account that if only one gold is given, that counts as item, not gold
		IF
		AddedTo(_Object, _Helper, _)
		AND
		DB_LOW_StormshoreTabernacle_SingleGods(_, (CHARACTER)_Helper,_, _Chest, _)
		AND
		GetStackAmount((ITEM)_object, _ExactItemAmount, _TotalAmount)
		THEN
		ToInventory((ITEM)_Object, _Chest, _ExactItemAmount, 0, 1);//Just iterate to the whole inventory to remove the items.
		//AddedType, check this
		
		IF
		GoldChanged(_Helper, _Amount)
		AND
		DB_LOW_StormshoreTabernacle_SingleGods(_, (CHARACTER)_Helper,_, _Chest, _)
		AND
		_Amount > 1
		AND
		IntegerProduct(-1, _Amount, _MinusAmount)
		AND
		IntegerSubtract(_Amount,1,_Amount2)
		THEN
		AddGold(_Chest, _Amount2);
		AddGold(_Helper, _MinusAmount);
		
		IF
		GoldChanged(_Helper, _Amount)
		AND
		DB_LOW_StormshoreTabernacle_ExtraGods((CHARACTER)_Helper, _)
		AND
		_Amount > 1
		AND
		IntegerProduct(-1, _Amount, _MinusAmount)
		AND
		IntegerSubtract(_Amount,1,_Amount2)
		THEN
		AddGold(S_LOW_GenericGodChest_8c43197d-6bfa-4ddf-9ee5-d3f75b1444d3, _Amount2);
		AddGold(_Helper, _MinusAmount);
		//END_REGION
		
		//REGION Applying/Removing curses and blessings
		
		//Curse player if he opens chest, light sources go out for a while
		
		IF
		CharacterStoleItem(_Player, _, _, _, _, _, (CHARACTER)S_LOW_TempleGuardian_32ec6ad3-c085-4fc5-943b-e2e3a05d9f2b, _Chest, _, _)
		AND
		DB_LOW_StormshoreTabernacle_SingleGods((ITEM)_Statue, _,(DIALOGRESOURCE)_,(ITEM) _Chest,(FLAG) _AngeredFlag)
		AND
		HasAppliedStatus(_Player, "LOW_STORMSHORETABERNACLE_GODCURSED",0)
		THEN
		SetFlag((FLAG)LOW_StormshoreTabernacle_State_AngeredPriest_4220e3e0-6769-4a3d-9768-2376477ea1aa,_Player);
		ApplyStatus(_Player, "LOW_STORMSHORETABERNACLE_GODCURSED", -1.0,1);
		SetFlag(_AngeredFlag, _Player);
		PROC_CharacterRegisterCrime((CHARACTER)_Player,"Steal",_Chest,(CHARACTER)S_LOW_TempleGuardian_32ec6ad3-c085-4fc5-943b-e2e3a05d9f2b,0);
		
		//Curse player if he opens chest, light sources go out for a while
		IF
		CharacterStoleItem(_Player, _, _, _, _, _, (CHARACTER)S_LOW_TempleGuardian_32ec6ad3-c085-4fc5-943b-e2e3a05d9f2b, (ITEM)S_LOW_GenericGodChest_8c43197d-6bfa-4ddf-9ee5-d3f75b1444d3, _, _)
		AND
		HasAppliedStatus(_Player, "LOW_STORMSHORETABERNACLE_GODCURSED",0)
		THEN
		ApplyStatus(_Player, "LOW_STORMSHORETABERNACLE_GODCURSED", -1.0,1);
		SetFlag((FLAG)LOW_StormshoreTabernacle_State_AngeredGenericShrine_20657a34-5055-475b-a52f-458a4e04872d, _Player);
		PROC_CharacterRegisterCrime((CHARACTER)_Player,"Steal",S_LOW_GenericGodChest_8c43197d-6bfa-4ddf-9ee5-d3f75b1444d3,(CHARACTER)S_LOW_TempleGuardian_32ec6ad3-c085-4fc5-943b-e2e3a05d9f2b,0);
		
		IF
		KilledBy((CHARACTER)S_LOW_TempleGuardian_32ec6ad3-c085-4fc5-943b-e2e3a05d9f2b, _, _Attacker, _ID)
		THEN
		ApplyStatus(_Attacker, "LOW_STORMSHORETABERNACLE_GODCURSED", -1.0,1);
		SetFlag((FLAG)LOW_StormshoreTabernacle_State_AngeredGenericShrine_20657a34-5055-475b-a52f-458a4e04872d, _Attacker);
		PROC_LOW_StormshoreTabernacle_TurnOffCandles();
		ObjectTimerLaunch(S_LOW_StormshoreCandles_007_6c814f17-cc18-4522-8f48-66baf54ddc02, "LOW_StormshoreTabernacle_TurnOnCandlesTimer",5000);
		
		IF
		KilledBy((CHARACTER)S_LOW_TempleGuardian_32ec6ad3-c085-4fc5-943b-e2e3a05d9f2b, _, _Attacker, _ID)
		AND
		DB_LOW_StormshoreTabernacle_SingleGods((ITEM)_, _,(DIALOGRESOURCE)_,(ITEM) _,(FLAG) _AngeredFlag)
		THEN
		SetFlag(_AngeredFlag, _Attacker);
		
		IF
		KilledBy((CHARACTER)S_LOW_TempleGuardian_32ec6ad3-c085-4fc5-943b-e2e3a05d9f2b, _, _, _)
		THEN
		PROC_LOW_StormshoreTabernacle_TurnOffCandles();
		ObjectTimerLaunch(S_LOW_StormshoreCandles_007_6c814f17-cc18-4522-8f48-66baf54ddc02, "LOW_StormshoreTabernacle_TurnOnCandlesTimer",5000);
		
		IF
		TimerFinished("LOW_StormshoreTabernacle_TurnOnCandlesTimer")
		THEN
		PROC_LOW_StormshoreTabernacle_TurnOnCandles();
		
		IF
		StatusApplied(_Player, "LOW_STORMSHORETABERNACLE_GODCURSED",_,_)
		THEN
		PlayEffect(_Player, (EFFECTRESOURCE)VFX_Spells_Cast_Cleric_DispelEvilAndGood_BreakEnchantment_Impact_Root_Textkey_01_4d0e9e72-4352-c2de-e0c2-7790a1564778);
		ObjectTimerLaunch(_Player, "LOW_StormshoreTabernacle_StopEffectVFX",2000);
		
		IF
		StatusApplied(_Player, "LOW_STORMSHORETABERNACLE_GODCURSED",_,_)
		AND
		HasAppliedStatus(_Player, "LOW_STORMSHORETABERNACLE_GODBLESSED",1)
		THEN
		RemoveStatus(_Player,"LOW_STORMSHORETABERNACLE_GODBLESSED");
		
		IF
		StatusRemoved(_Player, "LOW_STORMSHORETABERNACLE_GODBLESSED", _, _)
		THEN
		ClearFlag((FLAG)LOW_StormshoreTabernacle_State_BlessingGiven_6b189e45-6b68-41bc-b530-77bc81453299, _Player);
		
		IF
		StatusRemoved(_Player, "LOW_STORMSHORETABERNACLE_GODCURSED", _, _)
		THEN
		ClearFlag(LOW_StormshoreTabernacle_State_AngeredGenericShrine_20657a34-5055-475b-a52f-458a4e04872d, _Player);
		
		IF
		StatusRemoved(_Player, "LOW_STORMSHORETABERNACLE_GODCURSED", _, _)
		AND
		DB_LOW_StormshoreTabernacle_SingleGods((ITEM)_, _,(DIALOGRESOURCE)_,(ITEM) _,(FLAG) _AngeredFlag)
		THEN
		ClearFlag(_AngeredFlag, _Player);
		
		IF
		StatusRemoved(_Player, "LOW_STROMSHORETABERNACLE_GODCUSED_TECHNICAL", _, _)
		THEN
		RemoveStatus(_Player, "LOW_STORMSHORETABERNACLE_GODCURSED");
		
		//Receive blessing when selected the option in dialogue
		IF
		FlagSet((FLAG)LOW_StormshoreTabernacle_Event_GiveBlessing_4521b842-e723-4c99-b46f-592eb11f95a8, _Player, _)
		AND
		HasAppliedStatus(_Player, "LOW_STORMSHORETABERNACLE_GODBLESSED",0)
		THEN
		ClearFlag((FLAG)LOW_StormshoreTabernacle_Event_GiveBlessing_4521b842-e723-4c99-b46f-592eb11f95a8, _Player);
		ApplyStatus(_Player, "LOW_STORMSHORETABERNACLE_GODBLESSED", -1.0,1);
		SetFlag((FLAG)LOW_StormshoreTabernacle_State_BlessingGiven_6b189e45-6b68-41bc-b530-77bc81453299,_Player);
		PROC_LoopEffect((EFFECTRESOURCE)VFX_Status_Leadership_Aura_01_a3a36f14-40f0-0d2c-c67d-15c809dc9bcf, _Player, "LOW_StormshoreTabernacle_Effect", "CTY_Main_A", "");
		ObjectTimerLaunch(_Player, "LOW_StormshoreTabernacle_StopEffectVFX",2000);
		
		IF
		ObjectTimerFinished(_Player, "LOW_StormshoreTabernacle_StopEffectVFX")
		THEN
		PROC_StopLoopEffect(_Player,"LOW_StormshoreTabernacle_Effect");
		
		// Devas being summoned
		IF
		EnteredLevel(_Deva, _DevaRoot, _)
		AND
		DB_LOW_StormshoreTabernacle_CurseSummons((CHARACTERROOT)_DevaRoot)
		AND
		DB_PartyMembers(_PartyMember)
		AND
		IsInCombat(_PartyMember, 0)
		AND
		GetDistanceTo(_Deva, _PartyMember, _OutDistance)
		AND
		_OutDistance < 15.0
		THEN
		PROC_MakeSurprised(_PartyMember);
		//END_REGION
		
		//REGION Putting gold in the chests
		
		IF
		MovedFromTo(_Gold, _Character, _Chest, 0)
		AND
		DB_LOW_StormshoreTabernacle_ReactivityToUseChests((ITEM)_Chest)
		AND
		QRY_OnlyOnce("LOW_StormshoreTabernacle_PuttingItemsAtChest")
		THEN
		DB_LOW_StormshoreTabernacle_ReadyToTriggerPAD(_Character, _Chest);
		
		IF
		MovedFromTo(_Gold, _Chest, _Character, 0)
		AND
		DB_LOW_StormshoreTabernacle_ReadyToTriggerPAD(_Character, (ITEM)_Chest)
		THEN
		NOT DB_LOW_StormshoreTabernacle_ReadyToTriggerPAD(_Character, _Chest);
		NOT DB_OnlyOnce("LOW_StormshoreTabernacle_PuttingItemsAtChest");
		
		IF
		UseFinished(_, _Chest, _)
		AND
		DB_LOW_StormshoreTabernacle_ReadyToTriggerPAD(_Character, _Chest)
		THEN
		NOT DB_LOW_StormshoreTabernacle_ReadyToTriggerPAD(_Character, _Chest);
		PROC_TryStartAD(LOW_StormshoreTabernacle_PAD_PuttingItemsInChest_b00e132f-7941-d359-5c9a-666add494923, _Character);
		
		//END_REGION
		
		//REGION Brazier
		
		IF
		StatusAttempt(S_LOW_Stormshore_Brazier_New_727a3171-2cc7-4957-be16-f323dbb93318, "WET", _Player, _)
		AND
		DB_PartyMembers((CHARACTER)_Player)
		AND
		NOT DB_Defeated(S_LOW_TempleGuardian_32ec6ad3-c085-4fc5-943b-e2e3a05d9f2b)
		THEN
		PROC_CharacterRegisterCrime(_Player, "ItemDestroy", S_LOW_Stormshore_Brazier_New_727a3171-2cc7-4957-be16-f323dbb93318, 32ec6ad3-c085-4fc5-943b-e2e3a05d9f2b, 0);
		
		IF
		StatusRemoved(S_LOW_Stormshore_Brazier_New_727a3171-2cc7-4957-be16-f323dbb93318, "Burning", _, _)
		THEN
		SetFlag(LOW_StormshoreTabernacle_State_IsBrazierOff_7c5a6771-6edb-4227-97f3-c823292ac271);
		
		//END_REGION Brazier
		
	}
	EXIT
	{
	}
}
