		DB_GLO_Gazette_PaperStacks(S_LOW_BaldursMouth_Paper_Stack_000_a05a93e3-b310-4d3f-99ee-57a45ad7a3b5);
		DB_GLO_Gazette_PaperStacks(S_LOW_BaldursMouth_Paper_Stack_001_a0f38eb7-be70-4262-9890-895182f1e40b);
		DB_GLO_Gazette_PaperStacks(CONT_GEN_Market_Stall_Newspaper_B_000_43b5f149-7f4c-4335-b844-4a0ebb4ba118);
		DB_GLO_Gazette_PaperStacks(CONT_GEN_Market_Stall_Newspaper_A_002_26c50fe1-a3a8-4e1b-880b-9850d435f2e3);
