		DB_DialogBlockAttackButton(CAMP_GoblinHuntCelebration_ParentsAndDruidLeader_5acd7f9f-e965-ae46-ae7e-c689c1b8db94);
		//
		DB_CAMP_GoblinHuntCelebration_ProdigiesScene((CHARACTER)S_GLO_Prodigy_b6a3a9e9-b6eb-4c19-ab3f-4c431178fe1b, (TRIGGER)S_CAMP_TieflingPos_009_febc6417-a9af-43a6-9f83-a0be5b274cb0,(DIALOGRESOURCE)CAMP_GoblinHuntCelebration_Prodigy_d8853fbc-0be8-f8cb-5795-e241ba9e7d8b);
		DB_CAMP_GoblinHuntCelebration_ProdigiesScene(S_GLO_ProdigyBrother_d0187724-c0e2-4019-a01d-a03ee8153f1b, S_CAMP_TieflingPos_010_1bc30e74-d455-444a-8fcc-7cdf0d1369a5, CAMP_GoblinHuntCelebration_ProdigyBrother_51ccc80b-fb9b-aadb-7a42-14e2995d8b71);
		DB_CAMP_GoblinHuntCelebration_ProdigiesScene(S_GLO_ProdigySister_44d09b0b-0568-456c-b18d-559a0a3f981d, S_CAMP_TieflingPos_011_cda94aac-6ed6-4b7e-b12b-6cbbd28f8900,CAMP_GoblinHuntCelebration_ProdigySister_cc04a621-0b4c-95ef-c4ac-9ec019d569fb);
		
		
		DB_CAMP_GoblinHuntCelebration_LeavingCompanions((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d);
		DB_CAMP_GoblinHuntCelebration_LeavingCompanions((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		
		DB_GiveItemToEvent((ITEM)S_CAMP_BarcusDetonatingArrow_ddbb4879-c2ee-41b0-98d3-0aa561abd8c7, (FLAG)CAMP_GoblinHuntCelebration_UnfortunateGnome_GivePlayerArrow_60a5692c-c380-de0a-c716-6979d460e359);
		
		Lock(S_CAMP_PartyVoloCageDoor_bb42490f-603e-4118-a167-8129ef192c27, "CAMP_GoblinHuntCelebration_VoloCage");
		
		SetOnStage(S_CAMP_BetrayalOgre_b7ea8abf-486f-490b-a54e-5fe41018d54c, 0);
		DB_CAMP_GoblinHuntCelebration_VoloCageObjects((ITEM)S_CAMP_PartyVoloCage_98f0ac7c-5115-4030-ae54-8b53ab63ec77);
		DB_CAMP_GoblinHuntCelebration_VoloCageObjects(S_CAMP_PartyVoloCageDoor_bb42490f-603e-4118-a167-8129ef192c27);
		DB_CAMP_GoblinHuntCelebration_VoloCageObjects(S_CAMP_VoloCageBlocker_001_38c0ce35-fe7a-457b-9ebd-55284c3dac02);
		DB_CAMP_GoblinHuntCelebration_VoloCageObjects(S_CAMP_VoloCageBlocker_002_bc220f8c-88c1-4ba4-b390-53d36aeace34);
		DB_CAMP_GoblinHuntCelebration_VoloCageObjects(S_CAMP_VoloCageBlocker_003_43d44a3d-517a-417f-9d8f-ac60522a657f);
		DB_CAMP_GoblinHuntCelebration_VoloCageObjects(S_CAMP_VoloCageBlocker_004_ee41fa17-2878-408c-b9e3-ca84d3fba08f);
		DB_CAMP_GoblinHuntCelebration_VoloCageObjects(S_CAMP_VoloCageBlocker_005_d2f13f7a-a2bc-49b2-a377-da43e9545e3d);
		DB_CAMP_GoblinHuntCelebration_VoloCageObjects(S_CAMP_VoloCageBlocker_006_0f364f03-d847-4468-8917-e39a162cee3b);
		DB_CAMP_GoblinHuntCelebration_VoloCageObjects(S_CAMP_VoloCageBlocker_007_ac2134bc-5076-4c4d-9301-b2cb4d0b07ac);
		
		SetOnStage(S_CAMP_SeatRock_003_fcfd2137-5d24-41c3-9f72-2404ce7b30e5, 0);
		SetOnStage(S_CAMP_SeatRock_004_5dfe39f6-a965-4870-8d40-59ab461a4e7e, 0);
		
		PROC_SelfHealing_Disable(S_CAMP_PartyGoblin_009_c6908842-5e46-4a14-973a-84c55a59f1e4);
		
		DB_IgnoreMutingStatussesDialog(CAMP_GoblinHuntCelebration_ParentsAndDruidLeader_5acd7f9f-e965-ae46-ae7e-c689c1b8db94);
		
		//Halsin Camp Night support DB
		DB_CAMP_Halsin_HasMetHalsinFlags((FLAG)GOB_WolfPens_State_HalsinIntroHappened_7d0751b9-1055-4a54-9ccd-f5e95e2a1f69);
		DB_CAMP_Halsin_HasMetHalsinFlags((FLAG)GLO_Halsin_Event_TalkedWithDruidLeader_b337012e-aabc-3a99-1f27-225ebb185d58);
		DB_CAMP_Halsin_HasMetHalsinFlags((FLAG)DEN_AttackOnDen_HasMet_Halsin_cf151bc0-9f70-bead-5dff-9341a1fdc39f);
	}
	KB
	{
		//REGION Init
		IF
		DB_CAMP_GoblinHuntCelebration_Tieflings(_Tiefling, _Dialog, _Replacement, _Pos)
		AND
		_Replacement != NULL_00000000-0000-0000-0000-000000000000
		THEN
		SetOnStage(_Replacement, 0);
		
		IF
		DB_CAMP_GoblinHuntCelebration_VoloCageObjects(_Object)
		THEN
		SetOnStage(_Object, 0);
		
		IF
		DB_CAMP_GoblinHuntCelebration_Goblins(_Goblin, _)
		THEN
		DB_GLO_DefeatCounter(_Goblin, "CAMP_GoblinHuntCelebration_BetrayalFight");
		SetOnStage(_Goblin, 0);
		
		IF
		DB_CAMP_GoblinHuntCelebration_DeadTieflingPos(_Tiefling, _)
		THEN
		SetOnStage(_Tiefling, 0);
		ObjectTimerLaunch(_Tiefling, "CAMP_GoblinHuntCelebration_CleanBlood", 3000);
		
		IF
		ObjectTimerFinished(_Tiefling, "CAMP_GoblinHuntCelebration_CleanBlood")
		THEN
		CreateSurface(_Tiefling, "SurfaceNone", 5.0, -1.0, NULL_00000000-0000-0000-0000-000000000000); 
		//END_REGION
		
		//REGION Going to Camp automatically
		IF
		FlagSet((FLAG)DEN_AttackOnDen_Event_GoToCamp_b48deef8-0436-a593-1f56-3195c5d3b657,NULL_00000000-0000-0000-0000-000000000000,_ID)
		THEN
		DB_DEN_AttackOnDen_GoToCampAfterDialog(_ID);
		
		IF
		FlagSet((FLAG)DEN_AttackOnDen_Event_GoblinPartyInvitation_54e19b21-3fad-6a2e-c89a-9d5cf1b4773f,NULL_00000000-0000-0000-0000-000000000000,_ID)
		THEN
		DB_DEN_AttackOnDen_GoToCampAfterDialog(_ID);
		
		IF
		DialogEnded(_,_ID)
		AND
		DB_DialogPlayers(_ID,_Player,1)
		AND
		DB_DEN_AttackOnDen_GoToCampAfterDialog(_ID)
		THEN
		NOT DB_DEN_AttackOnDen_GoToCampAfterDialog(_ID);
		PROC_Camp_ForceEndTheDay((CHARACTER)_Player,"WLDMAIN");
		
		QRY
		QRY_Camp_SwapCampIfNecessary_Custom((CHARACTER)_Player)
		AND
		DB_CampNight(NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121, 8020)
		AND
		DB_GlobalFlag(DEN_AttackOnDen_Event_TieflingPartyInvitation_545593fd-42e6-15c1-1e96-18e0e0be0443)
		AND
		QRY_DEN_IsInDen(_Player)
		THEN
		DB_ActiveCamp("WLDMAIN");
		
		QRY
		QRY_Camp_SwapCampIfNecessary_Custom((CHARACTER)_Player)
		AND
		DB_CampNight(NIGHT_GoblinHunt_RaiderCelebration_86fee25f-1069-4f17-89fa-4c5b69f82e0b, 8020)
		AND
		DB_GlobalFlag(DEN_AttackOnDen_Event_GoblinPartyInvitation_54e19b21-3fad-6a2e-c89a-9d5cf1b4773f)
		AND
		QRY_DEN_IsInDen(_Player)
		THEN
		DB_ActiveCamp("WLDMAIN");
		
		//END_REGION
		
		//REGION Specific Night Logic - Goblin Hunt Celebration - Raiders
		
		PROC
		PROC_CampNight_StartSelected()
		AND
		DB_Camp_QueuedNight((FLAG)NIGHT_GoblinHunt_RaiderCelebration_86fee25f-1069-4f17-89fa-4c5b69f82e0b)
		AND
		NOT DB_CantAct(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b)
		THEN
		PROC_SpotPlayers_StopSpotting("DEN_AttackOnDen_DrowVictory");
		DB_CAMP_DrowBetrayal(1);
		DB_Camp_PreventEndOfNight(1);
		NOT DB_GLO_Absolute_TrueSoul(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b);
		PROC_CAMP_GoblinHuntCelebration_SetupRaiders();
		SetOnStage(S_CAMP_AltarBowl_9bd807cc-de17-428f-bdd6-ed710a92699e, 1);
		SetOnStage(S_CAMP_BloodAltar_ae7c1c27-3a7f-4d39-8b06-fe56879a7c37, 1);
		SetOnStage(S_CAMP_AltarLight001_6ba7e82b-983e-4128-b56d-e104ce6f977c, 1);
		SetOnStage(S_CAMP_AltarLight002_f1c0f968-4038-433c-a639-16153495060e, 1);
		PROC_CAMP_GoblinHuntCelebration_SetupBird();
		PROC_CAMP_GoblinHuntCelebration_SetupVolo();
		PROC_CAMP_GoblinHuntCelebration_SetupDog("CAMP_GoblinHuntCelebration_SetupDogForGoblins");
		
		IF
		DB_CAMP_DrowBetrayal(1)
		THEN
		DB_CombatReact_AD_OnTurn(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, (DIALOGRESOURCE)CAMP_MintharaAmbush_AD_Combat_DrowCommander_000_f948a2af-9b22-8621-60c2-f18c6e3bd089, 1);
		DB_CombatReact_AD_OnTurn(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, (DIALOGRESOURCE)CAMP_MintharaAmbush_AD_Combat_DrowCommander_001_038bd6cd-7764-9e00-9902-e1a996150383, 2);
		DB_CombatReact_AD_OnTurn(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, (DIALOGRESOURCE)CAMP_MintharaAmbush_AD_Combat_DrowCommander_002_ed13165b-2c4f-e9b3-0dcc-95d786105c58, 3);
		DB_CombatReact_AD_OnTurn(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, (DIALOGRESOURCE)CAMP_MintharaAmbush_AD_Combat_DrowCommander_003_8b757b1e-2095-ecd6-8b1b-c2bcb60bed38, 4);
		
		PROC
		PROC_CampNight_ClearCampNight((FLAG)NIGHT_GoblinHunt_RaiderCelebration_86fee25f-1069-4f17-89fa-4c5b69f82e0b)
		THEN
		NOT DB_CombatReact_AD_OnTurn(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, (DIALOGRESOURCE)CAMP_MintharaAmbush_AD_Combat_DrowCommander_000_f948a2af-9b22-8621-60c2-f18c6e3bd089, 1);
		NOT DB_CombatReact_AD_OnTurn(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, (DIALOGRESOURCE)CAMP_MintharaAmbush_AD_Combat_DrowCommander_001_038bd6cd-7764-9e00-9902-e1a996150383, 2);
		NOT DB_CombatReact_AD_OnTurn(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, (DIALOGRESOURCE)CAMP_MintharaAmbush_AD_Combat_DrowCommander_002_ed13165b-2c4f-e9b3-0dcc-95d786105c58, 3);
		NOT DB_CombatReact_AD_OnTurn(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, (DIALOGRESOURCE)CAMP_MintharaAmbush_AD_Combat_DrowCommander_003_8b757b1e-2095-ecd6-8b1b-c2bcb60bed38, 4);
		
		IF
		DialogEnded(CAMP_GoblinHuntCelebration_CFM_Raiders_37471826-8011-115d-6724-c12874619d95, _)
		THEN
		PROC_DEN_AttackOnDen_RaiderCelebration_JournalHook();
		
		IF
		FlagSet((FLAG)CAMP_GoblinHuntCelebration_Event_DUKillMinthara_37d02c0f-945f-7d72-ff12-64311398fe3d, _, _)
		THEN
		TeleportTo((CHARACTER)S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, (TRIGGER)S_CAMP_BetrayalMintharaPos_4867b39d-482a-48c1-ac85-4e21781b05c0);
		SetOnStage((CHARACTER)S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, 1);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)CAMP_GoblinHuntCelebration_CFM_Raiders_37471826-8011-115d-6724-c12874619d95,(INTEGER)_ID)
		AND
		DB_GlobalFlag(GLO_Volo_State_AtCamp_de1cadca-2eca-4cee-a3dc-e262bbb92277)
		AND
		NOT DB_CantTalk(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa)
		THEN
		PROC_DialogAddSpeakingActor(_ID, S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_SetupBird()
		AND
		DB_Defeated(S_DEN_SenderBird_bf90aa40-232b-40fd-a43e-699bb964e337)
		THEN
		SetOnStage(SS_CAMP_DeadBird_a4f25c31-4ac0-418b-a6c4-35f29cb16b7c, 1);
		Die(S_CAMP_DeadBird_a4f25c31-4ac0-418b-a6c4-35f29cb16b7c, DEATHTYPE.DoT, 1);
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_SetupBird()
		AND
		NOT DB_Defeated(S_DEN_SenderBird_bf90aa40-232b-40fd-a43e-699bb964e337)
		THEN
		SetOnStage(S_DEN_SenderBird_bf90aa40-232b-40fd-a43e-699bb964e337, 1);
		TeleportTo(S_DEN_SenderBird_bf90aa40-232b-40fd-a43e-699bb964e337, S_CAMP_DeadBird_a4f25c31-4ac0-418b-a6c4-35f29cb16b7c, "");
		Die(S_DEN_SenderBird_bf90aa40-232b-40fd-a43e-699bb964e337, DEATHTYPE.DoT, 1);
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_SetupVolo()
		AND
		DB_GlobalFlag(GLO_Volo_State_AtCamp_de1cadca-2eca-4cee-a3dc-e262bbb92277)
		THEN
		ToInventory(S_GOB_VoloGoblinsGuide_Copy_f1e89064-e9db-47e2-add6-67f8f72e1a74,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		TeleportTo(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, S_CAMP_PartyVoloPoint_0f929989-b0ef-43d9-ae73-66756bdeaebb, "");
		SetEntityEvent(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "CAMP_GoblinHuntCelebration_SetupVolo");
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_SetupVolo()
		AND
		DB_GlobalFlag(GLO_Volo_State_AtCamp_de1cadca-2eca-4cee-a3dc-e262bbb92277)
		AND
		DB_CAMP_GoblinHuntCelebration_VoloCageObjects(_Object)
		THEN
		SetOnStage(_Object, 1);
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_SetupDog((STRING)_SetupEvent)
		AND
		GetFlag(CAMP_GLO_State_InCamp_161b7223-039d-4ebe-986f-1dcd9a66733f, S_FOR_Courier_Dog_3059f69c-068d-4e28-8491-55953c027901, 1)
		THEN
		SetEntityEvent(S_FOR_Courier_Dog_3059f69c-068d-4e28-8491-55953c027901, _SetupEvent);
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_SetupRaiders()
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b);
		DB_Dialogs(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, CAMP_GoblinHuntCelebration_Drow_9ecb7dd8-4f2f-e641-04d8-29b8482d05ab);
		TeleportTo(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, S_CAMP_DrowPos_85702311-8b19-4104-85c0-6cbbde8aa0e7, "");
		SetFlag((FLAG)GOB_DrowCommander_State_AtCamp_9e6ea403-bcb6-4cb0-9ecc-ec4e45ba51c3, S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b);
		SetFaction(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, ACT1_DEN_AttackRaiders_Fighters_bfdc773b-6521-4fd1-3784-3d1404f1b2f5);
		SetCombatGroupID(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, "CAMP_GoblinHuntCelebration_DrowBetrayal");
		SetEntityEvent(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, "CAMP_GoblinHuntCelebration_RaiderParty");
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_SetupRaiders()
		AND
		DB_CAMP_GoblinHuntCelebration_Goblins(_Goblin, _)
		THEN
		SetOnStage(_Goblin, 1);
		SetCombatGroupID(_Goblin, "CAMP_GoblinHuntCelebration_DrowBetrayal");
		SetEntityEvent(_Goblin, "CAMP_GoblinHuntCelebration_RaiderParty");
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_SetupRaiders()
		AND
		DB_DEN_AttackOnDen_Raiders(_Raider, _, _, _)
		THEN
		SetOnStage(_Raider, 0);
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_SetupRaiders()
		AND
		DB_DEN_AttackOnDen_DruidRaiders(_Raider)
		THEN
		SetOnStage(_Raider, 0);
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_SetupRaiders()
		AND
		DB_CAMP_GoblinHuntCelebration_DeadTieflingPos(_Tiefling, _Pos)
		THEN
		SetOnStage(_Tiefling, 1);
		CreatePuddle(_Tiefling, "SurfaceBlood", 10, 15, 10,20, 1.0);
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_RemoveRaiders()
		THEN
		SetEntityEvent(S_FOR_Courier_Dog_3059f69c-068d-4e28-8491-55953c027901, "CAMP_GoblinHuntCelebration_ClearDog");
		SetOnStage(S_CAMP_BetrayalOgre_b7ea8abf-486f-490b-a54e-5fe41018d54c, 0);
		SetOnStage(S_CAMP_BetrayalBed_001_235ae6bc-86a0-44fe-b8c1-9bb0c47e2ca9, 0);
		SetOnStage(S_CAMP_BetrayalBed_002_d210c7bc-9555-4e47-a3a3-579864e61018, 0);
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_RemoveRaiders()
		AND
		NOT DB_GlobalFlag(CAMP_GoblinHuntCelebration_Event_DUKillMinthara_37d02c0f-945f-7d72-ff12-64311398fe3d)
		THEN
		SetOnStage(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, 0);
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_RemoveRaiders()
		AND
		DB_GlobalFlag((FLAG)GLO_Volo_State_AtCamp_de1cadca-2eca-4cee-a3dc-e262bbb92277)
		THEN
		SetEntityEvent(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "CAMP_GoblinHuntCelebration_ClearVolo");
		
		PROC
