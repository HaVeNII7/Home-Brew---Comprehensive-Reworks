}
Goal(88).Title("Act1");
Goal(88)
{
	INIT
	{
		DB_CheckLevelStart("WLD_Main_A");
		
		DB_RegionSafeSpot("WLD_Main_A",(TRIGGER)DOS2_StartPoint_000__000__000_b41c4f85-a580-cf6e-a4b9-9084e084452c);
	}
	KB
	{
		IF
		LevelLoaded("WLD_Main_A")
		THEN
		GoalCompleted;
		
		IF
		DB_CheckLevelStart("WLD_Main_A")
		AND
		DB_CurrentLevel("WLD_Main_A")
		THEN
		GoalCompleted;
		
		
	}
	EXIT
	{
	}
}
Goal(89).Title("Act1_CAMP_GoblinHuntCelebration");
Goal(89)
{
	INIT
	{
		DB_CAMP_GoblinHuntCelebration_NightFlags((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121);
		DB_CAMP_GoblinHuntCelebration_NightFlags((FLAG)NIGHT_GoblinHunt_RaiderCelebration_86fee25f-1069-4f17-89fa-4c5b69f82e0b);
		
		//NIGHT_GoblinHunt_TieflingCelebration
		DB_CampNight((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121, 8020);
		DB_CampNight_Camp((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121, "WLDMAIN");
		DB_CampNight_ExclusiveMoment((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121);
		DB_CampNight_Cancels((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121, (FLAG)NIGHT_GoblinHunt_RaiderCelebration_86fee25f-1069-4f17-89fa-4c5b69f82e0b);
		DB_CampNight_CancelledBy((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121, (FLAG)DEN_AttackOnDen_State_HostileTieflings_c5641caa-4409-4739-a1fe-8263b8271f4e);
		DB_CampNight_CancelledBy((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121, (FLAG)DEN_TieflingRefugees_State_LeftDen_003b304b-f058-4f8a-b9fa-a097e1b6b395);
		DB_CampNight_Requirement((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121, (FLAG)DEN_AttackOnDen_Event_TieflingPartyInvitation_545593fd-42e6-15c1-1e96-18e0e0be0443);
		DB_CampNight_CRD((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121, (CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, (DIALOGRESOURCE)CAMP_GoblinHuntTieflingCelebration_CRD_Astarion_bda95b3c-f689-a440-bd81-c333b15c3fc2,(FLAG)NULL_00000000-0000-0000-0000-000000000000);
		DB_CampNight_CRD((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121, (CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (DIALOGRESOURCE)CAMP_GoblinHuntTieflingCelebration_CRD_Laezel_bc147208-cdef-42c9-438e-bab901262d90,(FLAG)NULL_00000000-0000-0000-0000-000000000000);
		DB_CampNight_CRD((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121, (CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679, (DIALOGRESOURCE)CAMP_GoblinHuntTieflingCelebration_CRD_Shadowheart_b90c937e-edce-0e26-a86c-e29ac656cabb,(FLAG)NULL_00000000-0000-0000-0000-000000000000);
		DB_CampNight_CRD((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121, (CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, (DIALOGRESOURCE)CAMP_GoblinHuntTieflingCelebration_CRD_Wyll_4c817c86-c052-813f-77e6-6374da2cc842,(FLAG)NULL_00000000-0000-0000-0000-000000000000);
		DB_CampNight_CRD((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121, (CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, (DIALOGRESOURCE)CAMP_GoblinHuntTieflingCelebration_CRD_Gale_6e83e164-1900-b40d-723d-d2c206ea5a59,(FLAG)NULL_00000000-0000-0000-0000-000000000000);
		DB_CampNight_AvatarDream((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121,(DIALOGRESOURCE)CAMP_GoblinHuntCelebration_SD_SelectNight_750df06d-5a74-8f6b-cd1f-947055afbc2e);
