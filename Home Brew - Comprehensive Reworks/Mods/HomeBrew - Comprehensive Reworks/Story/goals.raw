		DB_CombatReact_AD_OnTurn(S_SHA_Necromancer_InitialJusticiar_83f1d9a0-8d28-46c1-93a8-66388541fcb4, (DIALOGRESOURCE)SHA_Necromancer_AD_Justiciar_TakingTurn_2_bf54d68e-bb66-6a75-ffa0-74ec0cd5425b, 2);
		
