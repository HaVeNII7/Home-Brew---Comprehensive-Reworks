		DB_CombatReact_AD_OnNextTurn(S_WYR_GurCamp_GurLeader_5e52cf9c-b673-45b7-888c-2c105eb4d890, (DIALOGRESOURCE)WYR_GurCamp_GurLeader_AD_TakingTurn_002_Combat_cba5c599-b39d-deae-b84a-ac549b4f81a7);
		DB_CombatReact_AD_OnNextTurn(S_WYR_GurCamp_GurLeader_5e52cf9c-b673-45b7-888c-2c105eb4d890, (DIALOGRESOURCE)WYR_GurCamp_GurLeader_AD_TakingTurn_003_Combat_404b9fac-7a21-0771-8fea-2458524e8fd9);
	}
	KB
	{
		//REGION Main
		PROC
		PROC_GLO_SetupForAct("BGO_Main_A", S_GLO_GurHunter_0e47fcb9-c0c4-4b0c-902b-2d13d209e760, 1)
		THEN
		PROC_GLO_SetupForAct_Place(
			(CHARACTER)S_GLO_GurHunter_0e47fcb9-c0c4-4b0c-902b-2d13d209e760,
			(TRIGGER)S_WYR_GurCamp_GurHunterPos_6e74e0b8-b6a7-484d-9a68-d0a0d9dce790, 
			(FACTION)ACT3_WYR_GurCamp_87fe8d0d-31c9-4b10-8fc6-f0c232c24b13);
		NOT DB_GLO_CharacterCorpseDialog(S_GLO_GurHunter_0e47fcb9-c0c4-4b0c-902b-2d13d209e760, HAG_GurHunter_Dead_e8f9f58d-4e06-0284-7ff6-fba90a2ea770);
		DB_WYR_GurCamp_NPCs((CHARACTER)S_GLO_GurHunter_0e47fcb9-c0c4-4b0c-902b-2d13d209e760, WYR_GurCamp_GurHunter_31eba83f-db02-13d9-f39e-09f63ac75c9c);
		PROC_RemoveDialog(S_GLO_GurHunter_0e47fcb9-c0c4-4b0c-902b-2d13d209e760);
		DB_Dialogs((CHARACTER)S_GLO_GurHunter_0e47fcb9-c0c4-4b0c-902b-2d13d209e760, WYR_GurCamp_GurHunter_31eba83f-db02-13d9-f39e-09f63ac75c9c);
		DB_LOW_GurFollowUp_NPCs((CHARACTER)S_GLO_GurHunter_0e47fcb9-c0c4-4b0c-902b-2d13d209e760, (DIALOGRESOURCE)LOW_CazadorsPalace_GurFollowUp_GurHunter_86d918f2-a58d-eb0c-8388-8e1f7cd9eeac, (TRIGGER)S_LOW_GurFollowUp_GurHunterAppearPos_3f9cb746-edd5-4093-82ab-4d1648b1f5a9, (TRIGGER)S_LOW_CazadorsPalace_Dungeon_GurHunterPos_37b5c7fa-ea6b-4b25-8a4a-1b368b7137d5);
		DB_WYR_GurCamp_IntroNPCs((CHARACTER)S_GLO_GurHunter_0e47fcb9-c0c4-4b0c-902b-2d13d209e760);
		DB_OriginMoment_ExtraNPCs((DIALOGRESOURCE)WYR_GurCamp_Intro_OM_Astarion_AOM_OOM_9c323cba-b76e-961d-aab8-a9ea88153cad, S_GLO_GurHunter_0e47fcb9-c0c4-4b0c-902b-2d13d209e760);
		DB_OriginMoment_ExtraNPCs((DIALOGRESOURCE)WYR_GurCamp_Intro_OM_Astarion_COM_efe497b7-6d46-c3d7-e610-b7d71e284fd7, S_GLO_GurHunter_0e47fcb9-c0c4-4b0c-902b-2d13d209e760);
		DB_WYR_GurCamp_GurHunterPresent(1);
		
		PROC
		PROC_GurCamp_Init()
		AND
		DB_GlobalFlag((FLAG)ORI_Astarion_State_GurGotAstarion_cd1687b8-3282-4121-aaa1-6de5eda6a9a4)
		AND
		DB_WYR_GurCamp_NPCs(_NPC, _)
		THEN
		Die(_NPC, DEATHTYPE.Physical, NULL_00000000-0000-0000-0000-000000000000, 1, 1, 1.0);
		
		PROC
		PROC_GurCamp_Init()
		AND
		DB_GlobalFlag((FLAG)ORI_Astarion_State_GurGotAstarion_cd1687b8-3282-4121-aaa1-6de5eda6a9a4)
		THEN
		DB_GLO_CharacterCorpseDialog((CHARACTER)S_WYR_GurCamp_GurLeader_5e52cf9c-b673-45b7-888c-2c105eb4d890, (DIALOGRESOURCE)WYR_GurCamp_GurLeader_Dead_ByCazador_413fccb0-216a-3d9f-7ea8-52998371a3de);
		
		PROC
		PROC_GurCamp_Init()
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Astarion_State_GurGotAstarion_cd1687b8-3282-4121-aaa1-6de5eda6a9a4)
		THEN
		DB_WYR_GurCamp_IntroNPCs((CHARACTER)S_WYR_GurCamp_GurLeader_5e52cf9c-b673-45b7-888c-2c105eb4d890);
		PROC_DefineSingleOriginMoment((DIALOGRESOURCE)WYR_GurCamp_Intro_NoAstarion_dba01e99-e6e2-467d-411e-af5c12fe82ff, 
			(TAG)ASTARION_23a46e79-e73c-4043-940f-cb0aace9ab2e, 
			(DIALOGRESOURCE)WYR_GurCamp_Intro_OM_Astarion_AOM_OOM_9c323cba-b76e-961d-aab8-a9ea88153cad,
			(DIALOGRESOURCE)WYR_GurCamp_Intro_OM_Astarion_COM_efe497b7-6d46-c3d7-e610-b7d71e284fd7,
			(DIALOGRESOURCE)WYR_GurCamp_Intro_OM_Astarion_AOM_OOM_9c323cba-b76e-961d-aab8-a9ea88153cad);
		DB_OriginMoment_DontAutoClearOriginMoment(WYR_GurCamp_Intro_OM_Astarion_COM_efe497b7-6d46-c3d7-e610-b7d71e284fd7);
		DB_OriginMoment_DontAutoClearOriginMoment(WYR_GurCamp_Intro_OM_Astarion_AOM_OOM_9c323cba-b76e-961d-aab8-a9ea88153cad);
		DB_OriginMayLeaveDialog((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, WYR_GurCamp_Intro_OM_Astarion_COM_efe497b7-6d46-c3d7-e610-b7d71e284fd7);
		DB_GlobalFlagReactionAfterDialog((FLAG)WYR_GurCamp_State_BetrayedAstarion_e9410d3a-0ade-4bfe-93b8-af51fb7fc399, (DIALOGRESOURCE)WYR_GurCamp_Intro_OM_Astarion_COM_efe497b7-6d46-c3d7-e610-b7d71e284fd7);
		
		PROC
		PROC_GurCamp_Init()
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Astarion_State_GurGotAstarion_cd1687b8-3282-4121-aaa1-6de5eda6a9a4)
		AND
		DB_WYR_GurCamp_NPCs(_NPC, _Dialog)
		THEN
		DB_Dialogs(_NPC, _Dialog);
		
		PROC
		PROC_GurCamp_Init()
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Astarion_State_GurGotAstarion_cd1687b8-3282-4121-aaa1-6de5eda6a9a4)
		AND
		DB_WYR_GurCamp_IntroNPCs(_NPC)
		THEN
		DB_SpotPlayers(_NPC, "WYR_GurCamp_Intro", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		DB_SpotPlayers_HasTag(_NPC, "WYR_GurCamp_Intro", (TAG)ASTARION_23a46e79-e73c-4043-940f-cb0aace9ab2e, 1);
		DB_SpotPlayers_SpotTrigger(_NPC, "WYR_GurCamp_Intro", (TRIGGER)S_WYR_GurCamp_SpotArea_d14f3ee3-7bfb-46ab-ba01-f90b4ff50220);
		
		QRY
		QRY_SelectCustomDialog_AfterGenerics(S_GLO_GurHunter_0e47fcb9-c0c4-4b0c-902b-2d13d209e760, _Player)
		AND
		NOT DB_GlobalFlag(WYR_GurCamp_State_IntroHappened_75a9c2d3-ecad-4cdf-aebf-79d38e8ddb31)
		THEN
		DB_SelectedDialog(WYR_GurCamp_Intro_NoAstarion_dba01e99-e6e2-467d-411e-af5c12fe82ff, S_WYR_GurCamp_GurLeader_5e52cf9c-b673-45b7-888c-2c105eb4d890, _Player);
		
		PROC
		PROC_SpotPlayers_Spotted(_, "WYR_GurCamp_Intro", _Player)
		AND
		QRY_OnlyOnce("WYR_GurCamp_AstarionSpotted")
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)WYR_GurCamp_Intro_NoAstarion_dba01e99-e6e2-467d-411e-af5c12fe82ff, S_WYR_GurCamp_GurLeader_5e52cf9c-b673-45b7-888c-2c105eb4d890, _Player)
		THEN
		DB_NOOP(1);
		
		IF
		FlagSet((FLAG)WYR_GurCamp_State_IntroHappened_75a9c2d3-ecad-4cdf-aebf-79d38e8ddb31, _, _)
		THEN
		NOT DB_OriginMoment_DontAutoClearOriginMoment(WYR_GurCamp_Intro_OM_Astarion_COM_efe497b7-6d46-c3d7-e610-b7d71e284fd7);
		NOT DB_OriginMoment_DontAutoClearOriginMoment(WYR_GurCamp_Intro_OM_Astarion_AOM_OOM_9c323cba-b76e-961d-aab8-a9ea88153cad);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)WYR_GurCamp_Intro_NoAstarion_dba01e99-e6e2-467d-411e-af5c12fe82ff, _ID)
		AND
		DB_WYR_GurCamp_GurHunterPresent(1)
		AND
		NOT DB_GlobalFlag(WYR_GurCamp_State_IntroHappened_75a9c2d3-ecad-4cdf-aebf-79d38e8ddb31)
		THEN
		PROC_DialogAddSpeakingActor(_ID, S_GLO_GurHunter_0e47fcb9-c0c4-4b0c-902b-2d13d209e760);
		
		QRY
		QRY_OriginMoment_PreventRelaunchDialog((DIALOGRESOURCE)WYR_GurCamp_Intro_OM_Astarion_AOM_OOM_9c323cba-b76e-961d-aab8-a9ea88153cad, _, _)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_OriginMoment_PreventRelaunchDialog((DIALOGRESOURCE)WYR_GurCamp_Intro_OM_Astarion_COM_efe497b7-6d46-c3d7-e610-b7d71e284fd7, _, _)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)WYR_GurCamp_State_BetrayedAstarion_e9410d3a-0ade-4bfe-93b8-af51fb7fc399)
		AND
		GetFaction((CHARACTER)S_WYR_GurCamp_GurLeader_5e52cf9c-b673-45b7-888c-2c105eb4d890, _Faction)
		THEN
		PROC_SetRelationToPlayers(_Faction, 100);
		//END_REGION
		
		//REGION Hostility
		// If the player kills any of the gur they become permanently hostile
		IF
		KilledBy(_Gur, (CHARACTER)_Player, _, _)
		AND
		DB_WYR_GurCamp_NPCs(_Gur, _)
		AND
		DB_Players(_Player)
		AND
		NOT DB_GlobalFlag(WYR_GurCamp_State_PermanentlyHostile_32116fb3-5f46-4dda-8972-69a3d76cd6aa)
		THEN
		PROC_GlobalSetFlagAndCache(WYR_GurCamp_State_PermanentlyHostile_32116fb3-5f46-4dda-8972-69a3d76cd6aa);
		PROC_SetRelationToPlayers((FACTION)ACT3_WYR_GurCamp_87fe8d0d-31c9-4b10-8fc6-f0c232c24b13, 0);
		//END_REGION
		
		//REGION Meeting Ulma without Astarion
		IF
		FlagSet((FLAG)WYR_GurCamp_State_GaveQuestToKillCazador_109ed582-3803-4e0d-9e4a-7440e4fe02d0, _, _ID)
		AND
		DB_DialogName((DIALOGRESOURCE)WYR_GurCamp_Intro_NoAstarion_dba01e99-e6e2-467d-411e-af5c12fe82ff, _ID)
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		THEN
		SetFlag((FLAG)WYR_GurCamp_State_GotQuestWithoutAstarion_812187ec-06b8-4dc1-96c2-75274d039da0);
		//END_REGION
		
		//REGION Goal completion
		PROC
		PROC_LOW_CazadorsPalace_PrepareGur()
		THEN
		GoalCompleted;
		//END_REGION
	}
	EXIT
	{
	}
}
