		DB_Camp_BedAlternative((ITEM)S_CAMP_ELFSONG_Bed3_01c09d6c-388c-4355-9a78-71f223622edf,(TRIGGER)S_CAMP_Elfsong_Sleeptrigger3_397e3d62-0a2b-4801-9ef7-957804618f67);
