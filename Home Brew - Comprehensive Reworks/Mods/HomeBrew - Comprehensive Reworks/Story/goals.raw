		FlagSet(GLO_ShadowHeart_Knows_CityGoal_e1e57952-2b37-cc62-4e69-c0e4c2713c4e,_,_ID)
		AND
		DB_DialogName(CAMP_Shadowheart_IVB_CFM_LaezelFight_23f9c168-1017-fc9f-ed65-7e8a1e33a09f,_ID)
		AND
		DB_GlobalFlag(ShadowHeart_InParty_Knows_SharWorshipper_634f858d-9b54-0711-e31f-075d304422ab)
		AND
		DB_DialogPlayers(_ID,_Char,_)
		AND
		QRY_OnlyOnce("ORI_COM_ShadowHeart_LearnedMission")
		THEN
		QuestUpdate((CHARACTER)_Char,"ORI_COM_ShadowHeart","LearnedMission_KnowShar_KnowBoxMission");
		
		IF
		FlagSet(GLO_ShadowHeart_Knows_CityGoal_e1e57952-2b37-cc62-4e69-c0e4c2713c4e,_,_ID)
		AND
		DB_DialogName(CAMP_Shadowheart_IVB_CFM_LaezelFight_23f9c168-1017-fc9f-ed65-7e8a1e33a09f,_ID)
		AND
		DB_DialogPlayers(_ID,_Char,_)
		AND
		QRY_OnlyOnce("ORI_COM_ShadowHeart_LearnedMission")
		THEN
		QuestUpdate((CHARACTER)_Char,"ORI_COM_ShadowHeart","LearnedMission_UnknowShar_KnowBoxMission");
		
		IF
		FlagSet(GLO_ShadowHeart_Knows_CityGoal_e1e57952-2b37-cc62-4e69-c0e4c2713c4e,_,_ID)
		AND
		DB_GlobalFlag(ShadowHeart_InParty_Knows_SharWorshipper_634f858d-9b54-0711-e31f-075d304422ab)
		AND
		DB_DialogPlayers(_ID,_Char,_)
		AND
		QRY_OnlyOnce("ORI_COM_ShadowHeart_LearnedMission")
		THEN
		QuestUpdate((CHARACTER)_Char,"ORI_COM_ShadowHeart","LearnedMission_KnowShar_UnknowBoxMission");
		
		IF
		FlagSet(GLO_ShadowHeart_Knows_CityGoal_e1e57952-2b37-cc62-4e69-c0e4c2713c4e,_,_ID)
		AND
		DB_DialogPlayers(_ID,_Char,_)
		AND
		QRY_OnlyOnce("ORI_COM_ShadowHeart_LearnedMission")
		THEN
		QuestUpdate((CHARACTER)_Char,"ORI_COM_ShadowHeart","LearnedMission_UnknowShar_UnknowBoxMission");
		
		IF
		FlagSet(CAMP_ShadowheartLaezelFight_State_ResolvedPeacefully_f212b8b3-0490-1663-4645-e4fa7ca350e4,_,_)
		AND
		DB_Players(_Char)
		THEN
		QuestUpdate(_Char,"ORI_COM_ShadowHeart","CampFight_Peace");
		
		IF
		Died(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		GetFlag(CAMP_Shadowheart_Event_Fight_9e208379-c14f-b65a-c4a2-a029162939cb,S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12,1)
		AND
		DB_Players(_Char)
		THEN
		QuestUpdate(_Char,"ORI_COM_ShadowHeart","CampFight_LaezelDied");
		
		IF
		Died(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		AND
		GetFlag(CAMP_Shadowheart_Event_Fight_9e208379-c14f-b65a-c4a2-a029162939cb,S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,1)
		AND
		DB_Players(_Char)
		THEN
		QuestUpdate(_Char,"ORI_COM_ShadowHeart","CampFight_ShadowheartDied");
		//END_REGION
		
		//REGION Dark Justiciar Subquest
		
		PROC
		PROC_ORI_Shadowheart_COM_Init()
		THEN
		PROC_TriggerRegisterForPlayers(S_UND_SharTempleVista_77fb985c-36ee-47b6-8d5e-b2304613e13f);
		
		//--------------ORI_COM_Shadowheart_Sub_Justiciar_SearchLair----------------------
		
		IF
		FlagSet(_Flag,_,_ID)
		AND
		DB_ORI_Shadowheart_HintFlag(_Flag)
		AND
		DB_GlobalFlag((FLAG)ORI_Shadowheart_Knows_BecomeJusticiar_c29b8679-3e0b-43f9-8578-2a5d7659180e)
		AND
		DB_GlobalFlag(ShadowHeart_InParty_Knows_SharWorshipper_634f858d-9b54-0711-e31f-075d304422ab)
		AND
		DB_DialogPlayers(_ID,_Char,_)
		THEN
		QuestUpdate((CHARACTER)_Char,"ORI_COM_ShadowHeart","SearchJusticiarLair_KnowShar");
		
		IF
		TextEvent("test")
		THEN
		QuestUpdate("ORI_COM_ShadowHeart", "SearchJusticiarLair_KnowShar");
		
		IF
		FlagSet(_Flag,_,_ID)
		AND
		DB_ORI_Shadowheart_HintFlag(_Flag)
		AND
		DB_GlobalFlag((FLAG)ORI_Shadowheart_Knows_BecomeJusticiar_c29b8679-3e0b-43f9-8578-2a5d7659180e)
		AND
		NOT DB_GlobalFlag(ShadowHeart_InParty_Knows_SharWorshipper_634f858d-9b54-0711-e31f-075d304422ab)
		AND
		DB_DialogPlayers(_ID,_Char,_)
		THEN
		QuestUpdate((CHARACTER)_Char,"ORI_COM_ShadowHeart","SearchJusticiarLair_UnknowShar");
		
		//--------------ORI_COM_Shadowheart_Sub_Justiciar_ExploreGrymforge----------------------
		
		IF
		FlagSet((FLAG)UND_DarkJusticiars_Quest_FoundCorpses_d0385e17-0730-4c65-863d-0235395a05ed, _, _ID)
		AND
		DB_GlobalFlag(ShadowHeart_InParty_Knows_SharWorshipper_634f858d-9b54-0711-e31f-075d304422ab)
		AND
		DB_DialogPlayers(_ID, _Char, _)
		THEN
		QuestUpdate((CHARACTER)_Char, "ORI_COM_ShadowHeart", "FoundJusiticiar_KnowShar");
		
		IF
		FlagSet((FLAG)UND_DarkJusticiars_Quest_FoundCorpses_d0385e17-0730-4c65-863d-0235395a05ed, _, _ID)
		AND
		NOT DB_GlobalFlag(ShadowHeart_InParty_Knows_SharWorshipper_634f858d-9b54-0711-e31f-075d304422ab)
		AND
		DB_DialogPlayers(_ID, _Char, _)
		THEN
		QuestUpdate((CHARACTER)_Char, "ORI_COM_ShadowHeart", "FoundJusiticiar_UnknowShar");
		
		IF
		FlagSet((FLAG)UND_DarkJusticiars_Quest_FoundFiends_8393d02d-0343-48b5-a27b-1c35e3641e37, _, _ID)
		AND
		DB_DialogPlayers(_ID, _Char, _)
		AND
		QRY_OnlyOnce("UND_DarkJusticiars_FoughtMerregon")
		THEN
		QuestUpdate((CHARACTER)_Char, "ORI_COM_ShadowHeart", "FoughtFiends");
		
		IF
		EnteredCombat(S_UND_KethericCity_LostMerregon_07e9b38f-624c-45db-b3fa-b45737314796, _ID)
		AND
		DB_Is_InCombat(_Player, _ID)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		QRY_OnlyOnce("UND_DarkJusticiars_FoughtMerregon")
		THEN
		QuestUpdate((CHARACTER)_Player, "ORI_COM_ShadowHeart", "FoughtFiends");
		
		IF
		EnteredTrigger(_Char,S_UND_DuergarCamp_SUB_05c3bf1f-29a6-437c-9a98-c1ff0ec53a53)
		AND
		DB_OnlyOnce("RecruitedFirstTime_ShadowHeart")
		AND
		DB_Players(_Char)
		THEN
		QuestUpdate(_Char,"ORI_COM_ShadowHeart","EnteredKethericCity");
		
		//--------------ORI_COM_Shadowheart_Sub_Justiciar_ReachTemple----------------------
		
		IF
		FlagSet((FLAG)UND_DarkJusticiars_Quest_HeardSharTemple_810cc654-76ab-4070-af16-47147dbea6b8, _, _ID)
		AND
		DB_DialogPlayers(_ID, _Char, _)
		THEN
		QuestUpdate((CHARACTER)_Char, "ORI_COM_ShadowHeart", "HeardSharTemple");
		
		IF
		FlagSet((FLAG)UND_DarkJusticiars_Quest_HeardSharTempleBlocked_f99761c4-132c-47f0-92bc-f466b5de7cbb, _, _ID)
		AND
		DB_DialogPlayers(_ID, _Char, _)
		AND
		QRY_OnlyOnce("UND_DarkJusticiars_LearnedBlocked")
		THEN
		QuestUpdate((CHARACTER)_Char, "ORI_COM_ShadowHeart", "HeardSharTemplePathBlocked");
		
		IF
		EnteredTrigger(_Char, S_UND_SharTempleVista_77fb985c-36ee-47b6-8d5e-b2304613e13f)
		AND
		DB_Players(_Char)
		AND
		QuestUpdateIsUnlocked(_Char, "ORI_COM_ShadowHeart", "HeardSharTemple", 1)
		AND
		QRY_OnlyOnce("UND_DarkJusticiars_LearnedBlocked")
		AND
		QRY_OnlyOnce("UND_DarkJusticiars_SharVistaSeen")
		THEN
		PROC_TriggerUnregisterForPlayers(S_UND_SharTempleVista_77fb985c-36ee-47b6-8d5e-b2304613e13f);
		QuestUpdate(_Char,"ORI_COM_ShadowHeart", "HeardSharTemplePathBlocked");
		
		IF
		EnteredTrigger(_Char, S_UND_SharTempleVista_77fb985c-36ee-47b6-8d5e-b2304613e13f)
		AND
		DB_Players(_Char)
		AND
		QuestUpdateIsUnlocked(_Char, "ORI_COM_ShadowHeart", "HeardSharTemple", 0)
		AND
		QRY_OnlyOnce("UND_DarkJusticiars_SharVistaSeen")
		THEN
		PROC_TriggerUnregisterForPlayers(S_UND_SharTempleVista_77fb985c-36ee-47b6-8d5e-b2304613e13f);
		QuestUpdate(_Char,"ORI_COM_ShadowHeart", "WalkedSharTemplePathBlocked");
		
		//END_REGION
		//END_REGION
		
		//REGION Recruit and Move to Camp
		PROC
		PROC_GLO_PartyMembers_AddHook(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,(CHARACTER)_Player)
		AND
		QRY_OnlyOnce("RecruitedFirstTime_ShadowHeart")
		THEN
		PROC_ORI_SetupCamp(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,0);
		SetFlag(ORI_ShadowHeart_HasMet_d06842a4-248e-7f83-da87-4eec7606178e,NULL_00000000-0000-0000-0000-000000000000,0);
		
		PROC
		PROC_GLO_PartyMembers_AddHook(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,_)
		AND
		NOT DB_CurrentLevel("TUT_Avernus_C")
		AND
		QRY_OnlyOnce("ORI_ShadowHeart_COM_Init")
		THEN
		PROC_ORI_Shadowheart_COM_Init();
		
		IF
		EntityEvent(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,"ORI_ToCamp")
		AND
		QRY_OnlyOnce("ORI_ShadowHeart_COM_Init")
		THEN
		PROC_ORI_Shadowheart_COM_Init();
		
		PROC
		PROC_ORI_Shadowheart_COM_Init()
		AND
		DB_GlobalFlag((FLAG)TUT_TransformChamber_State_FreedShadowheart_c3980ab3-9370-4c2d-9c76-38aff5fe575a)
		THEN
		SetFlag(ORI_Shadowheart_Event_LaezelFirst_d68af374-5808-5b37-210c-21f9e1c8c201,NULL_00000000-0000-0000-0000-000000000000);
		
		PROC
		PROC_ORI_Shadowheart_COM_Init()
		AND
		NOT DB_GlobalFlag(ShadowHeart_InParty_Knows_SharWorshipper_634f858d-9b54-0711-e31f-075d304422ab)
		THEN
		DB_StoryHideGodTags(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679);
		
		IF
		FlagSet(ShadowHeart_InParty_Knows_SharWorshipper_634f858d-9b54-0711-e31f-075d304422ab,_,_)
		THEN
		NOT DB_StoryHideGodTags(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679);
		
		IF
		TextEvent("shadowheart2camp")
		THEN
		PROC_ORI_SetupCamp(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,1);
		
		IF
		EntityEvent(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,"DebugTeleportedToCamp")
		THEN
		PROC_ORI_SetupCamp(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,1);
		//END_REGION
		
		//REGION DB_ORI_ShadowHeart_ADFoe
		IF
		DB_ORI_ShadowHeart_ADFoe(_Char)
		AND
		DB_Avatars(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		THEN
		NOT DB_ORI_ShadowHeart_ADFoe(_Char);
		
		IF
		DB_ORI_ShadowHeart_ADFoe(_Char)
		AND
		DB_OnlyOnce("ORI_ShadowHeart_FirstCombatVB")
		THEN
		NOT DB_ORI_ShadowHeart_ADFoe(_Char);
		
		IF
		DB_CHA_OutsideBandits(_Char)
		THEN
		DB_ORI_ShadowHeart_ADFoe(_Char);
		
		IF
		DB_CHA_InsideBandits(_Char,_)
		THEN
		DB_ORI_ShadowHeart_ADFoe(_Char);
		
		IF
		DB_CHA_Outpost_CreviceFoe(_Char,_)
		THEN
		DB_ORI_ShadowHeart_ADFoe(_Char);
		
		IF
		DB_DEN_HarpyMeal_Harpies(_Char,_)
		THEN
		DB_ORI_ShadowHeart_ADFoe(_Char);
		
		IF
		DB_DEN_GoblinScouts(_Char)
		THEN
		DB_ORI_ShadowHeart_ADFoe(_Char);
		//END_REGION
		
		//REGION Combat VB
		IF
		EnteredCombat(_Char,_ID)
		AND
		DB_ORI_ShadowHeart_ADFoe(_Char)
		THEN
		DB_ORI_ShadowHeart_FirstCombat(_ID,1);
		
		IF
		DB_Is_InCombat(_Char,_ID)
		AND
		DB_ORI_ShadowHeart_FirstCombat(_ID,1)
		AND
		DB_Players((CHARACTER)_Char)
		AND
		_Char != S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679
		THEN
		DB_ORI_ShadowHeart_FirstCombat(_ID,2);
		
		IF
		DB_Defeated(_Char)
		AND
		DB_Players((CHARACTER)_Char)
		AND
		DB_Is_InCombat(_Char,_ID)
		AND
		DB_ORI_ShadowHeart_FirstCombat(_ID,1)
		THEN
		DB_ORI_ShadowHeart_FirstCombat(_ID,0);
		
		QRY
		QRY_ORI_ShadowHeart_EnemyRemains((GUIDSTRING)_Char,(GUIDSTRING)_ID)
		AND
		DB_Is_InCombat(_Foe,_ID)
		AND
		NOT DB_Defeated(_Foe)
		AND
		QRY_IsEnemy(_Char,_Foe)
		THEN
		DB_NOOP(1);
		
		IF
		LeftCombat(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,_ID)
		AND
		NOT DB_OnlyOnce("ORI_ShadowHeart_FirstCombatVB")
		AND
		DB_ORI_ShadowHeart_FirstCombat(_ID,2)
		AND
		NOT DB_ORI_ShadowHeart_FirstCombat(_ID,0)
		AND
		DB_Players((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		AND
		NOT QRY_ORI_ShadowHeart_EnemyRemains(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,_ID)
		AND
		QRY_StartDialogCustom_Fixed(ORI_ShadowHeart_AD_SuccessfulCombat_23bccc36-35be-91ca-a3d0-a8f954629e06,S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,0,0,0,0)
		THEN
		DB_OnlyOnce("ORI_ShadowHeart_FirstCombatVB");
		
		IF
		CombatEnded(_ID)
		AND
		DB_ORI_ShadowHeart_FirstCombat(_ID,_Int)
		THEN
		NOT DB_ORI_ShadowHeart_FirstCombat(_ID,_Int);
		//END_REGION
	}
	EXIT
	{
	}
}
