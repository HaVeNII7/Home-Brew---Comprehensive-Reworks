		DB_TopicalGreetingStartCondition_FlagSet((FLAG)TG_CRE_DidZaithisk_44dd5c7a-3db8-4ad0-8a82-345a55d6043f,(FLAG)CRE_GithInfirmary_State_UsedDevice_a56d58c6-2a81-4a80-a4f6-4f73f254b40c);
