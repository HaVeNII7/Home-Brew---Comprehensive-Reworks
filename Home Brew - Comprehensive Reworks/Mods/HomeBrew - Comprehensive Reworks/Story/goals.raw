{
	INIT
	{
	}
	KB
	{
		PROC
		PROC_BG3_SavegamePatches_SetUnloadTag((GUIDSTRING)_Entity, (LEVELTEMPLATE)_CampLT, (STRING)_BugfixMarker)
		AND
		Exists(_Entity, 1)
		AND
		IsTagged(_Entity, (TAG)UNLOAD_WITH_LEVELTEMPLATE_87572f4a-8462-4042-a06a-caba1e0eb2cb, 0)
		THEN
		SetTag(_Entity, (TAG)UNLOAD_WITH_LEVELTEMPLATE_87572f4a-8462-4042-a06a-caba1e0eb2cb);
		DB_BUGFIX_Marker_GUS309397(_BugfixMarker, _Entity, _CampLT);
		
		PROC
		PROC_BG3_SavegamePatches_SetUnloadTag((GUIDSTRING)_Entity, (LEVELTEMPLATE)_CampLT, (STRING)_BugfixMarker)
		AND
		Exists(_Entity, 1)
		AND
		NOT DB_LevelTemplateLoaded(_CampLT)
		AND
		Concatenate(_BugfixMarker, "_Unloaded", _UnloadedBugfixMarker)
		THEN
		UnloadItem(_Entity);
		DB_BUGFIX_Marker_GUS309397(_UnloadedBugfixMarker, _Entity, _CampLT);
		
		//REGION Act 1
