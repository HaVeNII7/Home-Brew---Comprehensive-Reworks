		RemoveStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_BURNING_HIGHLEVEL_VFX", S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		RemoveStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_BURNING_LOWLEVEL_VFX", S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		//END_REGION Burning state
		
		//REGION Overdrive
		IF
		TemplateUseFinished(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (ITEMROOT)LOOT_SoulCoin_8c68e68d-96d4-45d6-804c-5f31ac948ff3, _, 1)
		THEN
		PROC_IncreaseCounter("ORI_Karlach_SoulCoinsConsumed");
		
		PROC
		PROC_CounterIncreased("ORI_Karlach_SoulCoinsConsumed", 10)
		THEN
		SetFlag(ORI_Karlach_State_OverdriveSkillUnlocked_8247bd54-e88c-4712-b9c9-25eb9fc890af, NULL_00000000-0000-0000-0000-000000000000);
		SetFlag(ORI_Karlach_Event_ReachedOverdrive_8c308560-7a87-49f5-ae52-143b48dd963b, NULL_00000000-0000-0000-0000-000000000000);
		PROC_RelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_ReachedOverdrive_b64bb016-8c5a-433c-9726-967996799ea9, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 0);
		
		IF
		DB_GlobalFlag(ORI_Karlach_Event_ReachedOverdrive_8c308560-7a87-49f5-ae52-143b48dd963b)
		AND
		DB_Avatars((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		NOT DB_CantTalk(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		PROC_ORI_Karlach_AvatarOverdriveDialog();
		
		PROC
		PROC_ORI_Karlach_AvatarOverdriveDialog()
		THEN
		PROC_GlobalClearFlagAndCache(ORI_Karlach_Event_ReachedOverdrive_8c308560-7a87-49f5-ae52-143b48dd963b);
		
		PROC
		PROC_ORI_Karlach_AvatarOverdriveDialog()
		AND
		QRY_StartDialog_Fixed(ORI_Karlach_AvatarOverdrive_c1899f27-c130-2c09-c7b2-6085f8514e8e, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		DB_NOOP(1);
		//END_REGION Overdrive
		
		//REGION Forging of the Heart - GLO
		IF
		DialogEnded(_OM, _ID)
		AND
		DB_ORI_Karlach_ForgingOfTheHeart_OMFlags(_, _OM, _Level, _Flag)
		AND
		NOT DB_DialogRequestFailed(_OM, _ID)
		AND
		DB_CurrentLevel(_Level)
		AND
		NOT DB_GlobalFlag(_Flag)
		THEN
		SetFlag(_Flag, NULL_00000000-0000-0000-0000-000000000000);
		
		QRY
		QRY_OM_BlockDisablingTrade(_Dialog, _, _)
		AND
		DB_ORI_Karlach_ForgingOfTheHeart_Dialogues(_Dialog)
		THEN
		DB_NOOP(1);
		
		IF
		TemplateAddedTo((ITEMROOT)_Template, _, (CHARACTER)_Player, _)
		AND
		DB_ORI_Karlach_InfernalMetalTemplates(_Template)
		AND
		DB_Players(_Player)
		AND
		DB_Players((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		NOT DB_GlobalFlag((FLAG)PLA_KarlachRecruitment_State_DammonUnavailable_96af4ae3-496d-497f-afb5-fec042fe6f27)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade_f6dc0de4-1089-43c0-b392-306a9a44387c)
		AND
		NOT QRY_PreventMPDialogue(_Player, (CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		QRY_OnlyOnce("ORI_Karlach_PlayFoundInfernalMetalPAD")
		THEN
		PROC_TryStartAD(GLO_ForgingOfTheHeart_PAD_FoundInfernalMetal_2b7ced89-ad85-7490-33af-d5c5050b8333, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		
		IF
		FlagSet((FLAG)GLO_ForgingOfTheHeart_Knows_DammonCanUpgradeKarlach_226d82fb-711b-64ac-e59a-b4361ce2204e, _, _)
		AND
		QRY_OnlyOnce_Reset("ORI_Karlach_PlayFoundInfernalMetalPAD")
		THEN
		SetFlag(ORI_Karlach_State_FoundMetalBranchUnlocked_e262fc84-d7ea-4e21-98de-102fcdc57ed0, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		FlagSet((FLAG)GLO_ForgingOfTheHeart_State_KarlachUpgraded_a818e2f5-9e0c-4ab3-8c1e-00765d3b892f, _, _)
		AND
		QRY_OnlyOnce_Reset("ORI_Karlach_PlayFoundInfernalMetalPAD")
		THEN
		SetFlag(ORI_Karlach_State_FoundMetalBranchUnlocked_e262fc84-d7ea-4e21-98de-102fcdc57ed0, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		FlagSet((FLAG)GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade_f6dc0de4-1089-43c0-b392-306a9a44387c, _, _)
		THEN
		ClearFlag(ORI_Karlach_State_FoundMetalBranchUnlocked_e262fc84-d7ea-4e21-98de-102fcdc57ed0, NULL_00000000-0000-0000-0000-000000000000);
		
		// Template handling
		IF
		TemplateAddedTo((ITEMROOT)_Template, (ITEM)_InfernalMetal, S_DEN_Weaponsmith_e2ad06ec-8034-479a-9f69-b86faea6dc79, "Regular")
		AND
		DB_ORI_Karlach_InfernalMetalTemplates(_Template)
		AND
		GetFlag((FLAG)GLO_ForgingOfTheHeart_State_ReceivedInfernalMetal_b2d05896-e0b7-4f46-8a54-2db04eae6d4b, S_DEN_Weaponsmith_e2ad06ec-8034-479a-9f69-b86faea6dc79, 1)
		THEN
		ClearFlag((FLAG)GLO_ForgingOfTheHeart_State_ReceivedInfernalMetal_b2d05896-e0b7-4f46-8a54-2db04eae6d4b, S_DEN_Weaponsmith_e2ad06ec-8034-479a-9f69-b86faea6dc79);
		RequestDelete(_InfernalMetal);
		
		// Karlach upgrades
		IF
		FlagSet((FLAG)GLO_ForgingOfTheHeart_State_KarlachUpgraded_a818e2f5-9e0c-4ab3-8c1e-00765d3b892f, _, _)
		THEN
		ApplyStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_FIRSTUPGRADE", -1.0, 1, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		PROC_RelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_FirstUpgrade_4b10a176-899f-f5ab-a292-3ad35324f47d, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 0);
		
		IF
		FlagSet((FLAG)GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade_f6dc0de4-1089-43c0-b392-306a9a44387c, _, _)
		THEN
		SetFlag(GLO_Karlach_State_CanHaveSex_1ea8dd6c-0562-473d-8310-6fdfdbffadca, NULL_00000000-0000-0000-0000-000000000000);
		RemoveStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_FIRSTUPGRADE");
		ApplyStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_SECONDUPGRADE", -1.0, 1, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		PROC_RelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_SecondUpgrade_54aef59f-3758-4254-a315-3723e9f9edc9, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 0);
		
		IF
		FlagSet((FLAG)GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade_f6dc0de4-1089-43c0-b392-306a9a44387c, _, _)
		AND
		DB_Avatars((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		DB_GLO_ForgingOfTheHeart_StartSecondUpgradeAvatarDialog(1);
		
		IF
		DB_GLO_ForgingOfTheHeart_StartSecondUpgradeAvatarDialog(1)
		AND
		NOT DB_CantTalk(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)ORI_Karlach_AvatarSecondUpgrade_ef579550-65ac-5e3f-9430-bb689d0175ae, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		NOT DB_GLO_ForgingOfTheHeart_StartSecondUpgradeAvatarDialog(1);
		
		PROC
		PROC_Camp_EveryoneWakeupEndHook()
		AND
		DB_GlobalFlag((FLAG)HAV_ForgingOfTheHeart_State_UnlockUpgradeNextDay_40dd7a6c-89a8-b301-a935-915059472061)
		THEN
		SetFlag((FLAG)HAV_ForgingOfTheHeart_State_ReadyForSecondUpgrade_edce0ffd-21d1-7a6c-2b55-a3e749d06fca, NULL_00000000-0000-0000-0000-000000000000);
		ClearFlag((FLAG)HAV_ForgingOfTheHeart_State_UnlockUpgradeNextDay_40dd7a6c-89a8-b301-a935-915059472061, NULL_00000000-0000-0000-0000-000000000000);
		PROC_DefineSingleOriginMoment((DIALOGRESOURCE)HAV_TieflingSurvivors_Weaponsmith_c2312421-411c-757e-551b-3e7ddbb9d7e7, (TAG)REALLY_KARLACH_1a2f70d6-8ead-4eb5-a824-79ee1971764a, (DIALOGRESOURCE)GLO_ForgingOfTheHeart_OM_Karlach_AOM_OOM_COM_e31f3936-c198-cf82-bd8f-e26efba691f1);
		PROC_DefineSingleOriginMoment((DIALOGRESOURCE)LOW_Dammon_028c720e-ece2-d8e4-de6c-cd4fa8faad26, (TAG)REALLY_KARLACH_1a2f70d6-8ead-4eb5-a824-79ee1971764a, (DIALOGRESOURCE)GLO_ForgingOfTheHeart_OM_Karlach_AOM_OOM_COM_e31f3936-c198-cf82-bd8f-e26efba691f1);
		
		// Define post OM origin moment as long as she can be upgraded
		QRY
		QRY_SelectCustomDialog_AfterGenerics(S_DEN_Weaponsmith_e2ad06ec-8034-479a-9f69-b86faea6dc79, _Player)
		AND
		DB_CurrentLevel(_CurrentLevel)
		AND
		DB_ORI_Karlach_ForgingOfTheHeart_OMFlags(_Dialog, _, _CurrentLevel, _Flag)
		AND
		DB_GlobalFlag(_Flag)
		AND
		DB_GlobalFlag((FLAG)GLO_ForgingOfTheHeart_Knows_DammonCanUpgradeKarlach_226d82fb-711b-64ac-e59a-b4361ce2204e)
		AND
		NOT DB_DoubleOriginMoment(_Dialog,_,_,GLO_ForgingOfTheHeart_FollowUp_OM_Karlach_AOM_OOM_COM_b141c825-0beb-5216-a106-e5cec367f70b,_,_,_,_,_,_,_)
		AND
		DB_Dialogs(S_DEN_Weaponsmith_e2ad06ec-8034-479a-9f69-b86faea6dc79, _Dialog) // Only set for current default dialog
		AND
		QRY_GLO_Karlach_TryDefineForgingOfTheHeartFollowUp(_Dialog)
		AND
		0 == 1 // Ugly thing to avoid having to click twice on Dammon to start the dialog.
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_GLO_Karlach_TryDefineForgingOfTheHeartFollowUp((DIALOGRESOURCE)_Dialog)
		AND
		NOT QRY_GLO_Karlach_BlockForgingOfTheHeartFollowUp()
		AND
		DB_ORI_Karlach_ForgingOfTheHeart_DevDialogues(_Dialog, _DevDialog) //TODO: Remove once we remove PostEA dialogues
		THEN
		PROC_DefineSingleOriginMoment(_DevDialog, (TAG)KARLACH_9aab4bcd-e1f7-4008-8f7b-f1203789ae9b, GLO_ForgingOfTheHeart_FollowUp_OM_Karlach_AOM_OOM_COM_b141c825-0beb-5216-a106-e5cec367f70b);
		
		QRY
		QRY_GLO_Karlach_BlockForgingOfTheHeartFollowUp()
		AND
		DB_GlobalFlag((FLAG)HAV_ForgingOfTheHeart_State_UnlockUpgradeNextDay_40dd7a6c-89a8-b301-a935-915059472061)
		AND
		NOT DB_GlobalFlag((FLAG)HAV_ForgingOfTheHeart_State_ReadyForSecondUpgrade_edce0ffd-21d1-7a6c-2b55-a3e749d06fca)
		THEN
		DB_NOOP(1);
		
		// Cancel OMs in Act 1 if got first upgrade.
		IF
		FlagSet((FLAG)GLO_ForgingOfTheHeart_State_KarlachUpgraded_a818e2f5-9e0c-4ab3-8c1e-00765d3b892f, _, _)
		THEN
		NOT DB_ORI_Karlach_ForgingOfTheHeart_OMFlags((DIALOGRESOURCE)DEN_Weaponsmith_PostEA_f2e19bab-4804-9a49-c7ee-0a190f1fcafd, (DIALOGRESOURCE)DEN_ForgingOfTheHeart_OM_Karlach_AOM_OOM_COM_61ffefa2-22fd-2f44-cfd1-29abbba4a2fd, "WLD_Main_A", (FLAG)ORI_Karlach_State_HadForgingOfTheHeartOM_Act1_7fe068a3-9d1f-438f-ba2a-3e4379d32f20);
		NOT DB_ORI_Karlach_ForgingOfTheHeart_OMFlags((DIALOGRESOURCE)DEN_DruidAttack_Weaponsmith_PostEA_23532629-93cf-a224-d39d-f29825c49025, (DIALOGRESOURCE)DEN_ForgingOfTheHeart_OM_Karlach_AOM_OOM_COM_61ffefa2-22fd-2f44-cfd1-29abbba4a2fd, "WLD_Main_A", (FLAG)ORI_Karlach_State_HadForgingOfTheHeartOM_Act1_7fe068a3-9d1f-438f-ba2a-3e4379d32f20);
		NOT DB_ORI_Karlach_ForgingOfTheHeart_OMFlags((DIALOGRESOURCE)DEN_AttackOnDen_Weaponsmith_f74a35e9-5895-dd0f-5c83-52009f6b0379, (DIALOGRESOURCE)DEN_ForgingOfTheHeart_OM_Karlach_AOM_OOM_COM_61ffefa2-22fd-2f44-cfd1-29abbba4a2fd, "WLD_Main_A", (FLAG)ORI_Karlach_State_HadForgingOfTheHeartOM_Act1_7fe068a3-9d1f-438f-ba2a-3e4379d32f20);
		PROC_ClearOriginMoment((DIALOGRESOURCE)GLO_ForgingOfTheHeart_FollowUp_OM_Karlach_AOM_OOM_COM_b141c825-0beb-5216-a106-e5cec367f70b);
		
		// Clear any follow ups after second upgrade.
		IF
		FlagSet(GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade_f6dc0de4-1089-43c0-b392-306a9a44387c, _, _)
		AND
		DB_ORI_Karlach_ForgingOfTheHeart_OMFlags(_Dialog, _OM, _CurrentLevel, _Flag)
		THEN
		NOT DB_ORI_Karlach_ForgingOfTheHeart_OMFlags(_Dialog, _OM, _CurrentLevel, _Flag);
		
		IF
		FlagSet(GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade_f6dc0de4-1089-43c0-b392-306a9a44387c, _, _)
		THEN
		PROC_ClearOriginMoment((DIALOGRESOURCE)GLO_ForgingOfTheHeart_FollowUp_OM_Karlach_AOM_OOM_COM_b141c825-0beb-5216-a106-e5cec367f70b);
		PROC_TopicalGreeting_UnlockTopic((FLAG)TG_ORI_Karlach_GotSecondUpgrade_617c5dc9-0c92-49f6-8994-63e9d06edb6a);
		
		QRY
		QRY_OriginMoment_PreventRelaunchDialog(GLO_ForgingOfTheHeart_FollowUp_OM_Karlach_AOM_OOM_COM_b141c825-0beb-5216-a106-e5cec367f70b, S_DEN_Weaponsmith_e2ad06ec-8034-479a-9f69-b86faea6dc79, _Player)
		THEN
		DB_NOOP(1);
		
		// IPRD for finding more infernal metal.
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)GLO_ForgingOfTheHeart_Event_ToldToGetMoreMetal_b2c0ae25-b3d7-eea3-7468-4283334e9b6c)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade_f6dc0de4-1089-43c0-b392-306a9a44387c)
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_FindMoreMetal_b821a524-63b8-0f73-a49f-51e05fa3a048, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 0);
		
		IF
		FlagSet(_Flag, _, _)
		AND
		DB_ORI_Karlach_ForgingOfTheHeart_InfernalMetalBranch(_Flag, 1)
		THEN
		ClearFlag((FLAG)GLO_ForgingOfTheHeart_State_BlockInfernalMetalQuestion_8095c7e4-d365-d4f2-2f95-69da62ddb0a4, NULL_00000000-0000-0000-0000-000000000000);
		
		// Shadowcursed Dammon
		IF
		DB_Sees(_Player, (CHARACTER)S_DEN_Weaponsmith_e2ad06ec-8034-479a-9f69-b86faea6dc79)
		AND
		DB_Players(_Player)
		AND
		DB_CustomDefeatedState(S_DEN_Weaponsmith_e2ad06ec-8034-479a-9f69-b86faea6dc79, "SCL_Shadowcurse")
		THEN
		SetFlag((FLAG)ORI_Karlach_State_SeenDammonDeadSpotter_3f8853b9-97ee-41ac-bb87-2b0b6120e271, _Player);
		SetFlag((FLAG)ORI_Karlach_State_SeenDammonDead_a39ffb36-e11c-4335-b721-9926e4cba0b5, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		FlagSet(_Flag, _, _)
		AND
		DB_ORI_Karlach_ForgingOfTheHeart_InfernalMetalBranch(_Flag, 0)
		THEN
		SetFlag((FLAG)GLO_ForgingOfTheHeart_State_BlockInfernalMetalQuestion_8095c7e4-d365-d4f2-2f95-69da62ddb0a4, NULL_00000000-0000-0000-0000-000000000000);
		
		// If Karlach finds Dammon unlock WRD instead (she already knows he is dead)
		IF
		FlagSet((FLAG)ORI_Karlach_State_SeenDammonDeadSpotter_3f8853b9-97ee-41ac-bb87-2b0b6120e271, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _)
		AND
		DB_GlobalFlag((FLAG)GLO_ForgingOfTheHeart_Knows_DammonCanUpgradeKarlach_226d82fb-711b-64ac-e59a-b4361ce2204e)
		THEN
		SetFlag((FLAG)ORI_Karlach_Knows_DammonIsDead_821a5eea-1a8b-9cc0-259a-4e975ad09189, NULL_00000000-0000-0000-0000-000000000000);
		PROC_RelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)GLO_Karlach_WRD_DammonDead_e093ac8d-05ab-731d-e8ab-5aa56df0f11b, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		//END_REGION Forging of the Heart - GLO
		
		//REGION Steel watchers encounter (shared between multiple act levels)
		// Only trigger for their default dialogues.
		IF
		DB_GLO_SteelWatchers(_SteelWatcher)
		AND
		DB_Dialogs(_SteelWatcher, _Dialog)
		AND
		NOT DB_ORI_Karlach_SteelWatcher_ProcessedDialogues(_Dialog)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Karlach_State_EncounteredSteelWatcher_a60d0317-5188-464d-b8c4-1f5307a7a65b)
		THEN
		DB_ORI_Karlach_SteelWatcher_ProcessedDialogues(_Dialog);
		PROC_DefineSingleOriginMoment(_Dialog, (TAG)KARLACH_9aab4bcd-e1f7-4008-8f7b-f1203789ae9b, GLO_SteelWatchers_OM_Karlach_AOM_OOM_fadbf09f-e900-e797-0606-db5c8f3e54b6, (DIALOGRESOURCE)GLO_SteelWatchers_OM_Karlach_COM_bab2d2bc-7f56-3408-a2ad-1e9699f291c6, (DIALOGRESOURCE)GLO_SteelWatchers_OM_Karlach_AOM_OOM_fadbf09f-e900-e797-0606-db5c8f3e54b6);
		
		// Other non-generic default dialogues
		IF
		DB_GLO_SteelWatchers_CustomDialog(_SteelWatcher)
		AND
		DB_Dialogs(_SteelWatcher, _Dialog)
		AND
		NOT DB_ORI_Karlach_SteelWatcher_ProcessedDialogues(_Dialog)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Karlach_State_EncounteredSteelWatcher_a60d0317-5188-464d-b8c4-1f5307a7a65b)
		THEN
		DB_ORI_Karlach_SteelWatcher_ProcessedDialogues(_Dialog);
		PROC_DefineSingleOriginMoment(_Dialog, (TAG)KARLACH_9aab4bcd-e1f7-4008-8f7b-f1203789ae9b, GLO_SteelWatchers_OM_Karlach_AOM_OOM_fadbf09f-e900-e797-0606-db5c8f3e54b6, (DIALOGRESOURCE)GLO_SteelWatchers_OM_Karlach_COM_bab2d2bc-7f56-3408-a2ad-1e9699f291c6, (DIALOGRESOURCE)GLO_SteelWatchers_OM_Karlach_AOM_OOM_fadbf09f-e900-e797-0606-db5c8f3e54b6);
		
		IF
		DialogStarted((DIALOGRESOURCE)GLO_SteelWatchers_OM_Karlach_COM_bab2d2bc-7f56-3408-a2ad-1e9699f291c6, _)
		THEN
		SetFlag((FLAG)ORI_Karlach_State_EncounteredSteelWatcher_a60d0317-5188-464d-b8c4-1f5307a7a65b, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		DialogStarted((DIALOGRESOURCE)GLO_SteelWatchers_OM_Karlach_AOM_OOM_fadbf09f-e900-e797-0606-db5c8f3e54b6, _)
		THEN
		SetFlag((FLAG)ORI_Karlach_State_EncounteredSteelWatcher_a60d0317-5188-464d-b8c4-1f5307a7a65b, NULL_00000000-0000-0000-0000-000000000000);
		
		// We are blocking Karlach's OM if she tries to speak with a steel watcher inside the ceremony room.
		QRY
		QRY_OriginMoment_OutsideCOMTrigger((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)GLO_SteelWatchers_OM_Karlach_AOM_OOM_fadbf09f-e900-e797-0606-db5c8f3e54b6)
		AND
		IsInTrigger(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (TRIGGER)S_WYR_WyrmRock_AudienceHallArea_a078f420-9f5e-452b-9391-e96e754b61c8, 1)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_OriginMoment_OutsideCOMTrigger((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)GLO_SteelWatchers_OM_Karlach_COM_bab2d2bc-7f56-3408-a2ad-1e9699f291c6)
		AND
		IsInTrigger(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (TRIGGER)S_WYR_WyrmRock_AudienceHallArea_a078f420-9f5e-452b-9391-e96e754b61c8, 1)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_OriginMoment_PreventRelaunchDialog((DIALOGRESOURCE)GLO_SteelWatchers_OM_Karlach_COM_bab2d2bc-7f56-3408-a2ad-1e9699f291c6, _, _)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_OriginMoment_PreventRelaunchDialog((DIALOGRESOURCE)GLO_SteelWatchers_OM_Karlach_AOM_OOM_fadbf09f-e900-e797-0606-db5c8f3e54b6, _, _)
		THEN
		DB_NOOP(1);
		//END_REGION
		
		//REGION Gortash Confrontation - Tracking Netherstones
		IF
		FlagSet((FLAG)COL_KethericShowdown_State_HasNetherstone_0243527e-408f-4711-97a0-7759847bb00a, (CHARACTER)_Player, _)
		AND
		DB_Players(_Player)
		AND
		QRY_ORI_GortashConfrontation_AnyPlayerHasFlag((FLAG)LOW_BhaalTemple_State_HasNetherstone_818fd00e-6780-4712-980e-5c7c25ba9987)
		THEN
		SetFlag((FLAG)ORI_GortashConfrontation_State_PartyHasBothStones_c42f5ebb-d471-47aa-9a19-40aebe9e7b2a, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		FlagSet((FLAG)LOW_BhaalTemple_State_HasNetherstone_818fd00e-6780-4712-980e-5c7c25ba9987, (CHARACTER)_Player, _)
		AND
		DB_Players(_Player)
		AND
		QRY_ORI_GortashConfrontation_AnyPlayerHasFlag((FLAG)COL_KethericShowdown_State_HasNetherstone_0243527e-408f-4711-97a0-7759847bb00a)
		THEN
		SetFlag((FLAG)ORI_GortashConfrontation_State_PartyHasBothStones_c42f5ebb-d471-47aa-9a19-40aebe9e7b2a, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		FlagCleared((FLAG)LOW_BhaalTemple_State_HasNetherstone_818fd00e-6780-4712-980e-5c7c25ba9987, (CHARACTER)_Player, _)
		AND
		DB_Players(_Player)
		AND
		NOT QRY_ORI_GortashConfrontation_AnyPlayerHasFlag((FLAG)LOW_BhaalTemple_State_HasNetherstone_818fd00e-6780-4712-980e-5c7c25ba9987)
		THEN
		ClearFlag((FLAG)ORI_GortashConfrontation_State_PartyHasBothStones_c42f5ebb-d471-47aa-9a19-40aebe9e7b2a, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		FlagCleared((FLAG)COL_KethericShowdown_State_HasNetherstone_0243527e-408f-4711-97a0-7759847bb00a, (CHARACTER)_Player, _)
		AND
		DB_Players(_Player)
		AND
		NOT QRY_ORI_GortashConfrontation_AnyPlayerHasFlag((FLAG)COL_KethericShowdown_State_HasNetherstone_0243527e-408f-4711-97a0-7759847bb00a)
		THEN
		ClearFlag((FLAG)ORI_GortashConfrontation_State_PartyHasBothStones_c42f5ebb-d471-47aa-9a19-40aebe9e7b2a, NULL_00000000-0000-0000-0000-000000000000);
		
		QRY
		QRY_ORI_GortashConfrontation_AnyPlayerHasFlag((FLAG)_Flag)
		AND
		DB_Players(_Player)
		AND
		GetFlag(_Flag, _Player, 1)
		THEN
		DB_NOOP(1);
		//END_REGION Gortash Confrontation - Tracking Netherstones
		
		//REGION Meeting Jaheira
		IF
		FlagSet((FLAG)_Flag, _, _)
		AND
		DB_ORI_Karlach_JaheiraHasMetFlags(_Flag, _GlobalFlag)
		AND
		_GlobalFlag != NULL_00000000-0000-0000-0000-000000000000
		THEN
		SetFlag(_GlobalFlag, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		FlagSet((FLAG)_Flag, _, _)
		AND
		DB_ORI_Karlach_JaheiraHasMetFlags(_Flag, _)
		THEN
		PROC_ORI_Karlach_UnlockHasMetJaheiraBranch();
		
		PROC
		PROC_ORI_Karlach_UnlockHasMetJaheiraBranch()
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c) // To avoid her recruitment dialog to be replaced during her recruitment.
		AND
		QRY_OnlyOnce("ORI_Karlach_HasMetJaheira")
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_MetJaheira_ab0c8400-202d-49a3-aa0a-81b201f4f066, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 0);
		
		//END_REGION Meeting Jaheira
		
		
		//REGION Wyll transforming into a devil
		IF
		TagSet(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, (TAG)WYLL_DEVIL_5e844f0e-d822-4210-a28e-6af149a7bd4b)
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c) // To avoid her recruitment dialog to be replaced during her recruitment.
		AND
		NOT DB_GlobalFlag((FLAG)DBG_Act3_Setup_Good_eecb2a28-fbbb-4e51-856b-8f6a0b1edfbe)
		AND
		QRY_OnlyOnce("ORI_Karlach_ReactsToWyllTransformation")
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_WyllTransformation_26799c64-03fb-5581-059c-fe04d2987050, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 0);
		
		// If players go through the CRD don't trigger IPRD and cancel if needed
		PROC
		PROC_DialogStarted((DIALOGRESOURCE)CAMP_MizorasJudgement_CRD_Karlach_66ec5e1a-22ce-1538-d84f-1048c92df582, _)
		THEN
		DB_OnlyOnce("ORI_Karlach_ReactsToWyllTransformation");
		PROC_CancelRelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_WyllTransformation_26799c64-03fb-5581-059c-fe04d2987050);
		//END_REGION Wyll transforming into a devil
		
		//REGION Signing contract with Raphael
		IF
		FlagSet((FLAG)GLO_Monitor_State_MadeDeal_86f40f63-0bfa-4ab6-b3b0-d01475c3cbdc, _, _DialogID)
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c) // To avoid her recruitment dialog to be replaced during her recruitment.
		AND
		NOT DB_DialogPlayers(_DialogID, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 1) // Make sure she isn't the one signing the contract.
		AND
		NOT DB_GlobalFlag((FLAG)END_General_State_Started_a0fd5f91-e4b3-4d01-84d3-9ff484139e99)
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_SignedContractWithRaphael_b0bca668-7f2d-4ce7-acb6-b5ff96880388, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 0);
		//END_REGION
		
		//REGION Romance with Mizora
		IF
		FlagSet((FLAG)ORI_Karlach_State_SleptWithMizora_e0c36221-366c-d689-58b9-de92dc651cbe, _Avatar, _)
		THEN
		DB_ORI_Karlach_ConfrontAvatarAboutMizora((CHARACTER)_Avatar);
		
		// Check if the player who slept with mizora is Karlach's partner when leaving camp, if so start IPRD.
		PROC
		PROC_GLO_PartyMembers_AddHook((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _Avatar)
		AND
		NOT DB_OnlyOnce("ORI_Karlach_ConfrontPlayerAboutMizoraRomance")
		AND
		DB_ORI_Karlach_ConfrontAvatarAboutMizora(_Avatar)
		THEN
		PROC_ORI_Karlach_TryConfrontPlayerAboutMizoraRomance(_Avatar);
		
		PROC
		PROC_Camp_Leave((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		DB_Players((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		NOT DB_OnlyOnce("ORI_Karlach_ConfrontPlayerAboutMizoraRomance")
		AND
		DB_ORI_Karlach_ConfrontAvatarAboutMizora(_Avatar)
		THEN
		PROC_ORI_Karlach_TryConfrontPlayerAboutMizoraRomance(_Avatar);
		
		PROC
		PROC_ORI_Karlach_TryConfrontPlayerAboutMizoraRomance((CHARACTER)_Avatar)
		AND
		DB_ORI_Partnered(_Avatar, (CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		QRY_OnlyOnce("ORI_Karlach_ConfrontPlayerAboutMizoraRomance")
		THEN
		NOT DB_ORI_Karlach_ConfrontAvatarAboutMizora(_Avatar);
		DB_RelationshipDialog_AutostartTryOnce((DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_MizoraPartnerFollowup_de1c1b7e-3eb4-11dc-6217-bf8e236d1166);
		DB_ExclamationDialog_NeverStop((DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_MizoraPartnerFollowup_de1c1b7e-3eb4-11dc-6217-bf8e236d1166);
		PROC_RelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_MizoraPartnerFollowup_de1c1b7e-3eb4-11dc-6217-bf8e236d1166, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 1);
		//END_REGION
		
		//REGION Gortash corpse
		// If Karlach arrives to the astral plane cancel IPRD.
		IF
		DB_CurrentLevel("END_Main")
		THEN
		PROC_CancelRelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_GortashPermadefeated_1045fee7-ff39-dc6a-8619-a9bcf1b1adfe);
		TimerCancel("ORI_Karlach_TryTriggerGortashPermadefeatedIPRD");
		
		// Gortash can survive Act 3 and make it to END where he dies, so we need his looting logic in a GLO goal.
		IF
		DB_PermaDefeated(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c) // Case for Karlach being in prison if Gortash is killed
		AND
		NOT DB_CantTalk(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		NOT DB_ORI_Karlach_TriggeredGortashPermadefeatedIPRD(1)
		AND
		NOT DB_ORI_Karlach_BlockedGortashPermadefeatedIPRD(1)
		AND
		NOT DB_CurrentLevel("END_Main")
		THEN
		TimerLaunch("ORI_Karlach_TryTriggerGortashPermadefeatedIPRD", 1500);
		
		IF
		FlagSet(GLO_Gortash_State_PermaDefeated_74dd56ff-7e00-42a6-a0f3-0d122f364769, _, _)
		AND
		NOT DB_Players((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c) // Case for Karlach not being in the party when he is permadefeated.
		THEN
		SetFlag((FLAG)ORI_Karlach_Event_GortashPermadefeated_WasNotInParty_a2901fa7-f325-6d7b-19d1-82bd86eee69c, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		TimerFinished("ORI_Karlach_TryTriggerGortashPermadefeatedIPRD")
		AND
		NOT DB_CantTalk(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		DB_ORI_Karlach_TriggeredGortashPermadefeatedIPRD(1);
		PROC_RelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_GortashPermadefeated_1045fee7-ff39-dc6a-8619-a9bcf1b1adfe, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 0);
		
		PROC
		PROC_DialogStarted((DIALOGRESOURCE)WYR_GortashConfrontation_SoulConsumption_d1543a3d-c943-003c-3e9e-c3b93e0758f2, _)
		THEN
		DB_ORI_Karlach_BlockedGortashPermadefeatedIPRD(1);
		PROC_CancelRelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_GortashPermadefeated_1045fee7-ff39-dc6a-8619-a9bcf1b1adfe);
		
		PROC
		PROC_BlockLootCorpse(_Looter, (CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		AND
		NOT DB_CurrentLevel("END_Main")
		THEN
		PROC_ORI_Karlach_TryStartGortashCorpseDialog(_Looter);
		
		PROC
		PROC_ORI_Karlach_TryStartGortashCorpseDialog((CHARACTER)_Looter)
		AND
		NOT DB_OnlyOnce("ORI_Karlach_BlockGortashCorpseDialog")
		THEN
		DB_WYR_GortashConfrontation_LootingGortashCorpse(_Looter);
		
		PROC
		PROC_ORI_Karlach_TryStartGortashCorpseDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		NOT DB_OnlyOnce("ORI_Karlach_BlockGortashCorpseDialog")
		AND
		QRY_ORI_GortashConfrontation_SelectKarlachInteractingDialog()
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_ORI_Karlach_TryStartGortashCorpseDialog((CHARACTER)_Player)
		AND
		NOT DB_Avatars(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		NOT DB_OnlyOnce("ORI_Karlach_BlockGortashCorpseDialog")
		AND
		QRY_ORI_GortashConfrontation_SelectNotKarlachInteractingDialog(_Player)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_ORI_Karlach_TryStartGortashCorpseDialog((CHARACTER)_)
		AND
		DB_WYR_GortashConfrontation_LootingGortashCorpse(_Looter)
		THEN
		NOT DB_WYR_GortashConfrontation_LootingGortashCorpse(_Looter);
		
		IF
		DialogStarted(WYR_GortashConfrontation_SoulConsumption_d1543a3d-c943-003c-3e9e-c3b93e0758f2, _)
		THEN
		DB_OnlyOnce("ORI_Karlach_BlockGortashCorpseDialog");
		SetFlag((FLAG)ORI_Karlach_Knows_GortashGrudge_65838018-f5f0-4ecf-acd7-0b6ca245a9a2, NULL_00000000-0000-0000-0000-000000000000);
		
		// Check for available avatars
		QRY
		QRY_ORI_GortashConfrontation_SelectKarlachInteractingDialog()
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		QRY_GetBestAvatarForCompanion((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		DB_QRYRTN_GetBestAvatarForCompanion((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _Avatar)
		AND
		QRY_SpeakerIsInDialogRange(_Avatar, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		QRY_StartDialog_Fixed(WYR_GortashConfrontation_SoulConsumption_d1543a3d-c943-003c-3e9e-c3b93e0758f2, S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _Avatar)
		AND
		QRY_WYR_GortashConfrontation_DialogSpeakerIsLooter(_Avatar)
		AND
		DB_WYR_GortashConfrontation_LootingGortashCorpse(_Looter)
		THEN
		DB_CustomLootCorpseResponse(_Looter, S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, 0);
		
		QRY
		QRY_WYR_GortashConfrontation_DialogSpeakerIsLooter((CHARACTER)_Avatar)
		AND
		DB_WYR_GortashConfrontation_LootingGortashCorpse(_Avatar)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_WYR_GortashConfrontation_DialogSpeakerIsLooter((CHARACTER)_)
		AND
		DB_WYR_GortashConfrontation_LootingGortashCorpse((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		DB_NOOP(1);
		
		// Trigger for Karlach only
		QRY
		QRY_ORI_GortashConfrontation_SelectKarlachInteractingDialog()
		AND
		QRY_StartDialog_Fixed(WYR_GortashConfrontation_SoulConsumption_d1543a3d-c943-003c-3e9e-c3b93e0758f2, S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		DB_WYR_GortashConfrontation_LootingGortashCorpse((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		DB_CustomLootCorpseResponse((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, 0);
		
		QRY
		QRY_ORI_GortashConfrontation_SelectNotKarlachInteractingDialog((CHARACTER)_Player)
		AND
		DB_Players(_Player)
		AND
		_Player != S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c
		AND
		DB_Players((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		AND
		QRY_StartDialog_Fixed(WYR_GortashConfrontation_SoulConsumption_d1543a3d-c943-003c-3e9e-c3b93e0758f2, S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _Player)
		AND
		QRY_WYR_GortashConfrontation_DialogSpeakerIsLooter(_Player)
		AND
		DB_WYR_GortashConfrontation_LootingGortashCorpse(_Looter)
		THEN
		DB_CustomLootCorpseResponse(_Looter, S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, 0);
		
		PROC
		PROC_StateSet_PermaDefeated(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		AND
		DB_InCamp((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		SetFlag(ORI_Karlach_State_GortashDefeatedWhileInCamp_a911b164-a03d-fe58-4ef5-e47b0951c102, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		DB_InCamp((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		DB_GlobalFlag((FLAG)WYR_GortashConfrontation_Event_SendKarlachToCamp_7a52ef44-835d-4af9-0388-cdd1036a09ed)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Karlach_Event_ClearAfterGortashDefeatCRDAndIPRD_bbc8076f-bdd6-f53a-d9c3-3cfd87df1baf)
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_AfterDefeatingGortash_585a4ee6-b04f-2559-2bc5-ae99a1f57ff2, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 0);
		
		IF
		FlagSet(ORI_Karlach_Event_ClearAfterGortashDefeatCRDAndIPRD_bbc8076f-bdd6-f53a-d9c3-3cfd87df1baf, _, _)
		THEN
		PROC_CancelRelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_AfterDefeatingGortash_585a4ee6-b04f-2559-2bc5-ae99a1f57ff2);
		
		PROC
		PROC_CAMP_LeftCamp((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		PROC_CampNight_ClearCampNight((FLAG)NIGHT_Karlach_AfterDefeatingGortash_b8e239e4-e73e-433e-9550-e4a56bdbffd1);
		PROC_CancelRelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_AfterDefeatingGortash_585a4ee6-b04f-2559-2bc5-ae99a1f57ff2);
		
		// Topical Greeting
		IF
		DialogEnded((DIALOGRESOURCE)WYR_GortashConfrontation_SoulConsumption_d1543a3d-c943-003c-3e9e-c3b93e0758f2, _)
		AND
		NOT DB_DialogRequestFailed((DIALOGRESOURCE)WYR_GortashConfrontation_SoulConsumption_d1543a3d-c943-003c-3e9e-c3b93e0758f2, _)
		AND
		DB_Avatars((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		PROC_TopicalGreeting_UnlockTopic((FLAG)TG_ORI_Karlach_AfterGortashDeathAvatar_802e3436-0184-463c-8580-e8c8c9a15bef);
		
		IF
		DialogEnded((DIALOGRESOURCE)WYR_GortashConfrontation_SoulConsumption_d1543a3d-c943-003c-3e9e-c3b93e0758f2, _)
		AND
		NOT DB_DialogRequestFailed((DIALOGRESOURCE)WYR_GortashConfrontation_SoulConsumption_d1543a3d-c943-003c-3e9e-c3b93e0758f2, _)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		PROC_TopicalGreeting_UnlockTopic((FLAG)TG_ORI_Karlach_AfterGortashDeathCompanion_cc1791d7-69a0-44aa-8bc0-40f15a129172);
		
		PROC
		PROC_LevelUnloading("BGO_Main_A") // Players leave WYR, end TG
		AND
		DB_TopicalGreeting_Current((FLAG)TG_ORI_Karlach_AfterGortashDeathAvatar_802e3436-0184-463c-8580-e8c8c9a15bef) // To avoid removing other TGs.
		THEN
		PROC_TopicalGreeting_ClearOldTopic();
		
		PROC
		PROC_LevelUnloading("BGO_Main_A") // Players leave WYR, end TG
		AND
		DB_TopicalGreeting_Current((FLAG)TG_ORI_Karlach_AfterGortashDeathCompanion_cc1791d7-69a0-44aa-8bc0-40f15a129172) // To avoid removing other TGs.
		THEN
		PROC_TopicalGreeting_ClearOldTopic();
		//END_REGION Gortash corpse
		
		//REGION Other IPRDs
		// Jaheira leaves after attacking any of her allies
		IF
		FlagSet((FLAG)GLO_Jaheira_State_LeftInAnger_16778577-593d-4bdf-b0bb-aaa7fb927a87, _, _)
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_JaheiraLeftAngry_eb11a6b1-2388-4f9a-8812-0205bd485875, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 0);
		
		// Emperor is revealed
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)INT_EmperorRevealed_Event_SceneComplete_2fa4811a-8757-40e7-a0bb-dc7e210dd6e6)
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_EmperorRevealed_06420aa1-cfa8-6f06-7bee-53cc6f1ab958, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 0);
		
		IF
		FlagSet((FLAG)VISITEDREGION_BGO_Main_A_40f06537-814f-4796-b012-5ffaa648a8d9, _, _)
		THEN
		PROC_CancelRelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_EmperorRevealed_06420aa1-cfa8-6f06-7bee-53cc6f1ab958);
		//END_REGION Other IPRDs
		
		//REGION Karlach date at Singing Lute
		IF
		FlagSet(ORI_Karlach_State_WentToDate_b30f31df-474f-15f3-9bfb-1fc2983c846a, _Player, _)
		AND
		DB_Players((CHARACTER)_Player)
		THEN
		SetFlag(ORI_Karlach_State_SingingLuteDate_0e4020d6-f2de-4a4d-8e4d-bb38260ca6e4);
		
		//END_REGION Karlach date at Singing Lute
		
		
		//REGION KARLACH - JOURNAL
		// Avatar Karlach journal
		PROC
		PROC_ORI_Karlach_UpdateJournal((STRING)_QuestStep)
		AND
		DB_Avatars((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		QuestUpdate((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_Avatar_Karlach", _QuestStep);
		
		// Companion Karlach journal
		PROC
		PROC_ORI_Karlach_UpdateJournal((STRING)_QuestStep)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		QuestUpdate("ORI_COM_Karlach", _QuestStep);
		
		//REGION GLOBAL JOURNAL UPDATES
		// Always try to start Karlach's quest if she is an avatar for debugging reasons.
		PROC
		PROC_LevelLoadedOnce(_)
		AND
		DB_Avatars((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		NOT DB_QuestIsAccepted("ORI_Avatar_Karlach")
		THEN
		PROC_ORI_Karlach_UpdateJournal("EscapeAvernus");
		
		PROC
		PROC_LevelLoadedOnce("WLD_Main_A")
		AND
		DB_Avatars((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		PROC_ORI_Karlach_UpdateJournal("AvernusEscaped");
		
		//Recruitment
		// If was not able to recruit her because the party is full: don't update
		IF
		FlagSet((FLAG)ORI_Karlach_Quest_AgreedToHelpNotRecruited_f08dc12e-cb2e-e373-e2eb-b0d2c7b0d7dc, _, _)
		AND
		NOT DB_GlobalFlag((FLAG)PLA_KarlachRecruitmentTollhouse_State_PaladinsPermaDefeated_d78dbc95-8d8e-4b3a-b618-ccfb48c31375)
		THEN
		PROC_ORI_Karlach_UpdateJournal("NotRecruited_PaladinsNotDefeated");
		
		PROC
		PROC_CheckFirstTimeRecruited((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		NOT DB_GlobalFlag((FLAG)PLA_KarlachRecruitmentTollhouse_State_PaladinsPermaDefeated_d78dbc95-8d8e-4b3a-b618-ccfb48c31375)
		AND
		QRY_OnlyOnce("ORI_Karlach_RecruitedUpdate")
		THEN
		PROC_ORI_Karlach_UpdateJournal("Recruited_PaladinsNotDefeated");
		SetFlag((FLAG)ORI_Karlach_State_Recruited_ed56dd05-9a92-4729-88bc-f4e6c6fb5be8);
		
		IF
		FlagSet((FLAG)ORI_Karlach_State_PromisedToDealWithPaladins_41e9f88c-0f3e-427a-911f-5df379642fe4, _, _)
		THEN
		PROC_ORI_Karlach_UpdateJournal("PaladinsReminder");
		
		IF
		FlagSet((FLAG)PLA_KarlachRecruitmentTollhouse_State_PaladinsPermaDefeated_d78dbc95-8d8e-4b3a-b618-ccfb48c31375, _, _)
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		QRY_ORI_Karlach_HadAnyPaladinsEntries()
		THEN
		PROC_ORI_Karlach_UpdateJournal("ExploreSwordCoast");
		
		QRY
		QRY_ORI_Karlach_HadAnyPaladinsEntries()
		AND
		DB_QuestIsAccepted("PLA_PaladinsOfTyr")
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_ORI_Karlach_HadAnyPaladinsEntries()
		AND
		QRY_QuestUpdateIsUnlockedForAny("ORI_Avatar_Karlach", "DealWithPaladins")
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_CheckFirstTimeRecruited((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		DB_GlobalFlag((FLAG)PLA_KarlachRecruitmentTollhouse_State_PaladinsPermaDefeated_d78dbc95-8d8e-4b3a-b618-ccfb48c31375)
		AND
		QRY_OnlyOnce("ORI_Karlach_RecruitedUpdate")
		THEN
		PROC_ORI_Karlach_UpdateJournal("Recruited_PaladinsDefeated");
		SetFlag((FLAG)ORI_Karlach_State_Recruited_ed56dd05-9a92-4729-88bc-f4e6c6fb5be8);
		
		IF
		DialogEnded((DIALOGRESOURCE)COL_KethericShowdown_ChosenThree_94ef9fa6-729b-d34a-623a-74a8c3ba187f, _DialogID)
		AND
		NOT DB_DialogRequestFailed((DIALOGRESOURCE)COL_KethericShowdown_ChosenThree_94ef9fa6-729b-d34a-623a-74a8c3ba187f, _DialogID)
		AND
		DB_Players((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		PROC_ORI_Karlach_UpdateJournal("MetGortashInCOL_KarlachPresent");
		
		PROC
		PROC_COL_KethericShowdown_AfterDefeat()
		AND
		QRY_QuestUpdateIsUnlockedForAny("ORI_COM_Karlach", "MetGortashInCOL_KarlachPresent")
		THEN
		PROC_ORI_Karlach_UpdateJournal("KethericDefeated");
		
		IF
		FlagSet((FLAG)ORI_Karlach_Quest_HuntGortash_8092d608-7969-3862-5f9a-d8a9853307b5, _, _)
		THEN
		PROC_ORI_Karlach_UpdateJournal("LearntGortashStory");
		
		IF
		DB_Sees((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		AND
		NOT DB_ORI_Karlach_FoundGortash(1)
		THEN
		PROC_ORI_Karlach_UpdateJournal("ConfrontGortash");
		
		IF
		DB_Sees((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		AND
		NOT DB_ORI_Karlach_FoundGortash(1)
		THEN
		PROC_ORI_Karlach_UpdateJournal("KillGortash");
		
		IF
		QuestUpdateUnlocked(_, "ORI_Avatar_Karlach", "KillGortash")
		THEN
		DB_ORI_Karlach_FoundGortash(1);
		
		IF
		QuestUpdateUnlocked(_, "ORI_COM_Karlach", "ConfrontGortash")
		THEN
		DB_ORI_Karlach_FoundGortash(1);
		
		IF
		FlagSet((FLAG)ORI_GortashConfrontation_Event_KarlachSentToPrison_f6764bce-1df3-4f81-91d0-bf986329798e, _, _)
		THEN
		PROC_ORI_Karlach_UpdateJournal("RescueKarlach");
		
		IF
		DB_Is_InCombat(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, _CombatID)
		AND
		DB_Is_InCombat(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _CombatID)
		THEN
		PROC_ORI_Karlach_UpdateJournal("KillGortash_AtWYR");
		
		IF
		EnteredChasm(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, _Chasm, _, _, _, _)
		AND
		NOT QRY_GLO_Chasms_HasChasmImmunity(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, _Chasm)
		THEN
		DB_ORI_Karlach_GortashFellInChasm(1);
		
		IF
		Died((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		THEN
		TimerLaunch("ORI_Karlach_CheckGortashInChasm", 500);
		
		IF
		TimerFinished("ORI_Karlach_CheckGortashInChasm")
		AND
		QRY_ORI_Karlach_GortashCorpseAvailable()
		THEN
		PROC_ORI_Karlach_UpdateJournal("GoToGortashCorpse");
		
		IF
		TimerFinished("ORI_Karlach_CheckGortashInChasm")
		AND
		NOT QRY_ORI_Karlach_GortashCorpseAvailable()
		THEN
		PROC_ORI_Karlach_SaveTheCityJournalUpdate();
		
		IF
		DB_OffStage(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		AND
		DB_PermaDefeated(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		THEN
		PROC_ORI_Karlach_SaveTheCityJournalUpdate();
		
		QRY
		QRY_ORI_Karlach_GortashCorpseAvailable()
		AND
		NOT DB_ORI_Karlach_GortashFellInChasm(1)
		AND
		DB_Dead((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_DialogStarted((DIALOGRESOURCE)WYR_GortashConfrontation_SoulConsumption_d1543a3d-c943-003c-3e9e-c3b93e0758f2, _)
		THEN
		PROC_ORI_Karlach_SaveTheCityJournalUpdate();
		
		PROC
		PROC_ORI_Karlach_SaveTheCityJournalUpdate()
		AND
		QRY_ORI_Karlach_CanCompleteForgingOfTheHeart()
		THEN
		PROC_ORI_Karlach_UpdateJournal("SaveTheCity");
		
		PROC
		PROC_ORI_Karlach_SaveTheCityJournalUpdate()
		AND
		QRY_ORI_Karlach_CanCompleteForgingOfTheHeart()
		AND
		DB_GlobalFlag((FLAG)GLO_ForgingOfTheHeart_Knows_DammonCanUpgradeKarlach_226d82fb-711b-64ac-e59a-b4361ce2204e)
		THEN
		PROC_ORI_Karlach_UpdateJournal("GetUpgrades_DoesKnowDammon");
		
		PROC
		PROC_ORI_Karlach_SaveTheCityJournalUpdate()
		AND
		QRY_ORI_Karlach_CanCompleteForgingOfTheHeart()
		AND
		NOT DB_GlobalFlag((FLAG)GLO_ForgingOfTheHeart_Knows_DammonCanUpgradeKarlach_226d82fb-711b-64ac-e59a-b4361ce2204e)
		THEN
		PROC_ORI_Karlach_UpdateJournal("GetUpgrades_DoesKnowDammon");
		
		IF
		QuestClosed("ORI_Avatar_Karlach_SUB_ForgingOfTheHeart")
		AND
		DB_PermaDefeated(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		THEN
		PROC_ORI_Karlach_CloseMainQuest();
		
		IF
		QuestClosed("ORI_COM_Karlach_SUB_ForgingOfTheHeart")
		AND
		DB_PermaDefeated(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		THEN
		PROC_ORI_Karlach_CloseMainQuest();
		
		PROC
		PROC_ORI_Karlach_SaveTheCityJournalUpdate()
		AND
		NOT QRY_ORI_Karlach_CanCompleteForgingOfTheHeart()
		THEN
		PROC_ORI_Karlach_CloseMainQuest();
		
		QRY
		QRY_ORI_Karlach_CanCompleteForgingOfTheHeart()
		AND
		NOT DB_PermaDefeated(S_DEN_Weaponsmith_e2ad06ec-8034-479a-9f69-b86faea6dc79)
		AND
		NOT QRY_ORI_Karlach_ForgingOfTheHeartClosed()
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_ORI_Karlach_ForgingOfTheHeartClosed()
		AND
		NOT DB_QuestIsClosed("ORI_Avatar_Karlach_SUB_ForgingOfTheHeart")
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_ORI_Karlach_ForgingOfTheHeartClosed()
		AND
		NOT DB_QuestIsClosed("ORI_COM_Karlach_SUB_ForgingOfTheHeart")
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_LevelLoadedOnce("END_Main")
		THEN
		PROC_ORI_Karlach_CloseMainQuest();
		
		PROC
		PROC_ORI_GortashConfrontation_DecideKarlachsFate()
		THEN
		PROC_ORI_Karlach_CloseMainQuest();
		
		// First close forging of the heart
		PROC
		PROC_ORI_Karlach_CloseMainQuest()
		THEN
		PROC_ORI_Karlach_CloseForgingOfTheHeartQuest();
		
		// Then close main
		PROC
		PROC_ORI_Karlach_CloseMainQuest()
		AND
		DB_GlobalFlag((FLAG)ORI_GortashConfrontation_State_KarlachLeft_1fed69d1-c245-4c5f-9ed0-5cfed57d8ae9)
		THEN
		PROC_ORI_Karlach_UpdateJournal("KarlachNotRescued");
		
		PROC
		PROC_ORI_Karlach_CloseMainQuest()
		AND
		DB_GlobalFlag((FLAG)ORI_GortashConfrontation_State_KarlachWillLeave_cb4ac6a2-b553-5f2d-2bfe-680d5aa0ff94)
		THEN
		PROC_ORI_Karlach_UpdateJournal("KarlachNotRescued");
		
		PROC
		PROC_ORI_Karlach_CloseMainQuest()
		AND
		DB_SceneManager((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KarlachInPrison")
		THEN
		PROC_ORI_Karlach_UpdateJournal("KarlachNotRescued");
		
		PROC
		PROC_ORI_Karlach_CloseMainQuest()
		AND
		DB_PermaDefeated(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		AND
		DB_GlobalFlag((FLAG)GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade_f6dc0de4-1089-43c0-b392-306a9a44387c)
		THEN
		PROC_ORI_Karlach_UpdateJournal("ReachEND_FullyUpgraded_GortashDefeated");
		
		PROC
		PROC_ORI_Karlach_CloseMainQuest()
		AND
		NOT DB_PermaDefeated(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		AND
		DB_GlobalFlag((FLAG)GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade_f6dc0de4-1089-43c0-b392-306a9a44387c)
		THEN
		PROC_ORI_Karlach_UpdateJournal("ReachEND_FullyUpgraded_GortashNotDefeated");
		
		PROC
		PROC_ORI_Karlach_CloseMainQuest()
		AND
		DB_PermaDefeated(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade_f6dc0de4-1089-43c0-b392-306a9a44387c)
		THEN
		PROC_ORI_Karlach_UpdateJournal("ReachEND_NotFullyUpgraded_GortashDefeated");
		
		PROC
		PROC_ORI_Karlach_CloseMainQuest()
		AND
		NOT DB_PermaDefeated(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_ForgingOfTheHeart_State_KarlachSecondUpgrade_f6dc0de4-1089-43c0-b392-306a9a44387c)
		THEN
		PROC_ORI_Karlach_UpdateJournal("ReachEND_NotFullyUpgraded_GortashNotDefeated");
		
		IF
		DB_PermaDefeated(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		PROC_ORI_Karlach_UpdateJournal("KarlachPermanentlyDies");
		
		//END_REGION GLOBAL JOURNAL UPDATES
		
		//REGION FORGING OF THE HEART UPDATES
		// Forging of the heart will require some logic since it can be done almost everywhere in the game.
		PROC
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal((STRING)_QuestStep)
		AND
		NOT DB_ORI_Karlach_ForgingOfTheHeart_MultiActUpdates(_QuestStep)
		THEN
		PROC_ORI_Karlach_UpdateJournal(_QuestStep);
		
		PROC
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal((STRING)_QuestStep)
		AND
		DB_ORI_Karlach_ForgingOfTheHeart_MultiActUpdates(_QuestStep)
		AND
		DB_ActiveLevel(_Level)
		AND
		DB_ORI_Karlach_ForgingOfTheHeart_Suffixes(_Level, _Suffix)
		AND
		Concatenate(_QuestStep, _Suffix, _ActQuestUpdate)
		THEN
		PROC_ORI_Karlach_UpdateJournal(_ActQuestUpdate);
		
		QRY
		QRY_ORI_Karlach_HasForgingOfTheHeartUpdate((STRING)_Update)
		AND
		QRY_QuestUpdateIsUnlockedForAny("ORI_Avatar_Karlach", _Update)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_ORI_Karlach_HasForgingOfTheHeartUpdate((STRING)_Update)
		AND
		QRY_QuestUpdateIsUnlockedForAny("ORI_COM_Karlach", _Update)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_ORI_Karlach_HasCurrentActForgingOfTheHeartUpdate((STRING)_Update)
		AND
		DB_ORI_Karlach_ForgingOfTheHeart_MultiActUpdates(_Update)
		AND
		DB_ActiveLevel(_Level)
		AND
		DB_ORI_Karlach_ForgingOfTheHeart_Suffixes(_Level, _Suffix)
		AND
		Concatenate(_Update, _Suffix, _ActQuestUpdate)
		AND
		QRY_QuestUpdateIsUnlockedForAny("ORI_Avatar_Karlach", _ActQuestUpdate)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_ORI_Karlach_HasCurrentActForgingOfTheHeartUpdate((STRING)_Update)
		AND
		DB_ORI_Karlach_ForgingOfTheHeart_MultiActUpdates(_Update)
		AND
		DB_ActiveLevel(_Level)
		AND
		DB_ORI_Karlach_ForgingOfTheHeart_Suffixes(_Level, _Suffix)
		AND
		Concatenate(_Update, _Suffix, _ActQuestUpdate)
		AND
		QRY_QuestUpdateIsUnlockedForAny("ORI_COM_Karlach", _ActQuestUpdate)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_ORI_Karlach_HasForgingOfTheHeartJournalUnlocked()
		AND
		DB_QuestIsAccepted("ORI_COM_Karlach_SUB_ForgingOfTheHeart")
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_ORI_Karlach_HasForgingOfTheHeartJournalUnlocked()
		AND
		DB_QuestIsAccepted("ORI_Avatar_Karlach_SUB_ForgingOfTheHeart")
		THEN
		DB_NOOP(1);
		
		//Flags setup
		PROC
		PROC_DialogFlagSetup(_Dialog, _, _)
		AND
		DB_ORI_Karlach_ForgingOfTheHeart_Dialogues(_Dialog)
		THEN
		PROC_ORI_Karlach_PrepareInfernalMetalMarkers();
		
		PROC
		PROC_DialogFlagSetup(_Dialog, _, _, _)
		AND
		DB_ORI_Karlach_ForgingOfTheHeart_Dialogues(_Dialog)
		THEN
		PROC_ORI_Karlach_PrepareInfernalMetalMarkers();
		
		PROC
		PROC_ORI_Karlach_PrepareInfernalMetalMarkers()
		THEN
		ClearFlag((FLAG)GLO_ForgingOfTheHeart_State_InfernalMetalAvailable_a1e06b76-42d9-4fe8-8b5a-cbc7135f3124, NULL_00000000-0000-0000-0000-000000000000);
		
		PROC
		PROC_ORI_Karlach_PrepareInfernalMetalMarkers()
		AND
		DB_ActiveLevel(_Level)
		AND
		DB_ORI_Karlach_ForgingOfTheHeart_InfernalIrons(_Level, _InfernalMetal)
		AND
		IsDestroyed(_InfernalMetal, 0)
		AND
		NOT DB_OffStage(_InfernalMetal)
		THEN
		SetFlag((FLAG)GLO_ForgingOfTheHeart_State_InfernalMetalAvailable_a1e06b76-42d9-4fe8-8b5a-cbc7135f3124, NULL_00000000-0000-0000-0000-000000000000);
		
		//JOURNAL UPDATES
		IF
		FlagSet((FLAG)ORI_Karlach_State_ToldKarlachAboutDammon_f2afec2f-95fb-a1c9-2976-9fb798144226, _, _)
		AND
		NOT DB_GlobalFlag((FLAG)PLA_KarlachRecruitment_State_DammonUnavailable_96af4ae3-496d-497f-afb5-fec042fe6f27)
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("KnowsDammon");
		
		// Main journal entry: does know about Dammon, paladins have been defeated
		IF
		FlagSet((FLAG)ORI_Karlach_State_ToldKarlachAboutDammon_f2afec2f-95fb-a1c9-2976-9fb798144226, _, _)
		AND
		NOT DB_GlobalFlag((FLAG)PLA_KarlachRecruitment_State_DammonUnavailable_96af4ae3-496d-497f-afb5-fec042fe6f27)
		AND
		DB_GlobalFlag((FLAG)PLA_KarlachRecruitmentTollhouse_State_PaladinsPermaDefeated_d78dbc95-8d8e-4b3a-b618-ccfb48c31375)
		AND
		QRY_OnlyOnce("ORI_Karlach_Journal_ForgingOfTheHeartUpdated")
		THEN
		PROC_ORI_Karlach_UpdateJournal("ForgingOfTheHeart_KnowsDammon");
		
		// Main journal entry: does know about Dammon, paladins have not been defeated
		IF
		FlagSet((FLAG)ORI_Karlach_State_ToldKarlachAboutDammon_f2afec2f-95fb-a1c9-2976-9fb798144226, _, _)
		AND
		NOT DB_GlobalFlag((FLAG)PLA_KarlachRecruitment_State_DammonUnavailable_96af4ae3-496d-497f-afb5-fec042fe6f27)
		AND
		NOT DB_GlobalFlag((FLAG)PLA_KarlachRecruitmentTollhouse_State_PaladinsPermaDefeated_d78dbc95-8d8e-4b3a-b618-ccfb48c31375)
		AND
		QRY_OnlyOnce("ORI_Karlach_Journal_ForgingOfTheHeartUpdated")
		THEN
		PROC_ORI_Karlach_UpdateJournal("ForgingOfTheHeart_KnowsDammon_BeforePaladins");
		
		IF
		FlagSet((FLAG)ORI_Karlach_State_InSearchOfMechanic_9943b467-dff2-4a15-abbc-e380e0b8f794, _, _)
		AND
		NOT DB_GlobalFlag((FLAG)PLA_KarlachRecruitment_State_DammonUnavailable_96af4ae3-496d-497f-afb5-fec042fe6f27)
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("RecruitedKarlach_KnowsCanBeUpgraded");
		
		// Main journal entry: does not know about Dammon, paladins have been defeated
		IF
		FlagSet((FLAG)ORI_Karlach_State_InSearchOfMechanic_9943b467-dff2-4a15-abbc-e380e0b8f794, _, _)
		AND
		NOT DB_GlobalFlag((FLAG)PLA_KarlachRecruitment_State_DammonUnavailable_96af4ae3-496d-497f-afb5-fec042fe6f27)
		AND
		DB_GlobalFlag((FLAG)PLA_KarlachRecruitmentTollhouse_State_PaladinsPermaDefeated_d78dbc95-8d8e-4b3a-b618-ccfb48c31375)
		AND
		QRY_OnlyOnce("ORI_Karlach_Journal_ForgingOfTheHeartUpdated")
		THEN
		PROC_ORI_Karlach_UpdateJournal("ForgingOfTheHeart_DoesNotKnowDammon");
		
		// Main journal entry: does not know about Dammon, paladins have not been defeated
		IF
		FlagSet((FLAG)ORI_Karlach_State_InSearchOfMechanic_9943b467-dff2-4a15-abbc-e380e0b8f794, _, _)
		AND
		NOT DB_GlobalFlag((FLAG)PLA_KarlachRecruitment_State_DammonUnavailable_96af4ae3-496d-497f-afb5-fec042fe6f27)
		AND
		NOT DB_GlobalFlag((FLAG)PLA_KarlachRecruitmentTollhouse_State_PaladinsPermaDefeated_d78dbc95-8d8e-4b3a-b618-ccfb48c31375)
		AND
		QRY_OnlyOnce("ORI_Karlach_Journal_ForgingOfTheHeartUpdated")
		THEN
		PROC_ORI_Karlach_UpdateJournal("ForgingOfTheHeart_DoesNotKnowDammon_BeforePaladins");
		
		IF
		FlagSet((FLAG)GLO_ForgingOfTheHeart_Knows_DammonCanUpgradeKarlach_226d82fb-711b-64ac-e59a-b4361ce2204e, _, _)
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("FindInfernalMetal_FirstUpgrade");
		DB_QuestDef_SawPermaDefeatedState("ORI_Avatar_Karlach", "DammonPermadefeated", (CHARACTER)S_DEN_Weaponsmith_e2ad06ec-8034-479a-9f69-b86faea6dc79);
		DB_QuestDef_SawPermaDefeatedState("ORI_COM_Karlach", "DammonPermadefeated", (CHARACTER)S_DEN_Weaponsmith_e2ad06ec-8034-479a-9f69-b86faea6dc79);
		
		IF
		FlagSet((FLAG)GLO_ForgingOfTheHeart_Event_RememberAboutFirstUpgrade_3b130e78-b545-9251-476b-b338a0568948, _Player, _)
		AND
		TaggedItemsGetCountInMagicPockets("INFERNAL_METAL_596255e4-37a3-4d06-b09d-2905874f892f",_Player,0)
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("FindInfernalMetal_FirstUpgrade");
		
		IF
		FlagSet((FLAG)GLO_ForgingOfTheHeart_Event_RememberAboutFirstUpgrade_3b130e78-b545-9251-476b-b338a0568948, _Player, _)
		AND
		DB_GlobalFlag((FLAG)PLA_KarlachRecruitmentTollhouse_State_PaladinsPermaDefeated_d78dbc95-8d8e-4b3a-b618-ccfb48c31375)
		AND
		QRY_OnlyOnce("ORI_Karlach_Journal_ForgingOfTheHeartUpdated")
		THEN
		PROC_ORI_Karlach_UpdateJournal("ForgingOfTheHeart_KnowsDammon"); // Main journal entry
		
		IF
		FlagSet((FLAG)GLO_ForgingOfTheHeart_Event_RememberAboutFirstUpgrade_3b130e78-b545-9251-476b-b338a0568948, _Player, _)
		AND
		NOT DB_GlobalFlag((FLAG)PLA_KarlachRecruitmentTollhouse_State_PaladinsPermaDefeated_d78dbc95-8d8e-4b3a-b618-ccfb48c31375)
		AND
		QRY_OnlyOnce("ORI_Karlach_Journal_ForgingOfTheHeartUpdated")
		THEN
		PROC_ORI_Karlach_UpdateJournal("ForgingOfTheHeart_KnowsDammon_BeforePaladins"); // Main journal entry
		
		IF
		FlagSet((FLAG)GLO_ForgingOfTheHeart_Event_RememberAboutFirstUpgrade_3b130e78-b545-9251-476b-b338a0568948, _Player, _)
		THEN
		ClearFlag((FLAG)GLO_ForgingOfTheHeart_Event_RememberAboutFirstUpgrade_3b130e78-b545-9251-476b-b338a0568948, _Player);
		
		IF
		FlagSet((FLAG)GLO_ForgingOfTheHeart_Event_RememberAboutSecondUpgrade_1547eb4c-0cde-8984-e691-a0f14a864b42, _Player, _)
		AND
		TaggedItemsGetCountInMagicPockets("INFERNAL_METAL_596255e4-37a3-4d06-b09d-2905874f892f",_Player,0)
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("FindInfernalMetal_SecondUpgrade");
		
		IF
		FlagSet((FLAG)GLO_ForgingOfTheHeart_Event_RememberAboutSecondUpgrade_1547eb4c-0cde-8984-e691-a0f14a864b42, _Player, _)
		THEN
		ClearFlag((FLAG)GLO_ForgingOfTheHeart_Event_RememberAboutSecondUpgrade_1547eb4c-0cde-8984-e691-a0f14a864b42, _Player);
		
		IF
		FlagSet((FLAG)GLO_ForgingOfTheHeart_Quest_WaitForNextAct_29c86e0b-100f-5a32-31d6-6bd4e287af71, _Player, _)
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("WaitForNextAct");
		
		PROC
		PROC_DEN_TieflingRefugees_Leave()
		AND
		QRY_ORI_Karlach_ToldOrKnowsAboutDammon()
		AND
		NOT QRY_ORI_Karlach_HasCurrentActForgingOfTheHeartUpdate("FindDammon_Act2")
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("TieflingsLeft");
		
		IF
		FlagSet((FLAG)ORI_Karlach_State_ToldKarlachAboutDammon_f2afec2f-95fb-a1c9-2976-9fb798144226, _, _)
		AND
		DB_GlobalFlag((FLAG)DEN_TieflingRefugees_State_LeftDen_003b304b-f058-4f8a-b9fa-a097e1b6b395)
		AND
		NOT QRY_ORI_Karlach_HasCurrentActForgingOfTheHeartUpdate("FindDammon_Act2")
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("TieflingsLeft");
		
		QRY
		QRY_ORI_Karlach_ToldOrKnowsAboutDammon()
		AND
		DB_GlobalFlag((FLAG)GLO_ForgingOfTheHeart_Knows_DammonCanUpgradeKarlach_226d82fb-711b-64ac-e59a-b4361ce2204e)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_ORI_Karlach_ToldOrKnowsAboutDammon()
		AND
		DB_GlobalFlag((FLAG)ORI_Karlach_State_ToldKarlachAboutDammon_f2afec2f-95fb-a1c9-2976-9fb798144226)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_LevelLoadedOnce("SCL_Main_A")
		AND
		DB_GlobalFlag((FLAG)GLO_ForgingOfTheHeart_Knows_DammonCanUpgradeKarlach_226d82fb-711b-64ac-e59a-b4361ce2204e)
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("FindDammon_Act2");
		
		IF
		FlagSet((FLAG)Act2_PointOfNoReturnReached_a3155f30-b8f3-4db5-ac21-d3036f4426e3, _, _)
		AND
		DB_GlobalFlag((FLAG)GLO_ForgingOfTheHeart_Knows_DammonCanUpgradeKarlach_226d82fb-711b-64ac-e59a-b4361ce2204e)
		AND
		DB_ORI_Karlach_ForgingOfTheHeart_HasSeenDammonInLevel("SCL_Main_A")
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("FindDammon_Act3");
		
		//Edge-case: moving to INT and Dammon dead will close the quest
		PROC
		PROC_LevelLoadedOnce("INT_Main_A") // Mostly for debug reasons
		AND
		DB_GlobalFlag((FLAG)PLA_KarlachRecruitment_State_DammonUnavailable_96af4ae3-496d-497f-afb5-fec042fe6f27)
		THEN
		PROC_ORI_Karlach_CloseForgingOfTheHeartQuest();
		
		PROC
		PROC_LevelLoadedOnce("INT_Main_A") // Mostly for debug reasons
		AND
		DB_GlobalFlag((FLAG)GLO_ForgingOfTheHeart_Knows_DammonCanUpgradeKarlach_226d82fb-711b-64ac-e59a-b4361ce2204e)
		AND
		DB_ORI_Karlach_ForgingOfTheHeart_HasSeenDammonInLevel("SCL_Main_A")
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("FindDammon_Act3");
		
		PROC
		PROC_LevelLoadedOnce("BGO_Main_A") // Mostly for debug reasons
		AND
		DB_GlobalFlag((FLAG)GLO_ForgingOfTheHeart_Knows_DammonCanUpgradeKarlach_226d82fb-711b-64ac-e59a-b4361ce2204e)
		AND
		DB_ORI_Karlach_ForgingOfTheHeart_HasSeenDammonInLevel("SCL_Main_A")
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("FindDammon_Act3");
		
		PROC
		PROC_LevelLoadedOnce("CTY_Main_A") // Mostly for debug reasons
		AND
		DB_GlobalFlag((FLAG)GLO_ForgingOfTheHeart_Knows_DammonCanUpgradeKarlach_226d82fb-711b-64ac-e59a-b4361ce2204e)
		AND
		DB_ORI_Karlach_ForgingOfTheHeart_HasSeenDammonInLevel("SCL_Main_A")
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("FindDammon_Act3");
		
		IF
		Saw(_Player, (CHARACTER)S_DEN_Weaponsmith_e2ad06ec-8034-479a-9f69-b86faea6dc79, _)
		AND
		DB_Players(_Player)
		AND
		DB_ActiveLevel(_Level)
		AND
		NOT DB_ORI_Karlach_ForgingOfTheHeart_HasSeenDammonInLevel(_Level)
		AND
		QRY_ORI_Karlach_HasForgingOfTheHeartJournalUnlocked()
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("DammonFound");
		
		PROC
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("DammonFound")
		AND
		NOT DB_ActiveLevel("WLD_Main_A")
		AND
		NOT DB_GlobalFlag((FLAG)PLA_KarlachRecruitment_State_DammonUnavailable_96af4ae3-496d-497f-afb5-fec042fe6f27)
		AND
		DB_GlobalFlag((FLAG)GLO_ForgingOfTheHeart_Knows_DammonCanUpgradeKarlach_226d82fb-711b-64ac-e59a-b4361ce2204e)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)GLO_ForgingOfTheHeart_PAD_KarlachSpotsDammon_ea0d6327-1e9b-184a-4f8c-333e25c24029, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		
		IF
		Saw(_Player, (CHARACTER)S_DEN_Weaponsmith_e2ad06ec-8034-479a-9f69-b86faea6dc79, _)
		AND
		DB_Players(_Player)
		AND
		DB_ActiveLevel(_Level)
		THEN
		DB_ORI_Karlach_ForgingOfTheHeart_HasSeenDammonInLevel(_Level);
		
		IF
		FlagSet((FLAG)HAV_ForgingOfTheHeart_State_UnlockUpgradeNextDay_40dd7a6c-89a8-b301-a935-915059472061, _, _)
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("WaitForNextDay");
		
		// Go talk to dammon
		IF
		FlagSet((FLAG)HAV_ForgingOfTheHeart_State_ReadyForSecondUpgrade_edce0ffd-21d1-7a6c-2b55-a3e749d06fca, _, _)
		AND
		DB_ActiveLevel(_Level)
		AND
		DB_ORI_Karlach_ForgingOfTheHeart_HasSeenDammonInLevel(_Level)
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("TalkToDammon");
		
		// Get upgrades: first one
		// Getting the infernal plate
		IF
		TemplateAddedTo((ITEMROOT)_InfernalMetalTemplate, _, (CHARACTER)_Player, _)
		AND
		DB_ORI_Karlach_InfernalMetalTemplates(_InfernalMetalTemplate)
		AND
		DB_ActiveLevel(_Level)
		AND
		DB_ORI_Karlach_ForgingOfTheHeart_HasSeenDammonInLevel(_Level)
		AND
		DB_Players(_Player)
		AND
		HasActiveStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_FIRSTUPGRADE", 0)
		AND
		HasActiveStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_SECONDUPGRADE", 0)
		AND
		QRY_ORI_Karlach_HasCurrentActForgingOfTheHeartUpdate("FindInfernalMetal_FirstUpgrade")
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("GetFirstUpgrade");
		
		// Finding Dammon.
		IF
		DB_ORI_Karlach_ForgingOfTheHeart_HasSeenDammonInLevel(_Level)
		AND
		DB_ActiveLevel(_Level)
		AND
		DB_Players(_Player)
		AND
		DB_ORI_Karlach_InfernalMetalTemplates(_InfernalMetalTemplate)
		AND
		TemplateIsInInventory(_InfernalMetalTemplate, _Player, _Count)
		AND
		_Count > 0
		AND
		HasActiveStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_FIRSTUPGRADE", 0)
		AND
		HasActiveStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_SECONDUPGRADE", 0)
		AND
		QRY_ORI_Karlach_HasCurrentActForgingOfTheHeartUpdate("FindInfernalMetal_FirstUpgrade")
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("GetFirstUpgrade");
		
		// Get upgrades: Dammon is ready for the second upgrade and players find him
		// Getting the infernal plate
		IF
		TemplateAddedTo((ITEMROOT)_InfernalMetalTemplate, _, (CHARACTER)_Player, _)
		AND
		DB_ORI_Karlach_InfernalMetalTemplates(_InfernalMetalTemplate)
		AND
		DB_Players(_Player)
		AND
		DB_ORI_Karlach_ForgingOfTheHeart_HasSeenDammonInLevel(_Level)
		AND
		DB_ActiveLevel(_Level)
		AND
		TemplateIsInInventory(LOOT_Ketheric_Infernal_Plate_A_5f4022b2-848a-4e91-8697-85863f5136c8, _Player, _Count)
		AND
		_Count > 0
		AND
		HasActiveStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_FIRSTUPGRADE", 1)
		AND
		QRY_ORI_Karlach_HasCurrentActForgingOfTheHeartUpdate("FindInfernalMetal_SecondUpgrade")
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("GetSecondUpgrade");
		
		// Finding dammon.
		IF
		DB_ORI_Karlach_ForgingOfTheHeart_HasSeenDammonInLevel(_Level)
		AND
		DB_ActiveLevel(_Level)
		AND
		DB_Players(_Player)
		AND
		DB_ORI_Karlach_InfernalMetalTemplates(_InfernalMetalTemplate)
		AND
		TemplateIsInInventory(_InfernalMetalTemplate, _Player, _Count)
		AND
		_Count > 0
		AND
		HasActiveStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_FIRSTUPGRADE", 1)
		AND
		QRY_ORI_Karlach_HasCurrentActForgingOfTheHeartUpdate("FindInfernalMetal_SecondUpgrade")
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("GetSecondUpgrade");
		
		// Closing entries
		IF
		StatusApplied(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_SECONDUPGRADE", _, _)
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("KarlachFullyUpgraded");
		
		PROC
		PROC_Origins_CompanionLeavePermanently(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _Reason)
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("ForgingOfTheHeart_KarlachPermanentlyLeaves");
		
		IF
		DB_PermaDefeated(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("ForgingOfTheHeart_KarlachPermanentlyDies");
		
		PROC
		PROC_HAV_TieflingSurvivors_DidNotSurvive((CHARACTER)S_DEN_Weaponsmith_e2ad06ec-8034-479a-9f69-b86faea6dc79)
		THEN
		PROC_ORI_Karlach_CloseForgingOfTheHeartQuest();
		
		PROC
		PROC_ORI_Karlach_CloseForgingOfTheHeartQuest()
		AND
		DB_PermaDefeated(S_DEN_Weaponsmith_e2ad06ec-8034-479a-9f69-b86faea6dc79)
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("DammonPermadefeated");
		
		PROC
		PROC_ORI_Karlach_CloseForgingOfTheHeartQuest()
		AND
		DB_GlobalFlag((FLAG)GLO_ForgingOfTheHeart_Knows_DammonCanUpgradeKarlach_226d82fb-711b-64ac-e59a-b4361ce2204e)
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("ForgingOfTheHeart_ReachEND");
		
		PROC
		PROC_ORI_Karlach_CloseForgingOfTheHeartQuest()
		AND
		NOT DB_GlobalFlag((FLAG)GLO_ForgingOfTheHeart_Knows_DammonCanUpgradeKarlach_226d82fb-711b-64ac-e59a-b4361ce2204e)
		THEN
		PROC_ORI_Karlach_UpdateForgingOfTheHeartJournal("DammonNeverMet");
		
		//END_REGION FORGING OF THE HEART UPDATES
		
		//END_REGION KARLACH - JOURNAL
	}
	EXIT
	{
	}
}
