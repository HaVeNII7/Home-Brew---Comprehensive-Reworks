		PROC_LOW_BhaalTemple_ClearDB_Allies_DuelPos();
		
		IF
		TextEvent("BTTestQRYPos")
		AND
		GetHostCharacter(_Char)
		THEN
		DebugText(_Char, "BTTestQRYPos");
		PROC_LOW_BhaalTemple_Duel_Allies_Setup();
		
		IF
