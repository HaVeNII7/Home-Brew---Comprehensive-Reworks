	KB
	{
		//REGION Tiefling refugees to Act3
		QRY
		QRY_GLO_SetupForAct_CustomBlock("BGO_Main_A",(CHARACTER)_Tiefling)
		AND
		DB_WYR_RefugeeCamp_TieflingRefugees(_Tiefling, _,_,_,_,_)
		AND
		NOT DB_GlobalFlag((FLAG)DEN_TieflingRefugees_State_LeftDen_003b304b-f058-4f8a-b9fa-a097e1b6b395)
		THEN
		DB_NOOP(1);
		
		// teleport surviving tiefling refugees to camp
		PROC
		PROC_GLO_SetupForAct("BGO_Main_A", (CHARACTER)_Character, 1)
		AND
		DB_WYR_RefugeeCamp_TieflingRefugees(_Character, _Trigger, _Faction, _Dialog, _Zone, _Group)
		THEN
		DB_WYR_RefugeeCamp_TieflingRefugees_Placed(_Character, _Zone, _Group);
		PROC_GLO_SetupForAct_Place(_Character, _Trigger, _Faction, _Dialog);
		
		// set death flags for refugees that didn't make it
		PROC
		PROC_GLO_SetupForAct("BGO_Main_A", (CHARACTER)_Refugee, 0)
		AND
		DB_WYR_RefugeeCamp_TieflingRefugee_DeathFlag(_Refugee, _Flag)
		THEN
		PROC_GlobalSetFlagAndCache(_Flag);
		
		IF
		DB_WYR_RefugeeCamp_TieflingRefugee_DeathFlag(_Refugee, _Flag)
		AND
		DB_PermaDefeated(_Refugee)
		THEN
		PROC_GlobalSetFlagAndCache(_Flag);
		
		PROC
		PROC_GLO_SetupForAct_Place(S_DEN_PickpocketTrader_e1fda08b-45d4-41db-84b5-20e9931ba5af,_,_,_)
		THEN
		PROC_SetCustomTradeTreasure(S_DEN_PickpocketTrader_e1fda08b-45d4-41db-84b5-20e9931ba5af, "WYR_Thiefling_Trade");
		
		// refugees with wounded half-orc move to tieflings camp, refugee_05 to their place
		PROC
		PROC_GLO_SetupForActComplete("BGO_Main_A")
		AND
		NOT DB_WYR_RefugeeCamp_TieflingRefugees_Placed(_,"Camp",_)
		THEN
		PROC_GlobalSetFlagAndCache(WYR_RefugeeCamp_State_NoTieflingsCamp_6947d1af-e1a1-47bf-833e-10dca6311be7);
		DB_ItemOwnerShipTriggers("BGO_Main_A", (TRIGGER)S_WYR_RefugeeCamp_Tieflings_Ownership_df8bf4fb-2cfe-47eb-bb5f-ea1f98b78217, (CHARACTER)S_WYR_RefugeeCamp_Refugee_14_62986827-cf46-492b-a32e-27a168e47846);
		TeleportTo(S_WYR_RefugeeCamp_Refugee_15_92801b00-ec09-4d0d-990b-960c07de43e3, S_WYR_RefugeeCamp_Refugee_15_BackupPos_3001e9f1-4a48-4bde-99da-a8dc3ad7b2e0);
		TeleportTo(S_WYR_RefugeeCamp_Refugee_14_62986827-cf46-492b-a32e-27a168e47846, S_WYR_RefugeeCamp_Refugee_14_BackupPos_56c090c3-bdb3-4269-b473-2e6e0098381e);
		TeleportTo(S_WYR_RefugeeCamp_WoundedRefugee_7799795e-1477-4857-8cb7-ca5db3c50f47, S_WYR_RefugeeCamp_WoundedRefugee_BackupPos_17bbfba3-513d-40f2-a6b2-a6a4f413dbd3);
		DB_ItemOwnerShipTriggers("BGO_Main_A", (TRIGGER)S_WYR_RefugeeCamp_WoundedRefugee_Ownership_926a5f65-5f27-4c13-b867-d9491cc135d2, (CHARACTER)S_WYR_RefugeeCamp_Refugee_05_0caf9e68-3da5-48d1-b633-17df143c7978);
		TeleportTo(S_WYR_RefugeeCamp_Refugee_05_0caf9e68-3da5-48d1-b633-17df143c7978, S_WYR_RefugeeCamp_Refugee_05_9a800b94-b74f-4586-8f9a-a6cc84e19aa6);
		PROC_SetOnStage(S_WYR_RefugeeCamp_Kitchen_Pot_Cauldron_Covered_2_032ec8bc-e2af-4941-a57a-9daa16aaf819, 0);
		
		// normal setup
		PROC
		PROC_GLO_SetupForActComplete("BGO_Main_A")
		AND
		DB_WYR_RefugeeCamp_TieflingRefugees_Placed(_Tiefling, "Camp", "Adult")
		AND
		NOT DB_WYR_RefugeeCamp_TieflingsSetupDone(_)
		THEN
		PROC_WYR_RefugeeCamp_SetupTieflingsOwnership(_Tiefling);
		
		// no adults
		PROC
		PROC_GLO_SetupForActComplete("BGO_Main_A")
		AND
		DB_WYR_RefugeeCamp_TieflingRefugees_Placed(_Tiefling, "Camp", "Kid")
		AND
		NOT DB_WYR_RefugeeCamp_TieflingsSetupDone(_)
		THEN
		PROC_WYR_RefugeeCamp_SetupTieflingsOwnership(_Tiefling);
		
		PROC
		PROC_WYR_RefugeeCamp_SetupTieflingsOwnership((CHARACTER)_Tiefling)
		THEN
		DB_WYR_RefugeeCamp_TieflingsSetupDone(1);
		DB_ItemOwnerShipTriggers("BGO_Main_A", (TRIGGER)S_WYR_RefugeeCamp_Tieflings_Ownership_df8bf4fb-2cfe-47eb-bb5f-ea1f98b78217, (CHARACTER)_Tiefling);
		DB_ItemOwnerShipTriggers("BGO_Main_A", (TRIGGER)S_WYR_RefugeeCamp_WoundedRefugee_Ownership_926a5f65-5f27-4c13-b867-d9491cc135d2, (CHARACTER)S_WYR_RefugeeCamp_Refugee_14_62986827-cf46-492b-a32e-27a168e47846);
		TeleportTo(S_WYR_RefugeeCamp_Refugee_15_92801b00-ec09-4d0d-990b-960c07de43e3, S_WYR_RefugeeCamp_Refugee_15_CampPos_a2579c52-e9cc-4792-8f51-18d36a21f620);
		TeleportTo(S_WYR_RefugeeCamp_Refugee_14_62986827-cf46-492b-a32e-27a168e47846, S_WYR_RefugeeCamp_Refugee_14_CampPos_2ca8ee54-8921-46b9-9ea3-ee843a652118);
		TeleportTo(S_WYR_RefugeeCamp_WoundedRefugee_7799795e-1477-4857-8cb7-ca5db3c50f47, S_WYR_RefugeeCamp_WoundedRefugee_CampPos_044c2339-7fe6-47f6-b149-22ff1f344f06);
		PROC_SetOnStage(S_WYR_RefugeeCamp_Kitchen_Pot_Cauldron_Covered_1_ad7a0694-f193-4bca-9ac5-931f76fee101, 0);
		
		PROC
		PROC_GLO_SetupForAct_DebugRerun("BGO_Main_A")
		THEN
		NOT DB_WYR_RefugeeCamp_TieflingsSetupDone(1);
		PROC_GlobalClearFlagAndCache(WYR_RefugeeCamp_State_NoTieflingsCamp_6947d1af-e1a1-47bf-833e-10dca6311be7);
		//END_REGION
		
		//REGION Dibbs family (humans with dog)
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)WYR_RefugeeCamp_Dibbs_e3d059b3-b206-3d2a-7202-b5b37a9d3dde, _InstanceID)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_WYR_RefugeeCamp_DibbsWife_4c22257a-4729-47eb-ae4b-61305033be95, S_WYR_RefugeeCamp_Dibbs_72d61688-13bd-4aa3-a027-915cf1e66497)
		THEN
		PROC_DialogAddSpeakingActor(_InstanceID, S_WYR_RefugeeCamp_DibbsWife_4c22257a-4729-47eb-ae4b-61305033be95);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)WYR_RefugeeCamp_DibbsWife_613ea866-9768-ddfc-1ae3-a620645deaf5, _InstanceID)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_WYR_RefugeeCamp_Dibbs_72d61688-13bd-4aa3-a027-915cf1e66497, S_WYR_RefugeeCamp_DibbsWife_4c22257a-4729-47eb-ae4b-61305033be95)
		THEN
		PROC_DialogAddSpeakingActor(_InstanceID, (CHARACTER)S_WYR_RefugeeCamp_Dibbs_72d61688-13bd-4aa3-a027-915cf1e66497);
		//END_REGION
		
		//REGION Sleeper
		QRY
		QRY_SelectCustomDialog_AfterGenerics((CHARACTER)S_WYR_RefugeeCamp_HobgoblinOutcast_b75bfef3-187e-495a-b0d4-4903d18e21d2, (CHARACTER)_Player)
		AND
		IsReposed(S_WYR_RefugeeCamp_HobgoblinOutcast_b75bfef3-187e-495a-b0d4-4903d18e21d2, 1)
		THEN
		DB_WYR_RefugeeCamp_Sleeper_TalkWhenWakeUp(_Player);
		SetEntityEvent(S_WYR_RefugeeCamp_HobgoblinOutcast_b75bfef3-187e-495a-b0d4-4903d18e21d2, "GLO_Sit_ManualInterrupt", 1);
		EndRepose(S_WYR_RefugeeCamp_HobgoblinOutcast_b75bfef3-187e-495a-b0d4-4903d18e21d2);
		
		IF
		ReposeRemoved((CHARACTER)S_WYR_RefugeeCamp_HobgoblinOutcast_b75bfef3-187e-495a-b0d4-4903d18e21d2, _)
		AND
		DB_WYR_RefugeeCamp_Sleeper_TalkWhenWakeUp(_Player)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_WYR_RefugeeCamp_HobgoblinOutcast_b75bfef3-187e-495a-b0d4-4903d18e21d2, _Player)
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)WYR_RefugeeCamp_HobgoblinOutcast_9e1a54d2-9362-3f21-1010-b341bd704b24, S_WYR_RefugeeCamp_HobgoblinOutcast_b75bfef3-187e-495a-b0d4-4903d18e21d2, _Player)
		THEN
		DB_NOOP(1);
		
		IF
		ReposeRemoved(S_WYR_RefugeeCamp_HobgoblinOutcast_b75bfef3-187e-495a-b0d4-4903d18e21d2, _)
		AND
		DB_WYR_RefugeeCamp_Sleeper_TalkWhenWakeUp(_Player)
		THEN
		NOT DB_WYR_RefugeeCamp_Sleeper_TalkWhenWakeUp(_Player);
		
		// Make him sleep, otherwise his vision cone messess with big barn sneaking-in
		IF
		ReposeAdded(S_WYR_RefugeeCamp_HobgoblinOutcast_b75bfef3-187e-495a-b0d4-4903d18e21d2, S_WYR_RefugeeCamp_Bedroll_Open_C_008_ebc5fe5c-ad04-4904-84dd-de69ceeccc28)
		AND
		HasActiveStatus(S_WYR_RefugeeCamp_HobgoblinOutcast_b75bfef3-187e-495a-b0d4-4903d18e21d2, "SLEEPING", 0)
		THEN
		ApplyStatus(S_WYR_RefugeeCamp_HobgoblinOutcast_b75bfef3-187e-495a-b0d4-4903d18e21d2, "SLEEPING", -1.0, 1);
		
		IF
		ReposeRemoved(S_WYR_RefugeeCamp_HobgoblinOutcast_b75bfef3-187e-495a-b0d4-4903d18e21d2, S_WYR_RefugeeCamp_Bedroll_Open_C_008_ebc5fe5c-ad04-4904-84dd-de69ceeccc28)
		AND
		HasActiveStatus(S_WYR_RefugeeCamp_HobgoblinOutcast_b75bfef3-187e-495a-b0d4-4903d18e21d2, "SLEEPING", 1)
		THEN
		RemoveStatus(S_WYR_RefugeeCamp_HobgoblinOutcast_b75bfef3-187e-495a-b0d4-4903d18e21d2, "SLEEPING");
		//END_REGION
		
		//REGION Protesters
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)WYR_RefugeeCamp_Protester_001_19408bb1-670b-bdc6-3b8d-2fa4bee5bc7f, _InstanceID)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_WYR_RefugeeCamp_FlamingFist_004_285923f1-dce0-4f7f-8ebe-0de8ba990467, S_WYR_RefugeeCamp_Protester_001_77bc8a1b-1c6e-4627-8a24-99c33f743709)
		THEN
		PROC_DialogAddSpeakingActor(_InstanceID, S_WYR_RefugeeCamp_FlamingFist_004_285923f1-dce0-4f7f-8ebe-0de8ba990467);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)WYR_RefugeeCamp_Protester_001_19408bb1-670b-bdc6-3b8d-2fa4bee5bc7f, _InstanceID)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_WYR_RefugeeCamp_Protester_002_d61bafe9-67aa-4a79-a6a3-901839c44e6a, S_WYR_RefugeeCamp_Protester_001_77bc8a1b-1c6e-4627-8a24-99c33f743709)
		THEN
		PROC_DialogAddSpeakingActor(_InstanceID, S_WYR_RefugeeCamp_Protester_002_d61bafe9-67aa-4a79-a6a3-901839c44e6a);
		
		IF
		DB_GlobalFlag((FLAG)WYR_MerchantsHouse_State_MerchantConfessed_b9c702f4-ed9c-4fe5-0250-8bd96d21a044)
		AND
		DB_WYR_RefugeeCamp_Protesters(_Protester)
		AND
		NOT DB_InRegion(_, S_WYR_Rivington_SUB_40c3661e-99a1-4189-aa69-c006e77e3db8)
		AND
		NOT DB_OffStage(_Protester)
		AND
		NOT DB_PermaDefeated(_Protester)
		THEN
		PROC_SetOnStage(_Protester, 0);
		
		PROC
		PROC_StateSet_Defeated(_Protester)
		AND
		DB_WYR_RefugeeCamp_Protesters((CHARACTER)_Protester)
		THEN
		NOT DB_WYR_RefugeeCamp_Protesters((CHARACTER)_Protester);
		PROC_WYR_RefugeeCamp_CheckProtestersGone();
		
		IF
		DB_OffStage(_Protester)
		AND
		DB_WYR_RefugeeCamp_Protesters((CHARACTER)_Protester)
		THEN
		NOT DB_WYR_RefugeeCamp_Protesters((CHARACTER)_Protester);
		PROC_WYR_RefugeeCamp_CheckProtestersGone();
		
		PROC
		PROC_WYR_RefugeeCamp_CheckProtestersGone()
		AND
		NOT DB_WYR_RefugeeCamp_Protesters(_)
		AND
		NOT DB_GlobalFlag(WYR_RefugeeCamp_State_ProtestersGone_3a1902e0-67d4-5c07-b568-833426c21c06)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_RefugeeCamp_State_ProtestersGone_3a1902e0-67d4-5c07-b568-833426c21c06);
		//END_REGION
		
		//REGION Run if any in the group is killed
		IF
		DB_PermaDefeated(_GroupCharacter)
		AND
		DB_WYR_RefugeeCamp_GroupDisappearIfAnyKilled((CHARACTER)_GroupCharacter, _GroupID)
		AND
		DB_WYR_RefugeeCamp_GroupDisappearIfAnyKilled((CHARACTER)_OtherCharacter, _GroupID)
		AND
		_GroupCharacter != _OtherCharacter
		THEN
		PROC_NotifyWhenReadyToMoveOn((CHARACTER)_OtherCharacter, "WYR_RefugeeCamp_GroupDisappearIfAnyKilled_Notify");
		
		PROC
		PROC_ReadyToMoveOn(_OtherCharacter, "WYR_RefugeeCamp_GroupDisappearIfAnyKilled_Notify")
		THEN
		SetCanJoinCombat(_OtherCharacter, 0);
		PROC_SetCanFight(_OtherCharacter, 0);
		PROC_DisappearOutOfSight(_OtherCharacter, "Sprint", 1, "");
		//END_REGION
		
		//REGION Misc
		// To avoid the refugee run to the player when chest explodes
		QRY
		QRY_CRIME_BlockGenericInvestigation((CHARACTER)S_WYR_RefugeeCamp_Refugee_04_c4d3a57b-4117-4531-aff1-56542344900c)
		THEN
		SetEntityEvent(c4d3a57b-4117-4531-aff1-56542344900c, "CRIME_StartLookingForInterrogationSuspects");
		//END_REGION
	}
	EXIT
	{
	}
}
