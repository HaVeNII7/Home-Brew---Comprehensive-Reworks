		PROC_NotifyWhenReadyToMoveOn(_Player, "END_HighHall_ArrivalReaction");
		
		PROC
		PROC_StartDialog_AddExtraSpeakers(END_HighHall_Arrival_be92c5db-c9bf-4130-25f1-bdde183f7a46, _ID)
