		_Version < 7
		THEN
		NOT DB_XEL_GateStones_ModVersion(_Version);
		DB_XEL_GateStones_ModVersion(7);
		NOT DB_XEL_GateStone_TeleportStatus("XEL_TELEPORT_BETA_TO_ALPHA",1);
