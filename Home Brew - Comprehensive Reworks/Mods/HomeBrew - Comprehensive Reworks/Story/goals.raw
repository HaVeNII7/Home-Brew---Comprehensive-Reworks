	KB
	{
		//REGION Creche Knows Location
		IF
		DB_InRegion(_Player, S_CRE_Creche_TopFloor_SUB_01f823fe-7363-4f8a-bea3-31755b318738)
		AND
		QRY_OnlyOnce("CRE_EnteredCreche")
		THEN
		SetFlag((FLAG)ORI_Laezel_Knows_CrecheLocation_696c423d-e6da-428e-a7fe-c083fffccad2);
		SetFlag((FLAG)ORI_Laezel_Knows_FoundCreche_1ea76d79-24c5-4d63-a9cd-178266f1673d);
		
		//END_REGION
		
		//REGION Creche Markings
		//Becomes available when the players notice the gith markings at the entrance of the region
		IF
		DB_InRegion((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (TRIGGER)S_CRE_GithMarkingsArea_c80368e0-8165-4738-837c-30ea37d62c11)
		AND
		DB_Players((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Laezel_Knows_FoundCreche_1ea76d79-24c5-4d63-a9cd-178266f1673d)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Laezel_State_RecruitmentInCrecheActive_674e1fbb-7174-4c62-9581-08c67aeeaaa4)
		AND
		QRY_OnlyOnce("CRE_LaezelSawMarkings")
		THEN
		PROC_ORI_Laezel_TryToStartMarkingsDialog();
		
		IF
		DB_InRegion((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (TRIGGER)S_CRE_GithMarkingsAreaSCLSide_67e9624c-91ea-40fb-9f62-f1f5136f14fd)
		AND
		DB_Players((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Laezel_Knows_FoundCreche_1ea76d79-24c5-4d63-a9cd-178266f1673d)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Laezel_State_RecruitmentInCrecheActive_674e1fbb-7174-4c62-9581-08c67aeeaaa4)
		AND
		QRY_OnlyOnce("CRE_LaezelSawMarkings")
		THEN
		SetFlag((FLAG)ORI_Laezel_State_ReactedToMarkingsFromSCLSide_074e45a4-5a52-4d14-8e5f-2e68183d5947);
		PROC_ORI_Laezel_TryToStartMarkingsDialog();
		
		PROC
		PROC_ORI_Laezel_TryToStartMarkingsDialog()
		THEN
		SetFlag((FLAG)ORI_Laezel_IPRD_CrecheMarkings_8a018b93-a428-49f2-9188-fc3b0b7eb1e0, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		
		PROC
		PROC_ORI_Laezel_TryToStartMarkingsDialog()
		AND
		QRY_GetBestAvatarForCompanion((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		DB_QRYRTN_GetBestAvatarForCompanion((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _Avatar)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(_Avatar, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)Laezel_InParty2_93bf58f5-5111-9730-1ee2-62dfb0b00c96, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _Avatar)
		THEN
		DB_ORI_Laezel_CrecheMarkingsDialogStarted(1);
		
		PROC
		PROC_ORI_Laezel_TryToStartMarkingsDialog()
		AND
		NOT DB_ORI_Laezel_CrecheMarkingsDialogStarted(1)
		THEN
		ClearFlag((FLAG)ORI_Laezel_IPRD_CrecheMarkings_8a018b93-a428-49f2-9188-fc3b0b7eb1e0, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		PROC_TryStartAD((DIALOGRESOURCE)ORI_Laezel_AD_CrecheMarkings_02323c18-5b00-54af-1c47-317a7d6d89c5, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		PROC_RelationshipDialog((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (DIALOGRESOURCE)Laezel_InParty2_93bf58f5-5111-9730-1ee2-62dfb0b00c96, (FLAG)ORI_Laezel_IPRD_CrecheMarkings_8a018b93-a428-49f2-9188-fc3b0b7eb1e0, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, 0);
		SetFlag((FLAG)ORI_Laezel_Knows_CrecheLocation_696c423d-e6da-428e-a7fe-c083fffccad2);
		SetFlag((FLAG)ORI_Laezel_State_ReactedToCrecheMarkingsLater_f824b96e-f2bd-4021-9a10-894d420e7fa4);
		
		IF
		DB_InRegion((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (TRIGGER)S_CRE_GithMarkingsArea_c80368e0-8165-4738-837c-30ea37d62c11)
		AND
		DB_Avatars((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Laezel_Knows_FoundCreche_1ea76d79-24c5-4d63-a9cd-178266f1673d)
		AND
		QRY_OnlyOnce("CRE_LaezelSawMarkings")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)ORI_Laezel_AD_CrecheMarkings_02323c18-5b00-54af-1c47-317a7d6d89c5, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		SetFlag((FLAG)ORI_Laezel_Knows_CrecheLocation_696c423d-e6da-428e-a7fe-c083fffccad2);
		
		IF
		FlagSet((FLAG)ORI_Laezel_Knows_FoundCreche_1ea76d79-24c5-4d63-a9cd-178266f1673d, _, _)
		THEN
		PROC_CancelRelationshipDialog((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (DIALOGRESOURCE)Laezel_InParty2_93bf58f5-5111-9730-1ee2-62dfb0b00c96, (FLAG)ORI_Laezel_IPRD_CrecheMarkings_8a018b93-a428-49f2-9188-fc3b0b7eb1e0);
		
		//END_REGION
		
		//REGION Chain of Command OM
		IF
		TextEvent("ORI_Laezel_Zaithisk")
		THEN
		SetFlag((FLAG)CRE_GithInfirmary_State_CharacterUsedDevice_23fd1f32-7850-466e-a77a-75cd48bdaa21, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		
		QRY
		QRY_OriginMoment_PreventRelaunchDialog((DIALOGRESOURCE)CRE_ChainOfCommand_Vlaakith_OM_Laezel_AOM_OOM_8a12a3a7-d7bf-4398-8770-ed2d17e257d6, _, _)
		THEN
		DB_NOOP(1); 
		
		QRY
		QRY_OriginMoment_PreventRelaunchDialog((DIALOGRESOURCE)CRE_ChainOfCommand_Vlaakith_OM_Laezel_COM_d2bacdeb-9d4e-af99-8f92-b2e19d1b85aa, _, _)
		THEN
		DB_NOOP(1); 
		
		IF
		EnteredTrigger((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (TRIGGER)S_CRE_VlaakithDialog_LaezelOMArea_9ee53aad-fc64-4ac7-93d6-4f098273bd4f)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Laezel_Knows_MetVlaakith_c93015c2-6ae4-4013-b439-433b588f881c)
		THEN
		DB_CustomDialogRange(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, 20);
		
		IF
		LeftTrigger((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (TRIGGER)S_CRE_VlaakithDialog_LaezelOMArea_9ee53aad-fc64-4ac7-93d6-4f098273bd4f)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		DB_CustomDialogRange(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, 20)
		THEN
		NOT DB_CustomDialogRange(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, 20);
		
		//Clear ExtraNPCs DB as these NPCs are optional and they prevent the OM from launching if they are dead
		PROC
		PROC_CRE_ChainOfCommand_StartSecurityOfficeCombat()
		AND
		DB_OriginMoment_ExtraNPCs((DIALOGRESOURCE)CRE_ChainOfCommand_Vlaakith_OM_Laezel_AOM_OOM_8a12a3a7-d7bf-4398-8770-ed2d17e257d6, _NPC)
		THEN
		NOT DB_OriginMoment_ExtraNPCs((DIALOGRESOURCE)CRE_ChainOfCommand_Vlaakith_OM_Laezel_AOM_OOM_8a12a3a7-d7bf-4398-8770-ed2d17e257d6, _NPC);
		
		PROC
		PROC_CRE_ChainOfCommand_StartSecurityOfficeCombat()
		AND
		DB_OriginMoment_ExtraNPCs((DIALOGRESOURCE)CRE_ChainOfCommand_Vlaakith_OM_Laezel_COM_d2bacdeb-9d4e-af99-8f92-b2e19d1b85aa, _NPC)
		THEN
		NOT DB_OriginMoment_ExtraNPCs((DIALOGRESOURCE)CRE_ChainOfCommand_Vlaakith_OM_Laezel_COM_d2bacdeb-9d4e-af99-8f92-b2e19d1b85aa, _NPC);
		
		//Player loses control of Laezel if they accept Vlaakith's orders or if they refuse and haven't convinced Laezel
		//If players try to leave the room, the Inquisitor would attack them if he's alive, otherwise Laezel will attack them
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)CRE_ChainOfCommand_State_LaezelWaitsAtPlanecaster_e25eb1e0-739e-489e-a1df-d2468682e9b3)
		AND
		QRY_GetBestAvatarForCompanion((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		DB_QRYRTN_GetBestAvatarForCompanion((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _Avatar)
		THEN
		PROC_CRE_ChainOfCommand_LaezelWaitsAtPlanecaster(_Avatar);
		
		PROC
		PROC_CRE_ChainOfCommand_LaezelWaitsAtPlanecaster((CHARACTER)_Avatar)
		THEN
		DB_GLO_PartyMembers_BlockReturnToRecruitmentPosition(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		DB_CompanionLeaving(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12,_Avatar);
		PROC_Origins_CompanionLeaveTemporarily((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, "SpokeToVlaakith_LaezelAtPlanecaster");
		DB_CRE_ChainOfCommand_LaezelIsAtPlanecaster(_Avatar);
		PROC_RemoveAllDialogEntriesForSpeaker(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		DB_Dialogs(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (DIALOGRESOURCE)CRE_ChainOfCommand_LaezelAtPlanecaster_95e4084a-6e8c-9266-5e52-fdb6af7ce049); //While she's not under the player control, she has a different one line dialog
		PROC_CharacterMoveTo(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (TRIGGER)S_CRE_LaezelNearPlanecasterPos_f7d75472-f18a-4912-b773-0b05c69a4278, "Walk", "");
		SetFaction(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (FACTION)Act1B_CRE_Gith_SecurityOffice_Laezel_5950b10a-8f6f-4b73-8866-831842652b5e);
		PROC_TryStartAD((DIALOGRESOURCE)CRE_ChainOfCommand_AD_LaezelGoesToPlanecaster_64e88b2d-6b86-ef23-3655-2d97f228fb5d, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		
		PROC
		PROC_CRE_ChainOfCommand_LaezelWaitsAtPlanecaster(_Avatar)
		AND
		IsInInventoryOf((ITEM)S_GLO_PuzzleBox_326324f9-0920-8f0f-3e85-3781fbf48282, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, 1)
		THEN
		SetFlag((FLAG)GLO_InfernalBox_Event_ForceGiveBox_7addbb64-502f-48aa-9b71-da1b8d6c28eb, _Avatar);
		
		IF
		DialogEnded((DIALOGRESOURCE)CRE_ChainOfCommand_Vlaakith_OM_Laezel_COM_d2bacdeb-9d4e-af99-8f92-b2e19d1b85aa, _)
		THEN
		PROC_CancelAllRelationshipDialogs((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		
		//Laezel turns hostile if the player refuses to show the artefact to the Inquisitor in the CRE_ChainOfCommand_Templar dialog
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)CRE_ChainOfCommand_Event_LaezelTurnsHostile_7b579389-80c1-4ccd-afb6-8283e204f854)
		THEN
		PROC_CRE_ChainOfCommand_LaezelTurnsHostile();
		
		//Laezel turns hostile if you start a fight while she's waiting at the Planecaster
		IF
		DB_Is_InCombat(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _Id)
		AND
		DB_Is_InCombat(S_CRE_Templar_378ac93e-03a0-40b4-904c-f37989ac7a8c, _Id)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		DB_GlobalFlag((FLAG)CRE_ChainOfCommand_State_LaezelWaitsAtPlanecaster_e25eb1e0-739e-489e-a1df-d2468682e9b3)
		AND
		QRY_OnlyOnce("CRE_ChainOfCommand_LaezelTurnedHostile")
		THEN
		PROC_CRE_ChainOfCommand_LaezelTurnsHostile();
		
		//Laezel turns hostile if the player leaves the room while she's at the planecaster
		IF
		LeftTrigger(_Player, S_CRE_SecurityOfficeArea_4f8819f5-4898-4db1-b3bd-92d24c51c80f)
		AND
		DB_Players(_Player)
		AND
		DB_InRegion((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (TRIGGER)S_CRE_SecurityOfficeLaezelLeaveArea_7b8493ab-9413-4330-9aa8-24b752a79980)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Laezel_State_ConvincedToSideWithPlayerAgainstInquisitor_a1279e2b-04d4-4093-97f2-3c3603153d2c)
		AND
		DB_GlobalFlag((FLAG)CRE_ChainOfCommand_State_PlanecasterActive_5e5e9cb6-41d8-4a93-942d-3dca4d357561)
		AND
		NOT DB_GlobalFlag((FLAG)CRE_AstralPrison_State_AstralPrisonWasEntered_2203e87a-6c7b-4aba-b2e8-e22ed96b9762)
		AND
		QRY_OnlyOnce("CRE_ChainOfCommand_LaezelTurnedHostile")
		THEN
		PROC_CRE_ChainOfCommand_LaezelTurnsHostile();
		
		PROC
		PROC_CRE_CrecheHostile()
		AND
		DB_GlobalFlag((FLAG)CRE_ChainOfCommand_State_PlanecasterActive_5e5e9cb6-41d8-4a93-942d-3dca4d357561)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Laezel_State_ConvincedToSideWithPlayerAgainstInquisitor_a1279e2b-04d4-4093-97f2-3c3603153d2c)
		AND
		DB_InRegion((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (TRIGGER)S_CRE_SecurityOfficeLaezelLeaveArea_7b8493ab-9413-4330-9aa8-24b752a79980)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		THEN
		PROC_CRE_ChainOfCommand_LaezelTurnsHostile();
		
		PROC
		PROC_CRE_ChainOfCommand_LaezelTurnsHostile()
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		QRY_OnlyOnce("ORI_Laezel_TurnsHostileAtPlanecaster")
		THEN
		PROC_Origins_CompanionLeavePermanently((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, "TurnedHostileDuringInquisitor");
		SetFaction((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (FACTION)Act1B_CRE_Gith_SecurityOffice_Laezel_5950b10a-8f6f-4b73-8866-831842652b5e);
		PROC_SetRelationToPlayers((FACTION)Act1B_CRE_Gith_SecurityOffice_Laezel_5950b10a-8f6f-4b73-8866-831842652b5e, 0);
		PROC_CharacterMoveTo((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (TRIGGER)S_CRE_Laezel_HostileRunToPositionInOffice_5d245142-d35f-46e6-bdcd-fdab86e5d7aa, "Run", "");
		DB_CombatReact_AD_OnNextTurn((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, CRE_ChainOfCommand_AD_LaezelTurnsHostile_a4961019-6be8-862d-ee66-f74a2ead4f53);
		
		PROC
		PROC_CRE_ChainOfCommand_LaezelTurnsHostile()
		AND
		GetClosestAlivePlayer(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _Player, _Dist)
		AND
		_Dist <= 30.0
		THEN
		SetCombatGroupAndEnterCombat(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, "c7eee170-a521-46d6-9cc2-72a6e8618930", _Player);
		
		//Returns Laezel to party if the Artefact is inserted in the Planecaster while she's waiting
		QRY
		QRY_ORI_Laezel_CheckAddToParty()
		AND
		DB_GlobalFlag((FLAG)CRE_ChainOfCommand_State_LaezelWaitsAtPlanecaster_e25eb1e0-739e-489e-a1df-d2468682e9b3)
		AND
		DB_OriginInPartyDialog((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _InPartyDialog)
		AND
		DB_CRE_ChainOfCommand_LaezelIsAtPlanecaster(_Avatar)
		THEN
		PROC_GlobalClearFlagAndCache((FLAG)CRE_ChainOfCommand_State_LaezelWaitsAtPlanecaster_e25eb1e0-739e-489e-a1df-d2468682e9b3);
		NOT DB_CRE_ChainOfCommand_LaezelIsAtPlanecaster(_Avatar);
		NOT DB_GLO_PartyMembers_BlockReturnToRecruitmentPosition(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		PROC_GLO_PartyMembers_Add((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _Avatar);
		PROC_RemoveAllDialogEntriesForSpeaker(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		PROC_GLO_Origins_MaybeSetDefaultDialog(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _InPartyDialog); //Return her InParty dialog when she's readded to party
		ClearTag(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (TAG)BLOCK_RESURRECTION_22a75dbb-1588-407e-b559-5aa4e6d4e6a6);
		
		//It should always pass, just does some extra bits conditionally
		QRY
		QRY_ORI_Laezel_CheckAddToParty()
		THEN
		DB_NOOP(1);
		
		//Add flag reactivity for Laezel not being present for the Vlaakith betrayal dialog. If she is, either the AOM, COM or OOM versions of this dialog would play instead
		IF
		DialogStarted((DIALOGRESOURCE)CRE_ChainOfCommand_Vlaakith_8ca0aac9-c46a-8d02-00ff-c61e6ec77c8d, _)
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		NOT DB_ORI_Laezel_JoinedVlaakithDialog(1)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)ORI_Laezel_State_LaezelWasInCampVlaakithBetrayal_0a32e664-a968-4a1f-a8cd-ca0b2588444a);
		
		IF
		DialogActorJoined((DIALOGRESOURCE)CRE_ChainOfCommand_Vlaakith_8ca0aac9-c46a-8d02-00ff-c61e6ec77c8d, _, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _)
		THEN
		DB_ORI_Laezel_JoinedVlaakithDialog(1);
		PROC_GlobalClearFlagAndCache((FLAG)ORI_Laezel_State_LaezelWasInCampVlaakithBetrayal_0a32e664-a968-4a1f-a8cd-ca0b2588444a);
		
		IF
		FlagSet((FLAG)CRE_AstralPrison_State_PlayerEnteredAstralPrison_889725f7-2635-462b-8062-97b5d8c91112, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _)
		THEN
		DB_ORI_Laezel_JoinedVlaakithDialog(1);
		PROC_GlobalClearFlagAndCache((FLAG)ORI_Laezel_State_LaezelWasInCampVlaakithBetrayal_0a32e664-a968-4a1f-a8cd-ca0b2588444a);
		
		//Called when exiting the room through the door with the Planecaster active. The area is a danger zone so it can't be left with FastTravel or resting
		//Can lead either into combat if the Inquisitor is alive, or directly to the WRD if he's not
		IF
		LeftTrigger(_Player, S_CRE_SecurityOfficeArea_4f8819f5-4898-4db1-b3bd-92d24c51c80f)
		AND
		DB_Players(_Player)
		AND
		DB_GlobalFlag((FLAG)CRE_ChainOfCommand_State_PlanecasterActive_5e5e9cb6-41d8-4a93-942d-3dca4d357561)
		AND
		NOT DB_GlobalFlag((FLAG)CRE_AstralPrison_State_AstralPrisonWasEntered_2203e87a-6c7b-4aba-b2e8-e22ed96b9762)
		AND
		DB_InRegion((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (TRIGGER)S_CRE_SecurityOfficeLaezelLeaveArea_7b8493ab-9413-4330-9aa8-24b752a79980)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		THEN
		DB_CRE_ChainOfComand_LaezelWRD_ReadyToActivate(1);
		
		IF
		LeftTrigger(_Player, (TRIGGER)S_CRE_AstralPlane_SUB_3f383c9a-fbe1-479e-a7ed-de86f65e93d9)
		AND
		DB_Players(_Player)
		AND
		DB_Defeated(S_CRE_Templar_378ac93e-03a0-40b4-904c-f37989ac7a8c)
		AND
		DB_Players((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		THEN
		DB_CRE_ChainOfComand_LaezelWRD_ReadyToActivate(1);
		
		IF
		DialogEnded((DIALOGRESOURCE)CRE_ChainOfCommand_Betrayal_OM_Laezel_COM_37646009-a3de-b772-d063-0d85c053ed88, _)
		AND
		NOT DB_CRE_ChainOfComand_LaezelWRD_ReadyToActivate(1)
		THEN
		DB_CRE_ChainOfComand_LaezelWRD_ReadyToActivate(1);
		
		//Plays after the inquisitor is defeated and the player has either returned from the Astral plane, or have refused the orders and exited the room
		//Does not play if the inquisitor is defeatead before the Vlaakith Dialog has played, as it will activate instead once he's defeated
		PROC
		PROC_GLO_DefeatCounter_AllDefeated("CRE_ChainOfCommand_InquisitorCombat")
		AND
		DB_CRE_ChainOfComand_LaezelWRD_ReadyToActivate(1) //Does not play if the player defeats the inquisitor before going to Astral Plane and haven't spoken to Vlaakith yet
		AND
		DB_Defeated(S_CRE_Templar_378ac93e-03a0-40b4-904c-f37989ac7a8c)
		AND
		QRY_OnlyOnce("CRE_ChainOfCommand_LaezelDefaultDialogEntryAdded")
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (DIALOGRESOURCE)Laezel_InParty2_93bf58f5-5111-9730-1ee2-62dfb0b00c96, ORI_Laezel_IPRD_VlaakithBetrayal_602363bc-c944-44be-aa93-8922d9cbdb1b, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, 0);
		
		//Adds a branch to the Laezel Default Dialog if the Inquisitor is already defeated when the DB is set
		IF
		DB_CRE_ChainOfComand_LaezelWRD_ReadyToActivate(1)
		AND
		DB_Defeated(S_CRE_Templar_378ac93e-03a0-40b4-904c-f37989ac7a8c)
		AND
		QRY_OnlyOnce("CRE_ChainOfCommand_LaezelDefaultDialogEntryAdded")
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (DIALOGRESOURCE)Laezel_InParty2_93bf58f5-5111-9730-1ee2-62dfb0b00c96, ORI_Laezel_IPRD_VlaakithBetrayal_602363bc-c944-44be-aa93-8922d9cbdb1b, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, 0);
		
		IF
		FlagSet((FLAG)CRE_Lance_Event_Exploded_f7d93dd1-c30e-4ef2-87c0-0cada12f180d, _, _)
		THEN
		PROC_CancelRelationshipDialog((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (DIALOGRESOURCE)Laezel_InParty2_93bf58f5-5111-9730-1ee2-62dfb0b00c96, ORI_Laezel_IPRD_VlaakithBetrayal_602363bc-c944-44be-aa93-8922d9cbdb1b);
		
		IF
		FlagSet((FLAG)Laezel_InParty_Event_DiscussedVlaakithBetrayal_af0ad422-970f-43d5-852d-d1551cdc6231, _, _)
		THEN
		PROC_CancelRelationshipDialog((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (DIALOGRESOURCE)Laezel_InParty2_93bf58f5-5111-9730-1ee2-62dfb0b00c96, ORI_Laezel_IPRD_VlaakithBetrayal_602363bc-c944-44be-aa93-8922d9cbdb1b);
		
		IF
		FlagSet((FLAG)ORI_Laezel_State_MetVossInAct2_26563f96-bf5a-4895-b63b-036c7571bbbc, _, _)
		THEN
		PROC_CancelRelationshipDialog((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (DIALOGRESOURCE)Laezel_InParty2_93bf58f5-5111-9730-1ee2-62dfb0b00c96, ORI_Laezel_IPRD_VlaakithBetrayal_602363bc-c944-44be-aa93-8922d9cbdb1b);
		
		//Should only trigger if the flag is set while the relationship dialog is ongoing, not if the flag has been set previously
		IF
		FlagSet((FLAG)CURRENTREGION_SCL_Main_A_f76b85b5-b557-4409-98fd-cc7b22f8292b, _, _)
		THEN
		PROC_CancelRelationshipDialog((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (DIALOGRESOURCE)Laezel_InParty2_93bf58f5-5111-9730-1ee2-62dfb0b00c96, ORI_Laezel_IPRD_VlaakithBetrayal_602363bc-c944-44be-aa93-8922d9cbdb1b);
		
		//END_REGION
		
		//REGION Zaithisk
		//If Laezel is allowed, the Normal Version of the dialog does not trigger after the OM
		QRY
		QRY_OriginMoment_PreventRelaunchDialog((DIALOGRESOURCE)CRE_GithInfirmary_Device_OM_Laezel_COM_444edbd9-75ee-14c2-0d30-3e2efe7866db, S_CRE_InfirmaryDevice_df843052-358f-487e-a3e2-8dafa0aaf6a6, _Player)
		AND
		DB_GlobalFlag((FLAG)CRE_GithInfirmary_State_LaezelOMAllowedLaezel_95f26a55-5b5a-4f81-ab2d-750f7159ff50)
		THEN
		DB_NOOP(1);
		//END_REGION
		
		//REGION Post-Zaithisk Default Dialog entry
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)CRE_GithInfirmary_State_UsedDevice_a56d58c6-2a81-4a80-a4f6-4f73f254b40c)
		AND
		DB_GlobalFlag((FLAG)CRE_GithInfirmary_State_LaezelTookPartInDevice_7ea4b4b7-06a4-44f6-aca6-75a1da537ebd)
		THEN
		TimerLaunch("CRE_GithInfirmary_LaezelReactionAD_Delay", 1500); //Short breathing space between the dialog ending and this AD starting
		
		//Sets a new entry in the Default Dialog
		IF
		TimerFinished("CRE_GithInfirmary_LaezelReactionAD_Delay")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)CRE_GithInfirmary_AD_LaezelReactionAfterZaithisk_3ed60424-6383-96c0-34f5-e26c54fb9e0c, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		
		//InParty conversation becomes available only if the player hasn't dealt with the Inquisitor and Vlaakith yet
		IF
		TimerFinished("CRE_GithInfirmary_LaezelReactionAD_Delay")
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (DIALOGRESOURCE)CRE_Laezel_WRD_PostZaithisk_bafb04ca-e293-d07b-9b46-5a8578de9846, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		//END_REGION
		
		//REGION Astral Prison - after Daisy
		IF
		EntityEvent(_Avatar, "CRE_AstralPrism_ReturnedAfterDaisyDialog")
		AND
		DB_Players((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		QRY_StartDialog((DIALOGRESOURCE)Laezel_InParty2_93bf58f5-5111-9730-1ee2-62dfb0b00c96, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _Avatar)
		THEN
		DB_CRE_StartedLaezelDialogWithAvatarAfterDaisy(1);
		SetFlag((FLAG)ORI_Laezel_IPRD_AfterDaisyInCreche_74d4537c-856b-4475-a6e4-e10fb998f588, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)Laezel_InParty2_93bf58f5-5111-9730-1ee2-62dfb0b00c96, _Id)
		AND
		DB_CRE_StartedLaezelDialogWithAvatarAfterDaisy(1)
		AND
		DialogGetInvolvedPlayer(_Id, 1, _Avatar)
		AND
		QRY_GetBestAvatarForCompanion((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		DB_QRYRTN_GetBestAvatarForCompanion((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12,_BoundAvatar)
		AND
		_BoundAvatar != _Avatar
		THEN
		NOT DB_CRE_StartedLaezelDialogWithAvatarAfterDaisy(1);
		PROC_DialogAddListeningActor(_Id, _BoundAvatar);
		
		IF
		DialogEnded(Laezel_InParty2_93bf58f5-5111-9730-1ee2-62dfb0b00c96, _)
		AND
		DB_CRE_StartedLaezelDialogWithAvatarAfterDaisy(1)
		THEN
		NOT DB_CRE_StartedLaezelDialogWithAvatarAfterDaisy(1);
		
		IF
		DialogRequestFailed(Laezel_InParty2_93bf58f5-5111-9730-1ee2-62dfb0b00c96, _)
		AND
		DB_CRE_StartedLaezelDialogWithAvatarAfterDaisy(1)
		THEN
		NOT DB_CRE_StartedLaezelDialogWithAvatarAfterDaisy(1);
		
		IF
		ReadyCheckPassed("CRE_AstralPrison_ReturnToCrecheReadyCheck")
		THEN
		NOT DB_CRE_StartedLaezelDialogWithAvatarAfterDaisy(1);
		//END_REGION
		
		//REGION Post Creche Destruction Default Dialog Entry
		IF
		TimerFinished("CRE_Lance_CrecheDestroyed_GroupDiscussionStartDelay")
		THEN
		SetFlag((FLAG)ORI_Laezel_State_StillInCrecheRegionAfterDestruction_73094947-03a4-4f4a-ad40-6ac774b9508f);
		SetFlag((FLAG)ORI_Laezel_State_ReactedToCrecheDestructionImmediately_6eefa160-21f9-4d17-8fef-26b357194d43);
		DB_TriggerEvents_AllPlayersLeft((TRIGGER)S_CRE_Laezel_PostCrecheDestructionImmediateReactionArea_fdf35162-4218-4d7c-8755-f94d5a955dfc, "ORI_Laezel_LeftPostCrecheDestructionArea");
		DB_RelationshipDialog_WRD_TriggerInCamp((DIALOGRESOURCE)CRE_Laezel_WRD_PostCrecheDestruction_379c8d83-89d6-18dd-c48a-75a360f8a76c, NULL_00000000-0000-0000-0000-000000000000);
		PROC_RelationshipDialog((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (DIALOGRESOURCE)CRE_Laezel_WRD_PostCrecheDestruction_379c8d83-89d6-18dd-c48a-75a360f8a76c, (FLAG)NULL_00000000-0000-0000-0000-000000000000, (CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, 0);
		
		IF
		FlagSet((FLAG)ORI_Laezel_State_WRD_PostCrecheDestruction_5e856cb0-9aa1-4fd4-bb29-3e942fc2d047, _, _)
		THEN
		NOT DB_RelationshipDialog_WRD_TriggerInCamp((DIALOGRESOURCE)CRE_Laezel_WRD_PostCrecheDestruction_379c8d83-89d6-18dd-c48a-75a360f8a76c, NULL_00000000-0000-0000-0000-000000000000);
		PROC_CancelRelationshipDialog((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (DIALOGRESOURCE)CRE_Laezel_WRD_PostCrecheDestruction_379c8d83-89d6-18dd-c48a-75a360f8a76c, NULL_00000000-0000-0000-0000-000000000000);
		
		
		IF
		EntityEvent(_, "ORI_Laezel_LeftPostCrecheDestructionArea")
		THEN
		ClearFlag((FLAG)ORI_Laezel_State_ReactedToCrecheDestructionImmediately_6eefa160-21f9-4d17-8fef-26b357194d43);
		
		//Laezel is part of the team, but not in party (left in camp)
		IF
		TimerFinished("CRE_Lance_CrecheDestroyed_GroupDiscussionStartDelay")
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		NOT DB_Players((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		THEN
		SetFlag((FLAG)ORI_Laezel_State_LaezelWasInCampWhenDestructionHappened_373da81c-6bd5-4c1a-b0c2-11c798ef280a);
		
		//If you left the Creche region while the PostCrecheDestruction branch is still queued up, clears a flag that changes the flavour of the greeting node of that branch
		IF
		DB_GlobalFlag((FLAG)ORI_Laezel_State_CrecheExploded_31ee1ed3-b163-4d1a-84f3-d37521900a87)
		AND
		NOT DB_ActiveLevel("CRE_Main_A")
		THEN
		ClearFlag((FLAG)ORI_Laezel_State_StillInCrecheRegionAfterDestruction_73094947-03a4-4f4a-ad40-6ac774b9508f);
		
		//END_REGION
		
		//REGION AD After Inquisitor Combat when fighting her way out of the Creche
		//Track when the players escapes the Creche after being betrayed by Vlaakith
		IF
		DB_GlobalFlag((FLAG)ORI_Laezel_State_BetrayedByVlaakith_175d8487-99dc-4009-9b45-6e9f29708cd7)
		THEN
		DB_TriggerEvents_AllPlayersLeftAllTriggersInSet("CRE_InnerCreche", "CRE_LeftCrecheAfterBetrayal");
		
		IF
		EntityEvent(_, "CRE_LeftCrecheAfterBetrayal")
		AND
		NOT DB_CRE_Laezel_LeftCrecheAfterBetrayal(1)
		THEN
		DB_CRE_Laezel_LeftCrecheAfterBetrayal(1);
		
		//If Laezel enters a fight with someone else in the Creche that is not in the Inquisitor's room, she will say a comment that Vlaakith set the creche hostile and they must fight their way out
		IF
		DB_GlobalFlag((FLAG)CRE_General_State_CrecheTurnedHostile_e183e7dc-c07a-4093-91dc-7814375c9582)
		AND
		NOT DB_CRE_Laezel_LeftCrecheAfterBetrayal(1) //Once you leave, this comment doesn't make sense if you return
		AND
		DB_Is_InCombat(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _CombatID)
		AND
		DB_Is_InCombat(_OtherGith, _CombatID)
		AND
		IsTagged(_OtherGith, (TAG)GITHYANKI_677ffa76-2562-4217-873e-2253d4720ba4, 1)
		AND
		NOT DB_Players((CHARACTER)_OtherGith)
		AND
		NOT DB_CRE_LaezelComment_ExcludedTargets((CHARACTER)_OtherGith)
		AND
		DB_Players(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		QRY_OnlyOnce("ORI_Laezel_AD_FightOutOfTheCreche_Called")
		THEN
		DB_CombatReact_AD_OnNextTurn(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (DIALOGRESOURCE)ORI_Laezel_AD_FightOutOfTheCreche_2bcd8eb5-4de4-88c2-00f6-68d66d1fe104);
		
		//END_REGION
		
		//REGION Flag set after encountering the hostile creche after Vlaakith scene
		//Track if the player (with or without Laezel, but needed for her Inparty) fought any of the gith in the creche after the Inquisitor fight, after they were turned hostile by Vlaakith
		IF
		DB_GlobalFlag((FLAG)CRE_General_State_CrecheTurnedHostile_e183e7dc-c07a-4093-91dc-7814375c9582)
		AND
		DB_Is_InCombat(_Player, _CombatID)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		DB_Is_InCombat(_OtherGith, _CombatID)
		AND
		IsTagged(_OtherGith, (TAG)GITHYANKI_677ffa76-2562-4217-873e-2253d4720ba4, 1)
		AND
		NOT DB_Players((CHARACTER)_OtherGith)
		AND
		NOT DB_CRE_LaezelComment_ExcludedTargets((CHARACTER)_OtherGith)
		AND
		NOT DB_GlobalFlag((FLAG)CRE_General_State_EncounteredHostileGithAfterCrecheTurnsHostile_a64dbe49-7166-493b-98ba-0965987ff3ad)
		THEN
		SetFlag((FLAG)CRE_General_State_EncounteredHostileGithAfterCrecheTurnsHostile_a64dbe49-7166-493b-98ba-0965987ff3ad);
		//END_REGION
	}
	EXIT
	{
	}
}
