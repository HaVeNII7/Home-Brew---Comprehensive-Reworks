		DB_CompanionOnlyFaction((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, (FACTION)Companion10_fd96559f-010a-6e27-8689-eb29795ff2af);
		
		DB_OriginInPartyDialog((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, (DIALOGRESOURCE)Halsin_InParty_890c2586-6b71-ca01-5bd6-19d533181c71);
		DB_OriginWarning1Dialog((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323,(DIALOGRESOURCE)Halsin_Warning1_5a6a42b5-dcaa-ee2b-7945-dba9bc4e4391);
		DB_OriginWarning2Dialog((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323,(DIALOGRESOURCE)Halsin_Warning2_b5443985-c6c4-3458-513c-b2ecade53b1a);
		DB_OriginLeavingDialog((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323,(DIALOGRESOURCE)Halsin_Leaving_2d76a999-2606-8877-f2b9-3ebbd692223d);
		
		DB_Inclusion_Object((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323,(FLAG)GLO_Inclusion_Halsin_cb187bc3-5018-4cfb-9945-37b0049ccb38,(FLAG)GLO_Inclusion_End_Halsin_850913aa-be71-417d-9ffb-d7d68d5a6f9d);
		
		DB_Debug_CharacterAddFlags((FLAG)Debug_AddHalsin_b9bdd9da-d2c8-4b36-aa74-c26461945691, (CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, (FLAG)Debug_HalsinIsPlayer_81cc366c-d171-4651-9195-8c22e54b6c26);
		DB_Debug_CharacterRemoveHideFlags((FLAG)Debug_RemoveHideHalsin_39cd2247-d138-4afb-ab2c-9d67bf5d951a, (CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		
		DB_CompanionCanPartner((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323,(FLAG)NULL_00000000-0000-0000-0000-000000000000, (FLAG)ORI_State_PartneredWithHalsin_7b53fe60-bb16-48a9-ae5c-9bce1dfac1a9, (FLAG)ORI_State_WasPartneredWithHalsin_ee6b727d-243e-4189-b572-1d782ea78df8, (FLAG)ORI_State_HandledBreakupWithHalsin_1268efe2-38d9-44e8-b83c-e78435344400, NULL_00000000-0000-0000-0000-000000000000, "datehalsin");
		DB_CompanionIsDating((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, (FLAG)ORI_State_HalsinIsDating_bacec26a-b4b9-40c3-825f-cc1fc2c7e5a9);
		//END_REGION
		
		//REGION Romance support DB
		DB_GLO_Halsin_RomanceFlags(CAMP_Halsin2_Event_FlirtedWitHalsinInSCL_1521059b-2dfb-12da-7b9a-bd1cd968670c);
		DB_GLO_Halsin_RomanceFlags(CAMP_Halsin2_Event_FlirtedWithHalsinInWLDMainA_a0373d03-25c1-bb02-a71f-f0844193153e);
		DB_GLO_Halsin_RomanceFlags(SCE_Halsin_Event_FlirtHint_1bcf3ae2-f377-4b37-7e97-a21e53c6e165);
		//END_REGION
		
		//REGION InParty Support Db
		DB_GLO_Halsin_GotToKnowFlags((FLAG)Halsin_InParty_Event_AskedForSurpriseInfo_4b4a7d6b-5904-cdb3-c64e-fe9fc624cff6);
		DB_GLO_Halsin_GotToKnowFlags((FLAG)Halsin_InParty_Event_AskedAboutHeight_4a720fef-c45f-47d4-aa42-519ecbaafd04);
		DB_GLO_Halsin_GotToKnowFlags((FLAG)ORI_Halsin_Event_AskedAboutBecomingDruid_e0daf50b-bf8c-49cc-9b62-22c39887ac22);
		
		
		//END_REGION
		
		PROC_GLO_DifficultyModes_AddHPBoostedEntity(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
	}
	KB
	{
		//REGION Move to Camp
		PROC
		PROC_GLO_PartyMembers_AddHook((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323,(CHARACTER)_Player)
		AND
		QRY_OnlyOnce("RecruitedFirstTime_Halsin")
		THEN
		PROC_GlobalSetFlagAndCache(GLO_LiftingTheCurse_State_HalsinRecruitable_2c8b6be0-558d-485c-b4f2-93ec1926a2fa);
		PROC_ORI_SetupCamp((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 0);
		SetFaction(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, (FACTION)Companion10_fd96559f-010a-6e27-8689-eb29795ff2af);
		SetFlag((FLAG)Companion_Halsin_HasMet_5612976e-dab8-4001-9734-ab309e657093, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		
		IF
		DialogEnded(CAMP_GoblinHuntCelebration_SCO_HalsinMorningAfter_3c5a0a46-7927-6692-d353-fc8270b47631, _)
		AND
		QRY_OnlyOnce("HalsinJoinsCamp")
		THEN
		PROC_ORI_SetupCamp((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1);
		
		IF
		DialogEnded((DIALOGRESOURCE)CAMP_HalsinsReturn_CFM_720f387b-ca6e-b3be-4176-bceb7512d172, _)
		AND
		QRY_OnlyOnce("HalsinJoinsCamp")
		THEN
		PROC_ORI_SetupCamp((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1);
		
		IF
		TextEvent("halsin2camp")
		THEN
		PROC_ORI_SetupCamp((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1);
		
		IF
		EntityEvent((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323,"DebugTeleportedToCamp")
		THEN
		PROC_ORI_SetupCamp((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1);
		
		
		//Prevent Halsin from getting his InParty assigned before he is recruitable
		IF
		DB_Dialogs(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, Halsin_InParty_890c2586-6b71-ca01-5bd6-19d533181c71)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_LiftingTheCurse_State_HalsinRecruitable_2c8b6be0-558d-485c-b4f2-93ec1926a2fa)
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		DB_Dialogs(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, CAMP_Halsin2_c0ab0f6f-3ffc-d06d-0d6d-d1aaef70dfe4);
		
		//Fix Faction
		PROC
		PROC_GLO_PartyMembers_AddHook((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323,(CHARACTER)_Player)
		THEN
		SetFaction(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, (FACTION)Companion10_fd96559f-010a-6e27-8689-eb29795ff2af);
		
		//END_REGION
		
		//REGION Open Relationship Stuff
		IF
		FlagSet((FLAG)ORI_State_PartneredWithHalsinSecondary_6af0be74-d032-4a20-876a-11bab5f86db2,_Avatar,_)
		THEN
		DB_ORI_Partnered_Secondary((CHARACTER)_Avatar,(CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		
		IF
		FlagCleared((FLAG)ORI_State_PartneredWithHalsinSecondary_6af0be74-d032-4a20-876a-11bab5f86db2,_Avatar,_)
		THEN
		NOT DB_ORI_Partnered_Secondary((CHARACTER)_Avatar,(CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		
		QRY
		QRY_CampNight_MeetsRequirements_Partner((FLAG)_NightFlag)
		AND
		DB_CampNight_Requirement_Partner((FLAG)_NightFlag, (CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		AND
		DB_ORI_Partnered_Secondary(_Avatar,(CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		AND
		DB_InCamp(_Avatar)
		AND
		NOT QRY_PreventMPDialogue((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, _Avatar)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_CampNight_QueueSleepMoment((FLAG)_NightFlag)
		AND
		NOT DB_Camp_QueuedSCO(_)
		AND
		NOT DB_Camp_QueuedAvatarDream(_)
		AND
		NOT DB_Camp_QueuedSoloDream(_,_)
		AND
		NOT DB_Camp_QueuedRomanceNight(_,_,_)
		AND
		DB_CampNight_RomanceNight((FLAG)_NightFlag,(CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323,(DIALOGRESOURCE)_RomanceNight,(FLAG)NULL_00000000-0000-0000-0000-000000000000)
		AND
		DB_ORI_Partnered_Secondary(_Avatar,(CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		THEN
		DB_Camp_QueuedRomanceNight((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323,_RomanceNight,_Avatar);
		
		QRY
		QRY_Debugbook_GetPartnerString((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		AND
		DB_ORI_Partnered_Secondary(_Avatar,(CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		AND
		GetDisplayName(_Avatar,_TranslatedStringKey)
		AND
		ResolveTranslatedString(_TranslatedStringKey,_AvatarName)
		THEN
		DB_QRYRTN_Debugbook_GetPartnerString(_AvatarName);
		
		PROC
		PROC_DebugBook_Event("StopRelationship",(CHARACTER)_Player)
		AND
		DB_DebugBook_LastSelectedCompanion((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		AND
		DB_ORI_Partnered_Secondary(_Avatar,(CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		THEN
		NOT DB_ORI_Partnered_Secondary(_Avatar,(CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		
		IF
		FlagSet(_RomanceFlag, _Avatar, _)
		AND
		DB_Avatars((CHARACTER)_Avatar)
		AND
		DB_GLO_Halsin_RomanceFlags(_RomanceFlag)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)GLO_Halsin_State_FlirtedWithPlayer_7ddc1485-8f29-4116-878b-a875649c5eaf);
		//END_REGION
		
		//REGION InParty Flagging Management
		IF
		FlagSet(_Flag, _Player, _)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		DB_GLO_Halsin_GotToKnowFlags(_Flag)
		AND
		DB_GlobalFlag(Halsin_InParty_Event_CommentedOnDeadFamily_747a5458-3893-4462-8f64-db9e225f882c)
		AND
		NOT QRY_GLO_Halsin_HasAllHalsinFlags(_Player)
		THEN
		SetFlag(ORI_Halsin_Event_GotToKnowHalsinProperly_a55ebe8b-065a-40c0-bcdf-63265cf74f7c, _Player, 0);
		
		//Checking that they have no flag NOT set
		QRY
		QRY_GLO_Halsin_HasAllHalsinFlags((GUIDSTRING)_Player)
		AND
		DB_GLO_Halsin_GotToKnowFlags(_Flag)
		AND
		GetFlag(_Flag, _Player, 0)
		THEN
		DB_NOOP(1);
		
		
		//Making sure Halsin doesn't tell us to meet him in camp after saving Thaniel when we are already in camp
		IF
		TeleportedToCamp(_Avatar)
		AND
		DB_Avatars(_Avatar)
		AND
		DB_PartOfTheTeam(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		AND
		DB_GlobalFlag(GLO_LiftingTheCurse_State_BreathHasBeenRestored_2113b54e-a140-4aa0-97ac-219fa7b7d038)
		AND
		NOT DB_GlobalFlag(SCl_LiftingTheCurse_State_HalsinToldUsToCheckThaniel_59599ff4-7e95-441e-ad20-52c47d29f425)
		THEN
		PROC_GlobalSetFlagAndCache(SCl_LiftingTheCurse_State_HalsinToldUsToCheckThaniel_59599ff4-7e95-441e-ad20-52c47d29f425);
		
		//Managing the flag to ask Halsin how he is faring in camp
		PROC
		PROC_LongRest()
		AND
		DB_GlobalFlag(CAMP_Halsin_Event_AskedFaringToday_2d5403b3-1368-4264-9419-66d9df33a7da)
		THEN
		PROC_GlobalClearFlagAndCache(CAMP_Halsin_Event_AskedFaringToday_2d5403b3-1368-4264-9419-66d9df33a7da);
		//END_REGION
		
		//REGION InParty Kiss Flag management
		IF
		DialogEnded(Halsin_InParty_890c2586-6b71-ca01-5bd6-19d533181c71, _ID)
		AND
		GetFlag((FLAG)ORI_Halsin_State_KissedOnceThisDialog_bf82162b-e99e-46ae-a1c6-86053c1ceb5e, S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1)
		THEN
		ClearFlag(ORI_Halsin_State_KissedOnceThisDialog_bf82162b-e99e-46ae-a1c6-86053c1ceb5e, S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, _ID, 0);
		//END_REGION
		
		//REGION Misc Debug
		
		//Makes sure Halsin has correct dialog in SCL_Camp after using Debug book
		QRY
		QRY_SelectCustomDialog(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, _Player)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		DB_ActiveLevel("SCL_Main_A")
		AND
		DB_GlobalFlag((FLAG)Debug_Act2Setup_State_BarcusRecruited_b7a697e4-265c-00b2-f6d1-818d0bdd5074)
		AND
		QRY_OnlyOnce("HalsinDebugDialogAct2Camp")
		THEN
		DB_SelectedDialog(CAMP_Halsin2_c0ab0f6f-3ffc-d06d-0d6d-d1aaef70dfe4, S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, _Player);
		
		IF
		DialogEnded(CAMP_Halsin2_c0ab0f6f-3ffc-d06d-0d6d-d1aaef70dfe4, _)
		AND
		DB_GlobalFlag((FLAG)Debug_Act2Setup_State_BarcusRecruited_b7a697e4-265c-00b2-f6d1-818d0bdd5074)
		AND
		DB_OnlyOnce("HalsinDebugDialogAct2Camp")
		AND
		QRY_OnlyOnce("HalsinDebugSetCamp2Dialog")
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		DB_Dialogs(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, CAMP_Halsin2_c0ab0f6f-3ffc-d06d-0d6d-d1aaef70dfe4);
		
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(758).Title("GLO_Companion_Jaheira");
Goal(758)
{
	INIT
	{
		//REGION Player Init Block
		//DB_Origins((CHARACTER)S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a);
		DB_OriginNPCAlignment((CHARACTER)S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a,(FACTION)GLO_Jaheira_e7dfda4a-9696-4aa1-9abc-9a350a797ed6);
		DB_OriginCampFlags((CHARACTER)S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a,(FLAG)JAHEIRA_8b7fd8c6-4d49-4932-b525-7dda10cf4a1b,(FLAG)JAHEIRAAVATAR_b8cb0de2-c543-4e3f-8270-7fe1c06b7a53,(FLAG)JAHEIRACOMPANION_cb886250-baf1-437e-b9de-ae97824a0e15,(FLAG)JAHEIRAPARTY_eb34cb38-9394-41bc-9ab3-15f5f32f60d3,(FLAG)JAHEIRACAMP_ec198187-5cf8-4c02-831c-3afc919ca2c4);
