		DB_Debug_GoldenPath_Step(S_Debug_GoldenPath_Step2_1dc2cb90-636b-4db4-9d5f-adcacfaaba67,S_CHA_OUTSIDE_Entrance_TeleportTrigger_522835a8-d9d8-45aa-ba08-fcd06be3fadf,2);
