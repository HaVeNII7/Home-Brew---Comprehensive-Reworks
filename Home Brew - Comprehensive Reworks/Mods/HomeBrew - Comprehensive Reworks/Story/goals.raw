		DB_GiveTemplateFromNpcToPlayerDialogEvent(
			(ITEMROOT)UNI_WYR_SharessCaress_PotentDrink_14a43b9d-0913-4a24-8f19-a2db6e87bc36,
			(FLAG)WYR_SharessCaress_Bartender_Event_GiveDrink_8701328a-8ec1-4574-6943-0ba7044649c9,
			(FLAG)NULL_00000000-0000-0000-0000-000000000000, 1);
		DB_ItemOwnerShipTriggers("BGO_Main_A", S_WYR_SharessCaress_BarShopOwnershipArea_10b14d6c-9e2b-4277-8e51-c3823d57ca88, S_WYR_SharessCaress_Bartender_ab24945c-268d-4f90-b8ea-bbb11cd50157);
