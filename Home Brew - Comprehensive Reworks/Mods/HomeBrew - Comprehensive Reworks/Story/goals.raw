		AND
		GetHostCharacter(_Char)
		THEN
		DebugText(_Char, "BTDuelStatusApply");
		PROC_LOW_BhaalTemple_Duel_DarkUrgeFaction_Apply();
		
		IF
		TextEvent("BTDuelStatusRemove")
		AND
