		THEN
		SetWeaponUnsheathed((CHARACTER)_Baneite, 1, 1);
		
		
		PROC
		PROC_LOW_SteelWatchFoundry_SetUpAfterIRN()
		AND
		DB_LOW_Gondians(_Gondian)
		THEN
		SetWeaponUnsheathed((CHARACTER)_Gondian, 1, 1);
