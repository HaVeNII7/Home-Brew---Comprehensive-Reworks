	KB
	{
		IF
		LevelLoaded("CTY_Main_A")
		THEN
		SetFlag((FLAG)CURRENTREGION_CTY_Main_A_d523976f-a39b-4d33-b6cb-f58b705a0396,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_GlobalSetFlagAndCache((FLAG)VISITEDREGION_CTY_Main_A_ce5346f4-c176-43ea-8da0-2067450e26ac);
		
		IF
		LevelUnloading("CTY_Main_A")
		THEN
		ClearFlag((FLAG)CURRENTREGION_CTY_Main_A_d523976f-a39b-4d33-b6cb-f58b705a0396,NULL_00000000-0000-0000-0000-000000000000,0);
		
		PROC
		PROC_GLO_Origins_SetupRecruitment("CTY_Main_A")
		AND
		DB_PartOfTheTeam((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		THEN
		DB_Camp_PersonalCornerLevelTemplate("ELFSONG",(CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, (LEVELTEMPLATE)CMP_Bed_Halsin_A_000_82a62c9b-af8d-4bf8-b8c1-c85a9f5565a7,(LEVELTEMPLATE)LT_CMP_BedElfsong_Unmade_A_MintharaHalsin_a621a4d0-54ff-4ab3-bc0b-b64c2c149a0e);
		
		PROC
		PROC_GLO_Origins_SetupRecruitment("CTY_Main_A")
		AND
		DB_PartOfTheTeam((CHARACTER)S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b)
		THEN
		DB_Camp_PersonalCornerLevelTemplate("ELFSONG",(CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, (LEVELTEMPLATE)CMP_Bed_Halsin_A_000_82a62c9b-af8d-4bf8-b8c1-c85a9f5565a7,(LEVELTEMPLATE)LT_CMP_BedElfsong_Unmade_A_MintharaHalsin_a621a4d0-54ff-4ab3-bc0b-b64c2c149a0e);
		
		PROC
		PROC_GLO_Origins_SetupRecruitment("CTY_Main_A")
		AND
		NOT DB_PartOfTheTeam((CHARACTER)S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b)
		AND
		NOT DB_PartOfTheTeam((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		THEN
		PROC_CacheLoadLevelTemplate((LEVELTEMPLATE)LT_CMP_BedElfsong_Unmade_A_MintharaHalsin_a621a4d0-54ff-4ab3-bc0b-b64c2c149a0e);
		
		//REGION Elfsong tavern payed state
		IF
		FlagSet((FLAG)CAMP_Elfsong_PaymentDone_fd063151-f443-4b87-80bf-6a9441b2b4d7, _, _)
		AND
		DB_Camp("SLUMS", _, _CampArea, _)
		AND
		QRY_TriggerEvents_AnyPartyMemberInTrigger(_CampArea)
		THEN
		DB_LOW_Elfsong_ReadyToChangeCamp(_CampArea);
		
		IF
		FlagSet((FLAG)CAMP_Elfsong_PaymentDone_fd063151-f443-4b87-80bf-6a9441b2b4d7, _, _)
		AND
		DB_Camp("SLUMS", _, _CampArea, _)
		AND
		NOT QRY_TriggerEvents_AnyPartyMemberInTrigger(_CampArea)
		THEN
		DeclutterArea(_CampArea,0,1);
		NOT DB_MainCamp("CTY_Main_A","SLUMS");
		DB_MainCamp("CTY_Main_A","ELFSONG");
		
		//Improvement to avoid having two characters in two different camps (if one character are still at Slums while other is buying elfsong.)
		IF
		TeleportedFromCamp(_Player)
		AND
		DB_CurrentLevel("CTY_Main_A")
		AND
		DB_LOW_Elfsong_ReadyToChangeCamp(_CampArea)
		AND
		NOT QRY_TriggerEvents_AnyPartyMemberInTrigger(_CampArea)
		THEN
		DeclutterArea(_CampArea,0,1);
		NOT DB_LOW_Elfsong_ReadyToChangeCamp(_CampArea);
		NOT DB_MainCamp("CTY_Main_A","SLUMS");
		DB_MainCamp("CTY_Main_A","ELFSONG");
		
		IF
		DB_GlobalFlag(CAMP_Elfsong_PaymentDone_fd063151-f443-4b87-80bf-6a9441b2b4d7)
		AND
		DB_CAMP_Elfsong_WaypointDoors(_Door, _Name)
		THEN
		SetStoryDisplayName(_Door, _Name);
		
		IF
		UseFinished(_Character, _DoorToFromCamp, 1)
		AND
		DB_CAMP_Elfsong_WaypointDoors(_DoorToFromCamp, _)
		AND
		DB_Players(_Character)
		AND
		NOT DB_Is_InCombat(_Character, _)
		AND
		DB_GlobalFlag((FLAG)CAMP_Elfsong_PaymentDone_fd063151-f443-4b87-80bf-6a9441b2b4d7)
		THEN
		PROC_TeleportToFromCamp(_Character);
		
		IF
		UseFinished(_Character, _DoorToFromCamp, 1)
		AND
		DB_CAMP_Elfsong_WaypointDoors(_DoorToFromCamp, _)
		AND
		DB_Players(_Character)
		AND
		DB_Is_InCombat(_Character, _)
		THEN
		PROC_PlayCantUseItemAD(_Character);
		
		IF
		UseStarted(_Character, _DoorToFromCamp)
		AND
		DB_CAMP_Elfsong_WaypointDoors(_DoorToFromCamp, _)
		AND
		DB_Players(_Character)
		AND
		NOT DB_DialogName((DIALOGRESOURCE)LOW_Elfsong_PAD_TryGoCamp_fba15873-d1b3-e52d-17eb-efd8db7f6b50, _)
		AND
		NOT DB_GlobalFlag((FLAG)CAMP_Elfsong_PaymentDone_fd063151-f443-4b87-80bf-6a9441b2b4d7)
		THEN
		PROC_TryStartAD(LOW_Elfsong_PAD_TryGoCamp_fba15873-d1b3-e52d-17eb-efd8db7f6b50, _Character);
		
		IF
		UseFinished(_Player, S_CAMP_Dumbwaiter_3ac8035f-543a-46b5-90ea-9afc4f35d374, 1)
		AND
		NOT QRY_StartDialog_Fixed((DIALOGRESOURCE)CAMP_Elfsong_Dumbwaiter_e9db2d0b-983f-9efa-1708-648289b4d52f, S_CAMP_Dumbwaiter_3ac8035f-543a-46b5-90ea-9afc4f35d374, _Player)
		THEN
		PROC_PlayCantUseItemAD(_Player);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)CAMP_Elfsong_Dumbwaiter_e9db2d0b-983f-9efa-1708-648289b4d52f, _ID)
		THEN
		PROC_DialogAddSpeakingActor(_ID, S_LOW_Elfsong_Camp_InvisibleDumbwaiter_1d74e772-f38f-44ea-84a3-00186f84acee);
		
		IF
		MovedFromTo(_Supply, S_LOW_Elfsong_Camp_InvisibleDumbwaiter_1d74e772-f38f-44ea-84a3-00186f84acee, _Player, 1)
		AND
		DB_Players((CHARACTER)_Player)
		THEN
		SetFlag(CAMP_Act3_Dumbwaiter_State_AlreadyBuySuppliesToday_69516163-8164-40a3-ab68-ab4c0ba89f6d);
		
		PROC
		PROC_LongRest()
		AND
		DB_GlobalFlag(CAMP_Act3_Dumbwaiter_State_AlreadyBuySuppliesToday_69516163-8164-40a3-ab68-ab4c0ba89f6d)
		THEN
		ClearFlag(CAMP_Act3_Dumbwaiter_State_AlreadyBuySuppliesToday_69516163-8164-40a3-ab68-ab4c0ba89f6d);
		
		//END_REGION
		
		IF
		TextEvent("SetElfsongCamp")
		AND
		GetHostCharacter(_Player)
		THEN
		SetFlag((FLAG)CAMP_Elfsong_PaymentDone_fd063151-f443-4b87-80bf-6a9441b2b4d7);
		DebugText(_Player, "Elfsong flag setted");
		
		//REGION Camp Night Definitions - Karlach
		IF
		DB_CantTalk(S_LOW_Bartender_626fc1ed-c1ff-4dcd-a986-068a12cb7974)
		AND
		DB_CantTalk(S_LOW_Bartender_RomanceSceneBackup_d3e6a655-b69d-4db7-9b59-dc0a9cdbfc26)
		THEN
		ClearFlag((FLAG)CAMP_Karlach_State_AnyBartenderAvailable_63cdf812-c71e-4acb-b161-5893c912a0c2, NULL_00000000-0000-0000-0000-000000000000);
		
		PROC
		PROC_StateCleared_CantTalk(S_LOW_Bartender_626fc1ed-c1ff-4dcd-a986-068a12cb7974)
		AND
		NOT DB_GlobalFlag((FLAG)CAMP_Karlach_State_AnyBartenderAvailable_63cdf812-c71e-4acb-b161-5893c912a0c2)
		THEN
		SetFlag((FLAG)CAMP_Karlach_State_AnyBartenderAvailable_63cdf812-c71e-4acb-b161-5893c912a0c2, NULL_00000000-0000-0000-0000-000000000000);
		
		PROC
		PROC_StateCleared_CantTalk(S_LOW_Bartender_RomanceSceneBackup_d3e6a655-b69d-4db7-9b59-dc0a9cdbfc26)
		AND
		NOT DB_GlobalFlag((FLAG)CAMP_Karlach_State_AnyBartenderAvailable_63cdf812-c71e-4acb-b161-5893c912a0c2)
		THEN
		SetFlag((FLAG)CAMP_Karlach_State_AnyBartenderAvailable_63cdf812-c71e-4acb-b161-5893c912a0c2, NULL_00000000-0000-0000-0000-000000000000);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)CAMP_Karlach_CRD_ROM_Date_2bf0d0c0-495c-6866-d5ad-d37dd4fa3648, _DialogID)
		THEN
		NOT DB_OnlyOnce("CAMP_ANightAtTheTown_BartenderAdded");
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)CAMP_Karlach_CRD_ROM_Date_2bf0d0c0-495c-6866-d5ad-d37dd4fa3648, _DialogID)
		AND
		NOT DB_CantTalk(S_LOW_Bartender_626fc1ed-c1ff-4dcd-a986-068a12cb7974)
		AND
		QRY_OnlyOnce("CAMP_ANightAtTheTown_BartenderAdded")
		THEN
		PROC_DialogAddSpeakingActor(_DialogID, S_LOW_Bartender_626fc1ed-c1ff-4dcd-a986-068a12cb7974);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)CAMP_Karlach_CRD_ROM_Date_2bf0d0c0-495c-6866-d5ad-d37dd4fa3648, _DialogID)
		AND
		DB_CantTalk(S_LOW_Bartender_626fc1ed-c1ff-4dcd-a986-068a12cb7974)
		AND
		NOT DB_CantTalk(S_LOW_Bartender_RomanceSceneBackup_d3e6a655-b69d-4db7-9b59-dc0a9cdbfc26)
		AND
		QRY_OnlyOnce("CAMP_ANightAtTheTown_BartenderAdded")
		THEN
		PROC_DialogAddSpeakingActor(_DialogID, S_LOW_Bartender_RomanceSceneBackup_d3e6a655-b69d-4db7-9b59-dc0a9cdbfc26);
		
		IF
		DialogEnded((DIALOGRESOURCE)CAMP_Karlach_CRD_ROM_Date_2bf0d0c0-495c-6866-d5ad-d37dd4fa3648, _DialogID)
		AND
		DB_DialogPlayers(_DialogID, _Avatar, 2)
		AND
		GetFlag((FLAG)ORI_Karlach_State_WentToDate_b30f31df-474f-15f3-9bfb-1fc2983c846a, _Avatar, 1)
		THEN
		PROC_ORI_KarlachDate_TryReplaceBartender();
		
		// Repeat date dialog till they go to the restaurant if agreed and in camp.
		QRY
		QRY_SelectCustomDialog_AfterGenerics(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _Avatar)
		AND
		DB_InCamp((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		DB_Camp_NightMode(1)
		AND
		DB_Players((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		DB_ORI_Partnered((CHARACTER)_Avatar, (CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		DB_GlobalFlag((FLAG)CAMP_Karlach_State_AnyBartenderAvailable_63cdf812-c71e-4acb-b161-5893c912a0c2)
		AND
		GetFlag((FLAG)ORI_Karlach_Event_AgreedGoingOnADate_0f767a0e-ee52-cbea-3082-c990837741d1, _Avatar, 1)
		AND
		GetFlag((FLAG)ORI_Karlach_State_WentToDate_b30f31df-474f-15f3-9bfb-1fc2983c846a, _Avatar, 0)
		AND
		QRY_CAMP_Karlach_ValidAct3RomanceCamp()
		THEN
		DB_SelectedDialog((DIALOGRESOURCE)CAMP_Karlach_CRD_ROM_Date_2bf0d0c0-495c-6866-d5ad-d37dd4fa3648, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _Avatar);
		
		QRY
		QRY_CAMP_Karlach_ValidAct3RomanceCamp()
		AND
		DB_ActiveCamp("SLUMS")
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_CAMP_Karlach_ValidAct3RomanceCamp()
		AND
		DB_ActiveCamp("ELFSONG")
		THEN
		DB_NOOP(1);
		
		//END_REGION Camp Night Definitions - Karlach
	}
	EXIT
	{
	}
}
