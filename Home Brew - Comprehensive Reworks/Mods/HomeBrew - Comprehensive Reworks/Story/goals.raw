	}
	KB
	{
		IF
		DB_LevelLoadedOnce("SCL_Main_A")
		AND
		NOT DB_SCL_MizoraSetupDone(_)
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		THEN
		PROC_TriggerRegisterForPlayers((TRIGGER)S_TWN_Cambion_MizoraCaptureTrigger_9a23baa5-4f9a-4fd1-bddc-ef393d115944);
		SetOnStage(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a, 1);
		DB_SCL_MizoraSetupDone(1);
		
		IF
		LevelLoaded("SCL_Main_A")
		AND
		QRY_COL_MizorasRescue_CheckTeleportMizoraToSCL()
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_COL_MizorasRescue_CheckTeleportMizoraToSCL()
		AND
		NOT DB_PermaDefeated(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a)
		AND
		NOT DB_GlobalFlag(COL_MizorasRescue_State_SavedMizora_148bcec2-5367-2b72-3c93-29fb32fc0181)
		AND
		NOT GetRegion(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a,"SCL_Main_A")
		THEN
		TeleportTo(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a,(TRIGGER)S_COL_Wyll_CambionPoint_b6251e73-d6a6-4d5f-9afd-40f1fb06f6a9,"GLO_Wyll_Cambion_TeleportedToCOL");
		
		//Redo capture setup if Mizora left SCL_Main_A
		IF
		EntityEvent(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a,"GLO_Wyll_Cambion_TeleportedToCOL")
		AND
		DB_COL_Mizora_CaptureSetupDone(1)
		THEN
		PROC_COL_Mizora_CaptureSetup();
		PROC_COL_Mizora_CaptureSetup_DefineDialog();
		
		PROC
		PROC_CampfireMoment_PreDialog((DIALOGRESOURCE)CAMP_MizorasJudgement_CFM_a5324441-1d70-43a9-d4e5-45b960823d54)
		AND
		DB_CurrentLevel("SCL_Main_A")
		THEN
		PROC_Camp_TeleportToCamp((CHARACTER)S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a,(TRIGGER)S_CAMP_SCL_Wyll_Cambion_Pos_c92645d0-217d-4248-91d6-95344e107dec);
		
		
		//REGION Mizora's Capture
		IF
		EnteredTrigger(_Player,(TRIGGER)S_TWN_Cambion_MizoraCaptureTrigger_9a23baa5-4f9a-4fd1-bddc-ef393d115944)
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		AND
		NOT DB_GlobalFlag((FLAG)TWN_Wyll_State_MizorasCaptureHappened_80cb617e-e3c3-3386-3919-6caef51bfd5d)
		AND
		DB_Players(_Player)
		AND
		QRY_StartDialog((DIALOGRESOURCE)TWN_MizorasCapture_ee05c8c2-3420-53f5-5ac5-e960a044f1c1,S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a,_Player)
		THEN
		PROC_TriggerUnregisterForPlayers((TRIGGER)S_TWN_Cambion_MizoraCaptureTrigger_9a23baa5-4f9a-4fd1-bddc-ef393d115944);
		
		IF
		DialogStarted((DIALOGRESOURCE)TWN_MizorasCapture_OM_Wyll_AOM_OOM_c0f3ae1e-670b-83bf-46bc-598b6ff50d29,_)
		THEN
		PROC_TriggerUnregisterForPlayers((TRIGGER)S_TWN_Cambion_MizoraCaptureTrigger_9a23baa5-4f9a-4fd1-bddc-ef393d115944);
		
		IF
		DialogStarted((DIALOGRESOURCE)TWN_MizorasCapture_OM_Wyll_COM_AOM_OOM_7d7fdf2d-7f48-b140-eb03-bb2e351c0bd0,_)
		THEN
		PROC_TriggerUnregisterForPlayers((TRIGGER)S_TWN_Cambion_MizoraCaptureTrigger_9a23baa5-4f9a-4fd1-bddc-ef393d115944);
		
		QRY
		QRY_OriginMoment_PreventRelaunchDialog(TWN_MizorasCapture_OM_Wyll_AOM_OOM_c0f3ae1e-670b-83bf-46bc-598b6ff50d29,_,_)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_OriginMoment_PreventRelaunchDialog(TWN_MizorasCapture_OM_Wyll_COM_AOM_OOM_7d7fdf2d-7f48-b140-eb03-bb2e351c0bd0,_,_)
		THEN
		DB_NOOP(1);
		
		IF
		FlagSet((FLAG)NIGHT_Wyll_MizorasCapture_3279549a-c467-4630-bd6d-a2aafeb8a2b9,_,_)
		THEN
		PROC_TriggerUnregisterForPlayers((TRIGGER)S_TWN_Cambion_MizoraCaptureTrigger_9a23baa5-4f9a-4fd1-bddc-ef393d115944);
		PROC_ClearOriginMoment((DIALOGRESOURCE)TWN_MizorasCapture_OM_Wyll_COM_AOM_OOM_7d7fdf2d-7f48-b140-eb03-bb2e351c0bd0);
		
		IF
		DB_GlobalFlag((FLAG)WYLLAVATAR_b0d1be97-c501-4a9d-8718-e473210a4694)
		AND
		DB_CampNight_CFM((FLAG)NIGHT_Wyll_MizorasCapture_3279549a-c467-4630-bd6d-a2aafeb8a2b9,(DIALOGRESOURCE)TWN_MizorasCapture_OM_Wyll_COM_AOM_OOM_7d7fdf2d-7f48-b140-eb03-bb2e351c0bd0)
		THEN
		NOT DB_CampfireMoment_FixedSpeakers((DIALOGRESOURCE)TWN_MizorasCapture_OM_Wyll_COM_AOM_OOM_7d7fdf2d-7f48-b140-eb03-bb2e351c0bd0,(GUIDSTRING)S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a,(GUIDSTRING)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d);
		DB_CampfireMoment_FixedSpeakers((DIALOGRESOURCE)TWN_MizorasCapture_OM_Wyll_AOM_OOM_c0f3ae1e-670b-83bf-46bc-598b6ff50d29,(GUIDSTRING)S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a);
		DB_CampfireMoment_FixedPlayer((DIALOGRESOURCE)TWN_MizorasCapture_OM_Wyll_AOM_OOM_c0f3ae1e-670b-83bf-46bc-598b6ff50d29, (GUIDSTRING)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d);
		NOT DB_CampNight_CFM((FLAG)NIGHT_Wyll_MizorasCapture_3279549a-c467-4630-bd6d-a2aafeb8a2b9,(DIALOGRESOURCE)TWN_MizorasCapture_OM_Wyll_COM_AOM_OOM_7d7fdf2d-7f48-b140-eb03-bb2e351c0bd0);
		DB_CampNight_CFM((FLAG)NIGHT_Wyll_MizorasCapture_3279549a-c467-4630-bd6d-a2aafeb8a2b9,(DIALOGRESOURCE)TWN_MizorasCapture_OM_Wyll_AOM_OOM_c0f3ae1e-670b-83bf-46bc-598b6ff50d29);
		
		//END_REGION
		
		//REGION Mizora's Rescue
		IF
		DB_InRegion(_Player,(TRIGGER)S_COL_Colony_SUB_c72269e5-0719-4379-a8ea-ca2ca199d0a3)
		AND
		NOT DB_COL_Mizora_CaptureSetupDone(_) 
		AND
		NOT DB_OffStage(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a)
		THEN
		PROC_COL_Mizora_CaptureSetup();
		PROC_COL_Mizora_CaptureSetup_DefineDialog();
		
		IF
		FlagSet((FLAG)TWN_Wyll_State_MizorasCaptureHappened_80cb617e-e3c3-3386-3919-6caef51bfd5d,_,_)
		AND
		NOT DB_COL_Mizora_CaptureSetupDone(_)
		THEN
		PROC_COL_Mizora_CaptureSetup();
		PROC_COL_Mizora_CaptureSetup_DefineDialog();
		
		PROC
		PROC_COL_Mizora_CaptureSetup_DefineDialog()
		THEN
		PROC_DefineSingleOriginMoment(COL_MizorasRescue_95b38e68-b094-9e46-11df-cd0d3bf7a702,(TAG)REALLY_WYLL_5f40def5-d3ec-4698-a367-01a339888956,
									(DIALOGRESOURCE)COL_MizorasRescue_OM_Wyll_COM_AOM_OOM_a988e571-00eb-904b-f8f5-0d767dd1aacb,
									(DIALOGRESOURCE)COL_MizorasRescue_OM_Wyll_COM_AOM_OOM_a988e571-00eb-904b-f8f5-0d767dd1aacb,
									(DIALOGRESOURCE)COL_MizorasRescue_OM_Wyll_COM_AOM_OOM_a988e571-00eb-904b-f8f5-0d767dd1aacb);
		DB_OriginMoment_ExtraNPCs((DIALOGRESOURCE)COL_MizorasRescue_OM_Wyll_COM_AOM_OOM_a988e571-00eb-904b-f8f5-0d767dd1aacb,S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a);
		DB_OriginMoment_DontAutoClearOriginMoment(COL_MizorasRescue_OM_Wyll_COM_AOM_OOM_a988e571-00eb-904b-f8f5-0d767dd1aacb);
		PROC_DefineSingleOriginMoment(COL_WyllDeath_cc3747c9-7160-cb21-fb1b-a578192d2c3b,(TAG)REALLY_WYLL_5f40def5-d3ec-4698-a367-01a339888956,
									(DIALOGRESOURCE)COL_WyllDeath_OM_Wyll_AOM_OOM_12fe2f75-7cd5-7d19-f8e6-f4a86e85e5c0,
									(DIALOGRESOURCE)COL_WyllDeath_OM_Wyll_COM_1d2754b8-4192-c015-939e-eef0aed9dfce,
									(DIALOGRESOURCE)COL_WyllDeath_OM_Wyll_AOM_OOM_12fe2f75-7cd5-7d19-f8e6-f4a86e85e5c0);
		DB_OriginMoment_MaxDistance((DIALOGRESOURCE)COL_WyllDeath_OM_Wyll_AOM_OOM_12fe2f75-7cd5-7d19-f8e6-f4a86e85e5c0,200.0);
		DB_OriginMoment_MaxDistance((DIALOGRESOURCE)COL_WyllDeath_OM_Wyll_COM_1d2754b8-4192-c015-939e-eef0aed9dfce,200.0);
		DB_OriginMoment_ExtraNPCs((DIALOGRESOURCE)COL_WyllDeath_OM_Wyll_AOM_OOM_12fe2f75-7cd5-7d19-f8e6-f4a86e85e5c0,S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a);
		DB_OriginMoment_ExtraNPCs((DIALOGRESOURCE)COL_WyllDeath_OM_Wyll_COM_1d2754b8-4192-c015-939e-eef0aed9dfce,S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a);
		
		QRY
		QRY_OriginMoment_PreventRelaunchDialog(COL_MizorasRescue_OM_Wyll_COM_AOM_OOM_a988e571-00eb-904b-f8f5-0d767dd1aacb,_,_)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_OriginMoment_PreventRelaunchDialog(COL_WyllDeath_OM_Wyll_AOM_OOM_12fe2f75-7cd5-7d19-f8e6-f4a86e85e5c0,_,_)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_OriginMoment_PreventRelaunchDialog(COL_WyllDeath_OM_Wyll_COM_1d2754b8-4192-c015-939e-eef0aed9dfce,_,_)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_COL_Mizora_CaptureSetup()
		THEN
		PROC_ClearOriginMoment((DIALOGRESOURCE)TWN_MizorasCapture_OM_Wyll_COM_AOM_OOM_7d7fdf2d-7f48-b140-eb03-bb2e351c0bd0);
		PROC_TriggerUnregisterForPlayers((TRIGGER)S_TWN_Cambion_MizoraCaptureTrigger_9a23baa5-4f9a-4fd1-bddc-ef393d115944);
		SetFlag(TWN_Wyll_State_MizorasCaptureHappened_80cb617e-e3c3-3386-3919-6caef51bfd5d);
		SetCanInteract(S_COL_TadpoleChamber_Thralls_Pod_003_b051e95c-8a5d-4cf3-badd-5c9112cb5739, 1);
		DB_Dialogs(S_COL_TadpoleChamber_Thralls_Pod_003_b051e95c-8a5d-4cf3-badd-5c9112cb5739,S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a,COL_MizorasRescue_95b38e68-b094-9e46-11df-cd0d3bf7a702);
		PROC_SelfHealing_Disable(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a);
		SetTag(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a,(TAG)IGNORE_DANGEROUS_SURFACES_bbf62461-4af4-4631-807a-eb0bd988d9a6);
		SetOnStage(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a, 1); //Probably not needed
		SetOnStage((ITEM)S_COL_Mizora_HiddenChair_3df2a01d-3667-436b-94e6-5b962e73ab5b, 1);
		SetVisible((ITEM)S_COL_Mizora_HiddenChair_3df2a01d-3667-436b-94e6-5b962e73ab5b, 0);
		SetDetached(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a, 1);
		Use(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a, (ITEM)S_COL_Mizora_HiddenChair_3df2a01d-3667-436b-94e6-5b962e73ab5b, 1, 1, "COL_Mizora_MizoraUsedHiddenChair");
		PROC_TriggerRegisterForParty(S_COL_Mizora_InPodAD_Box_7f66fa8c-79bd-4353-b660-040c8eb88844);
		
		IF
		EntityEvent(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a,"COL_Mizora_MizoraUsedHiddenChair")
		THEN
		SetCanInteract((ITEM)S_COL_Mizora_HiddenChair_3df2a01d-3667-436b-94e6-5b962e73ab5b, 0);
		DB_COL_Mizora_CaptureSetupDone(1);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog(COL_MizorasRescue_State_SavedMizora_148bcec2-5367-2b72-3c93-29fb32fc0181)
		THEN
		PROC_ClearOriginMoment((DIALOGRESOURCE)COL_MizorasRescue_OM_Wyll_COM_AOM_OOM_a988e571-00eb-904b-f8f5-0d767dd1aacb);
		PROC_ClearOriginMoment((DIALOGRESOURCE)COL_WyllDeath_OM_Wyll_AOM_OOM_12fe2f75-7cd5-7d19-f8e6-f4a86e85e5c0);
		SetOnStage((ITEM)S_COL_Mizora_HiddenChair_3df2a01d-3667-436b-94e6-5b962e73ab5b, 0);
		PROC_RemoveDialog(S_COL_TadpoleChamber_Thralls_Pod_003_b051e95c-8a5d-4cf3-badd-5c9112cb5739);
		PROC_RemoveDialog(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a);
		SetCanInteract(S_COL_TadpoleChamber_Thralls_Pod_003_b051e95c-8a5d-4cf3-badd-5c9112cb5739, 0);
		ClearTag(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a, (TAG)IGNORE_DANGEROUS_SURFACES_bbf62461-4af4-4631-807a-eb0bd988d9a6);
		PROC_SelfHealing_Enable(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a);
		SetDetached(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a, 0);
		SetOnStage(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a,0);
		PROC_TriggerUnregisterForParty(S_COL_Mizora_InPodAD_Box_7f66fa8c-79bd-4353-b660-040c8eb88844);
		
		//For COL_WyllDeath logic, see Act2_COL_KethericShowdown
		
		PROC
		PROC_GlobalFlagReactionAfterDialog(COL_MizorasRescue_State_KilledMizora_55d5833a-c07d-3461-8c88-a98da5207674)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		THEN
		PROC_ORI_Karlach_UnlockWyllsDeathBranch();
		SetCanInteract(S_COL_TadpoleChamber_Thralls_Pod_003_b051e95c-8a5d-4cf3-badd-5c9112cb5739, 0);
		PROC_COL_TadpolingCentre_PurgeCleanUp(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a);
		PROC_Origins_CompanionLeavePermanently((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d,"CompanionMurdered");
		Die(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d,DEATHTYPE.Disintegrate,1);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog(COL_MizorasRescue_State_KilledMizora_55d5833a-c07d-3461-8c88-a98da5207674)
		AND
		DB_Avatars((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		THEN
		Die(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d,DEATHTYPE.Disintegrate,1);
		MusicPlayGeneral("Music_Game_Over");
		ShowGameOverMenu();
		
		//Mizora AD
		PROC
		PROC_StateSet_PermaDefeated(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a)
		THEN
		PROC_TriggerUnregisterForParty(S_COL_Mizora_InPodAD_Box_7f66fa8c-79bd-4353-b660-040c8eb88844);
		
		IF
		FlagSet(MOO_MizorasRescue_Event_WalkedAway_bc19238e-efd0-fb9c-5018-5c2f7fb74f4b,_,_) //stops after speaking to her once
		THEN
		PROC_TriggerUnregisterForParty(S_COL_Mizora_InPodAD_Box_7f66fa8c-79bd-4353-b660-040c8eb88844);
		
		IF
		EnteredTrigger(_Player,S_COL_Mizora_InPodAD_Box_7f66fa8c-79bd-4353-b660-040c8eb88844)
		AND
		NOT DB_COL_Mizora_InPodAD_TimerRunning(1)
		THEN
		DB_COL_Mizora_InPodAD_TimerRunning(1);
		TimerLaunch("COL_Mizora_InPodAD",8000);
		
		IF
		TimerFinished("COL_Mizora_InPodAD")
		AND
		NOT DB_CurrentLevel("SCL_Main_A")
		THEN
		NOT DB_COL_Mizora_InPodAD_TimerRunning(1);
		
		IF
		TimerFinished("COL_Mizora_InPodAD")
		AND
		DB_COL_Mizora_InPodAD_TimerRunning(1)
		AND
		NOT QRY_AnyPartyMemberInTrigger(S_COL_Mizora_InPodAD_Box_7f66fa8c-79bd-4353-b660-040c8eb88844)
		THEN
		NOT DB_COL_Mizora_InPodAD_TimerRunning(1);
		
		IF
		TimerFinished("COL_Mizora_InPodAD")
		AND
		DB_COL_Mizora_InPodAD_TimerRunning(1)
		AND
		NOT DB_CantTalk(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a)
		THEN
		PROC_TryStartAD(COL_MizoraRescue_AD_MizoraInPod_95305433-e26c-2f48-0e23-6a2ac0132ebf,S_COL_TadpoleChamber_Thralls_Pod_003_b051e95c-8a5d-4cf3-badd-5c9112cb5739);
		//Pod is speaker with Mizora speaker group override so occlusion doesn't cull the audio from the AD
		
		IF
		TimerFinished("COL_Mizora_InPodAD")
		AND
		DB_COL_Mizora_InPodAD_TimerRunning(1)
		THEN
		TimerLaunch("COL_Mizora_InPodAD",30000);
		
		//END_REGION
		
		//REGION Haven Romance
		PROC
		PROC_CampNight_StartSelected()
		AND
		DB_Camp_QueuedNight((FLAG)NIGHT_Wyll_HavenRomance_6e5b7ca7-b4d0-498b-86cc-64ba4ee5ba51)
		AND
		QRY_GetBestAvatarForCompanion((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		AND
		DB_QRYRTN_GetBestAvatarForCompanion((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, _Avatar)
		THEN
		SetFlag((FLAG)ORI_Wyll_State_SelectedDatingAvatar_b5e2afe7-a165-4964-aa5a-5470159b2c1d, _Avatar);
		
		PROC
		PROC_CampNight_StartSelected()
		AND
		DB_Camp_QueuedNight((FLAG)NIGHT_Wyll_HavenRomance_Dating_04abd928-27f2-422d-ab3f-2625ed22ca24)
		AND
		QRY_GetBestAvatarForCompanion((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		AND
		DB_QRYRTN_GetBestAvatarForCompanion((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, _Avatar)
		THEN
		SetFlag((FLAG)ORI_Wyll_State_SelectedDatingAvatar_b5e2afe7-a165-4964-aa5a-5470159b2c1d, _Avatar);
		
		//END_REGION
	}
	EXIT
	{
	}
}
