		DB_Dialogs(S_LOW_BasiliskGate_DoorGuard_c14b2865-fd6f-4d52-8e41-b5f8aad97583,(DIALOGRESOURCE)LOW_BasiliskGate_DoorGuard_6a3a8342-aa92-3534-6cc8-47af857ebb17);
