	}
	KB
	{
		//REGION Debug
		//END_REGION Debug
		
		
		//REGION States and flags
		
		IF
		DB_WYR_South_Guards(_Guard)
		THEN
		DB_GLO_DefeatCounter(_Guard,"WYR_South_Guards");
		
		// guards can't see this trigger - it's too far, disable checkpoint manually
		IF
		DB_InRegion(_Player,_Trigger)
		AND
		DB_CheckPointPassTrigger("WYR_South",_,_Trigger)
		AND
		DB_CheckPoint(_,_,_,_,_,"WYR_South",(FLAG)_PassFlag,_,_)
		AND
		NOT DB_GlobalFlag(_PassFlag)
		AND
		NOT DB_DialogName(WYR_South_Primary_f03a1685-b148-b70e-b773-b62404525308,_) // no ongoing checkpoint dialog
		THEN
		PROC_WYR_Ironhand_SkipScene();
		
		IF
		DB_InRegion(_Player,_Trigger)
		AND
		DB_CheckPointPassTrigger("WYR_South",_,_Trigger)
		AND
		DB_CheckPoint(_,_,_,_,_,"WYR_South",(FLAG)_PassFlag,_,_)
		AND
		NOT DB_GlobalFlag(_PassFlag)
		THEN
		SetFlag(_PassFlag);
		
		PROC
		PROC_GLO_DefeatCounter_AllPermaDefeated("WYR_South_Guards")
		THEN
		PROC_RemoveDBTrespassTrigger(S_WYR_South_TrespassTrigger_eefe8bf7-73da-4954-abd2-38cbc1c4b9cd,S_WYR_South_CheckpointOut_9443e8cb-c32a-4b1b-bf04-5e9506dea31b);
		
		IF
		FlagSet((FLAG)WYR_South_Event_AgreedCustody_a85fefb5-6f59-4709-b310-b82a1e13411f,_,_)
		THEN
		SetFlag(WYR_South_State_AgreedCustody_b160b41d-8e33-4d4c-acc8-9aa862fee1df);
		
		IF
		DB_Is_InCombat(_Guard,_CombatID)
		AND
		DB_WYR_South_Guards((CHARACTER)_Guard)
		AND
		DB_Is_InCombat(_Player,_CombatID)
		AND
		DB_Players((CHARACTER)_Player)
		THEN
		SetFlag(WYR_South_State_Combat_d048dfe1-1545-4698-beba-cf7ed94f5ba4);
		
		IF //Turn guards permanently hostile if one of them perishes.
		KilledBy(_Guard, _Player, _, _)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		DB_WYR_South_Guards((CHARACTER)_Guard)
		AND
		QRY_OnlyOnce("WYR_South_Guards_PermaHostile")
		AND
		GetFaction(_Guard, _Faction)
		THEN
		PROC_SetRelationToPlayers(_Faction, 0);
		
		
		//END_REGION States and flags
		
		
		//REGION Checkpoint dialogs
		
		PROC
		PROC_CheckPointDialogue(_Player,S_WYR_South_Guard_004_e572c6d1-3330-46fd-9ecc-da318f499956)
		AND
		NOT DB_WYR_South_GuardsPanic(1)
		AND
		QRY_StartCheckpointWarningDialog("WYR_South",WYR_South_Primary_f03a1685-b148-b70e-b773-b62404525308,
			S_WYR_South_Guard_004_e572c6d1-3330-46fd-9ecc-da318f499956,
			_Player)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers(WYR_South_Primary_f03a1685-b148-b70e-b773-b62404525308,_DialogID)
		AND
		NOT DB_GlobalFlag(WYR_South_State_AccessGranted_3339af4f-3214-4d10-aaab-3d3511b9ab74)
		THEN
		PROC_DialogAddSpeakingActor(_DialogID,S_WYR_South_SteelWatch_cb51332e-f9b9-4564-bda9-641bb1f03635,0,1);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers(WYR_South_Primary_f03a1685-b148-b70e-b773-b62404525308,_DialogID)
		AND
		NOT DB_GlobalFlag(WYR_South_State_AccessGranted_3339af4f-3214-4d10-aaab-3d3511b9ab74)
		AND
		DB_WYR_Ironhand_SceneGnomes(_,_Gnome)
		THEN
		PROC_DialogAddSpeakingActor(_DialogId,_Gnome,1,1);
		
		QRY
		QRY_ShouldNotAddCharacterInTriggerToDialog(_Player,WYR_South_Primary_f03a1685-b148-b70e-b773-b62404525308,S_WYR_South_AddPlayerToDialog_Zone_d9ff0c05-6afa-4d58-88f6-4ab0cbc20f2d)
		AND
		QRY_CharacterIsHidden(_Player)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_CheckPointDialogue(_Player,_Guard)
		AND
		NOT DB_WYR_South_GuardsPanic(1)
		AND
		_Guard != S_WYR_South_Guard_004_e572c6d1-3330-46fd-9ecc-da318f499956
		AND
		DB_Dialogs(_Guard,_Dialog)
		AND
		QRY_StartCheckpointWarningDialog("WYR_South",_Dialog,_Guard,_Player)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_WYR_KillDirectorGortash_CalmSteelWatch()
		THEN
		PROC_GlobalSetFlagAndCache(WYR_South_State_AccessGranted_3339af4f-3214-4d10-aaab-3d3511b9ab74);
		//END_REGION
		
		//REGION Gnomes attack
		IF
		FlagSet(WYR_South_Event_DoInspection_a1e5ffe2-ffc4-4a7a-b7f2-1f5df21b7db1,_,_DialogID)
		THEN
		PROC_CharacterMoveTo(S_WYR_South_SteelWatch_cb51332e-f9b9-4564-bda9-641bb1f03635,S_WYR_South_SteelWatch_InspectionPoint_9e5932b8-c11e-42b4-b205-d42ff46456bb,"Walk","");
		
		/*
		IF
		FlagSet(WYR_South_Event_DoInspection_a1e5ffe2-ffc4-4a7a-b7f2-1f5df21b7db1,_,_DialogID)
		AND
		DB_DialogPlayers(_DialogID,_Player,_)
		THEN
		PROC_CharacterMoveTo((CHARACTER)_Player,S_WYR_South_Player_InspectionPoint_3be6935e-93c8-49dd-9be7-6256bf94e981,"Walk","");
		*/
		
		IF
		EntityEvent(S_WYR_South_SteelWatch_cb51332e-f9b9-4564-bda9-641bb1f03635,"WYR_South_SteelWatch_ReturnToSpot")
		THEN
		LookFromTrigger(S_WYR_South_SteelWatch_cb51332e-f9b9-4564-bda9-641bb1f03635,S_WYR_South_SteelWatch_Pos_eecfb94e-02de-4d8e-afd6-e4615542a2b1,0);
		
		IF
		FlagSet(WYR_South_State_AccessGranted_3339af4f-3214-4d10-aaab-3d3511b9ab74,_,_)
		THEN
		PROC_AddCharactersInTriggerToDialog_Clear(WYR_South_Primary_f03a1685-b148-b70e-b773-b62404525308,S_WYR_South_AddPlayerToDialog_Zone_d9ff0c05-6afa-4d58-88f6-4ab0cbc20f2d);
		PROC_TriggerUnregisterForPlayers(S_WYR_South_AddPlayerToDialog_Zone_d9ff0c05-6afa-4d58-88f6-4ab0cbc20f2d);
		
		IF
		FlagSet(WYR_South_State_AccessGranted_3339af4f-3214-4d10-aaab-3d3511b9ab74,_,_)
		AND
		HasAppliedStatus(S_WYR_South_SteelWatch_cb51332e-f9b9-4564-bda9-641bb1f03635,"SUNFLASHED",0)
		AND
		NOT DB_GlobalFlag(WYR_Ironhand_Event_GnomesIntervent_06ad5471-b210-4ea0-a390-09bc7afdd332)
		AND
		DB_GLO_SteelWatcher_IgnoresCrime(S_WYR_South_SteelWatch_cb51332e-f9b9-4564-bda9-641bb1f03635,_CrimeID)
		THEN
		NOT DB_GLO_SteelWatcher_IgnoresCrime(S_WYR_South_SteelWatch_cb51332e-f9b9-4564-bda9-641bb1f03635);
		NOT DB_GLO_SteelWatcher_IgnoresCrime(S_WYR_South_SteelWatch_cb51332e-f9b9-4564-bda9-641bb1f03635,_CrimeID);
		
		// TODO:
		// 1) make sure no one is in the hideout when they appear
		// 2) use Poof or invisibility status so they do not appear out of nowhere
		IF
		FlagSet((FLAG)WYR_Ironhand_Event_GnomesIntervent_06ad5471-b210-4ea0-a390-09bc7afdd332,_,_)
		AND
		DB_WYR_Ironhand_SceneGnomes(_Id,_Gnome)
		AND
		DB_WYR_Ironhand_Pos_BridgeCheckpointDialog(_Id,_Pos)
		THEN
		RemoveSurfaceLayer(_Pos,"Ground",5.0);
		RemoveSurfaceLayer(_Pos,"Cloud",5.0);
		TeleportTo(_Gnome,_Pos);
		//END_REGION Checkpoint dialogs
		
		
		//REGION Custody for player
		
		PROC
		PROC_FlagReactionAfterDialog(_Player,WYR_South_AgreedCustody_a85fefb5-6f59-4709-b310-b82a1e13411f,_,_DialogID)
		AND
		DB_Players(_OtherPlayer)
		AND
		InSamePartyGroup((CHARACTER)_Player,_OtherPlayer,1)
		AND
		DB_DialogNPCs(_DialogID,_Guard,1)
		AND
		DB_RegionPrison("BGO_Main_A_WyrmRock",_PrisonCell,_PrisonSpawnPoint)
		AND
		DB_PlayerPrison(S_WYR_WyrmRockPrison_PlayerCell_6792230e-f319-4870-8778-5f7bfae74489,_,_,_FugitiveStatus)
		THEN
		DB_WYR_South_TeleportingToPrison(_Player);
		PROC_CrimeTeleportCharacterToPrison((CHARACTER)_Guard,_OtherPlayer,_PrisonCell,_PrisonSpawnPoint,_FugitiveStatus);
		
		PROC
		PROC_FlagReactionAfterDialog(_Player, WYR_South_Event_AgreedCustody_a85fefb5-6f59-4709-b310-b82a1e13411f,_,_)
		THEN
		ClearFlag(WYR_South_Event_AgreedCustody_a85fefb5-6f59-4709-b310-b82a1e13411f, _Player);
		
		IF
		EntityEvent(_Player,"CRIME_TeleportedToPrison")
		AND
		DB_WYR_South_TeleportingToPrison((CHARACTER)_Player)
		AND
		QRY_OnlyOnce("WYR_South_VB_AfterSentToPrison")
		THEN
		StartVoiceBark(WYR_South_VB_AfterSentToPrison_42cb9caa-7005-bbd0-b9c8-5462c748e406,_Player);
		
		IF
		EntityEvent(_Player,"CRIME_TeleportedToPrison")
		AND
		DB_WYR_South_TeleportingToPrison((CHARACTER)_Player)
		THEN
		NOT DB_WYR_South_TeleportingToPrison(_Player);
		
		//END_REGION Custody for player
		
		
		//REGION Resisting arrest
		
		//PROC
		//PROC_GlobalFlagReactionAfterDialog(WYR_Ironhand_Event_GnomesIntervent_06ad5471-b210-4ea0-a390-09bc7afdd332,WYR_South_Primary_f03a1685-b148-b70e-b773-b62404525308,_DialogID)
		//AND
		//DB_DialogPlayers(_DialogID,_Player,1)
		//AND
		//DB_Players((CHARACTER)_Player)
		//THEN
		//ForceTurnBasedMode(_Player,1);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog(WYR_Ironhand_Event_GnomesIntervent_06ad5471-b210-4ea0-a390-09bc7afdd332,WYR_South_Primary_f03a1685-b148-b70e-b773-b62404525308)
		THEN
		PROC_WYR_Ironhand_GnomesIntervent(S_WYR_South_SteelWatch_cb51332e-f9b9-4564-bda9-641bb1f03635);
		SetFlag(WYR_South_State_AccessGranted_3339af4f-3214-4d10-aaab-3d3511b9ab74);
		SetFlag(WYR_South_State_AccessGrantedThroughCheckpoint_b70fe001-d164-4d4a-a333-d63e1982b4cd);
		
		//END_REGION Resisting arrest
		
		
		//REGION Guards panic
		
		PROC
		PROC_WYR_South_GuardsPanic()
		AND
		GetStatusTurns(S_WYR_South_SteelWatch_cb51332e-f9b9-4564-bda9-641bb1f03635,"SUNFLASHED",_Turns)
		AND
		IntegerProduct(_Turns,6000,_TurnsMillisec)
		AND
		IntegerSum(_TurnsMillisec,1000,_Duration)
		THEN
		DB_WYR_South_GuardsPanic(1);
		TimerLaunch("WYR_South_PanicFinish",_Duration);
		
		PROC
		PROC_WYR_Ironhand_GnomesRun()
		AND
		DB_WYR_Ironhand_SceneGnomes(1,_Gnome)
		THEN
		PROC_WYR_South_GuardsPanic();
		ObjectTimerLaunch(_Gnome,"WYR_South_GuardsAfterSunflash_RunForGnomes",2000,0);
		//TimerLaunch("WYR_South_GuardsAfterSunflash_RunForGnomes",2000);
		
		PROC
		PROC_WYR_South_GuardsPanic()
		AND
		DB_WYR_South_Panic(_Delay,_Guard,_RunTo)
		THEN
		RealtimeObjectTimerLaunch(_Guard,"WYR_South_PanicDelay",_Delay);
		
		//END_REGION Guards panic
		
		
		//REGION Guards after sunflash
		
		IF
		ObjectTimerFinished(_Gnome,"WYR_South_GuardsAfterSunflash_RunForGnomes")
		THEN
		PROC_TryStartAD(WYR_South_AD_CommandsAfterSunflash_c242ec92-de77-b9b3-aac6-e71fa560a6e5,S_WYR_South_Guard_004_e572c6d1-3330-46fd-9ecc-da318f499956);
		
		IF
		ObjectTimerFinished(_Gnome,"WYR_South_GuardsAfterSunflash_RunForGnomes")
		AND
		DB_WYR_South_GuardGoingToLook(_Guard,_LookOutPos)
		THEN
		PROC_CharacterMoveTo(_Guard,_LookOutPos,"Run","WYR_South_GuardRunsToCheck");
		
		IF
		EntityEvent(_Guard,"WYR_South_GuardRunsToCheck")
		AND
		_Guard != S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45
		THEN
		PlayAnimation(_Guard,CUST_LookingAround_63bcacef-5631-4ab3-9400-81b23cb18ca7,"WYR_South_GuardLookedAround");
		
		IF
		EntityEvent(_Guard,"WYR_South_GuardLookedAround")
		AND
		DB_WYR_South_GuardPos((CHARACTER)_Guard,_Pos)
		THEN
		PROC_CharacterMoveTo(_Guard,_Pos,"Walk","");
		
		IF
		ObjectTimerFinished(_Guard,"WYR_South_PanicDelay")
		AND
		DB_WYR_South_Panic(_Delay,(CHARACTER)_Guard,_RunTo)
		THEN
		PROC_CharacterMoveTo((CHARACTER)_Guard,_RunTo,"Run","");
		RealtimeObjectTimerLaunch(_Guard,"WYR_South_GuardReturns",12000);
		
		IF
		ObjectTimerFinished(_Guard,"WYR_South_GuardReturns")
		AND
		NOT DB_WYR_South_GuardGoingToLook((CHARACTER)_Guard,_)
		AND
		_Guard != S_WYR_South_Guard_004_e572c6d1-3330-46fd-9ecc-da318f499956
		AND
		DB_WYR_South_GuardPos((CHARACTER)_Guard,_Pos)
		THEN
		PROC_CharacterMoveTo(_Guard,_Pos,"Walk","");
		
		IF
		TimerFinished("WYR_South_PanicFinish")
		THEN
		NOT DB_WYR_South_GuardsPanic(1);
		//PROC_SpotPlayers_RestartSpotting(S_WYR_South_Guard_004_e572c6d1-3330-46fd-9ecc-da318f499956,"WYR_South");
		
		IF
		StatusRemoved(S_WYR_South_SteelWatch_cb51332e-f9b9-4564-bda9-641bb1f03635,"SUNFLASHED",_,_)
		AND
		DB_WYR_Ironhand_SteelWatchSunflashed(_SteelWatch, _Gnome)
		THEN
		NOT DB_WYR_Ironhand_SteelWatchSunflashed(_SteelWatch, _Gnome);
		PROC_CharacterMoveTo(S_WYR_South_SteelWatch_cb51332e-f9b9-4564-bda9-641bb1f03635,S_WYR_South_SteelWatch_Broken_Pos_3cdeffea-027f-4151-8714-e9224ff28bd9,"Stroll","WYR_South_SteelWatch_Event_Steering");
		PROC_CharacterMoveTo(S_WYR_South_Guard_004_e572c6d1-3330-46fd-9ecc-da318f499956,S_WYR_South_GuardPos_Fixing_004_8c2c333a-1a99-41ab-8f00-92f6b840831e,"Stroll","WYR_South_Guard_Fixing");
		ApplyStatus(_SteelWatch, "SUNFLASH_BROKENSCANNER", -1.0, 1, _Gnome);
		DB_WYR_South_SteelWatchBrokenScanner((CHARACTER)_SteelWatch);
		
		QRY
		QRY_SelectCustomDialog_AfterGenerics((CHARACTER)S_WYR_South_SteelWatch_cb51332e-f9b9-4564-bda9-641bb1f03635, _)
		AND
		IsTagged(S_WYR_South_SteelWatch_cb51332e-f9b9-4564-bda9-641bb1f03635, (TAG)STEEL_WATCHER_MALFUNCTION_62b8df63-c303-4956-97a9-5c9c97520ebf, 1)
		THEN
		DB_SelectedDialog((DIALOGRESOURCE)GLO_SteelWatcher_AD_Malfunction_6b4fb4c5-b34f-f10f-d035-9f3a8ec5a0b2, (CHARACTER)S_WYR_South_SteelWatch_cb51332e-f9b9-4564-bda9-641bb1f03635);
		
		IF
		EntityEvent(S_WYR_South_SteelWatch_cb51332e-f9b9-4564-bda9-641bb1f03635, "WYR_South_SteelWatch_Event_Steering")
		THEN
		LookFromTrigger(S_WYR_South_SteelWatch_cb51332e-f9b9-4564-bda9-641bb1f03635,S_WYR_South_SteelWatch_Broken_Pos_3cdeffea-027f-4151-8714-e9224ff28bd9, 1);
		
		IF
		EntityEvent((CHARACTER)S_WYR_South_Guard_004_e572c6d1-3330-46fd-9ecc-da318f499956,"WYR_South_Guard_Fixing")
		THEN
		LookAtEntity((CHARACTER)S_WYR_South_Guard_004_e572c6d1-3330-46fd-9ecc-da318f499956,S_WYR_South_SteelWatch_cb51332e-f9b9-4564-bda9-641bb1f03635,3.0);
		PlayAnimation(S_WYR_South_Guard_004_e572c6d1-3330-46fd-9ecc-da318f499956,CUST_Pondering_01_c2a68c82-1b0b-4d0c-8f1a-c9f14984a5fb,"");
		
		// Removing multifunctional SW
		PROC
		PROC_LongRestOrLevelUnloading("BGO_Main_A")
		AND
		DB_WYR_South_SteelWatchBrokenScanner(_SteelWatch)
		AND
		NOT DB_PermaDefeated(_SteelWatch)
		THEN
		NOT DB_WYR_South_SteelWatchBrokenScanner(_SteelWatch);
		PROC_SetOnStage(_SteelWatch, 0);
		
		//END_REGION Guards after sunflash
		
		
		//REGION Civilians disappear in case of combat or after player left
		
		IF
		DB_Is_InCombat(_Guard,_CombatID)
		AND
		DB_WYR_South_Guards((CHARACTER)_Guard)
		THEN
		PROC_WYR_South_RefugeesDisappear();
		
		PROC
		PROC_WYR_Ironhand_GnomesRun()
		THEN
		PROC_WYR_South_RefugeesDisappear();
		
		PROC
		PROC_WYR_South_RefugeesDisappear()
		AND
		DB_WYR_South_Refugees(_Refugee)
		AND
		NOT DB_PermaDefeated(_Refugee)
		THEN
		PROC_DisappearOutOfSightTo(_Refugee,S_WYR_South_CiviliansDisappearTo_Pos_a24e5541-7305-429a-a58f-dd4dd7a016a6,"Run",0,"");
		
		IF
		DB_DialogNPCs(_DialogID,_Npc,_)
		AND
		DB_WYR_South_RefugeesSeenWhenTalkedTo((CHARACTER)_Npc)
		AND
		DB_DialogName(_Dialog,_DialogID)
		AND
		DB_Dialogs(_Npc,_Dialog)
		THEN
		DB_WYR_South_SeenRefugees(1);
		
		IF
		DialogStarted(WYR_South_Primary_f03a1685-b148-b70e-b773-b62404525308,_)
		THEN
		DB_WYR_South_SeenRefugees(1);
		
		// refugees are in one Activation group => one event is enough
		IF
		Deactivated(_Refugee)
		AND
		DB_WYR_South_SeenRefugees(1)
		AND
		DB_WYR_South_Refugees((CHARACTER)_Refugee)
		THEN
		PROC_WYR_South_RefugeesRemove();
		
		PROC
		PROC_WYR_South_RefugeesRemove()
		THEN
		SetFlag(WYR_South_RefugeesLeft_e3945f51-32da-42f4-ab06-f58e61f55dbc,NULL_00000000-0000-0000-0000-000000000000,0);
		
		PROC
		PROC_WYR_South_RefugeesRemove()
		AND
		QRY_OnlyOnce("PROC_WYR_South_RefugeesRemove")
		AND
		DB_WYR_South_Refugees(_Refugee)
		THEN
		SetOnStage(_Refugee,0);
		
		IF
		EnteredTrigger(_Player,S_WYR_Fortress_SUB_94ca5a54-0813-48b4-9f55-4cb039a63c82)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		IsActive(S_WYR_South_Civilian_000_fac3ed5f-b71b-4285-b05a-1d504c06666e,0)
		THEN
		PROC_WYR_South_RefugeesRemove();
		
		//END_REGION Civilians disappear in case of combat or after player left
		
		//REGION Peacful resolutions
		IF
		FlagSet((FLAG)WYR_South_State_AccessGranted_3339af4f-3214-4d10-aaab-3d3511b9ab74,_,_)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_ScryingEyes_State_PartyActedHostile_d3c6d338-36d5-41e7-97d1-9541e0a9bbcf)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_SteelWatchers_State_EnemyOfAbsolute_1e72bf66-e983-42e5-bd41-10b03eb9e713)
		AND
		DB_WYR_South_Guards(_Guard)
		THEN
		PROC_PeacefulResolve((CHARACTER)_Guard);
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(560).Title("Act3_WYR_South_GoldQuest");
Goal(560)
{
	INIT
	{
		DB_Dialogs(S_WYR_South_GoldGuard_00_cb395bd9-d894-4187-8593-629a6f3e081c,WYR_South_GoldGuard_00_d395109c-be21-21c5-31f5-6de018848684);
		DB_Dialogs(S_WYR_South_GoldGuard_01_0797d0f6-db97-49d2-8606-40793025556d,WYR_South_GoldGuard_01_78878a28-aafa-caa0-2499-8ebed8dd9070);
		
		// Gnome head
		DB_HasItemEvent(S_WYR_WulbrenHead_2e02bb20-3619-44d2-b1be-cca9697dfc01,WYR_Ironhand_WulbrenHead_Has_9fc84be0-71e4-41d5-81a4-3f3fb43eb29b);
		DB_GiveItemToEvent(S_WYR_WulbrenHead_2e02bb20-3619-44d2-b1be-cca9697dfc01,WYR_Ironhand_WulbrenHead_Transfer_cc5cc951-639b-4330-8422-1e699ceb6b38);
		
		DB_GLO_HeadRemoval((CHARACTER)S_GLO_Wulbren_2d70edbf-1a70-4047-8099-48f3e75d93bf, (CHARACTERROOT)UNI_WYR_Wulbren_Beheaded_e6e93b8a-6972-4338-a4af-64deb67ecf98, (ITEM)S_WYR_WulbrenHead_2e02bb20-3619-44d2-b1be-cca9697dfc01);
		
		//REGION Journal
		DB_QuestDef_State_ConditionalFlag((FLAG)WYR_South_Event_GotTaskToTrackGnomes_717dceb3-3a0d-427d-b07d-77537a22439d, "WYR_GnomeHeads", "Accepted", 0, WYR_Ironhand_State_PlayerSawGnomes_d2378ff6-22b2-4f31-aa4e-947408de5cdc);
		DB_QuestDef_State_ConditionalFlag((FLAG)WYR_South_Event_GotTaskToTrackGnomes_717dceb3-3a0d-427d-b07d-77537a22439d, "WYR_GnomeHeads", "AcceptedKnows", 1, WYR_Ironhand_State_PlayerSawGnomes_d2378ff6-22b2-4f31-aa4e-947408de5cdc);
		DB_QuestDef_State((FLAG)WYR_Ironhand_WulbrenHead_Has_9fc84be0-71e4-41d5-81a4-3f3fb43eb29b, "WYR_GnomeHeads", "TookHead");
		DB_QuestDef_PermaDefeatedState("WYR_GnomeHeads", "FistPermaDefeated", S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45);
		DB_QuestDef_State((FLAG)END_General_State_Started_a0fd5f91-e4b3-4d01-84d3-9ff484139e99, "WYR_GnomeHeads", "ReachedEnd");
		DB_QuestDef_State((FLAG)LOW_SteelWatchFoundry_State_Outcome_WulbrenLeft_498c6f1b-871e-4c2a-9c23-a85df85cfe5c, "WYR_GnomeHeads", "NoHead");
		DB_QuestDef_State_ConditionalFlag((FLAG)WYR_South_GoldReward_Transfer_64073914-d602-42d5-b6c7-c47d7e0df5d9, "WYR_GnomeHeads", "RewardedGenerously", 1, WYR_South_GoldReward_Generous_da077223-256b-4322-939a-9c7c65857fac);
		DB_QuestDef_State_ConditionalFlag((FLAG)WYR_South_GoldReward_Transfer_64073914-d602-42d5-b6c7-c47d7e0df5d9, "WYR_GnomeHeads", "Rewarded", 0, WYR_South_GoldReward_Generous_da077223-256b-4322-939a-9c7c65857fac);
		//END_REGION
	}
	KB
	{
		//REGION Setup
		QRY
		QRY_GLO_SetupForAct_CustomBlock("BGO_Main_A",(CHARACTER)S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45)
		AND
		NOT DB_GlobalFlag(WYR_Ironhand_InAct3_Wulbren_3097cdd8-33eb-4ca0-956b-b2826bb01f8a)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_GLO_SetupForAct("BGO_Main_A",(CHARACTER)S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45,1)
		THEN
		SetOnStage(S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45,1);
		DB_Dialogs(S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45,WYR_South_GoldQuestGiver_cbf9928e-d7b7-ac9b-2a9b-aa4e295c19d0);
		//DB_WYR_South_Panic(500,S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45);
		DB_WYR_South_GuardPos(S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45,S_WYR_South_GoldQuestGiver_Pos_37e30c59-1dbb-43b2-9901-2041bd801026);
		DB_WYR_South_GuardGoingToLook(S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45,S_WYR_South_GuardsRunTo_002_8df585d7-14b0-43b1-b834-5bd3bd7f5785);
		DB_ItemOwnerShipTriggers("BGO_Main_A",S_WYR_South_OwnershipZone_c39415a4-dd6d-4821-aa78-3a04a0cdc178,S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45);
		AddGold(S_WYR_South_GoldStash_678f62f0-a84d-4c11-802e-f5591d5b6037, 3000);
		PROC_WYR_South_CheckGoldStash();
		
		PROC
		PROC_GLO_SetupForAct("BGO_Main_A",(CHARACTER)S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45,0)
		AND
		GetGold(S_WYR_South_GoldStash_678f62f0-a84d-4c11-802e-f5591d5b6037,_Gold)
		AND
		IntegerProduct(_Gold,-1,_MinusGold)
		THEN
		SetOnStage(S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45,0);
		AddGold(S_WYR_South_GoldStash_678f62f0-a84d-4c11-802e-f5591d5b6037,_MinusGold);
		PROC_WYR_South_CheckGoldStash();
		PROC_RemoveAllDialogEntriesForSpeaker(S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45);
		//NOT DB_WYR_South_Panic(500,S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45);
		NOT DB_WYR_South_GuardPos(S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45,S_WYR_South_GoldQuestGiver_Pos_37e30c59-1dbb-43b2-9901-2041bd801026);
		NOT DB_WYR_South_GuardGoingToLook(S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45,S_WYR_South_GuardsRunTo_002_8df585d7-14b0-43b1-b834-5bd3bd7f5785);
		NOT DB_ItemOwnerShipTriggers("BGO_Main_A",S_WYR_South_OwnershipZone_c39415a4-dd6d-4821-aa78-3a04a0cdc178,S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45);
		//END_REGION
		
		//REGION Gold stash
		PROC
		PROC_WYR_South_CheckGoldStash()
		AND
		GetGold(S_WYR_South_GoldStash_678f62f0-a84d-4c11-802e-f5591d5b6037,_Amount)
		THEN
		DB_WYR_South_GoldReward(_Amount);
		
		IF
		AddedTo(_,S_WYR_South_GoldStash_678f62f0-a84d-4c11-802e-f5591d5b6037,_)
		THEN
		PROC_WYR_South_CheckGoldStash();
		
		IF
		RemovedFrom(_,S_WYR_South_GoldStash_678f62f0-a84d-4c11-802e-f5591d5b6037)
		THEN
		PROC_WYR_South_CheckGoldStash();
		
		IF
		DB_WYR_South_GoldReward(_NewAmount)
		AND
		DB_WYR_South_GoldReward(_OldAmount)
		AND
		_NewAmount != _OldAmount
		THEN
		NOT DB_WYR_South_GoldReward(_OldAmount);
		
		IF
		DB_WYR_South_GoldReward(_Amount)
		AND
		_Amount > 0
		THEN
		SetFlag(WYR_South_GoldReward_Has_78cd1bf6-feb2-4b16-87a7-314fb2c8361c,S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45);
		
		IF
		DB_WYR_South_GoldReward(0)
		THEN
		ClearFlag(WYR_South_GoldReward_Has_78cd1bf6-feb2-4b16-87a7-314fb2c8361c,S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45);
		
		IF
		DB_WYR_South_GoldReward(_Amount)
		AND
		_Amount >= 10000
		THEN
		SetFlag(WYR_South_GoldReward_Generous_da077223-256b-4322-939a-9c7c65857fac);
		
		IF
		DB_WYR_South_GoldReward(_Amount)
		AND
		_Amount < 10000
		THEN
		ClearFlag(WYR_South_GoldReward_Generous_da077223-256b-4322-939a-9c7c65857fac);
		//END_REGION
		
		//REGION Reward announcement
		IF
		EntityEvent(S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45,"WYR_South_GuardRunsToCheck")
		THEN
		SetFlag(WYR_South_State_AnouncingReward_d611fa14-a0ce-4da2-8f4b-617b50cff635,S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45,0);
		
		IF
		DialogActorLeft(WYR_South_GoldQuestGiver_cbf9928e-d7b7-ac9b-2a9b-aa4e295c19d0,_DialogID,S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45,_)
		AND
		DB_WYR_South_GuardPos(S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45,_Pos)
		THEN
		ClearFlag(WYR_South_State_AnouncingReward_d611fa14-a0ce-4da2-8f4b-617b50cff635,S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45,0);
		SetFlag(WYR_South_GoldQuestGiver_GoInside_80f84ddc-0422-4160-aed2-a7dacaeaecde,S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45,0);
		PROC_CharacterMoveTo(S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45,_Pos,"Walk","");
		
		// AD if gnomes scene was skipped
		PROC
		PROC_WYR_Ironhand_SkipScene()
		AND
		NOT DB_WYR_South_NoCalling(1)
		THEN
		SetFlag(WYR_South_CallingAD_b9fd347c-3cf8-4af6-b8a5-2c2c08a21329,S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45,0);
		
		IF
		DialogStarted(WYR_South_GoldQuestGiver_cbf9928e-d7b7-ac9b-2a9b-aa4e295c19d0,_)
		THEN
		DB_WYR_South_NoCalling(1);
		ClearFlag(WYR_South_CallingAD_b9fd347c-3cf8-4af6-b8a5-2c2c08a21329,S_WYR_South_GoldQuestGiver_ad4a43f4-a86c-4946-a696-43a4ba4e6b45,0);
		//END_REGION
		
		//REGION Journal
		IF
		DB_GlobalFlag(WYR_South_Event_GotTaskToTrackGnomes_717dceb3-3a0d-427d-b07d-77537a22439d)
		THEN
		DB_GLO_HeadRemoval_InaccessibleIfOffstage(S_GLO_Wulbren_2d70edbf-1a70-4047-8099-48f3e75d93bf);
		
		QRY
		QRY_GLO_HeadRemoval_Block((CHARACTER)S_GLO_Wulbren_2d70edbf-1a70-4047-8099-48f3e75d93bf)
		AND
		NOT DB_GlobalFlag(WYR_South_Event_GotTaskToTrackGnomes_717dceb3-3a0d-427d-b07d-77537a22439d)
		THEN
		DB_NOOP(1);
		
		IF
		DB_InRegion(_Player, (TRIGGER)S_WYR_Ironhand_SUB_55832d9c-360c-483f-977a-bb6c4beb4eb0)
		AND
		NOT DB_WYR_South_GoldQuest_UpdatedEntering(1)
		AND
		NOT QRY_QuestUpdateIsUnlockedForAny("WYR_GnomeHeads", "AcceptedKnows")
		THEN
		DB_WYR_South_GoldQuest_UpdatedEntering(1); // to avoid log spamming
		QuestUpdate("WYR_GnomeHeads", "FoundHideout");
		
		IF
		RelationChanged((FACTION)ACT3_WYR_South_GateFlamingFists_4b772c61-c34d-4898-9ca7-45fba09b4d47, (FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, 0, 1)
		THEN
		QuestUpdate("WYR_GnomeHeads", "TurnedPermaHostile");
		
		IF
		DB_Dead((CHARACTER)S_GLO_Wulbren_2d70edbf-1a70-4047-8099-48f3e75d93bf)
		AND
		NOT DB_GLO_HeadRemoval_HeadInaccessible(S_GLO_Wulbren_2d70edbf-1a70-4047-8099-48f3e75d93bf)
		THEN
		QuestUpdate("WYR_GnomeHeads", "KilledGnomes");
		
		IF
		DB_GLO_HeadRemoval_HeadInaccessible(S_GLO_Wulbren_2d70edbf-1a70-4047-8099-48f3e75d93bf)
		THEN
		QuestUpdate("WYR_GnomeHeads", "NoHead");
		PROC_GlobalSetFlagAndCache((FLAG)WYR_Ironhand_State_HeadInaccessible_953499fd-7a01-bafb-0a76-ed4ec25b548e);
		
		// Debug
		IF
		TextEvent("WYR_Ironhand_TestGnomeHeadsQuest")
		THEN
		QuestUpdate("WYR_GnomeHeads","Accepted");
		PROC_GlobalSetFlagAndCache(WYR_South_Event_GotTaskToTrackGnomes_717dceb3-3a0d-427d-b07d-77537a22439d);
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(561).Title("Act3_WYR_South_GoldQuest_PostIronhand");
Goal(561)
