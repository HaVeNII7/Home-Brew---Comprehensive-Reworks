		DB_HAV_TakingIsobel_KOParticipants((CHARACTER)S_HAV_HavenOutcasts_FountainPatrol_Caster_ff70f59a-7d50-4e69-a768-60a97c6fb57d);
		DB_HAV_TakingIsobel_KOParticipants((CHARACTER)S_HAV_HavenOutcasts_BarricadeRunners_Ranger_572690b6-68f5-4e7b-807b-b9376b658b65);
