		DB_LOW_HouseOfHope_SpiritSouls((CHARACTER)S_LOW_HouseOfHope_SoulSpirit08_98e4242c-70e2-44ae-a580-e036316b5494,(TRIGGER)S_LOW_HouseOfHope_SoulSpirit08_Point_c890d944-8493-44c1-8429-fafe3ffdddb4,(TRIGGER)S_LOW_HouseOfHope_SoulSpirit08_Box_faa534c4-d6c3-4222-af94-a06ea3e63ad2,(DIALOGRESOURCE)LOW_HouseOfHope_AD_DamnedSoul08_51fc4554-f451-a9ff-ebef-4337d6b0e784);
		DB_LOW_HouseOfHope_SpiritSouls((CHARACTER)S_LOW_HouseOfHope_SoulSpirit15_2133c53e-3b07-457c-9e6d-a8a2ac8b275d,(TRIGGER)S_LOW_HouseOfHope_SoulSpirit15_Point_055d7ce4-16f0-4cd2-b2c0-4573f432b0e7,(TRIGGER)S_LOW_HouseOfHope_SoulSpirit15_Box_33d928de-a59d-4575-9b21-40179d8791bf,(DIALOGRESOURCE)LOW_HouseOfHope_AD_DamnedSoul15_ffeaf204-f70e-3df6-19f2-942ed5d446df);
		DB_LOW_HouseOfHope_SpiritSouls((CHARACTER)S_LOW_HouseOfHope_SoulSpirit17_a67db2ac-7900-4261-90b9-ad834a13e6e9,(TRIGGER)S_LOW_HouseOfHope_SoulSpirit17_Point_30cbfbe1-3bd3-4ed4-b44a-12e160d7448f,(TRIGGER)S_LOW_HouseOfHope_SoulSpirit17_Box_71679f8f-daa0-4aa2-84d0-0a667ab9a50f,(DIALOGRESOURCE)LOW_HouseOfHope_AD_DamnedSoul17_8958171d-831a-1bb3-0e53-41980df000a3);
		DB_LOW_HouseOfHope_SpiritSoulsPoofVFX((EFFECTRESOURCE)VFX_Script_HoH_Poof_01_13d0523c-610c-7d1d-54d8-b78832d69458);
		
		//END_REGION
		
		DB_LOW_HouseOfHopePetrifiedDebtors((CHARACTER)S_LOW_HouseOfHope_PetrifiedDebtor1_60e5372b-e0af-4c4e-a8af-c97d99574bca,(DIALOGRESOURCE)LOW_HouseOfHope_AD_PetrifiedDebtor1_8437638f-6a25-a638-a0e3-b0ebdc6f985f);
		DB_LOW_HouseOfHopePetrifiedDebtors((CHARACTER)S_LOW_HouseOfHope_PetrifiedDebtor2_9a85d4f1-47be-4c2c-b252-5179b496bc17,LOW_HouseOfHope_AD_PetrifiedDebtor2_7905d525-e809-21f1-c875-5af7ef45a106);
		DB_LOW_HouseOfHopePetrifiedDebtors((CHARACTER)S_LOW_HouseOfHope_PetrifiedDebtor3_579aa7d5-6220-4616-acfd-ee79a955b5fc,LOW_HouseOfHope_AD_PetrifiedDebtor3_218de3df-1ee6-f727-53a4-d55d3e470392);
		
		DB_LOW_HouseOfHope_Markers((TRIGGER)S_LOW_HouseOfHope_MarkerEntrance_96d32c91-a83f-436c-bd7d-3d39373d3a55,"LOW_HouseOfHope_Entrance");
		DB_LOW_HouseOfHope_Markers(S_LOW_HouseOfHope_MarkerFeastHall_647098ea-472c-4846-9909-e453276d17ca,"LOW_HouseOfHope_FeastHall");
		DB_LOW_HouseOfHope_Markers(S_LOW_HouseOfHope_MarkerPortalRoom_910170eb-0612-4850-bdd4-323de80ebc67,"LOW_HouseOfHope_PortalRoom");
		DB_LOW_HouseOfHope_Markers(S_LOW_HouseOfHope_MarkerBodoir_6863fe81-c64e-4dc3-8e45-80c757cbf76d,"LOW_HouseOfHope_BoudoirPoint");
		DB_LOW_HouseOfHope_Markers(S_LOW_HouseOfHope_MarkerArchive_9c6f574b-22b9-4ba9-bab5-0349a31dc75d,"LOW_HouseOfHope_ArchivePoint");
	}
	KB
	{
		IF
		TemplateUseStarted(_,(ITEMROOT)UNI_LOW_HouseOfHope_RichClock_64f0c416-3959-48cd-9b88-1aa07d423a32,_Clock)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)LOW_AD_HouseOfHope_RichClock_955e9648-6ac8-2b40-31f3-50d9f2e9c157,_Clock);
		
		//REGION Restoration Pond
		
		IF
		UseStarted(_Player,_Device)
		AND
		DB_LOW_HouseOfHope_RestorationDevice(_Device)
		AND
		QRY_HouseOfHope_CanUseRestorationDevice()
		THEN
		PROC_HouseOfHope_RestorationDevice_Activate();
		PlaySound(_Device,"Spell_Passive_Cast_Healing_DiscipleOfLife_L1to3");
		
		IF
		UseStarted(_Player,_Device)
		AND
		DB_LOW_HouseOfHope_RestorationDevice(_Device)
		AND
		NOT QRY_HouseOfHope_CanUseRestorationDevice()
		AND
		NOT DB_DialogSpeakers(_,_Player,_)
		THEN
		PROC_PlayCantUseItemAD(_Player);
		
		QRY
		QRY_HouseOfHope_CanUseRestorationDevice()
		AND
		NOT QRY_HouseOfHope_AnyoneInCombat()
		AND
		NOT DB_GlobalFlag((FLAG)LOW_HouseOfHope_Event_RaphaelAppeared_c25358e0-5ea1-929b-b511-6e745596d789)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_HouseOfHope_AnyoneInCombat()
		AND
		DB_Players(_Player)
		AND
		DB_Is_InCombat(_Player,_)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_HouseOfHope_RestorationDevice_Activate()
		AND
		DB_InRegion((CHARACTER)_Player,(TRIGGER)S_LOW_HouseOfHope_RestorationPoolArea_7f0289be-d004-4a9a-82d3-fd16fe6a6df9)
		THEN
		PlayEffect(_Player, (EFFECTRESOURCE)VFX_Spells_Cast_Intent_Healing_ShoutAoE_Impact_Root_Textkey_01_27357584-12f2-6267-08c2-cbec69d3ef10);
		RemoveSplatters(_Player);
		ApplyStatus(_Player,"TUT_RESTORATION",0.0,1,NULL_00000000-0000-0000-0000-000000000000);
		
		//END_REGION
		
		//REGION Portals comments
		
		IF
		DB_HouseOfHope_Portal_VFX(_Portal,_VFX,_Bone)
		THEN
		PROC_LoopEffect(_VFX,_Portal,"HoH_Portal","CTY_Main_A",_Bone);
		
		IF
		DB_LOW_HouseOfHope_Portal(_Portal,_Dialog,_)
		THEN
		DB_ItemDialog_NarratorAD(_Portal,_Dialog);
		
		IF
		UseFinished(_Player,_Portal,1)
		AND
		DB_LOW_HouseOfHope_Portal(_Portal,_,_)
		THEN
		DB_LOW_HouseOfHope_PortalComment(_Player,_Portal);
		
		IF
		AutomatedDialogRequestFailed(_Dialog,_)
		AND
		DB_LOW_HouseOfHope_Portal(_Portal,_Dialog,_)
		AND
		DB_LOW_HouseOfHope_PortalComment(_Player,_Portal)
		THEN
		NOT DB_LOW_HouseOfHope_PortalComment(_Player,_Portal);
		
		IF
		AutomatedDialogEnded(_Dialog,_)
		AND
		DB_LOW_HouseOfHope_Portal(_Portal,_Dialog,_)
		AND
		DB_LOW_HouseOfHope_PortalComment(_Player,_Portal)
		THEN
		NOT DB_LOW_HouseOfHope_PortalComment(_Player,_Portal);
		PROC_HouseOfHope_CommentOnPortalDestination(_Player,_Portal);
		
		PROC
		PROC_HouseOfHope_CommentOnPortalDestination((CHARACTER)_Player,(ITEM)_Portal)
		AND
		NOT DB_HouseOfHope_PerformedCommentsOnPortals(_Player,_Portal)
		AND
		DB_LOW_HouseOfHope_Portal(_Portal,_,_PAD)
		AND
		QRY_SpeakerIsAvailable(_Player,1,1)
		AND
		GetDistanceTo(_Player,_Portal,_Dist)
		AND
		_Dist <= 6.0
		THEN
		PROC_TryStartAD(_PAD,_Player);
		
		IF
		AutomatedDialogStarted(_PAD,_ID)
		AND
		DB_LOW_HouseOfHope_Portal(_Portal,_,_PAD)
		AND
		DB_DialogPlayers(_ID,_Player,_)
		THEN
		DB_HouseOfHope_PerformedCommentsOnPortals((CHARACTER)_Player,(ITEM)_Portal);
		
		//END_REGION
		
		//REGION Spirit Souls
		
		IF
		DB_LOW_HouseOfHope_SpiritSouls((CHARACTER)_Spirit,(TRIGGER)_Point,(TRIGGER)_Trigger,_)
		THEN
		PROC_CharacterDisableAllCrimes(_Spirit);
		SetOnStage(_Spirit,0);
		DB_OneShotPlayerTrigger(_Trigger);
		
		PROC
		PROC_OneShotTriggerEntered(_Player,_Trigger)
		AND
		DB_LOW_HouseOfHope_SpiritSouls(_Spirit,_Point,_Trigger,_AD)
		THEN
		PROC_LOW_HouseOfHope_SpiritSoulTriggered(_Player, _Spirit);
		
		PROC
		PROC_LOW_HouseOfHope_SpiritSoulTriggered((CHARACTER)_Player, (CHARACTER)_Spirit)
		THEN
		DB_LOW_HouseOfHope_SpiritSoulsTriggered(_Spirit);
		
		PROC
		PROC_LOW_HouseOfHope_SpiritSoulTriggered((CHARACTER)_Player, _)
		AND
		DB_LOW_HouseOfHope_SpiritSouls(_Spirit,_Point,_Trigger,_)
		THEN
		NOT DB_OneShotPlayerTrigger(_Trigger);
		
		PROC
		PROC_LOW_HouseOfHope_SpiritSoulTriggered((CHARACTER)_Player, (CHARACTER)_Spirit)
		THEN
		ObjectTimerLaunch(_Spirit,"LOW_HouseOfHope_SpiritADDelay",150000,1);
		
		PROC
		PROC_LOW_HouseOfHope_SpiritSoulTriggered((CHARACTER)_Player, (CHARACTER)_Spirit)
		THEN
		TimerLaunch("LOW_HouseOfHope_SpiritCooldown",15000);
		
		IF
		TimerFinished("LOW_HouseOfHope_SpiritCooldown")
		AND
		NOT DB_LOW_HouseOfHope_AlarmIsReady(1)
		AND
		DB_LOW_HouseOfHope_SpiritSouls(_Spirit,_Point,_Trigger,_)
		AND
		NOT DB_LOW_HouseOfHope_SpiritSoulsTriggered(_Spirit)
		THEN
		DB_OneShotPlayerTrigger(_Trigger);
		
		IF
		ObjectTimerFinished((CHARACTER)_Spirit,"LOW_HouseOfHope_SpiritADDelay")
		AND
		NOT DB_LOW_HouseOfHope_AlarmIsReady(1)
		AND
		DB_LOW_HouseOfHope_SpiritSoulsTriggered(_Spirit)
		THEN
		NOT DB_LOW_HouseOfHope_SpiritSoulsTriggered(_Spirit);
		
		PROC
		PROC_LOW_HouseOfHope_SpiritSoulTriggered((CHARACTER)_Player, (CHARACTER)_Spirit)
		THEN
		PROC_LOW_HouseOfHope_PlaySpiritAD((CHARACTER)_Spirit,_Player);
		
		PROC
		PROC_LOW_HouseOfHope_PlaySpiritAD((CHARACTER)_Spirit,(CHARACTER)_Player)
		AND
		DB_LOW_HouseOfHope_SpiritSouls(_Spirit,_Point,_Trigger,_AD)
		AND
		DB_LOW_HouseOfHope_SpiritSoulsPoofVFX(_Effect)
		THEN
		TeleportTo(_Spirit,_Point);
		PROC_Foop(_Spirit,_Effect);
		PROC_TryStartAD(_AD,_Spirit);
		SteerTo(_Spirit, _Player, 1);
		
		IF
		AutomatedDialogRequestFailed(_AD,_)
		AND
		DB_LOW_HouseOfHope_SpiritSouls(_Spirit,_,_,_AD)
		AND
		DB_LOW_HouseOfHope_SpiritSoulsPoofVFX(_Effect)
		THEN
		PROC_Poof(_Spirit,_Effect);
		
		IF
		AutomatedDialogEnded(_AD,_)
		AND
		DB_LOW_HouseOfHope_SpiritSouls(_Spirit,_,_,_AD)
		AND
		DB_LOW_HouseOfHope_SpiritSoulsPoofVFX(_Effect)
		THEN
		PROC_Poof(_Spirit,_Effect);
		
		IF
		DB_LOW_HouseOfHope_AlarmIsReady(1)
		AND
		DB_LOW_HouseOfHope_SpiritSouls(_Spirit,_,_,_)
		AND
		IsOnStage(_Spirit, 1)
		AND
		DB_LOW_HouseOfHope_SpiritSoulsPoofVFX(_Effect)
		THEN
		PROC_Poof(_Spirit, _Effect);
		
		IF
		DB_LOW_HouseOfHope_AlarmIsReady(1)
		AND
		DB_LOW_HouseOfHope_SpiritSouls(_Spirit,_Point,_Trigger,_AD)
		THEN
		NOT DB_LOW_HouseOfHope_SpiritSouls(_Spirit,_Point,_Trigger,_AD);
		
		
		PROC
		PROC_CharacterRegisterCrimeHandleIgnoresAfter(_ID, _Player, _, _, _Spirit)
		AND
		DB_LOW_HouseOfHope_SpiritSouls(_Spirit,_,_,_)
		AND
		DB_LOW_HouseOfHope_DebtorsIntoDemons(_Debtor,_)
		THEN
		CrimeIgnoreCrime(_ID, _Debtor);
		
		/*
		QRY
		QRY_CRIME_BlockRegisterCrime(_, _, _, _SoulVictim, _)
		AND
		DB_LOW_HouseOfHope_SpiritSouls(_Spirit,_Point,_Box,_AD)
		THEN
		DB_NOOP(1);
		*/
		
		IF
		AttackedBy((CHARACTER)_Spirit,_,_,_,_,_,_)
		AND
		DB_LOW_HouseOfHope_SpiritSouls(_Spirit,_Point,_Box,_AD)
		AND
		DB_LOW_HouseOfHope_SpiritSoulsPoofVFX(_Effect)
		THEN
		PROC_Poof(_Spirit, _Effect);
		NOT DB_LOW_HouseOfHope_SpiritSouls(_Spirit,_Point,_Box,_AD);
		
		
		
		
		//END_REGION
		
		IF
		DB_LOW_HouseOfHopePetrifiedDebtors(_Debtor,_AD)
		THEN
		SetHasDialog(_Debtor,1);
		
		IF
		DialogStartRequested((CHARACTER)_Debtor,_)
		AND
		DB_LOW_HouseOfHopePetrifiedDebtors(_Debtor,_AD)
		THEN
		PROC_TryStartAD(_AD,_Debtor);
		
		IF
		StatusRemoved((CHARACTER)_Debtor,"PETRIFIED",_,_)
		AND
		DB_LOW_HouseOfHopePetrifiedDebtors(_Debtor,_)
		THEN
		Die(_Debtor,DEATHTYPE.Disintegrate,NULL_00000000-0000-0000-0000-000000000000,0,1);
		
		IF
		Dying(_Debtor)
		AND
		DB_LOW_HouseOfHopePetrifiedDebtors(_Debtor,_)
		THEN
		SetOnStage(_Debtor,0);
		
		IF
		DB_LOW_HouseOfHope_Markers((TRIGGER)_Trigger,_)
		THEN
		TriggerRegisterForPlayers(_Trigger);
		
		IF
		EnteredTrigger(_Player,_Trigger)
		AND
		DB_LOW_HouseOfHope_Markers((TRIGGER)_Trigger,_Marker)
		THEN
		PROC_ShowMarker(_Player,_Marker);
		
		IF
		UseFinished(_Player,(ITEM)S_DOOR_HoH_HatchToEngine_1b108f4d-190c-4d17-aabe-80e8aa9e7089,0)
		AND
		NOT DB_OnlyOnce("LOW_HouseOfHope_UnlockDoorToPrison")
		THEN
		RequestActiveRoll(_Player,S_DOOR_HoH_HatchToEngine_1b108f4d-190c-4d17-aabe-80e8aa9e7089,"Strength",(DIFFICULTYCLASS)Act3_Easy_5028066b-6ea0-4a6a-9e3e-53bee62559a7,"LOW_HouseOfHope_DoorToPrison");
		
		IF
		RollResult("LOW_HouseOfHope_DoorToPrison",_Player,S_DOOR_HoH_HatchToEngine_1b108f4d-190c-4d17-aabe-80e8aa9e7089,1,1,_)
		AND
		QRY_OnlyOnce("LOW_HouseOfHope_UnlockDoorToPrison")
		THEN
		Unlock(S_DOOR_HoH_HatchToEngine_1b108f4d-190c-4d17-aabe-80e8aa9e7089,_Player);
		PROC_TryStartAD((DIALOGRESOURCE)GLO_AD_MechanicalClunk_a96814b5-9d5b-cf71-b0c3-39d4aea3dfd6,S_DOOR_HoH_HatchToEngine_1b108f4d-190c-4d17-aabe-80e8aa9e7089);
		
		IF
		UseFinished(_Player,(ITEM)S_LOW_HouseOfHope_PrisonHatchLever_232f708f-75c5-4d66-a30a-2aa08bf62c02,_)
		AND
		NOT DB_OnlyOnce("LOW_HouseOfHope_UnlockDoorToPrison")
		THEN
		Unlock(S_DOOR_HoH_HatchToEngine_1b108f4d-190c-4d17-aabe-80e8aa9e7089,_Player);
		PROC_TryStartAD((DIALOGRESOURCE)GLO_AD_MechanicalClunk_a96814b5-9d5b-cf71-b0c3-39d4aea3dfd6,S_TELEPORT_Ladder_HoHEngines_72d78125-4397-4557-8f90-290289349c19);
		DB_OnlyOnce("LOW_HouseOfHope_UnlockDoorToPrison");
		
		PROC
		PROC_BlockUseOfItem(_Player,(ITEM)S_TELEPORT_Ladder_HoHEngines_72d78125-4397-4557-8f90-290289349c19)
		AND
		DB_Players(_Player)
		AND
		NOT DB_OnlyOnce("LOW_HouseOfHope_UnlockDoorToPrison")
		THEN
		DB_CustomUseItemResponse(_Player,(ITEM)S_TELEPORT_Ladder_HoHEngines_72d78125-4397-4557-8f90-290289349c19,0);
		PROC_PlayCantUseItemAD(_Player);
		
		IF
		DB_LOW_HouseOfHope_CanSaveHope(1)
		THEN
		Unlock(S_DOOR_HoH_HatchToEngine_1b108f4d-190c-4d17-aabe-80e8aa9e7089);
		PROC_TryStartAD((DIALOGRESOURCE)GLO_AD_MechanicalClunk_a96814b5-9d5b-cf71-b0c3-39d4aea3dfd6,S_TELEPORT_Ladder_HoHEngines_72d78125-4397-4557-8f90-290289349c19);
		DB_OnlyOnce("LOW_HouseOfHope_UnlockDoorToPrison");
	}
	EXIT
	{
	}
}
Goal(609).Title("Act3b_LOW_HouseOfHope_Hideout");
Goal(609)
{
	INIT
	{
		SetCanInteract((ITEM)S_LOW_HouseOfHope_ClosetDoor_b38ebbed-e087-474b-9647-09688c60b57b,0);
	}
	KB
	{
		IF
		RollResult("LOW_HouseOfHope_SecretDoorKeyhole",_Player,S_LOW_HouseOfHope_SecretStashKeyhole_4fa176d6-ca4b-42bc-b4a5-772e130f8595,0,1,_)
		THEN
		CreateExplosion(_Player,"Projectile_SHA_EntrancePuzzle_RingPushBack", -1,S_LOW_HouseOfHope_SecretStashKeyhole_4fa176d6-ca4b-42bc-b4a5-772e130f8595);
		PROC_TryStartAD((DIALOGRESOURCE)LOW_HouseOfHope_AD_InfernalGem_651f91a7-4dc7-d7ac-7a2a-19009141196c,S_LOW_HouseOfHope_SecretStashKeyhole_4fa176d6-ca4b-42bc-b4a5-772e130f8595);
		
		IF
		UseFinished(_Player,(ITEM)S_LOW_HouseOfHope_SecretStashKeyhole_4fa176d6-ca4b-42bc-b4a5-772e130f8595,_)
		AND
		DB_OnlyOnce("LOW_HouseOfHope_SecretDoorKeyhole_Transformation")
		THEN
		RequestActiveRoll(_Player,S_LOW_HouseOfHope_SecretStashKeyhole_4fa176d6-ca4b-42bc-b4a5-772e130f8595,"Arcana",(DIFFICULTYCLASS)Act3_Hard_6298329e-255c-4826-9209-e911873b64e7,"LOW_HouseOfHope_SecretDoorKeyhole");
		
		IF
		RollResult("LOW_HouseOfHope_SecretDoorKeyhole",_Player,S_LOW_HouseOfHope_SecretStashKeyhole_4fa176d6-ca4b-42bc-b4a5-772e130f8595,1,1,_)
		AND
		DB_OnlyOnce("LOW_HouseOfHope_SecretDoorKeyhole_Transformation")
		AND
		QRY_OnlyOnce("LOW_HouseOfHope_SecretDoorKeyhole_Unlock")
		THEN
		DebugText(S_LOW_HouseOfHope_SecretStashKeyhole_4fa176d6-ca4b-42bc-b4a5-772e130f8595,"OPEN");
		PlayEffect(S_LOW_HouseOfHope_SecretStashKeyhole_4fa176d6-ca4b-42bc-b4a5-772e130f8595,(EFFECTRESOURCE)VFX_Script_Illusion_Perception_Check_Overlay_01_b8fe40e4-b49b-f7b1-25ba-f5b97341a16d,"",1.0);
		SetCanInteract(S_LOW_HouseOfHope_SecretStashKeyhole_4fa176d6-ca4b-42bc-b4a5-772e130f8595,0);
		TimerLaunch("LOW_HouseOfHope_SecretDoorKeyhole_UnlockTimer",800);
		PROC_CameraShakeAroundObject(S_LOW_HouseOfHope_SecretStashKeyhole_4fa176d6-ca4b-42bc-b4a5-772e130f8595,250,5.0);
		
		IF
		TimerFinished("LOW_HouseOfHope_SecretDoorKeyhole_UnlockTimer")
		THEN
		PROC_ItemUnlockAndOpen((ITEM)S_LOW_HouseOfHope_ClosetDoor_b38ebbed-e087-474b-9647-09688c60b57b);
		SetCanInteract(S_LOW_HouseOfHope_ClosetDoor_b38ebbed-e087-474b-9647-09688c60b57b,1);
		SetOnStage(S_LOW_HouseOfHope_SecretStashKeyhole_4fa176d6-ca4b-42bc-b4a5-772e130f8595,0);
		
		IF
		TimerFinished("LOW_HouseOfHope_SecretDoorKeyhole_UnlockTimer")
		AND
		DB_Players(_Player)
		THEN
		PROC_HideMarker(_Player,"LOW_HouseOfHope_SecretStash");
		
		IF
		UseFinished(_Player,(ITEM)S_LOW_HouseOfHope_SecretStashKeyhole_4fa176d6-ca4b-42bc-b4a5-772e130f8595,_)
		AND
		NOT DB_OnlyOnce("LOW_HouseOfHope_SecretDoorKeyhole_Transformation")
		THEN
		RequestActiveRoll(_Player,S_LOW_HouseOfHope_SecretStashKeyhole_4fa176d6-ca4b-42bc-b4a5-772e130f8595,"Wisdom",(DIFFICULTYCLASS)Act3_Easy_5028066b-6ea0-4a6a-9e3e-53bee62559a7,"LOW_HouseOfHope_SecretDoorKeyhole");
		
		IF
		RollResult("LOW_HouseOfHope_SecretDoorKeyhole",_Player,S_LOW_HouseOfHope_SecretStashKeyhole_4fa176d6-ca4b-42bc-b4a5-772e130f8595,1,1,_)
		AND
		QRY_OnlyOnce("LOW_HouseOfHope_SecretDoorKeyhole_Transformation")
		THEN
		DebugText(S_LOW_HouseOfHope_SecretStashKeyhole_4fa176d6-ca4b-42bc-b4a5-772e130f8595,"TRANSFORM");
		Transform(S_LOW_HouseOfHope_SecretStashKeyhole_4fa176d6-ca4b-42bc-b4a5-772e130f8595,QUEST_LOW_HoH_InfernalDiamond_Socket_Glow_e692fe33-f719-459a-90cf-497ccd22e48d,Physical_4acc6277-6dcd-4110-9450-b9379beaedac);
		PlayEffect(S_LOW_HouseOfHope_SecretStashKeyhole_4fa176d6-ca4b-42bc-b4a5-772e130f8595,(EFFECTRESOURCE)VFX_Script_Illusion_Perception_Check_Overlay_01_b8fe40e4-b49b-f7b1-25ba-f5b97341a16d,"",1.0);
		
		IF
		GameBookInterfaceClosed((ITEM)S_LOW_HouseOfHope_Book_ArchivingTreasures_fadeaa2a-71b3-895a-5a05-3097fa0fce50,_Player)
		AND
		NOT DB_OnlyOnce("LOW_HouseOfHope_SecretDoorKeyhole_Unlock")
		AND
		QRY_OnlyOnce("LOW_HouseOfHope_SecretStash_MapMarker")
		THEN
		PROC_ShowMarker(_Player,"LOW_HouseOfHope_SecretStash");
	}
	EXIT
	{
	}
}
