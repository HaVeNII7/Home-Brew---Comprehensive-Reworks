		DB_GLO_Backgrounds_Goal((TAG)HAUNTED_ONE_ce00b3b6-238e-4524-851b-3d1f2d2b1189, "Act1_HauntedOne_SidedAgainstTieflings", 345c9e42-5758-44be-ba56-6012cd5f8c91);
	}
	KB
	{
		//TODO: ADs when fighting gate defenders when you betray them.
		
		IF
		FlagSet(DEN_Refugees_State_LeadersAreDead_1e6a42ed-8313-4f46-57e2-20dbdb2df923, NULL_00000000-0000-0000-0000-000000000000,_)
		THEN
		GoalCompleted;
		
		IF
		FlagSet(DEN_AttackOnDen_State_RaiderVictory_abe1bce8-c234-4afe-a490-76210d98a078, _, _)
		AND
		DB_Players(_Player)
		AND
		QRY_DEN_IsInDen(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act1_HauntedOne_SidedAgainstTieflings");
		
		IF
		DB_GlobalFlag(DEN_AttackOnDen_Event_Start_c641da6a-b3f5-4873-bd34-c53768d30d6f)
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_DenVictory_71c7f23e-3ff1-c9b8-3ef5-d75fa1b42c8d)
		AND
		DB_Players(_Player)
		AND
		QRY_DEN_IsInDen(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act1_HauntedOne_SidedAgainstGoblins");
		
		//REGION INIT
		
		IF
		DB_DEN_AttackOnDen_MeetingDialogs(_Dialog, _)
		THEN
		DB_DialogBlockAttackButton(_Dialog);
		DB_DialogBlockTradeButton(_Dialog);
		
		IF
		DB_DEN_AttackOnDen_VictoryDialogs(_, _Dialog)
		THEN
		DB_DialogBlockAttackButton(_Dialog);
		DB_DialogBlockTradeButton(_Dialog);
		
		PROC
		PROC_DEN_AttackOnDen_HideEventObjects()
		AND
		DB_DEN_AttackOnDen_PrepObjects(_Object)
		AND
		IsInInventory(_Object, 0)
		THEN
		SetOnStage(_Object, 0);
		
		PROC
		PROC_DEN_AttackOnDen_HideEventObjects()
		AND
		DB_DEN_AttackOnDen_LeaveObjects(_Object)
		THEN
		SetOnStage(_Object, 0);
		
		IF
		DB_DEN_AttackOnDen_DruidRaiders(_Raider)
		THEN
		SetOnStage(_Raider, 0);
		//END_REGION
		
		//REGION NPC and situation participation updates
		
		PROC
		PROC_DEN_AttackOnDen_RemoveFromAttack((CHARACTER)_NPC)
		AND
		DB_DEN_NPC(_NPC, _Role, _AttackOnDenDialog)
		AND
		_Role != ""
		THEN
		DB_DEN_NPC(_NPC, "", (DIALOGRESOURCE)NULL_00000000-0000-0000-0000-000000000000);
		NOT DB_DEN_NPC(_NPC, _Role, _AttackOnDenDialog);
		
		
		//Remove Arka and Memnos from the attack if they moved out of the den at conclusion of Captured Goblin.
		IF
		FlagSet(DEN_CapturedGoblin_Event_GuardsLeft_b79734e0-8efc-228f-9a44-50641da7c55a, _, _) // flagType: Global
		THEN
		PROC_DEN_AttackOnDen_RemoveFromAttack(S_DEN_Griefling_7ce0afc2-e8f2-4f2e-82d8-27df98acc3d8);
		PROC_DEN_AttackOnDen_RemoveFromAttack(S_DEN_GrieflingFriend_c3334ee5-38dc-4197-aacc-4aa55803ff52);
		
		//END_REGION
		
		
		//REGION Starting conditions of situation
		
		PROC
		PROC_LongRest()
		AND
		DB_GlobalFlag(GLO_AttackOnDen_State_RaidReady_eb361773-da88-dee4-f4c8-a22acae60948)
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_StartSetup")
		THEN
		DB_ExecuteInLevel("DEN_AttackOnDen_StartSetup","WLD_Main_A");
		
		PROC
		PROC_ExecuteInLevel("DEN_AttackOnDen_StartSetup","WLD_Main_A")
		THEN
		PROC_State_IfCurrentProgressElse(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_LockdownComplete", "DEN_State_LockdownAttackOnDen", "DEN_State_AttackOnDen");
		//END_REGION
		
		//REGION AoD Lockdown
		
		PROC
		PROC_State_Changed(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_LockdownAttackOnDen")
		THEN
		PROC_DEN_AttackOnDen_LockdownStart();
		
		PROC
		PROC_DEN_AttackOnDen_LockdownStart()
		THEN
		PROC_SetRelationMutual((FACTION)ACT1_DEN_AttackRaiders_Fighters_bfdc773b-6521-4fd1-3784-3d1404f1b2f5, (FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, 50);
		PROC_SetRelationMutual((FACTION)ACT1_DEN_AttackRaiders_Standby_aca56eff-f292-1b69-8f22-ec96197b8d25, (FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, 50);
		PROC_TriggerRegisterForPlayers(S_DEN_LockdownAttackOnDenArea_41d767e2-cc0e-4c16-9107-0a3f3c46f191);
		PROC_DEN_AttackOnDen_LockdownStart_JournalHook();
		
		PROC
		PROC_DEN_AttackOnDen_LockdownStart()
		AND
		DB_DEN_AttackOnDen_Raiders(_Raider, _, _, _)
		AND
		DB_CRIME_Guards_RegionGuard(_Region, _Pool, _Raider)
		THEN
		NOT DB_CRIME_Guards_RegionGuard(_Region, _Pool, _Raider);
		
		PROC
		PROC_DEN_AttackOnDen_LockdownStart_JournalHook()
		THEN
		DB_DEN_AttackOnDen_AwaitingLockdownCombat(1);
		
		PROC
		PROC_DEN_AttackOnDen_LockdownStart()
		AND
		DB_DEN_AttackOnDen_LockdownRaiders(_Raider, _Position)
		AND
		NOT DB_Defeated(_Raider)
		THEN
		SetOnStage(_Raider, 1);
		SetCanJoinCombat(_Raider, 1);
		TeleportTo(_Raider, _Position, "");
		
		IF
		DB_InRegion(_Player, S_DEN_LockdownAttackOnDenArea_41d767e2-cc0e-4c16-9107-0a3f3c46f191)
		AND
		DB_Players(_Player)
		AND
		NOT DB_HiddenCharacters(_Player, _)
		AND
		NOT DB_CantTalk(_Player)
		AND
		NOT DB_OnlyOnce("DEN_AttackOnDen_LockdownFight")
		AND
		QRY_StartDialog(DEN_AttackOnDen_LockdownDrow_04fcdaa3-1e06-1587-d923-ced57bac82a9, S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, _Player)
		THEN
		DB_OnlyOnce("DEN_AttackOnDen_LockdownFight");
		PROC_TriggerUnregisterForPlayers(S_DEN_LockdownAttackOnDenArea_41d767e2-cc0e-4c16-9107-0a3f3c46f191);
		
		IF
		DB_InRegion(_Player, S_DEN_LockdownAttackOnDenArea_41d767e2-cc0e-4c16-9107-0a3f3c46f191)
		AND
		DB_Players(_Player)
		AND
		NOT DB_HiddenCharacters(_Player, _)
		AND
		DB_Is_WildShaped(_Player)
		AND
		NOT DB_OnlyOnce("DEN_AttackOnDen_LockdownFight")
		THEN
		DB_OnlyOnce("DEN_AttackOnDen_LockdownFight");
		PROC_TriggerUnregisterForPlayers(S_DEN_LockdownAttackOnDenArea_41d767e2-cc0e-4c16-9107-0a3f3c46f191);
		SetImmortal(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, 0);
		PROC_SetRelationMutual((FACTION)ACT1_DEN_AttackRaiders_Fighters_bfdc773b-6521-4fd1-3784-3d1404f1b2f5, (FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, 0);
		PROC_SetRelationMutual((FACTION)ACT1_DEN_AttackRaiders_Standby_aca56eff-f292-1b69-8f22-ec96197b8d25, (FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, 0);
		PROC_DEN_AttackOnDen_LockdownCombat_JournalHook();
		
		IF
		DialogEnded((DIALOGRESOURCE)DEN_AttackOnDen_MindMeldAfterCombat_861cbf47-f9ab-f0c4-5ff7-821eb491bbaa, _)
		AND
		IsImmortal((CHARACTER)S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, 1)
		THEN
		SetImmortal(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, 0);
		
		IF
		DialogEnded(DEN_AttackOnDen_LockdownDrow_04fcdaa3-1e06-1587-d923-ced57bac82a9, _)
		THEN
		SetImmortal(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, 0);
		PROC_SetRelationMutual((FACTION)ACT1_DEN_AttackRaiders_Fighters_bfdc773b-6521-4fd1-3784-3d1404f1b2f5, (FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, 0);
		PROC_SetRelationMutual((FACTION)ACT1_DEN_AttackRaiders_Standby_aca56eff-f292-1b69-8f22-ec96197b8d25, (FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, 0);
		PROC_DEN_AttackOnDen_LockdownCombat_JournalHook();
		
		IF
		AttackedBy(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b,_Player,_,_,_,_,_)
		AND
		DB_DEN_AttackOnDen_AwaitingLockdownCombat(1)
		THEN
		PROC_DEN_AttackOnDen_LockdownCombat_JournalHook();
		
		PROC
		PROC_DEN_AttackOnDen_LockdownCombat_JournalHook()
		THEN
		NOT DB_DEN_AttackOnDen_AwaitingLockdownCombat(1);
		
		//END_REGION
		
		//REGION Setting up main situation
		
		PROC
		PROC_State_Changed(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_AttackOnDen")
		THEN
		DB_LeaveCamp_ForbiddenReturnArea("WLD_Main_A", (TRIGGER)S_DEN_DruidLair_SUB_a9794f19-187a-4d79-b739-443548411d29, (TRIGGER)S_DEN_WaypointPos_cdd91969-67d0-454e-b27b-cf34e542956b);
		DB_LeaveCamp_ForbiddenReturnArea("WLD_Main_A", (TRIGGER)S_DEN_DruidVault_SUB_f4c22466-5963-4192-b939-f1056f4f806a, (TRIGGER)S_DEN_WaypointPos_cdd91969-67d0-454e-b27b-cf34e542956b);
		PROC_DEN_AttackOnDen_Start();
		PROC_DEN_AttackOnDen_Start_JournalHook();
		
		PROC
		PROC_State_Changed(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_AttackOnDen")
		AND
		DB_DEN_PlayerInDen(_Player)
		AND
		DB_DEN_InDenTriggers(_Region)
		AND
		DB_InRegion(_Player, _Region)
		AND
		DB_DEN_AttackOnDen_TransitionDialog(_Region, _Dialog)
		AND
		NOT QRY_StartDialogCustom_Fixed(_Dialog, _Player, 0, 0, 0, 0)
		AND
		_Dialog == DEN_AttackOnDen_DruidTransition_a3b23114-ecc0-59bd-2ff5-1faa501b89e8
		THEN
		TeleportTo(_Player, S_DEN_LairMainOutPoint_624be120-9ee0-496a-8f88-17a3bf84a320, "", 1, 1, 1);
		
		//Force characters out of the druid areas.
		IF
		DialogActorJoined(DEN_AttackOnDen_DruidTransition_a3b23114-ecc0-59bd-2ff5-1faa501b89e8, _, _Player, _)
		THEN
		TeleportTo(_Player, S_DEN_LairMainOutPoint_624be120-9ee0-496a-8f88-17a3bf84a320, "", 1, 1, 1);
		
		PROC
		PROC_DEN_AttackOnDen_Start_JournalHook()
		THEN
		DB_NOOP(1);
		
		//These guys are not region guards anymore
		PROC
		PROC_DEN_AttackOnDen_Start()
		AND
		DB_DEN_AttackOnDen_Raiders(_Raider, _, _, _)
		AND
		DB_CRIME_Guards_RegionGuard(_Region, _Pool, _Raider)
		THEN
		NOT DB_CRIME_Guards_RegionGuard(_Region, _Pool, _Raider);
		
		PROC
		PROC_DEN_AttackOnDen_Start()
		AND
		DB_DEN_NPC(_Druid, "Lair", _)
		AND
		NOT DB_DEN_AttackOnDen_DruidAnimals(_Druid)
		AND
		_Druid != S_DEN_DruidOpposed_322cf8d2-32ee-453f-987e-f12b32652b5d
		THEN
		DB_DEN_AttackOnDen_BlockLair(1);
		NOT DB_DEN_AttackOnDen_EmptyLair(1);
		
		PROC
		PROC_DEN_AttackOnDen_Start()
		AND
		DB_DEN_AttackOnDen_EmptyLair(1)
		THEN
		PROC_DEN_AttackOnDen_RemoveFromAttack(S_DEN_ExcitedBoar_5e856a8e-957a-49b1-8ec7-f430984e08ca);
		PROC_DEN_AttackOnDen_RemoveFromAttack(S_DEN_ZenBear_d4d4bfd2-9639-45bc-a256-2f079e53db29);
		PROC_DEN_AttackOnDen_RemoveFromAttack(S_DEN_ElevatorBear_04b7ef23-1002-4682-b962-33a2328bcd5c);
		
		PROC
		PROC_DEN_AttackOnDen_Start()
		THEN
		RemoveSurfaceLayer(S_DEN_KanonPushbackPos_bb550eee-2a36-4a47-902b-193dcfb6f5fa, "Ground", 20.0);
		
		PROC
		PROC_DEN_AttackOnDen_Start()
		AND
		NOT DB_OffStage((CHARACTER)S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523)
		THEN
		SetOnStage(S_DEN_BugbearNinja_4cb29070-a33c-4253-9f57-18d1c9a88523, 0);
		RemoveSurfaceLayer(S_DEN_KanonPushbackPos_bb550eee-2a36-4a47-902b-193dcfb6f5fa, "Ground", 20.0);
		
		PROC
		PROC_DEN_AttackOnDen_Start()
		AND
		DB_DEN_AttackOnDen_EmptyLair(1)
		AND
		DB_DEN_NPC(S_DEN_DruidOpposed_322cf8d2-32ee-453f-987e-f12b32652b5d, "Lair", _)
		AND
		DB_DEN_DruidAttack_OpposedDruids(_Druid, _)
		AND
		DB_DEN_NPC(_Druid, "Lair", _Dialog)
		THEN
		NOT DB_DEN_NPC(_Druid, "Lair", _Dialog);
		DB_DEN_NPC(_Druid, "Cave", _Dialog);
		
		PROC
		PROC_DEN_AttackOnDen_Start()
		AND
		DB_DEN_AttackOnDen_Raiders(_Raider, _, _, _)
		THEN
		SetOnStage(_Raider, 1);
		SetCanJoinCombat(_Raider, 0);
		TeleportTo(_Raider, S_DEN_AttackOnDen_DebugHoldingPoint_f922846c-1103-4ec2-aab7-a23b1d2ed7e8, "");
		DB_DEN_AttackOnDen_BlockOwned(_Raider, 1);
		PROC_CharacterDisableAllCrimes(_Raider);
		
		PROC
		PROC_DEN_AttackOnDen_Start()
		AND
		DB_DEN_AttackOnDen_GoblinBarrels(_, _Raider)
		THEN
		DB_DEN_AttackOnDen_BlockOwned(_Raider, 1);
		PROC_CharacterDisableAllCrimes(_Raider);
		
		PROC
		PROC_DEN_AttackOnDen_Start()
		THEN
		SetOnStage(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, 1);
		SetCanJoinCombat(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, 0);
		TeleportTo(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, S_DEN_AttackOnDen_DebugHoldingPoint_f922846c-1103-4ec2-aab7-a23b1d2ed7e8, "");
		
		PROC
		PROC_DEN_AttackOnDen_Start()
		AND
		DB_DEN_AttackOnDen_EmptyLair(1)
		AND
		NOT DB_DEN_NPC(S_DEN_DruidOpposed_322cf8d2-32ee-453f-987e-f12b32652b5d, _, _)
		THEN
		PROC_DEN_AttackOnDen_RemoveFromAttack(S_DEN_PetWolf_63471e30-7413-4496-97de-0bdf67c2f753);
		
		PROC
		PROC_DEN_AttackOnDen_Start()
		AND
		DB_GlobalFlag(DEN_Prodigy_State_Staying_479db0b1-cc1b-78bf-3e7b-9840747fbd4f)
		AND
		NOT DB_Defeated(S_GLO_Prodigy_b6a3a9e9-b6eb-4c19-ab3f-4c431178fe1b)
		AND
		NOT DB_Defeated(S_GLO_ProdigyBrother_d0187724-c0e2-4019-a01d-a03ee8153f1b)
		AND
		NOT DB_Defeated(S_GLO_ProdigySister_44d09b0b-0568-456c-b18d-559a0a3f981d)
		THEN
		SetFlag(DEN_Prodigy_State_ArgumentDone_9a1847e7-2249-0145-9294-0e6c87034e14, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		PROC
		PROC_DEN_AttackOnDen_Start()
		AND
		DB_DEN_NPC(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, "Gate", _)
		THEN
		SetEntityEvent(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, "DEN_States_Enable", 1);
		SetDualEntityEvent(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, S_DEN_WyllAttackGatePos_e386c441-83ab-4dcb-aab8-2f5c1feb14f8, "DEN_AttackOnDen_UpdatePosition");
		
		PROC
		PROC_DEN_AttackOnDen_Start()
		AND
		DB_DEN_NPC(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, "Gate", _)
		THEN
		PROC_DEN_AddOrUpdateDenNPC(S_DEN_Griefling_7ce0afc2-e8f2-4f2e-82d8-27df98acc3d8, "Cave", DEN_AttackOnDen_Griefling_4dc17e35-32f2-427d-c935-3171dc2fdebf);
		SetDualEntityEvent(S_DEN_Griefling_7ce0afc2-e8f2-4f2e-82d8-27df98acc3d8, S_DEN_AttackWyllPos_c0bfe2a1-dbb3-4ce8-a6e7-744ef3edd3cc, "DEN_AttackOnDen_UpdatePosition");
		
		PROC
		PROC_DEN_AttackOnDen_Start()
		THEN
		PROC_RemoveOneShotTrigger(S_DEN_ApproachingGatesVB_211654fb-d641-4d84-a8f6-52b32de8320a);
		SetFaction(S_DEN_BackupLeader_b304e07d-019c-4ec6-b5ea-c4ccb29ed892, ACT1_DEN_AttackOnDen_Gate_4ec9e6b5-f0c2-e413-489c-1f6c10a1a50f);
		SetFlag(DEN_GruntingKid_State_HatchOpened_0ff8129d-c04b-4b7d-bf9b-60b55b40fbcc,NULL_00000000-0000-0000-0000-000000000000);
		SetFlag(DEN_RaidingParty_Event_GateIsOpened_735e0e81-bd67-eb67-87ac-40da4c3e6c49, NULL_00000000-0000-0000-0000-000000000000, 0);	//flagType: Global
		SetFlag(DEN_AttackOnDen_State_UnderAttack_4ebba932-b9cf-41c5-b897-e77a63b93511, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		SetFlag(DEN_General_State_KanonTryBurial_7edf4538-ae5d-4fdd-968d-9ce4f6c63d7f, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetEntityEvent(S_DEN_Trainee_001_1f839ad2-2bcb-47d2-8de9-db7a1fb5d67f, "DEN_AttackOnDen_StopTrainee");
		SetEntityEvent(S_DEN_Trainee_002_bd7f31a6-98e8-46cd-97be-4347fa45d387, "DEN_AttackOnDen_StopTrainee");
		SetEntityEvent(S_DEN_Trainee_003_71bdc11d-b488-427d-8453-632e91178c7e, "DEN_AttackOnDen_StopTrainee");
		
		//Set the repaired gate on stage if it was destroyed prior to the situation.
		PROC
		PROC_DEN_AttackOnDen_Start()
		AND
		NOT DB_DEN_GateInUse(_)
		THEN
		DB_DEN_GateInUse((ITEM)S_DEN_RepairedGate_de5708cf-758e-47d2-aef7-b7d7162ba69e);
		SetFlag(DEN_AttackOnDen_Event_GateRepaired_44cd8f5e-c2b4-47ce-8443-5f613ec95c7d, NULL_00000000-0000-0000-0000-000000000000, 0);	// flagType: Global
		SetOnStage(S_DEN_RepairedGate_de5708cf-758e-47d2-aef7-b7d7162ba69e, 1);
		SetOnStage(S_DEN_Gate_567055bf-ffeb-4236-8a61-e53877397fde, 0);
		
		
		//When the situation starts, open the Gate of the Den and set a flag to setup all NPCs for it.
		PROC
		PROC_DEN_AttackOnDen_Start()
		THEN
		PROC_DeclareCounter("DEN_AttackOnDen_Tieflings");
		PROC_DeclareCounter("DEN_AttackOnDen_GateDefenders");
		PROC_SceneOver("DEN_BugbearScout_Ambush");
		PROC_SceneOver("DEN_SnakeCourt");
		PROC_SceneOver("DEN_GuardedEntrance_ParentsScene");
		SetVisible(S_DEN_GruntingKidHatch_4309dd70-89b1-44c7-a000-5790125ae6d1, 1);
		Unlock(S_DEN_GruntingKidHatch_4309dd70-89b1-44c7-a000-5790125ae6d1);
		PROC_RemoveDialog(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b);
		DB_Dialogs(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, DEN_AttackOnDen_Drow_84abf1c9-de21-4db1-cbb1-0046faf2fc45);
		//TODO: Refactor next three lines. Make better transition for apprentice that avoids positional issues.
		SetForceUpdate(S_DEN_Gatekeeper_847717b3-82eb-45a7-b875-78665c12ce9a, 0);
		PurgeOsirisQueue(S_DEN_Apprentice_7cabf226-e34b-4556-8903-a45d0fe26caf);
		PurgeOsirisQueue(S_DEN_Gatekeeper_847717b3-82eb-45a7-b875-78665c12ce9a);
		PROC_TriggerRegisterForPlayers(S_DEN_LeaderAttackSpotArea_41be541d-570b-447a-9636-6cbab92bbde2);
		PROC_TriggerRegisterForPlayers(S_DEN_AttackOnDenEntranceArea_b45cb766-c7a2-44c8-bd73-91779cd8ce78);
		SetFlag((FLAG)DEN_AttackOnDen_Event_Start_c641da6a-b3f5-4873-bd34-c53768d30d6f, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		SetFlag((FLAG)DEN_AttackOnDen_Event_PrepareNPCsForSetup_5e82ea1f-c31c-4929-a7a0-3a2db9b9b705, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		PROC_DEN_Gate_OpenOrCloseGate(1);
		
		
		//Make all objects at the gates visible if there are tieflings to prepare the defenses.
		PROC
		PROC_DEN_AttackOnDen_Start()
		AND
		NOT DB_GlobalFlag(DEN_GroveConflict_State_TooLowTieflings_ed9fe6c4-5037-4f74-968c-a166aeb29d9c)
		AND
		DB_DEN_AttackOnDen_PrepObjects(_Object)
		THEN
		SetOnStage(_Object, 1);
		
		PROC
		PROC_DEN_AttackOnDen_Start()
		AND
		NOT DB_GlobalFlag(DEN_GroveConflict_State_TooLowTieflings_ed9fe6c4-5037-4f74-968c-a166aeb29d9c)
		AND
		DB_DEN_AttackOnDen_LeaveObjects(_Object)
		THEN
		SetOnStage(_Object, 1);
		
		PROC
		PROC_DEN_AttackOnDen_Start()
		AND
		DB_Defeated(S_DEN_Bard_4a405fba-3000-4c63-97e5-a8001ebb883c)
		AND
		DB_Defeated(S_DEN_CharmedKid_3b92c689-6024-4446-a6c9-584e9e8d77ca)
		THEN
		SetFlag(DEN_AttackOnDen_State_NoStoryteller_cd7198cb-4f9e-5239-3211-9aface6587b6, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		//Clear all NPCs of current instructions.
		PROC
		PROC_DEN_AttackOnDen_Start()
		AND
		DB_DEN_NPC(_NPC, _Role, _AttackOnDenDialog)
		AND
		NOT DB_Defeated(_NPC)			
		THEN
		RemoveHarmfulStatuses(_NPC);
		LeaveCombat(_NPC);
		PROC_ForceStopDialog(_NPC);
		PurgeOsirisQueue(_NPC);
		DB_DEN_AttackOnDen_BlockOwned(_NPC, 0);
		PROC_DEN_AttackOnDen_SetupNPC(_NPC, _Role, _AttackOnDenDialog);
		
		//Remove Wyll if he's defeated during the setup.
		PROC
		PROC_DEN_AttackOnDen_Start()
		AND
		DB_DEN_NPC(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, _Role, _AttackOnDenDialog)
		AND
		DB_Defeated(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)		
		THEN
		PROC_DEN_AttackOnDen_SetupNPC(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, "", _AttackOnDenDialog);
		
		PROC
		PROC_DEN_AttackOnDen_Start()
		THEN
		DB_PartyDialogSuppressionZone((TRIGGER)S_DEN_AttackOnDenArea_66fa72fc-fd29-4608-89c1-6048467f4091);
		
		PROC
		PROC_DEN_AttackOnDen_Start()
		AND
		DB_DEN_InDenTriggers(_Trigger)
		THEN
		DB_PartyDialogSuppressionZone((TRIGGER)_Trigger);
		
		PROC
		PROC_DEN_AttackOnDen_Start()
		AND
		DB_DEN_AttackOnDen_EmptyLair(1)
		THEN
		SetFlag(DEN_AttackOnDen_State_DruidsAreDefeated_3c6d8a2c-dd85-48d1-b48d-f0c6d37959e4, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		
		PROC
		PROC_DEN_AttackOnDen_Start()
		THEN
		PROC_DEN_AttackOnDen_CheckInitialDefeat();
		
		
		//END_REGION
		
		
		//REGION Character-specific adjustments
		
		PROC
		PROC_DEN_AttackOnDen_SetupNPC(S_DEN_DruidOpposed_322cf8d2-32ee-453f-987e-f12b32652b5d, "Cave", _)
		THEN
		SetDualEntityEvent(S_DEN_DruidOpposed_322cf8d2-32ee-453f-987e-f12b32652b5d, S_DEN_AttackRathPos_6f92201d-6d8a-45d0-b026-9d9349ec1483, "DEN_AttackOnDen_UpdatePosition");
		
		
		PROC
		PROC_DEN_AttackOnDen_SetupNPC(S_DEN_PetWolf_63471e30-7413-4496-97de-0bdf67c2f753, "Cave", _)
		THEN
		SetDualEntityEvent(S_DEN_PetWolf_63471e30-7413-4496-97de-0bdf67c2f753, S_DEN_AttackWolfPos_2ad61951-a080-41f4-a8b6-41581252a8c3, "DEN_AttackOnDen_UpdatePosition");
		
		//Kill captured goblin if still in Den area.
		PROC
		PROC_DEN_AttackOnDen_SetupNPC(S_DEN_CapturedGoblin_783d7572-a846-455f-b686-247a95263ebb, "Specific", _)
		AND
		NOT DB_GlobalFlag((FLAG)DEN_CapturedGoblin_State_LeftDen_2a64c50f-45b6-8bd2-e980-77fb4b11fce3) // flagType: Global
		THEN
		Die(S_DEN_CapturedGoblin_783d7572-a846-455f-b686-247a95263ebb, DEATHTYPE.Physical, 1);
		
		PROC
		PROC_DEN_AttackOnDen_SetupNPC(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, "Gate", _)
		AND
		IsOnStage(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, 0)
		THEN
		SetOnStage(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, 1);
		
		
		PROC
		PROC_DEN_AttackOnDen_SetupNPC(S_DEN_TieflingLeader_475200ee-cc3c-4dbe-84b1-1820c02ea26a, "Gate", _)
		THEN
		SetFlag(DEN_AttackOnDen_State_ZevlorIsLeader_f1e902bc-1258-7a2f-0ed2-9bc042aae88d, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetEntityEvent(S_DEN_TieflingLeader_475200ee-cc3c-4dbe-84b1-1820c02ea26a,"DEN_AttackOnDen_SetLeader");
		
		
		
		//Setup trainer as tiefling leader if leader is already permadefeated.
		PROC
		PROC_DEN_AttackOnDen_SetupNPC(S_DEN_Trainer_02025646-347a-4235-aef7-e46b7c94b435, "Gate", _)
		AND
		DB_PermaDefeated(S_DEN_TieflingLeader_475200ee-cc3c-4dbe-84b1-1820c02ea26a)
		THEN
		SetDualEntityEvent(S_DEN_Trainer_02025646-347a-4235-aef7-e46b7c94b435, S_DEN_LeaderPos_05334587-5b2e-4b09-8fc0-220329fe9687, "DEN_AttackOnDen_UpdatePosition");
		SetEntityEvent(S_DEN_Trainer_02025646-347a-4235-aef7-e46b7c94b435,"DEN_AttackOnDen_SetLeader");
		
		PROC
		PROC_DEN_AttackOnDen_SetupNPC(S_GLO_GruntingKid_0f8ef61e-cb63-49e1-a242-677173bff5e0, "Hideout", _AttackOnDenDialog)
		AND
		NOT DB_DEN_AttackOnDen_EmptyLair(1)
		THEN
		DB_DEN_AttackOnDen_GruntingScene(1);
		SetFlag(DEN_AttackOnDen_State_MissingDoni_65b22f09-459c-ebbf-1859-ddc005d067eb, NULL_00000000-0000-0000-0000-000000000000, 0);
		LookAtEntity(S_GLO_GruntingKid_0f8ef61e-cb63-49e1-a242-677173bff5e0, S_DEN_LairMainOutDoor_1f76e748-d0d5-4cb5-8d0f-7fd96f14285b);
		
		
		PROC
		PROC_DEN_AttackOnDen_SetupNPC(S_GLO_GruntingKid_0f8ef61e-cb63-49e1-a242-677173bff5e0, "Hideout", _AttackOnDenDialog)
		AND
		DB_DEN_AttackOnDen_EmptyLair(1)
		THEN
		SetDualEntityEvent(S_GLO_GruntingKid_0f8ef61e-cb63-49e1-a242-677173bff5e0, S_DEN_AttackKidPos_011_653cf07f-e6ac-46eb-bb02-041ed278498e, "DEN_AttackOnDen_UpdatePosition");
		
		
		PROC
		PROC_DEN_AttackOnDen_SetupNPC(S_DEN_Tiefling_001_82f8662d-76da-4352-b37e-01ba433b5d43, "Cave", DEN_AttackOnDen_Tiefling001_b9cfdd58-28ee-6859-b2bc-d5e22293e6e2)
		AND
		NOT DB_DEN_AttackOnDen_GruntingScene(1)
		THEN
		NOT DB_DEN_AttackOnDen_MoveAfterRaidStarted(S_DEN_Tiefling_001_82f8662d-76da-4352-b37e-01ba433b5d43, S_DEN_AttackRikkaPos_1809d6fc-996c-4803-a6a2-dbb4cd261179);
		SetDualEntityEvent(S_DEN_Tiefling_001_82f8662d-76da-4352-b37e-01ba433b5d43, S_DEN_AttackRikkaPos_1809d6fc-996c-4803-a6a2-dbb4cd261179, "DEN_AttackOnDen_UpdatePosition");
		
		PROC
		PROC_DEN_AttackOnDen_SetupNPC(S_DEN_PetBird_72bd7f25-0644-4323-a428-85ba5630e6ea, "", _AttackOnDenDialog)
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_DEN_PetBird_72bd7f25-0644-4323-a428-85ba5630e6ea); //the bird leaves but he comes back after the attack and needs his dialog
		PROC_DEN_AttackOnDen_TryAddDialog(S_DEN_PetBird_72bd7f25-0644-4323-a428-85ba5630e6ea);
		
		PROC
		PROC_DEN_AttackOnDen_SetupNPC(S_DEN_WoundedBird_200bc56e-f3e1-445b-8b75-a5ddb541e123, "", _AttackOnDenDialog)
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_DEN_WoundedBird_200bc56e-f3e1-445b-8b75-a5ddb541e123); //the bird leaves but he comes back after the attack and needs his dialog
		PROC_DEN_AttackOnDen_TryAddDialog(S_DEN_WoundedBird_200bc56e-f3e1-445b-8b75-a5ddb541e123);
		
		PROC
		PROC_DEN_AttackOnDen_SetupNPC(S_DEN_Weaponsmith_e2ad06ec-8034-479a-9f69-b86faea6dc79, "Defenseless", _AttackOnDenDialog)
		AND
		GetEquippedItem(S_DEN_Weaponsmith_e2ad06ec-8034-479a-9f69-b86faea6dc79, "Melee Main Weapon", _Weapon)
		AND
		GetEquippedItem(S_DEN_Weaponsmith_e2ad06ec-8034-479a-9f69-b86faea6dc79, "Melee Offhand Weapon", _Weapon2)
		THEN
		Unequip(S_DEN_Weaponsmith_e2ad06ec-8034-479a-9f69-b86faea6dc79, _Weapon);
		Unequip(S_DEN_Weaponsmith_e2ad06ec-8034-479a-9f69-b86faea6dc79, _Weapon2);
		
		PROC
		PROC_DEN_AttackOnDen_SetupNPC(S_DEN_TieflingRefugee_RangerTrader_001_637d8d68-2a04-409e-a77d-cf31ac9478ee, "Defenseless", _AttackOnDenDialog)
		AND
		GetEquippedItem(S_DEN_TieflingRefugee_RangerTrader_001_637d8d68-2a04-409e-a77d-cf31ac9478ee, "Ranged Main Weapon", _Weapon)
		THEN
		Unequip(S_DEN_TieflingRefugee_RangerTrader_001_637d8d68-2a04-409e-a77d-cf31ac9478ee, _Weapon);
		
		
		PROC
		PROC_DEN_AttackOnDen_SetupNPC(S_DEN_TieflingRefugee_004_bc4c4282-86b0-4330-9df8-246ed0a704a2, "Defenseless", _AttackOnDenDialog)
		AND
		GetEquippedItem(S_DEN_TieflingRefugee_004_bc4c4282-86b0-4330-9df8-246ed0a704a2, "Melee Main Weapon", _Weapon)
		THEN
		Unequip(S_DEN_TieflingRefugee_004_bc4c4282-86b0-4330-9df8-246ed0a704a2, _Weapon);
		
		PROC
		PROC_DEN_AttackOnDen_SetupNPC(S_DEN_Griefling_7ce0afc2-e8f2-4f2e-82d8-27df98acc3d8, _Role, _AttackOnDenDialog)
		THEN
		DB_PermaDefeatedFlag(S_DEN_Griefling_7ce0afc2-e8f2-4f2e-82d8-27df98acc3d8, DEN_AttackOnDen_Event_GrieflingPermadefeated_56cc42ff-1401-8e30-13de-91ce54e48e68);
		
		//END_REGION
		
		
		//REGION General character adjustments
		
		PROC
		PROC_DEN_AttackOnDen_SetupNPC((CHARACTER)_InvolvedNPC, (STRING)_Role, (DIALOGRESOURCE)_AttackOnDenDialog)
		AND
		_Role != ""
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(_InvolvedNPC);
		PROC_DEN_AttackOnDen_TryAddDialog(_InvolvedNPC);
		PROC_DEN_AttackOnDen_AssignFaction(_InvolvedNPC, _Role);
		
		PROC
		PROC_DEN_AttackOnDen_SetupNPC((CHARACTER)_InvolvedNPC, (STRING)_Role, (DIALOGRESOURCE)_AttackOnDenDialog)
		AND
		_Role != ""
		AND
		_Role != "Lair Offstage"
		AND
		_Role != "Defenseless Offstage"
		THEN
		PROC_DEN_AttackOnDen_AssignNewPosition(_InvolvedNPC, _Role);
		
		//Give a participating character a new position and assign it to that position's corresponding combat.
		PROC
		PROC_DEN_AttackOnDen_AssignNewPosition((CHARACTER)_Character, (STRING)_Role)
		THEN
		SetEntityEvent(_Character, "DEN_AttackOnDen_TeleportToPosition");
		PROC_DEN_AttackOnDen_AssignToCombat(_Character, _Role);
		
		PROC
		PROC_DEN_AttackOnDen_AssignToCombat((CHARACTER)_Character, (STRING)_Role)
		AND
		DB_DEN_AttackOnDen_RoleCombat(_Role, _Combat)
		THEN
		PROC_DEN_AttackOnDen_AddToCombatTracking(_Character, _Combat);
		
		PROC
		PROC_DEN_AttackOnDen_AssignFaction((CHARACTER)_InvolvedNPC, (STRING)_Role)
		AND
		DB_DEN_AttackOnDen_RoleFactions(_Role, _Faction)
		AND
		_InvolvedNPC != S_DEN_GrieflingFriend_c3334ee5-38dc-4197-aacc-4aa55803ff52
		THEN
		SetFaction(_InvolvedNPC, _Faction);
		
		PROC
		PROC_DEN_AttackOnDen_TrySetCombatGroup((CHARACTER)_NPC, (STRING)_Role)
		AND
		DB_State_Current(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_AttackOnDen")
		AND
		DB_DEN_AttackOnDen_RoleCombat(_Role, _CombatGroup)
		THEN
		SetCombatGroupID(_NPC, _CombatGroup);
		
		IF
		BaseFactionChanged(_Character, _, ACT1_DEN_AttackOnDen_Gate_4ec9e6b5-f0c2-e413-489c-1f6c10a1a50f)
		THEN
		PROC_DEN_AttackOnDen_TrySetCombatGroup(_Character, "Gate");
		
		IF
		EnteredTrigger(_NPC, _CombatGroupArea)
		AND
		DB_DEN_AttackOnDen_CombatGroupAreas(_, _CombatGroupArea)
		AND
		DB_DEN_NPC(_NPC, _Role, _)
		THEN
		TriggerUnregisterForCharacter(_CombatGroupArea, _NPC);
		PROC_DEN_AttackOnDen_TrySetCombatGroup(_NPC, _Role);
		
		//Also unregister trigger when den NPCs are defeated during attack on den.
		PROC
		PROC_StateSet_PermaDefeated((CHARACTER)_NPC)
		AND
		DB_DEN_NPC(_NPC, _Role, _)
		AND
		DB_State_Current(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_AttackOnDen")
		AND
		DB_DEN_AttackOnDen_CombatGroupAreas(_Role, _CombatGroupArea)
		THEN
		TriggerUnregisterForCharacter(_CombatGroupArea, _NPC);
		
		IF
		EnteredTrigger(_NPC, S_DEN_DruidCombatGroupArea_3a127577-6dd8-42f1-8203-550904142b2a)
		THEN
		TriggerUnregisterForCharacter(S_DEN_DruidCombatGroupArea_3a127577-6dd8-42f1-8203-550904142b2a, _NPC);
		PROC_DEN_AttackOnDen_TrySetCombatGroup(_NPC, "Lair");
		
		PROC
		PROC_State_Changed(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_AttackOnDenVictory")
		AND
		DB_DEN_NPC(_NPC, _Role, _)
		AND
		DB_DEN_AttackOnDen_CombatGroupAreas(_Role, _CombatGroupArea)
		THEN
		TriggerUnregisterForCharacter(_CombatGroupArea, _NPC);
		
		//Set NPCs who don't participate off stage. Play an event so individual character logic can pick them up once they have left.
		PROC
		PROC_DEN_AttackOnDen_SetupNPC((CHARACTER)_UninvolvedNPC, "", (DIALOGRESOURCE)_AttackOnDenDialog)
		THEN
		SetOnStage(_UninvolvedNPC, 0);
		PROC_DEN_RemoveFromDenNPCs(_UninvolvedNPC);
		
		
		PROC
		PROC_DEN_AttackOnDen_SetupNPC((CHARACTER)_UninvolvedNPC, "", (DIALOGRESOURCE)_AttackOnDenDialog)
		AND
		DB_DEN_LeaveEvents(_UninvolvedNPC,_Event)
		THEN
		SetEntityEvent(_UninvolvedNPC, _Event);
		
		//Set non-combat druids off-stage and only set them back on stage later if the tieflings win.
		PROC
		PROC_DEN_AttackOnDen_SetupNPC(_Druid, "Lair Offstage", _Dialog)
		THEN
		SetOnStage(_Druid, 0);
		
		//Set oxes off-stage and make them appear to their harness position if the tieflings win.
		PROC
		PROC_DEN_AttackOnDen_SetupNPC(_Ox, "Defenseless Offstage", _Dialog)
		THEN
		SetOnStage(_Ox, 0);
		
		PROC
		PROC_DEN_AttackOnDen_AssignFaction(S_DEN_GrieflingFriend_c3334ee5-38dc-4197-aacc-4aa55803ff52, _)
		THEN
		SetFaction(S_DEN_GrieflingFriend_c3334ee5-38dc-4197-aacc-4aa55803ff52, ACT1_DEN_AttackOnDen_Memnos_5f5dd07e-ebc3-4cee-8ed8-ce8bb35143ff);
		
		//END_REGION
		
		
		//REGION General character dialog adjustments
		
		PROC
		PROC_DEN_AttackOnDen_TryAddDialog((CHARACTER)_NPC)
		AND
		DB_DEN_NPC(_NPC, _Role, _AttackOnDenDialog)
		AND
		_AttackOnDenDialog != NULL_00000000-0000-0000-0000-000000000000
		THEN
		DB_Dialogs(_NPC, _AttackOnDenDialog);
		
		//END_REGION
		
		//REGION Automatic raider victory
		
		PROC
		PROC_DEN_AttackOnDen_SetupNPC(_NPC, "Gate", _AttackOnDenDialog)
		THEN
		PROC_DEN_AttackOnDen_Count("DEN_AttackOnDen_GateDefenders");
		
		PROC
		PROC_DEN_AttackOnDen_SetupNPC(_NPC, _Role, _AttackOnDenDialog)
		AND
		_Role != "Lair"
		AND
		_Role != "Hideout"
		AND
		_Role != ""
		THEN
		PROC_DEN_AttackOnDen_Count("DEN_AttackOnDen_Tieflings");
		
		PROC
		PROC_DEN_AttackOnDen_Count((STRING)_Count)
		THEN
		PROC_IncreaseCounter(_Count);
		
		PROC
		PROC_DEN_AttackOnDen_CheckInitialDefeat()
		AND
		DB_PermaDefeated((CHARACTER)S_DEN_TieflingLeader_475200ee-cc3c-4dbe-84b1-1820c02ea26a)
		AND
		DB_PermaDefeated((CHARACTER)S_DEN_Trainer_02025646-347a-4235-aef7-e46b7c94b435)
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_StartAutoRaiderVictory")
		THEN
		SetFlag(DEN_AttackOnDen_Event_InsufficientDefense_d0710769-a13e-3677-39d9-e379d0b8838f, NULL_00000000-0000-0000-0000-000000000000, 0);
		PROC_DEN_AttackOnDen_ForceDefeat();
		
		PROC
		PROC_DEN_AttackOnDen_CheckInitialDefeat()
		AND
		DB_GlobalCounter("DEN_AttackOnDen_Tieflings", _Index)
		AND
		_Index < 12
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_StartAutoRaiderVictory")
		THEN
		SetFlag(DEN_AttackOnDen_Event_InsufficientDefense_d0710769-a13e-3677-39d9-e379d0b8838f, NULL_00000000-0000-0000-0000-000000000000, 0);
		PROC_DEN_AttackOnDen_ForceDefeat();
		
		PROC
		PROC_DEN_AttackOnDen_CheckInitialDefeat()
		AND
		DB_GlobalCounter("DEN_AttackOnDen_GateDefenders", _Index)
		AND
		_Index < 2
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_StartAutoRaiderVictory")
		THEN
		SetFlag(DEN_AttackOnDen_Event_InsufficientDefense_d0710769-a13e-3677-39d9-e379d0b8838f, NULL_00000000-0000-0000-0000-000000000000, 0);
		PROC_DEN_AttackOnDen_ForceDefeat();
		
		PROC
		PROC_DEN_AttackOnDen_CheckInitialDefeat()
		AND
		DB_DEN_AttackOnDen_TieflingDefeatCounters(_Combat)
		AND
		NOT DB_GLO_DefeatCounter_State(_, _Combat, _)
		THEN
		DB_DEN_AttackOnDen_DefeatCounterComplete(_Combat);
		
		IF
		DB_DEN_AttackOnDen_CheckDefeat(1)
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_UnderAttack_4ebba932-b9cf-41c5-b897-e77a63b93511)
		AND
		NOT DB_InRegion(_, S_DEN_AttackOnDenArea_66fa72fc-fd29-4608-89c1-6048467f4091)
		AND
		NOT DB_InRegion(_, S_DEN_AttackOnDenArea_Hideout_e8a663e9-2468-4a64-9127-62632507545f)
		AND
		NOT DB_InRegion(_, S_DEN_AttackOnDenArea_Vault_3c313775-1c89-4f98-9f0b-61a135135461)
		AND
		NOT DB_InRegion(_, S_DEN_AttackOnDenArea_Druid_c940e172-79b0-4be3-b44d-dbdb3224e91f)
		THEN
		NOT DB_DEN_AttackOnDen_CheckDefeat(1);
		DebugBreak("Start Defeat Timer");
		TimerLaunch("DEN_AttackOnDen_CheckDefeat", 5000);
		
		IF
		TimerFinished("DEN_AttackOnDen_CheckDefeat")
		THEN
		PROC_DEN_AttackOnDen_CheckDefeat();
		
		PROC
		PROC_DEN_AttackOnDen_CheckDefeat()
		AND
		NOT DB_InRegion(_, S_DEN_AttackOnDenArea_66fa72fc-fd29-4608-89c1-6048467f4091)
		AND
		NOT DB_InRegion(_, S_DEN_AttackOnDenArea_Hideout_e8a663e9-2468-4a64-9127-62632507545f)
		AND
		NOT DB_InRegion(_, S_DEN_AttackOnDenArea_Vault_3c313775-1c89-4f98-9f0b-61a135135461)
		AND
		NOT DB_InRegion(_, S_DEN_AttackOnDenArea_Druid_c940e172-79b0-4be3-b44d-dbdb3224e91f)
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_StartAutoRaiderVictory")
		THEN
		DB_DEN_AttackOnDen_Defeated(1);
		PROC_DEN_AttackOnDen_ForceDefeat();
		
		PROC
		PROC_DEN_AttackOnDen_CheckDefeat()
		AND
		NOT DB_DEN_AttackOnDen_Defeated(1)
		THEN
		DB_DEN_AttackOnDen_CheckDefeat(1);
		
		IF
		LevelUnloading("WLD_Main_A")
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_UnderAttack_4ebba932-b9cf-41c5-b897-e77a63b93511)
		AND
		DB_State_Current(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_AttackOnDen")
		THEN
		PROC_DEN_AttackOnDen_ForceDefeat();
		
		
		PROC
		PROC_DEN_AttackOnDen_ForceDefeat()
		THEN
		SetFlag(DEN_AttackOnDen_State_HostileTieflings_c5641caa-4409-4739-a1fe-8263b8271f4e, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetFlag(DEN_AttackOnDen_Event_RaidersWinByDefault_e0f44496-90a3-46d1-a1c9-1fbe19ca7632, NULL_00000000-0000-0000-0000-000000000000, 0); 
		SetFlag(DEN_AttackOnDen_State_RaidersAtDen_29f372ac-f9f1-4d54-bc9e-7eb493fa09d8, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetFlag(DEN_AttackOnDen_State_RaidersInDen_5e839d5f-3e25-4b56-b758-81d25c9cbd33, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		EnteredTrigger(_Player, S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211)
		AND
		DB_GlobalFlag(DEN_AttackOnDen_Event_RaidersWinByDefault_e0f44496-90a3-46d1-a1c9-1fbe19ca7632)
		AND
		DB_Players(_Player)
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_DefaultWinJournalHook")
		THEN
		PROC_DEN_AttackOnDen_AoD_NoTieflings_JournalHook();
		
		PROC
		PROC_DEN_AttackOnDen_AoD_NoTieflings_JournalHook()
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_DEN_AttackOnDen_ForceDefeat()
		AND
		NOT DB_GlobalFlag(GOB_General_State_Hostile_9816a6fb-54d7-4b9c-a5c7-bc6cda6bb276)
		THEN
		PROC_SetRelationMutual((FACTION)ACT1_DEN_AttackRaiders_Fighters_bfdc773b-6521-4fd1-3784-3d1404f1b2f5, (FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, 100);
		PROC_SetRelationMutual((FACTION)ACT1_DEN_AttackRaiders_Standby_aca56eff-f292-1b69-8f22-ec96197b8d25, (FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, 100);
		
		PROC
		PROC_DEN_AttackOnDen_ForceDefeat()
		AND
		DB_DEN_AttackOnDen_ExtraCharactersRemove(_Character)
		AND
		DB_DEN_AttackOnDen_Raiders(_Character, _A, _B, _C)
		THEN
		NOT DB_DEN_AttackOnDen_ExtraCharactersRemove(_Character);
		NOT DB_DEN_AttackOnDen_Raiders(_Character, _A, _B, _C);
		SetOnStage(_Character, 0);
		
		//Setup automatic defeat conditions.
		
		PROC
		PROC_DEN_AttackOnDen_ForceDefeat()
		THEN
		PROC_TriggerUnregisterForPlayers(S_DEN_AttackOnDenArea_66fa72fc-fd29-4608-89c1-6048467f4091);
		PROC_TriggerUnregisterForPlayers(S_DEN_AttackOnDenArea_Hideout_e8a663e9-2468-4a64-9127-62632507545f);
		PROC_TriggerUnregisterForPlayers(S_DEN_AttackOnDenArea_Druid_c940e172-79b0-4be3-b44d-dbdb3224e91f);
		PROC_TriggerUnregisterForPlayers(S_DEN_AttackOnDenArea_Vault_3c313775-1c89-4f98-9f0b-61a135135461);
		PROC_TriggerUnregisterForPlayers(S_DEN_LeaderAttackSpotArea_41be541d-570b-447a-9636-6cbab92bbde2);
		PROC_TriggerUnregisterForPlayers(S_DEN_AttackOnDenEntranceArea_b45cb766-c7a2-44c8-bd73-91779cd8ce78);
		
		PROC
		PROC_DEN_AttackOnDen_ForceDefeat()
		AND
		DB_DEN_GateInUse(_Gate)
		AND
		IsOpened(_Gate, 0)
		THEN
		Die(_Gate);
		
		PROC
		PROC_DEN_AttackOnDen_ForceDefeat()
		AND
		DB_DEN_NPC(_Character, _Role, _)
		AND
		_Role != ""
		AND
		NOT DB_Dead(_Character)
		THEN
		Die(_Character, DEATHTYPE.DoT, 1);
		
		PROC
		PROC_DEN_AttackOnDen_ForceDefeat()
		AND
		DB_DEN_AttackOnDen_Raiders(_Raider, _, _, _)
		AND
		IsOnStage(_Raider, 0)
		THEN
		SetOnStage(_Raider, 1);
		
		PROC
		PROC_DEN_AttackOnDen_ForceDefeat()
		AND
		DB_DEN_AttackOnDen_Raiders(_Raider, _, _, _)
		AND
		NOT DB_Defeated(_Raider)			
		THEN
		RemoveHarmfulStatuses(_Raider);
		LeaveCombat(_Raider);
		PurgeOsirisQueue(_Raider);
		SetFlag(DEN_AttackOnDen_State_Victorious_ebe2c997-93ae-93f2-7f11-34057122b19b, _Raider, 0);
		PROC_CharacterEnableAllCrimes(_Raider);
		SetCanJoinCombat(_Raider, 1);
		
		PROC
		PROC_DEN_AttackOnDen_ForceDefeat()			
		THEN
		RemoveHarmfulStatuses(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b);
		LeaveCombat(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b);
		PurgeOsirisQueue(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b);
		SetFlag(DEN_AttackOnDen_State_Victorious_ebe2c997-93ae-93f2-7f11-34057122b19b, S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, 0);
		SetCanJoinCombat(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, 1);
		//END_REGION
		
		//REGION Druid Lair and Story Mother
		
		PROC
		PROC_DEN_AttackOnDen_DoniToHideout()
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_DoniToHideout")
		THEN
		ClearFlag(DEN_AttackOnDen_State_MissingDoni_65b22f09-459c-ebbf-1859-ddc005d067eb, NULL_00000000-0000-0000-0000-000000000000, 0);
		PROC_CharacterMoveTo(S_GLO_GruntingKid_0f8ef61e-cb63-49e1-a242-677173bff5e0, S_DEN_AttackKidPos_011_653cf07f-e6ac-46eb-bb02-041ed278498e, "Run", "DEN_AttackOnDen_GruntingInHideout");
		
		
		IF
		DialogActorLeft(DEN_AttackOnDen_LairDoor_bdb3218d-bd21-d32a-e5f7-8df82e2e37a6, _, S_GLO_GruntingKid_0f8ef61e-cb63-49e1-a242-677173bff5e0, _)
		AND
		DB_OnlyOnce("DEN_AttackOnDen_GruntingThreeWay")
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_GruntingLeavesLairDoor")
		THEN
		TriggerRegisterForCharacter(S_DEN_MotherSightArea_c7688b7a-e2c6-4919-ba42-3f96de91fc5e, S_GLO_GruntingKid_0f8ef61e-cb63-49e1-a242-677173bff5e0);
		PROC_CharacterMoveTo(S_GLO_GruntingKid_0f8ef61e-cb63-49e1-a242-677173bff5e0, S_DEN_GruntingMovePos_0487027c-cac2-45fb-b435-19c8036276db, "Run", "DEN_AttackOnDen_GruntingAtDoor");
		PROC_DEN_AttackOnDen_FoundDoni_JournalHook();
		
		PROC
		PROC_DEN_AttackOnDen_FoundDoni_JournalHook()
		THEN
		DB_NOOP(1);
		
		IF
		EntityEvent(_, "DEN_AttackOnDen_GruntingAtDoor")
		THEN
		DB_DEN_AttackOnDen_DoniAtDoor(1);
		
		IF
		DB_DEN_AttackOnDen_DoniAtDoor(1)
		AND
		DB_Defeated(S_DEN_Tiefling_001_82f8662d-76da-4352-b37e-01ba433b5d43)
		THEN
		PROC_DEN_AttackOnDen_DoniToHideout();
		
		IF
		DB_Sees(S_DEN_Tiefling_001_82f8662d-76da-4352-b37e-01ba433b5d43, S_GLO_GruntingKid_0f8ef61e-cb63-49e1-a242-677173bff5e0)
		THEN
		SetEntityEvent(S_DEN_Tiefling_001_82f8662d-76da-4352-b37e-01ba433b5d43, "DEN_AttackOnDen_RikkaToDoni");
		
		
		IF
		AutomatedDialogEnded(DEN_AttackOnDen_AD_RikkaAndDoni_a2e68aba-ccd2-7b41-bdcc-68d38284465a, _)
		THEN
		PROC_DEN_AttackOnDen_DoniToHideout();
		
		QRY
		QRY_DEN_AttackOnDen_CanDoLairDialog()
		AND
		DB_DEN_AttackOnDen_BlockLair(1)
		AND
		NOT DB_GlobalFlag(DEN_AttackOnDen_State_HostileTieflings_c5641caa-4409-4739-a1fe-8263b8271f4e)
		AND
		QRY_SpeakerIsAvailable(S_DEN_ServantIntolerant_002_6f36c7a1-edfd-4e99-bd90-6d874f68c9b8)
		AND
		QRY_SpeakerIsAvailable(S_DEN_LairMainOutDoor_1f76e748-d0d5-4cb5-8d0f-7fd96f14285b)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_DEN_AttackOnDen_ThreeWayLairDialogAvailable()
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_GLO_GruntingKid_0f8ef61e-cb63-49e1-a242-677173bff5e0, S_DEN_LairMainOutDoor_1f76e748-d0d5-4cb5-8d0f-7fd96f14285b)
		AND
		NOT DB_OnlyOnce("DEN_AttackOnDen_GruntingThreeWay")
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_SelectCustomDialog(S_GLO_GruntingKid_0f8ef61e-cb63-49e1-a242-677173bff5e0, _Player)
		AND
		QRY_DEN_AttackOnDen_CanDoLairDialog()
		AND
		QRY_DEN_AttackOnDen_ThreeWayLairDialogAvailable()
		THEN
		DB_SelectedDialog(DEN_AttackOnDen_LairDoor_bdb3218d-bd21-d32a-e5f7-8df82e2e37a6, S_DEN_LairMainOutDoor_1f76e748-d0d5-4cb5-8d0f-7fd96f14285b, _Player, S_GLO_GruntingKid_0f8ef61e-cb63-49e1-a242-677173bff5e0);
		
		PROC
		PROC_BlockUseOfItem(_Player, S_DEN_LairMainOutDoor_1f76e748-d0d5-4cb5-8d0f-7fd96f14285b)
		AND
		QRY_DEN_AttackOnDen_CanDoLairDialog()
		AND
		QRY_DEN_AttackOnDen_ThreeWayLairDialogAvailable()
		AND
		QRY_StartDialog_Fixed(DEN_AttackOnDen_LairDoor_bdb3218d-bd21-d32a-e5f7-8df82e2e37a6, S_DEN_LairMainOutDoor_1f76e748-d0d5-4cb5-8d0f-7fd96f14285b, _Player, S_GLO_GruntingKid_0f8ef61e-cb63-49e1-a242-677173bff5e0)
		THEN
		DB_DEN_AttackOnDen_LairDialogStarted(1);
		
		PROC
		PROC_BlockUseOfItem(_Player, S_DEN_LairMainOutDoor_1f76e748-d0d5-4cb5-8d0f-7fd96f14285b)
		AND
		QRY_DEN_AttackOnDen_CanDoLairDialog()
		AND
		QRY_StartDialog_Fixed(DEN_AttackOnDen_LairDoor_bdb3218d-bd21-d32a-e5f7-8df82e2e37a6, S_DEN_LairMainOutDoor_1f76e748-d0d5-4cb5-8d0f-7fd96f14285b, _Player)
		THEN
		DB_DEN_AttackOnDen_LairDialogStarted(1);
		
		PROC
		PROC_BlockUseOfItem(_Player, S_DEN_LairMainOutDoor_1f76e748-d0d5-4cb5-8d0f-7fd96f14285b)
		AND
		DB_DEN_AttackOnDen_BlockLair(1)
		THEN
		DB_CustomUseItemResponse(_Player, S_DEN_LairMainOutDoor_1f76e748-d0d5-4cb5-8d0f-7fd96f14285b, 0);
		PROC_DEN_AttackOnDen_TryPlayBlockedLairAD(_Player);
		
		PROC
		PROC_DEN_AttackOnDen_TryPlayBlockedLairAD((CHARACTER)_Player)
		AND
		DB_Players(_Player)
		AND
		NOT DB_DEN_AttackOnDen_LairDialogStarted(1)
		THEN
		PROC_TryStartAD(DEN_AttackOnDen_PAD_LairDoorBlocked_6eeb78b9-fded-2761-c6f9-8d721ec089a7, _Player);
		
		IF
		DialogActorJoined(DEN_AttackOnDen_LairDoor_bdb3218d-bd21-d32a-e5f7-8df82e2e37a6, _, S_GLO_GruntingKid_0f8ef61e-cb63-49e1-a242-677173bff5e0, _)
		THEN
		DB_OnlyOnce("DEN_AttackOnDen_GruntingThreeWay");
		
		IF
		DialogStarted(DEN_AttackOnDen_LairDoor_bdb3218d-bd21-d32a-e5f7-8df82e2e37a6, _)
		THEN
		NOT DB_DEN_AttackOnDen_LairDialogStarted(1);
		
		IF
		UseStarted(S_GLO_GruntingKid_0f8ef61e-cb63-49e1-a242-677173bff5e0, S_DEN_GruntingKidHatch_4309dd70-89b1-44c7-a000-5790125ae6d1)
		THEN
		DB_DEN_AttackOnDen_RikkaBackToCave(1);
		
		IF
		DB_DEN_AttackOnDen_RikkaBackToCave(1)
		AND
		DB_DEN_AttackOnDen_GruntingScene(1)
		AND
		NOT DB_DialogNPCs(_, S_DEN_Tiefling_001_82f8662d-76da-4352-b37e-01ba433b5d43, _)
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_MotherToPrison")
		THEN
		NOT DB_DEN_AttackOnDen_GruntingScene(1);
		NOT DB_DEN_AttackOnDen_MoveAfterRaidStarted(S_DEN_Tiefling_001_82f8662d-76da-4352-b37e-01ba433b5d43, S_DEN_AttackRikkaPos_1809d6fc-996c-4803-a6a2-dbb4cd261179);
		PROC_CharacterMoveTo(S_DEN_Tiefling_001_82f8662d-76da-4352-b37e-01ba433b5d43, S_DEN_AttackRikkaPos_1809d6fc-996c-4803-a6a2-dbb4cd261179, "Walk", "DEN_AttackOnDen_MotherAtPrison");
		
		PROC
		PROC_DEN_AttackOnDen_HornBlown(_Player)
		AND
		DB_DEN_AttackOnDen_GruntingScene(1)
		THEN
		ClearFlag(DEN_AttackOnDen_State_MissingDoni_65b22f09-459c-ebbf-1859-ddc005d067eb, NULL_00000000-0000-0000-0000-000000000000, 0);
		PROC_CharacterMoveTo(S_GLO_GruntingKid_0f8ef61e-cb63-49e1-a242-677173bff5e0, S_DEN_AttackKidPos_011_653cf07f-e6ac-46eb-bb02-041ed278498e, "Run", "DEN_AttackOnDen_GruntingInHideout");
		NOT DB_DEN_AttackOnDen_GruntingScene(1);
		
		PROC
		PROC_DEN_AttackOnDen_HornBlown(_Player)
		THEN
		PROC_DEN_AttackONDen_HornBlown_JournalHook();
		
		PROC
		PROC_DEN_AttackONDen_HornBlown_JournalHook()
		THEN
		DB_NOOP(1);
		//END_REGION
		
		//REGION Unblocking lair
		
		//Unblocking lair
		PROC
		PROC_DEN_AttackOnDen_UnblockLair()
		AND
		DB_DEN_AttackOnDen_BlockLair(1)
		THEN
		NOT DB_DEN_AttackOnDen_BlockLair(1);
		
		PROC
		PROC_GLO_DefeatCounter_AllDefeated("DEN_AttackOnDen_DruidFight")
		THEN
		PROC_DEN_AttackOnDen_UnblockLair();
		
		IF
		FlagSet(DEN_AttackOnDen_State_DenVictory_71c7f23e-3ff1-c9b8-3ef5-d75fa1b42c8d, _, _)
		AND
		DB_GlobalFlag((FLAG)GLO_AttackOnDen_State_RaidReady_eb361773-da88-dee4-f4c8-a22acae60948)
		THEN
		PROC_DEN_AttackOnDen_UnblockLair();
		PROC_SetRelationToPlayers((FACTION)ACT1_DEN_AttackOnDen_Druid_7347ff55-56c1-4997-b6d1-22e5f29e86d9, 100);
		
		IF
		FlagSet(DEN_AttackOnDen_State_DenVictory_71c7f23e-3ff1-c9b8-3ef5-d75fa1b42c8d, _ ,_)
		AND
		DB_DEN_AttackOnDen_BlockOwned((CHARACTER)_NPC, 0)
		AND
		DB_DEN_NPC(_NPC, _, _)
		THEN
		NOT DB_DEN_AttackOnDen_BlockOwned((CHARACTER)_NPC, 0);
		
		PROC
		PROC_DEN_AttackOnDen_DruidsLastStand()
		THEN
		PROC_DEN_AttackOnDen_UnblockLair();
		
		//END_REGION
		
		//REGION Combat Tracking
		
		PROC
		PROC_DEN_AttackOnDen_AddToRaiderCombat((CHARACTER)_Raider)
		AND
		DB_GLO_DefeatCounter_Target("DEN_AttackOnDen_RaiderCombat", _CurrentCounterValue)
		AND
		IntegerSum(_CurrentCounterValue, 1, _IncrementedCounterValue)
		THEN
		DB_GLO_DefeatCounter(_Raider, "DEN_AttackOnDen_RaiderCombat");
		NOT DB_GLO_DefeatCounter_Target("DEN_AttackOnDen_RaiderCombat", _CurrentCounterValue);
		DB_GLO_DefeatCounter_Target("DEN_AttackOnDen_RaiderCombat", _IncrementedCounterValue);
		
		
		
		PROC
		PROC_DEN_AttackOnDen_AddToCombatTracking((CHARACTER)_NPC, (STRING)_Combat)
		THEN
		DB_GLO_DefeatCounter(_NPC, _Combat);
		
		
		PROC
		PROC_GLO_DefeatCounter_AllDefeated("DEN_AttackOnDen_GateCombat")
		THEN
		PROC_TriggerUnregisterForPlayers(S_DEN_GateCombatArea_687f429f-91f5-4e8f-9ab2-04cf6cfa23ba);
		
		
		PROC
		PROC_GLO_DefeatCounter_AllDefeated(_TieflingDefeatCounter)
		AND
		DB_DEN_AttackOnDen_TieflingDefeatCounters(_TieflingDefeatCounter)
		THEN
		DB_DEN_AttackOnDen_DefeatCounterComplete(_TieflingDefeatCounter);
		PROC_DEN_AttackOnDen_EndOfCombat(_TieflingDefeatCounter);
		
		
		//The combat the tiefling leader is in is considered to be the gate combat.
		IF
		EnteredCombat((CHARACTER)_Leader, _ID)
		AND
		DB_DEN_CurrentDefenderLeader(_Leader)
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_UnderAttack_4ebba932-b9cf-41c5-b897-e77a63b93511)
		THEN
		PROC_TriggerRegisterForPlayers(S_DEN_RaidersAggroArea_c4bc8b06-6b65-49a0-9e8a-89233c70a3a9);
		DB_DEN_AttackOnDen_GateCombatID(_ID);
		
		
		//Register the combat area trigger to force players in that area to join the combat.
		IF
		DB_DEN_AttackOnDen_GateCombatID(_ID)
		THEN
		PROC_TriggerRegisterForPlayers(S_DEN_GateCombatArea_687f429f-91f5-4e8f-9ab2-04cf6cfa23ba);
		
		
		IF
		SwitchedCombat((CHARACTER)_Leader, _OldID, _ID)
		AND
		DB_DEN_CurrentDefenderLeader(_Leader)
		AND
		DB_DEN_AttackOnDen_GateCombatID(_OldID)
		THEN
		NOT DB_DEN_AttackOnDen_GateCombatID(_OldID);
		DB_DEN_AttackOnDen_GateCombatID(_ID);
		
		IF
		CombatEnded(_ID)
		AND
		DB_DEN_AttackOnDen_GateCombatID(_ID)
		THEN
		PROC_TriggerUnregisterForPlayers(S_DEN_RaidersAggroArea_c4bc8b06-6b65-49a0-9e8a-89233c70a3a9);
		NOT DB_DEN_AttackOnDen_GateCombatID(_ID);
		
		//Adding players to the gate combat to keep combat alive.
		IF
		EnteredTrigger(_Player, S_DEN_GateCombatArea_687f429f-91f5-4e8f-9ab2-04cf6cfa23ba)
		AND
		DB_Players(_Player)
		AND
		DB_DEN_AttackOnDen_GateCombatID(_ID)
		THEN
		PROC_DEN_AttackOnDen_TryJoinGateCombat(_Player);
		
		
		PROC
		PROC_DEN_AttackOnDen_TryJoinGateCombat((CHARACTER)_Player)
		AND
		DB_DEN_AttackOnDen_GateCombatID(_ID)
		AND
		DB_DEN_CurrentDefenderLeader(_Leader)
		AND
		DB_Is_InCombat(_Leader, _ID)
		AND
		NOT DB_IS_InCombat(_Player, _ID)
		THEN
		SetCombatGroupID(_Player, "DEN_AttackOnDen_GateCombat");
		
		
		//Removing players from gate combat group when they leave the area.
		IF
		LeftTrigger(_Player, S_DEN_GateCombatArea_687f429f-91f5-4e8f-9ab2-04cf6cfa23ba)
		AND
		DB_Players(_Player)
		AND
		GetCombatGroupID(_Player, "DEN_AttackOnDen_GateCombat")
		THEN
		SetCombatGroupID(_Player, "");
		
		IF
		LeftCombat((CHARACTER)_Player, _ID)
		AND
		DB_Players(_Player)
		AND
		DB_DEN_AttackOnDen_GateCombatID(_ID)
		AND
		GetCombatGroupID(_Player, "DEN_AttackOnDen_GateCombat")
		THEN
		SetCombatGroupID(_Player, "");
		
		//END_REGION
		
		
		//REGION Blowing the horn at the Gate
		
		PROC
		PROC_DEN_BattleHorn_UsedAndAvailable((CHARACTER)_Player)
		AND
		DB_Players(_Player)
		AND
		DB_GlobalFlag((FLAG)DEN_AttackOnDen_State_UnderAttack_4ebba932-b9cf-41c5-b897-e77a63b93511) // flagType: Global
		AND
		DB_DEN_CurrentDefenderLeader(_Leader)
		AND
		NOT DB_GlobalFlag(DEN_AttackOnDen_State_RaidersAtDen_29f372ac-f9f1-4d54-bc9e-7eb493fa09d8)
		THEN
		//DB_DEN_AttackOnDen_CheckDefeat(1);
		PROC_ForceStopDialog(_Leader);
		PROC_DEN_AttackOnDen_HornBlown(_Player);
		SetForceUpdate((ITEM)S_DEN_BattleHorn_baf1a4c5-b6f9-48c2-908d-164b967655d5,0);
		
		
		//Start the raid when Tieflings are allied.
		PROC
		PROC_DEN_AttackOnDen_HornBlown((CHARACTER)_Player)
		AND
		GetRelation(ACT1_DEN_AttackOnDen_Gate_4ec9e6b5-f0c2-e413-489c-1f6c10a1a50f, Hero_a1542c81-6895-929e-4522-10ce218bb360, _Relation)
		AND
		_Relation > 24
		THEN
		PROC_DEN_AttackOnDen_ArrivalDialog(_Player);
		PROC_TriggerRegisterForPlayers(S_DEN_GateCombatArea_687f429f-91f5-4e8f-9ab2-04cf6cfa23ba);
		PROC_TriggerUnregisterForPlayers(S_DEN_LeaderAttackSpotArea_41be541d-570b-447a-9636-6cbab92bbde2);
		PROC_TriggerUnregisterForPlayers(S_DEN_AttackOnDenEntranceArea_b45cb766-c7a2-44c8-bd73-91779cd8ce78);
		DB_OnlyOnce("DEN_AttackOnDen_LeaderEvent");
		DB_OnlyOnce("DEN_AttackOnDen_EntranceEvent");
		
		PROC
		PROC_DEN_AttackOnDen_HornBlown((CHARACTER)_Player)
		THEN
		SetFlag(DEN_AttackOnDen_Event_ChefAndSonTalked_1877570b-a0f3-4d65-bbba-7db56293242a, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetFlag(DEN_AttackOnDen_Event_HornBlown_92dd6f14-e011-4c21-9738-5d49c720a24e, NULL_00000000-0000-0000-0000-000000000000, 0);
		PROC_DEN_AttackOnDen_MoveAfterRaidStarted();
		
		PROC
		PROC_DEN_AttackOnDen_HornBlown((CHARACTER)_Player)
		AND
		DB_DEN_NPC(_Character, "Gate", _)
		THEN
		SetEntityEvent(_Character, "DEN_AttackOnDen_WaitAtGates");
		
		PROC
		PROC_DEN_AttackOnDen_MoveAfterRaidStarted()
		AND
		DB_DEN_AttackOnDen_MoveAfterRaidStarted(S_DEN_GrieflingFriend_c3334ee5-38dc-4197-aacc-4aa55803ff52, S_DEN_SafetyPos_003_bf03ff45-ba26-46d0-b8f6-9a69ebd079da)
		THEN
		LeaveCombat(S_DEN_GrieflingFriend_c3334ee5-38dc-4197-aacc-4aa55803ff52);
		SetFaction(S_DEN_GrieflingFriend_c3334ee5-38dc-4197-aacc-4aa55803ff52, ACT1_DEN_AttackOnDen_Defenseless_0d52984d-82c0-44b3-861c-5f8107982525);
		
		PROC
		PROC_DEN_AttackOnDen_MoveAfterRaidStarted()
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_MoveAfterRaidStarted")
		AND
		DB_DEN_AttackOnDen_MoveAfterRaidStarted(_Character, _Position)
		THEN
		NOT DB_DEN_AttackOnDen_MoveAfterRaidStarted(_Character, _Position);
		SetEntityEvent(_Character, "DEN_AttackOnDen_ForceStopBehaviour");
		PROC_ForceStopDialog(_Character);
		SetEntityEvent(_Character, "ClearPeaceReturn", 1);
		PROC_CharacterMoveTo((CHARACTER)_Character, _Position, "Run", "DEN_AttackOnDen_EndOfReturn");
		
		IF
		FlagSet(DEN_AttackOnDen_Event_PlayerOpensGate_7c6f5e23-1d26-f209-a307-e79321437576, _, _)
		AND
		DB_DEN_CurrentDefenderLeader(_Leader)
		THEN
		PROC_CharacterMoveTo(_Leader, S_DEN_BetrayalLeaderPoint_64f02a17-8d79-4350-a1e6-7f18732eca9d, "Run", "DEN_AttackOnDen_BetrayalLeaderMove");
		
		IF
		EntityEvent(_Leader, "DEN_AttackOnDen_BetrayalLeaderMove")
		THEN
		LookFromTrigger((CHARACTER)_Leader, S_DEN_BetrayalLeaderPoint_8998a7a5-5f97-4239-8481-01a00f329f95, 1);
		
		IF
		EntityEvent(_Character, "DEN_AttackOnDen_EndOfReturn")
		THEN
		SetCanJoinCombat(_Character, 1);
		
		IF
		DialogActorJoined(DEN_AttackOnDen_RaidersArriveBeforeFight_b99a0f87-92fa-0e6f-1bf4-c668ae3d012b, _, (CHARACTER)_Player, _)
		AND
		DB_Players(_Player)
		THEN
		PROC_RemoveAllPolymorphs(_Player);
		
		PROC
		PROC_DEN_AttackOnDen_ArrivalDialog((CHARACTER)_Player)
		AND
		DB_DEN_CurrentDefenderLeader(S_DEN_TieflingLeader_475200ee-cc3c-4dbe-84b1-1820c02ea26a)
		AND
		NOT QRY_StartDialog(DEN_AttackOnDen_RaidersArriveBeforeFight_b99a0f87-92fa-0e6f-1bf4-c668ae3d012b, S_DEN_TieflingLeader_475200ee-cc3c-4dbe-84b1-1820c02ea26a, NULL_00000000-0000-0000-0000-000000000000, S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, _Player)
		THEN
		PROC_DEN_AttackOnDen_FailedLeaderDialog(DEN_AttackOnDen_RaidersArriveBeforeFight_b99a0f87-92fa-0e6f-1bf4-c668ae3d012b);
		
		
		PROC
		PROC_DEN_AttackOnDen_ArrivalDialog(_Player)
		AND
		DB_DEN_CurrentDefenderLeader(S_DEN_Trainer_02025646-347a-4235-aef7-e46b7c94b435)
		AND
		NOT QRY_StartDialog(DEN_AttackOnDen_RaidersArriveBeforeFight_b99a0f87-92fa-0e6f-1bf4-c668ae3d012b, NULL_00000000-0000-0000-0000-000000000000, S_DEN_Trainer_02025646-347a-4235-aef7-e46b7c94b435, S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, _Player)
		THEN
		PROC_DEN_AttackOnDen_FailedLeaderDialog(DEN_AttackOnDen_RaidersArriveBeforeFight_b99a0f87-92fa-0e6f-1bf4-c668ae3d012b);
		
		//Make raiders show up and join combat if players are currently in combat with the tieflings.
		PROC
		PROC_DEN_AttackOnDen_HornBlown((CHARACTER)_Player)
		AND
		NOT DB_DEN_AttackOnDen_DefeatCounterComplete("DEN_AttackOnDen_GateCombat")
		AND
		DB_DEN_CurrentDefenderLeader(_Leader)
		AND
		GetRelation(ACT1_DEN_AttackOnDen_Gate_4ec9e6b5-f0c2-e413-489c-1f6c10a1a50f, Hero_a1542c81-6895-929e-4522-10ce218bb360, _Relation)
		AND
		_Relation < 25
		THEN
		SetFlag(DEN_AttackOnDen_State_RaidersAtDen_29f372ac-f9f1-4d54-bc9e-7eb493fa09d8, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetCanJoinCombat(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, 1);
		PROC_AppearOutOfSightTo(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, S_DEN_RaidersAppearPos_002_06ec17f6-b313-49a1-a91d-be76de132da2, S_DEN_RaidersAppearDirection_23297c54-bc3e-4c46-88f4-0864d444ff98, "DEN_AttackOnDen_DrowAppeared");
		SetEntityEvent(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, "GOB_DrowCommander_LeftGoblinCamp");
		PROC_CharacterMoveTo(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, S_DEN_AttackDrowPos_7ae2ec37-9424-4012-89ce-749d73671b12, "Run", "DEN_AttackOnDen_DrowArrivedDuringFight");
		PROC_DEN_AttackOnDen_CombatSetup();
		
		IF
		EntityEvent(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, "DEN_AttackOnDen_DrowArrivedDuringFight")
		AND
		DB_DEN_CurrentDefenderLeader(_Leader)
		THEN
		SetFlag(DEN_AttackOnDen_Event_RaidersJoinedCombat_e4535a5f-1967-4c44-9ef9-b30246fbc44d, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetCombatGroupID(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, "DEN_AttackOnDen_GateCombat");
		SetFaction(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, (FACTION)ACT1_DEN_AttackRaiders_Fighters_bfdc773b-6521-4fd1-3784-3d1404f1b2f5);
		PROC_EnterCombat(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, _Leader);
		TriggerSetSoundState((TRIGGER)Amb_SV_RangerCamp_FZ_000_3fd38540-d846-770c-ba66-21c4924dacd6,"CombatPhase_AttackOnDen","DrowCommanderInCombat",1);
		
		//Raiders will show up on a player's turn after two rounds of combat.
		IF
		CombatRoundStarted(_ID, 2)
		AND
		DB_DEN_AttackOnDen_GateCombatID(_ID)
		AND
		NOT DB_GlobalFlag(DEN_AttackOnDen_State_RaidersAtDen_29f372ac-f9f1-4d54-bc9e-7eb493fa09d8)
		THEN
		DB_DEN_AttackOnDen_RaidersArriving(1);
		
		IF
		TurnStarted((CHARACTER)_Player)
		AND
		DB_Players(_Player)
		AND
		DB_DEN_AttackOnDen_GateCombatID(_ID)
		AND
		DB_Is_InCombat(_Player, _ID)
		AND
		DB_DEN_AttackOnDen_RaidersArriving(1)
		THEN
		NOT DB_DEN_AttackOnDen_RaidersArriving(1);
		SetFlag(DEN_AttackOnDen_State_RaidersAtDen_29f372ac-f9f1-4d54-bc9e-7eb493fa09d8, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetCanJoinCombat(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, 1);
		PROC_AppearOutOfSightTo(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, S_DEN_RaidersAppearPos_002_06ec17f6-b313-49a1-a91d-be76de132da2, S_DEN_RaidersAppearDirection_23297c54-bc3e-4c46-88f4-0864d444ff98, "DEN_AttackOnDen_DrowAppeared");
		SetEntityEvent(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, "GOB_DrowCommander_LeftGoblinCamp");
		PROC_CharacterMoveTo(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, S_DEN_AttackDrowPos_7ae2ec37-9424-4012-89ce-749d73671b12, "Run", "DEN_AttackOnDen_DrowArrivedDuringFight");
		PROC_DEN_AttackOnDen_CombatSetup();
		
		
		//Raiders show up if players end the combat before second round.
		PROC
		PROC_DEN_AttackOnDen_EndOfCombat("DEN_AttackOnDen_GateCombat")
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_HostileTieflings_c5641caa-4409-4739-a1fe-8263b8271f4e)
		AND
		NOT DB_GlobalFlag(DEN_AttackOnDen_State_RaidersAtDen_29f372ac-f9f1-4d54-bc9e-7eb493fa09d8)
		THEN
		PROC_TriggerRegisterForParty(S_DEN_FallBackRaiderArea_a66fd67a-a204-4e84-94c4-6263d620d8ec);
		
		PROC
		PROC_DEN_AttackOnDen_EndOfCombat("DEN_AttackOnDen_GateCombat")
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_HostileTieflings_c5641caa-4409-4739-a1fe-8263b8271f4e)
		AND
		DB_DEN_AttackOnDen_Raiders(_Raider, _, _, _)
		THEN
		PROC_CharacterEnableAllCrimes(_Raider);
		
		IF
		EnteredTrigger(_Player, S_DEN_FallBackRaiderArea_a66fd67a-a204-4e84-94c4-6263d620d8ec)
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_RaidersArrive")
		THEN
		NOT DB_DEN_AttackOnDen_RaidersArriving(1);
		SetFlag(DEN_AttackOnDen_State_RaidersAtDen_29f372ac-f9f1-4d54-bc9e-7eb493fa09d8, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetCanJoinCombat(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, 1);
		PROC_AppearOutOfSightTo(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, S_DEN_RaidersAppearPos_002_06ec17f6-b313-49a1-a91d-be76de132da2, S_DEN_RaidersAppearDirection_23297c54-bc3e-4c46-88f4-0864d444ff98, "DEN_AttackOnDen_DrowAppeared");
		SetEntityEvent(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, "GOB_DrowCommander_LeftGoblinCamp");
		PROC_CharacterMoveTo(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, S_DEN_AttackDrowPos_7ae2ec37-9424-4012-89ce-749d73671b12, "Run", "DEN_AttackOnDen_DrowArrivedDuringFight");
		PROC_DEN_AttackOnDen_CombatSetup();
		PROC_DEN_AttackOnDen_RaidersShowAfterCombat(_Player);
		//END_REGION
		
		
		//REGION Blocking use of gate lever
		
		PROC
		PROC_DEN_AttackOnDen_CombatSetup()
		AND
		GetRelation(ACT1_DEN_AttackOnDen_Gate_4ec9e6b5-f0c2-e413-489c-1f6c10a1a50f, Hero_a1542c81-6895-929e-4522-10ce218bb360, _Relation)
		AND
		NOT DB_DEN_AttackOnDen_BlockGate(1)
		AND
		_Relation < 25
		THEN
		DB_DEN_AttackOnDen_BlockGate(1);
		
		
		IF
		WentOnStage((ITEM)_Gate, 0)
		AND
		DB_DEN_GateInUse(_Gate)
		AND
		DB_DEN_AttackOnDen_BlockGate(1)
		THEN
		SetCanInteract(S_DEN_GateMechanism_5564d21c-9033-4958-8cc8-cd3f497bb51b, 0);
		
		
		//END_REGION
		
		
		//REGION Leader dialogs
		
		//Bring the first player to reach the entrance in a dialogue with the tiefling leader.
		
		IF
		DB_InRegion(_Player, S_DEN_AttackOnDenEntranceArea_b45cb766-c7a2-44c8-bd73-91779cd8ce78)
		AND
		NOT DB_OnlyOnce("DEN_AttackOnDen_EntranceEvent")
		AND
		DB_Players(_Player)
		AND
		NOT DB_HiddenCharacters(_Player,_)
		AND
		DB_DEN_CurrentDefenderLeader(_Leader)
		AND
		NOT DB_Defeated(_Leader)
		AND
		IsEnemy(_Leader, _Player, 0)
		THEN
		PROC_DEN_AttackOnDen_CheckWyllEvent("Front", DEN_AttackOnDen_EntranceMeeting_278c9ec1-02f0-c9ae-01d8-cd4507ce40cc, _Player);
		
		
		
		//Leader engages player in dialogue if no players have been spotted at the entrance of gates.
		IF
		DB_InRegion(_Player, S_DEN_LeaderAttackSpotArea_41be541d-570b-447a-9636-6cbab92bbde2)
		AND
		NOT DB_OnlyOnce("DEN_AttackOnDen_LeaderEvent")
		AND
		DB_Players(_Player)
		AND
		NOT DB_HiddenCharacters(_Player,_)
		AND
		DB_DEN_CurrentDefenderLeader(_Leader)
		AND
		NOT DB_Defeated(_Leader)
		AND
		DB_Dialogs(_Leader, _Dialog)
		AND
		IsEnemy(_Leader, _Player, 0)
		AND
		QRY_SpeakerIsAvailable(_Leader)
		AND
		QRY_SpeakerIsAvailable(_Player, 0, 1)
		THEN
		PROC_DEN_AttackOnDen_CheckWyllEvent("Back", _Dialog, _Player);
		
		PROC
		PROC_DEN_AttackOnDen_CheckWyllEvent("Back", (DIALOGRESOURCE)_Dialog, (CHARACTER)_Player)
		AND
		NOT DB_DEN_NPC(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, "Gate", _)
		AND
		DB_DEN_CurrentDefenderLeader(_Leader)
		AND
		QRY_StartDialog(_Dialog, _Leader, _Player)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_DEN_AttackOnDen_CheckWyllEvent("Back", _Dialog, _Player)
		AND
		DB_DEN_NPC(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, "Gate", _)
		AND
		NOT QRY_SpeakerIsAvailable(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		AND
		NOT DB_Is_WildShaped(_Player)
		AND
		DB_DEN_CurrentDefenderLeader(_Leader)
		AND
		QRY_StartDialog(_Dialog, _Leader, _Player)
		THEN
		SetDualEntityEvent(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, S_DEN_DefenderPos_002_34486062-9eea-4457-8685-38fb06696727, "DEN_AttackOnDen_UpdatePosition");
		
		
		PROC
		PROC_DEN_AttackOnDen_CheckWyllEvent("Back", _Dialog, _Player)
		AND
		DB_DEN_NPC(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, "Gate", _)
		AND
		QRY_SpeakerIsAvailable(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		AND
		QRY_StartDialog(DEN_AttackOnDen_EntranceMeetingWyll_fe7e5e63-53eb-3cba-c140-f7f5e4e68571, S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000, _Player)
		THEN
		SetDualEntityEvent(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, S_DEN_DefenderPos_002_34486062-9eea-4457-8685-38fb06696727, "DEN_AttackOnDen_UpdatePosition");
		
		PROC
		PROC_DEN_AttackOnDen_CheckWyllEvent("Front", _Dialog, _Player)
		AND
		NOT DB_DEN_NPC(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, "Gate", _)
		THEN
		PROC_DEN_AttackOnDen_LeaderDialog(DEN_AttackOnDen_EntranceMeeting_278c9ec1-02f0-c9ae-01d8-cd4507ce40cc, _Player);
		
		PROC
		PROC_DEN_AttackOnDen_CheckWyllEvent("Front", _Dialog, _Player)
		AND
		DB_DEN_NPC(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, "Gate", _)
		AND
		NOT QRY_SpeakerIsAvailable(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		THEN
		PROC_DEN_AttackOnDen_LeaderDialog(DEN_AttackOnDen_EntranceMeeting_278c9ec1-02f0-c9ae-01d8-cd4507ce40cc, _Player);
		SetDualEntityEvent(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, S_DEN_DefenderPos_002_34486062-9eea-4457-8685-38fb06696727, "DEN_AttackOnDen_UpdatePosition");
		
		PROC
		PROC_DEN_AttackOnDen_CheckWyllEvent("Front", _Dialog, _Player)
		AND
		DB_DEN_NPC(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, "Gate", _)
		AND
		QRY_SpeakerIsAvailable(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		AND
		QRY_StartDialog(DEN_AttackOnDen_EntranceMeetingWyll_fe7e5e63-53eb-3cba-c140-f7f5e4e68571, S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000, _Player)
		THEN
		SetDualEntityEvent(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, S_DEN_DefenderPos_002_34486062-9eea-4457-8685-38fb06696727, "DEN_AttackOnDen_UpdatePosition");
		
		PROC
		PROC_DEN_AttackOnDen_LeaderDialog((DIALOGRESOURCE)_Dialog, (CHARACTER)_Player)
		AND
		DB_DEN_CurrentDefenderLeader(_Leader)
		AND
		QRY_SpeakerIsAvailable(_Leader, 1)
		AND
		QRY_SpeakerIsAvailable(_Player, 1, 1)
		AND
		NOT QRY_DEN_AttackeOnDen_StartLeaderDialogCustom(_Dialog, _Player, _Leader)
		THEN
		PROC_DEN_AttackOnDen_FailedLeaderDialog(_Dialog);
		
		
		QRY
		QRY_DEN_AttackeOnDen_StartLeaderDialogCustom((DIALOGRESOURCE)_Dialog, (CHARACTER)_Player, S_DEN_TieflingLeader_475200ee-cc3c-4dbe-84b1-1820c02ea26a)
		AND
		DB_DEN_AttackOnDen_LeaderDialogs(_Dialog,_AllowLowAttitudeIntercept,_AllowCrimeIntercept,_BlockInteractiveIfCombat,_ShowAttackButton)
		AND
		QRY_StartDialogCustom(_Dialog, S_DEN_TieflingLeader_475200ee-cc3c-4dbe-84b1-1820c02ea26a, NULL_00000000-0000-0000-0000-000000000000, _Player, _AllowLowAttitudeIntercept, _AllowCrimeIntercept, _BlockInteractiveIfCombat, _ShowAttackButton)
		THEN
		DB_NOOP(1);
		
		
		QRY
		QRY_DEN_AttackeOnDen_StartLeaderDialogCustom((DIALOGRESOURCE)_Dialog, (CHARACTER)_Player, S_DEN_Trainer_02025646-347a-4235-aef7-e46b7c94b435)
		AND
		DB_DEN_AttackOnDen_LeaderDialogs(_Dialog,_AllowLowAttitudeIntercept,_AllowCrimeIntercept,_BlockInteractiveIfCombat,_ShowAttackButton)
		AND
		QRY_StartDialogCustom(_Dialog, NULL_00000000-0000-0000-0000-000000000000, S_DEN_Trainer_02025646-347a-4235-aef7-e46b7c94b435, _Player, _AllowLowAttitudeIntercept, _AllowCrimeIntercept, _BlockInteractiveIfCombat, _ShowAttackButton)
		THEN
		DB_NOOP(1);
		
		IF
		DialogEnded(DEN_AttackOnDen_RaidersArriveBeforeFight_b99a0f87-92fa-0e6f-1bf4-c668ae3d012b, _)
		AND
		NOT DB_GlobalFlag(DEN_AttackOnDen_Event_TieflingsGoHostile_1de63f35-f895-ee70-93b3-55aec390a976)
		THEN
		PROC_DEN_AttackOnDen_SideWithTieflings_JournalHook();
		
		PROC
		PROC_DEN_AttackOnDen_FailedLeaderDialog(DEN_AttackOnDen_RaidersArriveBeforeFight_b99a0f87-92fa-0e6f-1bf4-c668ae3d012b)
		THEN
		SetFlag((FLAG)DEN_AttackOnDen_Event_EnemiesAppear_c8e05643-4071-5879-4a4c-911494b6aa81, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetFlag((FLAG)DEN_AttackOnDen_Event_CloseGate_3909ce5d-1ec7-a3c0-8002-f990abd434e3, NULL_00000000-0000-0000-0000-000000000000, 0);
		PROC_DEN_AttackOnDen_SideWithTieflings_JournalHook();
		
		PROC
		PROC_DEN_AttackOnDen_SideWithTieflings_JournalHook()
		THEN
		DB_NOOP(1);
		
		
		PROC
		PROC_DEN_AttackOnDen_FailedLeaderDialog(DEN_AttackOnDen_OpenGateBetrayal_d2904b97-9ebd-7ffc-135c-2d89ff6668f2)
		THEN
		PROC_DEN_AttackOnDen_BetrayTieflings();
		
		
		IF
		DialogActorJoined(_Dialog, _, (CHARACTER)_Leader, _)
		AND
		DB_DEN_AttackOnDen_MeetingDialogs(_Dialog, _Leader)
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_DisableLeaderMeeting")
		THEN
		PROC_TriggerUnregisterForPlayers(S_DEN_LeaderAttackSpotArea_41be541d-570b-447a-9636-6cbab92bbde2);
		PROC_TriggerUnregisterForPlayers(S_DEN_AttackOnDenEntranceArea_b45cb766-c7a2-44c8-bd73-91779cd8ce78);
		DB_OnlyOnce("DEN_AttackOnDen_LeaderEvent");
		DB_OnlyOnce("DEN_AttackOnDen_EntranceEvent");
		
		//END_REGION
		
		//REGION Gate Combat
		
		//TODO: Actual character closing gate
		IF
		FlagSet(DEN_AttackOnDen_Event_CloseGate_3909ce5d-1ec7-a3c0-8002-f990abd434e3, _, _) // flagType: Global
		AND
		DB_DEN_GateInUse(_Gate)
		THEN
		PROC_DEN_Gate_OpenOrCloseGate(1);
		SetCanInteract((ITEM)_Gate, 1);
		
		
		IF
		FlagSet(DEN_AttackOnDen_Event_EnemiesAppear_c8e05643-4071-5879-4a4c-911494b6aa81, _, _) // flagType: Global
		THEN
		SetFlag(DEN_AttackOnDen_State_RaidersAtDen_29f372ac-f9f1-4d54-bc9e-7eb493fa09d8, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetCanJoinCombat(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, 1);
		PROC_AppearOutOfSightTo(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, S_DEN_RaidersAppearPos_002_06ec17f6-b313-49a1-a91d-be76de132da2, S_DEN_RaidersAppearDirection_23297c54-bc3e-4c46-88f4-0864d444ff98, "DEN_AttackOnDen_DrowAppeared");
		SetEntityEvent(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, "GOB_DrowCommander_LeftGoblinCamp");
		PROC_CharacterMoveTo(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, S_DEN_AttackDrowPos_7ae2ec37-9424-4012-89ce-749d73671b12, "Run", "");
		PROC_DEN_AttackOnDen_CombatSetup();
		
		
		PROC
		PROC_DEN_AttackOnDen_CombatSetup()
		AND
		DB_DEN_AttackOnDen_Raiders(_Raider, _, _AppearPos, _Direction)
		THEN
		PROC_AppearOutOfSightTo(_Raider, _AppearPos, _Direction, "DEN_AttackOnDen_RaiderAppeared");
		PROC_DEN_AttackOnDen_AddToRaiderCombat(_Raider);
		
		IF
		EntityEvent((CHARACTER)_Raider, "DEN_AttackOnDen_RaiderAppeared")
		AND
		DB_DEN_AttackOnDen_Raiders(_Raider, _Pos, _, _)
		THEN
		PROC_CharacterMoveTo(_Raider, _Pos, "Run", "DEN_AttackOnDen_InCombatPosition");
		
		IF
		EntityEvent((CHARACTER)_Raider, "DEN_AttackOnDen_InCombatPosition")
		AND
		DB_DEN_AttackOnDen_Raiders(_Raider, _Pos, _, _)
		THEN
		LookFromTrigger(_Raider, _Pos, 0);
		
		PROC
		PROC_StateSet_Defeated(_Raider)
		AND
		DB_DEN_AttackOnDen_Raiders((CHARACTER)_Raider, _Pos, _AppearPos, _Direction)
		THEN
		NOT DB_DEN_AttackOnDen_Raiders(_Raider, _Pos, _AppearPos, _Direction);
		
		IF
		DialogEnded(DEN_AttackOnDen_RaidersArriveBeforeFight_b99a0f87-92fa-0e6f-1bf4-c668ae3d012b, _ID)
		AND
		NOT DB_GlobalFlag(DEN_AttackOnDen_Event_EnemiesAppear_c8e05643-4071-5879-4a4c-911494b6aa81)
		THEN
		SetFlag(DEN_AttackOnDen_Event_EnemiesAppear_c8e05643-4071-5879-4a4c-911494b6aa81, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		
		IF
		DialogEnded(DEN_AttackOnDen_RaidersArriveBeforeFight_b99a0f87-92fa-0e6f-1bf4-c668ae3d012b, _ID)
		THEN
		SetCombatGroupID(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, "DEN_AttackOnDen_GateCombat");
		SetFaction(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, (FACTION)ACT1_DEN_AttackRaiders_Fighters_bfdc773b-6521-4fd1-3784-3d1404f1b2f5);
		
		
		IF
		BaseFactionChanged(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, _, (FACTION)ACT1_DEN_AttackRaiders_Fighters_bfdc773b-6521-4fd1-3784-3d1404f1b2f5)
		THEN
		PROC_DEN_AttackOnDen_StartCombat();
		
		
		PROC
		PROC_DEN_AttackOnDen_StartCombat()
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_DrowJoinsFight")
		AND
		DB_DEN_CurrentDefenderLeader(_Leader)
		THEN
		PROC_EnterCombat(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, _Leader);
		SetEntityEvent(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b,"GOB_SetAiTarget_DenGate");
		TriggerSetSoundState((TRIGGER)Amb_SV_RangerCamp_FZ_000_3fd38540-d846-770c-ba66-21c4924dacd6,"CombatPhase_AttackOnDen","DrowCommanderInCombat",1);
		
		PROC
		PROC_DEN_AttackOnDen_StartCombat()
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_PlayersJoinFight")
		AND
		DB_Players(_Player)
		AND
		DB_InRegion(_Player, S_DEN_GateCombatArea_687f429f-91f5-4e8f-9ab2-04cf6cfa23ba)
		AND
		NOT DB_Is_InCombat(_Player, _)
		THEN
		PROC_EnterCombat(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, _Player);
		TriggerSetSoundState((TRIGGER)Amb_SV_RangerCamp_FZ_000_3fd38540-d846-770c-ba66-21c4924dacd6,"CombatPhase_AttackOnDen","DrowCommanderInCombat",1);
		
		//END_REGION
		
		//REGION Betraying Tieflings
		
		IF
		DialogEnded(_Dialog, _)
		AND
		DB_DEN_AttackOnDen_MeetingDialogs(_Dialog, _)
		AND
		DB_GlobalFlag(DEN_AttackOnDen_Event_BetrayTieflingsBeforeFight_1491f60b-8d1a-7987-22d0-dfaf2dac8863)
		THEN
		PROC_DEN_AttackOnDen_BetrayTieflings();
		
		IF
		FlagSet(DEN_AttackOnDen_Event_PlayerOpensGate_7c6f5e23-1d26-f209-a307-e79321437576, _Player, _)	// flagtype: Object
		AND
		DB_DEN_GateInUse(_Gate)
		THEN
		DB_DEN_AttackOnDen_BlockGate(1);
		Use((CHARACTER)_Player, S_DEN_GateMechanism_5564d21c-9033-4958-8cc8-cd3f497bb51b, "DEN_AttackOnDen_PlayerOpensGate");
		
		IF
		UseStarted(_, _Gate)
		AND
		DB_DEN_GateInUse(_Gate)
		AND
		DB_DEN_AttackOnDen_BlockGate(1)
		THEN
		TimerLaunch("DEN_AttackOnDen_DisableLeverTimer", 2000);
		
		IF
		TimerFinished("DEN_AttackOnDen_DisableLeverTimer")
		THEN
		SetCanInteract(S_DEN_GateMechanism_5564d21c-9033-4958-8cc8-cd3f497bb51b, 0);
		
		IF
		DialogEnded(DEN_AttackOnDen_RaidersArriveBeforeFight_b99a0f87-92fa-0e6f-1bf4-c668ae3d012b, _)
		AND
		DB_GlobalFlag(DEN_AttackOnDen_Event_TieflingsGoHostile_1de63f35-f895-ee70-93b3-55aec390a976)
		THEN
		PROC_DEN_AttackOnDen_BetrayTieflings();
		
		PROC
		PROC_DEN_AttackOnDen_BetrayTieflings()
		AND
		NOT DB_OnlyOnce("DEN_AttackOnDen_BetrayTieflings")
		THEN
		PROC_DEN_AttackOnDen_MoveAfterRaidStarted();
		SetImmortal(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, 1);
		SetFlag(DEN_AttackOnDen_State_HostileTieflings_c5641caa-4409-4739-a1fe-8263b8271f4e, NULL_00000000-0000-0000-0000-000000000000, 0);
		PROC_SetRelationMutual((FACTION)ACT1_DEN_AttackRaiders_Fighters_bfdc773b-6521-4fd1-3784-3d1404f1b2f5, (FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, 100);
		PROC_SetRelationMutual((FACTION)ACT1_DEN_AttackRaiders_Standby_aca56eff-f292-1b69-8f22-ec96197b8d25, (FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, 100);
		PROC_SetRelationMutual((FACTION)ACT1_DEN_AttackOnDen_NPC_08f28bce-a261-35e2-9914-6aa8b3eea155, (FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, 0);
		PROC_SetRelationMutual((FACTION)ACT1_DEN_AttackOnDen_Gate_4ec9e6b5-f0c2-e413-489c-1f6c10a1a50f, (FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, 0);
		PROC_DEN_AttackOnDen_TieflingBetrayal_JournalHook();
		PROC_DEN_AttackOnDen_SomeTieflingsFlee();
		
		PROC
		PROC_DEN_AttackOnDen_BetrayTieflings()
		AND
		NOT DB_OnlyOnce("DEN_AttackOnDen_BetrayTieflings")
		AND
		DB_DEN_NPC(_NPC, _Role, _)
		AND
		DB_DEN_AttackOnDen_CombatGroupAreas(_Role, _Area)
		THEN
		TriggerRegisterForCharacter(_Area, _NPC);
		
		PROC
		PROC_DEN_AttackOnDen_BetrayTieflings()
		AND
		NOT DB_OnlyOnce("DEN_AttackOnDen_BetrayTieflings")
		AND
		DB_DEN_NPC(_NPC, _, _)
		AND
		DB_DialogNPCs(_, _NPC, _)
		THEN
		PROC_ForceStopDialog(_NPC);
		
		/*
		PROC
		PROC_DEN_AttackOnDen_BetrayTieflings()
		AND
		NOT DB_OnlyOnce("DEN_AttackOnDen_BetrayTieflings")
		AND
		DB_DEN_NPC(_NPC, _, _)
		THEN
		PROC_CharacterDisableAllCrimes(_NPC);*/
		
		PROC
		PROC_DEN_AttackOnDen_BetrayTieflings()
		THEN
		DB_OnlyOnce("DEN_AttackOnDen_BetrayTieflings");
		
		PROC
		PROC_DEN_AttackOnDen_SomeTieflingsFlee()
		AND
		DB_DEN_AttackOnDen_FleeingTieflings(_Tiefling)
		THEN
		SetCanJoinCombat(_Tiefling, 0);
		SetCanFight(_Tiefling, 0);
		PROC_CharacterMoveTo(_Tiefling, S_DEN_SafeFleePos_0c928fd6-ef89-47bc-9fa8-7c37b29ea51c, "Run", "DEN_AttackOnDen_Fled");
		
		PROC
		PROC_DEN_AttackOnDen_SomeTieflingsFlee()
		AND
		DB_DEN_AttackOnDen_FleeingTieflings(_Tiefling)
		AND
		DB_DEN_NPC(_Tiefling, _, _)
		AND
		DB_GLO_DefeatCounter(_Tiefling, _Combat)
		THEN
		NOT DB_GLO_DefeatCounter(_Tiefling, _Combat);
		PROC_GLO_DefeatCounter_CheckFinished(_Combat);
		
		IF
		EntityEvent(_Character, "DEN_AttackOnDen_Fled")
		THEN
		SetOnStage(_Character, 0);
		
		IF
		FlagSet(DEN_AttackOnDen_State_HostileTieflings_c5641caa-4409-4739-a1fe-8263b8271f4e, _, _)
		THEN
		TriggerClearItemsOwner(S_DEN_Trainer_Ownership_5db200ee-bcb1-4a41-b5cc-72be9bc9cbc4);
		TriggerClearItemsOwner(S_DEN_CookOwnership_c24dc854-a503-48b8-9f4a-9529a21af5ce);
		TriggerClearItemsOwner(S_DEN_AdventurersOwnership_cae8006a-7681-40a9-a30f-226a98222f11);
		TriggerClearItemsOwner(S_DEN_HagOwnership_d19456f1-799e-46d4-8a9c-e817997d0d6f);
		TriggerClearItemsOwner(S_DEN_Refugee001_Ownership_7af2e1ed-65e7-4de0-b2e3-01f63c23621f);
		TriggerClearItemsOwner(S_DEN_TieflingGuard_004_Ownership_9f0db868-d124-4b57-8546-8c4b35492161);
		TriggerClearItemsOwner(S_DEN_YoungLover_Ownership_f2100a37-48df-40a3-bdfa-fe6630db40cf);
		TriggerClearItemsOwner(S_DEN_Tiefling005_Trespassing_a2f33199-1006-4371-ac62-3dbfbd6513fb);
		TriggerClearItemsOwner(S_DEN_Weaponsmith_Ownership_85ef12d9-33ce-4772-9519-b902935d1232);
		TriggerClearItemsOwner(S_DEN_Pickpocket_Ownership_4c0e2489-d97c-49da-aedd-9b27d0251cd5);
		TriggerClearItemsOwner(S_DEN_Hideout_ThiefSpotBox_de0d46cf-d0bf-4879-b79e-bcec68bf64f4);
		TriggerClearItemsOwner(S_DEN_SenderOwnership_78e70f78-e183-497f-ace8-462df3dd8b56);
		TriggerClearItemsOwner(S_DEN_PondOwnership_aff112d5-b79e-405e-9114-6b70aea65a06);
		TriggerClearItemsOwner(S_DEN_ZenBearOwnership_d2c760c9-32d1-4cef-8ddd-7337325cf178);
		TriggerClearItemsOwner(S_DEN_DruidEntrance_Ownership_137c1348-fafd-44cf-924e-eb4df6de9bb6);
		TriggerClearItemsOwner(S_DEN_DruidsQuartersOwnership_989c7fa8-4a8d-4159-8625-b802dbf81b97);
		TriggerClearItemsOwner(S_DEN_SecretLibrary_SUB_14dd754c-4b74-4aa7-bbec-471c2f8a0c61);
		TriggerClearItemsOwner(S_DEN_AppOwnership_6b0e6f9c-bffe-4643-922e-2c97ea39dca7);
		TriggerClearItemsOwner(S_DEN_LeaderMainOwnership_7ff915af-57a5-4d4d-9fd3-95e33d37c433);
		
		PROC
		PROC_DEN_AttackOnDen_TieflingBetrayal_JournalHook()
		THEN
		DB_NOOP(1);
		
		//Consider tieflings as betrayed by players if they enter combat without being enemies with the drow commander yet.
		IF
		AttackedBy((CHARACTER)_Character, (CHARACTER)_Player, _, _, _, _, _)
		AND
		DB_State_Current(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_AttackOnDen")
		AND
		NOT DB_GlobalFlag(DEN_AttackOnDen_State_HostileTieflings_c5641caa-4409-4739-a1fe-8263b8271f4e)
		AND
		DB_DEN_NPC(_Character, _, _)
		AND
		_Character != S_DEN_GrieflingFriend_c3334ee5-38dc-4197-aacc-4aa55803ff52
		AND
		DB_Players(_Player)
		AND
		IsEnemy(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, _Character, 0)
		THEN
		PROC_DEN_AttackOnDen_BetrayTieflings();
		
		IF
		DestroyedBy(_Gate, _Player, _, _)
		AND
		DB_DEN_GateInUse(_Gate)
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_UnderAttack_4ebba932-b9cf-41c5-b897-e77a63b93511)
		AND
		NOT DB_GlobalFlag((FLAG)DEN_AttackOnDen_State_RaidersAtDen_29f372ac-f9f1-4d54-bc9e-7eb493fa09d8)
		THEN
		PROC_DEN_AttackOnDen_BetrayTieflings();
		
		//END_REGION
		
		//REGION Party members leave during arrival scene
		
		IF
		FlagSet(DEN_AttackOnDen_Event_WyllLeaves_cfefd3d2-bfa4-0c1f-7109-41ad313abc9d, _, _Inst)
		AND
		DB_PartOfTheTeam(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		AND
		QRY_Origins_PlayerForItemsOfLeavingCompanion(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d,_Inst)
		AND
		DB_QRYRTN_Origins_PlayerForItemsOfLeavingCompanion(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, _Player)
		THEN
		DB_CompanionLeaving(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d,_Player);
		PROC_Origins_CompanionLeavePermanently(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, "CompanionLowRelation");
		PROC_DEN_AttackOnDen_WyllLeaves_CheckWyllInCamp();
		
		PROC
		PROC_DEN_AttackOnDen_WyllLeaves_CheckWyllInCamp()
		AND
		DB_InCamp(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		THEN
		PROC_DisappearOutOfSight(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, "Run", 0, "GLO_CompanionLeaves_LowRelation");
		
		PROC
		PROC_DEN_AttackOnDen_WyllLeaves_CheckWyllInCamp()
		AND
		NOT DB_InCamp(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		THEN
		SetFaction(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, ACT1_DEN_AttackOnDen_Gate_4ec9e6b5-f0c2-e413-489c-1f6c10a1a50f);
		
		//END_REGION
		
		//REGION After Gate Combat
		
		PROC
		PROC_GLO_DefeatCounter_AllDefeated("DEN_AttackOnDen_RaiderCombat")
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_UnderAttack_4ebba932-b9cf-41c5-b897-e77a63b93511) //need to make sure this is triggered in the AoD context otherwise this goes through when Minthara is killed
		AND
		NOT DB_GlobalFlag(DEN_AttackOnDen_State_HostileTieflings_c5641caa-4409-4739-a1fe-8263b8271f4e)
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_LeaderCelebration")
		THEN
		DebugBreak("Raiders defeated!");
		PROC_DEN_AttackOnDen_BringBackOffstageCharacters();
		ClearFlag(DEN_AttackOnDen_State_UnderAttack_4ebba932-b9cf-41c5-b897-e77a63b93511, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetFlag(DEN_AttackOnDen_State_DenVictory_71c7f23e-3ff1-c9b8-3ef5-d75fa1b42c8d, NULL_00000000-0000-0000-0000-000000000000, 0);
		PROC_DEN_AttackOnDen_VictoryInvitation();
		
		PROC
		PROC_DEN_AttackOnDen_BringBackOffstageCharacters()
		AND
		DB_DEN_NPC(_Druid, "Lair Offstage", _)
		THEN
		SetOnStage(_Druid, 1);
		
		PROC
		PROC_DEN_AttackOnDen_BringBackOffstageCharacters()
		AND
		DB_DEN_NPC(_Ox, "Defenseless Offstage", _)
		THEN
		PROC_AppearOutOfSightTo(_Ox, S_DEN_LeaderCavePoint_03f82037-c5ca-4cb6-a858-02c5cc6a52ff, S_DEN_LeaderCavePoint_03f82037-c5ca-4cb6-a858-02c5cc6a52ff, "");
		
		PROC
		PROC_DEN_AttackOnDen_EndOfCombat("DEN_AttackOnDen_GateCombat")
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_HostileTieflings_c5641caa-4409-4739-a1fe-8263b8271f4e)
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_RaidersAtDen_29f372ac-f9f1-4d54-bc9e-7eb493fa09d8)
		AND
		DB_Players(_Player)
		AND
		QRY_SpeakerIsAvailable(_Player)
		AND
		GetDistanceTo(_Player, S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, _Distance)
		AND
		_Distance < 55
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_MindMeldAfterGateCombat")
		AND
		NOT QRY_StartDialogCustom(DEN_AttackOnDen_DrowMindMeldAfterGateCombat_861cbf47-f9ab-f0c4-5ff7-821eb491bbaa, S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, _Player, 1, 1, 0, 1)
		THEN
		DB_DEN_AttackOnDen_RaidersReadyToMove(1);
		
		IF
		FlagSet((FLAG)DEN_AttackOnDen_Event_OpenGateAfterCombat_87870d5c-74b1-6c3c-2968-c6dea44e7f0b, _, _)
		THEN
		PROC_DEN_Gate_OpenOrCloseGate(0);
		
		IF
		DialogEnded(DEN_AttackOnDen_DrowMindMeldAfterGateCombat_861cbf47-f9ab-f0c4-5ff7-821eb491bbaa, _)
		THEN
		DB_DEN_AttackOnDen_RaidersReadyToMove(1);
		
		PROC
		PROC_DEN_AttackOnDen_EndOfCombat("DEN_AttackOnDen_GateCombat")
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_HostileTieflings_c5641caa-4409-4739-a1fe-8263b8271f4e)
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_RaidersAtDen_29f372ac-f9f1-4d54-bc9e-7eb493fa09d8)
		AND
		NOT DB_GlobalFlag(DEN_AttackOnDen_Event_RaidersWinByDefault_e0f44496-90a3-46d1-a1c9-1fbe19ca7632)
		AND
		NOT DB_OnlyOnce("DEN_AttackOnDen_MindMeldAfterGateCombat")
		THEN
		DB_DEN_AttackOnDen_RaidersReadyToMove(1);
		
		
		PROC
		PROC_DEN_AttackOnDen_RaidersShowAfterCombat((CHARACTER)_Player)
		AND
		NOT QRY_StartDialog(DEN_AttackOnDen_RaidersArriveAfterFight_f5fbe4d0-7e3e-f9a8-1e5c-3eb4f0561a8c, S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, _Player)
		THEN
		DB_DEN_AttackOnDen_RaidersReadyToMove(1);
		
		
		IF
		DialogEnded(DEN_AttackOnDen_RaidersArriveAfterFight_f5fbe4d0-7e3e-f9a8-1e5c-3eb4f0561a8c, _)
		THEN
		DB_DEN_AttackOnDen_RaidersReadyToMove(1);
		//END_REGION
		
		//REGION Raiders Go To Den
		
		IF
		DB_DEN_OpenedGate(1)
		AND
		DB_DEN_AttackOnDen_RaidersReadyToMove(1)
		AND
		NOT DB_GlobalFlag(DEN_AttackOnDen_Event_RaidersWinByDefault_e0f44496-90a3-46d1-a1c9-1fbe19ca7632)
		THEN
		SetCanInteract(S_DEN_GateMechanism_5564d21c-9033-4958-8cc8-cd3f497bb51b, 0);
		SetFlag(DEN_AttackOnDen_State_RaidersInDen_5e839d5f-3e25-4b56-b758-81d25c9cbd33, NULL_00000000-0000-0000-0000-000000000000, 0);	//flagType: Global
		PROC_DEN_AttackOnDen_RaidersGoInsideDen();
		
		PROC
		PROC_DEN_AttackOnDen_RaidersGoInsideDen()
		THEN
		PROC_SetRelationMutual((FACTION)ACT1_DEN_AttackOnDen_Cave_be9ef27b-18d4-4168-a798-5c6b744e0c08,(FACTION)ACT1_DEN_AttackRaiders_Fighters_bfdc773b-6521-4fd1-3784-3d1404f1b2f5, 0);
		
		PROC
		PROC_DEN_AttackOnDen_RaidersGoInsideDen()
		AND
		DB_DEN_AttackOnDen_Raiders(_Raider, _, _, _)
		THEN
		SetCombatGroupID(_Raider, "");
		SetCanJoinCombat(_Raider, 1);
		PROC_SetCanFight(_Raider, 1);
		
		PROC
		PROC_DEN_AttackOnDen_RaidersGoInsideDen()
		AND
		DB_DEN_AttackOnDen_VictoryRaiders(_Raider)
		THEN
		SetFlag(DEN_AttackOnDen_State_Victorious_ebe2c997-93ae-93f2-7f11-34057122b19b, _Raider);
		
		PROC
		PROC_DEN_AttackOnDen_RaidersGoInsideDen()
		THEN
		Unlock(S_DEN_StorageDoor_e2911d4f-2b43-48e4-a1c2-5c4cc53bae8d);
		
		PROC
		PROC_DEN_AttackOnDen_RaidersGoInsideDen()
		AND
		Syscount("DB_DEN_AttackOnDen_CaveRaiders", 1, _Count)
		AND
		_Count < 4
		THEN
		PROC_DEN_AttackOnDen_RefillCaveRaiders();
		
		PROC
		PROC_DEN_AttackOnDen_RefillCaveRaiders()
		AND
		DB_DEN_AttackOnDen_CaveHoldRaiders(_Raider)
		AND
		Syscount("DB_DEN_AttackOnDen_CaveRaiders", 1, _Count)
		AND
		_Count < 4
		THEN
		DB_DEN_AttackOnDen_CaveRaiders(_Raider);
		NOT DB_DEN_AttackOnDen_CaveHoldRaiders(_Raider);
		
		PROC
		PROC_DEN_AttackOnDen_RaidersGoInsideDen()
		AND
		DB_DEN_AttackOnDen_CaveHoldRaiders(_Raider)
		AND
		TriggerGetRandomPosition(S_DEN_CaveHoldArea_d9120f68-0d1a-47d6-9e10-0e896eb0132a, _X, _Y, _Z)
		THEN
		SetCombatGroupID(_Raider, "");
		SetEntityEvent(_Raider, "ClearPeaceReturn", 1);
		PROC_CharacterMoveToPosition(_Raider, _X, _Y, _Z, "Run", "DEN_AttackOnDen_AtCaveHoldPos");
		
		PROC
		PROC_DEN_AttackOnDen_RaidersGoInsideDen()
		AND
		NOT DB_Defeated(S_GOB_WarchiefBrave_6601b8f7-1a92-46bb-b409-6fcef7406a39)
		AND
		TriggerGetRandomPosition(S_DEN_CaveHoldArea_d9120f68-0d1a-47d6-9e10-0e896eb0132a, _X, _Y, _Z)
		THEN
		SetCombatGroupID(S_GOB_WarchiefBrave_6601b8f7-1a92-46bb-b409-6fcef7406a39, "");
		SetEntityEvent(S_GOB_WarchiefBrave_6601b8f7-1a92-46bb-b409-6fcef7406a39, "ClearPeaceReturn", 1);
		PROC_CharacterMoveToPosition(S_GOB_WarchiefBrave_6601b8f7-1a92-46bb-b409-6fcef7406a39, _X, _Y, _Z, "Run", "DEN_AttackOnDen_AtCaveHoldPos");
		
		PROC
		PROC_DEN_AttackOnDen_RaidersGoInsideDen()
		AND
		DB_DEN_AttackOnDen_CaveRaiders(_Raider)
		AND
		TriggerGetRandomPosition(S_DEN_CaveHoldArea2_4d34380b-ef29-4d6e-9cf8-72aa39851a05, _X, _Y, _Z)
		THEN
		SetCombatGroupID(_Raider, "");
		SetEntityEvent(_Raider, "ClearPeaceReturn", 1);
		PROC_CharacterMoveToPosition(_Raider, _X, _Y, _Z, "Run", "DEN_AttackOnDen_AtCaveCombatPos");
		
		PROC
		PROC_DEN_AttackOnDen_DruidsLastStand()
		AND
		NOT DB_PermaDefeated(S_GOB_WarchiefBrave_6601b8f7-1a92-46bb-b409-6fcef7406a39)
		AND
		TriggerGetRandomPosition(S_DEN_DruidHoldArea_3a69cc72-ddec-40f3-bfea-206603c7701b, _X, _Y, _Z)
		THEN
		ClearFlag(DEN_AttackOnDen_State_Victorious_ebe2c997-93ae-93f2-7f11-34057122b19b, S_GOB_WarchiefBrave_6601b8f7-1a92-46bb-b409-6fcef7406a39);
		PROC_CharacterMoveToPosition(S_GOB_WarchiefBrave_6601b8f7-1a92-46bb-b409-6fcef7406a39, _X, _Y, _Z, "Run", "DEN_AttackOnDen_AtDruidCombatPos");
		
		PROC
		PROC_DEN_AttackOnDen_DruidsLastStand()
		AND
		DB_DEN_AttackOnDen_DruidRaiders(_Raider)
		AND
		TriggerGetRandomPosition(S_DEN_DruidHoldArea_3a69cc72-ddec-40f3-bfea-206603c7701b, _X, _Y, _Z)
		THEN
		PROC_AppearOutOfSightTo(_Raider, S_DEN_DruidHoldArea_3a69cc72-ddec-40f3-bfea-206603c7701b, S_DEN_DruidGoblinsAppearDirection_e9ed2e9b-41cf-44cc-a1a8-1c1a90955228, "GOB_DrowCommander_LeftGoblinCamp");
		PROC_CharacterMoveToPosition(_Raider, _X, _Y, _Z, "Run", "DEN_AttackOnDen_AtDruidCombatPos");
		
		
		IF
		DB_GlobalFlag(DEN_AttackOnDen_State_DruidsAreDefeated_3c6d8a2c-dd85-48d1-b48d-f0c6d37959e4)
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_RaidersInDen_5e839d5f-3e25-4b56-b758-81d25c9cbd33)
		AND
		DB_DEN_AttackOnDen_DruidRaiders(_Raider)
		THEN
		SetEntityEvent(_Raider, "ClearPeaceReturn", 1);
		SetFlag(DEN_AttackOnDen_State_Victorious_ebe2c997-93ae-93f2-7f11-34057122b19b, _Raider);
		
		
		PROC
		PROC_DEN_AttackOnDen_RaidersGoInsideDen()
		AND
		NOT DB_PermaDefeated(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b)
		AND
		DB_DEN_AttackOnDen_AllTieflingsDefeatCounters(1)
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_DrowCelebration")
		THEN
		SetCombatGroupID(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, "");
		PROC_RemoveDialog(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b);
		DB_Dialogs(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, DEN_AttackOnDen_Drow_84abf1c9-de21-4db1-cbb1-0046faf2fc45);
		FlushOsirisQueue(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b);
		SetEntityEvent(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, "ClearPeaceReturn", 1);
		PROC_CharacterMoveTo(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, S_DEN_DrowSafePos_f25283db-31d2-4ced-a0fa-c0a75d6f5621, "Run", "DEN_AttackOnDen_Victory");
		
		IF
		DB_DEN_AttackOnDen_RaidersReadyToMove(1)
		THEN
		PROC_DEN_AttackOnDen_ExtraRaidersLeave();
		
		PROC
		PROC_DEN_AttackOnDen_ExtraRaidersLeave()
		AND
		DB_DEN_AttackOnDen_ExtraCharacters(_Raider)
		AND
		NOT DB_DEN_AttackOnDen_RaiderVictoryPositions((CHARACTER)_Raider, _)
		THEN
		PROC_CharacterMoveTo((CHARACTER)_Raider, S_DEN_GoblinAppearDirection_2d5a4623-399f-4b23-b7cc-2cd5f2635fc0, "Walk", "DEN_AttackOnDen_RaiderDisappear");
		
		IF
		EntityEvent(_Raider, "DEN_AttackOnDen_RaiderDisappear")
		THEN
		PROC_DisappearOutOfSight((CHARACTER)_Raider, "Run", 1, "");
		
		
		PROC
		PROC_DEN_AttackOnDen_RaidersGoInsideDen()
		AND
		DB_DEN_AttackOnDen_DefeatCounterComplete("DEN_AttackOnDen_CaveCombat")
		AND
		NOT DB_DEN_AttackOnDen_DefeatCounterComplete("DEN_AttackOnDen_DefenselessCombat")
		THEN
		PROC_DEN_AttackOnDen_EndOfCombat("DEN_AttackOnDen_CaveCombat");
		
		IF
		FlagSet(DEN_AttackOnDen_State_Victorious_ebe2c997-93ae-93f2-7f11-34057122b19b, (CHARACTER)_Raider, _)
		AND
		DB_DEN_AttackOnDen_RaiderVictoryPositions(_Raider, _Pos)
		THEN
		SetCombatGroupID(_Raider, "");
		SetFaction(_Raider, ACT1_DEN_AttackRaiders_Standby_aca56eff-f292-1b69-8f22-ec96197b8d25);
		SetEntityEvent(_Raider, "ClearPeaceReturn", 1);
		PROC_CharacterMoveTo(_Raider, _Pos, "Run", "DEN_AttackOnDen_Victory");
		
		IF
		FlagSet(DEN_AttackOnDen_State_Victorious_ebe2c997-93ae-93f2-7f11-34057122b19b, (CHARACTER)_Raider, _)
		AND
		DB_DEN_AttackOnDen_CaveRaiders(_Raider)
		THEN
		SetEntityEvent(_Raider,"DEN_AttackOnDen_Victory");
		
		IF
		WentOnStage((CHARACTER)_Raider,1)
		AND
		DB_DEN_AttackOnDen_Raiders(_Raider,_,_,_)
		THEN
		SetEntityEvent(_Raider,"GOB_DrowCommander_LeftGoblinCamp");
		
		//END_REGION
		
		//REGION After Cave Combat
		
		PROC
		PROC_DEN_AttackOnDen_EndOfCombat("DEN_AttackOnDen_CaveCombat")
		THEN
		PROC_DEN_AttackOnDen_DruidsLastStand();
		
		PROC
		PROC_DEN_AttackOnDen_EndOfCombat("DEN_AttackOnDen_CaveCombat")
		AND
		GetFlag(DEN_AttackOnDen_State_RaidersInDen_5e839d5f-3e25-4b56-b758-81d25c9cbd33, NULL_00000000-0000-0000-0000-000000000000, 1)
		AND
		NOT DB_DEN_AttackOnDen_DefeatCounterComplete("DEN_AttackOnDen_DefenselessCombat")
		AND
		NOT DB_PermaDefeated(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b)
		THEN
		//Try AD
		PROC_DEN_AttackOnDen_RaidersToSafeArea();
		
		PROC
		PROC_DEN_AttackOnDen_RaidersToSafeArea()
		AND
		DB_DEN_AttackOnDen_SafeRaiders(_Raider)
		AND
		TriggerGetRandomPosition(S_DEN_SafeHoldArea_7e41e6ac-21ea-4235-be57-78a07b389a76, _X, _Y, _Z)
		THEN
		FlushOsirisQueue(_Raider);
		SetEntityEvent(_Raider, "ClearPeaceReturn", 1);
		PROC_CharacterMoveToPosition(_Raider, _X, _Y, _Z, "Run", "DEN_AttackOnDen_RaiderAtPrison");
		
		IF
		DB_GlobalFlag(DEN_AttackOnDen_State_RaidersInDen_5e839d5f-3e25-4b56-b758-81d25c9cbd33)
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_DruidsAreDefeated_3c6d8a2c-dd85-48d1-b48d-f0c6d37959e4)
		AND
		DB_DEN_AttackOnDen_DefeatCounterComplete("DEN_AttackOnDen_CaveCombat")
		THEN
		SetEntityEvent(S_GOB_WarchiefBrave_6601b8f7-1a92-46bb-b409-6fcef7406a39, "ClearPeaceReturn", 1);
		SetFlag(DEN_AttackOnDen_State_Victorious_ebe2c997-93ae-93f2-7f11-34057122b19b, S_GOB_WarchiefBrave_6601b8f7-1a92-46bb-b409-6fcef7406a39);
		
		PROC
		PROC_DEN_AttackOnDen_EndOfCombat("DEN_AttackOnDen_CaveCombat")
		AND
		GetFlag(DEN_AttackOnDen_State_RaidersInDen_5e839d5f-3e25-4b56-b758-81d25c9cbd33, NULL_00000000-0000-0000-0000-000000000000, 1)
		AND
		DB_DEN_AttackOnDen_CaveHoldRaiders(_Raider)
		THEN
		SetEntityEvent(_Raider, "ClearPeaceReturn", 1);
		SetFlag(DEN_AttackOnDen_State_Victorious_ebe2c997-93ae-93f2-7f11-34057122b19b, _Raider);
		
		PROC
		PROC_DEN_AttackOnDen_EndOfCombat("DEN_AttackOnDen_CaveCombat")
		AND
		GetFlag(DEN_AttackOnDen_State_RaidersInDen_5e839d5f-3e25-4b56-b758-81d25c9cbd33, NULL_00000000-0000-0000-0000-000000000000, 1)
		AND
		DB_DEN_AttackOnDen_CaveRaiders(_Raider)
		AND
		NOT DB_DEN_AttackOnDen_SafeRaiders(_Raider)
		THEN
		SetEntityEvent(_Raider, "ClearPeaceReturn", 1);
		SetFlag(DEN_AttackOnDen_State_Victorious_ebe2c997-93ae-93f2-7f11-34057122b19b, _Raider);
		
		PROC
		PROC_DEN_AttackOnDen_EndOfCombat("DEN_AttackOnDen_CaveCombat")
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_RaidersInDen_5e839d5f-3e25-4b56-b758-81d25c9cbd33)
		AND
		DB_DEN_AttackOnDen_AllTieflingsDefeatCounters(1)
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_DrowCelebration")
		THEN
		PROC_RemoveDialog(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b);
		DB_Dialogs(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, DEN_AttackOnDen_Drow_84abf1c9-de21-4db1-cbb1-0046faf2fc45);
		FlushOsirisQueue(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b);
		SetEntityEvent(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, "ClearPeaceReturn", 1);
		SetFlag(DEN_AttackOnDen_State_Victorious_ebe2c997-93ae-93f2-7f11-34057122b19b, S_GOB_WarchiefBrave_6601b8f7-1a92-46bb-b409-6fcef7406a39);
		PROC_AttackOnDen_StartDrowSpotting();
		
		PROC
		PROC_AttackOnDen_StartDrowSpotting()
		THEN
		DB_SpotPlayers(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, "DEN_AttackOnDen_DrowVictory", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		
		PROC
		PROC_SpotPlayers_Spotted(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, "DEN_AttackOnDen_DrowVictory", _Player)
		AND
		QRY_StartDialog(DEN_AttackOnDen_Drow_84abf1c9-de21-4db1-cbb1-0046faf2fc45, S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, _Player)
		THEN
		DB_NOOP(1);
		PROC_CharacterMoveToAndTalk(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, _Player, DEN_AttackOnDen_Drow_84abf1c9-de21-4db1-cbb1-0046faf2fc45, "DEN_AttackOnDen_DrowMovesToPlayer", "Run", 20.0);
		
		IF
		DB_DEN_AttackOnDen_DefeatCounterComplete(_Counter)
		THEN
		DebugBreak(_Counter);
		//END_REGION
		
		//REGION Prison Combat
		
		IF
		DB_Is_InCombat(_Refugee, _ID)
		AND
		DB_DEN_NPC((CHARACTER)_Refugee, "Defenseless", _)
		AND
		DB_Is_InCombat(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, _ID)
		THEN
		ApplyStatus(_Refugee, "FRIGHTENED", -1.0, 1);
		
		IF
		DB_State_Current(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_AttackOnDen")
		AND
		DB_DEN_NPC((CHARACTER)_Refugee, "Defenseless", _)
		THEN
		RequestSetSwarmGroup(_Refugee,"DEN_AttackOnDen_DefenselessNPC");
		
		IF
		FlagSet((FLAG)DEN_AttackOnDen_State_DenVictory_71c7f23e-3ff1-c9b8-3ef5-d75fa1b42c8d, _, _)
		AND
		DB_DEN_NPC((CHARACTER)_Refugee, "Defenseless", _)
		THEN
		RequestSetSwarmGroup(_Refugee,"");
		
		IF
		CombatStarted(_ID)
		AND
		DB_State_Current(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_AttackOnDen")
		AND
		NOT DB_OnlyOnce("DEN_AttackOnDen_DefenselessFacing")
		AND
		DB_DEN_NPC(_Refugee, "Defenseless", _)
		AND
		DB_Is_InCombat(_Refugee, _ID)
		AND
		IsInTrigger(_Refugee, S_DEN_SafetyIntroArea_0a8547e8-e0b2-4c46-abdd-a0a2f1a5faf8, 1)
		THEN
		LookAtEntity(_Refugee,S_DEN_TieflingLeaderInDoor_a5378747-7087-4adf-a529-8ce24ae9d1e2);
		DB_OnlyOnce("DEN_AttackOnDen_DefenselessFacing");
		
		IF
		TurnStarted(_Refugee)
		AND
		DB_Is_InCombat(_Refugee, _ID)
		AND
		DB_DEN_NPC((CHARACTER)_Refugee, "Defenseless", _)
		AND
		DB_Is_InCombat(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, _ID)
		THEN
		FleeFrom(_Refugee,"Enemy",5.0);
		
		IF
		EntityEvent(_Raider, "DEN_AttackOnDen_RaiderAtPrison")
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_DefenselessCombat")
		THEN
		PROC_SetRelationMutual((FACTION)ACT1_DEN_AttackOnDen_Defenseless_0d52984d-82c0-44b3-861c-5f8107982525,(FACTION)ACT1_DEN_AttackRaiders_Fighters_bfdc773b-6521-4fd1-3784-3d1404f1b2f5, 0);
		
		//END_REGION
		
		//REGION After Prison Combat
		
		PROC
		PROC_DEN_AttackOnDen_EndOfCombat("DEN_AttackOnDen_DefenselessCombat")
		AND
		DB_DEN_AttackOnDen_DefeatCounterComplete("DEN_AttackOnDen_CaveCombat")
		AND 
		DB_DEN_AttackOnDen_DefeatCounterComplete("DEN_AttackOnDen_GateCombat")
		THEN
		ClearFlag(DEN_AttackOnDen_State_UnderAttack_4ebba932-b9cf-41c5-b897-e77a63b93511, NULL_00000000-0000-0000-0000-000000000000, 0);	//flagType: Global
		DB_DEN_AttackOnDen_DefeatCounterComplete("DEN_AttackOnDen_DefenselessCombat");
		
		
		IF
		DB_GlobalFlag(DEN_AttackOnDen_State_RaidersInDen_5e839d5f-3e25-4b56-b758-81d25c9cbd33)
		AND
		DB_DEN_AttackOnDen_AllTieflingsDefeatCounters(1)
		THEN
		SetFlag(DEN_AttackOnDen_State_Victorious_ebe2c997-93ae-93f2-7f11-34057122b19b, S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b);
		SetFlag(DEN_AttackOnDen_State_Victorious_ebe2c997-93ae-93f2-7f11-34057122b19b, S_GOB_WarchiefGrumpy_126e39d1-7c38-453c-888b-4cddce7f3e41);
		SetFlag(DEN_AttackOnDen_State_Victorious_ebe2c997-93ae-93f2-7f11-34057122b19b, S_GOB_RaiderArrogant_43d953fa-575e-452c-b220-939e6bdcc36b);
		
		
		PROC
		PROC_DEN_AttackOnDen_EndOfCombat("DEN_AttackOnDen_DefenselessCombat")
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_RaidersInDen_5e839d5f-3e25-4b56-b758-81d25c9cbd33)
		AND
		DB_DEN_AttackOnDen_AllTieflingsDefeatCounters(1)
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_DrowCelebration")
		THEN
		PROC_RemoveDialog(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b);
		DB_Dialogs(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, DEN_AttackOnDen_Drow_84abf1c9-de21-4db1-cbb1-0046faf2fc45);
		FlushOsirisQueue(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b);
		SetEntityEvent(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, "ClearPeaceReturn", 1);
		PROC_AttackOnDen_StartDrowSpotting();
		
		
		//END_REGION
		
		//REGION End of event
		
		IF
		FlagSet(DEN_AttackOnDen_State_RaiderVictory_abe1bce8-c234-4afe-a490-76210d98a078, _, _)
		THEN
		PROC_DEN_AttackOnDen_ClearPartyDialogSuppression();
		
		IF
		FlagSet(DEN_AttackOnDen_State_DenVictory_71c7f23e-3ff1-c9b8-3ef5-d75fa1b42c8d, _, _)
		THEN
		PROC_DEN_AttackOnDen_ClearPartyDialogSuppression();
		
		PROC
		PROC_DEN_AttackOnDen_ClearPartyDialogSuppression()
		THEN
		NOT DB_PartyDialogSuppressionZone(S_DEN_AttackOnDenArea_66fa72fc-fd29-4608-89c1-6048467f4091);
		
		PROC
		PROC_DEN_AttackOnDen_ClearPartyDialogSuppression()
		AND
		DB_DEN_InDenTriggers(_Trigger)
		THEN
		NOT DB_PartyDialogSuppressionZone(_Trigger);
		
		IF
		FlagSet(DEN_AttackOnDen_State_RaiderVictory_abe1bce8-c234-4afe-a490-76210d98a078, _, _)
		THEN
		SetImmortal(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, 0);
		PROC_State_Progress(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_RaiderVictory");
		
		IF
		DB_DEN_AttackOnDen_DefeatCounterComplete("DEN_AttackOnDen_CaveCombat")
		AND
		DB_DEN_AttackOnDen_DefeatCounterComplete("DEN_AttackOnDen_DefenselessCombat")
		AND
		DB_DEN_AttackOnDen_DefeatCounterComplete("DEN_AttackOnDen_GateCombat")
		THEN
		DB_DEN_AttackOnDen_AllTieflingsDefeatCounters(1);
		
		IF
		DB_DEN_AttackOnDen_AllTieflingsDefeatCounters(1)
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_DruidsAreDefeated_3c6d8a2c-dd85-48d1-b48d-f0c6d37959e4)
		THEN
		ClearFlag(DEN_AttackOnDen_State_UnderAttack_4ebba932-b9cf-41c5-b897-e77a63b93511, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetFlag(DEN_AttackOnDen_State_RaiderVictory_abe1bce8-c234-4afe-a490-76210d98a078, NULL_00000000-0000-0000-0000-000000000000, 0);	//flagType: Global
		
		PROC
		PROC_DEN_AttackOnDen_KillEveryone()
		AND
		DB_DEN_NPC(_NPC, _Role, _AttackOnDenDialog)
		THEN
		Die(_NPC, DEATHTYPE.DoT, 1);
		//END_REGION
		
		//REGION Debug
		
		IF
		FlagSet(DEN_AttackOnDen_Debug_Start_10b6026f-b246-7f88-aa40-a653fe08d861, _, _)
		THEN
		DB_GOB_DrowCommander_DEBUG_BlockSortie(1);
		SetFlag(GOB_DrowCommander_Event_RaidersSortie_26816b01-2d64-b50c-3bf6-bffd7dc5f0b9, NULL_00000000-0000-0000-0000-000000000000, 0);
		PROC_GOB_DrowCommander_RaidersForceLeave();
		
		IF
		TextEvent("ReadyAttackOnDen")
		THEN
		PROC_DEN_RaidingParty_DebugResolveConfrontation();
		PROC_TeleportPartiesTo(S_CHA_Debug_LaezelRecruitPoint_22095e5a-57af-438e-a303-6c5a38b2cef8, "");
		SetFlag(DEN_AttackOnDen_Debug_Start_10b6026f-b246-7f88-aa40-a653fe08d861, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		DB_GlobalFlag(DEN_AttackOnDen_Debug_Start_10b6026f-b246-7f88-aa40-a653fe08d861)
		AND
		DB_GlobalFlag(GLO_AttackOnDen_State_RaidReady_eb361773-da88-dee4-f4c8-a22acae60948)
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_StartSetup")
		THEN
		PROC_State_IfCurrentProgressElse(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_LockdownComplete", "DEN_State_LockdownAttackOnDen", "DEN_State_AttackOnDen");
		
		//TODO: Debugs for ending the event with either resolution (tieflings/raider victory)
		
		//END_REGION
		
		//REGION Kids die
		
		IF
		DB_GlobalFlag(DEN_AttackOnDen_State_RaidersInDen_5e839d5f-3e25-4b56-b758-81d25c9cbd33)
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_HostileTieflings_c5641caa-4409-4739-a1fe-8263b8271f4e)
		AND
		NOT QRY_TriggerEvents_AnyPlayerInTrigger(S_DEN_HideoutArea_c4f9e65f-fc63-42b6-bd2e-eba70b24a700)
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_KidsDieOrRun")
		THEN
		PROC_DEN_AttackOnDen_KillKids();
		
		IF
		DB_GlobalFlag(DEN_AttackOnDen_State_HostileTieflings_c5641caa-4409-4739-a1fe-8263b8271f4e)
		AND
		QRY_TriggerEvents_AnyPlayerInTrigger(S_DEN_HideoutArea_c4f9e65f-fc63-42b6-bd2e-eba70b24a700)
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_KidsDieOrRun")
		THEN
		PROC_DEN_AttackOnDen_KidsRunAway();
		
		IF
		EnteredTrigger(_Player, S_DEN_HideoutArea_c4f9e65f-fc63-42b6-bd2e-eba70b24a700)
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_KidsDieOrRun")
		THEN
		PROC_DEN_AttackOnDen_KidsRunAway();
		
		PROC
		PROC_DEN_AttackOnDen_KidsRunAway()
		AND
		DB_DEN_NPC(_Kid, "Hideout", _)
		THEN
		PROC_ForceStopDialog(_Kid);
		PROC_DisappearOutOfSight(_Kid, "Run", 1, "");
		
		PROC
		PROC_DEN_AttackOnDen_KidsRunAway()
		THEN
		PROC_ForceStopDialog(S_DEN_Bard_4a405fba-3000-4c63-97e5-a8001ebb883c);
		PROC_TryStartAD(DEN_AttackOnDen_AD_BardDefendsKids_4891a78e-5b0c-c5b6-f1a6-35c38aadc939, S_DEN_Bard_4a405fba-3000-4c63-97e5-a8001ebb883c);
		
		PROC
		PROC_DEN_AttackOnDen_KillKids()
		AND
		DB_DEN_NPC(_Kid, "Hideout", _)
		THEN
		DB_DEN_AttackOnDen_DeadKid(_Kid);
		SetImmortal(_Kid,0);
		Die(_Kid, DEATHTYPE.DoT, 1);
		CreatePuddle(_Kid, "SurfaceBlood", 10, 15, 10,20, 1.0);
		
		PROC
		PROC_DEN_AttackOnDen_KillKids()
		THEN
		Die(S_DEN_Bard_4a405fba-3000-4c63-97e5-a8001ebb883c, DEATHTYPE.DoT, 1);
		CreatePuddle(S_DEN_Bard_4a405fba-3000-4c63-97e5-a8001ebb883c, "SurfaceBlood", 10, 15, 10,20, 1.0);
		SetOnStage(S_GOB_RaiderThirsty_64889786-dbc4-4acf-b17b-149527e898c7, 1);
		SetOnStage(S_GOB_RaiderMurderous_04428629-2857-4795-b9b6-b41a06d9a889, 1);
		
		IF
		DB_DEN_AttackOnDen_DeadKid(_Kid)
		AND
		DB_Sees(_Player,_Kid)
		AND
		DB_Players(_Player)
		AND
		NOT DB_CantTalk(_Player)
		AND
		NOT DB_DEN_AttackOnDen_DeadKidsReaction(1)
		THEN
		StartVoiceBark(DEN_AttackOnDen_VB_DeadKids_3282fab5-a566-96be-d472-e69d93434f35, _Player);
		DB_DEN_AttackOnDen_DeadKidsReaction(1);
		
		//END_REGION
		
		//REGION Den Victory Scene
		
		
		IF
		DB_DEN_CurrentDefenderLeader(_Leader)
		THEN
		SetDualEntityEvent(_Leader, S_DEN_LeaderVictoryPos_04e4c483-3125-40bc-9bfe-e9bfa589b6d7, "DEN_AttackOnDen_VictoryPosition");
		
		PROC
		PROC_DEN_AttackOnDen_VictoryInvitation()
		AND
		DB_DEN_CurrentDefenderLeader(_Leader)
		THEN
		SetFlag(DEN_AttackOnDen_State_WaitingForCelebration_97e3e4e8-eab2-4d32-1ae7-f0ba20a75c42, _Leader, 0);
		PROC_DEN_Gate_OpenOrCloseGate(0);
		PROC_State_Progress(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_AttackOnDenVictory");
		
		PROC 
		PROC_State_Changed(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_AttackOnDenVictory")
		THEN
		PROC_DEN_AttackOnDen_Victory();
		
		PROC
		PROC_DEN_AttackOnDen_Victory()
		AND
		DB_DEN_AttackOnDen_NonLeaveNPCs(_NPC, _Pos)
		THEN
		PROC_CharacterMoveTo(_NPC, _Pos, "Walk", "");
		
		PROC
		PROC_DEN_AttackOnDen_Victory()
		AND
		GetEquippedItem(S_DEN_Trainee_001_1f839ad2-2bcb-47d2-8de9-db7a1fb5d67f, "Melee Main Weapon", _Weapon)
		THEN
		RequestDelete(_Weapon);
		
		PROC
		PROC_DEN_AttackOnDen_Victory()
		AND
		DB_PermaDefeated(S_DEN_TieflingLeader_475200ee-cc3c-4dbe-84b1-1820c02ea26a)
		AND
		DB_PermaDefeated(S_DEN_Trainer_02025646-347a-4235-aef7-e46b7c94b435)
		THEN
		SetOnStage(S_DEN_BackupLeader_b304e07d-019c-4ec6-b5ea-c4ccb29ed892, 1);
		TriggerRegisterForCharacter(S_DEN_VictorySceneArea_a0b30a20-2514-4238-b220-fdf45c6a4f19, S_DEN_BackupLeader_b304e07d-019c-4ec6-b5ea-c4ccb29ed892);
		
		//Move Halsin to the Grove as soon as Cerys is set on stage.
		PROC
		PROC_DEN_AttackOnDen_Victory()
		AND
		DB_DEN_CurrentDefenderLeader(S_DEN_BackupLeader_b304e07d-019c-4ec6-b5ea-c4ccb29ed892)
		AND
		DB_GLO_Halsin_ReadyForDen(1)
		THEN
		PROC_GLO_Halsin_TeleportToDen();
		
		IF
		EnteredTrigger(S_DEN_BackupLeader_b304e07d-019c-4ec6-b5ea-c4ccb29ed892, S_DEN_VictorySceneArea_a0b30a20-2514-4238-b220-fdf45c6a4f19)
		THEN
		PROC_AttackOnDen_TryRegisterBackupSpotting();
		TriggerUnregisterForCharacter(S_DEN_VictorySceneArea_a0b30a20-2514-4238-b220-fdf45c6a4f19, S_DEN_BackupLeader_b304e07d-019c-4ec6-b5ea-c4ccb29ed892);
		
		PROC
		PROC_AttackOnDen_TryRegisterBackupSpotting()
		AND
		NOT DB_GlobalFlag(DEN_AttackOnDen_Event_TieflingPartyInvitation_545593fd-42e6-15c1-1e96-18e0e0be0443)
		THEN
		DB_SpotPlayers_SpotTrigger(S_DEN_BackupLeader_b304e07d-019c-4ec6-b5ea-c4ccb29ed892, "DEN_AttackOnDen_BackupVictorySpotting",S_DEN_VictorySceneArea_a0b30a20-2514-4238-b220-fdf45c6a4f19);
		DB_SpotPlayers(S_DEN_BackupLeader_b304e07d-019c-4ec6-b5ea-c4ccb29ed892, "DEN_AttackOnDen_BackupVictorySpotting", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		
		PROC
		PROC_SpotPlayers_Spotted(S_DEN_BackupLeader_b304e07d-019c-4ec6-b5ea-c4ccb29ed892, "DEN_AttackOnDen_BackupVictorySpotting", _Player)
		AND
		QRY_StartDialog(DEN_AttackOnDen_BackupLeader_92b83e7a-534b-ebbc-8e8a-7a89d0d1bdab, S_DEN_BackupLeader_b304e07d-019c-4ec6-b5ea-c4ccb29ed892, _Player)
		THEN
		DB_NOOP(1);
		
		IF
		EntityEvent((CHARACTER)_Leader, "DEN_AttackOnDen_VictoryMoveComplete")
		AND
		DB_DEN_CurrentDefenderLeader(_Leader)
		AND
		NOT DB_GLO_Halsin_DebugAttackOnDenMeet(1)
		THEN
		PROC_TriggerRegisterForPlayers(S_DEN_VictorySceneArea_a0b30a20-2514-4238-b220-fdf45c6a4f19);
		
		
		IF
		DialogStarted(_Dialog, _)
		AND
		DB_DEN_AttackOnDen_VictoryDialogs(_, _Dialog)
		AND
		NOT DB_GlobalFlag(DEN_AttackOnDen_Event_TieflingPartyInvitation_545593fd-42e6-15c1-1e96-18e0e0be0443)
		THEN
		SetFlag(DEN_AttackOnDen_Event_TieflingPartyInvitation_545593fd-42e6-15c1-1e96-18e0e0be0443, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		DB_InRegion(_Player, S_DEN_VictorySceneArea_a0b30a20-2514-4238-b220-fdf45c6a4f19)
		AND
		DB_DEN_CurrentDefenderLeader(_Leader)
		AND
		_Leader != S_DEN_BackupLeader_b304e07d-019c-4ec6-b5ea-c4ccb29ed892
		AND
		NOT DB_DialogNPCs(_, _Leader, _)
		AND
		NOT DB_CantTalk(_Player)
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_VictoryScene")
		AND
		DB_DEN_AttackOnDen_VictoryDialogs(_Leader, _Dialog)
		AND
		QRY_StartDialog(_Dialog, _Leader, _Player)
		THEN
		DB_NOOP(1);
		
		
		IF
		DB_DialogName(_Dialog, _ID)
		AND
		DB_DEN_AttackOnDen_VictoryDialogs(_, _Dialog)
		AND
		NOT DB_GlobalFlag(DEN_AttackOnDen_Event_VictorySpeech_8d24f0ca-a22d-f4fa-5bc5-931dd02bfb56)
		AND
		DB_Players(_Player)
		AND
		NOT DB_CantTalk_IgnoreStatuses(_Player)
		AND
		QRY_DEN_IsInDen(_Player, 1, S_DEN_DruidVault_SUB_f4c22466-5963-4192-b939-f1056f4f806a, S_DEN_Tunnel_SUB_6d2ed20e-f315-463a-9783-d02b173cb35a)
		THEN
		PROC_DialogAddListeningActor(_ID, _Player);
		
		IF
		DialogStarted(_Dialog, _ID)
		AND
		DB_DEN_AttackOnDen_VictoryDialogs(_, _Dialog)
		AND
		NOT DB_GlobalFlag(DEN_AttackOnDen_Event_VictorySpeech_8d24f0ca-a22d-f4fa-5bc5-931dd02bfb56)
		AND
		DB_DEN_NPC(_NPC, _, _)
		AND
		NOT DB_Defeated(_NPC)
		AND
		DB_DEN_CurrentDefenderLeader(_Leader)
		AND
		_NPC != _Leader
		THEN
		PROC_ForceStopDialog(_NPC);
		SetEntityEvent(_NPC, "DEN_AttackOnDen_TeleportToVictoryPos");
		
		IF
		DialogStarted(_Dialog, _ID)
		AND
		DB_DEN_AttackOnDen_VictoryDialogs(_, _Dialog)
		AND
		NOT DB_GlobalFlag(DEN_AttackOnDen_Event_VictorySpeech_8d24f0ca-a22d-f4fa-5bc5-931dd02bfb56)
		THEN
		SetFlag(DEN_AttackOnDen_Event_VictorySpeech_8d24f0ca-a22d-f4fa-5bc5-931dd02bfb56, NULL_00000000-0000-0000-0000-000000000000, 0);	//flagType: Global
		
		IF
		RelationChanged(ACT1_DEN_AttackOnDen_NPC_08f28bce-a261-35e2-9914-6aa8b3eea155, Hero_a1542c81-6895-929e-4522-10ce218bb360, _Relation, 1)
		AND
		_Relation < 50
		THEN
		SetFlag((FLAG)DEN_AttackOnDen_State_HostileTieflings_c5641caa-4409-4739-a1fe-8263b8271f4e, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		PROC
		PROC_StateSet_PermaDefeated((CHARACTER)_NPC)
		AND
		DB_DEN_NPC(_NPC, _, _)
		AND
		DB_DEN_AttackOnDen_LeaveNPCs(_NPC)
		AND
		DB_State_Current(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_AttackOnDenVictory")
		AND
		DB_Players(_Player)
		AND
		IsEnemy(_NPC, _Player, 1)
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_BetrayTieflingsAfterVictory")
		THEN
		PROC_DEN_AttackOnDen_BetrayTieflings();
		SetFlag(DEN_AttackOnDen_State_HostileTieflings_c5641caa-4409-4739-a1fe-8263b8271f4e, NULL_00000000-0000-0000-0000-000000000000, 0);
		PROC_SetRelationMutual((FACTION)ACT1_DEN_AttackOnDen_NPC_08f28bce-a261-35e2-9914-6aa8b3eea155, (FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, 0);
		
		//END_REGION
		
		//REGION Chef and son scene
		
		PROC
		PROC_DEN_AttackOnDen_Start()
		AND
		NOT DB_PermaDefeated((CHARACTER)S_DEN_Tiefling_FoodTrader_001_1b35671b-e5d7-4943-bbd0-4c816b69b7cb)
		AND
		NOT DB_PermaDefeated((CHARACTER)S_DEN_Tiefling_008_03b6fae4-d250-4ce9-9a01-19cb427deb17)
		THEN
		PROC_TriggerRegisterForPlayers(S_DEN_SafetyIntroArea_0a8547e8-e0b2-4c46-abdd-a0a2f1a5faf8);
		
		
		QRY
		QRY_SelectCustomDialog_AfterGenerics(S_DEN_Tiefling_008_03b6fae4-d250-4ce9-9a01-19cb427deb17, _Player)
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_UnderAttack_4ebba932-b9cf-41c5-b897-e77a63b93511)
		AND
		NOT DB_GlobalFlag(DEN_AttackOnDen_Event_ChefAndSonTalked_1877570b-a0f3-4d65-bbba-7db56293242a)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_DEN_Tiefling_008_03b6fae4-d250-4ce9-9a01-19cb427deb17, S_DEN_Tiefling_FoodTrader_001_1b35671b-e5d7-4943-bbd0-4c816b69b7cb)
		THEN
		DB_SelectedDialog(DEN_AttackOnDen_ChefAndSon_133f2381-a171-71f8-859d-9b9660d6e69b, S_DEN_Tiefling_008_03b6fae4-d250-4ce9-9a01-19cb427deb17, S_DEN_Tiefling_FoodTrader_001_1b35671b-e5d7-4943-bbd0-4c816b69b7cb, _Player);
		
		
		QRY
		QRY_SelectCustomDialog_AfterGenerics(S_DEN_Tiefling_FoodTrader_001_1b35671b-e5d7-4943-bbd0-4c816b69b7cb, _Player)
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_UnderAttack_4ebba932-b9cf-41c5-b897-e77a63b93511)
		AND
		NOT DB_GlobalFlag(DEN_AttackOnDen_Event_ChefAndSonTalked_1877570b-a0f3-4d65-bbba-7db56293242a)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_DEN_Tiefling_FoodTrader_001_1b35671b-e5d7-4943-bbd0-4c816b69b7cb, S_DEN_Tiefling_008_03b6fae4-d250-4ce9-9a01-19cb427deb17)
		THEN
		DB_SelectedDialog(DEN_AttackOnDen_ChefAndSon_133f2381-a171-71f8-859d-9b9660d6e69b, S_DEN_Tiefling_008_03b6fae4-d250-4ce9-9a01-19cb427deb17, S_DEN_Tiefling_FoodTrader_001_1b35671b-e5d7-4943-bbd0-4c816b69b7cb, _Player);
		
		IF
		DialogStarted(DEN_AttackOnDen_ChefAndSon_133f2381-a171-71f8-859d-9b9660d6e69b, _)
		THEN
		PROC_TriggerUnregisterForPlayers(S_DEN_SafetyIntroArea_0a8547e8-e0b2-4c46-abdd-a0a2f1a5faf8);
		SetFlag(DEN_AttackOnDen_Event_ChefAndSonTalked_1877570b-a0f3-4d65-bbba-7db56293242a, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		DB_InRegion(_Player, S_DEN_SafetyIntroArea_0a8547e8-e0b2-4c46-abdd-a0a2f1a5faf8)
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_UnderAttack_4ebba932-b9cf-41c5-b897-e77a63b93511)
		AND
		NOT DB_GlobalFlag(DEN_AttackOnDen_State_HostileTieflings_c5641caa-4409-4739-a1fe-8263b8271f4e)
		AND
		NOT DB_GlobalFlag(DEN_AttackOnDen_Event_ChefAndSonTalked_1877570b-a0f3-4d65-bbba-7db56293242a)
		AND
		DB_Players(_Player)
		AND
		NOT DB_HiddenCharacters(_Player,_)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_DEN_Tiefling_FoodTrader_001_1b35671b-e5d7-4943-bbd0-4c816b69b7cb, S_DEN_Tiefling_008_03b6fae4-d250-4ce9-9a01-19cb427deb17)
		AND
		QRY_SpeakerIsAvailable(S_DEN_Tiefling_008_03b6fae4-d250-4ce9-9a01-19cb427deb17)
		AND
		QRY_StartDialog(DEN_AttackOnDen_ChefAndSon_133f2381-a171-71f8-859d-9b9660d6e69b, S_DEN_Tiefling_008_03b6fae4-d250-4ce9-9a01-19cb427deb17, S_DEN_Tiefling_FoodTrader_001_1b35671b-e5d7-4943-bbd0-4c816b69b7cb, _Player)
		THEN
		DB_NOOP(1);
		
		IF
		DialogEnded(DEN_AttackOnDen_ChefAndSon_133f2381-a171-71f8-859d-9b9660d6e69b, _)
		THEN
		PROC_TryStartAD(DEN_AttackOnDen_AD_ChefAndSon_314aadc8-7c5a-aa74-a2df-bd3c99613eef, (CHARACTER)S_DEN_Tiefling_FoodTrader_001_1b35671b-e5d7-4943-bbd0-4c816b69b7cb, (CHARACTER)S_DEN_Tiefling_008_03b6fae4-d250-4ce9-9a01-19cb427deb17);
		//END_REGION
		
		//REGION Prodigy 4-way dialog
		
		QRY
		QRY_SelectCustomDialog_AfterGenerics(_NPC, _Player)
		AND
		DB_State_Current(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_AttackOnDen")
		AND
		DB_GLO_Prodigy_NPCs(_NPC)
		THEN
		DB_SelectedDialog(DEN_AttackOnDen_ProdigyTrio_d43f9a4f-c19d-cb84-54cd-1193b76b9de7, S_GLO_Prodigy_b6a3a9e9-b6eb-4c19-ab3f-4c431178fe1b, S_GLO_ProdigySister_44d09b0b-0568-456c-b18d-559a0a3f981d, S_GLO_ProdigyBrother_d0187724-c0e2-4019-a01d-a03ee8153f1b, _Player);
		
		
		//END_REGION
		
		//REGION Memnos fight conditionals
		
		IF
		DialogActorLeft(DEN_AttackOnDen_GrieflingFriend_ab984a7f-9474-e39d-714a-eb63c948173a, _, S_DEN_GrieflingFriend_c3334ee5-38dc-4197-aacc-4aa55803ff52,_)
		AND
		DB_GlobalFlag(DEN_AttackOnDen_Event_GrieflingFriendFights_e614acaf-3696-4ec4-903b-178d11076148)
		THEN
		NOT DB_DEN_AttackOnDen_MoveAfterRaidStarted(S_DEN_GrieflingFriend_c3334ee5-38dc-4197-aacc-4aa55803ff52, S_DEN_SafetyPos_003_bf03ff45-ba26-46d0-b8f6-9a69ebd079da);
		SetCombatGroupID(S_DEN_GrieflingFriend_c3334ee5-38dc-4197-aacc-4aa55803ff52, "");
		SetFaction(S_DEN_GrieflingFriend_c3334ee5-38dc-4197-aacc-4aa55803ff52, (FACTION)ACT1_DEN_AttackOnDen_Cave_be9ef27b-18d4-4168-a798-5c6b744e0c08);
		PROC_CharacterMoveTo(S_DEN_GrieflingFriend_c3334ee5-38dc-4197-aacc-4aa55803ff52, S_DEN_AttackFriendCavePos_003_67a8fa52-c949-44a4-aa1b-0bb17170c102, "Run", "");
		NOT DB_DEN_AttackOnDen_FleeingTieflings(S_DEN_GrieflingFriend_c3334ee5-38dc-4197-aacc-4aa55803ff52);
		
		//END_REGION
		
		//REGION Sound
		
		PROC
		PROC_DEN_AttackOnDen_Start()
		AND
		DB_DEN_AttackOnDen_Raiders(_Raider,_,_,_)
		THEN
		DB_Sound_ScriptedCombatMusic(_Raider,"DEN_AttackOnDen");
		
		//END_REGION
		
		//REGION Setup end
		
		PROC
		PROC_DEN_AttackOnDen_Start()
		THEN
		PROC_DEN_AttackOnDen_SetupOver();
		
		PROC
		PROC_DEN_AttackOnDen_SetupOver()
		THEN
		DB_NOOP(1);
		
		//END_REGION
		
		//REGION Druid encounter
		
		IF
		DB_DEN_AttackOnDen_DruidEncounter(_Character, _)
		THEN
		DB_GLO_DefeatCounter(_Character, "DEN_AttackOnDen_DruidFight");
		
		PROC
		PROC_GLO_DefeatCounter_AllDefeated("DEN_AttackOnDen_DruidFight")
		THEN
		SetFlag(DEN_AttackOnDen_State_DruidsAreDefeated_3c6d8a2c-dd85-48d1-b48d-f0c6d37959e4, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		PROC
		PROC_GLO_DefeatCounter_AllDefeated("DEN_AttackOnDen_DruidFight")
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_RaidersInDen_5e839d5f-3e25-4b56-b758-81d25c9cbd33)
		AND
		DB_DEN_AttackOnDen_DruidRaiders(_Raider)
		THEN
		SetFlag(DEN_AttackOnDen_State_Victorious_ebe2c997-93ae-93f2-7f11-34057122b19b, _Raider, 0);
		
		PROC
		PROC_GLO_DefeatCounter_AllDefeated("DEN_AttackOnDen_DruidFight")
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_RaidersInDen_5e839d5f-3e25-4b56-b758-81d25c9cbd33)
		AND
		NOT DB_PermaDefeated(S_GOB_WarchiefBrave_6601b8f7-1a92-46bb-b409-6fcef7406a39)
		THEN
		SetFlag(DEN_AttackOnDen_State_Victorious_ebe2c997-93ae-93f2-7f11-34057122b19b, S_GOB_WarchiefBrave_6601b8f7-1a92-46bb-b409-6fcef7406a39, 0);
		PROC_CharacterMoveTo(S_GOB_WarchiefBrave_6601b8f7-1a92-46bb-b409-6fcef7406a39, S_DEN_CaveHoldArea2_4d34380b-ef29-4d6e-9cf8-72aa39851a05, "Run", "");
		
		PROC
		PROC_DEN_AttackOnDen_DruidsLastStand()
		AND
		NOT DB_GlobalFlag(DEN_AttackOnDen_State_DruidsAreDefeated_3c6d8a2c-dd85-48d1-b48d-f0c6d37959e4)
		AND
		DB_DEN_AttackOnDen_DruidEncounter(_Druid, _Position)
		AND
		DB_DEN_NPC(_Druid, "Lair", _)
		THEN
		PROC_CharacterMoveTo(_Druid, _Position, "Run", "DEN_AttackOnDen_DruidAtCombatPos");
		
		IF
		EntityEvent((CHARACTER)_Druid, "DEN_AttackOnDen_DruidAtCombatPos")
		AND
		DB_DEN_AttackOnDen_DruidEncounter(_Druid, _Position)
		THEN
		LookFromTrigger(_Druid, _Position, 0);
		
		PROC
		PROC_StateSet_PermaDefeated((CHARACTER)_Druid)
		AND
		DB_DEN_AttackOnDen_DruidEncounter(_Druid, _Position)
		THEN
		NOT DB_DEN_AttackOnDen_DruidEncounter(_Druid, _Position);
		//END_REGION
		
		//REGION Sacred Idol
		
		IF
		DB_State_Current(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_AttackOnDen")
		AND
		IsInTrigger(S_DEN_SilvanusIdol_a841d36c-9a00-4a26-943e-c0af6895bb16,S_DEN_PondOwnership_aff112d5-b79e-405e-9114-6b70aea65a06,1)
		THEN
		NOT DB_DEN_DruidAttack_CurrentIdolTrigger(S_DEN_PondOwnership_aff112d5-b79e-405e-9114-6b70aea65a06);
		DB_DEN_DruidAttack_CurrentIdolTrigger(S_DEN_DruidEntrance_Ownership_137c1348-fafd-44cf-924e-eb4df6de9bb6);
		TeleportTo(S_DEN_SilvanusIdol_a841d36c-9a00-4a26-943e-c0af6895bb16,S_DEN_AttackOnDen_IdolPoint_0d2b6b1c-05e7-47dc-ac92-a6a7cfe7090a);
		
		//END_REGION
		
		//REGION Restore forbidden return area at end of AoD
		
		PROC
		PROC_State_Changed(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_AttackOnDenVictory")
		THEN
		NOT DB_LeaveCamp_ForbiddenReturnArea("WLD_Main_A", (TRIGGER)S_DEN_DruidLair_SUB_a9794f19-187a-4d79-b739-443548411d29, (TRIGGER)S_DEN_WaypointPos_cdd91969-67d0-454e-b27b-cf34e542956b);
		NOT DB_LeaveCamp_ForbiddenReturnArea("WLD_Main_A", (TRIGGER)S_DEN_DruidVault_SUB_f4c22466-5963-4192-b939-f1056f4f806a, (TRIGGER)S_DEN_WaypointPos_cdd91969-67d0-454e-b27b-cf34e542956b);
		
		PROC
		PROC_State_Changed(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_RaiderVictory")
		THEN
		NOT DB_LeaveCamp_ForbiddenReturnArea("WLD_Main_A", (TRIGGER)S_DEN_DruidLair_SUB_a9794f19-187a-4d79-b739-443548411d29, (TRIGGER)S_DEN_WaypointPos_cdd91969-67d0-454e-b27b-cf34e542956b);
		NOT DB_LeaveCamp_ForbiddenReturnArea("WLD_Main_A", (TRIGGER)S_DEN_DruidVault_SUB_f4c22466-5963-4192-b939-f1056f4f806a, (TRIGGER)S_DEN_WaypointPos_cdd91969-67d0-454e-b27b-cf34e542956b);
		
		//END_REGION
		
		//REGION Debugs
		
		
		IF
		TextEvent("attackondenraidervictory")
		THEN
		PROC_DEN_AttackOnDen_DebugRaiderVictory();
		
		PROC
		PROC_DEN_AttackOnDen_DebugRaiderVictory()
		THEN
		SetFaction(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, (FACTION)ACT1_DEN_AttackRaiders_Fighters_bfdc773b-6521-4fd1-3784-3d1404f1b2f5);
		SetCombatGroupID(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, "");
		
		PROC
		PROC_DEN_AttackOnDen_DebugRaiderVictory()
		AND
		DB_DEN_NPC(_Character, _, _)
		THEN
		Die(_Character, DEATHTYPE.DoT, 1);
		
		PROC
		PROC_DEN_AttackOnDen_DebugRaiderVictory()
		AND
		DB_DEN_GateInUse(_Gate)
		THEN
		Die(_Gate);
		SetFlag(DEN_AttackOnDen_State_RaidersAtDen_29f372ac-f9f1-4d54-bc9e-7eb493fa09d8, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetFlag(DEN_AttackOnDen_State_RaidersInDen_5e839d5f-3e25-4b56-b758-81d25c9cbd33, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetFlag(DEN_AttackOnDen_State_RaiderVictory_abe1bce8-c234-4afe-a490-76210d98a078, NULL_00000000-0000-0000-0000-000000000000, 0);
		PROC_SetRelationMutual((FACTION)ACT1_DEN_AttackRaiders_Fighters_bfdc773b-6521-4fd1-3784-3d1404f1b2f5, (FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, 100);
		PROC_SetRelationMutual((FACTION)ACT1_DEN_AttackRaiders_Standby_aca56eff-f292-1b69-8f22-ec96197b8d25, (FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, 100);
		
		PROC
		PROC_DEN_AttackOnDen_DebugRaiderVictory()
		AND
		DB_DEN_AttackOnDen_RaiderVictoryPositions(_Raider, _Position)
		THEN
		NOT DB_DEN_AttackOnDen_RaiderVictoryPositions(_Raider, _Position);
		SetOnStage(_Raider, 1);
		SetCombatGroupID(_Raider, "");
		SetCanJoinCombat(_Raider, 1);
		TeleportTo(_Raider, _Position, "");
		SetEntityEvent(_Raider, "GOB_DrowCommander_LeftGoblinCamp");
		SetFlag(DEN_AttackOnDen_State_Victorious_ebe2c997-93ae-93f2-7f11-34057122b19b, _Raider);
		SetEntityEvent(_Raider, "DEN_AttackOnDen_Victory");
		
		IF
		TextEvent("attackondenvictory")
		THEN
		PROC_DEN_AttackOnDen_DebugDenVictory();
		
		PROC
		PROC_DEN_AttackOnDen_DebugDenVictory()
		THEN
		PROC_TriggerUnregisterForPlayers(S_DEN_LeaderAttackSpotArea_41be541d-570b-447a-9636-6cbab92bbde2);
		PROC_TriggerUnregisterForPlayers(S_DEN_AttackOnDenEntranceArea_b45cb766-c7a2-44c8-bd73-91779cd8ce78);
		DB_OnlyOnce("DEN_AttackOnDen_LeaderEvent");
		DB_OnlyOnce("DEN_AttackOnDen_EntranceEvent");
		
		PROC
		PROC_DEN_AttackOnDen_DebugDenVictory()
		THEN
		SetFlag(DEN_AttackOnDen_State_RaidersAtDen_29f372ac-f9f1-4d54-bc9e-7eb493fa09d8, NULL_00000000-0000-0000-0000-000000000000, 0);
		TeleportTo(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, S_DEN_RaidersAppearPos_002_06ec17f6-b313-49a1-a91d-be76de132da2, "");
		Die(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, DEATHTYPE.DoT, 1);
		
		PROC
		PROC_DEN_AttackOnDen_DebugDenVictory()
		AND
		DB_DEN_AttackOnDen_Raiders(_Raider, _Pos, _, _)
		THEN
		SetOnStage(_Raider, 1);
		TeleportTo(_Raider, _Pos, "");
		Die(_Raider, DEATHTYPE.DoT, 1);
		
		
		IF
		TextEvent("fullattackonden")
		THEN
		ClearFlag(DEN_Prodigy_State_Leaving_5f02e553-2798-7837-0a7c-6996c6352bbc, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetFlag(DEN_Prodigy_State_Staying_479db0b1-cc1b-78bf-3e7b-9840747fbd4f, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetOnStage(S_GLO_Prodigy_b6a3a9e9-b6eb-4c19-ab3f-4c431178fe1b, 1);
		SetOnStage(S_GLO_ProdigySister_44d09b0b-0568-456c-b18d-559a0a3f981d, 1);
		SetOnStage(S_GLO_ProdigyBrother_d0187724-c0e2-4019-a01d-a03ee8153f1b, 1);
		PROC_GOB_WolfPens_HalsinForceBreakoutAndLeaving();
		//END_REGION
		
		//REGION Combat ADs
		
		IF
		TurnStarted(_NPC)
		AND
		DB_CurrentLevel("WLD_Main_A")
		AND
		DB_Is_InCombat(_NPC, _ID)
		AND
		DB_Is_InCombat(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, _ID)
		AND
		DB_DEN_AttackOnDen_FrightenedADs((CHARACTER)_NPC, _Dialog)
		THEN
		NOT DB_DEN_AttackOnDen_FrightenedADs((CHARACTER)_NPC, _Dialog);
		PROC_TryStartAD(_Dialog, _NPC);
		
		IF
		TurnStarted(_NPC)
		AND
		DB_CurrentLevel("WLD_Main_A")
		AND
		DB_GlobalFlag((FLAG)DEN_AttackOnDen_State_HostileTieflings_c5641caa-4409-4739-a1fe-8263b8271f4e)
		AND
		DB_DEN_AttackOnDen_GateCombatADs((CHARACTER)_NPC, _Dialog)
		THEN
		NOT DB_DEN_AttackOnDen_GateCombatADs((CHARACTER)_NPC, _Dialog);
		PROC_TryStartAD(_Dialog, _NPC);
		
		IF
		FlagSet(DEN_AttackOnDen_State_HostileTieflings_c5641caa-4409-4739-a1fe-8263b8271f4e, _, _)
		AND
		DB_Is_InCombat(_Leader, _)
		AND
		DB_DEN_CurrentDefenderLeader((CHARACTER)_Leader)
		AND
		DB_DEN_AttackOnDen_GateCombatADs((CHARACTER)_Leader, _Dialog)
		THEN
		NOT DB_DEN_AttackOnDen_GateCombatADs((CHARACTER)_Leader, _Dialog);
		PROC_TryStartAD(_Dialog, _Leader);
		
		//END_REGION
		
		//REGION Looting
		
		
		QRY
		QRY_CorpseLooting_BlockMakeOwned((CHARACTER)_NPC)
		AND
		DB_DEN_AttackOnDen_BlockOwned(_NPC, 1)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_CorpseLooting_BlockMakeOwned((CHARACTER)_NPC)
		AND
		DB_DEN_AttackOnDen_BlockOwned(_NPC, 0)
		AND
		DB_OnlyOnce("DEN_AttackOnDen_BetrayTieflings")
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_CorpseLooting_BlockMakeOwned(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b)
		AND
		DB_GlobalFlag(GLO_AttackOnDen_State_RaidReady_eb361773-da88-dee4-f4c8-a22acae60948)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_CorpseLooting_BlockMakeOwned((CHARACTER)_Raider)
		AND
		DB_DEN_AttackOnDen_GoblinBarrels(_, _Raider)
		THEN
		DB_NOOP(1);
		
		//END_REGION
		
		//REGION Raiders ignore crimes done to den people and vice versa
		
		PROC
		PROC_CharacterRegisterCrime_Success(_Char, _CrimeType, _StoryActionID, _Evidence, _Victim, _CrimeID)
		AND
		DB_DEN_NPCIsOrWasInDen(_Victim)
		AND
		DB_DEN_AttackOnDen_Raiders(_Raider, _, _, _)
		AND
		DB_CurrentLevel("WLD_Main_A")
		AND
		NOT DB_PermaDefeated(_Raider)
		THEN
		CrimeIgnoreCrime(_CrimeID, _Raider);
		
		PROC
		PROC_CharacterRegisterCrime_Success(_Char, _CrimeType, _StoryActionID, _Evidence, _Victim, _CrimeID)
		AND
		DB_DEN_NPCIsOrWasInDen(_Victim)
		AND
		DB_CurrentLevel("WLD_Main_A")
		THEN
		CrimeIgnoreCrime(_CrimeID, S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b);
		
		PROC
		PROC_CharacterRegisterCrime_Success(_Char, _CrimeType, _StoryActionID, _Evidence, _Victim, _CrimeID)
		AND
		DB_DEN_AttackOnDen_Raiders(_Victim, _, _, _)
		AND
		DB_DEN_NPC(_DenCharacter, _, _)
		THEN
		CrimeIgnoreCrime(_CrimeID, _DenCharacter);
		
		PROC
		PROC_CharacterRegisterCrime_Success(_Char, _CrimeType, _StoryActionID, _Evidence, S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, _CrimeID)
		AND
		DB_DEN_NPC(_DenCharacter, _, _)
		THEN
		CrimeIgnoreCrime(_CrimeID, _DenCharacter);
		
		
		//END_REGION
		
		//REGION Wyll somehow still in defeat counter bug fix
		
		//Somehow Wyll got removed from the Den _after_ the event was setup and
		IF
		DB_DEN_AttackOnDen_TieflingDefeatCounters(_Counter)
		AND
		DB_GLO_DefeatCounter(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, _Counter)
		AND
		NOT DB_DEN_NPC(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, _, _)
		THEN
		NOT DB_GLO_DefeatCounter(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, _Counter);
		PROC_GLO_DefeatCounter_CheckFinished(_Counter);
		
		//END_REGION
		
		//REGION Missing raider last resort fix
		
		IF
		FlagSet(DEN_AttackOnDen_State_RaidersAtDen_29f372ac-f9f1-4d54-bc9e-7eb493fa09d8, _, _)
		THEN
		TimerLaunch("DEN_AttackOnDen_ExcludeMissingRaiders", 3000);
		
		IF
		TimerFinished("DEN_AttackOnDen_ExcludeMissingRaiders")
		THEN
		DB_DEN_AttackOnDen_RaiderExclusionInEffect(1);
		
		IF
		DB_DEN_AttackOnDen_RaiderExclusionInEffect(1)
		AND
		DB_DEN_AttackOnDen_Raiders(_Raider, _, _, _)
		AND
		IsInTrigger(_Raider, S_GOB_ThroneRoom_SUB_bb81678b-641c-43fc-bd41-53295d59be03, 1)
		AND
		DB_GLO_DefeatCounter_Target("DEN_AttackOnDen_RaiderCombat", _Target)
		AND
		IntegerSubtract(_Target, 1, _NewTarget)
		AND
		IntegerMax(_NewTarget, 0, _ActualTarget)
		THEN
		PROC_GOB_DrowCommander_ClearFromRaid(_Raider);
		NOT DB_GLO_DefeatCounter(_Raider, "DEN_AttackOnDen_RaiderCombat");
		NOT DB_GLO_DefeatCounter_Target("DEN_AttackOnDen_RaiderCombat", _Target);
		DB_GLO_DefeatCounter_Target("DEN_AttackOnDen_RaiderCombat", _ActualTarget);
		PROC_GLO_DefeatCounter_CheckFinished("DEN_AttackOnDen_RaiderCombat");
		
		//END_REGION
		
		IF
		FlagSet(Act2_PointOfNoReturnReached_a3155f30-b8f3-4db5-ac21-d3036f4426e3, _, _)
		THEN
		GoalCompleted;
	}
	EXIT
	{
	}
}
Goal(107).Title("Act1_DEN_AttackOnDen_Combat");
