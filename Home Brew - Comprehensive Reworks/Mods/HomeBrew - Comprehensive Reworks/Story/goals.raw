		AND
		GetFlag((FLAG)LOW_SorcerousSundries_Event_HasKarsusBook_c7019855-fcac-4bc5-bacf-9fad0213ab28, S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, 1)
		THEN
