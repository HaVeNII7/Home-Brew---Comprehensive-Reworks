	KB
	{
		//FishAndGrime barrels get moved - reacted to in anubis
		IF
		Moved(_Barrel)
		AND
		DB_LOW_FishAndGrime_Barrels(_Barrel, _Trigger)
		THEN
		SetEntityEvent(S_LOW_FishAndGrime_Sailor_02_b72a36b1-20da-47a7-8e58-b6b53a7f23e7, "LOW_FishAndGrime_Barrels_Moved", 1);
		PROC_LOW_FishAndGrime_BarrelMoved(_Barrel, _Trigger);
		
		PROC
		PROC_LOW_FishAndGrime_BarrelMoved((GUIDSTRING)_Barrel,(TRIGGER)_Trigger)
		AND
		IsInTrigger(_Barrel, _Trigger, 0)
		THEN
		SetFlag((FLAG)LOW_FishAndGrime_BarrelsMoved_992d3547-2dcd-4692-bd4e-4e31ce856f8e);
		
		//Pottery Kid pot is destroyed
		IF
		DestroyedBy(_Pot,_Player,_,_)
		AND
		DB_LOW_Pottery_Pots(_Pot)
		AND
		QRY_OnlyOnce("LOW_PoterKid_Runaway")
		THEN
		PROC_DisappearOutOfSight((CHARACTER)S_LOW_Pottery_Kid_3edafaeb-fa8a-4536-a4f8-19af510278e3,"Run",1,"");
		
		//EastwayWizards magic show
		IF
		StatusApplied(_Illusion, "LOW_EASTWAYWIZARD_MINOR_ILLUSION", _, _)
		AND
		DB_LOW_EastwayWizards_TargetBox(_Wizard, _Trigger)
		AND
		IsInTrigger(_Illusion, _Trigger, 1)
		THEN
		SetEntityEventGuid(_Wizard, "LOW_EastwayWizards_WizardSide_TargetSpawned", _Illusion, 1);
		
		//EastwayFoodCrisis chicken offstage
		PROC
		PROC_LOW_EastwayFoodCrisis_RemoveChicken()
		AND
		DB_EastwayFoodCrisis_Chicken(_Chicken)
		THEN
		SetOnStage(_Chicken,0);
		NOT DB_EastwayFoodCrisis_Chicken(_Chicken);
		
		PROC
		PROC_CrowdSupport_OffStageLinkedImmidiately("EastwayFoodCrisis")
		THEN
		DB_ExecuteInLevel_AfterLongRest("LOW_EastwayFoodCrisis_ChickenSetOffstage","CTY_Main_A");
		
		PROC
		PROC_ExecuteInLevel("LOW_EastwayFoodCrisis_ChickenSetOffstage","CTY_Main_A")
		THEN
		PROC_LOW_EastwayFoodCrisis_RemoveChicken();
		
		PROC
		PROC_CrowdSupport_OffStageLinked("EastwayFoodCrisis")
		THEN
		PROC_LOW_EastwayFoodCrisis_RemoveChicken();
		
		//Brampton Beggars
		PROC
		PROC_LevelLoadedOnce("CTY_Main_A")
		THEN
		SetDoNotFaceFlag((CHARACTER)S_LOW_BramptonBeggars_Civilian1_fe489f75-7e61-469c-879b-dce765985502,1);
		SetDoNotFaceFlag((CHARACTER)S_LOW_BramptonBeggars_Civilian2_8ebaddc2-505f-4dd1-944d-349ca5c802b3,1);
		
		//REGION Disabling stuff when Gortash dies
		IF
		DB_ActiveLevel("CTY_Main_A")
		AND
		DB_GlobalFlag((FLAG)GLO_Gortash_State_WorldKnowsPermaDefeated_5bbc8258-a708-4486-aa3f-8757d9dce533)
		THEN
		PROC_LOW_HideStuffOnGortashDead();
		
		PROC
		PROC_LOW_HideStuffOnGortashDead()
		AND
		DB_GLO_CrowdSupport_DisperseVignette(_Npc, "DoomSayer", _, _)
		THEN
		PROC_SetOnStage(_Npc, 0);
		
		PROC
		PROC_LOW_HideStuffOnGortashDead()
		AND
		DB_GLO_CrowdSupport_DisperseVignette(_Npc, "GeniusGortash", _, _)
		THEN
		PROC_SetOnStage(_Npc, 0);
		
		PROC
		PROC_LOW_HideStuffOnGortashDead()
		THEN
		PROC_SetOnStage(S_LOW_BaldursMouth_Gossiper_001_5a7185d6-1f54-4870-831c-991f9743ea24, 0);
		
		PROC
		PROC_LOW_HideStuffOnGortashDead()
		AND
		DB_GLO_CrowdSupport_DisperseVignette(_Npc, "BloomridgeParanoia", _, _)
		THEN
		PROC_SetOnStage(_Npc, 0);
		
		PROC
		PROC_LOW_HideStuffOnGortashDead()
		AND
		DB_GLO_CrowdSupport_DisperseVignette(_Npc, "CartLoading", _, _)
		THEN
		PROC_SetOnStage(_Npc, 0);
		
		PROC
		PROC_LOW_HideStuffOnGortashDead()
		AND
		DB_GLO_CrowdSupport_DisperseVignette(_Npc, "EastwayDisappointment", _, _)
		THEN
		PROC_SetOnStage(_Npc, 0);
		
		PROC
		PROC_LOW_HideStuffOnGortashDead()
		AND
		DB_GLO_CrowdSupport_DisperseVignette(_Npc, "EastwayFoodCrisis", _, _)
		THEN
		PROC_SetOnStage(_Npc, 0);
		
		PROC
		PROC_LOW_HideStuffOnGortashDead()
		THEN
		PROC_SetOnStage(S_LOW_Elfsong_Exterior_Patron_001_b0acaed9-296a-409c-8064-a8aff1131013, 0);
		
		PROC
		PROC_LOW_HideStuffOnGortashDead()
		THEN
		PROC_SetOnStage(S_LOW_Elfsong_Exterior_Patron_003_a2f68872-56c0-4ad7-ae32-31907d1c3b16, 0);
		//END_REGION
	}
	EXIT
	{
	}
}
