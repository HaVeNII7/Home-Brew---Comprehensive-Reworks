			(GUIDSTRING)LOOT_Alchemy_Crystal_PurpleFluoriteShard_fef1900a-402c-455f-8c63-87bdaedac6d7);
		
		//DB_UND_Mineable_Const_DamageStep(100.0);
		//DB_UND_Mineable_Const_DropChanceDamaged(0);
