		PROC
		PROC_LOW_SWS_Bonecloak_DisperseCivs()
		AND
		DB_LOW_SWS_AtWall_Kids(_Civ)
		AND
		IsOnStage(_Civ,1)
		THEN
		PROC_DisappearOutOfSight(_Civ,"Run",1,"");
		
		//END_REGION Combat
	}
	EXIT
