Goal(489).Title("Act3_Camp");
Goal(489)
{
	INIT
	{
		//REGION Camp Definitions
		// Camp: LT_CMP_BGO_Farm_A
		DB_Camp("FARM",
				(ITEM)S_CAMP_FARM_Fire_8befdbac-f8e1-4c3d-861f-c72228ff160b,
				(TRIGGER)S_CAMP_FARM_Area_000_dd22d38b-7e59-4ede-86a8-f247961ea2ec,
				(TRIGGER) S_CAMP_FARM_Entrance_36bb4525-6a1b-496f-b6d5-e5bca1a23aff);
		DB_Camp_Ambiance("FARM",
