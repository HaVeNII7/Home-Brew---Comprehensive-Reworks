		PROC
		PROC_LOW_SteelWatchFoundry_SetUpAfterIRN()
		AND
		DB_LOW_LabGondians(_Gondian)
		THEN
		PROC_SelfHealing_Disable((CHARACTER)_Gondian);
		ApplyDamage(_Gondian, 12, "Slashing", NULL_00000000-0000-0000-0000-000000000000);
		SetCombatGroupID(_Gondian, "57e22865-626b-4c85-a5e8-9dc77342d4e5");
		CreateSurface(_Gondian, "SurfaceBlood", 2.5,-1.0, _Gondian);
		
		PROC
		PROC_LOW_SteelWatchFoundry_SetUpAfterIRN()
		AND
		DB_LOW_LabBaneites(_Baneite)
		THEN
		PROC_SelfHealing_Disable((CHARACTER)_Baneite);
		ApplyDamage(_Baneite, 15, "Slashing", NULL_00000000-0000-0000-0000-000000000000);
		SetCombatGroupID(_Baneite, "57e22865-626b-4c85-a5e8-9dc77342d4e5");
		CreateSurface(_Baneite, "SurfaceBlood", 1.0,-1.0, _Baneite);
		//END_REGION
		
