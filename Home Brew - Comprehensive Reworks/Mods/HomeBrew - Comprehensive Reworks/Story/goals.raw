	KB
	{
		//REGION Flags to set when Gale joins the party.
		PROC
		PROC_GLO_PartyMembers_AddHook(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, _)
		AND
		NOT DB_Avatars(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		THEN
		SetFlag(ORI_Gale_State_WasRecruited_a56d3a51-2983-5f82-25f4-ad142948b133, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		PROC
		PROC_GLO_PartyMembers_AddHook(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, _Player)
		AND
		NOT DB_Avatars(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		THEN
		SetFlag(ORI_Gale_HasMet_62561a76-d292-fa86-6027-2f1fe91667d6, _Player, 0);
		
		//END_REGION
		
		
		//REGION Move to camp
		
		PROC
		PROC_GLO_PartyMembers_AddHook((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604,(CHARACTER)_Player)
		AND
		QRY_OnlyOnce("RecruitedFirstTime_Gale")
		THEN
		PROC_ORI_Gale_PlayerSetup(_Player);
		
		PROC
		PROC_ORI_Gale_PlayerSetup((CHARACTER)_Recruiter)
		THEN
		PROC_SpotPlayers_StopSpotting((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "ORI_Gale_FindAvatar");
		NOT DB_SpotPlayers((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "ORI_Gale_FindAvatar", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		NOT DB_SpotPlayers_HasTag((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "ORI_Gale_FindAvatar", (TAG)AVATAR_306b9b05-1057-4770-aa17-01af21acd650, 1);
		NOT DB_SpotPlayers_SpotTrigger((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "ORI_Gale_FindAvatar", S_ORI_Gale_RecruitmentTrigger_22824abf-0652-4313-8caa-3cfc54d0089d);
		NOT DB_SpotPlayers_Continuous((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "ORI_Gale_FindAvatar");
		PROC_ORI_SetupCamp(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, 0);
		SetDetached((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, 0);
		SetCanSpotSneakers((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, 1);
		PROC_TriggerUnregisterForPlayers(S_ORI_Gale_RecruitmentTrigger_22824abf-0652-4313-8caa-3cfc54d0089d);
		PROC_SetInvulnerable(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, 0);
		PROC_CharacterEnableAllCrimes((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604);
		SetVisible(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, 1);
		
		PROC
		PROC_ORI_Gale_PlayerSetup((CHARACTER)_Recruiter)
		AND
		_Recruiter != NULL_00000000-0000-0000-0000-000000000000
		THEN
		SetFlag(ORI_Gale_State_HasRecruited_7548c517-72a8-b9c5-c9e9-49d8d9d71172, _Recruiter, 0);
		
		//END_REGION
		
		//REGION Magic Item Region tracking
		IF
		DB_Waypoint_Teleporting(_Player, _Trigger)
		AND
		GetPosition(_Trigger, _X, _Y, _Z)
		AND
		DB_ORI_Gale_TrackRegion(_RegionTrigger, _RegionName)
		AND
		PositionIsInTrigger(_X, _Y, _Z, _RegionTrigger, 1)
		THEN
		DB_ORI_Gale_SuppressTriggerForWP(_RegionTrigger);
		TimerCancel("ORI_Gale_UnsuppressTriggersForWP");
		TimerLaunch("ORI_Gale_UnsuppressTriggersForWP", 5000);
		
		IF
		TimerFinished("ORI_Gale_UnsuppressTriggersForWP")
		AND
		DB_ORI_Gale_SuppressTriggerForWP(_RegionTrigger)
		THEN
		NOT DB_ORI_Gale_SuppressTriggerForWP(_RegionTrigger);
		
		IF
		EnteredTrigger(_Player, _RegionTrigger)
		AND
		DB_Players(_Player)
		AND
		NOT DB_ORI_Gale_SuppressTriggerForWP(_RegionTrigger)
		AND
		DB_ORI_Gale_TrackRegion(_RegionTrigger, _RegionName)
		THEN
		PROC_ORI_Gale_IncreaseRegionsVisited();
		DB_ORI_Gale_RegionsVisited(_RegionName);
		PROC_ORI_Gale_VisitedTrackedRegion(_RegionName);
		PROC_ORI_Gale_RemoveTrackedRegion(_RegionName);
		
		PROC
		PROC_ORI_Gale_IncreaseRegionsVisited()
		AND
		DB_ORI_Gale_RegionTracking_VisitedCount(_PrevCount)
		AND
		IntegerSum(_PrevCount, 1, _NewCount) // Increase counter
		THEN
		NOT DB_ORI_Gale_RegionTracking_VisitedCount(_PrevCount);
		DB_ORI_Gale_RegionTracking_VisitedCount(_NewCount);
		
		
		// Proc to override for custom outcomes
		PROC
		PROC_ORI_Gale_VisitedTrackedRegion((STRING)_RegionName)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_ORI_Gale_RemoveTrackedRegion((STRING)_RegionName)
		AND
		DB_ORI_Gale_TrackRegion(_RegionTrigger, _RegionName)
		THEN
		NOT DB_ORI_Gale_TrackRegion(_RegionTrigger, _RegionName);
		
		IF
		DB_ORI_Gale_RegionTracking_VisitedCount(_NewCount)
		AND
		DB_ORI_Gale_RegionCounter(_NewCount, _Flag)
		THEN
		SetFlag(_Flag, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		//END_REGION
		
		//REGION Consuming magic items
		
		PROC
		PROC_ORI_Gale_ConsumedMagicItem()
		AND
		DB_GlobalFlag(ORI_Gale_State_GotOneMagicItem_6fec5439-a66e-4aff-b62b-69f88648c34d)
		THEN
		SetFlag(ORI_Gale_State_GotTwoMagicItems_c757086e-4696-441d-b19c-fdb65982776f, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		PROC
		PROC_ORI_Gale_ConsumedMagicItem()
		AND
		NOT DB_GlobalFlag(ORI_Gale_State_GotOneMagicItem_6fec5439-a66e-4aff-b62b-69f88648c34d)
		THEN
		SetFlag(ORI_Gale_State_GotOneMagicItem_6fec5439-a66e-4aff-b62b-69f88648c34d, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		//END_REGION
		
		//REGION Debug
		IF
		TextEvent("Gale2Camp")
		THEN
		PROC_ORI_SetupCamp(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, 1);
		
		IF
		EntityEvent((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "DebugTeleportedToCamp")
		AND
		NOT DB_IsOrWasInParty((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		THEN
		PROC_ORI_Gale_PlayerSetup(NULL_00000000-0000-0000-0000-000000000000);
		
		PROC
		PROC_AddDebugCharToParty((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		NOT DB_OnlyOnce("RecruitedFirstTime_Gale")
		THEN
		SetOnStage(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, 1);
		PROC_ORI_Gale_PlayerSetup(NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		EntityEvent((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "DebugTeleportedToCamp")
		THEN
		PROC_ORI_SetupCamp((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, 1);
		//END_REGION
		
		//REGION
		IF
		FlagSet(_ConditionFlag, _, _)
		AND
		DB_ORI_Gale_DelayedNightConditions(_ConditionFlag, _Delay, _ReadyFlag)
		AND
		NOT DB_ORI_Gale_DelayedNightCounter(_, _ReadyFlag)
		THEN
		DB_ORI_Gale_DelayedNightCounter(_Delay, _ReadyFlag);
		
		PROC
		PROC_LongRest()
		AND
		DB_ORI_Gale_DelayedNightCounter(_DelayOld, _ReadyFlag)
		AND
		_DelayOld >= 0
		AND
		IntegerSubtract(_DelayOld, 1, _DelayNew)
		THEN
		NOT DB_ORI_Gale_DelayedNightCounter(_DelayOld, _ReadyFlag);
		DB_ORI_Gale_DelayedNightCounter(_DelayNew, _ReadyFlag);
		//Counter drops off into -1 and stops counting down.
		
		IF
		DB_ORI_Gale_DelayedNightCounter(0, _ReadyFlag)
		THEN
		SetFlag(_ReadyFlag, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		//END_REGION
		
		//REGION Resurrection WRD
		IF
		Resurrected(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		DB_Avatars(_Avatar)
		AND
		QuestUpdateIsUnlocked(_Avatar, "ORI_COM_Gale", "GaleDied", 1)
		THEN
		QuestUpdate(_Avatar, "ORI_COM_Gale", "ResurrectedGale");
		
		IF
		Resurrected(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		DB_Avatars(_Avatar)
		AND
		QuestUpdateIsUnlocked(_Avatar, "ORI_COM_Gale", "GaleDied", 1)
		AND
		QRY_OnlyOnce("ORI_Resurrected_WRD_Gale")
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, (DIALOGRESOURCE)ORI_Resurrected_WRD_Gale_6ed0f4c2-5324-08bd-bf27-22237a90da64, (CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604);
		
		IF
		Resurrected(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		DB_Avatars((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		THEN
		QuestUpdate(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "ORI_Avatar_Gale", "ResurrectedGale");
		
		//END_REGION
		
		
		//REGION Romance night 2
		IF
		FlagSet(CAMP_GoblinHuntCelebration_SD_ROM_NightWithGale_SexAfterAll_496aee4f-b350-8351-a3fa-aa9d4e982dd6, _, _ID)
		AND
		DB_DialogPlayers(_ID, _Avatar, _)
		AND
		DB_Avatars((CHARACTER)_Avatar)
		THEN
		DB_Camp_QueuedSoloDream(_Avatar,CAMP_GoblinHuntCelebration_SD_ROM_NightWithGale_9e267aa8-0f95-1364-c97d-a13a12f30386);
		
		//END_REGION
		
		//REGION Journal
		
		IF
		FlagSet((FLAG)ORI_Gale_Knows_NeedsMagicItems_d3827f86-fc4f-411d-9623-9ae5d35d6735, _, _)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Gale_State_EnoughRegionsToAskMagicItem1_a1faa546-4525-437e-a528-a4ccfd541a93)
		AND
		DB_Players(_Character)
		THEN
		QuestUpdate(_Character, "ORI_COM_Gale", "LearnedGoal2");
		
		IF
		FlagSet((FLAG)ORI_Gale_Knows_NeedsMagicItems_d3827f86-fc4f-411d-9623-9ae5d35d6735, _, _)
		AND
		DB_GlobalFlag((FLAG)ORI_Gale_State_EnoughRegionsToAskMagicItem1_a1faa546-4525-437e-a528-a4ccfd541a93)
		AND
		DB_Players(_Character)
		THEN
		QuestUpdate(_Character, "ORI_COM_Gale", "LearnedGoal");
		
		IF
		DialogEnded((DIALOGRESOURCE)COL_KethericShowdown_ChosenThree_94ef9fa6-729b-d34a-623a-74a8c3ba187f, _ID)
		AND
		DB_GlobalFlag((FLAG)ORI_Gale_Event_BombDisarmed_3d014e79-5595-9365-87bb-5cbb1f87fe5c)
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		DB_GlobalFlag(ORI_Gale_State_SawElderBrain_98b08cb9-7ad2-9bf9-1da1-bb549e88d934)
		AND
		DB_DialogPlayers(_ID, _Player, 1)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		THEN
		QuestUpdate((CHARACTER)_Player, "ORI_COM_Gale", "GaleSawBrain");
		
		IF
		DialogEnded((DIALOGRESOURCE)COL_KethericShowdown_ChosenThree_94ef9fa6-729b-d34a-623a-74a8c3ba187f, _ID)
		AND
		DB_GlobalFlag((FLAG)ORI_Gale_Event_BombDisarmed_3d014e79-5595-9365-87bb-5cbb1f87fe5c)
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		NOT DB_GlobalFlag(ORI_Gale_State_SawElderBrain_98b08cb9-7ad2-9bf9-1da1-bb549e88d934)
		AND
		DB_DialogPlayers(_ID, _Player, 1)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		THEN
		QuestUpdate((CHARACTER)_Player, "ORI_COM_Gale", "GaleMissedBrain");
		
		IF
		DialogEnded((DIALOGRESOURCE)COL_KethericShowdown_ChosenThree_94ef9fa6-729b-d34a-623a-74a8c3ba187f, _ID)
		AND
		DB_GlobalFlag((FLAG)ORI_Gale_Event_BombDisarmed_3d014e79-5595-9365-87bb-5cbb1f87fe5c)
		AND
		DB_GlobalFlag(ORI_Gale_State_SawElderBrain_98b08cb9-7ad2-9bf9-1da1-bb549e88d934)
		AND
		DB_Avatars((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		THEN
		QuestUpdate((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "ORI_Avatar_Gale", "SawBrain");
		
		IF
		DialogEnded((DIALOGRESOURCE)COL_KethericShowdown_ChosenThree_94ef9fa6-729b-d34a-623a-74a8c3ba187f, _ID)
		AND
		DB_GlobalFlag((FLAG)ORI_Gale_Event_BombDisarmed_3d014e79-5595-9365-87bb-5cbb1f87fe5c)
		AND
		NOT DB_GlobalFlag(ORI_Gale_State_SawElderBrain_98b08cb9-7ad2-9bf9-1da1-bb549e88d934)
		AND
		DB_Avatars((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		THEN
		QuestUpdate((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "ORI_Avatar_Gale", "MissedBrain");
		
		IF
		QuestUpdateUnlocked(_, "ORI_COM_Gale", _Update)
		AND
		DB_ORI_Gale_NeedMagicItemJournalUpdates(_Flag, _Update)
		THEN
		NOT DB_ORI_Gale_NeedMagicItemJournalUpdates((FLAG)ORI_Gale_State_EnoughRegionsToAskMagicItem1_a1faa546-4525-437e-a528-a4ccfd541a93, "NeedFirstItem");
		
		IF
		FlagSet((FLAG)ORI_Gale_Knows_NeedsMagicItems_d3827f86-fc4f-411d-9623-9ae5d35d6735, _, _)
		THEN
		DB_ORI_Gale_NeedMagicItemJournalUpdates((FLAG)ORI_Gale_State_EnoughRegionsToAskMagicItem1_a1faa546-4525-437e-a528-a4ccfd541a93, "NeedFirstItem");
		DB_ORI_Gale_NeedMagicItemJournalUpdates((FLAG)ORI_Gale_State_EnoughRegionsToAskMagicItem2_fd8f43cd-a2c1-4211-8978-de2db47fafe8, "NeedSecondItem");
		DB_ORI_Gale_NeedMagicItemJournalUpdates((FLAG)ORI_Gale_State_EnoughRegionsToAskMagicItem3_40cd9192-878b-480f-9a41-9f69c61f2bd9, "NeedThirdItem");
		
		IF
		DB_GlobalFlag(_Flag)
		AND
		DB_ORI_Gale_NeedMagicItemJournalUpdates(_Flag, _Update)
		AND
		DB_Players((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		THEN
		QuestUpdate((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "ORI_COM_Gale", _Update);
		
		IF
		DB_GlobalFlag(_Flag)
		AND
		DB_ORI_Gale_NeedMagicItemJournalUpdates(_Flag, _Update)
		AND
		NOT DB_Players((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		DB_InCamp((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		DB_InCamp((CHARACTER)_Player)
		AND
		DB_Players(_Player)
		THEN
		QuestUpdate(_Player, "ORI_COM_Gale", _Update);
		
		IF
		DB_GlobalFlag(ORI_Gale_State_SentToFindBook_223470bc-af59-c833-500a-ace86e5cc1df)
		AND
		NOT DB_GlobalFlag(LOW_Tolna_Knows_PermaDefeated_629cbe29-01fb-4fb6-81c3-23748fb4c03d)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Gale_Knows_ReadKarsusNotes_2b0e541f-f49e-7e82-27d6-15fccd6ff1ff)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Gale_State_PartyHadKarsusNotes_9e26ca1b-0ae3-472b-a6a3-385846bc8ff5)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Gale_Knows_BrainHasCrownOfKarsus_FromRaphael_4451456b-6f9b-7de2-9fae-68fc5a86f9d9)
		THEN
		PROC_ORI_Gale_JournalUpdate("FindBook");
		
		IF
		DB_GlobalFlag(ORI_Gale_State_SentToFindBook_223470bc-af59-c833-500a-ace86e5cc1df)
		AND
		DB_GlobalFlag(LOW_Tolna_Knows_PermaDefeated_629cbe29-01fb-4fb6-81c3-23748fb4c03d)
		AND
		NOT DB_GlobalFlag(ORI_Gale_Quest_NoTolna_c105de73-0701-4289-95f4-f6c79cb85ba3)
		AND
		NOT DB_InRegion(_, S_LOW_SorcerousSundries_Cellar_SUB_a3ad0aa6-0b85-495d-9378-ad495d90b8e7)
		AND
		NOT DB_GlobalFlag(ORI_Gale_Quest_FindBook2_Accidental_20ddb12d-1ae4-46cd-80ad-363416d60d10)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Gale_Knows_ReadKarsusNotes_2b0e541f-f49e-7e82-27d6-15fccd6ff1ff)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Gale_State_PartyHadKarsusNotes_9e26ca1b-0ae3-472b-a6a3-385846bc8ff5)
		THEN
		PROC_GlobalSetFlagAndCache(ORI_Gale_Quest_NoTolna_c105de73-0701-4289-95f4-f6c79cb85ba3);
		
		IF
		DB_GlobalFlag(ORI_Gale_State_SentToFindBook_223470bc-af59-c833-500a-ace86e5cc1df)
		AND
		DB_GlobalFlag(LOW_Tolna_Knows_PermaDefeated_629cbe29-01fb-4fb6-81c3-23748fb4c03d)
		AND
		NOT DB_GlobalFlag(ORI_Gale_Quest_FindBook2_Accidental_20ddb12d-1ae4-46cd-80ad-363416d60d10)
		AND
		DB_InRegion(_, S_LOW_SorcerousSundries_Cellar_SUB_a3ad0aa6-0b85-495d-9378-ad495d90b8e7)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Gale_Knows_ReadKarsusNotes_2b0e541f-f49e-7e82-27d6-15fccd6ff1ff)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Gale_State_PartyHadKarsusNotes_9e26ca1b-0ae3-472b-a6a3-385846bc8ff5)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Gale_Quest_FindBook2_6202429c-e813-43bb-a431-040cc6214069)
		THEN
		PROC_GlobalSetFlagAndCache(ORI_Gale_Quest_FindBook2_Accidental_20ddb12d-1ae4-46cd-80ad-363416d60d10);
		NOT DB_QuestDef_State((FLAG)ORI_Gale_Quest_FindBook2_6202429c-e813-43bb-a431-040cc6214069, "ORI_COM_Gale", "FindBook2"); //In case the Quest flag is set from dialogue.
		
		IF
		DB_GlobalFlag((FLAG)ORI_Gale_State_PartyHadKarsusNotes_9e26ca1b-0ae3-472b-a6a3-385846bc8ff5)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Gale_Knows_ReadKarsusNotes_2b0e541f-f49e-7e82-27d6-15fccd6ff1ff)
		AND
		DB_GlobalFlag((FLAG)ORI_Gale_State_SentToFindBook_223470bc-af59-c833-500a-ace86e5cc1df)
		THEN
		PROC_GlobalSetFlagAndCache(ORI_Gale_Quest_FoundBook_3f0fc364-1d8b-4327-a234-d6623c698ec9);
		
		IF
		FlagSet((FLAG)ORI_Gale_Event_BombDisarmed_3d014e79-5595-9365-87bb-5cbb1f87fe5c, _, _)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Gale_Knows_LearnedBackstory_0a9731cf-4769-249f-818d-b4c6e542083d)
		THEN
		NOT DB_QuestDef_State((FLAG)ORI_Gale_Knows_LearnedBackstory_0a9731cf-4769-249f-818d-b4c6e542083d, "ORI_COM_Gale", "LearnedBackstory");
		DB_QuestDef_State((FLAG)ORI_Gale_Knows_LearnedBackstory_0a9731cf-4769-249f-818d-b4c6e542083d, "ORI_COM_Gale", "LearnedBackstory_AfterElminster");
		
		
		//END_REGION
		
		//REGION TGs
		
		
		//If a TG is trigger, clear that TG.
		IF
		InstanceDialogChanged(_, Gale_InParty2_Nested_TopicalGreetings_97bd4ff9-bff4-4d88-e82b-47b4c424ce42, _, _)
		AND
		DB_TopicalGreeting(_Flag)
		AND
		NOT DB_ORI_Gale_RepeatTG(_Flag)
		AND
		GetFlag(_Flag, S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, 1)
		THEN
		ClearFlag(_Flag, S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, 0);
		
		
		//END_REGION
		
		//REGION
		IF
		FlagSet((FLAG)Debug_AddGale_06a419b9-8c82-ef98-12af-41dfca6672dd, _Character, _)
		AND
		NOT DB_PartOfTheTeam((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		THEN
		SetOnStage((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604,1);
		TeleportTo((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, _Character,"Debug_CharacterAdd_Teleported",1,0,1,0,1);
		PROC_GLO_PartyMembers_Add((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, (CHARACTER)_Character);
		SetFlag((FLAG)SetPreset_Default_7eabc516-c15c-46ff-a99d-60d4a9f7037e, (CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, 0); // flagType: Object
		
		IF
		FlagSet((FLAG)Debug_AddGale_06a419b9-8c82-ef98-12af-41dfca6672dd, _Character, _)
		THEN
		ClearFlag((FLAG)Debug_AddGale_06a419b9-8c82-ef98-12af-41dfca6672dd, _Character, 0);
		
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(831).Title("GLO_Origin_Gale_Death");
Goal(831)
{
	INIT
	{
		SetOnStage(S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, 0);
		PROC_SetInvulnerable(S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, 1);
		
		
		DB_ORI_Gale_DeathVoiceDialogs((DIALOGRESOURCE)Gale_DeathVoice_39f17d8c-1af1-2074-6c4e-87f48f3a4625);
		DB_ORI_Gale_DeathVoiceDialogs((DIALOGRESOURCE)Gale_DeathVoice_StatusFallback_c32a6907-3add-4f48-5a77-ec1660ec82c2);
		DB_ORI_Gale_DeathVoiceDialogs((DIALOGRESOURCE)ORI_Gale_Deathvoice_Reminder_d4538145-784c-bd63-9d96-67f7fe7379d5);
	}
	KB
	{
		//REGION Death Countdown
		
		PROC
		PROC_LongRest()
		AND
		DB_Dead(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		NOT DB_ORI_Gale_DeadCounter(_)
		AND
		NOT DB_OnlyOnce("ORI_Gale_Explode")
		THEN
		DB_ORI_Gale_DeadCounter(0);
		
		PROC
		PROC_LongRest()
		AND
		DB_Dead(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		DB_ORI_Gale_DeadCounter(_Num)
		AND
		IntegerSum(_Num, 1, _NewNum)
		THEN
		NOT DB_ORI_Gale_DeadCounter(_Num);
		DB_ORI_Gale_DeadCounter(_NewNum);
		
		/*
		IF
		EnteredChasm(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, _, _)
		THEN
		SetFlag(ORI_Gale_State_InChasm_cff2a312-9719-4510-b5c3-a91c4fb7be8c, NULL_00000000-0000-0000-0000-000000000000, 0);
		*/
		
		IF
		Resurrected(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		THEN
		ClearFlag(ORI_Gale_State_InChasm_cff2a312-9719-4510-b5c3-a91c4fb7be8c, NULL_00000000-0000-0000-0000-000000000000, 0);
		NOT DB_OnlyOnce("ORI_Gale_Explode");
		
		IF
		Resurrected(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		DB_ORI_Gale_DeadCounter(_Num)
		THEN
		NOT DB_ORI_Gale_DeadCounter(_Num);
		
		PROC
		PROC_LongRest()
		AND
		NOT DB_OnlyOnce("ORI_Gale_Explode")
		AND
		DB_ORI_Gale_DeadCounter(_I)
		AND
		_I > 2
		AND
		NOT DB_GlobalFlag(ORI_Gale_State_InChasm_cff2a312-9719-4510-b5c3-a91c4fb7be8c)
		THEN
		PROC_ORI_Gale_Explosion();
		
		IF
		EntityEvent(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "ORI_Gale_PostDeathTeleport")
		THEN
		NOT DB_ORI_Gale_Teleporting(1);
		PROC_ORI_Gale_Explosion();
		
		IF
		TextEvent("ORI_Gale_Explosion")
		THEN
		PROC_ORI_Gale_Explosion();
		
		
		//END_REGION
		
		//REGION Death Mouth
		IF
		Dying(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		DB_ORI_Gale_DyingCombat(_ID)
		THEN
		NOT DB_ORI_Gale_DyingCombat(_ID);
		
		IF
		Dying(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		DB_Is_InCombat(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, _ID)
		THEN
		DB_ORI_Gale_DyingCombat(_ID);
		
		IF
		EnteredChasm(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, _, _, _X, _Y, _Z)
		THEN
		DB_ORI_Gale_VoiceLocation(_X, _Y, _Z);
		
		IF
		Died(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		NOT DB_ORI_Gale_VoiceLocation(_, _, _)
		AND
		GetPosition(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, _X, _Y, _Z)
		THEN
		DB_ORI_Gale_VoiceLocation(_X, _Y, _Z);
		
		IF
		Died(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		DB_QRYRTN_ORI_Gale_CombatSpeaker((GUIDSTRING)_Speaker)
		THEN
		NOT DB_QRYRTN_ORI_Gale_CombatSpeaker(_Speaker);
		
		IF
		Died(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		NOT DB_ORI_Gale_DyingCombat(_)
		THEN
		PROC_ORI_Gale_TrySetupDeathvoice();
		
		IF
		CombatEnded(_ID)
		AND
		DB_ORI_Gale_DyingCombat(_ID)
		THEN
		NOT DB_ORI_Gale_DyingCombat(_ID);
		PROC_ORI_Gale_TrySetupDeathvoice();
		
		PROC
		PROC_ORI_Gale_TrySetupDeathvoice()
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		NOT DB_OnlyOnce("Gale_DeathVoice")
		THEN
		PROC_ORI_Gale_SetupDeathvoice();
		
		PROC
		PROC_ORI_Gale_TrySetupDeathvoice()
		AND
		DB_Avatars((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		THEN
		PROC_ORI_Gale_SetupDeathvoice();
		
		PROC
		PROC_ORI_Gale_SetupDeathvoice()
		AND
		DB_ORI_Gale_VoiceLocation(_X, _Y, _Z)
		THEN
		TeleportToPosition(S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, _X, _Y, _Z, "", 0, 0, 0, 0, 1);
		SetOnStage(S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, 1);
		SetDetached(S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, 1);
		SetVisible(S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, 0);
		DB_SpotPlayers(S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, "GLO_Gale_DeathVoice", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		DB_SpotPlayers_CustomRadius(S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, "GLO_Gale_DeathVoice", 8.0);
		DB_CustomDialogRange(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, 12);
		DB_SpotPlayers_BlockTargetFTB(S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, "GLO_Gale_DeathVoice");
		DB_SpotPlayers_IncludeWildshapedPlayers(S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, "GLO_Gale_DeathVoice");
		DB_SpotPlayers_IncludeFollowers(S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, "GLO_Gale_DeathVoice");
		DB_SpotPlayers_IncludeSummons(S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, "GLO_Gale_DeathVoice");
		DB_SpotPlayers_TargetIgnoreCantTalk(S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, "GLO_Gale_DeathVoice");
		DB_SpotPlayers_Continuous(S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, "GLO_Gale_DeathVoice");
		PROC_SpotPlayers_RestartSpotting((CHARACTER)S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, "GLO_Gale_DeathVoice");
		
		//So as not to interrupt dialogue flow, 
		PROC
		PROC_SpotPlayers_Spotted((CHARACTER)S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, "GLO_Gale_DeathVoice", _Character)
		THEN
		PROC_ORI_Gale_TryDeathVoice(_Character);
		
		IF
		DialogEnded(_, _ID)
		AND
		DB_DialogPlayers(_ID, _Actor, _)
		AND
		DB_SpotPlayers_Spotted((CHARACTER)S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, "GLO_Gale_DeathVoice", _Character)
		AND
		InSamePartyGroup(_Character, (CHARACTER)_Actor, 1)
		THEN
		PROC_ORI_Gale_TryDeathVoice((CHARACTER)_Character);
		
		PROC
		PROC_ORI_Gale_TryDeathVoice((CHARACTER)_Character)
		AND
		QRY_ORI_Gale_DeathSpeakerEligible(_Character)
		AND
		QRY_ORI_Gale_FindDeathSpeaker()
		AND
		DB_QRYRTN_ORI_Gale_DeathSpeaker(_Speaker)
		AND
		QRY_ORI_Gale_PickDeathVoiceDialog(_Speaker)
		AND
		DB_QRYRTN_ORI_Gale_PickDeathVoiceDialog(_Dialog)
		THEN
		PROC_ORI_Gale_PlayDeathvoiceDialog(_Speaker, _Dialog);
		
		PROC
		PROC_ORI_Gale_PlayDeathvoiceDialog((CHARACTER)_Speaker, (DIALOGRESOURCE)_Dialog)
		AND
		DB_OnlyOnce("Gale_DeathVoice")
		AND
		QRY_StartDialogCustom(ORI_Gale_Deathvoice_Reminder_d4538145-784c-bd63-9d96-67f7fe7379d5, _Speaker, 0, 0, 1, 0)
		THEN
		PROC_SpotPlayers_StopSpotting((CHARACTER)S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, "GLO_Gale_DeathVoice");
		
		PROC
		PROC_ORI_Gale_PlayDeathvoiceDialog((CHARACTER)_Speaker, (DIALOGRESOURCE)_Dialog)
		AND
		NOT DB_OnlyOnce("Gale_DeathVoice")
		AND
		QRY_StartDialogCustom(_Dialog, S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, _Speaker, 0, 0, 1, 0)
		THEN
		DB_OnlyOnce("Gale_DeathVoice");
		PROC_SpotPlayers_StopSpotting((CHARACTER)S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, "GLO_Gale_DeathVoice");
		
		IF
		DialogStarted(_Dialog, _)
		AND
		DB_ORI_Gale_DeathVoiceDialogs(_Dialog)
		THEN
		DB_OnlyOnce("Gale_DeathVoice");
		PROC_SpotPlayers_StopSpotting((CHARACTER)S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, "GLO_Gale_DeathVoice");
		
		QRY
		QRY_ORI_Gale_PickDeathVoiceDialog((GUIDSTRING)_Speaker)
		AND
		DB_QRYRTN_ORI_Gale_PickDeathVoiceDialog(_Dialog)
		THEN
		NOT DB_QRYRTN_ORI_Gale_PickDeathVoiceDialog(_Dialog);
		
		QRY
		QRY_ORI_Gale_PickDeathVoiceDialog((GUIDSTRING)_Speaker)
		AND
		DB_Players((CHARACTER)_Speaker)
		THEN
		DB_QRYRTN_ORI_Gale_PickDeathVoiceDialog((DIALOGRESOURCE)Gale_DeathVoice_39f17d8c-1af1-2074-6c4e-87f48f3a4625);
		
		QRY
		QRY_ORI_Gale_PickDeathVoiceDialog((GUIDSTRING)_Speaker)
		AND
		NOT DB_Players((CHARACTER)_Speaker)
		THEN
		DB_QRYRTN_ORI_Gale_PickDeathVoiceDialog((DIALOGRESOURCE)Gale_DeathVoice_StatusFallback_c32a6907-3add-4f48-5a77-ec1660ec82c2);
		
		IF
		Resurrected(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		DB_ORI_Gale_DyingCombat(_ID)
		THEN
		NOT DB_ORI_Gale_DyingCombat(_ID);
		
		IF
		Resurrected(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		DB_ORI_Gale_VoiceLocation(_X, _Y, _Z)
		THEN
		NOT DB_ORI_Gale_VoiceLocation(_X, _Y, _Z);
		
		IF
		Resurrected(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		THEN
		SetOnStage(S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, 0);
		NOT DB_CustomDialogRange(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, 12);
		
		IF
		DialogEnded(Gale_DeathVoice_39f17d8c-1af1-2074-6c4e-87f48f3a4625, _)
		THEN
		SetOnStage(S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, 0);
		NOT DB_CustomDialogRange(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, 12);
		
		QRY
		QRY_ORI_Gale_FindDeathSpeaker()
		AND
		DB_QRYRTN_ORI_Gale_DeathSpeaker(_Char)
		THEN
		NOT DB_QRYRTN_ORI_Gale_DeathSpeaker(_Char);
		
		QRY
		QRY_ORI_Gale_FindDeathSpeaker()
		AND
		DB_Avatars(_Char)
		AND
		NOT DB_CantTalk_IgnoreStatuses(_Char)
		AND
		NOT DB_QRYRTN_ORI_Gale_DeathSpeaker(_)
		AND
		QRY_SameUser(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, _Char)
		AND
		QRY_ORI_Gale_DeathSpeakerEligible(_Char)
		THEN
		DB_QRYRTN_ORI_Gale_DeathSpeaker(_Char);
		
		
		QRY
		QRY_ORI_Gale_FindDeathSpeaker()
		AND
		DB_Players(_Char)
		AND
		NOT DB_CantTalk_IgnoreStatuses(_Char)
		AND
		NOT DB_QRYRTN_ORI_Gale_DeathSpeaker(_)
		AND
		QRY_SameUser(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, _Char)
		AND
		QRY_ORI_Gale_DeathSpeakerEligible(_Char)
		THEN
		DB_QRYRTN_ORI_Gale_DeathSpeaker(_Char);
		
		QRY
		QRY_ORI_Gale_FindDeathSpeaker()
		AND
		DB_Avatars(_Char)
		AND
		NOT DB_CantTalk_IgnoreStatuses(_Char)
		AND
		NOT DB_QRYRTN_ORI_Gale_DeathSpeaker(_)
		AND
		QRY_ORI_Gale_DeathSpeakerEligible(_Char)
		THEN
		DB_QRYRTN_ORI_Gale_DeathSpeaker(_Char);
		
		QRY
		QRY_ORI_Gale_FindDeathSpeaker()
		AND
		DB_Players(_Char)
		AND
		NOT DB_CantTalk_IgnoreStatuses(_Char)
		AND
		NOT DB_QRYRTN_ORI_Gale_DeathSpeaker(_)
		AND
		QRY_ORI_Gale_DeathSpeakerEligible(_Char)
		THEN
		DB_QRYRTN_ORI_Gale_DeathSpeaker(_Char);
		
		QRY
		QRY_ORI_Gale_FindDeathSpeaker()
		AND
		DB_PartyMembers(_Char)
		AND
		NOT DB_CantTalk_IgnoreStatuses(_Char)
		AND
		NOT DB_QRYRTN_ORI_Gale_DeathSpeaker(_)
		AND
		QRY_ORI_Gale_DeathSpeakerEligible(_Char)
		THEN
		DB_QRYRTN_ORI_Gale_DeathSpeaker(_Char);
		
		QRY
		QRY_ORI_Gale_FindDeathSpeaker()
		AND
		DB_Avatars(_Char)
		AND
		NOT DB_QRYRTN_ORI_Gale_DeathSpeaker(_)
		AND
		QRY_SameUser(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, _Char)
		AND
		QRY_ORI_Gale_DeathSpeakerEligible(_Char)
		THEN
		DB_QRYRTN_ORI_Gale_DeathSpeaker(_Char);
		
		QRY
		QRY_ORI_Gale_FindDeathSpeaker()
		AND
		DB_Players(_Char)
		AND
		NOT DB_QRYRTN_ORI_Gale_DeathSpeaker(_)
		AND
		QRY_SameUser(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, _Char)
		AND
		QRY_ORI_Gale_DeathSpeakerEligible(_Char)
		THEN
		DB_QRYRTN_ORI_Gale_DeathSpeaker(_Char);
		
		QRY
		QRY_ORI_Gale_FindDeathSpeaker()
		AND
		DB_Avatars(_Char)
		AND
		NOT DB_QRYRTN_ORI_Gale_DeathSpeaker(_)
		AND
		QRY_ORI_Gale_DeathSpeakerEligible(_Char)
		THEN
		DB_QRYRTN_ORI_Gale_DeathSpeaker(_Char);
		
		QRY
		QRY_ORI_Gale_FindDeathSpeaker()
		AND
		DB_Players(_Char)
		AND
		NOT DB_QRYRTN_ORI_Gale_DeathSpeaker(_)
		AND
		QRY_ORI_Gale_DeathSpeakerEligible(_Char)
		THEN
		DB_QRYRTN_ORI_Gale_DeathSpeaker(_Char);
		
		QRY
		QRY_ORI_Gale_FindDeathSpeaker()
		AND
		DB_PartyMembers(_Char)
		AND
		NOT DB_QRYRTN_ORI_Gale_DeathSpeaker(_)
		AND
		QRY_ORI_Gale_DeathSpeakerEligible(_Char)
		THEN
		DB_QRYRTN_ORI_Gale_DeathSpeaker(_Char);
		
		QRY
		QRY_ORI_Gale_DeathSpeakerEligible((CHARACTER)_Char)
		AND
		DB_ORI_Gale_DyingCombat(_ID)
		AND
		DB_Was_InCombat(_Char, _ID)
		AND
		QRY_SpeakerIsAvailable(_Char, 0, 1)
		AND
		NOT QRY_ORI_Gale_DeathSpeakerBlock(_Char)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_ORI_Gale_DeathSpeakerEligible(_Char)
		AND
		NOT QRY_ORI_Gale_DeathSpeakerBlock(_Char)
		AND
		QRY_SpeakerIsAvailable(_Char, 0, 1)
		AND
		QRY_SpeakerIsInDialogRange(_Char, S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_ORI_Gale_DeathSpeakerBlock((CHARACTER)_Char)
		AND
		DB_Players(_Player)
		AND
		InSamePartyGroup(_Char, _Player, 1)
		AND
		IsSpeakerReserved(_Player, 1)
		THEN
		DB_NOOP(1);
		
		//REGION FTB to protect those in the dialogue
		
		IF
		DB_DialogPlayers(_ID, _Speaker, _)
		AND
		DB_DialogName(_Dialog, _ID)
		AND
		DB_ORI_Gale_DeathVoiceDialogs(_Dialog)
		AND
		QRY_ORI_Gale_DeathVoice_CacheFTB((CHARACTER)_Speaker)
		THEN
		PROC_ORI_Gale_DeathVoice_BringInFTBSpeakers(_Speaker);
		ForceTurnBasedMode(_Speaker, 1);
		
		PROC
		PROC_ORI_Gale_DeathVoice_BringInFTBSpeakers((CHARACTER)_Speaker)
		AND
		DB_Players(_NewSpeaker)
		AND
		NOT DB_DialogSpeakers(_, _NewSpeaker, _)
		AND
		_NewSpeaker != S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604
		AND
		QRY_OnlyOnce_Reset("ORI_Gale_DeathVoice_JoinDeathVoice")
		AND
		DB_DialogPlayers(_ID, _Speaker, _)
		AND
		DB_DialogName(_Dialog, _ID)
		AND
		DB_ORI_Gale_DeathVoiceDialogs(_Dialog)
		AND
		GetDistanceTo(_Speaker, _NewSpeaker, _Distance)
		AND
		_Distance <= 10
		AND
		QRY_OnlyOnce("ORI_Gale_DeathVoice_JoinDeathVoice")
		THEN
		PROC_DialogAddListeningActor(_ID, _NewSpeaker);
		
		IF
		EnteredForceTurnBased(_NewSpeaker)
		AND
		NOT DB_DialogSpeakers(_, _NewSpeaker, _)
		AND
		DB_Players((CHARACTER)_NewSpeaker)
		AND
		_NewSpeaker != S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604
		AND
		QRY_OnlyOnce_Reset("ORI_Gale_DeathVoice_JoinDeathVoice")
		AND
		DB_DialogPlayers(_ID, _Speaker, _)
		AND
		DB_DialogName(_Dialog, _ID)
		AND
		DB_ORI_Gale_DeathVoiceDialogs(_Dialog)
		AND
		GetDistanceTo(_Speaker, _NewSpeaker, _Distance)
		AND
		_Distance <= 10
		AND
		QRY_OnlyOnce("ORI_Gale_DeathVoice_JoinDeathVoice")
		THEN
		PROC_DialogAddListeningActor(_ID, _NewSpeaker);
		
		QRY
		QRY_ORI_Gale_DeathVoice_CacheFTB((CHARACTER)_Speaker)
		AND
		IsInForceTurnBasedMode(_Speaker, _InFTB)
		AND
		DB_Negate(_InFTB, _NotInFTB)
		THEN
		DB_ORI_Gale_DeathVoice_CachedFTB(_Speaker, _InFTB);
		NOT DB_ORI_Gale_DeathVoice_CachedFTB(_Speaker, _NotInFTB);
		
		IF
		DialogEnded(_Dialog, _)
		AND
		DB_ORI_Gale_DeathVoiceDialogs(_Dialog)
		AND
		DB_ORI_Gale_DeathVoice_CachedFTB(_Speaker, 0)
		THEN
		ForceTurnBasedMode(_Speaker, 0);
		
		IF
		DialogEnded(_Dialog, _ID)
		AND
		DB_ORI_Gale_DeathVoiceDialogs(_Dialog)
		AND
		DB_ORI_Gale_DeathVoice_CachedFTB(_Speaker, _InFTB)
		THEN
		NOT DB_ORI_Gale_DeathVoice_CachedFTB(_Speaker, _InFTB);
		
		
		//END_REGION
		
		//END_REGION
		
		//REGION Death Effect
		IF
		Died(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		NOT DB_ORI_Gale_InChasm(1)
		THEN
		NOT DB_ORI_Gale_AuraSuppressed(1);
		ApplyStatus(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "ORI_GALE_NECROTICAURA", -1.0, 1, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		EnteredChasm(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, _, _, _, _, _)
		THEN
		DB_ORI_Gale_InChasm(1);
		NOT DB_ORI_Gale_AuraSuppressed(1);
		RemoveStatus(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "ORI_GALE_NECROTICAURA");
		
		IF
		Resurrected(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		THEN
		NOT DB_ORI_Gale_InChasm(1);
		NOT DB_ORI_Gale_AuraSuppressed(1);
		RemoveStatus(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "ORI_GALE_NECROTICAURA");
		
		IF
		StatusAttempt(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "RESURRECTING", _, _)
		THEN
		RemoveStatus(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "ORI_GALE_NECROTICAURA");
		DB_ORI_Gale_AuraSuppressed(1);
		
		IF
		StatusRemoved(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "RESURRECTING", _, _)
		AND
		DB_ORI_Gale_AuraSuppressed(1)
		AND
		NOT DB_ORI_Gale_InChasm(1)
		THEN
		ApplyStatus(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "ORI_GALE_NECROTICAURA", -1.0, 1, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		StatusRemoved(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "RESURRECTING", _, _)
		AND
		DB_ORI_Gale_AuraSuppressed(1)
		THEN
		NOT DB_ORI_Gale_AuraSuppressed(1);
		
		//END_REGION
		
		PROC
		PROC_ORI_Gale_DisableDeathEffect()
		THEN
		GoalCompleted;
	}
	EXIT
	{
		SysClear("DB_ORI_Gale_DyingCombat", 1);
		SysClear("DB_ORI_Gale_InChasm", 1);
		SysClear("DB_QRYRTN_ORI_Gale_DeathSpeaker", 1);
		SysClear("DB_ORI_Gale_DeathVoiceDialogs", 1);
		SysClear("DB_ORI_Gale_DeathVoiceDialogs", 1);
		SetOnStage(S_GLO_Gale_DeathVoice_736c736b-34d8-4dc6-98ac-3f78378ad06d, 0);
		RemoveStatus(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "ORI_GALE_NECROTICAURA");
	}
}
Goal(832).Title("GLO_Origin_Gale_Death_PostEA");
Goal(832)
{
	INIT
	{
		DB_ORI_Gale_SetupCurseProgression(1);
		
		DB_ORI_Gale_WorsenCurse((FLAG)ORI_Gale_State_EnoughRegionsToAskMagicItem1_a1faa546-4525-437e-a528-a4ccfd541a93);
		DB_ORI_Gale_WorsenCurse((FLAG)ORI_Gale_State_EnoughRegionsToAskMagicItem2_fd8f43cd-a2c1-4211-8978-de2db47fafe8);
