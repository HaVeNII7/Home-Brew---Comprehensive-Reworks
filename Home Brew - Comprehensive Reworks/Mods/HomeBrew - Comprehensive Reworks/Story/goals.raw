		DB_HasItemEvent((ITEM)S_UND_MushroomHunter_WeddingRing_5e309a15-0f33-4343-b0f5-e98ff71219fc, (FLAG)UND_MushroomHunter_Event_HasWeddingRing_d91c8ed5-49c2-446d-878c-16ac4da70a27);
