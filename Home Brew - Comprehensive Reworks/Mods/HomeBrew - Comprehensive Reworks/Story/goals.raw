Goal(927).Title("Z_GLO_Act2_DebugSetup");
Goal(927)
{
	INIT
	{
		DB_DBG_Act2_PathFlags((FLAG)DBG_Act2_TieflingPath_eec5a662-da3c-2375-bbd0-0906c3acaeaa);
		DB_DBG_Act2_PathFlags((FLAG)DBG_Act2_AbsolutePath_be04c037-ca2e-7351-f299-c7cc13d44b53);
		DB_DBG_Act2_PathFlags((FLAG)DBG_Act2_KillerPath_1037d931-1e71-b749-b12a-f2c8186ba891);
	}
	KB
	{
		IF
		FlagSet((FLAG)_Flag, (CHARACTER)_Player, _)
		AND
		DB_DBG_Act2_PathFlags(_Flag)
		AND
		DB_Players(_Player)
		AND
		NOT DB_Act2_DebugSetup_Completed(1)
		THEN
		DB_Act2_DebugSetup_MainPlayer(_Player);
		
		IF
		DialogEnded((DIALOGRESOURCE)DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea, _)
		AND
		DB_Act2_DebugSetup_MainPlayer((CHARACTER)_Player)
		AND
		DB_DBG_Act2_PathFlags((FLAG)_PathFlag)
		AND
		GetFlag(_PathFlag, _Player, 1)
		AND
		NOT DB_Act2_DebugSetup_Completed(1)
		THEN
		DB_Act2_DebugSetup_Completed(1);
		PROC_GLO_Act2_DebugSetup_Journal(_PathFlag);
		
		//REGION Tiefling Flow
		PROC
		PROC_GLO_Act2_DebugSetup_Journal((FLAG)DBG_Act2_TieflingPath_eec5a662-da3c-2375-bbd0-0906c3acaeaa)
		THEN
		QuestUpdate("TUT_NautiloidEscape", "EscapedHell");
