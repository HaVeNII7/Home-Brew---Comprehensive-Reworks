		DB_GLO_FireBowls((ITEM)S_MOO_Bowl_01_575f4306-5146-4c32-9528-28033d1deacc,S_MOO_Hinge_01_7225dd44-3bc6-4bb4-a26a-87be9a919990);
		DB_GLO_FireBowls((ITEM)S_MOO_Bowl_02_3e563a39-ddc4-4524-99c5-114a83c0ea08,S_MOO_Hinge_02_8ebdbf85-98a6-436b-9e71-0d1fbe5608f6);
		DB_GLO_FireBowls((ITEM)S_MOO_Bowl_03_bd450326-4ee9-4896-b5a5-ef40e4678a96,S_MOO_Hinge_03_e304aa39-e794-4d14-a573-5e7e46f2bc44);
		DB_GLO_FireBowls((ITEM)S_MOO_Bowl_04_87586af5-6a53-40c9-ad46-e26810495238,S_MOO_Hinge_04_21e9f738-615b-4469-b48d-1dfce2a9d9c1);
		DB_GLO_FireBowls((ITEM)S_MOO_Bowl_05_5de9ca72-819d-4205-a7ba-bbfbe43593a7,S_MOO_Hinge_05_437a4915-41b2-4ed6-ae01-9dbb6b24d2c7);
