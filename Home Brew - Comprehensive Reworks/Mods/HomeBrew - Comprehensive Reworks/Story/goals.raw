		AND
		NOT DB_PermaDefeated((CHARACTER)S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211)
		AND
		QRY_OnlyOnce("NIGHT_NightsongShadowheartVisit_InviteIsobel")
		THEN
		TeleportTo((CHARACTER)S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211, _Entrypoint);
		PROC_Foop((CHARACTER)S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211);
		
		IF
		DB_SelectedDialog((DIALOGRESOURCE)CAMP_NightsongShadowheartVisit_CFM_3327ccbc-a1c6-47ee-05ac-e735523036a5, (CHARACTER)S_GLO_Nightsong_6c55edb0-901b-4ba4-b9e8-3475a8392d9b, _Player)
