		IF
		DB_LOW_LodgeGithKid(S_LOW_GithKid_10403a03-aa9c-4c68-8a52-cbb381627906)
		AND
		QRY_LOW_WasTheGithEggDelivered()
		THEN
		PROC_LOW_SetupLodgeGithKidMassacre();
		
