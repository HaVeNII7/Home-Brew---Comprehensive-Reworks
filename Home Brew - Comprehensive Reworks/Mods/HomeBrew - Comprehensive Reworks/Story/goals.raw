	KB
	{
		//REGION INIT
		
		IF
		DB_END_Courtyard_FleeingCivilians(_Civilian)
		THEN
		TriggerRegisterForCharacter(S_END_FleeDisappearArea_3dd64277-556f-4d59-9e2c-14d3a635f712, _Civilian);
		SetOnStage(_Civilian, 0);
		
		IF
		DB_END_Courtyard_HelpGuards(_Guard, _, _, _)
		THEN
		PROC_CharacterDisableCrime(_Guard, "VandaliseNoOwner");
		PROC_CharacterDisableCrime(_Guard, "Vandalise");
		TriggerRegisterForCharacter(S_END_FleeDisappearArea_3dd64277-556f-4d59-9e2c-14d3a635f712, _Guard);
		//END_REGION
		
		//REGION Patrols
		
		IF
		DB_END_Courtyard_PatrolFollowers(_Lead, _)
		THEN
		SetForceUpdate(_Lead, 1);		//TODO: Remove once proper patrols are setup.
		
		IF
		DB_END_Courtyard_PatrolFollowers(_Lead, _Follower)
		THEN
		SetForceUpdate(_Follower, 1);	//TODO: Remove once proper patrols are setup.
		PROC_Follow(_Follower, _Lead);
		
		//END_REGION
		
		//REGION Fleeing Civilians
		
		PROC
		PROC_OneShotTriggerEntered(_Character, S_END_FleeAppearArea_cf0823ea-c685-4c83-a7f1-ae26f209f1f4)
		AND
		DB_END_Courtyard_FleeingCivilians(_Civilian)
		THEN
		SetOnStage(_Civilian, 1);
		
		PROC
		PROC_OneShotTriggerEntered(_Character, S_END_FleeAppearArea_cf0823ea-c685-4c83-a7f1-ae26f209f1f4)
		THEN
		PROC_CameraShakeAroundObject(_Character, 6000, 30.0);
		
		
		IF
		WentOnStage((CHARACTER)_Civilian, 1)
		AND
		DB_END_Courtyard_FleeingCivilians(_Civilian)
		AND
		Random(10000, _Time)
		AND
		TriggerGetRandomPosition(S_END_FleeDisappearArea_3dd64277-556f-4d59-9e2c-14d3a635f712, _X, _Y, _Z)
		THEN
		PROC_CharacterMoveToPosition(_Civilian, _X, _Y, _Z, "Run", "");
		ObjectTimerLaunch(_Civilian, "END_Courtyard_FleeAD", _Time);
		
		IF
		EnteredTrigger(_Civilian, S_END_FleeDisappearArea_3dd64277-556f-4d59-9e2c-14d3a635f712)
		AND
		DB_END_Courtyard_FleeingCivilians(_Civilian)
		THEN
		NOT DB_END_Courtyard_FleeingCivilians(_Civilian);
		TriggerUnregisterForCharacter(S_END_FleeDisappearArea_3dd64277-556f-4d59-9e2c-14d3a635f712, _Civilian);
		PROC_CharacterMoveTo(_Civilian, S_END_EntranceFleePos_cc2b598e-80f9-4c24-a0f6-b1c20f00bdc3, "Run", "END_Courtyard_AtFleePos");
		
		IF
		EntityEvent(_Character, "END_Courtyard_AtFleePos")
		THEN
		PROC_DisappearOutOfSightTo((CHARACTER)_Character, S_END_EntranceDisappearPos_001ee589-50d5-4411-87aa-263b97515e7d, "Run", 1, "");
		//END_REGION
		
		//REGION Intro Scene
		
		IF
		EnteredTrigger(_Character, S_END_CourtyardIntroArea_227c4354-b2f8-4379-9706-deacec31c97c)
		THEN
		PROC_END_LastStand_StartScene(_Character);
		
		PROC
		PROC_END_LastStand_StartScene((CHARACTER)_Player)
		AND
		DB_Players(_Player)
		AND
		QRY_StartDialog(END_LastStand_42371c11-dc70-2ea5-3a92-cd93d939c32d, S_END_LastStandGuard_001_27ac67d4-2c33-4b87-8cc2-92c2719e52ac, S_END_LastStandGuard_002_73c547aa-fd47-4c4d-b907-316ad0af4d21, S_END_LastStandGuard_003_0e5ae266-ba26-48ac-9c2a-c9a461f1352d, S_END_LastStandGuard_004_99d89d39-9ef8-466b-8eb7-1776fed67b4a, _Player)
		THEN
		PROC_TriggerUnregisterForParty(S_END_CourtyardIntroArea_227c4354-b2f8-4379-9706-deacec31c97c);
		DB_END_LastStand_Started(1);
		
		//Summon or follower; get the owner and play the dialog.
		PROC
		PROC_END_LastStand_StartScene((CHARACTER)_Character)
		AND
		NOT DB_Players(_Character)
		AND
		CharacterGetOwner(_Character, _Player)
		AND
		QRY_StartDialog(END_LastStand_42371c11-dc70-2ea5-3a92-cd93d939c32d, S_END_LastStandGuard_001_27ac67d4-2c33-4b87-8cc2-92c2719e52ac, S_END_LastStandGuard_002_73c547aa-fd47-4c4d-b907-316ad0af4d21, S_END_LastStandGuard_003_0e5ae266-ba26-48ac-9c2a-c9a461f1352d, S_END_LastStandGuard_004_99d89d39-9ef8-466b-8eb7-1776fed67b4a, _Player)
		THEN
		PROC_TriggerUnregisterForParty(S_END_CourtyardIntroArea_227c4354-b2f8-4379-9706-deacec31c97c);
		DB_END_LastStand_Started(1);
		
		//Try any player in trigger.
		PROC
		PROC_END_LastStand_StartScene((CHARACTER)_Character)
		AND
		DB_Players(_Player)
		AND
		NOT DB_END_LastStand_Started(1)
		AND
		IsInTrigger(_Character, S_END_CourtyardIntroDialogArea_80dea3a8-c737-4681-8618-b9dc5b1c1620, 1)
		AND
		QRY_StartDialog(END_LastStand_42371c11-dc70-2ea5-3a92-cd93d939c32d, S_END_LastStandGuard_001_27ac67d4-2c33-4b87-8cc2-92c2719e52ac, S_END_LastStandGuard_002_73c547aa-fd47-4c4d-b907-316ad0af4d21, S_END_LastStandGuard_003_0e5ae266-ba26-48ac-9c2a-c9a461f1352d, S_END_LastStandGuard_004_99d89d39-9ef8-466b-8eb7-1776fed67b4a, _Player)
		THEN
		PROC_TriggerUnregisterForParty(S_END_CourtyardIntroArea_227c4354-b2f8-4379-9706-deacec31c97c);
		DB_END_LastStand_Started(1);
		
		PROC
		PROC_END_LastStand_StartScene((CHARACTER)_Character)
		AND
		NOT DB_END_LastStand_Started(1)
		THEN
		PROC_TriggerUnregisterForParty(S_END_CourtyardIntroArea_227c4354-b2f8-4379-9706-deacec31c97c);
		DB_END_LastStand_Started(1);
		SetFlag(END_LastStand_Event_GuardsDie_727bd43c-f4ce-bcf8-eaed-403882ba0c5d, NULL_00000000-0000-0000-0000-000000000000, 0);
		PROC_END_Courtyard_ProcessLastStandOutcome();
		
		//Block auto-add to add the minflayer manually and everyone else as listeners.
		QRY
		QRY_ShouldNotAddCharacterInTriggerToDialog(_Character, END_LastStand_42371c11-dc70-2ea5-3a92-cd93d939c32d, S_END_CourtyardIntroDialogArea_80dea3a8-c737-4681-8618-b9dc5b1c1620)
		AND
		NOT DB_DialogName(END_LastStand_42371c11-dc70-2ea5-3a92-cd93d939c32d, _)
		THEN
		DB_NOOP(1);
		
		//Add Emperor into mindflayer spot if not full-ceremorph.
		PROC
		PROC_StartDialog_AddExtraSpeakers(END_LastStand_42371c11-dc70-2ea5-3a92-cd93d939c32d, _ID)
		AND
		DB_PartyMembers(S_GLO_Emperor_73d49dc5-8b8b-45dc-a98c-927bb4e3169b)
		AND
		IsInTrigger(S_GLO_Emperor_73d49dc5-8b8b-45dc-a98c-927bb4e3169b, S_END_CourtyardIntroDialogArea_80dea3a8-c737-4681-8618-b9dc5b1c1620, 1)
		AND
		IsTagged(S_GLO_Emperor_73d49dc5-8b8b-45dc-a98c-927bb4e3169b, FULL_CEREMORPH_3797bfc4-8004-4a19-9578-61ce0714cc0b, 0)
		THEN
		PROC_DialogAddSpeakingActor(_ID, S_GLO_Emperor_73d49dc5-8b8b-45dc-a98c-927bb4e3169b);
		
		//Add full-ceremorph into mindflayer spot.
		PROC
		PROC_StartDialog_AddExtraSpeakers(END_LastStand_42371c11-dc70-2ea5-3a92-cd93d939c32d, _ID)
		AND
		DB_PartyMembers(_Character)
		AND
		IsInTrigger(_Character, S_END_CourtyardIntroDialogArea_80dea3a8-c737-4681-8618-b9dc5b1c1620, 1)
		AND
		IsTagged(_Character, FULL_CEREMORPH_3797bfc4-8004-4a19-9578-61ce0714cc0b, 1)
		THEN
		PROC_DialogAddSpeakingActor(_ID, _Character);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers(END_LastStand_42371c11-dc70-2ea5-3a92-cd93d939c32d, _ID)
		THEN
		PROC_DialogAddSpeakingActor(_ID, S_END_LastStandGuard_005_09eec5b4-d504-4c46-8410-ec180722456b);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers(END_LastStand_42371c11-dc70-2ea5-3a92-cd93d939c32d, _ID)
		THEN
		PROC_DialogAddSpeakingActor(_ID, S_END_LastStandGuard_006_e9abe20a-60df-4807-8582-ecc2f9b80525);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers(END_LastStand_42371c11-dc70-2ea5-3a92-cd93d939c32d, _ID)
		THEN
		PROC_DialogAddSpeakingActor(_ID, S_END_MindflayerGuard_002_d4745b04-7fc4-4356-be8e-f333c2560160);
		
		//Other party members listen.
		PROC
		PROC_StartDialog_AddExtraSpeakers(END_LastStand_42371c11-dc70-2ea5-3a92-cd93d939c32d, _ID)
		AND
		DB_PartyMembers(_Character)
		AND
		IsInTrigger(_Character, S_END_CourtyardIntroDialogArea_80dea3a8-c737-4681-8618-b9dc5b1c1620, 1)
		AND
		IsTagged(_Character, FULL_CEREMORPH_3797bfc4-8004-4a19-9578-61ce0714cc0b, 0)
		THEN
		PROC_DialogAddListeningActor(_ID, _Character);
		
		IF
		DialogStarted(END_LastStand_42371c11-dc70-2ea5-3a92-cd93d939c32d, _)
		AND
		DB_END_Courtyard_HelpGuards(_Guard, _Position, _, _)
		THEN
		PROC_CharacterMoveTo(_Guard, _Position, "Run", "");
		
		IF
		FlagSet(END_LastStand_Event_GuardsDie_727bd43c-f4ce-bcf8-eaed-403882ba0c5d, _, _)
		THEN
		NOT DB_END_Courtyard_HelpGuards(S_END_LastStandGuard_005_09eec5b4-d504-4c46-8410-ec180722456b, S_END_HelpGuardPos_005_053b6a52-e619-45ac-8bd3-b840d4b11953, NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		NOT DB_END_Courtyard_HelpGuards(S_END_LastStandGuard_006_e9abe20a-60df-4807-8582-ecc2f9b80525, S_END_HelpGuardPos_006_8d6087b2-ad86-406e-874e-ee22baf78589, NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		Die(S_END_LastStandGuard_005_09eec5b4-d504-4c46-8410-ec180722456b, DEATHTYPE.DoT, 1);
		Die(S_END_LastStandGuard_006_e9abe20a-60df-4807-8582-ecc2f9b80525, DEATHTYPE.DoT, 1);
		SetOnStage(S_END_LastStandGuard_005_09eec5b4-d504-4c46-8410-ec180722456b, 0);
		SetOnStage(S_END_LastStandGuard_006_e9abe20a-60df-4807-8582-ecc2f9b80525, 0);
		
		IF
		DialogEnded(END_LastStand_42371c11-dc70-2ea5-3a92-cd93d939c32d, _)
		THEN
		PROC_END_Courtyard_ProcessLastStandOutcome();
		
		PROC
		PROC_END_Courtyard_ProcessLastStandOutcome()
		AND
		NOT DB_GlobalFlag(END_LastStand_Event_GuardsFollow_fa88d01a-93e3-88e5-c308-229436e366d2)
		AND
		DB_END_Courtyard_HelpGuards(_Guard, _, _, _)
		AND
		TriggerGetRandomPosition(S_END_FleeDisappearArea_3dd64277-556f-4d59-9e2c-14d3a635f712, _X, _Y, _Z)
		THEN
		PROC_CharacterMoveToPosition(_Guard, _X, _Y, _Z, "Run", "");
		
		IF
		EnteredTrigger(_Guard, S_END_FleeDisappearArea_3dd64277-556f-4d59-9e2c-14d3a635f712)
		AND
		DB_END_Courtyard_HelpGuards(_Guard, _Pos, _ChargePos, _CombatPos)
		THEN
		NOT DB_END_Courtyard_HelpGuards(_Guard, _Pos, _ChargePos, _CombatPos);
		TriggerUnregisterForCharacter(S_END_FleeDisappearArea_3dd64277-556f-4d59-9e2c-14d3a635f712, _Guard);
		PROC_CharacterMoveTo(_Guard, S_END_EntranceFleePos_cc2b598e-80f9-4c24-a0f6-b1c20f00bdc3, "Run", "END_Courtyard_AtFleePos");
		//END_REGION
		
		//REGION Helper Guards
		
		PROC
		PROC_END_Courtyard_GuardsRushIn()
		THEN
		PROC_SetRelationToPlayers(ACT3_END_HighHallCivilians_a5a635e0-bb1b-4d19-9974-3eb77de64202, 100);
		PROC_SetRelationMutual(ACT3_END_HighHallAbsolutists_aeffb3e9-0b6c-43ab-9bc9-0928c24c30a2, ACT3_END_HighHallCivilians_a5a635e0-bb1b-4d19-9974-3eb77de64202, 0);
		ClearFlag(END_LastStand_Event_GuardsFollow_fa88d01a-93e3-88e5-c308-229436e366d2, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		PROC
		PROC_END_Courtyard_GuardsRushIn()
		AND
		DB_END_Courtyard_HelpGuards(_Guard, _, _CombatPos, _)
		THEN
		TriggerRegisterForCharacter(S_END_CanEnterCombatArea_7b6c3a83-1f89-4439-86bd-68a4f2854e2d, _Guard);
		SetCanJoinCombat(_Guard, 0);
		SetCanFight(_Guard, 0);
		PROC_CharacterMoveTo(_Guard, _CombatPos, "Run", "");
		
		IF
		EnteredTrigger(_Guard, S_END_CanEnterCombatArea_7b6c3a83-1f89-4439-86bd-68a4f2854e2d)
		AND
		DB_END_Courtyard_HelpGuards(_Guard, _, _, _)
		THEN
		SetCanJoinCombat(_Guard, 1);
		SetCanFight(_Guard, 1);
		
		IF
		LeftCombat((CHARACTER)_Guard, _)
		AND
		DB_END_Courtyard_HelpGuards(_Guard, _, _, _FinalPos)
		THEN
		PROC_CharacterMoveTo(_Guard, _FinalPos, "Run", "END_Courtyard_GuardAssault");
		
		IF
		DB_GlobalFlag(END_LastStand_Event_GuardsFollow_fa88d01a-93e3-88e5-c308-229436e366d2)
		AND
		DB_Players(_Player)
		AND
		DB_Is_InCombat(_Player, _ID)
		AND
		DB_Is_InCombat(_Enemy, _ID)
		AND
		NOT DB_OnlyOnce("END_Courtyard_GuardsFollow")
		AND
		IsEnemy(_Player, (CHARACTER)_Enemy, 1)
		AND
		IsInTrigger(_Enemy, S_END_EntranceCombatArea_31b595a6-4734-426c-aa7e-8005be23cfe2, 1)
		THEN
		DB_OnlyOnce("END_Courtyard_GuardsFollow");
		PROC_END_Courtyard_GuardsRushIn();
		
		//END_REGION
		
		//REGION Sewer Grates
		
		
		IF
		DestroyedBy(_Grate, _, _, _)
		AND
		DB_END_Courtyard_SewerGrates(_Grate, _OtherGrate)
		THEN
		SysClear("DB_END_Courtyard_SewerGrates", 2);
		Die(_OtherGrate, DEATHTYPE.DoT, 0);
		PROC_END_Courtyard_OpenSewerGrates();
		
		PROC
		PROC_END_Courtyard_OpenSewerGrates()
		THEN
		SetCanInteract(S_END_SewerGrateEntrance_dc1ee6b6-ecde-458f-a411-b8881426f7e7, 1);
		SetCanInteract(S_END_SewerGrateInside_29bf04f3-2f52-41d8-91fa-8aac0ad82b03, 1);
		
		//END_REGION
		
		//REGION Teleporters
		
		PROC
		PROC_BlockUseOfItem(_Player, _TinyTeleporter)
		AND
		DB_Players(_Player)
		AND
		DB_END_Courtyard_TinyTeleporters(_TinyTeleporter, _Destination)
		THEN
		DB_CustomUseItemResponse(_Player, _TinyTeleporter, 0);
		PROC_END_Courtyard_ProcessTinyTeleporter(_Player, _Destination);
		
		PROC
		PROC_END_Courtyard_ProcessTinyTeleporter((CHARACTER)_Player, (TRIGGER)_Destination)
		AND
		QRY_CheckCanSqueeze(_Player)
		THEN
		DetachFromPartyGroup(_Player);
		TeleportTo(_Player, _Destination, "", 0, 0, 0, 0, 1);
		
		PROC
		PROC_END_Courtyard_ProcessTinyTeleporter((CHARACTER)_Player, (TRIGGER)_Destination)
		AND
		NOT QRY_CheckCanSqueeze(_Player)
		AND
		NOT DB_END_Courtyard_TooBigAD(_Player)
		AND
		QRY_StartDialog_Fixed(DEN_Thieflings_AD_CannotFitCrack_037efa81-c02d-7bb1-7ad0-39c424b0373c, _Player)	//PLACEHOLDER: Discuss whether to make generic AD or custom AD.
		THEN
		DB_END_Courtyard_TooBigAD(_Player);
		ObjectTimerLaunch(_Player, "END_TooBigADTimer", 5000);
		
		IF
		ObjectTimerFinished((CHARACTER)_Player, "END_TooBigADTimer")
		THEN
		NOT DB_END_Courtyard_TooBigAD(_Player);
		
		IF
		UseFinished(_, S_END_SecretPassageButton_b2dc5d6d-9e65-4ef9-938c-c090b065e7f4, 1)
		THEN
		SetCanInteract(S_END_SecretPassageButton_b2dc5d6d-9e65-4ef9-938c-c090b065e7f4, 0);
		Open(S_END_SecretPassageWall_f8e98ae2-e07b-49ab-92e3-2a5d7d166f4c);
		
		//END_REGION
		
		//REGION Entrance  Gate
		IF
		UseFinished(_, S_END_GateLever_19fd3dc8-f4ad-4767-93ea-ca8996cbb929, 1)
		AND
		IsOpened(S_END_CourtyardGate_9bae7b0f-9d57-4f7d-b105-4818b0fc552e, _Opened)
		THEN
		SetCanInteract(S_END_GateLever_19fd3dc8-f4ad-4767-93ea-ca8996cbb929, 0);
		PROC_END_Courtyard_GateOpenOrClose(_Opened);
		ObjectTimerLaunch(S_END_GateLever_19fd3dc8-f4ad-4767-93ea-ca8996cbb929, "END_Courtyard_GateLeverTimer", 5000);
		
		PROC
		PROC_END_Courtyard_GateOpenOrClose(0)
		THEN
		Unlock(S_END_CourtyardGate_9bae7b0f-9d57-4f7d-b105-4818b0fc552e);
		Open(S_END_CourtyardGate_9bae7b0f-9d57-4f7d-b105-4818b0fc552e);
		
		PROC
		PROC_END_Courtyard_GateOpenOrClose(1)
		THEN
		Close(S_END_CourtyardGate_9bae7b0f-9d57-4f7d-b105-4818b0fc552e);
		Lock(S_END_CourtyardGate_9bae7b0f-9d57-4f7d-b105-4818b0fc552e, "END_COURTYARD");
		
		IF
		ObjectTimerFinished(S_END_GateLever_19fd3dc8-f4ad-4767-93ea-ca8996cbb929, "END_Courtyard_GateLeverTimer")
		THEN
		SetCanInteract(S_END_GateLever_19fd3dc8-f4ad-4767-93ea-ca8996cbb929, 1);
		
		//END_REGION
		
		//REGION Dragons flying by
		
		IF
		DB_END_Courtyard_Dragons(_Dragon, _Destination, _StartTrigger, _Speed)
		THEN
		//SetOnStage(_Dragon, 0);
		PROC_TriggerRegisterForPlayers(_StartTrigger);
		
		IF
		EnteredTrigger(_Player, _StartTrigger)
		AND
		DB_END_Courtyard_Dragons(_Dragon, _, _StartTrigger, _)
		THEN
		PROC_CameraShakeAroundObject(_Player, 6000, 30.0);
		PROC_TriggerUnregisterForPlayers(_StartTrigger);
		PROC_END_Courtyard_DragonFlyBy(_Player, _Dragon);
		
		PROC
		PROC_END_Courtyard_DragonFlyBy(_, _)
		AND
		DB_Players(_AnyPlayer)
		AND
		IsInInventoryOf((ITEM)S_GLO_GithRadar_4aca442e-5ecb-4611-b481-5eaf35596dea, _AnyPlayer, 1)
		AND
		QRY_OnlyOnce("END_Courtyard_RadarActivated")
		THEN
		PlaySound(_AnyPlayer, "SE_Pendulum_Psionic_Detector"); 
		
		PROC
		PROC_END_Courtyard_DragonFlyBy((CHARACTER)_Player, (ITEM)_Dragon)
		AND
		QRY_OnlyOnce("END_Courtyard_DragonWarningAD")
		THEN
		PROC_TryStartAD(END_Courtyard_AD_DragonWarning_b265eaf2-ce2b-834a-a006-9a2d602cf00b, _Player);
		
		PROC
		PROC_END_Courtyard_DragonFlyBy((CHARACTER)_Player, (ITEM)_Dragon)
		AND
		DB_END_Courtyard_Dragons(_Dragon, _Destination, _StartTrigger, _Speed)
		THEN
		SetForceUpdate(_Dragon, 1);
		SetOnStage(_Dragon, 1);
		ItemMoveTo(_Dragon, _Destination, _Speed, 0.0, 0, "END_DragonFlyBy_Passed", 0);
		ObjectTimerLaunch(_Dragon, "END_DragonFlyBy_Sound", 600);
		
		IF
		ObjectTimerFinished(_Dragon, "END_DragonFlyBy_Sound")
		THEN
		PlaySound(_Dragon, "Dragon_Rig_DFLT_CUST_Fly_Over_01_Roar");
		
		IF
		EntityEvent((ITEM)_Dragon, "END_DragonFlyBy_Passed")
		AND
		DB_END_Courtyard_Dragons(_Dragon, _Destination, _StartTrigger, _Speed)
		THEN
		SetForceUpdate(_Dragon, 0);
		SetOnStage(_Dragon, 0);
		NOT DB_END_Courtyard_Dragons(_Dragon, _Destination, _StartTrigger, _Speed);
		
		//END_REGION
		
		//REGION Rooftops encounter
		
		IF
		DB_Combat_CallingForHelp_SpawnObjects(_Ally, _, "END_ROOFTOPGHOULS", _)
		THEN
		SetOnStage(_Ally, 0);
		
		//END_REGION
		
		//REGION ADs
		
		IF
		TurnStarted((CHARACTER)_Character)
		AND
		DB_END_Courtyard_BattleADs(_AD, _Character)
		THEN
		PROC_TryStartAD(_AD, _Character);
		
		IF
		AutomatedDialogStarted(_AD, _)
		AND
		DB_END_Courtyard_BattleADs(_AD, _Character)
		THEN
		NOT DB_END_Courtyard_BattleADs(_AD, _Character);
		
		IF
		TurnStarted((CHARACTER)_Player)
		AND
		DB_Players(_Player)
		AND
		DB_Is_InCombat(_Player, _ID)
		AND
		DB_Is_InCombat(_HelpCaller, _ID)
		AND
		QRY_SpeakerIsAvailable(_Player)
		AND
		NOT DB_END_Courtyard_StopCallHelpAD(1)
		AND
		HasActiveStatus(_HelpCaller, "CALLING_FOR_HELP_ENDGAMEROOFTOPS", 1)
		THEN
		DB_END_Courtyard_StopCallHelpAD(1);
		PROC_TryStartAD((DIALOGRESOURCE)END_Courtyard_AD_StopAlarm_f3aa6557-c253-a633-0453-b1086a74ca7e, _Player);
		
		PROC
		PROC_GLO_DefeatCounter_AllDefeated(_DefeatCounter)
		AND
		DB_END_Courtyard_DefeatCounter(_DefeatCounter, _Index)
		AND
		DB_END_Reinforcements_Characters(_Index, _Character)
		AND
		DB_Players(_Player)
		AND
		DB_Was_InCombat(_Player, _CombatID)
		AND
		NOT DB_Is_InCombat(_Player, _)
		AND
		DB_Was_InCombat(_Character, _CombatID)
		THEN
		NOT DB_END_Courtyard_DefeatCounter(_DefeatCounter, _Index);
		PROC_END_Courtyard_ReactToAllDefeated(_Player);
		
		PROC
		PROC_END_Courtyard_ReactToAllDefeated((CHARACTER)_Player)
		AND
		QRY_END_Courtyard_EnemiesLeft()
		AND
		NOT DB_END_Courtyard_CarefulVB(1)
		THEN
		DB_END_Courtyard_CarefulVB(1);
		StartVoiceBark((VOICEBARKRESOURCE)END_Courtyard_VB_CombatOverNoAlarm_39469cbd-dae5-fcad-3541-8091dbc72dca, _Player);
		
		PROC
		PROC_END_Courtyard_ReactToAllDefeated((CHARACTER)_Player)
		AND
		NOT QRY_END_Courtyard_EnemiesLeft()
		AND
		NOT DB_END_Courtyard_AllClearVB(1)
		THEN
		DB_END_Courtyard_AllClearVB(1);
		StartVoiceBark((VOICEBARKRESOURCE)END_Courtyard_VB_BigCombatOver_8ed2546a-b178-af5b-f4a2-448344987887, _Player);
		
		QRY
		QRY_END_Courtyard_EnemiesLeft()
		AND
		DB_END_Reinforcements_Characters(_Index, _Character)
		AND
		NOT DB_Defeated(_Character)
		THEN
		DB_NOOP(1);
		
		//END_REGION
		
		//REGION Courtyard tracking
		
		IF
		DB_InRegion(_Character, S_END_GatekeeperTrapArea_55367a3b-05c1-485d-adf7-b00d1d3c83f8)
		AND
		NOT DB_GlobalFlag(END_Courtyard_State_PlayerInCourtyard_f7e06241-25d8-433a-90b9-0695e63768a8)
		THEN
		SetFlag(END_Courtyard_State_PlayerInCourtyard_f7e06241-25d8-433a-90b9-0695e63768a8, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		DB_GlobalFlag(END_Courtyard_State_PlayerInCourtyard_f7e06241-25d8-433a-90b9-0695e63768a8)
		AND
		NOT DB_InRegion(_, S_END_GatekeeperTrapArea_55367a3b-05c1-485d-adf7-b00d1d3c83f8)
		THEN
		ClearFlag(END_Courtyard_State_PlayerInCourtyard_f7e06241-25d8-433a-90b9-0695e63768a8, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(669).Title("Act3c_END_Gale");
Goal(669)
{
	INIT
	{
		PROC_ORI_Gale_SetupEndGameJournal();
	}
	KB
	{
		//REGION Gale Explosion Spell Add
		IF
		EnteredTrigger((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, S_END_BrainBattleArea_b0cbe773-d02f-4074-8507-eab6033c3b27)
		AND
		HasSpell((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "Shout_END_Gale_ActivateNethereseOrb", 0)
		AND
		HasSpell((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "Target_END_Gale_ActivateNethereseOrb", 0)
		THEN
		AddSpell(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, "Target_END_Gale_ActivateNethereseOrb", 1, 0);
		
		PROC
		PROC_END_BrainBattle_UsedMindTeleporter((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		DB_ORI_Gale_SuicideSpell(_Spell)
		THEN
		RemoveSpell((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, _Spell, 1);
		//END_REGION
		
		//REGION Gale Exploding Mid Brain Battle
		IF
		CastedSpell(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, _Spell, _, _, _)
		AND
		DB_ORI_Gale_SuicideSpell(_Spell)
		AND
		DB_InRegion((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, (TRIGGER)S_END_BrainBattleArea_b0cbe773-d02f-4074-8507-eab6033c3b27)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)END_BrainBattle_Event_GaleExplodedMidBattle_993173dd-a519-c8aa-67d7-b4fecfd2b5dc);
		
		QRY
		QRY_Gale_PreventGameOver()
		AND
		DB_InRegion((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, (TRIGGER)S_END_BrainBattleArea_b0cbe773-d02f-4074-8507-eab6033c3b27)
		THEN
		PROC_END_BrainBattle_QueueFullRestore((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604);
		DB_END_BrainBattle_GaleRestoreReady(1);
		
		IF
		DB_END_BrainBattle_GaleRestoreReady(1)
		AND
		NOT DB_END_BrainBattle_QueuedRestoreCharacters(_)
		THEN
		PROC_END_Gale_OrbDetonation();
		
		PROC
		PROC_END_Gale_OrbDetonation()
		AND
		NOT DB_Is_InCombat(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, _)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		QRY_StartDialog_Fixed(END_BrainBattle_GaleExplosion_3b9653f5-17c7-6716-2919-3ad3a9c137fc, (CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, (CHARACTER)S_GLO_Netherbrain_3858e896-d7dd-4699-b37d-d3919ff15ba7)
		THEN
		DB_END_Gale_OrbDialogueStarted(1);
		TeleportTo((CHARACTER)S_GLO_Elminster_75bb6396-1132-4064-bafe-205a3f156b9b, (TRIGGER)S_Debug_Teleport_END_FinaleEntrance_2915874b-b742-42b7-991f-86a07aeff6ee);
		SetOnStage((CHARACTER)S_GLO_Elminster_75bb6396-1132-4064-bafe-205a3f156b9b, 1);
		
		PROC
		PROC_END_Gale_OrbDetonation()
		AND
		NOT DB_Is_InCombat(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, _)
		AND
		DB_Avatars((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		QRY_StartDialog_Fixed(END_BrainBattle_GaleExplosion_3b9653f5-17c7-6716-2919-3ad3a9c137fc, NULL_00000000-0000-0000-0000-000000000000, (CHARACTER)S_GLO_Netherbrain_3858e896-d7dd-4699-b37d-d3919ff15ba7, S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		THEN
		DB_END_Gale_OrbDialogueStarted(1);
		TeleportTo((CHARACTER)S_GLO_Elminster_75bb6396-1132-4064-bafe-205a3f156b9b, (TRIGGER)S_Debug_Teleport_END_FinaleEntrance_2915874b-b742-42b7-991f-86a07aeff6ee);
		SetOnStage((CHARACTER)S_GLO_Elminster_75bb6396-1132-4064-bafe-205a3f156b9b, 1);
		
		PROC
		PROC_END_Gale_OrbDetonation()
		AND
		DB_Is_InCombat(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, _CombatGUID)
		AND
		DB_InRegion((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, (TRIGGER)S_END_BrainBattleArea_b0cbe773-d02f-4074-8507-eab6033c3b27)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		QRY_StartDialogCustom_Fixed((DIALOGRESOURCE)END_BrainBattle_GaleExplosion_3b9653f5-17c7-6716-2919-3ad3a9c137fc, S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, S_GLO_Netherbrain_3858e896-d7dd-4699-b37d-d3919ff15ba7, 0, 0, 0, 0)
		THEN
		DB_END_Gale_OrbDialogueStarted(1);
		PROC_END_BrainBattle_ClearBrainBattle();
		EndCombat(_CombatGUID);
		TeleportTo((CHARACTER)S_GLO_Elminster_75bb6396-1132-4064-bafe-205a3f156b9b, (TRIGGER)S_Debug_Teleport_END_FinaleEntrance_2915874b-b742-42b7-991f-86a07aeff6ee);
		SetOnStage((CHARACTER)S_GLO_Elminster_75bb6396-1132-4064-bafe-205a3f156b9b, 1);
		
		PROC
		PROC_END_Gale_OrbDetonation()
		AND
		DB_Is_InCombat(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, _CombatGUID)
		AND
		DB_InRegion((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, (TRIGGER)S_END_BrainBattleArea_b0cbe773-d02f-4074-8507-eab6033c3b27)
		AND
		DB_Avatars((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		QRY_StartDialogCustom_Fixed((DIALOGRESOURCE)END_BrainBattle_GaleExplosion_3b9653f5-17c7-6716-2919-3ad3a9c137fc, NULL_00000000-0000-0000-0000-000000000000, S_GLO_Netherbrain_3858e896-d7dd-4699-b37d-d3919ff15ba7, S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, 0, 0, 0, 0)
		THEN
		DB_END_Gale_OrbDialogueStarted(1);
		PROC_END_BrainBattle_ClearBrainBattle();
		EndCombat(_CombatGUID);
		TeleportTo((CHARACTER)S_GLO_Elminster_75bb6396-1132-4064-bafe-205a3f156b9b, (TRIGGER)S_Debug_Teleport_END_FinaleEntrance_2915874b-b742-42b7-991f-86a07aeff6ee);
		SetOnStage((CHARACTER)S_GLO_Elminster_75bb6396-1132-4064-bafe-205a3f156b9b, 1);
		
		PROC
		PROC_END_Gale_OrbDetonation()
		AND
		DB_Is_InCombat(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, _CombatGUID)
		AND
		DB_InRegion((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, (TRIGGER)S_END_BrainBattleArea_b0cbe773-d02f-4074-8507-eab6033c3b27)
		AND
		NOT DB_END_Gale_OrbDialogueStarted(1)
		THEN
		ShowGameOverMenu();
		
		IF
		DialogRequestFailed((DIALOGRESOURCE)END_BrainBattle_GaleExplosion_3b9653f5-17c7-6716-2919-3ad3a9c137fc, _ID)
		THEN
		ShowGameOverMenu();
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)END_BrainBattle_GaleExplosion_3b9653f5-17c7-6716-2919-3ad3a9c137fc, (INTEGER)_ID)
		AND
		DB_PartyMembers((CHARACTER)_Character)
		THEN
		PROC_DialogAddSpeakingActor(_ID, _Character);
		
		//Currently cine has disconnected the Elminster nodes from the dialog.
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)END_BrainBattle_GaleExplosion_3b9653f5-17c7-6716-2919-3ad3a9c137fc, (INTEGER)_ID)
		THEN
		PROC_DialogAddSpeakingActor(_ID, (CHARACTER)S_GLO_Elminster_75bb6396-1132-4064-bafe-205a3f156b9b);
		
		IF
		DialogStarted(END_BrainBattle_GaleExplosion_3b9653f5-17c7-6716-2919-3ad3a9c137fc, _)
		THEN
		SetFlag(END_FinalDecisions_Event_GaleExploded_a32e3cb5-9536-3c3e-a4d2-1837ee3b6190, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetFlag(ORI_DarkUrge_State_GoMadEnding_a0bea44c-be8a-26e4-ded5-c6c5827d4190, NULL_00000000-0000-0000-0000-000000000000, 0);	//Brain is getting blown up, so it`s a GoMadEnding by default.
		
		IF
		DialogStarted(END_BrainBattle_GaleExplosion_3b9653f5-17c7-6716-2919-3ad3a9c137fc, _)
		AND
		DB_GlobalFlag((FLAG)END_BrainBattle_Event_GaleExplodedMidBattle_993173dd-a519-c8aa-67d7-b4fecfd2b5dc)
		AND
		DB_PartyMembers((CHARACTER)_Character)
		THEN
		PROC_END_General_MakeAvatarUnavailable(_Character, 0);
		
		IF
		DialogEnded((DIALOGRESOURCE)END_BrainBattle_GaleExplosion_3b9653f5-17c7-6716-2919-3ad3a9c137fc, _ID)
		THEN
		PROC_END_BrainBattle_RevelryScene();
		
		IF
		DialogEnded((DIALOGRESOURCE)END_BrainBattle_Intro_4565e114-0153-0449-ea83-de3b972c7679, _)
		AND
		DB_GlobalFlag((FLAG)END_BrainBattle_Event_GaleAscendsTheStalkAlone_217731da-1297-09b6-52b0-e9ee8580e70c)
		THEN
		DetachFromPartyGroup((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604);
		PROC_END_BrainBattle_QueueFullRestore((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604);
		DB_END_BrainBattle_GaleRestoreReady(1);
		
		//END_REGION
		
		//REGION Journal
		
		PROC
		PROC_ORI_Gale_SetupEndGameJournal()
		AND
		DB_GlobalFlag((FLAG)ORI_Gale_State_Met_ElminsterInWYR_82b0cbde-1d3b-1f67-86a8-d05744462209)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Gale_State_MystraOM_40a7e59c-2473-504b-27ec-b2903fd5cf96)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Gale_MystraOM_State_RefusedOM_617d8194-0aa8-4fd9-9c8c-c6fd545afd64)
		THEN
		PROC_ORI_Gale_JournalUpdate("EndGame_SkippedMystra");
		
		PROC
		PROC_ORI_Gale_SetupEndGameJournal()
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Gale_Knows_ReadKarsusNotes_2b0e541f-f49e-7e82-27d6-15fccd6ff1ff)
		THEN
		PROC_ORI_Gale_JournalUpdate("EndGame_NoBook");
		
		PROC
		PROC_ORI_Gale_EndGameJournalUpdate((STRING)_Update)
		AND
		DB_GlobalFlag((FLAG)ORI_Gale_Knows_ReadKarsusNotes_2b0e541f-f49e-7e82-27d6-15fccd6ff1ff)
		THEN
		PROC_ORI_Gale_JournalUpdate(_Update);
		
		PROC
		PROC_ORI_Gale_EndGameJournalUpdate((STRING)_Update)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Gale_Knows_ReadKarsusNotes_2b0e541f-f49e-7e82-27d6-15fccd6ff1ff)
		AND
		Concatenate(_Update, "_NoBook", _NewUpdate)
		THEN
		PROC_ORI_Gale_JournalUpdate(_NewUpdate);
		
		PROC
		PROC_END_General_UpdateMindFlayerFlags((CHARACTER)_Avatar)
		AND
		DB_Avatars(_Avatar)
		AND
		_Avatar != S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c
		AND
		_Avatar != S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604
		THEN
		PROC_ORI_Gale_EndGameJournalUpdate("BecameIllithid");
		
		PROC
		PROC_END_General_UpdateMindFlayerFlags((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		PROC_ORI_Gale_EndGameJournalUpdate("KarlachIllithid");
		
		PROC
		PROC_END_General_UpdateMindFlayerFlags((CHARACTER)S_GLO_Orpheus_47c90728-af68-4cbc-baaa-6497eebd8d7e)
		THEN
		PROC_ORI_Gale_EndGameJournalUpdate("OrpheusIllithid");
		
		PROC
		PROC_END_General_UpdateMindFlayerFlags((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		THEN
		PROC_ORI_Gale_EndGameJournalUpdate("GaleIllithid");
		
		PROC
		PROC_END_General_UpdateMindFlayerFlags((CHARACTER)S_GLO_Emperor_73d49dc5-8b8b-45dc-a98c-927bb4e3169b)
		THEN
		PROC_ORI_Gale_EndGameJournalUpdate("EmperorIllithid");
		
		IF
		DialogEnded(END_MorphicPool_NetherbrainConfrontation_ce5161a9-9580-379a-6e1f-476a4ca688cf, _ID)
		AND
		DB_DialogPlayers(_ID, (CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, 1)
		THEN
		PROC_ORI_Gale_EndGameJournalUpdate("FailedDominateBrain");
		
		IF
		DialogEnded(END_MorphicPool_NetherbrainConfrontation_ce5161a9-9580-379a-6e1f-476a4ca688cf, _ID)
		AND
		NOT DB_DialogPlayers(_ID, (CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, 1)
		THEN
		PROC_ORI_Gale_EndGameJournalUpdate("MissedDominateBrain");
		
		//END_REGION
	}
	EXIT
	{
	}
}
