		DB_TUT_Lab_IntellectDevourerDialogues((DIALOGRESOURCE)GLO_Us_Summon_7e34566d-ff87-f435-b050-0bc514bce084);
		DB_GlobalFlagReactionAfterDialog(COL_Morgue_Butcher_State_ConvincedReleaseUs_f85984db-5653-3cbd-6892-4571cc25168b,(DIALOGRESOURCE)COL_Morgue_Butcher_FreedUs_d9019c61-d7c8-3bad-420e-e6bc9ad214f8);
		DB_GlobalFlagReactionAfterDialog(COL_Morgue_Butcher_State_ConvincedReleaseUs_f85984db-5653-3cbd-6892-4571cc25168b,(DIALOGRESOURCE)COL_Kitchen_Butcher_be8586a0-5737-c953-d28d-0b03772ac451);
		DB_FlagReactionAfterDialog(COL_Morgue_Event_ReceiveUsSavedReward_74210c6a-8939-3f02-33de-c5289c7de6eb,(DIALOGRESOURCE)COL_Morgue_Us_dbf36c59-70e2-205d-925c-ac66944d6562);
		DB_FlagReactionAfterDialog(COL_Morgue_Butcher_Event_ReceiveUsKey_9a74c3ee-1f08-4fcf-9f5e-37ed74fa3843,(DIALOGRESOURCE)COL_Morgue_Butcher_FreedUs_d9019c61-d7c8-3bad-420e-e6bc9ad214f8);
		DB_FlagReactionAfterDialog(COL_Morgue_Butcher_Event_ReceiveUsKey_9a74c3ee-1f08-4fcf-9f5e-37ed74fa3843,(DIALOGRESOURCE)COL_Kitchen_Butcher_be8586a0-5737-c953-d28d-0b03772ac451);
		
		DB_HostileToPlayerGroupCancelFlag(COL_Morgue_Butcher_State_ConvincedReleaseUs_f85984db-5653-3cbd-6892-4571cc25168b,(FACTION)ACT2_COL_Butcher_04637de8-a921-4c0f-80b3-1f25ed3e4f8c);
		DB_HostileToPlayerGroupCancelFlag(COL_Morgue_Butcher_State_ConvincedReleaseUs_f85984db-5653-3cbd-6892-4571cc25168b,(FACTION)ACT0_TUT_LabDevourer_55adef8a-dea9-4f20-9af4-1045ec79e749);
		DB_HostileToPlayerGroupCancelFlag(COL_Morgue_Event_ButcherCancelHostility_d06a61ef-552b-da79-9735-3cf773f883e0,(FACTION)ACT2_COL_Butcher_04637de8-a921-4c0f-80b3-1f25ed3e4f8c);
		DB_HostileToPlayerGroupCancelFlag(COL_Morgue_Event_ButcherCancelHostility_d06a61ef-552b-da79-9735-3cf773f883e0,(FACTION)ACT0_TUT_LabDevourer_55adef8a-dea9-4f20-9af4-1045ec79e749);
		SetOnStage(S_COL_Morgue_CageKey_b022b127-df51-4620-91fc-2ed63d2ed90d,0);
		
		DB_CombatReact_AD_OnTurn(S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,COL_Morgue_AD_Butcher_CombatTurn001_58789c6d-a75c-ff8f-4259-d57da54420a5,3);
		DB_CombatReact_AD_OnTurn(S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,COL_Morgue_AD_Butcher_CombatTurn002_0cfd2cec-1597-e2bb-f183-c58a165f4d32,6);
		
		DB_COL_Butcher_IntDev((CHARACTER)S_COL_IntellectDevourer_Kitchen_01_9036bdcf-d70d-47f0-a71c-e4d1a7db1a88);
		DB_COL_Butcher_IntDev((CHARACTER)S_COL_IntellectDevourer_Kitchen_02_fcb6ed15-2290-44fa-b0c4-5c8036b82c06);
		DB_COL_Butcher_IntDev((CHARACTER)S_COL_IntellectDevourer_Kitchen_03_506df930-e558-4078-81f0-b4929c264a04);
		DB_COL_Butcher_IntDev((CHARACTER)S_COL_IntellectDevourer_Kitchen_04_6199540e-df07-4ae3-892c-f87faacc3127);
		DB_COL_Butcher_IntDev((CHARACTER)S_COL_IntellectDevourer_Kitchen_05_c6db5b87-deb6-42d7-a615-6790801e006a);
	}
	KB
	{
		//REGION Debug hooks
		IF
		TextEvent("COL_Butcher")
		THEN
		PROC_TeleportPartiesTo((TRIGGER)S_COL_DEBUG_Morgue_Point_0d308efa-86a3-4b55-bbab-4a8ffe7287bc,"");
		
		IF
		TextEvent("morgue_us")
		THEN
		PROC_CharacterFullRestore((CHARACTER)S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558);
		PROC_GlobalSetFlagAndCache((FLAG)TUT_Lab_State_FreedBrain_2a0d14f5-661b-46d5-8910-98cc4f85c3e3);
		PROC_COL_Morgue_InitUs();
		ClearFlag((FLAG)COL_Morgue_Butcher_State_ConvincedReleaseUs_f85984db-5653-3cbd-6892-4571cc25168b);
		
		IF
		FlagSet(COL_Morgue_Debug_UsInColony_183e41d3-032f-4aeb-af77-2a8e0b7a9394,_,_)
		THEN
		DB_COL_Morgue_Debug_UsInColony(1);
		
		IF
		DB_COL_Morgue_Debug_UsInColony(1)
		AND
		DB_InRegion(_,(TRIGGER)S_COL_Colony_SUB_c72269e5-0719-4379-a8ea-ca2ca199d0a3)
		AND
		QRY_OnlyOnce("COL_Morgue_Debug_UsInColony")
		THEN
		NOT DB_COL_Morgue_Debug_UsInColony(1);
		ClearFlag(COL_Morgue_Debug_UsInColony_183e41d3-032f-4aeb-af77-2a8e0b7a9394);
		PROC_CharacterFullRestore((CHARACTER)S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558);
		PROC_GlobalSetFlagAndCache((FLAG)TUT_Lab_State_FreedBrain_2a0d14f5-661b-46d5-8910-98cc4f85c3e3);
		PROC_COL_Morgue_InitUs();
		ClearFlag((FLAG)COL_Morgue_Butcher_State_ConvincedReleaseUs_f85984db-5653-3cbd-6892-4571cc25168b);
		
		IF
		TextEvent("morgue_cagesneak")
		THEN
		ApplyStatus(S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,"BLINDED",20.0,1,NULL_00000000-0000-0000-0000-000000000000);
		PROC_ItemUnlockAndOpen(S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4);
		
		IF
		FlagSet(COL_Morgue_Debug_CageSneak_81b91dfb-8808-4a31-aa2d-fa0974e1d606,_,_)
		THEN
		ClearFlag(COL_Morgue_Debug_CageSneak_81b91dfb-8808-4a31-aa2d-fa0974e1d606);
		ApplyStatus(S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,"BLINDED",20.0,1,NULL_00000000-0000-0000-0000-000000000000);
		PROC_ItemUnlockAndOpen(S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4);
		
		//END_REGION
		
		//REGION Post-Chosen Three cleanup
		
		//If Us wasn't freed, the Butcher will have killed it
		PROC
		PROC_COL_KethericShowdown_ChosenThree_CleanUp()
		AND
		DB_GlobalFlag((FLAG)COL_Morgue_State_UsInColony_8e0a2351-4e88-0b3f-4088-6de33da0ddd4)
		AND
		NOT DB_GlobalFlag((FLAG)COL_Morgue_State_UsSaved_14440266-df48-ff1b-b65a-b661d79f523c)
		AND
		NOT DB_Defeated(S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db)
		AND
		NOT DB_CantAct(S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db)
		AND
		NOT DB_CantMove(S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db)
		AND
		NOT DB_Dead(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558)
		THEN
		DB_OnlyOnce("COL_Morgue_Us_KilledAfterChosenThree");
		TeleportTo(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,COL_Morgue_Us_Dead_Point_39241b40-1adb-470f-b391-a147836ea4bd,"",0,0,0,0,1);
		Die(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,DEATHTYPE.Physical,S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,1,0,0.0);
		ClearOwnership((ITEM)S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4);
		PROC_ItemUnlockAndOpen((ITEM)S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4);
		
		PROC
		PROC_COL_KethericShowdown_ChosenThree_CleanUp()
		AND
		DB_GlobalFlag((FLAG)COL_Morgue_State_UsInColony_8e0a2351-4e88-0b3f-4088-6de33da0ddd4)
		AND
		NOT DB_GlobalFlag((FLAG)COL_Morgue_State_UsSaved_14440266-df48-ff1b-b65a-b661d79f523c)
		AND
		NOT DB_OnlyOnce("COL_Morgue_Us_KilledAfterChosenThree")
		AND
		NOT DB_PermaDefeated(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558)
		THEN
		TimerLaunch("COL_Morgue_UsFreedAndSafe",2000); //delay in case PROC triggers while someone is in the Morgue or spotting will start dialogue first
		
		IF
		TimerFinished("COL_Morgue_UsFreedAndSafe")
		THEN
		DB_COL_Morgue_CheckUsCageOpened(1);
		
		PROC
		PROC_COL_KethericShowdown_ChosenThree_CleanUp()
		AND
		DB_COL_Butcher_IntDev(_Character)
		AND
		NOT DB_Defeated(_Character)
		THEN
		SetOnStage(_Character,0);
		NOT DB_COL_Butcher_IntDev(_Character);
		
		PROC
		PROC_COL_KethericShowdown_ChosenThree_CleanUp()
		AND
		NOT DB_Defeated(S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db)
		AND
		NOT DB_GlobalFlag((FLAG)COL_Butcher_State_WasRecruited_eb986be8-f802-9650-90eb-ecd028ecf9e3)
		THEN
		SetOnStage(S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,0);
		
		//END_REGION
		
		//REGION Resonance Stone reaction PADs
		
		IF
		StatusApplied((CHARACTER)_Character, "COL_RESONANCESTONE_BUFF",_, _)
		AND
		DB_InRegion((CHARACTER)_Character,S_COL_KitchenSecret_Area_Box_15007902-6a1c-4a58-8558-a63df446acb1)
		AND
		DB_Players(_Character)
		AND
		QRY_OncePerUserAndNearbyPlayers(_Character,"COL_ResonanceJoy_Apply_PAD")
		THEN
		ClearFlag((FLAG)COL_KitchenSecret_State_JoyRemoved_a8cd0896-6fb9-e135-f4b4-9ebf548c816c,_Character,0);
		PROC_TryStartAD(COL_KitchenSecret_ResonanceStone_PAD_a1f121ce-35d5-1d58-423c-a1bf1c0e3c4e,_Character);
		
		IF
		StatusApplied((CHARACTER)_Character, "COL_RESONANCESTONE_BUFF",_, _)
		AND
		DB_COL_ResonanceJoy_ToCheck(_Character)
		THEN
		TimerCancel("COL_ResonanceJoy_Remove_StatusCheck");
		
		IF
		StatusRemoved((CHARACTER)_Character, "COL_RESONANCESTONE_BUFF",_, _)
		AND
		DB_Players(_Character)
		THEN
		DB_COL_ResonanceJoy_ToCheck((CHARACTER)_Character);
		TimerLaunch("COL_ResonanceJoy_Remove_StatusCheck",500);
		
		PROC
		PROC_COL_ResonanceJoy_Remove_TryPAD((CHARACTER)_Character)
		AND
		DB_InRegion((CHARACTER)_Character,S_COL_KitchenSecret_Area_Box_15007902-6a1c-4a58-8558-a63df446acb1)
		AND
		HasActiveStatus(_Character,"COL_RESONANCESTONE_BUFF",0)
		AND
		QRY_OncePerUserAndNearbyPlayers((CHARACTER)_Character,"COL_ResonanceJoy_Remove_PAD")
		THEN
		SetFlag((FLAG)COL_KitchenSecret_State_JoyRemoved_a8cd0896-6fb9-e135-f4b4-9ebf548c816c,_Character,0);
		PROC_TryStartAD(COL_KitchenSecret_ResonanceStone_PAD_a1f121ce-35d5-1d58-423c-a1bf1c0e3c4e,_Character);
		
		IF
		TimerFinished("COL_ResonanceJoy_Remove_StatusCheck")
		AND
		DB_COL_ResonanceJoy_ToCheck((CHARACTER)_Character)
		THEN
		NOT DB_COL_ResonanceJoy_ToCheck(_Character);
		PROC_COL_ResonanceJoy_Remove_TryPAD(_Character);
		
		//END_REGION
		
		//REGION Us in Colony state
		
		IF
		DB_InRegion(_PartyMember,(TRIGGER)S_COL_Colony_SUB_c72269e5-0719-4379-a8ea-ca2ca199d0a3)
		AND
		DB_PartyMembers(_PartyMember)
		AND
		QRY_OnlyOnce("COL_Morgue_InitializedUs")
		AND
		DB_GlobalFlag(TUT_Lab_State_FreedBrain_2a0d14f5-661b-46d5-8910-98cc4f85c3e3)
		AND
		NOT DB_PermaDefeated(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558)
		THEN
		PROC_COL_Morgue_InitUs();
		
		PROC
		PROC_COL_Morgue_InitUs()
		THEN
		DB_DeadOnceFlag((CHARACTER)S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,COL_Morgue_State_Us_IsDead_72a07a1d-a984-4f87-bd5a-730e99b6263a);
		SetOnStage(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,1);
		SetFlag(COL_Morgue_State_UsInColony_8e0a2351-4e88-0b3f-4088-6de33da0ddd4);
		TeleportTo(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,S_COL_Morgue_Us_Point_cdfbc0be-4659-4e54-8ded-97812deb3f35,"",0,0,0,1,1);
		Transform(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,Intellect_Devourer_PlayerWildshape_27b9089b-9aef-44e9-aaf7-100e3e320823,(SHAPESHIFTRULE)DisguiseKeepName_c7c3381e-b901-416e-a0c4-bc745e1ff54a);
		PROC_RemoveAllDialogEntriesForSpeaker(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558);
		PROC_RemoveDialog(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558);
		DB_Dialogs(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,COL_Morgue_Us_dbf36c59-70e2-205d-925c-ac66944d6562);
		Close(S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4);
		Lock(S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4,"US_CAGE");
		SetOwner(S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4,S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db);
		PROC_ToInventoryAndOnStage(S_COL_Morgue_CageKey_b022b127-df51-4620-91fc-2ed63d2ed90d,(CHARACTER)S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,1,0,1);
		DB_CustomForbiddenItemCrimes(S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4,"COL_Morgue_Us_Freed","COL_Morgue_Us_Freed");
		TriggerRegisterForCharacter(S_COL_Morgue_Us_Cage_Box_887d142c-5df1-43cd-96ca-8c4f49e65873,S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558);
		TriggerRegisterForCharacter(S_COL_Morgue_Us_Area_Box_4844e8a2-c8ce-415d-9f68-9e9b2b83d131,S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558);
		SetCanJoinCombat(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,0);
		SetCanFight(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,0);
		PROC_SetRelationToPlayers((FACTION)ACT0_TUT_LabDevourer_55adef8a-dea9-4f20-9af4-1045ec79e749,100);
		
		IF
		FlagSet((FLAG)COL_Morgue_State_UsFreed_ac8042af-6b62-4d54-ad2c-44cf7aaa107f,_,_)
		THEN
		SetCanJoinCombat(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,1);
		SetCanFight(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,1);
		
		IF
		DB_GlobalFlag(COL_Morgue_State_UsInColony_8e0a2351-4e88-0b3f-4088-6de33da0ddd4)
		AND
		DB_PermaDefeated(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558)
		THEN
		ClearFlag(COL_Morgue_State_UsInColony_8e0a2351-4e88-0b3f-4088-6de33da0ddd4);
		
		IF
		DB_GlobalFlag(COL_Morgue_State_UsInColony_8e0a2351-4e88-0b3f-4088-6de33da0ddd4)
		AND
		DB_GlobalFlag(COL_Morgue_State_UsSaved_14440266-df48-ff1b-b65a-b661d79f523c)
		THEN
		ClearFlag(COL_Morgue_State_UsInColony_8e0a2351-4e88-0b3f-4088-6de33da0ddd4);
		
		//END_REGION
		
		//REGION Us cage/crime reaction/player following
		
		IF
		Opened(S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4)
		THEN
		SetOnStage(S_COL_Morgue_Us_InvisibleCageWall_8698f017-28bf-4cc3-bcb4-bf91820ee8d4,0);
		
		IF
		DestroyedBy(S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4,_,_,_)
		THEN
		SetOnStage(S_COL_Morgue_Us_InvisibleCageWall_8698f017-28bf-4cc3-bcb4-bf91820ee8d4,0);
		
		IF
		Closed(S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4)
		THEN
		SetOnStage(S_COL_Morgue_Us_InvisibleCageWall_8698f017-28bf-4cc3-bcb4-bf91820ee8d4,1);
		
		IF
		Unlocked(S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4,_Character,_)
		THEN
		Open(S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4);
		
		IF
		Opened(S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4)
		AND
		DB_GlobalFlag(COL_Morgue_State_UsInColony_8e0a2351-4e88-0b3f-4088-6de33da0ddd4)
		AND
		NOT DB_GlobalFlag(COL_Morgue_State_UsFreed_ac8042af-6b62-4d54-ad2c-44cf7aaa107f)
		THEN
		DebugText(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,"|Cage door opened|");
		SetFlag(COL_Morgue_State_UsFreed_ac8042af-6b62-4d54-ad2c-44cf7aaa107f);
		PROC_COL_Morgue_UsTryFollowPlayer(NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		DestroyedBy(S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4,_Character,_,_)
		AND
		DB_GlobalFlag(COL_Morgue_State_UsInColony_8e0a2351-4e88-0b3f-4088-6de33da0ddd4)
		AND
		NOT DB_GlobalFlag(COL_Morgue_State_UsFreed_ac8042af-6b62-4d54-ad2c-44cf7aaa107f)
		THEN
		DebugText(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,"|Cage door destroyed|");
		SetFlag(COL_Morgue_State_UsFreed_ac8042af-6b62-4d54-ad2c-44cf7aaa107f);
		PROC_COL_Morgue_UsTryFollowPlayer(_Character);
		
		//Us attacked reaction AD
		IF
		CrimeIsRegistered((CHARACTER)S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,_Crime,_,_,_Character,_,_,_)
		AND
		DB_CRIME_AssaultType(_,_,_Crime)
		AND
		DB_PartyMembers((CHARACTER)_Character)
		AND
		DB_GlobalFlag(COL_Morgue_State_UsInColony_8e0a2351-4e88-0b3f-4088-6de33da0ddd4)
		//AND
		//IsEnemy(_Character,S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,0)
		THEN
		PROC_COL_Morgue_AttackedUs((CHARACTER)_Character);
		
		PROC
		PROC_COL_Morgue_AttackedUs((CHARACTER)_Character)
		AND
		DB_Players(_Character)
		AND
		DB_OnlyOnce("COL_Morgue_AD_Us_Attacked")
		THEN
		//Only become hostile after warning
		DB_HostileToPlayerGroup((FACTION)ACT0_TUT_LabDevourer_55adef8a-dea9-4f20-9af4-1045ec79e749,_Character);
		
		PROC
		PROC_COL_Morgue_AttackedUs((CHARACTER)_Character)
		AND
		QRY_OnlyOnce("COL_Morgue_AD_Us_Attacked")
		THEN
		PROC_TryStartAD(COL_Morgue_AD_Us_Attacked_a5de407b-c627-cc83-340c-7507c4f403dd,S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558);
		
		//Chop will get angry if we attack Us
		QRY
		QRY_CRIME_BlockRegisterCrime(_Character,_Crime,_,(CHARACTER)S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,_)
		AND
		DB_CRIME_AssaultType(_,_,_Crime)
		AND
		DB_GlobalFlag(COL_Morgue_State_UsInColony_8e0a2351-4e88-0b3f-4088-6de33da0ddd4)
		AND
		NOT DB_GlobalFlag((FLAG)COL_Morgue_State_UsFreed_ac8042af-6b62-4d54-ad2c-44cf7aaa107f)
		AND
		NOT DB_Dead((CHARACTER)S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db)
		AND
		GetHitpoints(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,_Hitpoints)
		AND
		_Hitpoints > 0
		AND
		IsEnemy((CHARACTER)S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,0)
		AND
		CrimeGetNewID(_CrimeId)
		THEN
		DebugText(_Character,"|Attacked us.|");
		PROC_COL_Morgue_AttackedUs((CHARACTER)_Character);
		PROC_CharacterRegisterCrime((CHARACTER)_Character,"COL_Morgue_Us_Freed",S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4,S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,_CrimeId);
		
		//Chop will get angry if we kill Us
		IF
		KilledBy((CHARACTER)S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,_Character,_,_)
		AND
		DB_GlobalFlag(COL_Morgue_State_UsInColony_8e0a2351-4e88-0b3f-4088-6de33da0ddd4)
		AND
		GetRelation((FACTION)ACT2_COL_Butcher_04637de8-a921-4c0f-80b3-1f25ed3e4f8c,(FACTION)ACT0_TUT_LabDevourer_55adef8a-dea9-4f20-9af4-1045ec79e749,_Relation)
		AND
		_Relation > 0
		AND
		CrimeGetNewID(_CrimeId)
		THEN
		DebugText(_Character,"|Killed Us.|");
		PROC_CharacterRegisterCrime((CHARACTER)_Character,"COL_Morgue_Us_Freed",S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4,S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,_CrimeId);
		
		//Us somehow left its cage through systemic means
		IF
		LeftTrigger(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,S_COL_Morgue_Us_Cage_Box_887d142c-5df1-43cd-96ca-8c4f49e65873)
		AND
		DB_GlobalFlag(COL_Morgue_State_UsInColony_8e0a2351-4e88-0b3f-4088-6de33da0ddd4)
		AND
		NOT DB_GlobalFlag(COL_Morgue_State_UsFreed_ac8042af-6b62-4d54-ad2c-44cf7aaa107f)
		AND
		NOT DB_GlobalFlag(COL_Morgue_Butcher_State_ConvincedReleaseUs_f85984db-5653-3cbd-6892-4571cc25168b)
		THEN
		DebugText(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,"|Left cage trigger|");
		PROC_COL_Morgue_UsTryFollowPlayer(NULL_00000000-0000-0000-0000-000000000000);
		SetFlag(COL_Morgue_State_UsFreed_ac8042af-6b62-4d54-ad2c-44cf7aaa107f);
		
		//Freed follow
		PROC
		PROC_COL_Morgue_UsTryFollowPlayer((CHARACTER)_Player)
		AND
		QRY_COL_Morgue_UsShouldFollowPlayer()
		AND
		DB_Players(_Player)
		THEN
		PROC_Follow((CHARACTER)S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,_Player);
		
		PROC
		PROC_COL_Morgue_UsTryFollowPlayer(_Player)
		AND
		QRY_COL_Morgue_UsShouldFollowPlayer()
		AND
		NOT DB_Players(_Player) //could also be NULL
		THEN
		DB_SpotPlayers((CHARACTER)S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,"COL_Morgue_UsFollowPlayer",NULL_00000000-0000-0000-0000-000000000000,NULL_00000000-0000-0000-0000-000000000000);
		
		QRY
		QRY_COL_Morgue_UsShouldFollowPlayer()
		AND
		NOT DB_GlobalFlag(COL_Morgue_Butcher_State_ConvincedReleaseUs_f85984db-5653-3cbd-6892-4571cc25168b)
		AND
		NOT DB_GlobalFlag(COL_Morgue_State_ButcherIntDevDefeated_75768e95-037d-4221-a66d-726948cb3e7c)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_SpotPlayers_Spotted(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,"COL_Morgue_UsFollowPlayer",_Player)
		AND
		DB_Players(_Player)
		THEN
		DebugText(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,"|Follow spotted player|");
		PROC_Follow((CHARACTER)S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,_Player);
		PROC_SpotPlayers_StopSpotting("COL_Morgue_UsFollowPlayer");
		
		IF
		DB_Following((CHARACTER)S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,_Player)
		AND
		DB_GlobalFlag((FLAG)COL_Morgue_State_UsInColony_8e0a2351-4e88-0b3f-4088-6de33da0ddd4)
		THEN
		PROC_TryStartAD(COL_Morgue_AD_Us_FollowPlayer_d54ddcde-0361-4ca0-f34c-943c1c9ca37e,S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558);
		//DebugText(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,"|Get Us to safety!|");
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)COL_Morgue_Butcher_FreedUs_d9019c61-d7c8-3bad-420e-e6bc9ad214f8,_DialogId)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db)
		THEN
		PROC_DialogAddSpeakingActor(_DialogId,S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558);
		
		//REGION Chop spotting Us outside of cage
		//Chop will turn hostile on Us if he spots it outside of its cage
		//provided he doesn't see a player and starts the crime reaction
		//Need a workaround because there's a bug with AND NOT conditions in Osiris
		PROC
		PROC_COL_Morgue_InitUs()
		THEN
		DB_COL_Morgue_BlockChopSpottingUs_ButcherUnconvinced(1);
		DB_COL_Morgue_BlockChopSpottingUs_ButcherNotInDialog(1);
		
		IF
		FlagSet(COL_Morgue_Butcher_State_ConvincedReleaseUs_f85984db-5653-3cbd-6892-4571cc25168b,_,_)
		AND
		DB_COL_Morgue_BlockChopSpottingUs_ButcherUnconvinced(1)
		THEN
		NOT DB_COL_Morgue_BlockChopSpottingUs_ButcherUnconvinced(1);
		
		IF
		FlagCleared(COL_Morgue_Butcher_State_ConvincedReleaseUs_f85984db-5653-3cbd-6892-4571cc25168b,_,_)
		AND
		NOT DB_COL_Morgue_BlockChopSpottingUs_ButcherUnconvinced(1)
		THEN
		DB_COL_Morgue_BlockChopSpottingUs_ButcherUnconvinced(1);
		
		IF
		EnteredTrigger(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,S_COL_Morgue_Us_Cage_Box_887d142c-5df1-43cd-96ca-8c4f49e65873)
		AND
		DB_COL_Morgue_BlockChopSpottingUs_UsNotInCage(1)
		THEN
		NOT DB_COL_Morgue_BlockChopSpottingUs_UsNotInCage(1);
		
		IF
		LeftTrigger(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,S_COL_Morgue_Us_Cage_Box_887d142c-5df1-43cd-96ca-8c4f49e65873)
		AND
		NOT DB_COL_Morgue_BlockChopSpottingUs_UsNotInCage(1)
		THEN
		DB_COL_Morgue_BlockChopSpottingUs_UsNotInCage(1);
		
		IF
		DialogActorJoined(_,_,S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,_)
		AND
		DB_COL_Morgue_BlockChopSpottingUs_ButcherNotInDialog(1)
		THEN
		NOT DB_COL_Morgue_BlockChopSpottingUs_ButcherNotInDialog(1);
		
		IF
		DialogActorLeft(_,_,S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,_)
		AND
		NOT DB_COL_Morgue_BlockChopSpottingUs_ButcherNotInDialog(1)
		THEN
		DB_COL_Morgue_BlockChopSpottingUs_ButcherNotInDialog(1);
		
		IF
		DB_GlobalFlag(COL_Morgue_State_UsFreed_ac8042af-6b62-4d54-ad2c-44cf7aaa107f)
		AND
		DB_Sees((CHARACTER)S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,(CHARACTER)S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558)
		AND
		DB_COL_Morgue_BlockChopSpottingUs_ButcherUnconvinced(1) //AND NOT bug workaround
		AND
		DB_COL_Morgue_BlockChopSpottingUs_UsNotInCage(1) //AND NOT bug workaround
		AND
		DB_COL_Morgue_BlockChopSpottingUs_ButcherNotInDialog(1) //AND NOT bug workaround
		AND
		NOT DB_CRIME_HandlingCrime(_,S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db)
		AND
		QRY_OnlyOnce("COL_Morgue_ChopSpotsUs")
		THEN
		DebugText(S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,"Spotted Us");
		TimerLaunch("COL_Morgue_UsFollowingCrime",1000);
		//This delay allows Us' "follow spotting" to occur
		//Which will make Us follow a player, making it easier to determine a criminal
		//Using a timer here is filthy and despicable, but I wouldn't know how else
		//to account for someone *not* getting spotted within this timespan
		
		IF
		TimerFinished("COL_Morgue_UsFollowingCrime")
		THEN
		PROC_COL_Morgue_UsFollowingCrime();
		
		PROC
		PROC_COL_Morgue_UsFollowingCrime()
		AND
		DB_Following((CHARACTER)S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,_Player)
		AND
		CrimeGetNewID(_CrimeID)
		THEN
		PROC_CharacterRegisterCrime(_Player,"COL_Morgue_Us_Freed",S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4,S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,_CrimeId);
		
		PROC
		PROC_COL_Morgue_UsFollowingCrime()
		AND
		NOT DB_Following((CHARACTER)S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,_)
		AND
		CrimeGetNewID(_CrimeID)
		THEN
		PROC_TryStartAD(COL_Morgue_AD_Butcher_SpotUs_c5f00f61-4ad6-df32-fa9e-d9e95529e54b,S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db);
		PROC_SetRelationMutual((FACTION)ACT2_COL_Butcher_04637de8-a921-4c0f-80b3-1f25ed3e4f8c,(FACTION)ACT0_TUT_LabDevourer_55adef8a-dea9-4f20-9af4-1045ec79e749,0);
		PROC_CharacterRegisterCrime(NULL_00000000-0000-0000-0000-000000000000,"COL_Morgue_Us_Freed",S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4,S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,_CrimeId);
		
		PROC
		PROC_COL_Morgue_UsFollowingCrime()
		AND
		DB_Following((CHARACTER)S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,_Player)
		AND
		NOT DB_Sees(S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,_Player)
		THEN
		PROC_TryStartAD(COL_Morgue_AD_Butcher_SpotUs_c5f00f61-4ad6-df32-fa9e-d9e95529e54b,S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db);
		PROC_SetRelationMutual((FACTION)ACT2_COL_Butcher_04637de8-a921-4c0f-80b3-1f25ed3e4f8c,(FACTION)ACT0_TUT_LabDevourer_55adef8a-dea9-4f20-9af4-1045ec79e749,0);
		
		IF
		DB_Is_InCombat(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,_CombatId)
		AND
		DB_Is_InCombat(_Character,_CombatId)
		AND
		DB_GLO_DefeatCounter(_Character,"COL_Morgue_DefeatCounter")
		AND
		DB_Following((CHARACTER)S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,_Player)
		THEN
		DB_HostileToPlayerGroup((FACTION)ACT2_COL_Butcher_04637de8-a921-4c0f-80b3-1f25ed3e4f8c,_Player);
		
		//END_REGION
		
		//Intercept cage crime reactions
		QRY
		QRY_CRIME_BlockRegisterCrime(_Criminal,"KnockSpell",S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4,S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,_CrimeId)
		AND
		DB_GlobalFlag(COL_Morgue_State_UsInColony_8e0a2351-4e88-0b3f-4088-6de33da0ddd4)
		AND
		NOT DB_GlobalFlag(COL_Morgue_State_UsFreed_ac8042af-6b62-4d54-ad2c-44cf7aaa107f)
		AND
		NOT DB_GlobalFlag(COL_Morgue_Butcher_State_ConvincedReleaseUs_f85984db-5653-3cbd-6892-4571cc25168b)
		THEN
		PROC_CharacterRegisterCrime(_Criminal,"COL_Morgue_Us_Freed",S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4,S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,_CrimeId);
		
		QRY
		QRY_CRIME_BlockRegisterCrime(_Criminal,"Vandalism",S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4,S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,_CrimeId)
		AND
		DB_GlobalFlag(COL_Morgue_State_UsInColony_8e0a2351-4e88-0b3f-4088-6de33da0ddd4)
		AND
		NOT DB_GlobalFlag(COL_Morgue_State_UsFreed_ac8042af-6b62-4d54-ad2c-44cf7aaa107f)
		AND
		NOT DB_GlobalFlag(COL_Morgue_Butcher_State_ConvincedReleaseUs_f85984db-5653-3cbd-6892-4571cc25168b)
		THEN
		PROC_CharacterRegisterCrime(_Criminal,"COL_Morgue_Us_Freed",S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4,S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,_CrimeId);
		
		//Add Us as optional speaker to crime reaction dialog
		PROC
		PROC_StartDialog_AddExtraSpeakers(COL_Morgue_Butcher_FreedUs_d9019c61-d7c8-3bad-420e-e6bc9ad214f8,_DialogId)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558)
		THEN
		PROC_DialogAddSpeakingActor(_DialogId,S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558);
		
		IF
		FlagSet(COL_Morgue_Event_ButcherCancelHostility_d06a61ef-552b-da79-9735-3cf773f883e0,_,_)
		THEN
		ClearFlag(COL_Morgue_Event_ButcherCancelHostility_d06a61ef-552b-da79-9735-3cf773f883e0);
		
		//END_REGION
		
		//REGION Us release reward
		
		// Conditions:
		// - Get Us out of its cage/unlock the cage door
		//	AND either:
		//		- Defeat Chop and the intellect devourers
		// OR	- Get Us out without Chop noticing
		// OR	- Convince Chop to let Us out
		
		//Convince solution
		PROC
		PROC_GlobalFlagReactionAfterDialog(COL_Morgue_Butcher_State_ConvincedReleaseUs_f85984db-5653-3cbd-6892-4571cc25168b)
		THEN
		ClearOwnership(S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4);
		DebugText(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,"|Convinced Butcher|");
		DB_COL_Morgue_CheckUsCageOpened(1);
		
		//Get key to Us' cage if the cage is still locked
		PROC
		PROC_FlagReactionAfterDialog(_Player,COL_Morgue_Butcher_Event_ReceiveUsKey_9a74c3ee-1f08-4fcf-9f5e-37ed74fa3843)
		AND
		IsLocked((ITEM)S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4,1)
		AND
		GetInventoryOwner(S_COL_Morgue_CageKey_b022b127-df51-4620-91fc-2ed63d2ed90d,S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db)
		THEN
		ToInventory((ITEM)S_COL_Morgue_CageKey_b022b127-df51-4620-91fc-2ed63d2ed90d,_Player,1,1,1);
		
		IF
		DB_COL_Morgue_CheckUsCageOpened(1)
		AND
		QRY_IsOpeneding((ITEM)S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4)
		THEN
		DB_COL_Morgue_UsCageOpened(1);
		
		IF
		Opened(S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4)
		AND
		DB_COL_Morgue_CheckUsCageOpened(1)
		THEN
		DB_COL_Morgue_UsCageOpened(1);
		
		IF
		DB_COL_Morgue_CheckUsCageOpened(1)
		AND
		DB_COL_Morgue_UsCageOpened(1)
		THEN
		PROC_COL_Morgue_OnUsFreedAndSafe();
		NOT DB_COL_Morgue_CheckUsCageOpened(1);
		NOT DB_COL_Morgue_UsCageOpened(1);
		
		//Kill Butcher + int devs solution
		IF
		FlagSet(COL_Morgue_State_UsFreed_ac8042af-6b62-4d54-ad2c-44cf7aaa107f,_,_)
		THEN
		DB_GLO_DefeatCounter_AllDefeatedGlobalFlag("COL_Morgue_DefeatCounter",COL_Morgue_State_ButcherIntDevDefeated_75768e95-037d-4221-a66d-726948cb3e7c);
		DB_GLO_DefeatCounter(S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,"COL_Morgue_DefeatCounter");
		DB_GLO_DefeatCounter(S_COL_IntellectDevourer_Kitchen_01_9036bdcf-d70d-47f0-a71c-e4d1a7db1a88,"COL_Morgue_DefeatCounter");
		DB_GLO_DefeatCounter(S_COL_IntellectDevourer_Kitchen_02_fcb6ed15-2290-44fa-b0c4-5c8036b82c06,"COL_Morgue_DefeatCounter");
		DB_GLO_DefeatCounter(S_COL_IntellectDevourer_Kitchen_03_506df930-e558-4078-81f0-b4929c264a04,"COL_Morgue_DefeatCounter");
		DB_GLO_DefeatCounter(S_COL_IntellectDevourer_Kitchen_04_6199540e-df07-4ae3-892c-f87faacc3127,"COL_Morgue_DefeatCounter");
		
		PROC
		PROC_GLO_DefeatCounter_AllDefeated("COL_Morgue_DefeatCounter")
		THEN
		DebugText(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,"|All defeated|");
		PROC_COL_Morgue_OnUsFreedAndSafe();
		
		//Escape solution
		IF
		DB_GlobalFlag((FLAG)COL_Morgue_State_UsFreed_ac8042af-6b62-4d54-ad2c-44cf7aaa107f)
		AND
		NOT DB_InRegion(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,S_COL_Morgue_Us_Area_Box_4844e8a2-c8ce-415d-9f68-9e9b2b83d131)
		AND
		NOT DB_Is_InCombat(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,_)
		THEN
		DebugText(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,"|Escaped morgue|");
		PROC_COL_Morgue_OnUsFreedAndSafe();
		
		IF
		LeftTrigger((CHARACTER)S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,S_COL_Morgue_Us_Area_Box_4844e8a2-c8ce-415d-9f68-9e9b2b83d131)
		AND
		DB_Following((CHARACTER)S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,_)
		THEN
		PROC_StopFollow((CHARACTER)S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558);
		
		//Wrap up spotting
		PROC
		PROC_COL_Morgue_OnUsFreedAndSafe()
		THEN
		DB_COL_Morgue_UsFreedAndSafe_AwaitingWrapUp(1);
		
		IF
		DB_COL_Morgue_UsFreedAndSafe_AwaitingWrapUp(1)
		AND
		DB_PermaDefeatedOrOffstage(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558)
		THEN
		NOT DB_COL_Morgue_UsFreedAndSafe_AwaitingWrapUp(1);
		
		IF
		DB_COL_Morgue_UsFreedAndSafe_AwaitingWrapUp(1)
		AND
		NOT DB_Defeated(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558)
		AND
		QRY_OnlyOnce("COL_Morgue_DidUsWrapUp")
		THEN
		NOT DB_COL_Morgue_UsFreedAndSafe_AwaitingWrapUp(1);
		ClearOwnership(S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4);
		SetFlag(COL_Morgue_State_UsSaved_14440266-df48-ff1b-b65a-b661d79f523c);
		DB_SpotPlayers_Continuous(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,"COL_Morgue_UsWrapUp");
		DB_SpotPlayers(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,"COL_Morgue_UsWrapUp",NULL_00000000-0000-0000-0000-000000000000,NULL_00000000-0000-0000-0000-000000000000);
		
		PROC
		PROC_COL_Morgue_OnUsFreedAndSafe()
		AND
		DB_Following((CHARACTER)S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,_)
		THEN
		PROC_StopFollow((CHARACTER)S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558);
		
		IF
		DB_SpotPlayers_Spotted(_,"COL_Morgue_UsWrapUp",_Player)
		AND
		DB_Players(_Player)
		AND
		NOT DB_CantTalk(_Player)
		AND
		NOT DB_CantTalk(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558)
		AND
		QRY_StartDialog(COL_Morgue_Us_dbf36c59-70e2-205d-925c-ac66944d6562,S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558,_Player)
		THEN
		PROC_SpotPlayers_StopSpotting("COL_Morgue_UsWrapUp");
		
		//Remove cage door ownership
		PROC
		PROC_COL_Morgue_OnUsFreedAndSafe()
		THEN
		PROC_COL_Morgue_ClearCageOwnership();
		
		IF
		FlagCleared((FLAG)COL_Morgue_State_UsInColony_8e0a2351-4e88-0b3f-4088-6de33da0ddd4,_,_)
		THEN
		PROC_COL_Morgue_ClearCageOwnership();
		
		PROC
		PROC_COL_Morgue_ClearCageOwnership()
		THEN
		ClearOwnership((ITEM)S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4);
		NOT DB_CustomForbiddenItemCrimes(S_COL_Morgue_Cage_Us_5f3613eb-f290-4828-80dc-167ed16134d4,"COL_Morgue_Us_Freed","COL_Morgue_Us_Freed");
		
		
		//Reward (summon scripting done in GLO_Us_Summon goal)
		PROC
		PROC_FlagReactionAfterDialog(_Player,COL_Morgue_Event_ReceiveUsSavedReward_74210c6a-8939-3f02-33de-c5289c7de6eb)
		AND
		CreateAtObject(UNI_COL_Us_Summon_Brain_dbc5b484-26d6-41f3-bd50-dc74b8f9cc9b,_Player,0,0,"",0,_Item)
		THEN
		ToInventory((ITEM)_Item,_Player,1,1,1);
		ClearFlag(COL_Morgue_Event_ReceiveUsSavedReward_74210c6a-8939-3f02-33de-c5289c7de6eb,_Player);
		PROC_Poof(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558);
		
		//END_REGION
		
		//REGION Prevent corpses being owned
		
		QRY
		QRY_CorpseLooting_BlockMakeOwned((CHARACTER)S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_CorpseLooting_BlockMakeOwned((CHARACTER)S_COL_CleansingRoom_Chute_Corpse_aab704a9-68bd-4684-9185-80a92d3681ab)
		THEN
		DB_NOOP(1);
		
		//END_REGION
		
		//REGION Blood shower/falling corpse
		
		IF
		UseFinished(_Character,S_COL_CleansingRoom_Button_7cd94d20-6cc7-4d6d-8f9a-1d05b5de11db, 1)
		AND
		QRY_OnlyOnce("COL_Cleansing_SpawnedCorpse")
		THEN
		Die(S_COL_CleansingRoom_Chute_Corpse_aab704a9-68bd-4684-9185-80a92d3681ab,DEATHTYPE.None,S_COL_CleansingRoom_Chute_Corpse_aab704a9-68bd-4684-9185-80a92d3681ab,1,1,0.0);
		SetOnStage(S_COL_CleansingRoom_Chute_Corpse_aab704a9-68bd-4684-9185-80a92d3681ab,1);
		TeleportTo(S_COL_CleansingRoom_Chute_Corpse_aab704a9-68bd-4684-9185-80a92d3681ab,S_COL_Cleansing_BloodEffect_Point_d9f78610-9e5c-4e27-a998-6d7f482e4cdc,"",0,0,0,0,0);
		TimerLaunch("COL_Cleansing_Chute_Blood",300);
		DB_COL_Chute_Character(_Character);
		TimerCancel("COL_Cleansing_Chute_AD");
		TimerLaunch("COL_Cleansing_Chute_AD",2000);
		PROC_COL_CleansingRoom_BloodShower_Check();
		
		IF
		UseFinished(_Character,S_COL_CleansingRoom_Button_7cd94d20-6cc7-4d6d-8f9a-1d05b5de11db, 1)
		AND
		GetPosition(S_COL_Cleansing_BloodEffect_Point_d9f78610-9e5c-4e27-a998-6d7f482e4cdc,_X,_Y,_Z)
		AND
		DB_OnlyOnce("COL_Cleansing_SpawnedCorpse")
		THEN
		PROC_COL_CleansingRoom_BloodShower_Check();
		
		//Temporarily disable button to prevent VFX spam
		IF
		UseFinished(_Character,S_COL_CleansingRoom_Button_7cd94d20-6cc7-4d6d-8f9a-1d05b5de11db, 1)
		THEN
		SetCanInteract(S_COL_CleansingRoom_Button_7cd94d20-6cc7-4d6d-8f9a-1d05b5de11db,0);
		ObjectTimerLaunch(S_COL_CleansingRoom_Button_7cd94d20-6cc7-4d6d-8f9a-1d05b5de11db,"COL_Cleansing_ReenableButton",800);
		
		IF
		ObjectTimerFinished(S_COL_CleansingRoom_Button_7cd94d20-6cc7-4d6d-8f9a-1d05b5de11db,"COL_Cleansing_ReenableButton")
		THEN
		SetCanInteract(S_COL_CleansingRoom_Button_7cd94d20-6cc7-4d6d-8f9a-1d05b5de11db,1);
		
		IF
		Dying(S_COL_CleansingRoom_Chute_Corpse_aab704a9-68bd-4684-9185-80a92d3681ab)
		THEN
		SetVisible(S_COL_CleansingRoom_Chute_Corpse_aab704a9-68bd-4684-9185-80a92d3681ab,1);
		PROC_Foop(S_COL_CleansingRoom_Chute_Corpse_aab704a9-68bd-4684-9185-80a92d3681ab);
		
		IF
		TimerFinished("COL_Cleansing_Chute_Blood")
		THEN
		CreateSurface(S_COL_BloodSurface_Target_Point_42ca4f7e-5822-412a-a199-5256f9d28f7d,"SurfaceBlood",5.0,-1.0);
		
		//Play button press reaction PAD
		IF
		TimerFinished("COL_Cleansing_Chute_AD")
		AND
		NOT DB_COL_CleansingRoom_BloodShower_Target(_)
		AND
		DB_COL_Chute_Character(_Player)
		AND
		DB_Players(_Player)
		THEN
		PROC_TryStartAD(COL_CleansingChute_PAD_7209e688-ec74-45ed-1a34-213032b0ea25,_Player);
		
		//Play blood shower PAD
		IF
		TimerFinished("COL_Cleansing_Chute_AD")
		AND
		DB_COL_CleansingRoom_BloodShower_Target(_Player)
		AND
		DB_Players(_Player)
		THEN
		PROC_TryStartAD(COL_CleansingChute_PAD_BloodShower_3aa6a9ba-f8ac-2865-bd2e-9b1e22c4645f,_Player);
		NOT DB_COL_CleansingRoom_BloodShower_Target(_Player);
		
		IF
		TimerFinished("COL_Cleansing_Chute_AD")
		AND
		DB_COL_Chute_Character(_Character)
		THEN
		NOT DB_COL_Chute_Character(_Character);
		
		//CORPSE CHUTE BLOOD SHOWER
		PROC
		PROC_COL_CleansingRoom_BloodShower_Check()
		THEN 
		PlayEffect(S_COL_Cleansing_BloodEffect_Point_d9f78610-9e5c-4e27-a998-6d7f482e4cdc,VFX_Script_COL_Cleansing_BloodEffect_01_3d232c29-3e88-5ca1-1b00-bf4ac7ef0aa8,"",1.0);
		PlayEffect(S_COL_Cleansing_BloodSurface_Point_42ca4f7e-5822-412a-a199-5256f9d28f7d,VFX_Script_COL_Cleansing_BloodEffect_Ground_01_9e1739b2-fe03-75aa-415c-bb4e1d695d3d,"",1.0);
		//Blood particle effect
		
		PROC
		PROC_COL_CleansingRoom_BloodShower_Check()
		AND
		DB_InRegion(_Entity,S_COL_CleansingRoom_BloodShower_Box_ce0d8b1d-afe6-48f0-aa03-1a8913b51ac7)
		THEN
		ApplyStatus(_Entity, "BLOOD_COVERED_FULL", -1.0, 1, NULL_00000000-0000-0000-0000-000000000000);
		
		PROC
		PROC_COL_CleansingRoom_BloodShower_Check()
		AND
		DB_InRegion(_Player,S_COL_CleansingRoom_BloodShower_Box_ce0d8b1d-afe6-48f0-aa03-1a8913b51ac7)
		AND
		DB_Players(_Player)
		THEN
		TimerCancel("COL_Cleansing_Chute_AD");
		TimerLaunch("COL_Cleansing_Chute_AD",2000);
		
		PROC
		PROC_COL_CleansingRoom_BloodShower_Check()
		AND
		DB_InRegion(_Player,S_COL_CleansingRoom_BloodShower_Box_ce0d8b1d-afe6-48f0-aa03-1a8913b51ac7)
		AND
		DB_Players(_Player)
		AND
		NOT DB_COL_CleansingRoom_BloodShower_Target(_)
		AND
		QRY_SpeakerIsAvailable(_Player)
		AND
		QRY_OncePerUserAndNearbyPlayers((CHARACTER)_Player,"COL_CleansingChute_BloodShower")
		THEN
		DB_COL_CleansingRoom_BloodShower_Target(_Player);
		
		//END_REGION
		
		//REGION Chop ADs
		
		IF
		EnteredCombat((CHARACTER)S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,_)
		AND
		NOT DB_DialogSpeakers(_,S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db,_)
		THEN
		PROC_TryStartAD(COL_Morgue_AD_Butcher_CombatEnter_3e34c624-4549-8a9b-cf02-3696d9ee6f81,S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db);
		
		IF
		Dying(S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db)
		THEN
		DB_DialogDeath(S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db);
		PROC_TryStartAD(COL_Morgue_AD_Butcher_Death_8123a9ec-ea56-6f48-e45e-fce8c7dc558d,S_COL_Butcher_82ebdca0-f478-4c2b-a529-179a7e82b3db);
		
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(333).Title("Act2_COL_NecromancerRoom");
Goal(333)
{
	INIT
	{
		DB_COL_NecromancerLab_Start((TRIGGER)S_COL_NecromancerLab_Start1_9d16f2ad-cbe3-4f1e-980e-050dc3a5e333);
		DB_COL_NecromancerLab_Start(S_COL_NecromancerLab_Start2_8b027d15-87b2-40a8-9c07-e21625649b1d);
		DB_COL_NecromancerLab_Start(S_COL_NecromancerLab_Start3_75b3b1ae-da29-4a49-853a-8e650a2503bb);
		DB_COL_NecromancerLab_Start(S_COL_NecromancerLab_Start4_a268a2c9-063a-49bd-9bac-1752dd6bb836);
		DB_COL_NecromancerLab_Start(S_COL_NecromancerLab_Start5_d25b1d01-3768-4043-b929-a314362cc950);
		DB_COL_NecromancerLab_Start(S_COL_NecromancerLab_Start6_f998703a-edd2-4168-b5f0-de775063d051);
		
		//_Zombie,_SwarmGroupID,_AnubisConfig
		DB_COL_NecromancerLab_ReplaceableZombies((CHARACTER)S_COL_NecromancerRoom_Undead1_dbdabc8b-afe2-470c-aaf6-b4d8b20248fc,"COL_NecroLab_ZombiesDefault01","COL_NecromancerLab_Undead1");
		DB_COL_NecromancerLab_ReplaceableZombies((CHARACTER)S_COL_NecromancerRoom_Undead2_7e522c85-8768-40c1-8cf4-71ac9bdf8ac0,"COL_NecroLab_ZombiesDefault01","COL_NecromancerLab_Undead2");
		DB_COL_NecromancerLab_ReplaceableZombies((CHARACTER)S_COL_NecromancerRoom_Undead3_af7d7501-4054-4ef9-98d1-0f4c3c1e4a1e,"COL_NecroLab_ZombiesDefault01","COL_NecromancerLab_Undead3");
		DB_COL_NecromancerLab_ReplaceableZombies((CHARACTER)S_COL_NecromancerRoom_Undead4_38db884e-3817-48bb-a7ae-c066cb6176f9,"COL_NecroLab_ZombiesDefault02","COL_NecromancerLab_Undead4");
		DB_COL_NecromancerLab_ReplaceableZombies((CHARACTER)S_COL_NecromancerRoom_Undead5_28c8a569-740b-4963-9edb-b900e6af15ae,"COL_NecroLab_ZombiesDefault02","COL_NecromancerLab_Undead5");
		DB_COL_NecromancerLab_ReplaceableZombies((CHARACTER)S_COL_NecromancerRoom_Undead6_746f16c5-59bd-4b88-b250-64448fc4c05f,"COL_NecroLab_ZombiesDefault02","COL_NecromancerLab_Undead6");
		
		DB_COL_NecromancerLab_Candidates((CHARACTER)S_GLO_Wulbren_2d70edbf-1a70-4047-8099-48f3e75d93bf, (TRIGGER)S_COL_NecromancerLab_ZombiePoint_Wulbren_c85ab9a1-f9fb-4f9a-8622-b43a026572d7,"COL_NecroLab_ZombieCandidates01","COL_NecroLab_ZombieName_Wulbren");
		DB_COL_NecromancerLab_Candidates((CHARACTER)S_GLO_GnomePrisoner_001_4fbd62e8-a486-471e-8a65-00966b058dd5, S_COL_NecromancerLab_ZombiePoint_GnomePrisoner_001_ca932e0f-8cb4-4ccb-a01e-4b6850b36743,"COL_NecroLab_ZombieCandidates01","COL_NecroLab_ZombieName_GnomePrisoner_001");
		DB_COL_NecromancerLab_Candidates((CHARACTER)S_GLO_GnomePrisoner_002_c9a7d921-bef0-4829-8792-d48c529daee5, S_COL_NecromancerLab_ZombiePoint_GnomePrisoner_002_e8bdacdb-a2f4-4fca-bc96-31faedbfa200,"COL_NecroLab_ZombieCandidates01","COL_NecroLab_ZombieName_GnomePrisoner_002");
		DB_COL_NecromancerLab_Candidates((CHARACTER)S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, S_COL_NecromancerLab_ZombiePoint_DrowCommander_64eff4fd-6679-4db4-93f2-5b5fa8df6190,"COL_NecroLab_ZombieCandidates01","COL_NecroLab_ZombieName_DrowCommander");
		DB_COL_NecromancerLab_Candidates((CHARACTER)S_GOB_GoblinKing_11337af0-6a57-426b-a820-c4b00923dd54, S_COL_NecromancerLab_ZombiePoint_GoblinKing_7e78c743-1594-42cf-a5d8-a02ab71c8547,"COL_NecroLab_ZombieCandidates01","COL_NecroLab_ZombieName_GoblinKing");
		DB_COL_NecromancerLab_Candidates((CHARACTER)S_GLO_ProdigySister_44d09b0b-0568-456c-b18d-559a0a3f981d, S_COL_NecromancerLab_ZombiePoint_ProdigySister_7f9f6eb3-c190-4ff9-9677-2255fee5df7e,"COL_NecroLab_ZombieCandidates02","COL_NecroLab_ZombieName_ProdigySister");
		DB_COL_NecromancerLab_Candidates((CHARACTER)S_GLO_ProdigyBrother_d0187724-c0e2-4019-a01d-a03ee8153f1b, S_COL_NecromancerLab_ZombiePoint_ProdigyBrother_979489c3-c452-4272-9a6a-351ff4f1af9d,"COL_NecroLab_ZombieCandidates02","COL_NecroLab_ZombieName_ProdigyBrother");
		DB_COL_NecromancerLab_Candidates((CHARACTER)S_GLO_YoungLover_01_dd9178e7-1e3f-43bc-8a38-666dfcac7d0c, S_COL_NecromancerLab_ZombiePoint_YoungLover_37715e15-c055-4678-b993-1c220af03c88,"COL_NecroLab_ZombieCandidates02","COL_NecroLab_ZombieName_YoungLover_01");
