		DB_GLO_Tags_GameStartTagExclusionTag((TAG)ILLITHID_1eec74e8-3673-4500-abec-57b7ed8469ed, (TAG)REALLY_HALSIN_9b8709f9-8d2a-4b4e-a465-8505c561d7f5);
		DB_GLO_Tags_GameStartTagExclusionTag((TAG)BALDURIAN_f15e9b0d-676c-4f52-9abf-365cff89ef0f,(TAG)REALLY_MINSC_aeb694fc-83fb-452d-819a-b97ba442dc42);
		
		//END_REGION
	}
	KB
	{
		PROC
		PROC_CheckRaceTags()
		THEN
		IterateTagsCategory(TAGCATEGORY.Race,"GLO_RaceTag","GLO_FillRaceTags_Finish");
		IterateTagsCategory(TAGCATEGORY.Race_Meta,"GLO_RaceMetaTag","GLO_FillRaceMetaTags_Finish");
		
		IF
		TagEvent(_Tag,"GLO_RaceTag")
		AND
		NOT DB_RaceTags(_Tag,_)
		AND
		NOT DB_RaceTags(_,_Tag)
		AND
		NOT DB_RaceTags_NoREALLY(_Tag)
		AND
		GUIDToString(_Tag,_TagStr)
		AND
		Concatenate("Tag in Race category is not in DB_RaceTags: ",_TagStr,_Str)
		THEN
		DebugBreak(_Str);
		
		IF
		TagEvent(_Tag,"GLO_RaceMetaTag")
		AND
		NOT DB_RaceTags(_Tag,_)
		AND
		NOT DB_RaceTags(_,_Tag)
		AND
		NOT DB_RaceTags_NoREALLY(_Tag)
		AND
		GUIDToString(_Tag,_TagStr)
		AND
		Concatenate("Tag in RaceMeta category is not in DB_RaceTags: ",_TagStr,_Str)
		THEN
		DebugBreak(_Str);
	}
	EXIT
	{
	}
}
