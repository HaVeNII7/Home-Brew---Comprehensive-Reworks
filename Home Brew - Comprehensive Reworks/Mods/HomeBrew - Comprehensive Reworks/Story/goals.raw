		DB_SCL_ShadowCurse_CursedCharacters((CHARACTER)S_HAV_Wave0_ShadowCursed_Warrior_Pilgrim_003_1a9b065b-d2cd-44c5-95e4-307d6bd82fe7);
		DB_SCL_ShadowCurse_CursedCharacters((CHARACTER)S_HAV_Wave0_ShadowCursed_Warrior_Pilgrim_005_be15abb7-2ea6-4cf8-bf56-bd8465b570e3);
