		DB_HAV_EnteringHaven_DenVouchers((CHARACTER)S_HAV_FlamingSpy_acb1dd9e-952b-4281-8e30-ec6f671493a6, 0);
		
		DB_Inclusion_Object(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, (FLAG)DEN_ThiefHideoutLeader_Inclusion_Start_5e66d4cf-2bed-d0c1-b003-cfd14b8ad04d, NULL_00000000-0000-0000-0000-000000000000);
		
		DB_CorpseCleanup_Area((TRIGGER)S_HAV_Haven_SUB_6ac001f4-9c56-4a1b-963d-a509e158ffab);
		DB_CorpseCleanup_Area((TRIGGER)S_HAV_Haven_SUB_Cellar_eee18cb6-443a-4b8f-ad19-58dff3d731d8);
		
