		PROC
		PROC_LOW_SWS_Disabled()
		AND
		DB_LOW_SWS_AtWall_Guards(_Guard)
		THEN
		PROC_DisappearOutOfSightTo(_Guard,S_LOW_SWS_AtWall_Pos_Civ_Disappear_001_4d3520ef-9330-4b3c-90bd-cd26b12e1af0,"Walk",0,"");
		
		
		//REGION Combat
		
		IF
		EnteredCombat(_Guard,_)
		AND
		DB_LOW_SWS_AtWall_Guards((CHARACTER)_Guard)
		THEN
		PROC_LOW_SWS_AtWall_DisperseCivs();
		
		PROC
		PROC_LOW_SWS_AtWall_DisperseCivs()
		AND
		DB_LOW_SWS_AtWall_Civilians(_Civ)
		AND
		IsOnStage(_Civ,1)
		THEN
