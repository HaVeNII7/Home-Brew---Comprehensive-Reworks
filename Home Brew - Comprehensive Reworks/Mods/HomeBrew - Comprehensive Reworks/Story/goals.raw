		DB_WorldGossip_RegionTrigger((TRIGGER)S_PartyBanterTrigger_BlightedVillage_0352da9f-04fe-4535-ba9b-9e332060e22c,(FLAG)BANTERREGION_WLD_BlightedVillage_91d68491-16db-4972-af25-a7b9b581b4d8);
