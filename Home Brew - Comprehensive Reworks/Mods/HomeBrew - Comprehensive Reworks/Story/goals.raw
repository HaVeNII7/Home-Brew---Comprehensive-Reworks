		DB_GLO_RapidAD_ADHelper("LOW_BaldursGate_Brainquakes", S_LOW_BaldursGate_RapidAD_Helper_003_e6085c8a-fa53-49e9-aad4-49b1b389c50c, LOW_BaldursGate_AD_RapidMelt_004_5a908c39-7b2c-fd43-5487-ce310fbb0587);
