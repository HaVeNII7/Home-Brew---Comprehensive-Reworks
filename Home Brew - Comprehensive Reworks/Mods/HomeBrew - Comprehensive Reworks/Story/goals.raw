		DB_Debug_GoldenPath_Step(S_Debug_GoldenPath_Step8_7a378591-097c-48a6-b24c-b5850769110e,S_Debug_GoldenPath_Step8_b606f3b9-f735-460e-b592-86e606aaea53,8);
		DB_Debug_GoldenPath_Step(S_Debug_GoldenPath_Step9_f9094048-f7f2-4d8b-9c83-31a94fc66bf7,S_Debug_GoblinThrone_03995572-1deb-447c-ab60-b15f018d1170,9);
		
		DB_Debug_GoldenPath_BasicItems(CONS_Potion_Hill_Giant_Strength_c69fb092-2f4f-4688-82b6-7d92405626b1);
		DB_Debug_GoldenPath_BasicItems(GRN_GreaseBottle_A_e2968a2e-bc83-4d50-99ef-39ce78d2d630);
