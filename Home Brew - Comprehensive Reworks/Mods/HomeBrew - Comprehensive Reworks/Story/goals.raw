		DB_HAV_EnteringHaven_Claws((CHARACTER)S_HAV_CrawlingClaw_007_e6455d59-6f13-4570-b834-4f4ab0918b24);
		DB_HAV_EnteringHaven_Claws((CHARACTER)S_HAV_CrawlingClaw_008_767ac3d2-cb9a-40bb-8769-4ccd92ca54ff);
		DB_HAV_EnteringHaven_Claws((CHARACTER)S_HAV_CrawlingClaw_009_85677d5f-d076-46fc-b006-9458c20d8d26);
