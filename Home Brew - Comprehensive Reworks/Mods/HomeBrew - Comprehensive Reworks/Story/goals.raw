Goal(692).Title("Act3c_OriginMoments_Gale");
Goal(692)
{
	INIT
	{
		DB_GlobalFlagReactionAfterDialog(END_IllithidOptions_Event_TookMomentToChoose_4fc3d679-7bd5-4a2f-9175-4d5c028ed185, END_IllithidOptions_OrpheusFreed_dd0df229-54bf-82cb-9869-a33edb46a57f);
		
	}
	KB
	{
		//REGION ILLITHID OPTIONS WRD
		PROC
		PROC_GlobalFlagReactionAfterDialog(END_IllithidOptions_Event_TadpoleGroupDiscussion_55831e5e-9916-4099-a397-37f5e6967d2e, END_IllithidOptions_Assimilation_f909fcc9-a3dc-b91d-e91c-33f0479c55bb, _ID)
		AND
		NOT DB_GlobalFlag(ORI_Gale_State_SwayedTowardsCrown_76150a10-511d-4eeb-b263-46994bab0b48)
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, (DIALOGRESOURCE)END_IllithidOptions_WRD_GaleBombOption_15e19d29-6c41-cb8a-c961-d7fec9b73e31, NULL_00000000-0000-0000-0000-000000000000, S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, 0, 0);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog(END_IllithidOptions_Event_TookMomentToChoose_4fc3d679-7bd5-4a2f-9175-4d5c028ed185, END_IllithidOptions_OrpheusFreed_dd0df229-54bf-82cb-9869-a33edb46a57f, _ID)
		AND
		NOT DB_GlobalFlag(ORI_Gale_State_SwayedTowardsCrown_76150a10-511d-4eeb-b263-46994bab0b48)
		AND
		DB_RelationshipDialogsFinished(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604,END_IllithidOptions_WRD_GaleBombOption_15e19d29-6c41-cb8a-c961-d7fec9b73e31,NULL_00000000-0000-0000-0000-000000000000)
		THEN
		NOT DB_RelationshipDialogsFinished(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604,END_IllithidOptions_WRD_GaleBombOption_15e19d29-6c41-cb8a-c961-d7fec9b73e31,NULL_00000000-0000-0000-0000-000000000000); //Reset to allow triggering twice
		
		PROC
		PROC_GlobalFlagReactionAfterDialog(END_IllithidOptions_Event_TookMomentToChoose_4fc3d679-7bd5-4a2f-9175-4d5c028ed185, END_IllithidOptions_OrpheusFreed_dd0df229-54bf-82cb-9869-a33edb46a57f, _ID)
		AND
		NOT DB_GlobalFlag(ORI_Gale_State_SwayedTowardsCrown_76150a10-511d-4eeb-b263-46994bab0b48)
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, (DIALOGRESOURCE)END_IllithidOptions_WRD_GaleBombOption_15e19d29-6c41-cb8a-c961-d7fec9b73e31, NULL_00000000-0000-0000-0000-000000000000, S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, 0, 0);
		
		IF
		FlagSet((FLAG)END_IllithidOptions_Event_EmperorBetrayal_411c2575-bfbc-449c-9762-edad4285aafd, _, _)
		THEN
		PROC_CancelRelationshipDialog((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, (DIALOGRESOURCE)END_IllithidOptions_WRD_GaleBombOption_15e19d29-6c41-cb8a-c961-d7fec9b73e31, (FLAG)NULL_00000000-0000-0000-0000-000000000000);
		
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(693).Title("Act3c_OriginMoments_Karlach");
Goal(693)
{
	INIT
	{
		PROC_END_GortashConfrontation_SteelWatcherInit();
	}
	KB
	{
		//REGION Tadpole Choice
		PROC
		PROC_GlobalFlagReactionAfterDialog(END_IllithidOptions_Event_TadpoleGroupDiscussion_55831e5e-9916-4099-a397-37f5e6967d2e, END_IllithidOptions_Assimilation_f909fcc9-a3dc-b91d-e91c-33f0479c55bb, _ID)
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)END_IllithidOptions_WRD_KarlachTadpoleChoice_d3710a76-1807-1a13-5773-f77b00adaeff, NULL_00000000-0000-0000-0000-000000000000, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 0, 0);
		
		IF
		FlagSet((FLAG)END_IllithidOptions_State_ExitPortalAvailable_b97872a1-59cc-40cd-8963-e06be614adc0, _, _)
		THEN
		PROC_CancelRelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)END_IllithidOptions_WRD_KarlachTadpoleChoice_d3710a76-1807-1a13-5773-f77b00adaeff, (FLAG)NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		FlagSet((FLAG)END_IllithidOptions_State_OrpheusIsFree_3b747050-1be0-432e-9de6-e48faa4b74bb, _, _)
		THEN
		PROC_CancelRelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)END_IllithidOptions_WRD_KarlachTadpoleChoice_d3710a76-1807-1a13-5773-f77b00adaeff, (FLAG)NULL_00000000-0000-0000-0000-000000000000);
		//END_REGION
		
		PROC
		PROC_END_GortashConfrontation_SteelWatcherInit()
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Karlach_State_KilledByGortash_d74f8867-9752-45bc-ab54-3177101e8507)
		THEN
		SetOnStage(S_END_SteelWatcherVariant_3a75657b-f356-457a-8a2d-e939adf92862, 0);
		
		// If tag was set with the debug book active block her mindflayer OM from triggering to avoid set up blockers.
		IF
		TagSet(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, FULL_CEREMORPH_3797bfc4-8004-4a19-9578-61ce0714cc0b)
		AND
		DB_DialogName((DIALOGRESOURCE)DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea, _)
		THEN
		DB_Debug_ORI_Karlach_BlockMindflayerDialog(1);
		
		//Karlach becomes mindflayer IPRD
		IF
		TagSet(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, FULL_CEREMORPH_3797bfc4-8004-4a19-9578-61ce0714cc0b)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		NOT DB_Debug_ORI_Karlach_BlockMindflayerDialog(1)
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InPartyEND_84af8609-030b-252c-2335-65d7f410b0e7, (FLAG)ORI_Karlach_IPRD_BecameMindflayer_b90b15b1-15eb-4a73-bbdc-415c4652bef6, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 0);
		
		// Self reflection avatar dialog
		IF
		DB_END_General_PartyMindFlayer(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		DB_Avatars((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		NOT DB_CantTalk(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		NOT DB_ORI_Karlach_MindFlayerSelfReflectionTriggered(1)
		AND
		NOT DB_Debug_ORI_Karlach_BlockMindflayerDialog(1)
		AND
		QRY_StartDialog_Fixed(ORI_Karlach_AvatarTransformsIntoMindflayer_ef7d930a-db5a-e54d-9551-90edb479fa94, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_DialogStarted(ORI_Karlach_AvatarTransformsIntoMindflayer_ef7d930a-db5a-e54d-9551-90edb479fa94, _)
		THEN
		DB_ORI_Karlach_MindFlayerSelfReflectionTriggered(1);
		
		
		// Her keeping her upgrades doesn't make sense since she loses her infernal engine when transformed into a mind flayer. 
		IF
		TagSet(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, FULL_CEREMORPH_3797bfc4-8004-4a19-9578-61ce0714cc0b)
		THEN
		RemoveStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_FIRSTUPGRADE");
		RemoveStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_SECONDUPGRADE");
		
		IF
		TextEvent("ORI_Karlach_TestMindflayerAvatarDialog")
		AND
		DB_Players((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		QRY_StartDialog_Fixed(ORI_Karlach_AvatarTransformsIntoMindflayer_ef7d930a-db5a-e54d-9551-90edb479fa94, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		DB_NOOP(1);
	}
	EXIT
	{
	}
}
Goal(694).Title("Act3c_OriginMoments_Laezel");
Goal(694)
{
	INIT
	{
	}
	KB
	{
		//REGION WRD instead of GD Tadpole Choice
		PROC
		PROC_GlobalFlagReactionAfterDialog(END_IllithidOptions_Event_TadpoleGroupDiscussion_55831e5e-9916-4099-a397-37f5e6967d2e, END_IllithidOptions_Assimilation_f909fcc9-a3dc-b91d-e91c-33f0479c55bb, _ID)
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (DIALOGRESOURCE)END_IllithidOptions_WRD_LaezelTadpoleChoice_6b4dd906-1126-8569-4910-359baefcfb31, NULL_00000000-0000-0000-0000-000000000000, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, 0);
		//END_REGION
		
		//REGION WRD if Emperor is betrayed and leaves
		//If the emperor is forced to escape for any reason before playters get the Supreme Tadpole and Raphael will not appear, Laezel IPRD gets queued up
		PROC
		PROC_END_IllithidOptions_TryRaphaelLastChance()
		AND
		NOT QRY_END_IllithidOptions_RaphaelCanAppear()
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (DIALOGRESOURCE)END_IllithidOptions_WRD_LaezelEmperorBetrayed_935a55b7-31ed-b331-cf91-c4a1780ea6a3, (FLAG)NULL_00000000-0000-0000-0000-000000000000,  S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, 0);
		
		//If the players fail to obtain the Supreme Tadpole and then get the hammer from Raphael, Laezel IPRD gets queued up
		PROC
		PROC_GlobalFlagReactionAfterDialog(END_IllithidOptions_State_AcceptedRaphaelDeal_c4d409ef-d70e-9934-edf2-d6bd66201c19)
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (DIALOGRESOURCE)END_IllithidOptions_WRD_LaezelEmperorBetrayed_935a55b7-31ed-b331-cf91-c4a1780ea6a3, (FLAG)NULL_00000000-0000-0000-0000-000000000000,  S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, 0);
		
		//Dialog no longer relevant once Orpheus is freed
		IF
		FlagSet((FLAG)END_IllithidOptions_State_ExitPortalAvailable_b97872a1-59cc-40cd-8963-e06be614adc0, _, _)
		THEN
		PROC_CancelRelationshipDialog((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (DIALOGRESOURCE)END_IllithidOptions_WRD_LaezelEmperorBetrayed_935a55b7-31ed-b331-cf91-c4a1780ea6a3, (FLAG)NULL_00000000-0000-0000-0000-000000000000);
		PROC_CancelRelationshipDialog((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (DIALOGRESOURCE)END_IllithidOptions_WRD_LaezelTadpoleChoice_6b4dd906-1126-8569-4910-359baefcfb31, (FLAG)NULL_00000000-0000-0000-0000-000000000000);
		
		//END_REGION
	}
	EXIT
	{
	}
}
