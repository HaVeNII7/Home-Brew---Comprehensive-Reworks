		DB_DialogBlockAttackButton((DIALOGRESOURCE)TWN_MarchingArmy_Arrest_17c8a1e6-2855-601f-1dfd-535352e93fd4);
		DB_DialogBlockTradeButton((DIALOGRESOURCE)TWN_MarchingArmy_Arrest_17c8a1e6-2855-601f-1dfd-535352e93fd4);
		
		DB_TWN_MarchingArmy_CrowdTriggers((TRIGGER)S_MarchingArmyCrowd_001_489c7c59-0879-40df-814a-5ea7112f0942);
		DB_TWN_MarchingArmy_CrowdTriggers((TRIGGER)S_MarchingArmyCrowd_002_e39f2244-5ca2-4959-aaf2-f376ec38e783);
