Goal(514).Title("Act3_GLO_Orpheus_Journal");
Goal(514)
{
	INIT
	{
		//REGION Free Orpheus
		
		DB_QuestDef_State_ConditionalFlag((FLAG)GLO_Orpheus_Knows_OrphicHammerIsTheKey_980541fb-1483-ea1a-3387-64405eace9a2, "GLO_FreeOrpheus", "LearnedAboutHammer_InHouse", 1, (FLAG)LOW_HouseOfHope_State_VisitedHouseOfHope_c8889a79-8277-48e9-afa0-e14f6359ea10);
		
		// A part of Free Orpheus quest where players need to steal the Hammer: it should be active only if players know about the Orphic Hammer and it should be removed if the deal is made
		DB_GEN_FreeOrpheus_SetConditionalUpdatesInHouse((FLAG)LOW_HouseOfHope_Knows_MasterKeyword_e18062be-03c7-7249-bca2-e7a71159020a, "GLO_FreeOrpheus", "GotMasterKeyword_DidntSeeHammer", 0, (FLAG)LOW_HouseOfHope_Event_SawMainTreasures_3a0552ac-db09-4f61-93d6-2c6f3be90d46);
		DB_GEN_FreeOrpheus_SetConditionalUpdatesInHouse((FLAG)LOW_HouseOfHope_Knows_MasterKeyword_e18062be-03c7-7249-bca2-e7a71159020a, "GLO_FreeOrpheus", "GotMasterKeyword_SawHammer", 1, (FLAG)LOW_HouseOfHope_Event_SawMainTreasures_3a0552ac-db09-4f61-93d6-2c6f3be90d46);
		DB_GEN_FreeOrpheus_SetUpdatesInHouse((FLAG)LOW_HouseOfHope_Event_SawMainTreasures_3a0552ac-db09-4f61-93d6-2c6f3be90d46, "GLO_FreeOrpheus", "SawHammerInField");
		DB_GEN_FreeOrpheus_SetUpdatesInHouse((FLAG)LOW_HouseOfHope_Archivist_Event_ToldWherePassword_8dd842f4-a33c-2308-b3f0-c049b4cbc540, "GLO_FreeOrpheus", "GotDirectionsFromArchivist");
		DB_GEN_FreeOrpheus_SetConditionalUpdatesInHouse((FLAG)LOW_HouseOfHope_Event_SawMainTreasures_3a0552ac-db09-4f61-93d6-2c6f3be90d46,  "GLO_FreeOrpheus", "SawHammerInField_HaveKeyword", 1, (FLAG)LOW_HouseOfHope_Knows_MasterKeyword_e18062be-03c7-7249-bca2-e7a71159020a);
		DB_GEN_FreeOrpheus_SetUpdatesInHouse((FLAG)LOW_HouseOfHope_State_HammerIsStolen_1b248e8d-fef1-4671-aa55-afd0e34c2682, "GLO_FreeOrpheus", "StoleOrphicHammer");
		//
		
		DB_QuestDef_State((FLAG)GLO_Monitor_State_MadeDeal_86f40f63-0bfa-4ab6-b3b0-d01475c3cbdc, "GLO_FreeOrpheus", "MadeDeal");
		DB_QuestDef_State_ConditionalFlag((FLAG)END_General_State_CurrentlyInAstralPlane_b3cf6c91-4d1c-4dcf-bc57-262f7d0f02b9, "GLO_FreeOrpheus", "EnteredAstralPlane", 1, (FLAG)END_IllithidOptions_State_ArrivedWithOrphicHammer_a350e277-55a7-4e03-9c14-db154b6c682e);
		DB_QuestDef_State_ConditionalFlag((FLAG)END_General_State_CurrentlyInAstralPlane_b3cf6c91-4d1c-4dcf-bc57-262f7d0f02b9, "GLO_FreeOrpheus", "EnteredAstralPlane_NoHammer", 0, (FLAG)END_IllithidOptions_State_ArrivedWithOrphicHammer_a350e277-55a7-4e03-9c14-db154b6c682e);
		
		DB_QuestDef_State_ConditionalFlag((FLAG)END_IllithidOptions_State_AcceptedRaphaelDeal_c4d409ef-d70e-9934-edf2-d6bd66201c19, "GLO_FreeOrpheus", "RaphaelGaveLastChance", 0, (FLAG)GLO_Monitor_State_MadeDeal_86f40f63-0bfa-4ab6-b3b0-d01475c3cbdc);
		DB_QuestDef_State_ConditionalFlag((FLAG)END_IllithidOptions_State_AcceptedRaphaelDeal_c4d409ef-d70e-9934-edf2-d6bd66201c19, "GLO_FreeOrpheus", "RaphaelReturnedHammer", 1, (FLAG)GLO_Monitor_State_MadeDeal_86f40f63-0bfa-4ab6-b3b0-d01475c3cbdc);
		
		DB_QuestDef_State((FLAG)END_IllithidOptions_State_OrpheusIsFree_3b747050-1be0-432e-9de6-e48faa4b74bb, "GLO_FreeOrpheus", "SmashedChains");
		DB_QuestDef_State((FLAG)END_IllithidOptions_State_AssimilatedOrpheus_5562cc3f-c168-48c9-87c1-1598a5c58961, "GLO_FreeOrpheus", "AssimilatedOrpheus");
		//END_REGION
		
		//REGION Deal with the Devil
		
		DB_QuestDef_State_ConditionalFlag((FLAG)WYR_RaphaelTango_Warlock_State_Talked_07639773-0bcd-8536-53ca-d025c1a6988a, "GLO_RaphaelDeal", "GotKorrillaInvitation", 1, (FLAG)GLO_Warlock_State_InSharessCaress_e3682219-f9b6-482f-9419-cc2adaf037c0);
		DB_QuestDef_State_ConditionalFlag((FLAG)WYR_RaphaelTango_Warlock_State_Talked_07639773-0bcd-8536-53ca-d025c1a6988a, "GLO_RaphaelDeal", "GotKorrillaElfsongInvitation", 1, (FLAG)GLO_Warlock_State_InElfsongTavern_05c25ac8-f10f-49f1-8d7e-c0c48d6772c9);
		DB_QuestDef_State_ConditionalFlag((FLAG)WYR_SharessCaress_Knows_RaphaelInSharess_63e92afc-0fad-0d53-fa28-b995cadf9d68, "GLO_RaphaelDeal", "GotMamzellInvitation", 0, (FLAG)WYR_RaphaelTango_Warlock_State_Talked_07639773-0bcd-8536-53ca-d025c1a6988a);
		
		DB_QuestDef_State((FLAG)GLO_Monitor_State_MadeDeal_86f40f63-0bfa-4ab6-b3b0-d01475c3cbdc, "GLO_RaphaelDeal", "MadeDeal");
		DB_QuestDef_State((FLAG)WYR_RaphaelTango_Warlock_DiabolistHint_f1dc232a-e053-f624-ded9-187ddfad9008, "GLO_RaphaelDeal", "TalkedToKorrillaAfterDeal");
		
		DB_QuestDef_State((FLAG)LOW_HouseOfHope_State_ContractIsDestroyed_1a51a77c-d549-4d50-95df-97ab9d1ef9f6, "GLO_RaphaelDeal", "DestroyedContract");
		
		DB_QuestDef_State((FLAG)LOW_HouseOfHope_State_VisitedHouseOfHope_c8889a79-8277-48e9-afa0-e14f6359ea10, "GLO_RaphaelDeal", "EnteredHouseOfHope");
		
		//END_REGION
		
		//REGION Deal with the Devil - Fulfill Deal
		
		DB_QuestDef_ChainedState("GLO_RaphaelDeal", "MadeDeal", "GLO_RaphaelDeal", "MadeDeal_Fulfill");
		DB_QuestDef_ChainedState("GLO_RaphaelDeal", "DestroyedContract", "GLO_RaphaelDeal", "DestroyedContract_Fulfill");
		
		//END_REGION
		
		//REGION Deal with the Devil - Avoid Deal
		DB_QuestDef_ChainedState("GLO_RaphaelDeal", "MadeDeal", "GLO_RaphaelDeal", "MadeDeal_Avoid");
		
		DB_QuestDef_State((FLAG)LOW_HouseOfHope_Knows_TreasureInArchive_b213dfe2-6afb-9772-d748-9ba9430a6aae, "GLO_RaphaelDeal", "GotHopeHelp");
		DB_QuestDef_State_ConditionalFlag((FLAG)LOW_HouseOfHope_Knows_MasterKeyword_e18062be-03c7-7249-bca2-e7a71159020a, "GLO_RaphaelDeal", "GotMasterKeyword_DidntSeeContract", 0, (FLAG)LOW_HouseOfHope_Event_SawMainTreasures_3a0552ac-db09-4f61-93d6-2c6f3be90d46);
		DB_QuestDef_State_ConditionalFlag((FLAG)LOW_HouseOfHope_Knows_MasterKeyword_e18062be-03c7-7249-bca2-e7a71159020a, "GLO_RaphaelDeal", "GotMasterKeyword_SawContract", 1, (FLAG)LOW_HouseOfHope_Event_SawMainTreasures_3a0552ac-db09-4f61-93d6-2c6f3be90d46);
		DB_QuestDef_State((FLAG)LOW_HouseOfHope_Event_SawMainTreasures_3a0552ac-db09-4f61-93d6-2c6f3be90d46, "GLO_RaphaelDeal", "SawContractInField");
		DB_QuestDef_State((FLAG)LOW_HouseOfHope_Archivist_Event_ToldWherePassword_8dd842f4-a33c-2308-b3f0-c049b4cbc540, "GLO_RaphaelDeal", "GotDirectionsFromArchivist");
		DB_QuestDef_State_ConditionalFlag((FLAG)LOW_HouseOfHope_Event_SawMainTreasures_3a0552ac-db09-4f61-93d6-2c6f3be90d46,  "GLO_RaphaelDeal", "SawContractInField_HaveKeyword", 1, (FLAG)LOW_HouseOfHope_Knows_MasterKeyword_e18062be-03c7-7249-bca2-e7a71159020a);
		DB_QuestDef_ChainedState("GLO_RaphaelDeal", "DestroyedContract", "GLO_RaphaelDeal", "DestroyedContract_Avoid");
		
		DB_QuestDef_LevelLoaded("GLO_RaphaelDeal", "ReachedEnd", "END_Main");
		
		//END_REGION
		
		//REGION Helsik books
		DB_GEN_DealWithDevil_GortashNotes((ITEMROOT)UNI_BOOK_LOW_GortashHome_LettersBook_960378af-2689-42d3-9f82-c075eff02bb9);
		DB_GEN_DealWithDevil_GortashNotes((ITEMROOT)BOOK_LOW_DevilsFee_ReportActivitesEnverGortash_09d22fe2-20f9-4568-b891-140a595f0bff);
		DB_GEN_DealWithDevil_GortashNotes((ITEMROOT)BOOK_LOW_DevilsFee_ObserversReport_aa021f7f-d134-4e79-b20a-b3fe248c8e7c);
		
		DB_GEN_DealWithDevil_HelsikNotes((ITEMROOT)BOOK_LOW_DevilsFee_DiabolistLetter_Ninefingers_63f6945c-0f59-444d-b6f0-b22340b51e38);
		
		//END_REGION
	}
	KB
	{
		//REGION Quest before House of Hope
		IF
		FlagSet((FLAG)GLO_Orpheus_Knows_OrphicHammerIsTheKey_980541fb-1483-ea1a-3387-64405eace9a2,_,_)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_HouseOfHope_State_VisitedHouseOfHope_c8889a79-8277-48e9-afa0-e14f6359ea10)
		THEN
		QuestUpdate("GLO_FreeOrpheus", "LearnedAboutHammer");
		DB_GEN_FreeOrpheus_QuestStartedBeforeHouse(1);
		
		IF
		DialogEnded((DIALOGRESOURCE)CAMP_Orthon_DiabolistHint_698c239b-4a50-95c7-c9b5-02f1adfa0098,_)
		THEN
		DB_GEN_FreeOrpheus_LearnedAboutHelsik(1);
		DB_GEN_FreeOrpheus_UpdatesBeforeHouse("OrthonTalkedInCamp");
		DB_GEN_DealWithDevil_UpdatesBeforeHouse("OrthonTalkedInCamp");
		
		IF
		TemplateUseFinished(_,_GortashNote,_,1)
		AND
		NOT DB_GEN_FreeOrpheus_LearnedAboutHelsik(1)
		AND
		DB_GEN_DealWithDevil_GortashNotes(_GortashNote)
		THEN
		DB_GEN_FreeOrpheus_LearnedAboutHelsik(1);
		DB_GEN_FreeOrpheus_UpdatesBeforeHouse("FoundGortashLinkNote");
		DB_GEN_DealWithDevil_UpdatesBeforeHouse("FoundGortashLinkNote");
		
		IF
		TemplateUseFinished(_,_HelsikNote,_,1)
		AND
		NOT DB_GEN_FreeOrpheus_LearnedAboutHelsik(1)
		AND
		DB_GEN_DealWithDevil_HelsikNotes(_HelsikNote)
		THEN
		DB_GEN_FreeOrpheus_LearnedAboutHelsik(1);
		DB_GEN_FreeOrpheus_UpdatesBeforeHouse("FoundHelsikNote");
		DB_GEN_DealWithDevil_UpdatesBeforeHouse("FoundHelsikNote");
		
		IF
		UseFinished(_, (ITEM)S_WYR_RaphaelTango_WarlockRecords_aa42c2a0-2ddd-400e-9cb2-32a7f5f796b6, 1)
		AND
		NOT DB_GEN_FreeOrpheus_LearnedAboutHelsik(1)
		THEN
		DB_GEN_FreeOrpheus_LearnedAboutHelsik(1);
		DB_GEN_FreeOrpheus_UpdatesBeforeHouse("FoundGortashLinkNote");
		DB_GEN_DealWithDevil_UpdatesBeforeHouse("FoundGortashLinkNote");
		
		IF
		FlagSet((FLAG)LOW_Helsik_Know_RevealedAsDiabolist_89e8e322-a263-2b13-d6c3-0e44a555a385,_,_)
		AND
		NOT DB_GEN_FreeOrpheus_LearnedAboutHelsik(1)
		THEN
		DB_GEN_FreeOrpheus_UpdatesBeforeHouse("UncoveredDevilsFeeSecrets");
		DB_GEN_DealWithDevil_UpdatesBeforeHouse("UncoveredDevilsFeeSecrets");
		
		IF
		FlagSet((FLAG)LOW_DevilsFee_Event_GettingGrimoire_d393fe51-7232-483c-baa0-95e9bd5a7267,_,_)
		THEN
		DB_GEN_FreeOrpheus_UpdatesBeforeHouse("ReceivedGrimoire");
		DB_GEN_DealWithDevil_UpdatesBeforeHouse("ReceivedGrimoire");
		
		IF
		FlagSet((FLAG)LOW_DevilsFee_Event_GettingGrimoire_d393fe51-7232-483c-baa0-95e9bd5a7267,_,_)
		THEN
		DB_GEN_FreeOrpheus_GrimoireUpdate(1);
		DB_GEN_FreeOrpheus_UpdatesBeforeHouse("ReceivedGrimoire");
		DB_GEN_DealWithDevil_UpdatesBeforeHouse("ReceivedGrimoire");
		
		IF
		UseFinished(_, (ITEM)S_LOW_DevilsFee_GrimoireRitual_7a24e183-1870-47b8-add2-720db3bd3758, _)
		AND
		NOT DB_GEN_FreeOrpheus_GrimoireUpdate(1)
		THEN
		DB_GEN_FreeOrpheus_UpdatesBeforeHouse("StoleGrimoire");
		DB_GEN_DealWithDevil_UpdatesBeforeHouse("StoleGrimoire");
		
		IF
		FlagSet((FLAG)LOW_DevilsFee_Event_OpeningPortal_4dfbe814-2457-40ae-bead-b997d0724af2,_,_)
		THEN
		DB_GEN_FreeOrpheus_UpdatesBeforeHouse("RitualCompleted");
		DB_GEN_DealWithDevil_UpdatesBeforeHouse("RitualCompleted");
		
		IF
		FlagSet((FLAG)LOW_HouseOfHope_State_VisitedHouseOfHope_c8889a79-8277-48e9-afa0-e14f6359ea10,_,_)
		THEN
		DB_GEN_FreeOrpheus_UpdatesBeforeHouse("EnteredHouse");
		DB_GEN_DealWithDevil_UpdatesBeforeHouse("EnteredHouse");
		
		IF
		DB_GEN_FreeOrpheus_QuestStartedBeforeHouse(1)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_Monitor_State_MadeDeal_86f40f63-0bfa-4ab6-b3b0-d01475c3cbdc)
		AND
		DB_GEN_FreeOrpheus_UpdatesBeforeHouse(_Update)
		THEN
		QuestUpdate("GLO_FreeOrpheus", _Update);
		 
		IF
		DB_GEN_DealWithDevil_UpdatesBeforeHouse(_Update)
		THEN
		QuestUpdate("GLO_RaphaelDeal", _Update);
		
		//END_REGION
		
		//REGION Quests in House of Hope
		
		IF
		FlagSet((FLAG)GLO_Orpheus_Knows_OrphicHammerIsTheKey_980541fb-1483-ea1a-3387-64405eace9a2,_,_)
		THEN
		PROC_GEN_FreeOrpheus_SetUpdatesInHouse();
		
		PROC
		PROC_GEN_FreeOrpheus_SetUpdatesInHouse()
		AND
		DB_GEN_FreeOrpheus_SetUpdatesInHouse(_Flag, _Quest, _Step)
		THEN
		DB_QuestDef_State(_Flag, _Quest, _Step);
		
		PROC
		PROC_GEN_FreeOrpheus_SetUpdatesInHouse()
		AND
		DB_GEN_FreeOrpheus_SetConditionalUpdatesInHouse(_Flag, _Quest, _Step, _State, _ConditionalFlag)
		THEN
		DB_QuestDef_State_ConditionalFlag(_Flag, _Quest, _Step, _State, _ConditionalFlag);
		
		// Removing quest updates for Free Orpheus quest that we don't need after making the deal
		IF
		FlagSet((FLAG)GLO_Monitor_State_MadeDeal_86f40f63-0bfa-4ab6-b3b0-d01475c3cbdc, _,_)
		THEN
		PROC_GEN_FreeOrpheus_RemoveUpdatesInHouse();
		
		IF
		GameBookInterfaceClosed((ITEM)UNI_BOOK_LOW_HoH_SecurityBreachReport_90e80285-7495-8ddb-5ea3-cd14f5920dd6, _)
		AND
		NOT DB_GEN_DealWithDevil_LearnedAboutBoudoir(1)
		THEN
		DB_GEN_DealWithDevil_LearnedAboutBoudoir(1);
		
		IF
		GameBookInterfaceClosed((ITEM)S_LOW_HouseOfHope_BoudoirKey_b54922ae-91cd-4cc4-b9bf-4de932ee5b8c, _)
		AND
		NOT DB_GEN_DealWithDevil_LearnedAboutBoudoir(1)
		THEN
		DB_GEN_DealWithDevil_LearnedAboutBoudoir(1);
		
		IF
		DB_GEN_DealWithDevil_LearnedAboutBoudoir(1)
		AND
		DB_GlobalFlag(LOW_HouseOfHope_Event_SawMainTreasures_3a0552ac-db09-4f61-93d6-2c6f3be90d46)
		AND
		NOT DB_GlobalFlag(LOW_HouseOfHope_Archivist_Event_ToldWherePassword_8dd842f4-a33c-2308-b3f0-c049b4cbc540)
		AND
		NOT DB_GlobalFlag(GLO_Monitor_State_MadeDeal_86f40f63-0bfa-4ab6-b3b0-d01475c3cbdc)
		THEN
		QuestUpdate("GLO_FreeOrpheus", "LearnedAboutBoudoir");
		
		IF
		DB_GEN_DealWithDevil_LearnedAboutBoudoir(1)
		AND
		DB_GlobalFlag(LOW_HouseOfHope_Event_SawMainTreasures_3a0552ac-db09-4f61-93d6-2c6f3be90d46)
		AND
		NOT DB_GlobalFlag(LOW_HouseOfHope_Archivist_Event_ToldWherePassword_8dd842f4-a33c-2308-b3f0-c049b4cbc540)
		AND
		DB_GlobalFlag(GLO_Monitor_State_MadeDeal_86f40f63-0bfa-4ab6-b3b0-d01475c3cbdc)
		THEN
		QuestUpdate("GLO_RaphaelDeal", "LearnedAboutBoudoir");
		
		IF
		FlagSet((FLAG)LOW_HouseOfHope_Archivist_Event_ToldWherePassword_8dd842f4-a33c-2308-b3f0-c049b4cbc540,_,_)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_HouseOfHope_Event_SawMainTreasures_3a0552ac-db09-4f61-93d6-2c6f3be90d46)
		THEN
		SetFlag((FLAG)LOW_HouseOfHope_Event_SawMainTreasures_3a0552ac-db09-4f61-93d6-2c6f3be90d46);
		
		PROC
		PROC_GEN_FreeOrpheus_RemoveUpdatesInHouse()
		AND
		DB_GEN_FreeOrpheus_SetUpdatesInHouse(_Flag, _Quest, _Step)
		THEN
		NOT DB_QuestDef_State(_Flag, _Quest, _Step);
		
		PROC
		PROC_GEN_FreeOrpheus_RemoveUpdatesInHouse()
		AND
		DB_GEN_FreeOrpheus_SetConditionalUpdatesInHouse(_Flag, _Quest, _Step, _State, _ConditionalFlag)
		THEN
		NOT DB_QuestDef_State_ConditionalFlag(_Flag, _Quest, _Step, _State, _ConditionalFlag);
		
		// Adding important knowledge after learning about the Orphic Hammer
		IF
		FlagSet((FLAG)GLO_Orpheus_Knows_OrphicHammerIsTheKey_980541fb-1483-ea1a-3387-64405eace9a2,_,_)
		AND
		DB_GlobalFlag((FLAG)LOW_HouseOfHope_Knows_TreasureInArchive_b213dfe2-6afb-9772-d748-9ba9430a6aae)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_HouseOfHope_Event_SawMainTreasures_3a0552ac-db09-4f61-93d6-2c6f3be90d46)
		THEN
		QuestUpdate("GLO_FreeOrpheus", "GotHopeHelp");
		
		IF
		FlagSet((FLAG)GLO_Orpheus_Knows_OrphicHammerIsTheKey_980541fb-1483-ea1a-3387-64405eace9a2,_,_)
		AND
		DB_GlobalFlag((FLAG)LOW_HouseOfHope_Event_SawMainTreasures_3a0552ac-db09-4f61-93d6-2c6f3be90d46)
		THEN
		QuestUpdate("GLO_FreeOrpheus", "SawHammerInField");
		
		// Handling "GotHopeHelp"
		
		IF
		FlagSet((FLAG)LOW_HouseOfHope_Knows_TreasureInArchive_b213dfe2-6afb-9772-d748-9ba9430a6aae,_,_)
		AND
		DB_GlobalFlag((FLAG)GLO_Orpheus_Knows_OrphicHammerIsTheKey_980541fb-1483-ea1a-3387-64405eace9a2)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_HouseOfHope_Event_SawMainTreasures_3a0552ac-db09-4f61-93d6-2c6f3be90d46)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_HouseOfHope_Knows_MasterKeyword_e18062be-03c7-7249-bca2-e7a71159020a)
		THEN
		QuestUpdate("GLO_FreeOrpheus", "GotHopeHelp");
		
		
		IF
		DB_LOW_HouseOfHope_UnlockTreasures(1)
		AND 
		NOT DB_GlobalFlag((FLAG)GLO_Monitor_State_MadeDeal_86f40f63-0bfa-4ab6-b3b0-d01475c3cbdc)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_Monitor_State_PermaDefeated_92f6d5f6-86af-4339-ad8a-da9d629f0dae)
		THEN
		QuestUpdate("GLO_FreeOrpheus", "RemovedMagicField");
		
		IF
		DB_LOW_HouseOfHope_UnlockTreasures(1)
		AND 
		DB_GlobalFlag((FLAG)GLO_Monitor_State_MadeDeal_86f40f63-0bfa-4ab6-b3b0-d01475c3cbdc)
		THEN
		QuestUpdate("GLO_RaphaelDeal", "RemovedMagicField");
		
		PROC
		PROC_LOW_HouseOfHope_RaphaelGoesHostile()
		AND 
		NOT DB_GlobalFlag((FLAG)GLO_Monitor_State_MadeDeal_86f40f63-0bfa-4ab6-b3b0-d01475c3cbdc)
		AND
		DB_GlobalFlag((FLAG)LOW_HouseOfHope_State_HammerIsStolen_1b248e8d-fef1-4671-aa55-afd0e34c2682)
		THEN
		QuestUpdate("GLO_FreeOrpheus", "EncounteredRaphael");
		
		
		PROC
		PROC_LOW_HouseOfHope_RaphaelGoesHostile()
		THEN
		QuestUpdate("GLO_RaphaelDeal", "EncounteredRaphael");
		
		PROC
		PROC_LOW_HouseOfHope_Postmortem()
		AND 
		NOT DB_GlobalFlag((FLAG)GLO_Monitor_State_MadeDeal_86f40f63-0bfa-4ab6-b3b0-d01475c3cbdc)
		AND
		DB_GlobalFlag((FLAG)LOW_HouseOfHope_State_HammerIsStolen_1b248e8d-fef1-4671-aa55-afd0e34c2682)
		THEN
		QuestUpdate("GLO_FreeOrpheus", "DefeatedRaphael");
		
		PROC
		PROC_LOW_HouseOfHope_Postmortem()
		THEN
		NOT DB_QuestDef_State_ConditionalFlag((FLAG)END_General_State_CurrentlyInAstralPlane_b3cf6c91-4d1c-4dcf-bc57-262f7d0f02b9, "GLO_FreeOrpheus", "EnteredAstralPlane_NoHammer", 0, (FLAG)END_IllithidOptions_State_ArrivedWithOrphicHammer_a350e277-55a7-4e03-9c14-db154b6c682e);
		DB_QuestDef_State_ConditionalFlag((FLAG)END_General_State_CurrentlyInAstralPlane_b3cf6c91-4d1c-4dcf-bc57-262f7d0f02b9, "GLO_FreeOrpheus", "LostHammer", 0, (FLAG)END_IllithidOptions_State_ArrivedWithOrphicHammer_a350e277-55a7-4e03-9c14-db154b6c682e);
		
		PROC
		PROC_LOW_HouseOfHope_Postmortem()
		AND 
		NOT DB_GlobalFlag((FLAG)GLO_Monitor_State_MadeDeal_86f40f63-0bfa-4ab6-b3b0-d01475c3cbdc)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_HouseOfHope_State_HammerIsStolen_1b248e8d-fef1-4671-aa55-afd0e34c2682)
		THEN
		QuestUpdate("GLO_FreeOrpheus", "DefeatedRaphael_NoHammer");
		PROC_GEN_FreeOrpheus_RemoveUpdatesInHouse();
		DB_QuestDef_State((FLAG)LOW_HouseOfHope_State_HammerIsStolen_1b248e8d-fef1-4671-aa55-afd0e34c2682, "GLO_FreeOrpheus", "StoleOrphicHammer_RaphaelDefeated");
		
		
		PROC
		PROC_LOW_HouseOfHope_Postmortem()
		THEN
		QuestUpdate("GLO_RaphaelDeal", "DefeatedRaphael");
		
		
		
		//END_REGION
		
		//REGION Deal with the Devil intro
		
		// We don't need an updates from Korrilla at this point
		IF
		FlagSet((FLAG)WYR_RaphaelTango_Event_BeganSoloScene_1048973a-9ed0-89e5-ce68-11e03fafc22c,_,_)
		THEN
		NOT DB_QuestDef_State_ConditionalFlag((FLAG)WYR_RaphaelTango_Warlock_State_Talked_07639773-0bcd-8536-53ca-d025c1a6988a, "GLO_RaphaelDeal", "GotKorrillaInvitation", 1, (FLAG)GLO_Warlock_State_InSharessCaress_e3682219-f9b6-482f-9419-cc2adaf037c0);
		NOT DB_QuestDef_State_ConditionalFlag((FLAG)WYR_RaphaelTango_Warlock_State_Talked_07639773-0bcd-8536-53ca-d025c1a6988a, "GLO_RaphaelDeal", "GotKorrillaElfsongInvitation", 1, (FLAG)GLO_Warlock_State_InElfsongTavern_05c25ac8-f10f-49f1-8d7e-c0c48d6772c9);
		NOT DB_QuestDef_State_ConditionalFlag((FLAG)WYR_SharessCaress_Knows_RaphaelInSharess_63e92afc-0fad-0d53-fa28-b995cadf9d68, "GLO_RaphaelDeal", "GotMamzellInvitation", 0, (FLAG)WYR_RaphaelTango_Warlock_State_Talked_07639773-0bcd-8536-53ca-d025c1a6988a);
		
		IF
		DialogEnded((DIALOGRESOURCE)WYR_RaphaelTango_Raphael_SoloScene_e95ac422-e05d-f119-68fd-e382d71f7c79, _)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_Orpheus_Knows_OrphicHammerIsTheKey_980541fb-1483-ea1a-3387-64405eace9a2)
		THEN
		DB_GEN_DealWithDevil_DidntListenRaphael(1);
		QuestUpdate("GLO_RaphaelDeal", "DidntListenRaphael");
		
		IF
		FlagSet((FLAG)GLO_Orpheus_Knows_OrphicHammerIsTheKey_980541fb-1483-ea1a-3387-64405eace9a2,_,_)
		AND
		DB_GEN_DealWithDevil_DidntListenRaphael(1)
		THEN
		QuestUpdate("GLO_RaphaelDeal", "ReturnedToRaphael");
		
		IF
		FlagSet((FLAG)GLO_Orpheus_Knows_OrphicHammerIsTheKey_980541fb-1483-ea1a-3387-64405eace9a2,_,_)
		AND
		NOT DB_GEN_DealWithDevil_DidntListenRaphael(1)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_HouseOfHope_State_VisitedHouseOfHope_c8889a79-8277-48e9-afa0-e14f6359ea10)
		THEN
		QuestUpdate("GLO_RaphaelDeal", "TalkedToRaphael");
		
		IF
		DialogEnded((DIALOGRESOURCE)WYR_RaphaelTango_Raphael_SoloScene_e95ac422-e05d-f119-68fd-e382d71f7c79, _)
		AND
		DB_GlobalFlag((FLAG)GLO_Orpheus_Knows_OrphicHammerIsTheKey_980541fb-1483-ea1a-3387-64405eace9a2)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_Monitor_State_MadeDeal_86f40f63-0bfa-4ab6-b3b0-d01475c3cbdc)
		THEN
		QuestUpdate("GLO_RaphaelDeal", "RefusedDeal");
		
		
		IF
		FlagSet((FLAG)LOW_HouseOfHope_State_VisitedHouseOfHope_c8889a79-8277-48e9-afa0-e14f6359ea10,_,_)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_Monitor_State_MadeDeal_86f40f63-0bfa-4ab6-b3b0-d01475c3cbdc)
		THEN
		TriggerRegisterForPlayers((TRIGGER)S_WYR_RaphaelTango_RoomArea_Journal_a0724e60-4f4e-414f-98bd-c4e372b73692);
		
		IF
		EnteredTrigger(_, (TRIGGER)S_WYR_RaphaelTango_RoomArea_Journal_a0724e60-4f4e-414f-98bd-c4e372b73692)
		THEN
		TriggerUnregisterForPlayers((TRIGGER)S_WYR_RaphaelTango_RoomArea_Journal_a0724e60-4f4e-414f-98bd-c4e372b73692);
		QuestUpdate("GLO_RaphaelDeal", "BetrayedRaphael_Upd");
		
		PROC
		PROC_WYR_RaphaelTango_Retreat()
		AND
		NOT DB_GlobalFlag((FLAG)GLO_Monitor_State_MadeDeal_86f40f63-0bfa-4ab6-b3b0-d01475c3cbdc)
		THEN
		QuestUpdate("GLO_RaphaelDeal", "AngriedRaphael");
		
		
		//END_REGION
		
		//REGION Finale
		IF
		DialogStarted((DIALOGRESOURCE)END_GameFinale_RaphaelCrownUpdate_b7ee667d-d550-7115-37f3-ce900ca80cbd,_)
		THEN
		QuestUpdate("GLO_RaphaelDeal", "GaveCrown_Fulfill");
		QuestUpdate("GLO_RaphaelDeal", "GaveCrown");
		//END_REGION
	}
	EXIT
	{
	}
}
