		THEN
		DB_DebugBookEntry_Temp("Gale","Act 1","Obtain Magical Artifacts","Make Gale Want another Item","Gale_MakeHimWantAnother",0);
		
		
		PROC
		PROC_DebugBook_AddConditionalEntries((CHARACTER)_Player)
