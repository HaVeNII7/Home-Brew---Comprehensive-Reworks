	}
	KB
	{
		//REGION Flaming Fists and Civilians
		//The flaming fist spots us.
		PROC
		PROC_SpotPlayers_Spotted(_Spotter, "LOW_BaldursGate_GuardsSpotting", (CHARACTER)_Target)
		AND
		DB_Players(_Target)
		AND
		QRY_StartDialog((DIALOGRESOURCE)LOW_BaldursGate_FlamingFists_BeforeMainDoor_73990848-a5d4-bf61-bcb5-ca7eb53e86d3, (CHARACTER)S_LOW_BaldursGate_FlamingFist_Cleric_001_f61ed726-793d-4611-a234-ad5a6b487514,
			S_LOW_BaldursGate_FlamingFist_Ranger_001_08d0dcec-a5c3-4099-922c-2a0b8b97fcd6, _Target)
		THEN
		DB_NOOP(1);
		//END_REGION
		
		//REGION Teleport out of danger and brainquakes
		
		IF
		UseStarted(_Player, S_LOW_BaldursGate_Gate_3b44a2e3-e33d-48e7-9ac4-62480ff48bc8)
		AND
		DB_Players(_Player)
		AND
		NOT QRY_StartDialog_Fixed((DIALOGRESOURCE)LOW_BaldursGate_DoorDialog_0d7628e0-b800-a7e0-fbd5-966e42edab98, S_LOW_BaldursGate_ElderBrain_Helper_877f2eb3-586f-4660-bea5-333d00c3ea92, _Player)
		THEN
		PROC_PlayCantUseItemAD(_Player);
		
		IF
		EnteredTrigger(_Player, S_LOW_BaldursGate_Lvl3Warning_003_23ac5522-cbac-4da2-b890-92f1cd3dd363)
		AND
		DB_Players(_Player)
		AND
		IsTagged(_Player, (TAG)ILLITHID_1eec74e8-3673-4500-abec-57b7ed8469ed, 1)
		THEN
		ScreenFadeTo(_Player, 1.5, 1, "LOW_BaldursGate_TeleportParty");
		DB_LOW_BaldursGate_FadeEvent(_Player, "LOW_BaldursGate_TeleportParty");
		
		IF
		EnteredTrigger(_Player, _Trigger)
		AND
		IsTagged(_Player, (TAG)ILLITHID_1eec74e8-3673-4500-abec-57b7ed8469ed, 1)
		AND
		DB_Players(_Player)
		AND
		DB_LOW_BaldursGate_WarningTriggers(_Dialog, _Trigger)
		THEN
		PROC_EmperorAD(_Player, _Dialog);
		
		IF
		ScreenFadeDone(_, _FadeID)
		AND
		DB_LOW_BaldursGate_FadeEvent(_Player, _FadeID)
		THEN
		TeleportTo(_Player, S_LOW_BaldursGate_Lvl1Warning_fbbefd03-3745-4374-bc87-8b1cb42fd3e1, "", 1, 1, 1, 0, 1);
		NOT DB_LOW_BaldursGate_FadeEvent(_Player, _FadeID);
		ClearScreenFade(_Player, 1.5, "LOW_BaldursGate_TeleportParty");
		PROC_LOW_BaldursGate_WarningEventsSetup();
		
		PROC
		PROC_LOW_BaldursGate_WarningEventsSetup()
		THEN
