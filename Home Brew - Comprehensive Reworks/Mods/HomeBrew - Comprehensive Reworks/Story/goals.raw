		DB_QuestDef_State((FLAG)LOW_SteelWatchFoundry_State_KillSwitchKilledGondians_8930425e-fa90-41b2-a222-67eacf8753f5, "LOW_SaveGondians","AllGondiansDead_BySwitch");
