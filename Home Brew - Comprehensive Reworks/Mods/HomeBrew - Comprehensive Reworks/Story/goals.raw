		DB_FOR_SchoolOgre_Entrance((TRIGGER)S_FOR_SchoolOgre_Entrance_East_41fc78e6-50a6-4b63-ab2a-1419a40b2b21,(FLAG)FOR_SchoolOgres_State_EntranceUsed_East_15d88c73-8a5b-4ef8-bc29-ee38eefdd917);
		DB_FOR_SchoolOgre_Entrance((TRIGGER)S_FOR_SchoolOgre_Entrance_North_4b8753c5-c053-4908-9c0d-25d77681d3da,(FLAG)FOR_SchoolOgres_State_EntranceUsed_North_64d97a76-5941-41a3-bec7-b6ac5be86542);
		DB_FOR_SchoolOgre_Entrance((TRIGGER)S_FOR_SchoolOgre_Entrance_West_aee2f4a1-450d-4573-9c9e-172a6825146d,(FLAG)FOR_SchoolOgres_State_EntranceUsed_West_4704a1bc-5da9-4953-86c5-c5e684afb23f);
		
		PROC_FOR_SchoolOgre_InitSpotting();
		
		DB_DialogMoneyTransfer(1,(DIALOGRESOURCE)FOR_SchoolOgre1_31f68c00-dc6f-bcec-a0be-14acf675d630,500);
		DB_DialogMoneyTransfer(2,(DIALOGRESOURCE)FOR_SchoolOgre1_31f68c00-dc6f-bcec-a0be-14acf675d630,1000);
		DB_DialogMoneyTransfer(1,(DIALOGRESOURCE)FOR_SchoolOgres_Spotted_39bf09f7-0f54-3ca9-cbbd-56ca1a099545,500,4);
		DB_DialogMoneyTransfer(2,(DIALOGRESOURCE)FOR_SchoolOgres_Spotted_39bf09f7-0f54-3ca9-cbbd-56ca1a099545,1000,4);
		DB_DialogMoneyTransfer(1,(DIALOGRESOURCE)FOR_SchoolOgres_AfterSummon_5b0c1ee3-697c-7eeb-9370-5a70479bcc48,500);
		DB_DialogMoneyTransfer(2,(DIALOGRESOURCE)FOR_SchoolOgres_AfterSummon_5b0c1ee3-697c-7eeb-9370-5a70479bcc48,1000);
		DB_DialogMoneyTransfer(3,(DIALOGRESOURCE)FOR_SchoolOgres_AfterSummon_5b0c1ee3-697c-7eeb-9370-5a70479bcc48,2500);
		DB_DialogMoneyTransfer(4,(DIALOGRESOURCE)FOR_SchoolOgres_AfterSummon_5b0c1ee3-697c-7eeb-9370-5a70479bcc48,5000);
		
		DB_Dialogs(S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f,(DIALOGRESOURCE)FOR_SchoolOgre1_31f68c00-dc6f-bcec-a0be-14acf675d630);
		DB_Dialogs(S_FOR_SchoolOgre2_b847c9ba-1b52-4afa-be10-accd07134245,(DIALOGRESOURCE)FOR_SchoolOgre2_2a570108-5a68-c468-12bf-1396263dbf5d);
		DB_Dialogs(S_FOR_SchoolOgre3_62c5741f-061b-4dbc-afe6-5fd2368485ce,(DIALOGRESOURCE)FOR_SchoolOgre3_b71b094e-57d3-befd-2c16-2eaf0aca3dc1);
		
		DB_GLO_CharacterCorpseDialog((CHARACTER)S_FOR_SchoolOgre_Corpse_ef9ff510-c334-45d4-bade-a3a0f4c6e63b, (DIALOGRESOURCE)FOR_SchoolOgre_Corpse_Dead_40aeaadb-5bb2-a8d5-3a57-a178f0075842);
		
		ToInventory((ITEM)S_FOR_SchoolOgres_Horn_9d83c0b2-a14d-4f46-af49-67938cff4c8b,(CHARACTER)S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f);
		DB_HasItemEvent((ITEM)S_FOR_SchoolOgres_Horn_9d83c0b2-a14d-4f46-af49-67938cff4c8b,(FLAG)FOR_SchoolOgres_State_HasHorn_1656d9e5-4687-4ef1-ba87-44ba0f3478ec);
		//REGION Combat
		
		PROC_TriggerRegisterForPlayers(S_FOR_ShoolOgre_DestructableFloor_AreaTrigger_8f399368-0d58-4de6-9c8d-9f41a0b28600);
		
		//END_REGION
		
		DB_DropMutingStatussesDialog((DIALOGRESOURCE)FOR_SchoolOgres_AfterSummon_5b0c1ee3-697c-7eeb-9370-5a70479bcc48);
	}
	KB
	{
		//REGION Ogres Spot You
		PROC
		PROC_FOR_SchoolOgre_InitSpotting()
		AND
		DB_FOR_SchoolOgres(_Ogre)
		THEN
		DB_SpotPlayers(_Ogre, "FOR_SchoolOgre_SpotPlayers", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		DB_SpotPlayers_IncludeFollowers(_Ogre, "FOR_SchoolOgre_SpotPlayers");
		DB_SpotPlayers_IncludeSummons(_Ogre, "FOR_SchoolOgre_SpotPlayers");
		DB_SpotPlayers_TargetIgnoreCantTalk(_Ogre, "FOR_SchoolOgre_SpotPlayers");
		DB_SpotPlayers_IncludeWildshapedPlayers(_Ogre, "FOR_SchoolOgre_SpotPlayers");
		PROC_FOR_SchoolOgre_InitSpotTriggers(_Ogre);
		
		PROC
		PROC_FOR_SchoolOgre_InitSpotTriggers((CHARACTER)_Ogre)
		AND
		DB_FOR_SchoolOgre_Entrance(_Trigger, _Flag)
		THEN
		DB_SpotPlayers_SpotTrigger(_Ogre, "FOR_SchoolOgre_SpotPlayers", _Trigger);
		
		// Spotted player is available for dialog
		QRY
		QRY_FOR_SchoolOgres_SpottedCharacterIsAvailablePlayer((CHARACTER)_SpottedCharacter)
		AND
		DB_Players(_SpottedCharacter)
		AND
		QRY_SpeakerIsAvailable(_SpottedCharacter)
		AND
		QRY_OnlyOnce("FOR_SchoolOgres_PlayerSpottedInSchool")
		AND
		DB_InRegion(_SpottedCharacter, _Trigger)
		AND
		DB_FOR_SchoolOgre_Entrance(_Trigger, _Flag)
		AND
		QRY_PROC_FOR_SchoolOgres_SetEntranceFlag(_Flag)
		THEN
		PROC_FOR_SchoolOgres_PlayerSpotted(_SpottedCharacter, _Flag);
		
		// Spotted player is not available for dialog, but another player in the triggers is
		PROC
		PROC_SpotPlayers_Spotted(_Ogre, "FOR_SchoolOgre_SpotPlayers", _SpottedCharacter)
		AND
		NOT QRY_FOR_SchoolOgres_SpottedCharacterIsAvailablePlayer(_SpottedCharacter)
		AND
		DB_Players(_OtherPlayer)
		AND
		DB_InRegion(_OtherPlayer, _Trigger)
		AND
		DB_FOR_SchoolOgre_Entrance(_Trigger, _Flag)
		AND
		QRY_OnlyOnce("FOR_SchoolOgres_PlayerSpottedInSchool")
		AND
		QRY_PROC_FOR_SchoolOgres_SetEntranceFlag(_Flag)
		THEN
		PROC_FOR_SchoolOgres_PlayerSpotted(_OtherPlayer, _Flag);
		
		QRY
		QRY_PROC_FOR_SchoolOgres_SetEntranceFlag((FLAG)_SchoolOgreEntranceFlag)
		THEN
		SetFlag(_SchoolOgreEntranceFlag);
		
		// Fallback: spotted player is not available for dialog, and no other players are, go to combat
		PROC
		PROC_SpotPlayers_Spotted(_Ogre, "FOR_SchoolOgre_SpotPlayers", _SpottedCharacter)
		AND
		QRY_OnlyOnce("FOR_SchoolOgres_PlayerSpottedInSchool")
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT1_FOR_SchoolOgres_Original_aea113cd-5e2c-4048-9f6e-76d8f1af7c0c,0);
		PROC_SceneOver("FOR_SchoolOgreScene");
		
		// Try to start group dialog with all ogres
		PROC
		PROC_FOR_SchoolOgres_PlayerSpotted((CHARACTER)_Player,(FLAG)_SchoolOgreEntranceFlag)
		AND
		QRY_PROC_FOR_SchoolOgres_SetEntranceFlag(_SchoolOgreEntranceFlag)
		AND
		NOT DB_CantTalk(S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f)
		AND
		NOT DB_CantTalk(S_FOR_SchoolOgre2_b847c9ba-1b52-4afa-be10-accd07134245)
		AND
		NOT DB_CantTalk(S_FOR_SchoolOgre3_62c5741f-061b-4dbc-afe6-5fd2368485ce)
		AND
		QRY_StartDialogCustom((DIALOGRESOURCE)FOR_SchoolOgres_Spotted_39bf09f7-0f54-3ca9-cbbd-56ca1a099545,S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f,S_FOR_SchoolOgre2_b847c9ba-1b52-4afa-be10-accd07134245,S_FOR_SchoolOgre3_62c5741f-061b-4dbc-afe6-5fd2368485ce,_Player,S_FOR_SchoolOgre_Corpse_ef9ff510-c334-45d4-bade-a3a0f4c6e63b,0,1,1,1)
		THEN
		DB_FOR_SchoolOgres_DialogStartSucces(1);
		
		// Try to start solo dialog with Ogre 1
		PROC
		PROC_FOR_SchoolOgres_PlayerSpotted((CHARACTER)_Player,(FLAG)_)
		AND
		NOT DB_FOR_SchoolOgres_DialogStartSucces(1)
		AND
		NOT DB_CantTalk(S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f)
		AND
		QRY_StartDialogCustom((DIALOGRESOURCE)FOR_SchoolOgre1_31f68c00-dc6f-bcec-a0be-14acf675d630,S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f,_Player,0,1,1,1)
		THEN
		DB_FOR_SchoolOgres_DialogStartSucces(1);
		
		// Fallback to combat
		PROC
		PROC_FOR_SchoolOgres_PlayerSpotted((CHARACTER)_Player,(FLAG)_)
		AND
		NOT DB_FOR_SchoolOgres_DialogStartSucces(1)
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT1_FOR_SchoolOgres_Original_aea113cd-5e2c-4048-9f6e-76d8f1af7c0c,0);
		PROC_SceneOver("FOR_SchoolOgreScene");
		
		IF
		DB_FOR_SchoolOgres(_Ogre)
		THEN
		DB_SceneManager(_Ogre,"FOR_SchoolOgreScene");
		SetTag(_Ogre, NOT_MESSING_AROUND_542b58f0-42ad-4157-a28e-27434e0e7b18); //They care about crimes so long as they're not recruited.
		
		IF
		DB_PermaDefeated(S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f)
		AND
		QRY_OnlyOnce("FOR_SchoolOgre_StopSpotting")
		AND
		DB_FOR_SchoolOgres(_AnyOgre)
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT1_FOR_SchoolOgres_Original_aea113cd-5e2c-4048-9f6e-76d8f1af7c0c,0);
		PROC_SceneOver("FOR_SchoolOgreScene");
		
		PROC
		PROC_SceneInterrupted(_,_,"FOR_SchoolOgreScene",_Reason)
		AND
		_Reason != "StartedDialog"
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT1_FOR_SchoolOgres_Original_aea113cd-5e2c-4048-9f6e-76d8f1af7c0c,0);
		PROC_SceneOver("FOR_SchoolOgreScene");
		
		IF
		DB_PermaDefeated(_Ogre)
		AND
		DB_FOR_SchoolOgres((CHARACTER)_Ogre)
		THEN
		NOT DB_FOR_SchoolOgres(_Ogre);
		
		IF
		DialogStarted((DIALOGRESOURCE)FOR_SchoolOgres_Spotted_39bf09f7-0f54-3ca9-cbbd-56ca1a099545,_)
		THEN
		PROC_SceneOver("FOR_SchoolOgreScene");
		
		IF
		DialogStarted((DIALOGRESOURCE)FOR_SchoolOgre1_31f68c00-dc6f-bcec-a0be-14acf675d630,_)
		THEN
		PROC_SceneOver("FOR_SchoolOgreScene");
		
		PROC
		PROC_SceneOver("FOR_SchoolOgreScene")
		AND
		DB_FOR_SchoolOgre_Entrance(_SchoolOgresEntranceTrigger,_Flag)
		THEN
		PROC_TriggerUnregisterForPlayers(_SchoolOgresEntranceTrigger);
		NOT DB_FOR_SchoolOgre_Entrance(_SchoolOgresEntranceTrigger,_Flag);
		
		PROC
		PROC_SceneOver("FOR_SchoolOgreScene")
		THEN
		PROC_SpotPlayers_CleanupSpotting("FOR_SchoolOgre_SpotPlayers");
		//END_REGION
		
		//REGION Ogres Hired
		IF
		TextEvent("ogres")
		AND
		GetHostCharacter(_Player)
		THEN
		ToInventory((ITEM)S_FOR_SchoolOgres_Horn_9d83c0b2-a14d-4f46-af49-67938cff4c8b,_Player);
		SetFlag((FLAG)FOR_SchoolOgre_State_Hired_77d67f5b-540e-92b9-90ab-fa4849ff3901,NULL_00000000-0000-0000-0000-000000000000,0);
		ClearFlag((FLAG)FOR_SchoolOgres_State_OfferedLatePayment_0abc5fd9-599e-f536-5504-0ce0aad477c0,NULL_00000000-0000-0000-0000-000000000000,0);
		ClearFlag((FLAG)FOR_SchoolOgres_State_OfferedMeat_d5b09c6c-959d-514b-c265-292331928889,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_SceneOver("FOR_SchoolOgreScene");
		SetOnStage((CHARACTER)S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f,0);
		SetOnStage((CHARACTER)S_FOR_SchoolOgre2_b847c9ba-1b52-4afa-be10-accd07134245,0);
		SetOnStage((CHARACTER)S_FOR_SchoolOgre3_62c5741f-061b-4dbc-afe6-5fd2368485ce,0);
		
		
		IF
		TextEvent("ogresdebt")
		AND
		GetHostCharacter(_Player)
		THEN
		ToInventory((ITEM)S_FOR_SchoolOgres_Horn_9d83c0b2-a14d-4f46-af49-67938cff4c8b,_Player);
		SetFlag((FLAG)FOR_SchoolOgre_State_Hired_77d67f5b-540e-92b9-90ab-fa4849ff3901,NULL_00000000-0000-0000-0000-000000000000,0);
		SetFlag((FLAG)FOR_SchoolOgres_State_OfferedLatePayment_0abc5fd9-599e-f536-5504-0ce0aad477c0,NULL_00000000-0000-0000-0000-000000000000,0);
		ClearFlag((FLAG)FOR_SchoolOgres_State_OfferedMeat_d5b09c6c-959d-514b-c265-292331928889,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_SceneOver("FOR_SchoolOgreScene");
		SetOnStage((CHARACTER)S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f,0);
		SetOnStage((CHARACTER)S_FOR_SchoolOgre2_b847c9ba-1b52-4afa-be10-accd07134245,0);
		SetOnStage((CHARACTER)S_FOR_SchoolOgre3_62c5741f-061b-4dbc-afe6-5fd2368485ce,0);
		
		IF
		TextEvent("ogresmeat")
		AND
		GetHostCharacter(_Player)
		THEN
		ToInventory((ITEM)S_FOR_SchoolOgres_Horn_9d83c0b2-a14d-4f46-af49-67938cff4c8b,_Player);
		SetFlag((FLAG)FOR_SchoolOgre_State_Hired_77d67f5b-540e-92b9-90ab-fa4849ff3901,NULL_00000000-0000-0000-0000-000000000000,0);
		ClearFlag((FLAG)FOR_SchoolOgres_State_OfferedLatePayment_0abc5fd9-599e-f536-5504-0ce0aad477c0,NULL_00000000-0000-0000-0000-000000000000,0);
		SetFlag((FLAG)FOR_SchoolOgres_State_OfferedMeat_d5b09c6c-959d-514b-c265-292331928889,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_SceneOver("FOR_SchoolOgreScene");
		SetOnStage((CHARACTER)S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f,0);
		SetOnStage((CHARACTER)S_FOR_SchoolOgre2_b847c9ba-1b52-4afa-be10-accd07134245,0);
		SetOnStage((CHARACTER)S_FOR_SchoolOgre3_62c5741f-061b-4dbc-afe6-5fd2368485ce,0);
		
		IF
		FlagSet((FLAG)FOR_SchoolOgres_Event_GiveHorn_c971dad2-e668-fece-df8c-499f8f748900,_Player,_)
		THEN
		ToInventory((ITEM)S_FOR_SchoolOgres_Horn_9d83c0b2-a14d-4f46-af49-67938cff4c8b,_Player);
		
		
		IF
		FlagSet(FOR_SchoolOgre_State_Hired_77d67f5b-540e-92b9-90ab-fa4849ff3901, _, _)
		AND
		DB_FOR_SchoolOgres(_Ogre)
		THEN
		ClearTag(_Ogre, NOT_MESSING_AROUND_542b58f0-42ad-4157-a28e-27434e0e7b18); //They care about crimes so long as they're not recruited.
		SetTag(_Ogre, MONSTER_90101158-141e-4896-8e60-f8db03f6dde3); //They now only care about crimes against their allies, i.e. themselves.
		
		IF
		DialogEnded((DIALOGRESOURCE)FOR_SchoolOgres_Spotted_39bf09f7-0f54-3ca9-cbbd-56ca1a099545,_)
		AND
		DB_GlobalFlag((FLAG)FOR_SchoolOgre_State_Hired_77d67f5b-540e-92b9-90ab-fa4849ff3901)
		THEN
		PROC_FOR_SchoolOgres_RunOffAfterHired();
		
		IF
		DialogEnded((DIALOGRESOURCE)FOR_SchoolOgre1_31f68c00-dc6f-bcec-a0be-14acf675d630,_)
		AND
		DB_GlobalFlag((FLAG)FOR_SchoolOgre_State_Hired_77d67f5b-540e-92b9-90ab-fa4849ff3901)
		THEN
		PROC_FOR_SchoolOgres_RunOffAfterHired();
		
		PROC
		PROC_FOR_SchoolOgres_RunOffAfterHired()
		THEN
		TimerLaunch("FOR_SchoolOgres_RunOffAfterHired",1000);
		
		PROC
		PROC_FOR_SchoolOgres_RunOffAfterHired()
		AND
		DB_FOR_SchoolOgres(_Ogre)
		THEN
		SetHasDialog(_Ogre,0);
		
		IF
		TimerFinished("FOR_SchoolOgres_RunOffAfterHired")
		AND
		DB_FOR_SchoolOgres(_Ogre)
		THEN
		PROC_DisappearOutOfSightTo(_Ogre,(TRIGGER)S_FOR_SchoolOgres_RunAwayDirection_9807d351-9799-44d4-9348-730894981c5b,"Walk",1,"");
		
		IF
		FlagSet((FLAG)FOR_SchoolOgres_State_Hired_77d67f5b-540e-92b9-90ab-fa4849ff3901, _, _)
		AND
		DB_FOR_SchoolOgres(_Ogre)
		AND
		NOT DB_PermaDefeated(_Ogre)
		THEN
		PROC_PeacefulResolve(_Ogre);
		//END_REGION
		
		//REGION Using the Horn
		IF
		TextEvent("ogrehorn")
		AND
		GetHostCharacter(_Player)
		THEN
		PlayAnimation(_Player,(ANIMATION)CUST_PlayingHorn_01_6a141d35-effe-4c7f-9585-bb153e4c1230,"FOR_OgresHornBlown"); //CUST_PlayingHorn_01
		
		IF
		UseStarted(_Player,(ITEM)S_FOR_SchoolOgres_Horn_9d83c0b2-a14d-4f46-af49-67938cff4c8b)
		THEN
		NOT DB_FOR_SchoolOgress_Hornresponded(1);
		
		//Player cant be in another dialog
		IF
		UseStarted(_Player,(ITEM)S_FOR_SchoolOgres_Horn_9d83c0b2-a14d-4f46-af49-67938cff4c8b)
		AND
		NOT QRY_SpeakerIsAvailable(_Player, 1)
		THEN
		DB_FOR_SchoolOgress_Hornresponded(1);
		
		//Ogre already summoned
		IF
		UseStarted(_Player,(ITEM)S_FOR_SchoolOgres_Horn_9d83c0b2-a14d-4f46-af49-67938cff4c8b)
		AND
		DB_FOR_SchoolOgre_SummonPlayer(_,_)
		THEN
		DB_FOR_SchoolOgress_Hornresponded(1);
		
		IF
		UseStarted(_Player,(ITEM)S_FOR_SchoolOgres_Horn_9d83c0b2-a14d-4f46-af49-67938cff4c8b)
		AND
		NOT DB_FOR_SchoolOgress_Hornresponded(1)
		THEN
		CloseUI(_Player,"Inventory");
		PlayAnimation(_Player,(ANIMATION)CUST_PlayingHorn_01_6a141d35-effe-4c7f-9585-bb153e4c1230,"FOR_OgresHornBlown"); //CUST_PlayingHorn_01
		
		//Response 1: Ogres are dead
		IF
		EntityEvent(_Player,"FOR_OgresHornBlown")
		AND
		NOT DB_FOR_SchoolOgress_Hornresponded(1)
		AND
		NOT DB_FOR_SchoolOgres((CHARACTER)S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f)
		THEN
		DB_FOR_SchoolOgress_Hornresponded(1);
		SetFlag((FLAG)FOR_SchoolOgres_Event_HornFail_Dead_78e9bec2-81f4-6e8b-53e7-63496cb9f976,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_TryStartAD((DIALOGRESOURCE)FOR_SchoolOgres_PAD_NotReturning_574a821c-4435-73c1-f9d4-ac76eac0df82,_Player);
		
		//Response 2: Contract is done
		IF
		EntityEvent(_Player,"FOR_OgresHornBlown")
		AND
		NOT DB_FOR_SchoolOgress_Hornresponded(1)
		AND
		DB_GlobalFlag((FLAG)FOR_SchoolOgres_State_SummonedThrice_2ea0b8d7-a7ba-9bad-af9c-2a4e3702ef3f)
		THEN
		DB_FOR_SchoolOgress_Hornresponded(1);
		SetFlag((FLAG)FOR_SchoolOgres_Event_HornFail_Done_7132dbdc-ea57-6248-3885-1226aeb5db9d,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_TryStartAD((DIALOGRESOURCE)FOR_SchoolOgres_PAD_NotReturning_574a821c-4435-73c1-f9d4-ac76eac0df82,_Player);
		
		//Response 3: Ogres too far (different region)
		IF
		EntityEvent(_Player,"FOR_OgresHornBlown")
		AND
		NOT DB_FOR_SchoolOgress_Hornresponded(1)
		AND
		NOT DB_CurrentLevel("WLD_Main_A")
		THEN
		DB_FOR_SchoolOgress_Hornresponded(1);
		SetFlag((FLAG)FOR_SchoolOgres_Event_HornFail_Range_feb0a181-ccf6-d635-79c3-68ce8bb4e2cc,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_TryStartAD((DIALOGRESOURCE)FOR_SchoolOgres_PAD_NotReturning_574a821c-4435-73c1-f9d4-ac76eac0df82,_Player);
		
		//Response 3b: Ogres too far (blocked zone)
		IF
		EntityEvent(_Player,"FOR_OgresHornBlown")
		AND
		NOT DB_FOR_SchoolOgress_Hornresponded(1)
		AND
		DB_InBlockedWaypointZone((CHARACTER)_Player,_)
		THEN
		DB_FOR_SchoolOgress_Hornresponded(1);
		SetFlag((FLAG)FOR_SchoolOgres_Event_HornFail_Range_feb0a181-ccf6-d635-79c3-68ce8bb4e2cc,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_TryStartAD((DIALOGRESOURCE)FOR_SchoolOgres_PAD_NotReturning_574a821c-4435-73c1-f9d4-ac76eac0df82,_Player);
		
		//Response 4: Player in Camp
		IF
		EntityEvent((CHARACTER)_Player,"FOR_OgresHornBlown")
		AND
		NOT DB_FOR_SchoolOgress_Hornresponded(1)
		AND
		DB_InCamp(_Player)
		THEN
		DB_FOR_SchoolOgress_Hornresponded(1);
		SetFlag((FLAG)FOR_SchoolOgres_Event_HornFail_Camp_4be1279a-a0e8-f9e7-21c9-0f1415a6f31b,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_TryStartAD((DIALOGRESOURCE)FOR_SchoolOgres_PAD_NotReturning_574a821c-4435-73c1-f9d4-ac76eac0df82,_Player);
		
		//Ogre already summoned
		IF
		EntityEvent(_Player,"FOR_OgresHornBlown")
		AND
		NOT DB_OffStage((CHARACTER)S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f)
		THEN
		DB_FOR_SchoolOgress_Hornresponded(1);
		
		//Never hired: Summon Ogres + Have them attack the players
		IF
		EntityEvent((CHARACTER)_Player,"FOR_OgresHornBlown")
		AND
		NOT DB_FOR_SchoolOgress_Hornresponded(1)
		AND
		NOT DB_GlobalFlag((FLAG)FOR_SchoolOgres_State_Hired_77d67f5b-540e-92b9-90ab-fa4849ff3901)
		THEN
		SetFlag((FLAG)FOR_SchoolOgres_Event_AggroOnPlayer_e87b2a42-1470-d04a-621b-7c6e5f54b000,NULL_00000000-0000-0000-0000-000000000000,0);
		DB_FOR_SchoolOgress_Hornresponded(1);
		PROC_SetRelationToPlayers((FACTION)ACT1_FOR_SchoolOgres_Original_aea113cd-5e2c-4048-9f6e-76d8f1af7c0c,0);
		PROC_SetRelationToPlayers((FACTION)Act1_FOR_SchoolOgres_Summoned_61056357-8ea5-4ab2-895e-bda956f2b03b,0);
		PROC_FOR_SchoolOgres_Summon(_Player);
		
		//Hired: Summon Ogres + Attack all but the players.
		IF
		EntityEvent((CHARACTER)_Player,"FOR_OgresHornBlown")
		AND
		NOT DB_FOR_SchoolOgress_Hornresponded(1)
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT1_FOR_SchoolOgres_Original_aea113cd-5e2c-4048-9f6e-76d8f1af7c0c,50);
		PROC_SetRelationToPlayers((FACTION)Act1_FOR_SchoolOgres_Summoned_61056357-8ea5-4ab2-895e-bda956f2b03b,50);
		PROC_FOR_SchoolOgres_Summon(_Player);
		
		IF
		EntityEvent(_Player,"FOR_OgresHornBlown")
		THEN
		NOT DB_FOR_SchoolOgress_Hornresponded(1);
		//END_REGION
		
		//REGION Summoning The Ogres
		PROC
		PROC_FOR_SchoolOgres_Summon((CHARACTER)_Player)
		AND
		DB_FOR_SchoolOgres(_Ogre)
		THEN
		PROC_ForceStopDialog(_Ogre);
		AppearOutOfSightTo(_Ogre,_Player, (TRIGGER)S_FOR_SchoolOgre_LookAt_cb2c39fb-c511-49e5-85f3-fb47b47181d7,0,NULL_00000000-0000-0000-0000-000000000000, "FOR_SchoolOgre_RunToPlayer",1);
		DB_FOR_SchoolOgre_SummonPlayer(_Ogre,_Player);
		
		/* Staggered summon code, tested it but didn't seem to help.
		PROC
		PROC_FOR_SchoolOgres_Summon((CHARACTER)_Player)
		AND
		DB_FOR_SchoolOgres(_Ogre)
		THEN
		PROC_ForceStopDialog(_Ogre);
		DB_FOR_SchoolOgre_SummonPlayer(_Ogre,_Player);
		DB_FOR_SchoolOgre_SummonOgresDelayed(_Ogre);
		
		PROC
		PROC_FOR_SchoolOgres_Summon((CHARACTER)_Player)
		THEN
		SetEntityEvent(_Player, "FOR_SchoolOgre_SpawnNextOgre");
		
		// Only spawn next ogre when previous ogre is spawned
		IF
		EntityEvent(_PreviousOgre, "FOR_SchoolOgre_SpawnNextOgre")
		AND
		QRY_OnlyOnce_Reset("FOR_SchoolOgre_SpawnNextOgre")
		AND
		DB_FOR_SchoolOgre_SummonOgresDelayed(_Ogre)
		AND
		DB_FOR_SchoolOgre_SummonPlayer(_Ogre,_Player)
		AND
		QRY_OnlyOnce("FOR_SchoolOgre_SpawnNextOgre")
		THEN
		NOT DB_FOR_SchoolOgre_SummonOgresDelayed(_Ogre);
		AppearOutOfSightTo(_Ogre,_Player, (TRIGGER)S_FOR_SchoolOgre_LookAt_cb2c39fb-c511-49e5-85f3-fb47b47181d7,0,NULL_00000000-0000-0000-0000-000000000000, "FOR_SchoolOgre_SpawnNextOgre",1);
		
		// Propagate event to have ogres run to the player once they have appeared
		IF
		EntityEvent(_Ogre, "FOR_SchoolOgre_SpawnNextOgre")
		AND
		DB_FOR_SchoolOgre_SummonPlayer((CHARACTER)_Ogre, _)
		THEN
		SetEntityEvent(_Ogre, "FOR_SchoolOgre_RunToPlayer");
		*/
		
		IF
		AppearTeleportFailed(_Ogre,_)
		AND
		DB_FOR_SchoolOgre_SummonPlayer(_Ogre,_Player)
		THEN
		SetOnStage(_Ogre,0);
		NOT DB_FOR_SchoolOgre_SummonPlayer(_Ogre,_Player);
		
		PROC
		PROC_FOR_SchoolOgres_Summon((CHARACTER)_Player)
		THEN
		SetFlag((FLAG)FOR_SchoolOgres_State_KilledNoone_21ffcaa9-23fc-f03a-f167-b06c6d22ee03,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_RemoveAllDialogEntriesForSpeaker((CHARACTER)S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f);
		DB_Dialogs((CHARACTER)S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f,(DIALOGRESOURCE)FOR_SchoolOgres_AfterSummon_5b0c1ee3-697c-7eeb-9370-5a70479bcc48);
		
		IF
		DB_Is_InCombat(_Ogre,_)
		AND
		DB_FOR_SchoolOgres((CHARACTER)_Ogre)
		THEN
		ClearFlag((FLAG)FOR_SchoolOgres_State_KilledNoone_21ffcaa9-23fc-f03a-f167-b06c6d22ee03,NULL_00000000-0000-0000-0000-000000000000,0);
		
		PROC
		PROC_FOR_SchoolOgres_Summon((CHARACTER)_Player)
		AND
		QRY_OnlyOnce("FOR_SchoolOgre_StopSpotting")
		AND
		DB_FOR_SchoolOgres(_AnyOgre)
		THEN
		SetFaction(_AnyOgre,(FACTION)Act1_FOR_SchoolOgres_Summoned_61056357-8ea5-4ab2-895e-bda956f2b03b);
		PROC_SpotPlayers_StopSpotting(_AnyOgre, "FOR_SchoolOgre");
		
		PROC
		PROC_FOR_SchoolOgres_Summon((CHARACTER)_Player)
		AND
		DB_FOR_SchoolOgre_SummonedHaveAttacked(1)
		THEN
		NOT DB_FOR_SchoolOgre_SummonedHaveAttacked(1);
		
		IF
		EntityEvent(_Ogre,"FOR_SchoolOgre_RunToPlayer")
		AND
		DB_FOR_SchoolOgre_SummonPlayer((CHARACTER)_Ogre,_Player)
		THEN
		PROC_CharacterMoveTo((CHARACTER)_Ogre,_Player,"Run","FOR_SchoolOgres_TestCombatEnd");
		
		IF
		EntityEvent((CHARACTER)S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f,"FOR_SchoolOgre_RunToPlayer")
		AND
		NOT QRY_StartDialog((DIALOGRESOURCE)FOR_SchoolOgres_AD_Summoned_67a08f9f-a27f-f6c7-0d25-30b2ec8c4edc,(CHARACTER)S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f,(CHARACTER)S_FOR_SchoolOgre2_b847c9ba-1b52-4afa-be10-accd07134245,(CHARACTER)S_FOR_SchoolOgre3_62c5741f-061b-4dbc-afe6-5fd2368485ce)
		AND
		NOT QRY_StartDialog((DIALOGRESOURCE)FOR_SchoolOgres_AD_Summoned_67a08f9f-a27f-f6c7-0d25-30b2ec8c4edc,(CHARACTER)S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f,(CHARACTER)S_FOR_SchoolOgre2_b847c9ba-1b52-4afa-be10-accd07134245,NULL_00000000-0000-0000-0000-000000000000)
		AND
		NOT QRY_StartDialog((DIALOGRESOURCE)FOR_SchoolOgres_AD_Summoned_67a08f9f-a27f-f6c7-0d25-30b2ec8c4edc,(CHARACTER)S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f,NULL_00000000-0000-0000-0000-000000000000,(CHARACTER)S_FOR_SchoolOgre3_62c5741f-061b-4dbc-afe6-5fd2368485ce)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)FOR_SchoolOgres_AD_Summoned_67a08f9f-a27f-f6c7-0d25-30b2ec8c4edc,(CHARACTER)S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f,NULL_00000000-0000-0000-0000-000000000000,NULL_00000000-0000-0000-0000-000000000000);
		
		//Way to make ogres aggro everything: If they see someone, become aggressive to their faction.
		IF
		Saw(_Ogre,_Enemy,_)
		AND
		DB_FOR_SchoolOgre_SummonPlayer(_Ogre,_)
		AND
		NOT DB_FOR_SchoolOgres(_Enemy)
		AND
		NOT DB_GlobalFlag((FLAG)FOR_SchoolOgres_Event_AggroOnPlayer_e87b2a42-1470-d04a-621b-7c6e5f54b000)
		AND
		NOT DB_Dead(_Enemy)
		AND
		IsPartyMember(_Enemy,1,0)
		AND
		GetFaction(_Enemy,_Faction)
		AND
		CanJoinCombat(_Ogre, 1)
		THEN
		PROC_FOR_SchoolOgre_SummonedHostileTo(_Enemy, _Faction);
		
		// Before the Ogres have attacked, the enemies will not be hostile to the player
		PROC
		PROC_FOR_SchoolOgre_SummonedHostileTo((CHARACTER)_Enemy, (FACTION)_Faction)
		AND
		NOT DB_FOR_SchoolOgre_SummonedHaveAttacked(1)
		THEN
		DB_FOR_SchoolOgre_SummonedHostileTo(_Enemy, _Faction);
		PROC_SetRelation((FACTION)Act1_FOR_SchoolOgres_Summoned_61056357-8ea5-4ab2-895e-bda956f2b03b,_Faction,0);
		
		// After the Ogres have attacked, the enemies will be hostile to the player
		PROC
		PROC_FOR_SchoolOgre_SummonedHostileTo(_Enemy, _Faction)
		AND
		DB_FOR_SchoolOgre_SummonedHaveAttacked(1)
		AND
		DB_Players(_Player)
		THEN
		DB_FOR_SchoolOgre_SummonedHostileTo(_Enemy, _Faction);
		//PROC_SetRelationToPlayers(_Faction, 0);
		PROC_SetRelationTemporaryHostile(_Enemy, _Player);
		PROC_SetRelationMutual((FACTION)Act1_FOR_SchoolOgres_Summoned_61056357-8ea5-4ab2-895e-bda956f2b03b, _Faction, 0);
		
		// If the ogres attack something, they will become hostile to the ogres.
		// The defenders will also blame the players for any attacks on them
		IF
		AttackedBy((CHARACTER)_Defender,(CHARACTER)_Ogre,_,_,_,_,_)
		AND
		NOT DB_FOR_SchoolOgre_SummonedHaveAttacked(1)
		AND
		DB_FOR_SchoolOgre_SummonPlayer(_Ogre, _Player)
		AND
		NOT DB_FOR_SchoolOgres(_Defender)
		AND
		IsPartyMember(_Defender,1,0)
		AND
		GetFaction(_Defender,_DefenderFaction)
		THEN
		PROC_FOR_SchoolOgre_SummonedHaveAttacked();
		
		// Ogres attacked for the first time, everyone they are hostile to now becomes hostile to them and temporarily to the player that summoned them.
		PROC
		PROC_FOR_SchoolOgre_SummonedHaveAttacked()
		THEN
		DB_FOR_SchoolOgre_SummonedHaveAttacked(1);
		
		PROC
		PROC_FOR_SchoolOgre_SummonedHaveAttacked()
		AND
		DB_FOR_SchoolOgre_SummonPlayer(_, _Player)
		AND
		DB_FOR_SchoolOgre_SummonedHostileTo(_Character, _Faction)
		THEN
		DB_FOR_SchoolOgre_SummonedHaveAttacked(1);
		//PROC_SetRelationToPlayers(_Faction, 0);
		PROC_SetRelationTemporaryHostile(_Character, _Player);
		PROC_SetRelation(_Faction, (FACTION)Act1_FOR_SchoolOgres_Summoned_61056357-8ea5-4ab2-895e-bda956f2b03b, 0);
		
		//Edge case: If an NPC changes faction AFTER the ogre saw it, reapply hostility.
		IF
		BaseFactionChanged(_Char,_,_Faction)
		AND
		DB_FOR_SchoolOgre_SummonPlayer(_Ogre,_)
		AND
		DB_Sees(_Ogre,_Char)
		AND
		NOT DB_FOR_SchoolOgres(_Char)
		AND
		NOT DB_GlobalFlag((FLAG)FOR_SchoolOgres_Event_AggroOnPlayer_e87b2a42-1470-d04a-621b-7c6e5f54b000)
		AND
		IsPartyMember(_Char,1,0)
		THEN
		PROC_SetRelationMutual((FACTION)Act1_FOR_SchoolOgres_Summoned_61056357-8ea5-4ab2-895e-bda956f2b03b,_Faction,0);
		
		IF
		WentOnStage(_Ogre,_)
		AND
		DB_FOR_SchoolOgres((CHARACTER)_Ogre)
		AND
		GetPosition(_Ogre,_X,_Y,_Z)
		THEN
		PlayEffectAtPosition((EFFECTRESOURCE)VFX_Script_Ogre_Spawn_01_134d1d6b-1bd7-8cea-8d6e-8f3db2a14b32,_X,_Y,_Z,1.0);
		//END_REGION
		
		//REGION Dialog Interrupt
		IF
		EnteredCombat(_Ogre,_)
		AND
		DB_FOR_SchoolOgres((CHARACTER)_Ogre)
		AND
		DB_FOR_SchoolOgres(_AnyOgre)
		AND
		DB_DialogNPCs(_,_AnyOgre,_ID)
		AND
		NOT DB_AutomatedDialog(_ID)
		THEN
		PROC_ForceStopDialog(_AnyOgre);
		//END_REGION
		
		//REGION After Combat
		IF
		EntityEvent(_Ogre,"FOR_SchoolOgres_TestCombatEnd")
		AND
		DB_FOR_SchoolOgres((CHARACTER)_Ogre)
		AND
		DB_Is_InCombat(_Ogre,_)
		THEN
		DB_FOR_SchoolOgres_WaitForCombatToEnd(_Ogre);
		
		IF
		EntityEvent(_Ogre,"FOR_SchoolOgres_TestCombatEnd")
		AND
		DB_FOR_SchoolOgres((CHARACTER)_Ogre)
		AND
		DB_FOR_SchoolOgre_SummonPlayer(_,_Player)
		AND
		DB_Is_InCombat(_Player,_)
		THEN
		DB_FOR_SchoolOgres_WaitForCombatToEnd(_Player);
		
		IF
		LeftCombat(_Combatant,_)
		AND
		DB_FOR_SchoolOgres_WaitForCombatToEnd((CHARACTER)_Combatant)
		THEN
		NOT DB_FOR_SchoolOgres_WaitForCombatToEnd((CHARACTER)_Combatant);
		PROC_FOR_SchoolOgres_CheckCombatEnded();
		
		PROC
		PROC_FOR_SchoolOgres_CheckCombatEnded()
		AND
		NOT DB_FOR_SchoolOgres_WaitForCombatToEnd(_)
		AND
		DB_FOR_SchoolOgre_SummonPlayer(_Ogre,_Player)
		THEN
		PROC_CharacterMoveTo((CHARACTER)_Ogre,_Player,"Run","FOR_SchoolOgres_TestCombatEnd");
		
		//Disable ogres from joining another combat once they have left combat after being summoned.
		IF
		LeftCombat((CHARACTER)_Ogre, _)
		AND
		DB_FOR_SchoolOgre_SummonPlayer(_Ogre, _)
		THEN
		SetCanJoinCombat(_Ogre, 0);
		SetCanFight(_Ogre, 0);
		
		IF
		EntityEvent((CHARACTER)S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f,"FOR_SchoolOgres_TestCombatEnd")
		AND
		NOT DB_FOR_SchoolOgres_WaitForCombatToEnd(_)
		AND
		DB_FOR_SchoolOgre_SummonPlayer((CHARACTER)S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f,_Player)
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)FOR_SchoolOgres_AfterSummon_5b0c1ee3-697c-7eeb-9370-5a70479bcc48,(CHARACTER)S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f,_Player)
		THEN
		DB_NOOP(1);
		
		IF
		EntityEvent(_Ogre,"FOR_SchoolOgres_TestCombatEnd")
		AND
		NOT DB_FOR_SchoolOgres_WaitForCombatToEnd(_)
		AND
		DB_PermaDefeated((CHARACTER)S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f)
		THEN
		PROC_DisappearOutOfSight((CHARACTER)_Ogre,"Run",1,"GEN_GoOffStage");
		
		IF
		EntityEvent(_Ogre,"FOR_SchoolOgres_TestCombatEnd")
		AND
		NOT DB_FOR_SchoolOgres_WaitForCombatToEnd(_)
		AND
		NOT DB_Dead((CHARACTER)S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f)
		AND
		NOT DB_FOR_SchoolOgres_TimerStarted(1)
		THEN
		DB_FOR_SchoolOgres_TimerStarted(1);
		TimerLaunch("FOR_SchoolOgres_Fallback",20000);
		
		IF
		EnteredCombat(_Ogre,_)
		AND
		DB_FOR_SchoolOgres((CHARACTER)_Ogre)
		AND
		DB_FOR_SchoolOgres_TimerStarted(1)
		THEN
		NOT DB_FOR_SchoolOgres_TimerStarted(1);
		TimerCancel("FOR_SchoolOgres_Fallback");
		DB_FOR_SchoolOgres_WaitForCombatToEnd(_Ogre);
		
		IF
		TimerFinished("FOR_SchoolOgres_Fallback")
		AND
		DB_FOR_SchoolOgres_TimerStarted(1)
		AND
		NOT DB_DialogNPCs(_,(CHARACTER)S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f,_)
		AND
		DB_FOR_SchoolOgres(_Ogre)
		THEN
		SetFlag((FLAG)FOR_SchoolOgres_State_SummonedThrice_2ea0b8d7-a7ba-9bad-af9c-2a4e3702ef3f,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_DisappearOutOfSight((CHARACTER)_Ogre,"Run",1,"GEN_GoOffStage");
		
		IF
		TimerFinished("FOR_SchoolOgres_Fallback")
		THEN
		NOT DB_FOR_SchoolOgres_TimerStarted(1);
		
		IF
		Died((CHARACTER)S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f)
		THEN
		SetFlag((FLAG)FOR_SchoolOgres_State_SummonedThrice_2ea0b8d7-a7ba-9bad-af9c-2a4e3702ef3f,NULL_00000000-0000-0000-0000-000000000000,0);
		ClearFlag((FLAG)FOR_SchoolOgres_State_AfterSummoning_2xDeal_b2514b10-63d3-8107-2348-904948d682c3,NULL_00000000-0000-0000-0000-000000000000,0);
		ClearFlag((FLAG)FOR_SchoolOgres_State_AfterSummoning_5XDeal_299f123d-8f5b-c0dc-0aad-5b9620712426,NULL_00000000-0000-0000-0000-000000000000,0);
		ClearFlag((FLAG)FOR_SchoolOgres_State_AfterSummoning_10XDeal_be0290c7-5a04-66f1-98d2-cca61dd3e709,NULL_00000000-0000-0000-0000-000000000000,0);
		
		IF                      
		DialogEnded((DIALOGRESOURCE)FOR_SchoolOgres_AfterSummon_5b0c1ee3-697c-7eeb-9370-5a70479bcc48,_)
		THEN
		ObjectTimerLaunch((CHARACTER)S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f,"FOR_SchoolOgres_RunOff",500);
		ObjectTimerLaunch((CHARACTER)S_FOR_SchoolOgre2_b847c9ba-1b52-4afa-be10-accd07134245,"FOR_SchoolOgres_RunOff",1000);
		ObjectTimerLaunch((CHARACTER)S_FOR_SchoolOgre3_62c5741f-061b-4dbc-afe6-5fd2368485ce,"FOR_SchoolOgres_RunOff",1500);
		
		IF
		ObjectTimerFinished(_Ogre,"FOR_SchoolOgres_RunOff")
		THEN
		PROC_DisappearOutOfSight((CHARACTER)_Ogre,"Run",1,"GEN_GoOffStage");
		
		IF
		DialogEnded((DIALOGRESOURCE)FOR_SchoolOgres_AfterSummon_5b0c1ee3-697c-7eeb-9370-5a70479bcc48,_)
		THEN
		TimerCancel("FOR_SchoolOgres_Fallback");
		
		IF
		WentOnStage(_Ogre,0)
		AND
		DB_FOR_SchoolOgre_SummonPlayer((CHARACTER)_Ogre,_Player)
		THEN
		SetCanFight(_Ogre, 1);
		SetCanJoinCombat(_Ogre, 1);
		NOT DB_FOR_SchoolOgre_SummonPlayer(_Ogre,_Player);
		
		IF
		Died(_Ogre)
		AND
		DB_FOR_SchoolOgre_SummonPlayer((CHARACTER)_Ogre,_Player)
		THEN
		NOT DB_FOR_SchoolOgre_SummonPlayer(_Ogre,_Player);
		
		IF
		DialogEnded((DIALOGRESOURCE)FOR_SchoolOgres_AfterSummon_5b0c1ee3-697c-7eeb-9370-5a70479bcc48,_)
		AND
		DB_GlobalFlag((FLAG)FOR_SchoolOgres_Event_AggroOnPlayer_e87b2a42-1470-d04a-621b-7c6e5f54b000)
		THEN
		PROC_SetRelationToPlayers((FACTION)Act1_FOR_SchoolOgres_Summoned_61056357-8ea5-4ab2-895e-bda956f2b03b,0);
		SetFlag((FLAG)FOR_SchoolOgres_State_SummonedThrice_2ea0b8d7-a7ba-9bad-af9c-2a4e3702ef3f,NULL_00000000-0000-0000-0000-000000000000,0);
		
		//Restore hostility if Ogre is combat disabled and their faction is hostile to players.
		IF
		RelationChanged(Act1_FOR_SchoolOgres_Summoned_61056357-8ea5-4ab2-895e-bda956f2b03b, Hero_a1542c81-6895-929e-4522-10ce218bb360, 0, _)
		AND
		DB_FOR_SchoolOgre_SummonPlayer(_Ogre,_Player)
		AND
		CanFight(_Ogre, 0)
		THEN
		SetCanFight(_Ogre, 1);
		SetCanJoinCombat(_Ogre, 1);
		
		IF
		FlagSet((FLAG)FOR_SchoolOgres_State_SummonedThrice_2ea0b8d7-a7ba-9bad-af9c-2a4e3702ef3f,NULL_00000000-0000-0000-0000-000000000000,_)
		THEN
		SetStoryItem((ITEM)S_FOR_SchoolOgres_Horn_9d83c0b2-a14d-4f46-af49-67938cff4c8b,0);
		//END_REGION
		
		//REGION Combat
		
		IF
		EnteredTrigger(_Player,S_FOR_ShoolOgre_DestructableFloor_AreaTrigger_8f399368-0d58-4de6-9c8d-9f41a0b28600)
		AND
		DB_Players(_Player)
		AND
		DB_FOR_SchoolOgres(_Ogre)
		THEN
		AiAddInterestingItem(_Ogre,BLD_GEN_Beam_Square_A_Wood_A_8H_A_000_LT_PLT_FOR_HouseFloor_003_LT_WLD_Forest_9b966418-1de4-cc4c-e09a-02eafc09f59b);
		
		IF
		LeftTrigger(_Player,S_FOR_ShoolOgre_DestructableFloor_AreaTrigger_8f399368-0d58-4de6-9c8d-9f41a0b28600)
		AND
		DB_Players(_Player)
		AND
		DB_FOR_SchoolOgres(_Ogre)
		THEN
		AiRemoveInterestingItem(_Ogre,BLD_GEN_Beam_Square_A_Wood_A_8H_A_000_LT_PLT_FOR_HouseFloor_003_LT_WLD_Forest_9b966418-1de4-cc4c-e09a-02eafc09f59b);
		
		IF
		DestroyedBy(BLD_GEN_Beam_Square_A_Wood_A_8H_A_000_LT_PLT_FOR_HouseFloor_003_LT_WLD_Forest_9b966418-1de4-cc4c-e09a-02eafc09f59b,_,_,_)
		THEN
		PROC_TriggerUnregisterForPlayers(S_FOR_ShoolOgre_DestructableFloor_AreaTrigger_8f399368-0d58-4de6-9c8d-9f41a0b28600);
		
		IF
		DestroyedBy(BLD_GEN_Beam_Square_A_Wood_A_8H_A_000_LT_PLT_FOR_HouseFloor_003_LT_WLD_Forest_9b966418-1de4-cc4c-e09a-02eafc09f59b,_,_,_)
		AND
		NOT DB_GlobalFlag((FLAG)FOR_SchoolOgres_State_Hired_77d67f5b-540e-92b9-90ab-fa4849ff3901)
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT1_FOR_SchoolOgres_Original_aea113cd-5e2c-4048-9f6e-76d8f1af7c0c,0);
		
		IF
		DestroyedBy(BLD_GEN_Beam_Square_A_Wood_A_8H_A_000_LT_PLT_FOR_HouseFloor_003_LT_WLD_Forest_9b966418-1de4-cc4c-e09a-02eafc09f59b,_,_,_)
		AND
		DB_FOR_SchoolOgres(_Ogre)
		THEN
		AiRemoveInterestingItem(_Ogre,BLD_GEN_Beam_Square_A_Wood_A_8H_A_000_LT_PLT_FOR_HouseFloor_003_LT_WLD_Forest_9b966418-1de4-cc4c-e09a-02eafc09f59b);
		
		//END_REGION
		
		//REGION Boulder
		PROC
		PROC_FOR_SchoolOgres_RunOffAfterHired()
		THEN
		ClearOwnership(S_FOR_SchoolOgres_Stash_Crate_7cac9b65-9541-48c7-9649-d92792808db7);
		//END_REGION
		
		//REGION Patrolling Goblin walks in on fight against ogres (not hired)
		IF
		EnteredCombat((CHARACTER)S_FOR_Ambush_PatrollingGoblin_6db1f304-683a-4409-ab7a-b22f64f2c2e3,_CombatID)
		AND
		DB_FOR_SchoolOgres(_Ogre)
		AND
		DB_Is_InCombat(_Ogre,_CombatID)
		AND
		NOT DB_GlobalFlag((FLAG)FOR_SchoolOgre_State_Hired_77d67f5b-540e-92b9-90ab-fa4849ff3901)
		AND
		QRY_OnlyOnce("FOR_Amobush_PatrollingGoblinWalksInOnFight")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)FOR_Ambush_PatrollingGoblin_AD_JoinOgreFight_1df51ca1-fd6e-2150-d82c-2232207aa141,(CHARACTER)S_FOR_Ambush_PatrollingGoblin_6db1f304-683a-4409-ab7a-b22f64f2c2e3);
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(157).Title("Act1_FOR_ThayanCellar");
Goal(157)
{
	INIT
	{
		SetOnStage(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, 0);
		SetCanInteract(S_FOR_SecretDoor_7a8d4e98-b661-427d-8437-71451ddb847c, 0);
		PROC_TriggerRegisterForParty((TRIGGER)S_FOR_ThayanCellar_SecretLabArea_448458f8-773f-426d-a287-3becd992173e);
		PROC_TriggerRegisterForParty((TRIGGER)S_FOR_ThayanCellar_CellarTrapTrigger_3a2b26ca-6705-4f68-b5ee-e29633023f87);
		PROC_TriggerRegisterForPlayers(S_FOR_ThayanCellar_SafeBubble_cc621ff4-1971-4084-9a5b-c47d3050640d);
		TriggerRegisterForItems((TRIGGER)S_FOR_ThayanOrb_MirrorBox_bb4820dd-89ce-4ab0-8554-557a5bb3fc67);
		
		DB_FlagReactionAfterDialog((FLAG)FOR_ThayanCellar_Event_DestroyMirror_c1b401c5-d21c-405e-bf38-b273d3a6b376, (DIALOGRESOURCE)FOR_ThayanCellar_MagicMirror_f899b723-7363-c89d-ec8f-ec1a7dc86454);
		
		DB_FOR_ThayanCellar_Braziers((ITEM)S_FOR_Brazier_000_3fa48bca-2143-4b10-94d2-7cc2616596c1);
		DB_FOR_ThayanCellar_Braziers((ITEM)S_FOR_Brazier_001_3ee5753f-d494-4497-968c-29238214b188);
		
		//REGION Undead Ambush
		DB_FOR_ThayanCellar_UndeadContainer(S_FOR_Crypt_002_d22904ef-0759-47eb-9ceb-bcd107edc6d0, S_FOR_ThayG_Skeleton_002_171eb53b-f6a4-465a-9bb1-585a74a0efcc);
		DB_FOR_ThayanCellar_UndeadContainer(S_FOR_Crypt_003_8c5e3d51-2244-499e-ba59-2d7b0041b3db, S_FOR_ThayG_Skeleton_003_7be92b31-6fcd-4fef-8708-9bb927f89fd5);
		DB_FOR_ThayanCellar_UndeadContainer(S_FOR_Crypt_004_91bcb042-868e-4629-a345-45747864e6d8, S_FOR_ThayG_Skeleton_004_d1f7d900-0e2d-4706-a141-20a026c003ed);
		DB_FOR_ThayanCellar_UndeadContainer(S_FOR_Crypt_005_83da924f-91a9-48ee-bf50-24d9b050ea4a, S_FOR_ThayG_Skeleton_005_43a9bace-50c0-4313-bc3b-824adecf0aad);
		DB_FOR_ThayanCellar_UndeadContainer(S_FOR_Crypt_006_7668d12b-f129-4e34-b882-c94d569a90fc, S_FOR_ThayG_Skeleton_006_fe72d606-8d37-4dfc-bbe2-2afda9e91c88);
		DB_FOR_ThayanCellar_UndeadContainer(S_FOR_Crypt_007_1c01b1fc-6032-41f5-a705-94334e72d97e, S_FOR_ThayG_Skeleton_007_595edf1e-af70-4dec-a1a6-735f4966c42f);
		DB_FOR_ThayanCellar_UndeadContainer(S_FOR_Crypt_008_bfa6370c-b65a-4a7e-8a35-3c69a4b4f427, S_FOR_ThayG_Skeleton_008_532d1b22-b493-4282-b366-a55dbd6cf8a4);
		
		DB_FOR_ThayanCellar_AmbushStopped(0);
		
		PROC_FOR_ThayanCellar_InitUndead();
		//END_REGION
		
		//REGION Secret Areas
		DB_FOR_ThayanCellar_SecretDoors(S_FOR_MovingBookCase_eb1fa168-7b0e-4d17-9d54-03b74365ac84, S_FOR_SecretWallLever_8f2afbad-fe57-4574-b8c2-6c0ae0bff0cf);
		//END_REGION
		
		//REGION Apothecary House
		DB_KnowledgeCheckItem_AD("FOR_Thayan_ApothecaryHerbs", S_FOR_Thayan_ApothecaryHerbs_be767903-b998-4dca-a5f1-5e04828d4df4, "Nature", (DIFFICULTYCLASS)DC_Legacy_15_bddbb9b8-a242-4c3e-a2eb-3fd274c0c539, (DIALOGRESOURCE)FOR_ThayanCellar_VB_InspectHerbs_6ad6b713-12cb-813d-7ed4-cf3d0e8cc23c, (FLAG)FOR_ThayanCellar_State_IdentifiedHerbs_d7a1f673-b092-41cc-88a1-3687725b01ad);
		DB_KnowledgeCheckItem_AD("FOR_Thayan_ApothecaryCauldron", S_FOR_Thayan_ApothecaryCauldron_2b3ab481-94eb-4a70-912c-3b772aa4d5cc, "Medicine", (DIFFICULTYCLASS)DC_Legacy_15_bddbb9b8-a242-4c3e-a2eb-3fd274c0c539, (DIALOGRESOURCE)FOR_ThayanCellar_VB_InspectCookingPot_53d85e9d-fbb3-5dea-5576-4f3ac8a0d365, (FLAG)FOR_ThayanCellar_State_IdentifiedCookingPot_11204032-c043-4a30-bd88-958300c6fce0);
		PROC_TriggerRegisterForPlayers(S_FOR_Thayan_ApothecaryHouseTrigger_2c46c830-8f1c-45b0-aa3e-feb66e2d3c53);
		//END_REGION
		
		//REGION Quasit
		PROC_TriggerRegisterForParty((TRIGGER)S_FOR_OrbAndSkeletonsRoom_dff5d215-e4c9-42cb-abb3-cfc288ff8fc1);
		
		DB_FOR_ThayanCellar_QuasitNames((FLAG)FOR_ThayanCellar_State_QuasitName1_09d81790-babd-4cd8-b02a-0b6883bc7eb7, "FOR_ThayanCellar_QuasitName1");
		DB_FOR_ThayanCellar_QuasitNames((FLAG)FOR_ThayanCellar_State_QuasitName2_22a59e56-1524-4e16-810f-0fda6eae9649, "FOR_ThayanCellar_QuasitName2");
		DB_FOR_ThayanCellar_QuasitNames((FLAG)FOR_ThayanCellar_State_QuasitName3_d4db7baf-45cc-471a-8b19-26e02ad61785, "FOR_ThayanCellar_QuasitName3");
		//END_REGION
		
		//REGION Danger Zone
		PROC_TriggerRegisterForParty((TRIGGER)S_FOR_ThayanCellar_DangerZone_5978a2ae-581a-4063-a953-f0713aca5bbe);
		//END_REGION
		
		//REGION EA Hack - Orb Trap
		DB_FOR_ThayanCellar_OrbPath((TRIGGER)S_FOR_ThayanCellar_OrbRoute_000_88f7a06e-4d4f-4885-bd93-fdd82495adbe, 0);
		DB_FOR_ThayanCellar_OrbPath((TRIGGER)S_FOR_ThayanCellar_OrbRoute_001_ffe045bc-57f5-463c-a14f-ac9a350719c8, 1);
		DB_FOR_ThayanCellar_OrbPath((TRIGGER)S_FOR_ThayanCellar_OrbRoute_002_4ca0b0cb-d9c3-4f35-93f0-4b097da85edb, 2);
		DB_FOR_ThayanCellar_OrbPath((TRIGGER)S_FOR_ThayanCellar_OrbRoute_003_e42f84b3-a6a4-443e-8e24-f9286bfae566, 3);
		DB_FOR_ThayanCellar_OrbPath((TRIGGER)S_FOR_ThayanCellar_OrbRoute_004_2975374b-2d18-4797-a38d-9f7a1e8c5a5b, 4);
		DB_FOR_ThayanCellar_OrbPath((TRIGGER)S_FOR_ThayanCellar_OrbRoute_005_d72cf61d-8bd2-41d6-8f0d-3deb0da39278, 5);
		DB_FOR_ThayanCellar_OrbPath((TRIGGER)S_FOR_ThayanCellar_OrbRoute_006_739ae41a-8325-4ecf-b7f6-3f66b5931fb0, 6);
		DB_FOR_ThayanCellar_OrbPath((TRIGGER)S_FOR_ThayanCellar_OrbRoute_007_36fd8705-e70d-42c5-bc2e-7c8c3838d413, 7);
		DB_FOR_ThayanCellar_OrbPath((TRIGGER)S_FOR_ThayanCellar_OrbRoute_008_01503ed2-88d1-4987-b76d-acde58e5aeaf, 8);
		DB_FOR_ThayanCellar_OrbPath((TRIGGER)S_FOR_ThayanCellar_OrbRoute_004_2975374b-2d18-4797-a38d-9f7a1e8c5a5b, 9);
		DB_FOR_ThayanCellar_OrbPath((TRIGGER)S_FOR_ThayanCellar_OrbRoute_005_d72cf61d-8bd2-41d6-8f0d-3deb0da39278, 10);
		
		DB_FOR_ThayanCellar_OrbCurrentPoint(0);
		//END_REGION
		
		//Magic Mirror
		DB_BookFlags(S_FOR_ThayanJournal_9339e000-6be5-45c3-868d-7e686c7d2b69,FOR_ThayanCellar_Knows_WizardName_6977d982-cf60-46f3-ab39-73fe325f442c);
		DB_QuestDef_State((FLAG)FOR_ThayanCellar_Event_OpenMirror_d1da5931-fb01-4f5d-940a-74d2b1e7aff8, "HIDDEN_WLD_Boosters", "FOR_ThayanCellar_OpenMirror");
		
		SetOnStage(Quest_ThayGuardian_Stalactite_01_8ffd570c-6e3f-4042-bdf2-1b28e3322c92,0);
		SetOnStage(Quest_ThayGuardian_Stalactite_02_5589fab1-63e7-49fc-a4d1-3a242dfed744,0);
		SetOnStage(Quest_ThayGuardian_Stalactite_03_7261181b-e91e-45ae-868f-0acc41db6a24,0);
	}
	KB
	{
		 //REGION Apothecary House
		//TODO: Need solution for firing VB after using inventory item
		IF
		UseFinished(_Player, S_FOR_Thayan_ApothecaryLedger_551bb6db-470a-42ba-88e1-c5f628d08c9b, 1)
		AND
		DB_InRegion(_Player, S_FOR_Thayan_ApothecaryHouseTrigger_2c46c830-8f1c-45b0-aa3e-feb66e2d3c53)
		AND
		NOT DB_GlobalFlag((FLAG)FOR_ThayanCellar_State_CellarDiscovered_308aa3f8-f4f2-4c48-88e9-59d36b1778e8)
		AND
		QRY_SpeakerIsAvailable(_Player)
		AND
		QRY_OncePerUserAndNearbyPlayers(_Player, "FOR_ThayanCellar_PlayerReadLedger")
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)FOR_ThayanCellar_VB_ReadLedger_5a10dc2c-f146-2656-b8cb-aa639f1650c0, _Player);
		//END_REGION
		
		//REGION Secret Door
		
		// Open the secret bookcase door
		IF
		DualEntityEvent(_Player, _Lever, "FOR_ThayanCellar_OpenSecretDoor")
		AND
		DB_FOR_ThayanCellar_SecretDoors(_Door, _Lever)
		AND
		NOT DB_FOR_ThayanCellar_MovingDoor(_Door)
		AND
		NOT DB_FOR_ThayanCellar_OpenedDoor(_Door)
		THEN
		DB_FOR_ThayanCellar_MovingDoor(_Door);
		DB_FOR_ThayanCellar_OpenedDoor(_Door);
		Open((ITEM)S_FOR_MovingBookCase_eb1fa168-7b0e-4d17-9d54-03b74365ac84);
		Open(S_FOR_MovingBookCase_InvisibleDoor_46f1c81c-6ff0-4aaf-b584-07789f0ad09d);
		
		//Close the secret bookcase door
		IF
		DualEntityEvent(_Player, _Lever, "FOR_ThayanCellar_OpenSecretDoor")
		AND
		DB_FOR_ThayanCellar_SecretDoors(_Door, _Lever)
		AND
		NOT DB_FOR_ThayanCellar_MovingDoor(_Door)
		AND
		DB_FOR_ThayanCellar_OpenedDoor(_Door)
		THEN
		DB_FOR_ThayanCellar_MovingDoor(_Door);
		NOT DB_FOR_ThayanCellar_OpenedDoor(_Door);
		Close((ITEM)S_FOR_MovingBookCase_eb1fa168-7b0e-4d17-9d54-03b74365ac84);
		Close(S_FOR_MovingBookCase_InvisibleDoor_46f1c81c-6ff0-4aaf-b584-07789f0ad09d);
		
		IF
		EntityEvent(_Door, "FOR_ThayanCellar_OpenedDoor")
		AND
		DB_FOR_ThayanCellar_MovingDoor(_Door)
		THEN
		NOT DB_FOR_ThayanCellar_MovingDoor(_Door);
		
		IF
		EntityEvent(_Door, "FOR_ThayanCellar_ClosedDoor")
		AND
		DB_FOR_ThayanCellar_MovingDoor(_Door)
		THEN
		NOT DB_FOR_ThayanCellar_MovingDoor(_Door);
		
		IF
		DualEntityEvent(_Player, _Lever, "FOR_ThayanCellar_OpenLabSecretDoor")
		AND
		QRY_OnlyOnce_Reset("FOR_ThayanCellar_LabSecretDoorProcessed")
		AND
		IsOpened(S_FOR_SecretDoor_7a8d4e98-b661-427d-8437-71451ddb847c, 0)
		AND
		QRY_OnlyOnce("FOR_ThayanCellar_LabSecretDoorProcessed")
		THEN
		Open(S_FOR_SecretDoor_7a8d4e98-b661-427d-8437-71451ddb847c);
		
		IF
		DualEntityEvent(_Player, _Lever, "FOR_ThayanCellar_OpenLabSecretDoor")
		AND
		IsOpened(S_FOR_SecretDoor_7a8d4e98-b661-427d-8437-71451ddb847c, 1)
		AND
		QRY_OnlyOnce("FOR_ThayanCellar_LabSecretDoorProcessed")
		THEN
		Close(S_FOR_SecretDoor_7a8d4e98-b661-427d-8437-71451ddb847c);
		//END_REGION
		
		//REGION Magic Mirror
		
		QRY
		QRY_FOR_ThayanCellar_NoReflection((CHARACTER)_Player)
		AND
		IsTagged(_Player, (TAG)REALLY_ASTARION_ffd08582-7396-4cac-bcd4-8f9cd0fd8ef3, 1)
		THEN
		SetFlag((FLAG)FOR_ThayanCellar_State_NoReflection_034ae669-eb9a-45c3-9d29-de54a1e8d486, _Player, 0);
		
		QRY
		QRY_FOR_ThayanCellar_NoReflection((CHARACTER)_Player)
		AND
		HasActiveStatusWithGroup(_Player, "SG_Invisible", 1)
		THEN
		SetFlag((FLAG)FOR_ThayanCellar_State_NoReflection_034ae669-eb9a-45c3-9d29-de54a1e8d486, _Player, 0);
		
		QRY
		QRY_FOR_ThayanCellar_NoReflection((CHARACTER)_Player)
		THEN
		DB_NOOP(1);
		
		IF
		DialogEnded((DIALOGRESOURCE)FOR_ThayanCellar_MagicMirror_f899b723-7363-c89d-ec8f-ec1a7dc86454, _ID)
		AND
		DB_DialogPlayers(_ID, _Player, _)
		AND
		GetFlag((FLAG)FOR_ThayanCellar_State_NoReflection_034ae669-eb9a-45c3-9d29-de54a1e8d486, _Player, 1)
		THEN
		ClearFlag((FLAG)FOR_ThayanCellar_State_NoReflection_034ae669-eb9a-45c3-9d29-de54a1e8d486, _Player);
		
		PROC
		PROC_BlockUseOfItem(_Char, (ITEM)S_FOR_MagicMirror_7b0d83fb-8cda-4b55-b1b7-fa5073ae5c89)
		AND
		NOT DB_GlobalFlag((FLAG)FOR_ThayanCellar_Event_OpenMirror_d1da5931-fb01-4f5d-940a-74d2b1e7aff8)
		THEN
		DB_CustomUseItemResponse(_Char, (ITEM)S_FOR_MagicMirror_7b0d83fb-8cda-4b55-b1b7-fa5073ae5c89, 0);
		
		PROC
		PROC_BlockUseOfItem(_Char, (ITEM)S_FOR_MagicMirror_7b0d83fb-8cda-4b55-b1b7-fa5073ae5c89)
		AND
		NOT DB_FOR_ThayanCellar_TrapActive(1)
		AND
		NOT DB_GlobalFlag((FLAG)FOR_ThayanCellar_Event_OpenMirror_d1da5931-fb01-4f5d-940a-74d2b1e7aff8)
		AND
		QRY_SpeakerIsAvailable((ITEM)S_FOR_MagicMirror_7b0d83fb-8cda-4b55-b1b7-fa5073ae5c89)
		AND
		DB_Players(_Char)
		AND
		QRY_FOR_ThayanCellar_NoReflection((CHARACTER)_Char)
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)FOR_ThayanCellar_MagicMirror_f899b723-7363-c89d-ec8f-ec1a7dc86454, (ITEM)S_FOR_MagicMirror_7b0d83fb-8cda-4b55-b1b7-fa5073ae5c89, _Char)
		THEN
		DB_NOOP(1);
		
		IF
		FlagSet((FLAG)FOR_ThayanCellar_Event_OpenMirror_d1da5931-fb01-4f5d-940a-74d2b1e7aff8, _, _)
		THEN
		SetCanInteract((ITEM)S_FOR_MagicMirror_7b0d83fb-8cda-4b55-b1b7-fa5073ae5c89, 0);
		Open((ITEM)S_FOR_MagicMirror_7b0d83fb-8cda-4b55-b1b7-fa5073ae5c89);
		
		
		PROC
		PROC_FlagReactionAfterDialog(_Barb, (FLAG)FOR_ThayanCellar_Event_DestroyMirror_c1b401c5-d21c-405e-bf38-b273d3a6b376)
		AND
		IsDestroyed((ITEM)S_FOR_MagicMirror_7b0d83fb-8cda-4b55-b1b7-fa5073ae5c89, 0)
		THEN
		Die((ITEM)S_FOR_MagicMirror_7b0d83fb-8cda-4b55-b1b7-fa5073ae5c89, DEATHTYPE.Physical, _Barb, 0, 0, 1.0);
		
		//END_REGION
		
		//REGION Thayan Trap
		QRY
		QRY_FOR_ThayanCellar_OrbNotTriggeredOrFinished()
		AND
		DB_FOR_ThayanCellar_OrbFinished(1)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_FOR_ThayanCellar_OrbNotTriggeredOrFinished()
		AND
		NOT DB_FOR_ThayanCellar_TrapActive(1)
		THEN
		DB_NOOP(1);
		
		//REGION Deploy Trap
		IF
		DialogEnded((DIALOGRESOURCE)FOR_ThayanCellar_MagicMirror_f899b723-7363-c89d-ec8f-ec1a7dc86454, _ID)
		AND
		DB_GlobalFlag((FLAG)FOR_ThayanCellar_Event_StartTrap_42248191-11cd-46f4-ac37-a1770c113563)
		AND
		NOT DB_FOR_ThayanCellar_TrapActive(1)
		THEN
		DB_FOR_ThayanCellar_TrapActive(1);
		NOT DB_Dialogs(S_FOR_MagicMirror_7b0d83fb-8cda-4b55-b1b7-fa5073ae5c89, (DIALOGRESOURCE)FOR_ThayanCellar_MagicMirror_f899b723-7363-c89d-ec8f-ec1a7dc86454);
		PROC_RemoveDialog(S_FOR_MagicMirror_7b0d83fb-8cda-4b55-b1b7-fa5073ae5c89);
		ClearFlag((FLAG)FOR_ThayanCellar_Event_StartTrap_42248191-11cd-46f4-ac37-a1770c113563, NULL_00000000-0000-0000-0000-000000000000, _ID);
		TimerLaunch("FOR_ThayanCellar_OrbEmerging", 100);
		
		PROC
		PROC_BlockUseOfItem((CHARACTER)_Player, (ITEM)S_FOR_MagicMirror_7b0d83fb-8cda-4b55-b1b7-fa5073ae5c89)
		AND
		DB_FOR_ThayanCellar_TrapActive(1)
		THEN
		DB_CustomUseItemResponse(_Player, (ITEM)S_FOR_MagicMirror_7b0d83fb-8cda-4b55-b1b7-fa5073ae5c89, 0);
		PROC_PlayCantUseItemAD(_Player);
		
		IF
		FlagSet(FOR_ThayanCellar_Event_StartTrap_42248191-11cd-46f4-ac37-a1770c113563, _, _)
		THEN
		SetFlag((FLAG)FOR_ThayanCellar_Event_TrapActivatedOnce_e4a8bf1e-f176-a23a-ffcd-cd50c531ed23, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		TimerFinished("FOR_ThayanCellar_OrbEmerging")
		THEN
		SetFlag((FLAG)FOR_ThayanCellar_Event_TrapInProgress_b88cda6a-46f0-48f6-929b-7967696be9b2, NULL_00000000-0000-0000-0000-000000000000);
		SetOnStage(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, 1);
		ItemMoveTo(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, S_FOR_ThayanOrbEmerge_338a236a-feb1-473b-8b69-0bc6b86dcad1, 1.0, 0.0, 0, "FOR_ThayanCellar_OrbEmerged", 1);
		
		IF
		EntityEvent(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, "FOR_ThayanCellar_OrbEmerged")
		AND
		DrawSurfaceOnPath(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, SS_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, "SurfaceFire", 0.5, 30.0, _Handle)
		THEN
		DB_FOR_ThayanCellar_SurfaceHandle(_Handle);
		ApplyStatus(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, "FOR_THAYANCELLAR_TRAPFUEL", 60.0, 1, NULL_00000000-0000-0000-0000-000000000000);
		PROC_FOR_ThayanCellar_OrbTrace();
		
		IF
		EntityEvent(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, "FOR_ThayanCellar_OrbEmerged")
		AND
		DB_Players(_Player)
		AND
		DB_InRegion(_Player, S_FOR_ThayanCellar_Boundaries_ee808e8c-a15f-45f2-8dae-e225dd9674ab)
		AND
		QRY_IsInRange(_Player, S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, 10.0)
		AND
		QRY_OncePerUserAndNearbyPlayers(_Player, "FOR_ThayanCellar_OrbSeen")
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)FOR_ThayanCellar_VB_TrapStart_01be5f1b-2143-25f2-17ce-f7e753b5233c, _Player);
		
		//END_REGION
		
		//REGION Orb Movement and Player Trace
		
		IF
		EntityEvent(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, "FOR_FireOrb_EndPath")
		THEN
		CreateExplosion(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, "Projectile_UND_ThayanCellar_OrbExplosion", 3);
		
		IF
		EntityEvent(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, "FOR_FireOrb_EndPath")
		AND
		NOT DB_Is_InCombat(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, _)
		THEN
		TimerLaunch("FOR_ThayanCellar_OrbCooldown", 300);
		
		IF
		EntityEvent(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, "FOR_FireOrb_EndPath")
		AND
		DB_Is_InCombat(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, _)
		THEN
		EndTurn(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1);
		
		IF
		TimerFinished("FOR_ThayanCellar_OrbCooldown")
		THEN
		PROC_FOR_ThayanCellar_OrbTrace();
		
		PROC
		PROC_FOR_ThayanCellar_OrbTrace()
		AND
		NOT DB_FOR_ThayanCellar_OrbFinished(1)
		AND
		NOT QRY_FOR_ThayanCellar_OrbTrace()
		THEN
		PROC_FOR_ThayanCellar_OrbLeave();
		
		QRY
		QRY_FOR_ThayanCellar_OrbTrace()
		AND
		DB_FOR_ThayanCellar_OrbCurrentPoint(_Index)
		AND
		DB_FOR_ThayanCellar_OrbPath(_Point, _Index)
		AND
		GetPosition(_Point, _X, _Y, _Z)
		AND
		RealSum(_Y, 2.3, _NewY) //So it floats in the air rather than dragging across the ground
		AND
		IntegerSum(_Index, 1, _NewIndex) 
		THEN
		ItemMoveToPosition((ITEM)S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, _X, _NewY, _Z, 1.6, 1.2, "FOR_FireOrb_EndPath", 0);
		NOT DB_FOR_ThayanCellar_OrbCurrentPoint(_Index);
		DB_FOR_ThayanCellar_OrbCurrentPoint(_NewIndex);
		
		QRY
		QRY_FOR_ThayanCellar_ClosestTarget()
		AND
		DB_InRegion(_Char, S_FOR_ThayanCellar_Boundaries_ee808e8c-a15f-45f2-8dae-e225dd9674ab)
		AND
		GetDistanceTo(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, _Char, _Dist)
		AND
		NOT DB_Defeated ((CHARACTER)_Char)
		THEN
		DB_FOR_ThayanCellar_TargetDistance(_Char, _Dist);
		
		IF
		DB_FOR_ThayanCellar_TargetDistance(_Char1, _Dist1)
		AND
		DB_FOR_ThayanCellar_TargetDistance(_Char2, _Dist2)
		AND
		_Char1 != _Char2
		AND
		_Dist1 <= _Dist2
		THEN
		NOT DB_FOR_ThayanCellar_TargetDistance(_Char2, _Dist2);
		
		QRY
		QRY_FOR_ThayanCellar_RemoveData()
		AND
		DB_FOR_ThayanCellar_TargetDistance(_Target, _Dist)
		THEN
		NOT DB_FOR_ThayanCellar_TargetDistance(_Target, _Dist);
		
		QRY
		QRY_FOR_ThayanCellar_RemoveData()
		AND
		NOT DB_FOR_ThayanCellar_TargetDistance(_, _)
		THEN
		DB_NOOP(1);
		
		
		//END_REGION
		
		//REGION Orb Finish 
		
		IF
		DestroyedBy(S_FOR_MagicMirror_7b0d83fb-8cda-4b55-b1b7-fa5073ae5c89, _, _, _)
		AND
		NOT DB_FOR_ThayanCellar_OrbFinished(1)
		THEN
		DB_FOR_ThayanCellar_OrbFinished(1);
		PROC_FOR_ThayanCellar_OrbLeave();
		
		IF
		UsingSpellOnTarget(_, S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, "Target_DispelMagic", _, _, _)
		AND
		NOT DB_FOR_ThayanCellar_OrbFinished(1)
		THEN
		DB_FOR_ThayanCellar_OrbFinished(1);
		PROC_FOR_ThayanCellar_OrbLeave();
		
		IF
		UsingSpellOnTarget(_, S_FOR_MagicMirror_7b0d83fb-8cda-4b55-b1b7-fa5073ae5c89, "Target_DispelMagic", _, _, _)
		AND
		NOT DB_FOR_ThayanCellar_OrbFinished(1)
		THEN
		DB_FOR_ThayanCellar_OrbFinished(1);
		PROC_FOR_ThayanCellar_OrbLeave();
		
		IF
		StatusRemoved(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, "FOR_THAYANCELLAR_TRAPFUEL", _, _)
		AND
		NOT DB_FOR_ThayanCellar_OrbFinished(1)
		THEN
		DB_FOR_ThayanCellar_OrbFinished(1);
		PROC_FOR_ThayanCellar_OrbLeave();
		
		PROC
		PROC_FOR_ThayanCellar_OrbTrace()
		AND
		DB_FOR_ThayanCellar_OrbFinished(1)
		THEN
		NOT DB_FOR_ThayanCellar_OrbFinished(1);
		TimerCancel("FOR_ThayanCellar_OrbTimer");
		PROC_FOR_ThayanCellar_OrbLeave();
		//END_REGION
		
		//REGION Orb Return
		PROC
		PROC_FOR_ThayanCellar_OrbLeave()
		THEN
		TimerLaunch("FOR_ThayanCellar_ReturnDelay", 4000);
		
		PROC
		PROC_FOR_ThayanCellar_OrbLeave()
		AND
		DB_Players(_Player)
		AND
		DB_InRegion(_Player, S_FOR_ThayanCellar_Boundaries_ee808e8c-a15f-45f2-8dae-e225dd9674ab)
		AND
		QRY_IsInRange(_Player, S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, 10.0)
		AND
		QRY_OncePerUserAndNearbyPlayers(_Player, "FOR_ThayanCellar_OrbExhaustVB")
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)FOR_ThayanCellar_VB_Trap_1e28f571-72ed-9aa2-0f4a-5ad710f1ea1b, _Player);
		
		IF
		TimerFinished("FOR_ThayanCellar_ReturnDelay")
		AND
		DB_FOR_ThayanCellar_SurfaceHandle(_Handle)
		THEN
		NOT DB_FOR_ThayanCellar_SurfaceHandle(_Handle);
		StopDrawSurfaceOnPath(_Handle);
		RemoveStatus(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, "FOR_THAYANCELLAR_TRAPFUEL");
		ItemMoveTo(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, S_FOR_ThayanOrbEmerge_338a236a-feb1-473b-8b69-0bc6b86dcad1, 1.2, 0.0, 0, "FOR_FireOrb_LeavePath", 1);
		
		IF
		EntityEvent(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, "FOR_FireOrb_LeavePath")
		THEN
		ItemMoveTo(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, S_FOR_ThayanOrbMirror_660ac921-fa64-42da-a8d4-2b09d90baf31, 0.8, 0.0, 0, "FOR_FireOrb_ReturnToMirror", 1);
		DB_FOR_ThayanCellar_TrapActiveOnDeactivationPath(1);
		
		IF
		EntityEvent(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, "FOR_FireOrb_ReturnToMirror")
		AND
		DB_FOR_ThayanCellar_TrapActive(1)
		THEN
		DB_Dialogs(S_FOR_MagicMirror_7b0d83fb-8cda-4b55-b1b7-fa5073ae5c89, (DIALOGRESOURCE)FOR_ThayanCellar_MagicMirror_f899b723-7363-c89d-ec8f-ec1a7dc86454);
		NOT DB_FOR_ThayanCellar_TrapActive(1);
		ClearFlag((FLAG)FOR_ThayanCellar_Event_TrapInProgress_b88cda6a-46f0-48f6-929b-7967696be9b2, NULL_00000000-0000-0000-0000-000000000000);
		SetOnStage(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, 0);
		//END_REGION
		
		//REGION Combat
		
		IF
		TurnStarted(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1)
		THEN
		PROC_FOR_ThayanCellar_OrbTrace();
		
		IF
		LeftCombat(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1, _)
		THEN
		PROC_FOR_ThayanCellar_OrbTrace();
		
		//END_REGION
		
		//REGION Turret Delay
		
		IF
		DualEntityEvent(_, S_FOR_BookPressurePlate_8288ace1-357d-417a-98e3-1ec7ade1e05d, "FOR_ThayanCellar_BookPressurePlate_Pressed")
		THEN
		TimerLaunch("FOR_ThayanCellar_TurretDelay", 750);
		
		IF
		TimerFinished("FOR_ThayanCellar_TurretDelay")
		THEN
		SetDualEntityEvent(NULL_00000000-0000-0000-0000-000000000000, S_FOR_ThayanTurret_001_da680b84-21b6-4daf-a9a0-7c5d24ddbdd0, "FOR_ThayanCellar_BookPressurePlate_PressedRight");
		
		IF
		DualEntityEvent(_, S_FOR_BookPressurePlate_8288ace1-357d-417a-98e3-1ec7ade1e05d, "FOR_ThayanCellar_BookPressurePlate_UnPressed")
		THEN
		TimerCancel("FOR_ThayanCellar_TurretDelay");
		
		//END_REGION
		
		//END_REGION
		
		//REGION Secret Lab Entry
		
		IF
		DB_InRegion(_Player, (TRIGGER)S_FOR_ThayanCellar_SecretLabArea_448458f8-773f-426d-a287-3becd992173e)
		AND
		DB_Players(_Player)
		THEN
		SetFlag((FLAG)FOR_ThayanCellar_State_LabDiscovered_72e17f62-be19-4277-be42-01a6f62afbf3);
		
		IF
		DB_InRegion(_Player, (TRIGGER)S_FOR_ThayanCellar_SecretLabArea_448458f8-773f-426d-a287-3becd992173e)
		AND
		NOT DB_CantTalk(_Player)
		AND
		QRY_OncePerUserAndNearbyPlayers(_Player, "S_FOR_ThayanCellar_LabEntry", 6.0)
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)FOR_ThayanCellar_VB_EnterSecretLab_40112dbc-2f4d-50fb-7490-5f616bc56e14, _Player);
		
		//END_REGION
		
		//REGION Investigations
		
		PROC
		PROC_BlockUseOfItem(_Player, S_FOR_MovingBookCase_eb1fa168-7b0e-4d17-9d54-03b74365ac84)
		AND
		GetFlag((FLAG)FOR_ThayanCellar_State_TriedBookcaseCheck_b36dbfd7-0853-4306-ad04-ef4ecf9b7405, _Player, 0)
		THEN
		DB_CustomUseItemResponse(_Player, S_FOR_MovingBookCase_eb1fa168-7b0e-4d17-9d54-03b74365ac84, 0);
		PROC_TrySkillCheck(_Player, S_FOR_MovingBookCase_eb1fa168-7b0e-4d17-9d54-03b74365ac84, "Investigation", (DIFFICULTYCLASS)DC_Legacy_10_625be976-7a67-4394-97c8-14c69715ae4b, "FOR_ThayanCellar_BookCaseInvestigate");
		
		PROC
		PROC_RollResult("FOR_ThayanCellar_BookCaseInvestigate", _Player, S_FOR_MovingBookCase_eb1fa168-7b0e-4d17-9d54-03b74365ac84, 1)
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)FOR_ThayanCellar_VB_Bookcase_a8b000eb-b8a6-28c4-ff87-e57989c232f3, _Player);
		
		PROC
		PROC_RollResult("FOR_ThayanCellar_BookCaseInvestigate", _Player, S_FOR_MovingBookCase_eb1fa168-7b0e-4d17-9d54-03b74365ac84, _Result)
		AND
		_Result != 2
		THEN
		SetFlag((FLAG)FOR_ThayanCellar_State_TriedBookcaseCheck_b36dbfd7-0853-4306-ad04-ef4ecf9b7405, _Player, 0);
		
		IF
		UseStarted(_Player, S_FOR_DoctorLog_bd7b6fad-8409-4d5d-bd8b-824c93412165)
		AND
		DB_Players(_Player)
		AND
		QRY_OnlyOnce("FOR_ThayanCellar_ReadLog")
		THEN
		SetFlag((FLAG)FOR_ThayanCellar_Quest_ReadDoctorLog_db3f8b4a-87f4-4732-abd1-9de54fd58a6a, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		//END_REGION
		
		//REGION Undead Container
		IF
		DB_PermaDefeated(_Undead)
		AND
		DB_FOR_ThayanCellar_ActiveUndead(_Undead)
		THEN
		NOT DB_FOR_ThayanCellar_ActiveUndead(_Undead);
		
		IF
		DB_FOR_ThayanCellar_ActiveUndead(_Undead)
		THEN
		DB_GLO_DefeatCounter(_Undead, "FOR_ThayanCellar_SkeletonAmbush");
		
		PROC
		PROC_GLO_DefeatCounter_AllPermaDefeated("FOR_ThayanCellar_SkeletonAmbush")
		THEN
		NOT DB_FOR_ThayanCellar_AmbushStopped(0);
		DB_FOR_ThayanCellar_AmbushStopped(1);
		
		PROC
		PROC_FOR_ThayanCellar_InitUndead()
		AND
		DB_FOR_ThayanCellar_UndeadContainer(_, _Undead)
		AND
		GetFaction(_Undead,_Faction)
		AND
		GetCombatGroupID(_Undead,_CmbGroupID)
		THEN
		PROC_CharacterDisableAllCrimes((CHARACTER)_Undead);
		ApplyStatus(_Undead,"FOR_THAYAN_UNDEAD_SLUMBER",-1.0,1,_Undead);
		DB_FOR_ThayanCellar_SavedUndeadCombatInfo(_Undead,_Faction,_CmbGroupID);
		SetFaction(_Undead,ACT1_FOR_ThayanUndead_Neutral_StandUp_2b6426e3-6970-4fdd-82c9-850520e43fb1);
		SetCombatGroupID(_Undead,"");
		SetOnStage(_Undead, 0);
		
		PROC
		PROC_FOR_ThayanCellar_InitUndead()
		AND
		DB_FOR_ThayanCellar_UndeadContainer(_, _Undead)
		AND
		DB_FOR_ThayanCellar_UndeadContainer(_Casket, _OtherUndead)
		AND
		_Undead != _OtherUndead
		THEN
		AiAddInterestingItem((CHARACTER)_Undead, (ITEM)_Casket);
		
		//REGION Undead Appear
		PROC
		PROC_BlockUseOfItem(_Player, _Chest)
		AND
		DB_Players(_Player)
		AND
		DB_FOR_ThayanCellar_UndeadContainer(_Chest, _Undead)
		AND
		DB_FOR_ThayanCellar_AmbushStopped(0)
		THEN
		DB_CustomUseItemResponse(_Player, _Chest, 0);
		SetFlag((FLAG)FOR_ThayanCellar_State_TombOpened_a19ade94-68fe-42a0-9c7a-ee1c6338c10f, _Chest, 0);
		PROC_FOR_ThayanCellar_SkeletonEmerge((ITEM)_Chest, (CHARACTER)_Undead);
		
		IF
		UseStarted(_Char, _Chest)
		AND
		NOT DB_Players(_Char)
		AND
		DB_FOR_ThayanCellar_UndeadContainer(_Chest, _Undead)
		AND
		DB_FOR_ThayanCellar_AmbushStopped(0)
		THEN
		SetFlag((FLAG)FOR_ThayanCellar_State_TombOpened_a19ade94-68fe-42a0-9c7a-ee1c6338c10f, _Chest, 0);
		PROC_FOR_ThayanCellar_SkeletonEmerge((ITEM)_Chest, (CHARACTER)_Undead);
		
		PROC
		PROC_BlockUseOfItem(_Player, _Chest)
		AND
		DB_Players(_Player)
		AND
		DB_FOR_ThayanCellar_UndeadContainer(_Chest, _Undead)
		AND
		QRY_OnlyOnce("FOR_ThayanCellar_UndeadAmbush")
		THEN
		PROC_Ambush_SetPlayersSurprised(_Player);
		
		IF
		HitpointsChanged(_Chest, _Hitpoints)
		AND
		_Hitpoints != 100.0
		AND
		DB_FOR_ThayanCellar_UndeadContainer(_Chest, _Undead)
		AND
		DB_FOR_ThayanCellar_AmbushStopped(0)
		THEN
		SetFlag((FLAG)FOR_ThayanCellar_State_TombOpened_a19ade94-68fe-42a0-9c7a-ee1c6338c10f, _Chest, 0);
		PROC_FOR_ThayanCellar_SkeletonEmerge((ITEM)_Chest, (CHARACTER)_Undead);
		
		PROC
		PROC_FOR_ThayanCellar_SkeletonEmerge((ITEM)_Chest, (CHARACTER)_Undead)
		THEN
		PROC_FOR_ThayanCellar_TombDestroy((ITEM)_Chest, (CHARACTER)_Undead);
		
		PROC
		PROC_FOR_ThayanCellar_TombDestroy((ITEM)_Chest, (CHARACTER)_Undead)
		AND
		IsDestroyed((ITEM)_Chest, 0)
		THEN
		Die((ITEM)_Chest, DEATHTYPE.Physical, _Undead, 0, 0);
		
		IF
		DestroyedBy(_Chest,_,_,_)
		AND
		DB_FOR_ThayanCellar_AmbushStopped(0)
		AND
		DB_FOR_ThayanCellar_UndeadContainer(_Chest, _Undead)
		AND
		GetWorldTransformFromLocal(_Chest, 0.0, 0.0, 0.0, 0.0 ,-90.0, 0.0, _DestX, _Y, _DestZ, _RotX, _RotY, _RotZ)
		AND
		RealSum(_Y, 2.0, _DestY)
		THEN
		ToTransform(S_FOR_ThayG_SpawnHelper_86195bd5-840e-41f9-97cc-24cdfd30e3c9,_DestX, _DestY, _DestZ,0.0,_RotY,0.0);
		TeleportTo(_Undead,S_FOR_ThayG_SpawnHelper_86195bd5-840e-41f9-97cc-24cdfd30e3c9,"", 0, 0, 0, 0, 1);
		SetOnStage(_Undead,1);
		RealtimeObjectTimerLaunch(_Undead,"FOR_ThayanCellar_SkeletonRise",250);
		NOT DB_FOR_ThayanCellar_UndeadContainer(_Chest, _Undead);
		DB_FOR_ThayanCellar_ActiveUndead((CHARACTER)_Undead);
		PROC_FOR_ThayanCellar_TombCheck();
		SetEntityEvent(_Undead, "FOR_ThayanCellar_SkeletonReleased_QuestUpdate");
		
		IF
		ObjectTimerFinished(_Undead,"FOR_ThayanCellar_SkeletonRise")
		THEN
		RemoveStatus(_Undead,"FOR_THAYAN_UNDEAD_SLUMBER",_Undead);
		RealtimeObjectTimerLaunch(_Undead,"FOR_ThayanCellar_SkeletonFinishStandUpAnimation",2700);
		
		IF
		ObjectTimerFinished(_Undead,"FOR_ThayanCellar_SkeletonFinishStandUpAnimation")
		AND
		DB_FOR_ThayanCellar_SavedUndeadCombatInfo((CHARACTER)_Undead,_Faction,_CmbGroupID)
		THEN
		NOT DB_FOR_ThayanCellar_SavedUndeadCombatInfo(_Undead,_Faction,_CmbGroupID);
		SetFlag(FOR_ThayanCellar_State_OutOfCrypt_a5f29cbf-abb5-4530-be4a-cda4a26832fe,_Undead);
		SetFaction(_Undead,_Faction);
		SetCombatGroupID(_Undead,_CmbGroupID);
		
		PROC
		PROC_FOR_ThayanCellar_TombCheck()
		AND
		NOT DB_FOR_ThayanCellar_UndeadContainer(_, _)
		THEN
		SetFlag((FLAG)FOR_ThayanCellar_State_TombsEmpty_808119f1-b6c7-4d85-8831-77b404e77105, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		//END_REGION
		
		//END_REGION
		
		//REGION Book Trap
		
		IF
		DualEntityEvent(_Player, S_FOR_BookTrapPressurePlate_e444dd79-e81b-40bf-918e-fa3976219af7, "FOR_ThayanCellar_FrontPressurePlate_Pressed")
		AND
		DB_FOR_ThayanCellar_Braziers(_Brazier)
		AND
		HasActiveStatus(_Brazier, "BURNING", 0)
		THEN
		ApplyStatus(_Brazier, "BURNING", -1.0, 1);
		
		IF
		DualEntityEvent(_Player, S_FOR_BookPressurePlate_8288ace1-357d-417a-98e3-1ec7ade1e05d, "FOR_ThayanCellar_BookPressurePlate_Pressed")
		THEN
		Close(S_FOR_BookCellDoor_7ac6feab-91dc-40bd-a9a8-e7bc8ba2abf8);
		Lock(S_FOR_BookCellDoor_7ac6feab-91dc-40bd-a9a8-e7bc8ba2abf8, "FOR_BookCellKey");
		
		IF
		DualEntityEvent(_Player, S_FOR_BookPressurePlate_8288ace1-357d-417a-98e3-1ec7ade1e05d, "FOR_ThayanCellar_BookPressurePlate_Pressed")
		THEN
		TimerLaunch("FOR_ThayanCellar_BookTrap_FTBDelay", 1000);
		
		IF
		TimerFinished("FOR_ThayanCellar_BookTrap_FTBDelay")
		AND
		DB_InRegion(_TrapVictim, (TRIGGER)S_FOR_ThayanCellar_CellarTrapTrigger_3a2b26ca-6705-4f68-b5ee-e29633023f87)
		THEN
		ForceTurnBasedMode(_TrapVictim, 1);
		
		IF
		LeftTrigger(_Character, S_FOR_ThayanCellar_CellarTrapTrigger_3a2b26ca-6705-4f68-b5ee-e29633023f87)
		AND
		NOT QRY_TriggerEvents_AnyNotDefeatedPartyMemberInTrigger((TRIGGER)S_FOR_ThayanCellar_CellarTrapTrigger_3a2b26ca-6705-4f68-b5ee-e29633023f87)
		THEN
		SetDualEntityEvent(_Character, S_FOR_ThayanTurret_001_da680b84-21b6-4daf-a9a0-7c5d24ddbdd0, "FOR_ThayanCellar_BookPressurePlate_UnPressed");
		SetDualEntityEvent(_Character, S_FOR_ThayanTurret_000_1a2f60cd-1038-49c7-a3f4-56ad9e760ef5, "FOR_ThayanCellar_BookPressurePlate_UnPressed");
		
		IF
		DB_Defeated(_Character)
		AND
		DB_InRegion((CHARACTER)_Character, (TRIGGER)S_FOR_ThayanCellar_CellarTrapTrigger_3a2b26ca-6705-4f68-b5ee-e29633023f87)
		AND
		NOT QRY_TriggerEvents_AnyNotDefeatedPartyMemberInTrigger((TRIGGER)S_FOR_ThayanCellar_CellarTrapTrigger_3a2b26ca-6705-4f68-b5ee-e29633023f87)
		THEN
		SetDualEntityEvent(_Character, S_FOR_ThayanTurret_001_da680b84-21b6-4daf-a9a0-7c5d24ddbdd0, "FOR_ThayanCellar_BookPressurePlate_UnPressed");
		SetDualEntityEvent(_Character, S_FOR_ThayanTurret_000_1a2f60cd-1038-49c7-a3f4-56ad9e760ef5, "FOR_ThayanCellar_BookPressurePlate_UnPressed");
		//END_REGION
		
		//REGION Quasit summon
		IF
		DB_PlayerSummons(_Quasit)
		AND
		GetTemplate(_Quasit, QUEST_FOR_QuasitSummon_000c1be8-615a-4324-b59d-1f0f5637df36)
		THEN
		PROC_FOR_ThayanCellar_SetAndStartDialog(_Quasit);
		
		PROC
		PROC_FOR_ThayanCellar_SetAndStartDialog((CHARACTER)_Quasit)
		THEN
		DB_Dialogs(_Quasit, (DIALOGRESOURCE)FOR_ThayanCellar_QuasitSummon_7b661231-3d26-6ab4-2dae-9cbd4d0cc848);
		
		PROC
		PROC_FOR_ThayanCellar_SetAndStartDialog((CHARACTER)_Quasit)
		AND
		NOT DB_OnlyOnce("FOR_StartedQuasitDialog")
		AND
		CharacterGetOwner(_Quasit, _Owner)
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)FOR_ThayanCellar_QuasitSummon_7b661231-3d26-6ab4-2dae-9cbd4d0cc848, _Quasit, _Owner)
		AND
		QRY_OnlyOnce("FOR_StartedQuasitDialog")
		THEN
		DB_NOOP(1);
		
		//Reaction to the trap
		IF
		DB_FOR_ThayanCellar_TrapActive(1)
		AND
		DB_PlayerSummons(_Quasit)
		AND
		GetTemplate(_Quasit, QUEST_FOR_QuasitSummon_000c1be8-615a-4324-b59d-1f0f5637df36)
		AND
		DB_InRegion(_Quasit, (TRIGGER)S_FOR_OrbAndSkeletonsRoom_dff5d215-e4c9-42cb-abb3-cfc288ff8fc1)
		AND
		QRY_OnlyOnce("FOR_ThayanCellar_QuasitReacts")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)FOR_ThayanCellar_AD_QuasitReactsToTrap_c8e888fa-ea4f-1f7b-2e1b-693b5797858e, _Quasit);
		
		IF //Change display name based on the name the player chooses.
		FlagSet(_NameFlag, _Quasit, _)
		AND
		DB_FOR_ThayanCellar_QuasitNames((FLAG)_NameFlag, (STRING)_NameKey)
		THEN
		SetStoryDisplayName((CHARACTER)_Quasit, _NameKey);
		DB_GLO_Quasit_Name((FLAG)_NameFlag, (STRING)_NameKey);
		
		//END_REGION
		
		//REGION Sound
		
		IF
		ItemEnteredTrigger(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1,S_FOR_ThayanOrb_MirrorBox_bb4820dd-89ce-4ab0-8554-557a5bb3fc67,_)
		AND
		NOT DB_FOR_ThayanCellar_TrapActiveOnDeactivationPath(1)
		THEN
		PlaySound(S_FOR_MagicMirror_7b0d83fb-8cda-4b55-b1b7-fa5073ae5c89,"SE_PUZ_GEN_Orb_Magical_A_ThruMirror_Enter");
		
		IF
		ItemEnteredTrigger(S_FOR_ThayanOrb_c9b5f985-466d-41d4-88fd-adfa999aaeb1,S_FOR_ThayanOrb_MirrorBox_bb4820dd-89ce-4ab0-8554-557a5bb3fc67,_)
		AND
		DB_FOR_ThayanCellar_TrapActiveOnDeactivationPath(1)
		THEN
		NOT DB_FOR_ThayanCellar_TrapActiveOnDeactivationPath(1);
		PlaySound(S_FOR_MagicMirror_7b0d83fb-8cda-4b55-b1b7-fa5073ae5c89,"SE_PUZ_GEN_Orb_Magical_A_ThruMirror_Exit");
		
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(158).Title("Act1_FOR_UnfortunateGnomeFree");
Goal(158)
{
	INIT
	{
		DB_HasItemTemplateScriptFlag(1, (DIALOGRESOURCE)FOR_UnfortunateGnome_eb447f2f-14f4-df3f-24d3-f2aa0b2bc4f4, GRN_Bomb_A_278271f9-3fbc-4cf7-a5dc-b36527f521b2, 1, 1);
	}
	KB
	{
		IF
		EntityEvent(S_FOR_UnfortunateGnome_6e45a00b-bad2-40bb-9403-147b9e92d976, "HAV_SavingPrisoners_BarcusToHaven")
		THEN
		GoalCompleted;
		
		//REGION Thanking of players.
		
		PROC
		PROC_SpotPlayers_Spotted(S_FOR_UnfortunateGnome_6e45a00b-bad2-40bb-9403-147b9e92d976, "FOR_UnfortunateGnome", _Player)
		AND
		NOT QRY_StartDialog(DIALOGRESOURCEGUID_FOR_UnfortunateGnome_eb447f2f-14f4-df3f-24d3-f2aa0b2bc4f4, S_FOR_UnfortunateGnome_6e45a00b-bad2-40bb-9403-147b9e92d976, _Player)
		THEN
		DB_NOOP(1);
		
		IF
		InstanceDialogChanged(_, _, (DIALOGRESOURCE)FOR_UnfortunateGnome_eb447f2f-14f4-df3f-24d3-f2aa0b2bc4f4, _)
		THEN
		PROC_SpotPlayers_StopSpotting(S_FOR_UnfortunateGnome_6e45a00b-bad2-40bb-9403-147b9e92d976, "FOR_UnfortunateGnome");
		
		IF
		DialogStarted(DIALOGRESOURCEGUID_FOR_UnfortunateGnome_eb447f2f-14f4-df3f-24d3-f2aa0b2bc4f4, _)
		THEN
		PROC_SpotPlayers_StopSpotting(S_FOR_UnfortunateGnome_6e45a00b-bad2-40bb-9403-147b9e92d976, "FOR_UnfortunateGnome");
		
		IF
		NestedDialogPlayed(DIALOGRESOURCEGUID_FOR_UnfortunateGnome_eb447f2f-14f4-df3f-24d3-f2aa0b2bc4f4, _ID)
		THEN
		DB_FOR_UnfortunateGnome_WasUnfortunateGnomeDialog(_ID);
		
		IF
		DialogEnded(_, _ID)
		AND
		DB_FOR_UnfortunateGnome_WasUnfortunateGnomeDialog(_ID)
		THEN
		PROC_FOR_UnfortunateGnome_UnfortunateGnomeDialogEnded(_ID);
		
		IF
		DialogEnded(DIALOGRESOURCEGUID_FOR_UnfortunateGnome_eb447f2f-14f4-df3f-24d3-f2aa0b2bc4f4, _ID)
		THEN
		PROC_FOR_UnfortunateGnome_UnfortunateGnomeDialogEnded(_ID);
		
		PROC
		PROC_FOR_UnfortunateGnome_UnfortunateGnomeDialogEnded((INTEGER)_ID)
		AND
		NOT DB_GlobalFlag((FLAG)UND_DuergarGuards_State_PermaDefeated_b2211d1b-3dea-9b74-b19c-71938ac4b218) // flagType: Global
		AND
		NOT DB_GlobalFlag((FLAG)UND_UnfortunateGnome_State_Freed_ce63b2ca-4692-551f-db78-0bff8dd0da6d) // flagType: Global
		AND
		DB_DialogPlayers(_ID, _Player, 1)
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_FOR_UnfortunateGnome_6e45a00b-bad2-40bb-9403-147b9e92d976);
		SetHasDialog(S_FOR_UnfortunateGnome_6e45a00b-bad2-40bb-9403-147b9e92d976, 0);
		PROC_FOR_UnfortunateGnome_RunAway("FOR_UnfortunateGnome_RanAway");
		QuestUpdate((CHARACTER)_Player, "FOR_UnfortunateGnome", "GnomeNotToCamp");
		
		
		PROC
		PROC_FOR_UnfortunateGnome_UnfortunateGnomeDialogEnded((INTEGER)_ID)
		AND
		DB_GlobalFlag((FLAG)UND_DuergarGuards_State_PermaDefeated_b2211d1b-3dea-9b74-b19c-71938ac4b218) // flagType: Global
		AND
		NOT DB_GlobalFlag((FLAG)UND_UnfortunateGnome_State_Freed_ce63b2ca-4692-551f-db78-0bff8dd0da6d) // flagType: Global //Player decided not to invite him along.
		AND
		DB_DialogPlayers(_ID, _Player, 1)
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_FOR_UnfortunateGnome_6e45a00b-bad2-40bb-9403-147b9e92d976);
		SetHasDialog(S_FOR_UnfortunateGnome_6e45a00b-bad2-40bb-9403-147b9e92d976, 0);
		PROC_FOR_UnfortunateGnome_RunAway("FOR_UnfortunateGnome_CapturedAgain");
		QuestUpdate((CHARACTER)_Player, "FOR_UnfortunateGnome", "GnomeNotToCamp");
		
		PROC
		PROC_FOR_UnfortunateGnome_UnfortunateGnomeDialogEnded((INTEGER)_ID)
		AND
		DB_GlobalFlag((FLAG)UND_UnfortunateGnome_State_Freed_ce63b2ca-4692-551f-db78-0bff8dd0da6d) // flagType: Global
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_FOR_UnfortunateGnome_6e45a00b-bad2-40bb-9403-147b9e92d976);
		SetHasDialog(S_FOR_UnfortunateGnome_6e45a00b-bad2-40bb-9403-147b9e92d976,0);
		
		PROC
		PROC_FOR_UnfortunateGnome_UnfortunateGnomeDialogEnded((INTEGER)_ID)
		AND
		DB_GlobalFlag((FLAG)UND_UnfortunateGnome_State_Freed_ce63b2ca-4692-551f-db78-0bff8dd0da6d) // flagType: Global
		AND
		NOT DB_GlobalFlag((FLAG)FOR_UnfortunateGnome_Event_Run_3d6b6f85-e976-d687-e5b1-78785064fb17)
		AND
		DB_DialogPlayers(_ID, _Player, 1)
		THEN
		PROC_FOR_UnfortunateGnome_RunAway("UND_UnfortunateGnome_RanAwayToCamp");
		QuestUpdate((CHARACTER)_Player, "FOR_UnfortunateGnome", "GnomeToCamp");
		
		PROC
		PROC_FOR_UnfortunateGnome_UnfortunateGnomeDialogEnded((INTEGER)_ID)
		AND
		DB_GlobalFlag((FLAG)UND_UnfortunateGnome_State_Freed_ce63b2ca-4692-551f-db78-0bff8dd0da6d) // flagType: Global
		AND
		NOT DB_GlobalFlag((FLAG)FOR_UnfortunateGnome_Event_Run_3d6b6f85-e976-d687-e5b1-78785064fb17)
		AND
		DB_DialogPlayers(_ID, _Player, 1)
		THEN
		PROC_FOR_UnfortunateGnome_RunAway("");
		QuestUpdate((CHARACTER)_Player, "FOR_UnfortunateGnome", "GnomeNotToCamp");
		
		PROC
		PROC_LevelUnloading("WLD_Main_A")
		AND
		DB_FOR_GnomeGoblins(_Goblin, _, _, _)
		AND
		NOT DB_PermaDefeated(_Goblin)
		AND
		IsOnStage(_Goblin, 1)
		THEN
		SetOnStage(_Goblin, 0);
		SetEntityEvent(_Goblin, "FOR_GnomeGoblinsReturnedHome");
		SetFlag((FLAG)FOR_GnomeGoblinsReturnedHome_be23fd5b-22ed-b163-0204-779faf6e131c, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		PROC_RemoveDBTrespassTrigger(TRIGGERGUID_S_WLD_WIL_NearCapturedGnome_a877c0ce-1016-4120-9c51-6557fea123b0, NULL_00000000-0000-0000-0000-000000000000);
		
		//END_REGION
		
		
		//REGION Unfortunate Gnome Leaves
		PROC
		PROC_FOR_UnfortunateGnome_RunAway((STRING)_Event)
		AND
		IsInTrigger(S_FOR_UnfortunateGnome_6e45a00b-bad2-40bb-9403-147b9e92d976, S_FOR_UnfortunateGnome_WindmillArea_4bc3d6c1-bb2d-4497-87cd-a4496af65d67, 1)
		THEN
		PROC_DisappearOutOfSightTo(S_FOR_UnfortunateGnome_6e45a00b-bad2-40bb-9403-147b9e92d976, S_GOB_GnomeGoblinDestination_5418547b-f831-4598-99fe-741ba7985e0a, "Run", 0, _Event);
		
		PROC
		PROC_FOR_UnfortunateGnome_RunAway((STRING)_Event)
		AND
		IsInTrigger(S_FOR_UnfortunateGnome_6e45a00b-bad2-40bb-9403-147b9e92d976, S_FOR_UnfortunateGnome_WindmillArea_4bc3d6c1-bb2d-4497-87cd-a4496af65d67, 0)
		THEN
		PROC_DisappearOutOfSight(S_FOR_UnfortunateGnome_6e45a00b-bad2-40bb-9403-147b9e92d976,"Run",0,_Event);
		
		//END_REGION
		
		//REGION Unfortunate Gnome can be flung off
		
		IF
		DialogEnded(FOR_UnfortunateGnome_SpeedUp_b7098519-067a-43ee-1446-1ef3a604de87, _ID)
		AND
		DB_FOR_UnfortunateGnome_ThrowOffDialog(_ID)
		AND
		NOT DB_GlobalFlag((FLAG)FOR_GnomeGoblinsPacified_385336a9-30d7-f4f8-fa62-32dff47ff714)
		AND
		NOT QRY_StartDialog(DIALOGRESOURCEGUID_FOR_GnomeGoblin1_AD_InvestigateMill_cf27ec59-299d-7a19-7d1b-7a20b4c4a7e3, S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, S_FOR_GnomeGoblin3_bff8ab5f-739d-422a-9ad3-92f4b897f1bc)
		AND
		DB_FOR_UnfortunateGnome_GnomeInvestiGoblins(_, _Goblin, 1)
		THEN
		SetEntityEvent(_Goblin, "FOR_GnomeGoblins_Investigate");
		
		IF
		AutomatedDialogEnded(DIALOGRESOURCEGUID_FOR_GnomeGoblin1_AD_InvestigateMill_cf27ec59-299d-7a19-7d1b-7a20b4c4a7e3, _)
		AND
		DB_FOR_UnfortunateGnome_GnomeInvestiGoblins(_, _Goblin, 1)
		AND
		NOT DB_GlobalFlag((FLAG)FOR_GnomeGoblinsPacified_385336a9-30d7-f4f8-fa62-32dff47ff714)
		THEN
		SetEntityEvent(_Goblin, "FOR_GnomeGoblins_Investigate");
		
		IF
		DialogEnded(FOR_UnfortunateGnome_SlowDown_e5a2eee5-2eef-e746-ff88-a461d03e336c, _ID)
		AND
		DB_FOR_UnfortunateGnome_ThrowOffDialog(_ID)
		AND
		DB_FOR_UnfortunateGnome_GnomeInvestiGoblins(_, _Goblin, 1)
		THEN
		SetEntityEvent(_Goblin, "FOR_GnomeGoblins_Investigate");
		
		
		//END_REGION
		
	}
	EXIT
	{
	}
}
Goal(159).Title("Act1_FOR_UnfortunateGnomeGen");
Goal(159)
{
	INIT
	{
		DB_PreventKnockedOutPermaDefeated((CHARACTER)FOR_GnomeGoblin1_6b85e9ac-82c4-9126-cce2-4d0259475ae9);
		
		DB_GLO_CharacterCorpseDialog(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, (DIALOGRESOURCE)FOR_GnomeGoblin1_Dead_4e00a2b1-a251-d4a2-7da7-3c6dbbac8fed);
		DB_GLO_CharacterCorpseDialog(S_FOR_UnfortunateGnome_6e45a00b-bad2-40bb-9403-147b9e92d976, FOR_UnfortunateGnome_Dead_bedf63dc-6459-b784-063f-26c24f2706f5);
		
		PROC_TriggerRegisterForPlayers(S_FOR_GnomeGoblinApproach_5f593aa2-5e02-4da4-821c-c19390730370);
		DB_QuestDef_State(FOR_GnomeGoblinsDead_8910f084-c9ad-2336-c6a7-098d71914529, "FOR_UnfortunateGnome", "Defeated");
		DB_QuestDef_State(FOR_GnomeGoblinsPacified_385336a9-30d7-f4f8-fa62-32dff47ff714, "FOR_UnfortunateGnome", "Pacified");
		DB_QuestDef_State(WLD_FOR_GnomeGoblinsAngry_42a4e444-5e6e-c574-f360-ea3cf57e4426, "FOR_UnfortunateGnome", "GoblinsAttacked");
		DB_QuestDef_State(FOR_UnfortunateGnome_State_FoundDead_52305f06-b315-4eaa-b39b-4f3c4afd98bd, "FOR_UnfortunateGnome", "GnomeDied");
		
		DB_DeadOnceFlag(S_FOR_UnfortunateGnome_6e45a00b-bad2-40bb-9403-147b9e92d976, FOR_UnfortunateGnome_State_FoundDead_52305f06-b315-4eaa-b39b-4f3c4afd98bd);
		
		DB_SurrenderManually(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404);
		DB_Surrender_BlockPermaDefeatedOnFlee(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404);
		
		DB_FOR_GnomeGoblin1_SurrenderDialogues((DIALOGRESOURCE)FOR_GnomeGoblin1_Surrender_NotAtWindmill_10513b6f-5dd7-0578-87e3-b91a9db98659);
		
		PROC_TriggerRegisterForParty((TRIGGER)S_FOR_UnfortunateGnome_WindmillForceActivation_3b494ddd-a226-4fe3-905d-49e1546559fa);
		
		SetCanFight(S_FOR_UnfortunateGnome_6e45a00b-bad2-40bb-9403-147b9e92d976, 0);
		
		DB_AddCharactersInTriggerToDialog(FOR_UnfortunateGnome_SlowDown_NoGoblins_8859f0e0-0d0b-e54f-c141-7dff95ae05a4, S_FOR_UnfortunateGnome_SlowDown_NoGoblins_Trigger_5ee4c342-324b-4931-bd1b-24c95a1ea306, 1, 1, 1, 1);
	}
	KB
	{
		IF
		EntityEvent(_Goblin, "FOR_GnomeGoblinsReturnedHome")
		AND
		DB_FOR_GnomeGoblins((CHARACTER)_Goblin, _Trigger, _Dialog, _Time)
		AND
		_Trigger != NULL_00000000-0000-0000-0000-000000000000
		THEN
		DB_MOO_GnomeGoblins(_Goblin, _Trigger);
		NOT DB_FOR_GnomeGoblins((CHARACTER)_Goblin, _Trigger, _Dialog, _Time);
		SetFlag((FLAG)FOR_GnomeGoblinsReturnedHome_be23fd5b-22ed-b163-0204-779faf6e131c, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		PROC_RemoveDBTrespassTrigger(TRIGGERGUID_S_WLD_WIL_NearCapturedGnome_a877c0ce-1016-4120-9c51-6557fea123b0, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		FlagSet(WLD_FOR_GnomeGoblinsPacified_385336a9-30d7-f4f8-fa62-32dff47ff714, _, _) // flagType: Global
		THEN
		ClearOwnership(S_FOR_UnfortunateGnome_Lever_50b03092-6db1-4469-b21d-2104758ce130);
		ClearOwnership(S_FOR_UnfortunateGnome_Lever2_3c4f6a14-7b10-48ec-ace1-6324142cb994);
		
		IF
		FlagSet(WLD_FOR_GnomeGoblinsPacified_385336a9-30d7-f4f8-fa62-32dff47ff714, _, _) // flagType: Global
		AND
		DB_FOR_GnomeGoblins((CHARACTER)_Goblin, NULL_00000000-0000-0000-0000-000000000000, _Dialog, _Time)
		AND
		NOT DB_PermaDefeated(_Goblin)
		THEN
		PROC_PeacefulResolve((CHARACTER)_Goblin);
		
		
		IF
		EntityEvent(_, "FOR_GnomeGoblinsReturnedHome")
		THEN
		ClearOwnership(S_FOR_UnfortunateGnome_Lever_50b03092-6db1-4469-b21d-2104758ce130);
		ClearOwnership(S_FOR_UnfortunateGnome_Lever2_3c4f6a14-7b10-48ec-ace1-6324142cb994);
		
		IF
		AddedTo(S_FOR_UnfortunateGnome_BlackpowderSatchel_67a1414e-354e-433a-9ca5-745bd688c939, _Player, _)
		AND
		DB_Players((CHARACTER)_Player)
		THEN
		SetFlag(FOR_UnfortunateGnome_Knows_GnomeHasSmokepowder_d4938986-e88c-49f5-1d35-b7c359bc3a3f, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		//REGION Finding the backpack
		IF
		FlagSet((FLAG)FOR_UnfortunateGnome_Event_OfferedPack_a32084eb-7edc-d5bb-3d61-393684ec8213, _Player, _)
		AND
		NOT DB_GlobalFlag((FLAG)FOR_UnfortunateGnome_State_FoundBackpack_578a8d46-8f84-4ae9-811a-4e89c9f3de27)
		THEN
		PROC_UnlockPartyMarker("FOR_UnfortunateGnome_Backpack");
		PROC_UnlockPartyMarker("FOR_UnfortunateGnome_Backpack_Basement");
		
		IF
		FlagSet((FLAG)FOR_UnfortunateGnome_State_FoundBackpack_578a8d46-8f84-4ae9-811a-4e89c9f3de27, _, _)
		THEN
		PROC_HidePartyMarker("FOR_UnfortunateGnome_Backpack");
		PROC_HidePartyMarker("FOR_UnfortunateGnome_Backpack_Basement");
		
		IF
		Opened(S_FOR_UnfortunateGnome_Backpack_1075f497-108e-4697-90d1-4615963614f3)
		THEN
		SetFlag((FLAG)FOR_UnfortunateGnome_State_FoundBackpack_578a8d46-8f84-4ae9-811a-4e89c9f3de27);
		
		IF
		DestroyedBy(S_FOR_UnfortunateGnome_Backpack_1075f497-108e-4697-90d1-4615963614f3, _, _, _)
		THEN
		SetFlag((FLAG)FOR_UnfortunateGnome_State_FoundBackpack_578a8d46-8f84-4ae9-811a-4e89c9f3de27);
		
		IF
		Moved(S_FOR_UnfortunateGnome_Backpack_1075f497-108e-4697-90d1-4615963614f3)
		THEN
		SetFlag((FLAG)FOR_UnfortunateGnome_State_FoundBackpack_578a8d46-8f84-4ae9-811a-4e89c9f3de27);
		//END_REGION
		
		//REGION Surrender
		IF
		HitpointsChanged(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, _Percent)
		AND
		DB_Is_InCombat(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, _CombatID)
		AND
		_Percent < 25.0
		AND
		_Percent > 0.0
		AND
		NOT DB_MOO_GnomeGoblins((CHARACTER)S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, _) //Don't do this if he's in MOO.
		AND
		NOT DB_Defeated(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404)
		AND
		NOT DB_OnlyOnce("FOR_GnomeGoblin_Surrender")
		AND
		QRY_Surrender_GetSurrenderCause((CHARACTER)S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404)
		AND
		DB_QRYRTN_Surrender_GetSurrenderCause(_Cause)
		THEN
		PROC_Surrender(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404,_Cause);
		ClearOwnership(S_FOR_UnfortunateGnome_Lever_50b03092-6db1-4469-b21d-2104758ce130);
		ClearOwnership(S_FOR_UnfortunateGnome_Lever2_3c4f6a14-7b10-48ec-ace1-6324142cb994);
		PROC_RemoveDBTrespassTrigger(TRIGGERGUID_S_WLD_WIL_NearCapturedGnome_a877c0ce-1016-4120-9c51-6557fea123b0, NULL_00000000-0000-0000-0000-000000000000);
		SetFlag(WLD_FOR_GnomeGoblinStopSpot_283b6c8d-77e3-4575-8262-3d729a3b36ec, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		QRY
		QRY_Surrender_StartCustomDialogAfterCombat((CHARACTER)_Player, (CHARACTER)S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, (GUIDSTRING)_CombatID)
		AND
		NOT DB_FOR_UnfortunateGnomeGone(1)
		AND
		NOT QRY_StartDialog_Fixed((DIALOGRESOURCE)FOR_GnomeGoblin1_Surrender_NotAtWindmill_10513b6f-5dd7-0578-87e3-b91a9db98659, S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, _Player)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_Surrender_StartCustomDialogAfterCombat((CHARACTER)_Player, (CHARACTER)S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, (GUIDSTRING)_CombatID)
		THEN
		DB_NOOP(1);
		
		IF
		TextEvent("FOR_GnomeGoblin_Surrender")
		THEN
		PROC_SetHitpoints_BlockSelfHealing(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, 1);
		
		IF
		EntityEvent(S_FOR_UnfortunateGnome_6e45a00b-bad2-40bb-9403-147b9e92d976,"FOR_UnfortunateGnome_RanAway")
		THEN
		DB_FOR_UnfortunateGnomeGone(1);
		
		IF
		EntityEvent(S_FOR_UnfortunateGnome_6e45a00b-bad2-40bb-9403-147b9e92d976,"UND_UnfortunateGnome_RanAwayToCamp")
		THEN
		DB_FOR_UnfortunateGnomeGone(1);
		
		PROC
		PROC_Surrendered(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404,(CHARACTER)_Cause)
		THEN
		DB_OnlyOnce("FOR_GnomeGoblin_Surrender");
		SetFlag((FLAG)FOR_GnomeGoblinsDead_8910f084-c9ad-2336-c6a7-098d71914529, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetHasDialog(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, 1);
		DB_Dialogs((CHARACTER)S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, FOR_GnomeGoblin1_Surrender_NotAtWindmill_10513b6f-5dd7-0578-87e3-b91a9db98659);
		
		PROC
		PROC_Surrendered(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404,(CHARACTER)_Cause)
		AND
		DB_GLO_DefeatCounter(_Goblin, "FOR_GnomeGoblins")
		THEN
		NOT DB_GLO_DefeatCounter(_Goblin, "FOR_GnomeGoblins");
		
		QRY
		QRY_CustomSurrenderReaction(_Goblin)
		AND
		DB_FOR_GnomeGoblins((CHARACTER)_Goblin, _, _, _)
		AND
		_Goblin != S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404
		AND
		NOT DB_CantMove(_Goblin)
		THEN
		PROC_SetCanFight(_Goblin, 0);
		SetCanJoinCombat(_Goblin, 0);
		PROC_RemoveDialog(_Goblin);
		PROC_CharacterDisableAllCrimes(_Goblin, 1);
		DisappearOutOfSightTo(_Goblin, TRIGGERGUID_S_GOB_GnomeGoblinDestination_5418547b-f831-4598-99fe-741ba7985e0a, "Run", 0, "FOR_GnomeGoblinsReturnedHome");
		
		IF
		DialogEnded(_Dialog, _Id)
		AND
		DB_FOR_GnomeGoblin1_SurrenderDialogues(_Dialog)
		AND
		NOT DB_CharacterDieAfterDialog(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404,_Id)
		AND
		QRY_OnlyOnce("FOR_GnomeGoblin_ReadyToUnsurrender")
		THEN
		PROC_FOR_UnfortunateGnome_LeaderReadyToUnsurrender();
		
		PROC
		PROC_FOR_UnfortunateGnome_LeaderReadyToUnsurrender()
		AND
		NOT DB_GlobalFlag((FLAG)FOR_GnomeGoblin1_State_SurrenderWait_afe2158b-f792-73e7-ea12-3b4584a0adb6)
		THEN
		PROC_FOR_UnfortunateGnome_LeaderUnsurrender();
		
		PROC
		PROC_FOR_UnfortunateGnome_LeaderReadyToUnsurrender()
		AND
		DB_GlobalFlag((FLAG)FOR_GnomeGoblin1_State_SurrenderWait_afe2158b-f792-73e7-ea12-3b4584a0adb6)
		AND
		NOT DB_FOR_UnfortunateGnome_WaitForLeaderToBeLooted(1)
		THEN
		DB_FOR_UnfortunateGnome_WaitForLeaderToBeLooted(1);
		
		IF
		DB_GlobalFlag(FOR_GnomeGoblin1_Surrender_State_WasLooted_c18311c3-a783-4cbb-6eb0-4d4b6c5fbd51)
		AND
		DB_FOR_UnfortunateGnome_WaitForLeaderToBeLooted(1)
		THEN
		NOT DB_FOR_UnfortunateGnome_WaitForLeaderToBeLooted(1);
		PROC_FOR_UnfortunateGnome_LeaderUnsurrender();
		
		//Cautionary fallbacks, though WasLooted should be set long before
		IF
		LeftTrigger(_Player, S_FOR_ForestVillage_SUB_21e6bfbf-c5c9-4e99-97f8-2df7143967c4)
		AND
		DB_PartyMembers(_Player)
		AND
		QRY_AnyPartyMemberInTrigger(S_FOR_ForestVillage_SUB_21e6bfbf-c5c9-4e99-97f8-2df7143967c4)
		AND
		DB_FOR_UnfortunateGnome_WaitForLeaderToBeLooted(1)
		THEN
		NOT DB_FOR_UnfortunateGnome_WaitForLeaderToBeLooted(1);
		PROC_FOR_UnfortunateGnome_LeaderUnsurrender();
		
		IF
		DB_PermaDefeated(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404)
		AND
		DB_FOR_UnfortunateGnome_WaitForLeaderToBeLooted(1)
		THEN
		NOT DB_FOR_UnfortunateGnome_WaitForLeaderToBeLooted(1);
		
		PROC
		PROC_LongRest()
		AND
		DB_FOR_UnfortunateGnome_WaitForLeaderToBeLooted(1)
		THEN
		NOT DB_FOR_UnfortunateGnome_WaitForLeaderToBeLooted(1);
		PROC_FOR_UnfortunateGnome_LeaderUnsurrender();
		
		PROC
		PROC_FOR_UnfortunateGnome_LeaderUnsurrender()
		AND
		QRY_OnlyOnce("FOR_GnomeGoblin_Unsurrendered")
		AND
		DB_Surrender_FightStats(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, _HadBlockRegen,_CouldFight,_CouldJoinCombat)
		THEN
		NOT DB_Surrender_FightStats(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, _HadBlockRegen,_CouldFight,_CouldJoinCombat);
		DB_Surrender_FightStats(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, _HadBlockRegen, 0, 0);
		PROC_Unsurrender(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, NULL_00000000-0000-0000-0000-000000000000);
		// Prevent him from reacting to the players trespassing the abandoned village
		BlockNewCrimeReactions(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, 1);
		PROC_SetCanFight(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, 0);
		SetCanJoinCombat(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, 0);
		PROC_RemoveDialog((CHARACTER)S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404);
		DisappearOutOfSightTo(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, TRIGGERGUID_S_GOB_GnomeGoblinDestination_5418547b-f831-4598-99fe-741ba7985e0a, "Run", 0, "FOR_GnomeGoblinsReturnedHome");
		
		PROC
		PROC_Surrender_Fled(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404)
		AND
		QRY_OnlyOnce("FOR_GnomeGoblin_Unsurrendered")
		THEN
		PROC_Unsurrender(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, NULL_00000000-0000-0000-0000-000000000000);
		BlockNewCrimeReactions(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, 0);
		SetEntityEvent(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, "FOR_GnomeGoblinsReturnedHome");
		
		IF
		DB_KnockedOut((CHARACTER)S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404)
		AND
		NOT DB_MOO_GnomeGoblins((CHARACTER)S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, _)
		THEN
		DB_Surrendered((CHARACTER)S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404);
		
		IF
		DB_Surrendered((CHARACTER)S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404)
		AND
		NOT DB_MOO_GnomeGoblins((CHARACTER)S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, _)
		THEN
		DB_Dialogs((CHARACTER)S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, (DIALOGRESOURCE)FOR_GnomeGoblin1_Surrender_NotAtWindmill_10513b6f-5dd7-0578-87e3-b91a9db98659);
		
		//END_REGION
		
		//REGION Once surrendered, the goblin may need to give a refund.
		PROC
		PROC_TransferMoneyInDialog(_ID,_Amount,_Character,_)
		AND
		DB_DialogName(WLD_GnomeGoblin1_6b85e9ac-82c4-9126-cce2-4d0259475ae9 ,_ID)
		AND
		DB_TransferMoneyInDialog_Succeeded(1)
		THEN
		SetFlag(FOR_GnomeGoblin1_State_PaidUser_b6860204-39d8-4b0f-8986-fac162dd23c9, _Character, 0);
		DB_DialogMoneyTransfer(1, (DIALOGRESOURCE)FOR_GnomeGoblin1_Surrender_NotAtWindmill_10513b6f-5dd7-0578-87e3-b91a9db98659, _Amount, 1);
		
		IF
		CharacterLootedCharacter(_, S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404)
		THEN
		SetFlag(FOR_GnomeGoblin1_Surrender_State_WasLooted_c18311c3-a783-4cbb-6eb0-4d4b6c5fbd51, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		//END_REGION
		
		//REGION Journal updates
		IF
		EnteredTrigger(_Player, S_FOR_GnomeGoblinApproach_5f593aa2-5e02-4da4-821c-c19390730370)
		AND
		DB_FOR_UnfortunateGnome_OnWindMill((CHARACTER)S_FOR_UnfortunateGnome_6e45a00b-bad2-40bb-9403-147b9e92d976)
		AND
		NOT DB_GlobalFlag(FOR_GnomeGoblinsDead_8910f084-c9ad-2336-c6a7-098d71914529)
		AND
		NOT DB_GlobalFlag(FOR_GnomeGoblinsPacified_385336a9-30d7-f4f8-fa62-32dff47ff714)
		THEN
		QuestUpdate(_Player, "FOR_UnfortunateGnome", "Approach");
		
		IF
		DB_GlobalFlag(FOR_GnomeGoblinsDead_8910f084-c9ad-2336-c6a7-098d71914529)
		AND
		NOT DB_GlobalFlag(FOR_UnfortunateGnome_State_Freed_c829895d-aba7-46e5-bc10-eb2516c8ddd6)
		AND
		DB_GlobalFlag(GLO_UnfortunateGnome_State_Still_d58850bc-2eac-8105-99b1-fec5d247b746)
		AND
		DB_Players(_Player)
		THEN
		QuestUpdate(_Player, "FOR_UnfortunateGnome", "WindmillStopped");
		
		IF
		DB_GlobalFlag(FOR_UnfortunateGnome_State_Freed_c829895d-aba7-46e5-bc10-eb2516c8ddd6)
		AND
		DB_GlobalFlag(FOR_GnomeGoblinsDead_8910f084-c9ad-2336-c6a7-098d71914529)
		AND
		DB_Players(_Player)
		THEN
		DB_QuestDef_State(FOR_GnomeGoblinsDead_8910f084-c9ad-2336-c6a7-098d71914529, "FOR_UnfortunateGnome", "GnomeFreed");
		
		IF
		DB_GlobalFlag(FOR_UnfortunateGnome_State_Freed_c829895d-aba7-46e5-bc10-eb2516c8ddd6)
		AND
		DB_GlobalFlag(FOR_GnomeGoblinsPacified_385336a9-30d7-f4f8-fa62-32dff47ff714)
		AND
		DB_Players(_Player)
		THEN
		DB_QuestDef_State(FOR_GnomeGoblinsDead_8910f084-c9ad-2336-c6a7-098d71914529, "FOR_UnfortunateGnome", "GnomeFreed");
		
		PROC
		PROC_LevelLoadedOnce("SCL_Main_A")
		AND
		DB_Players(_Player)
		THEN
		QuestUpdate(_Player, "FOR_UnfortunateGnome", "GnomeLeft");
		
		//END_REGION
		
		//REGION Speak With Dead removed when gnome runs away from Windmill. The SWD only applies to the case that the gnome died there.
		IF
		DB_FOR_UnfortunateGnomeGone(1)
		THEN
		NOT DB_GLO_CharacterCorpseDialog(S_FOR_UnfortunateGnome_6e45a00b-bad2-40bb-9403-147b9e92d976, FOR_UnfortunateGnome_Dead_bedf63dc-6459-b784-063f-26c24f2706f5);
		 
		//END_REGION
		
		//REGION Apply Statuses
		IF
		UseStarted(_Character, S_FOR_UnfortunateGnomeChains_74cf2839-80b6-4f42-ab7c-679f0b6b74ac)
		THEN
		DB_FOR_UnfortunateGnome_OnWindMill(_Character);
		
		IF
		DB_FOR_UnfortunateGnome_OnWindMill(_Character)
		THEN
		ApplyStatus(_Character, "FOR_TIEDTOWINDMILL", -1.0, 1, NULL_00000000-0000-0000-0000-000000000000);
		PROC_LoopEffect(VFX_Script_PUZ_GEN_Tied_Ropes_A_Gnome_A_01_25f36571-f664-fcd6-5ca5-1fce4ad85444, _Character, "FOR_WindmillRopes", "WLD_Main_A", "Dummy_BodyFX");
		
		
		IF
		DB_FOR_UnfortunateGnome_OnWindMill(_Character)
		AND
		NOT DB_GlobalFlag(GLO_UnfortunateGnome_State_Still_d58850bc-2eac-8105-99b1-fec5d247b746)
		THEN
		SetDetached(_Character, 1);
		
		IF
		DB_FOR_UnfortunateGnome_OnWindMill(_Character)
		AND
		DB_GlobalFlag(GLO_UnfortunateGnome_State_Still_d58850bc-2eac-8105-99b1-fec5d247b746)
		THEN
		SetDetached(_Character, 0);
		
		IF
		ReposeRemoved(_Character,_)
		AND
		DB_FOR_UnfortunateGnome_OnWindMill((CHARACTER)_Character)
		AND
		IsOnStage(S_FOR_UnfortunateGnomeChains_Free_6c85929a-dfa7-4a2e-8cf3-60a31493e5fa, 1)
		THEN
		SetOnStage(S_FOR_UnfortunateGnomeChains_Free_6c85929a-dfa7-4a2e-8cf3-60a31493e5fa, 0);
		
		IF
		ReposeRemoved(_Character,_)
		AND
		DB_FOR_UnfortunateGnome_OnWindMill((CHARACTER)_Character)
		THEN
		SetCanFight(S_FOR_UnfortunateGnome_6e45a00b-bad2-40bb-9403-147b9e92d976, 1);
		SetDetached(_Character, 0);
		RemoveStatus(_Character, "FOR_TIEDTOWINDMILL");
		PROC_StopLoopEffect(_Character, "FOR_WindmillRopes");
		NOT DB_FOR_UnfortunateGnome_OnWindMill(_Character);
		
		//END_REGION
		
		//REGION Sound
		
		IF
		FlagSet(GLO_UnfortunateGnome_State_Still_d58850bc-2eac-8105-99b1-fec5d247b746, _, _)
		THEN
		TriggerSetSoundRTPC((TRIGGER)Amb_SV_Forest_QD_727b95fa-f30c-3d41-cbe2-dc0d67f8f105, "SE_Windmill_A_Speed", 0.0, 1);
		PlaySound(S_FOR_UnfortunateGnomeChains_74cf2839-80b6-4f42-ab7c-679f0b6b74ac,"SE_Windmill_A_Stop");
		
		IF
		FlagCleared(GLO_UnfortunateGnome_State_Still_d58850bc-2eac-8105-99b1-fec5d247b746, _, _)
		THEN
		TriggerSetSoundRTPC((TRIGGER)Amb_SV_Forest_QD_727b95fa-f30c-3d41-cbe2-dc0d67f8f105, "SE_Windmill_A_Speed", 50.0, 1);
		
		IF
		FlagCleared(WLD_FOR_UnfortunateGnome_State_Fast_ad363172-0964-4f0c-9f1d-4fea67834e60, _, _)
		THEN
		TriggerSetSoundRTPC((TRIGGER)Amb_SV_Forest_QD_727b95fa-f30c-3d41-cbe2-dc0d67f8f105, "SE_Windmill_A_Speed", 50.0, 1);
		
		IF
		FlagSet(WLD_FOR_UnfortunateGnome_State_Fast_ad363172-0964-4f0c-9f1d-4fea67834e60, _, _)
		THEN
		TriggerSetSoundRTPC((TRIGGER)Amb_SV_Forest_QD_727b95fa-f30c-3d41-cbe2-dc0d67f8f105, "SE_Windmill_A_Speed", 100.0, 1);
		
		//END_REGION
		
		//REGION If the windmill is restarted, end interactive dialogues
		
		IF
		FlagCleared(GLO_UnfortunateGnome_State_Still_d58850bc-2eac-8105-99b1-fec5d247b746, _, _)
		AND
		DB_FOR_UnfortunateGnome_OnWindMill(_Character)
		AND
		DB_DialogNPCs(_ID, _Character, _)
		AND
		NOT DB_AutomatedDialog(_ID)
		THEN
		PROC_ForceStopDialog(_Character);
		
		//END_REGION
		
		//REGION Windmill cinematics
		IF
		UseStarted(_Character, S_FOR_UnfortunateGnome_Lever2_3c4f6a14-7b10-48ec-ace1-6324142cb994)
		AND
		IsPartyMember(_Character, 1, 1)
		AND
		QRY_OnlyOnce("FOR_UnfortunateGnome_SlowDown")
		AND
		DB_Players(_Character)
		AND
		NOT DB_GlobalFlag(GLO_UnfortunateGnome_State_Still_d58850bc-2eac-8105-99b1-fec5d247b746)
		AND
		NOT QRY_UnfortunateGnome_Slowdown_WithGoblins(_Character, 0)
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)FOR_UnfortunateGnome_SlowDown_NoGoblins_8859f0e0-0d0b-e54f-c141-7dff95ae05a4, _Character)
		THEN
		DB_NOOP(1);
		
		IF
		UseStarted(_Character, S_FOR_UnfortunateGnome_Lever_50b03092-6db1-4469-b21d-2104758ce130)
		AND
		IsPartyMember(_Character, 1, 1)
		AND
		QRY_OnlyOnce("FOR_UnfortunateGnome_SpeedUp")
		AND
		DB_Players(_Character)
		AND
		NOT QRY_UnfortunateGnome_Slowdown_WithGoblins(_Character, 1)
		AND
		QRY_StartDialogCustom_Fixed((DIALOGRESOURCE)FOR_UnfortunateGnome_SpeedUp_b7098519-067a-43ee-1446-1ef3a604de87, _Character, 0, 0, 0, 0)
		THEN
		DB_NOOP(1);
		
		IF
		FlagSet(WLD_FOR_UnfortunateGnome_State_Fast_ad363172-0964-4f0c-9f1d-4fea67834e60, _, _)
		AND
		NOT DB_FOR_UnfortunateGnome_ThrowOffDialog(_)
		AND
		NOT DB_GlobalFlag((FLAG)FOR_UnfortunateGnome_State_Freed_c829895d-aba7-46e5-bc10-eb2516c8ddd6)
		AND
		NOT DB_DialogName(FOR_UnfortunateGnome_SpeedUp_b7098519-067a-43ee-1446-1ef3a604de87, _)
		AND
		NOT DB_DialogName((DIALOGRESOURCE)FOR_UnfortunateGnome_SlowDown_e5a2eee5-2eef-e746-ff88-a461d03e336c, _)
		AND
		NOT DB_GlobalFlag((FLAG)FOR_GnomeGoblinsPacified_385336a9-30d7-f4f8-fa62-32dff47ff714)
		AND
		NOT QRY_StartDialog(DIALOGRESOURCEGUID_FOR_GnomeGoblin1_AD_InvestigateMill_cf27ec59-299d-7a19-7d1b-7a20b4c4a7e3, S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, S_FOR_GnomeGoblin3_bff8ab5f-739d-422a-9ad3-92f4b897f1bc)
		AND
		DB_FOR_UnfortunateGnome_GnomeInvestiGoblins(_, _Goblin, 1)
		THEN
		SetEntityEvent(_Goblin, "FOR_GnomeGoblins_Investigate");
		
		//END_REGION
		
		//REGION If you fling off the unfortunate gnome, the goblins have nothing to have fun with, so they trundle off.
		
		
		IF
		FlagSet(FOR_UnfortunateGnome_Event_ThrowOff_87ddb5ee-952a-4513-8759-03d1a98e1afc, _, _)
		AND
		NOT DB_GlobalFlag((FLAG)FOR_GnomeGoblinsPacified_385336a9-30d7-f4f8-fa62-32dff47ff714)
		THEN
		ObjectTimerLaunch(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, "FOR_UnfortunateGnome_LeaveAfterFlungOff", 90000);
		
		IF
		ObjectTimerFinished(S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404, "FOR_UnfortunateGnome_LeaveAfterFlungOff")
		THEN
		SetFlag(FOR_UnfortunateGnome_State_GoblinsGiveUp_0f66989b-1a89-4666-bd62-00b2dfe4e325, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		
		IF
		DB_GlobalFlag(FOR_UnfortunateGnome_State_GoblinsGiveUp_0f66989b-1a89-4666-bd62-00b2dfe4e325)
		AND
		NOT DB_GlobalFlag((FLAG)WLD_FOR_GnomeGoblinsPacified_385336a9-30d7-f4f8-fa62-32dff47ff714) // flagType: Global
		AND
		NOT DB_CantTalk((CHARACTER)S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404)
		AND
		NOT DB_GlobalFlag(FOR_GnomeGoblinsReturnedHome_be23fd5b-22ed-b163-0204-779faf6e131c) //For if they surrendered, otherwise this triggers in Moonrise
		AND
		QRY_OnlyOnce("FOR_GnomeGoblin1_AD_UnfortunateGnomeGone")
		AND
		NOT QRY_StartDialog(FOR_GnomeGoblin1_AD_UnfortunateGnomeGone_32ed5899-0c97-9d2d-e946-21515146bb1a, (CHARACTER)S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404)
		THEN
		PROC_FOR_GnomeGoblins_LeavePacified();
		
		IF
		DB_GlobalFlag(FOR_UnfortunateGnome_State_GoblinsGiveUp_0f66989b-1a89-4666-bd62-00b2dfe4e325)
		AND
		NOT DB_GlobalFlag((FLAG)WLD_FOR_GnomeGoblinsPacified_385336a9-30d7-f4f8-fa62-32dff47ff714) // flagType: Global
		AND
		DB_Defeated((CHARACTER)S_FOR_GnomeGoblin1_b2c582af-bc69-48b3-a004-648562dab404)
		AND
		QRY_OnlyOnce("FOR_GnomeGoblin1_AD_UnfortunateGnomeGone")
		THEN
		PROC_FOR_GnomeGoblins_LeavePacified();
		
		IF
		AutomatedDialogEnded(FOR_GnomeGoblin1_AD_UnfortunateGnomeGone_32ed5899-0c97-9d2d-e946-21515146bb1a, _)
		THEN
		PROC_FOR_GnomeGoblins_LeavePacified();
		
		PROC
		PROC_FOR_GnomeGoblins_LeavePacified()
		AND
		DB_FOR_GnomeGoblins(_Goblin, _, _, _Time)
		THEN
		ObjectTimerLaunch(_Goblin, "FOR_GnomeGoblinLeave", _Time);
		
		IF
		ObjectTimerFinished((CHARACTER)_Goblin, "FOR_GnomeGoblinLeave")
		THEN
		PROC_DisappearOutOfSightTo(_Goblin, TRIGGERGUID_S_GOB_GnomeGoblinDestination_5418547b-f831-4598-99fe-741ba7985e0a, "Run", 0, "FOR_GnomeGoblinsReturnedHome");
		
		//END_REGION
		
		//REGION
		IF
		DB_InRegion(_Character, (TRIGGER)S_FOR_UnfortunateGnome_WindmillForceActivation_3b494ddd-a226-4fe3-905d-49e1546559fa)
		AND
		NOT DB_FOR_ForceUpdating(1)
		THEN
		DB_FOR_ForceUpdating(1);
		SetForceUpdate(S_FOR_UnfortunateGnomeChains_74cf2839-80b6-4f42-ab7c-679f0b6b74ac, 1);
		
		IF
		DB_FOR_ForceUpdating(1)
		AND
		NOT DB_InRegion(_, (TRIGGER)S_FOR_UnfortunateGnome_WindmillForceActivation_3b494ddd-a226-4fe3-905d-49e1546559fa)
		THEN
		NOT DB_FOR_ForceUpdating(1);
		SetForceUpdate(S_FOR_UnfortunateGnomeChains_74cf2839-80b6-4f42-ab7c-679f0b6b74ac, 0);
		
		//END_REGION
	}
	EXIT
	{
	}
}
