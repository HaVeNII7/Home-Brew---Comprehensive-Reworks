		//END_REGION
		
		//REGION Rainforest Basement traps
		DB_LOW_RainforestBasement_DeprecatedItems((ITEM)S_LOW_RainforestBasement_Tripwire_000_Deprecated_669e6863-b1da-4930-b57e-061ece0b886a);
		DB_LOW_RainforestBasement_DeprecatedItems((ITEM)S_LOW_RainforestBasement_Tripwire_001_Deprecated_5fb39058-d7d6-4079-8171-56f4ce16d298);
		DB_LOW_RainforestBasement_DeprecatedItems((ITEM)S_LOW_RainforestBasement_Tripwire_002_Deprecated_3ee2a3c5-033a-41fa-b5c8-6c505232453d);
		DB_LOW_RainforestBasement_DeprecatedItems((ITEM)S_LOW_RainforestBasement_SecretDoor_DEPRECATED_c237b313-3c49-4f83-84cf-14d5c159317d);
		DB_LOW_RainforestBasement_DeprecatedItems((ITEM)S_LOW_RainforestBasement_Torch_000_DEPRECATED_bf2366c1-8d63-4a43-bb1a-0e12d387a01f);
		DB_LOW_RainforestBasement_DeprecatedItems((ITEM)S_LOW_RainforestBasement_Torch_001_DEPRECATED_788c8a8c-df91-4b9d-87bc-429048ade78d);
		//END_REGION Rainforest Basement traps
	}
	KB
	{
		IF
		DB_LOW_Brainquakes(_Trigger)
		THEN
		PROC_TriggerRegisterForPlayers(_Trigger);
		
		//Special interaction with one of the Brainkquakes triggers
		IF
		EnteredTrigger(_Player, S_LOW_BrainquakeTrigger_06_4bb017c0-a7dc-4b07-8e68-1e6718476f9a)
		AND
		DB_LOW_Brainquakes(S_LOW_BrainquakeTrigger_06_4bb017c0-a7dc-4b07-8e68-1e6718476f9a)
		THEN
		PROC_EmperorAD(_Player, (DIALOGRESOURCE)LOW_BaldursGate_EmperorAD_Brainquake_045c5005-d236-20b0-2dff-a750ba3916e7);
		
		IF
		EnteredTrigger(_Player,_Trigger)
		AND
		DB_LOW_Brainquakes(_Trigger)
		THEN
		PROC_GLO_Brainquakes_ShakeGroundAroundCharacter(_Player);
		NOT DB_LOW_Brainquakes(_Trigger);
		
		//REGION Eastway Food Crisis crimes
		IF
		DB_EastwayFoodCrisis_Chicken(_Chicken)
		THEN
		PROC_CharacterDisableAllCrimes(_Chicken);
		//END_REGION
		
		//REGION Plays world timelines for LOW
		IF
		LevelGameplayStarted("CTY_Main_A", _)
		AND
		NOT DB_GLO_ActiveWorldTimelines(LOW_WRLD_ShippingLane_17be9a7b-6506-a693-1bad-42330ef3a171, "CTY_Main_A", _)
		AND
		StartWorldTimeline(LOW_WRLD_ShippingLane_17be9a7b-6506-a693-1bad-42330ef3a171, TimelineSceneTrigger_LOW_WRLD_ShippingLane_a5baa5cf-db69-41bd-8269-3845e1bfe5f9, _, _ID)
		THEN
		DB_GLO_ActiveWorldTimelines(LOW_WRLD_ShippingLane_17be9a7b-6506-a693-1bad-42330ef3a171, "CTY_Main_A", _ID);
		
		//END_REGION
		
		//REGION World Learns about Gortash's Death
		IF
		LevelGameplayStarted("CTY_Main_A", _)
		AND
		DB_GlobalFlag((FLAG)GLO_Gortash_State_PermaDefeated_74dd56ff-7e00-42a6-a0f3-0d122f364769)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_Gortash_State_WorldKnowsPermaDefeated_5bbc8258-a708-4486-aa3f-8757d9dce533)
		THEN
		PROC_GlobalSetFlagAndCache(GLO_Gortash_State_WorldKnowsPermaDefeated_5bbc8258-a708-4486-aa3f-8757d9dce533);
		//END_REGION
		
		//REGION Attitude bump for bard players who chat with musical instruments vendor about music
		IF
		FlagSet((FLAG)LOW_JewelryMusicStore_State_MusicVendorChattedWithPlayer_626911c4-c5dc-49d4-bddc-7baa87fd582e,_Player,_)
		AND
		DB_Players((CHARACTER)_Player)
		THEN
		AddAttitudeTowardsPlayer((CHARACTER)S_LOW_Traders_MusicVendor_bfb008db-a56e-4de7-bca5-e84a11619b21,_Player,50);
		//END_REGION
		
		//REGION Until the oil surface is removed, the dock fishermen are scrubbing it off 
		IF
		FlagSet((FLAG)LOW_DockWarehouse_Fishers_State_OilRemoved_708209b0-2e50-448e-8058-46a532f8484b,_Player,_)
		THEN
		PROC_RemoveDialog(S_LOW_FisherBrother_092b641b-7cac-4fc5-81e2-ef9f21186e67);
		PROC_RemoveDialog(S_LOW_FisherSister_78b65473-f053-4eea-9501-90958df96f82);
		PROC_NotifyWhenReadyToMoveOn(S_LOW_FisherBrother_092b641b-7cac-4fc5-81e2-ef9f21186e67,"LOW_DockWarehouse_Fishers_LeaveOnOilRemoved");
		PROC_NotifyWhenReadyToMoveOn(S_LOW_FisherSister_78b65473-f053-4eea-9501-90958df96f82,"LOW_DockWarehouse_Fishers_LeaveOnOilRemoved");
		
		PROC
		PROC_ReadyToMoveOn(_Fisher,"LOW_DockWarehouse_Fishers_LeaveOnOilRemoved")
		THEN
		PROC_DisappearOutOfSight(_Fisher,"",0,"Walk");
		//END_REGION
		
		//REGION Rainforest Basement deprecated items
		IF
		DB_LOW_RainforestBasement_DeprecatedItems(_Item)
		THEN
		SetOnStage(_Item, 0);
		//END_REGION Rainforest Basement deprecated items
		
	}
	EXIT
	{
	}
}
Goal(617).Title("Act3b_LOW_MonkAmulet");
Goal(617)
{
	INIT
	{
		DB_GLO_MonkAmuletBanters((TRIGGER)S_LOW_MonkAmulet_SharranGrottoBanter_c00ca9c7-f1f4-4134-86b2-ebddcd3b6ae5, (DIALOGRESOURCE)LOW_MonkAmulet_AD_SharranGrottoBanter_8b882bcd-3ebc-824a-b8ae-25ad9cebae56);
	}
	KB
	{
		//There is reactivity in the AD as to whether the player equipping the amulet is Sharran/Shadowheart
		IF
		AutomatedDialogStarted(LOW_MonkAmulet_AD_SharranGrottoBanter_8b882bcd-3ebc-824a-b8ae-25ad9cebae56, _)
		AND
		DB_GLO_MonkAmulet_EquippingPlayer(_Player)
		AND
		IsTagged(_Player,(TAG)SHAR_486e4a27-e6f9-40a5-9dd1-108a1d0f60eb,1)
		THEN
		SetFlag(LOW_MonkAmulet_State_SharranWearingAmulet_3bceb1e9-f0c8-484a-86f5-a23a04ebd46b);
		
		IF
		AutomatedDialogEnded(LOW_MonkAmulet_AD_SharranGrottoBanter_8b882bcd-3ebc-824a-b8ae-25ad9cebae56, _)
		AND
		DB_GlobalFlag(LOW_MonkAmulet_State_SharranWearingAmulet_3bceb1e9-f0c8-484a-86f5-a23a04ebd46b)
		THEN
		ClearFlag(LOW_MonkAmulet_State_SharranWearingAmulet_3bceb1e9-f0c8-484a-86f5-a23a04ebd46b);
	}
	EXIT
	{
	}
}
