		DB_OriginCampFlags(S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba,(FLAG)MINSC_57698b42-b815-49a1-8c51-100da1b4b9ee,(FLAG)MINSCAVATAR_a5df191b-17fd-4c0b-8bb2-b93f8e111b03,(FLAG)MINSCCOMPANION_68e19008-92ab-4aaf-affc-52fcd3acf5f3,(FLAG)MINSCPARTY_eb4fa22d-899e-4133-8ae3-b8d312c07314,(FLAG)MINSCCAMP_48d218a6-f664-455a-a856-3517c5a2a4b9);
