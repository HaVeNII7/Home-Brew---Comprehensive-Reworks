		DB_HAV_SavingPrisoners_FlamingFist((CHARACTER)S_HAV_HavenOutcasts_FountainGuards_Melee_1_3e2db417-c434-4f08-ab6a-dd60c8e9f3b5);
		
		SetOnStage(S_HAV_Florrick_Note_43785054-670c-42c5-bc43-38ab269ed40f,0);
		
