		DB_GLO_ThrallOfTheAbsolute_LoadedLevelPoints("BGO_Main_A",(TRIGGER)S_BGO_ThrallOfTheAbsolute_AbsoluteSpeakerPoint_dfe3a4dc-51de-46be-8f9e-d66a05a15bfd);
