		DB_WYR_Smugglers_Goods(LOOT_Druid_Autopsy_Set_Tadpole_066_ac03f29a-7015-459f-8c5b-a680ab9f2fa1);
		DB_WYR_Smugglers_Goods(LOOT_Druid_Autopsy_Set_Tadpole_067_8cc5097b-98db-442f-a71f-dadd5ca9de46);
		DB_WYR_Smugglers_Goods(LOOT_Druid_Autopsy_Set_Tadpole_068_b57c85f8-a0cb-42eb-a8bc-ffc13037532d);
		DB_WYR_Smugglers_Goods(LOOT_Druid_Autopsy_Set_Tadpole_069_66456f9a-1559-4b8e-83ce-240b67b86df1);
		DB_WYR_Smugglers_Goods(LOOT_Druid_Autopsy_Set_Tadpole_070_0448a86c-5f11-4605-b5c3-964c080be72e);
		DB_WYR_Smugglers_Goods(LOOT_Druid_Autopsy_Set_Tadpole_071_397cf939-1995-46f1-a940-048cfc78d50b);
		DB_WYR_Smugglers_Goods(LOOT_Druid_Autopsy_Set_Tadpole_072_89092544-4f8d-496b-b0e2-1f4a4c478d9a);
		DB_WYR_Smugglers_Goods(LOOT_Druid_Autopsy_Set_Tadpole_073_8422afe7-5d6b-4e25-8ddc-42945034dc48);
		DB_WYR_Smugglers_Goods(LOOT_GEN_Autopsy_Jar_Tadpoles_A_000_4e8a5fff-760e-4f66-8f21-b5fa5fd9c8bc);
		DB_WYR_Smugglers_Goods(LOOT_GEN_Autopsy_Jar_Tadpoles_A_001_ef2ab0fe-596a-4a55-912a-472a4d103f41);
		DB_WYR_Smugglers_Goods(LOOT_GEN_Autopsy_Jar_Tadpoles_B_000_3d12515f-31f3-4648-acc5-a9dcd839aa76);
		DB_WYR_Smugglers_Goods(LOOT_GEN_Autopsy_Jar_Tadpoles_B_002_e7402974-ce13-4705-8175-eefdf9971d10);
		DB_WYR_Smugglers_Goods(LOOT_GEN_Autopsy_Jar_Tadpoles_B_003_eda4ff20-3e4b-4a3d-b6e7-efe9099b0b08);
		DB_WYR_Smugglers_Goods(LOOT_GEN_Autopsy_Jar_Tadpoles_B_004_fa58728c-513e-48dc-86f5-b6406222b9ec);
		DB_WYR_Smugglers_Goods(LOOT_GEN_Autopsy_Jar_Tadpoles_B_005_5a728222-e86c-4f21-8f95-57df0b6763b0);
		DB_WYR_Smugglers_Goods(LOOT_GEN_Autopsy_Jar_Tadpoles_B_006_92fa9454-7286-4fc0-bb57-4b06189cc583);
		//END_REGION Goods to be cleared
		
		// Combat NPC Reactivity
		DB_CombatReact_AD_OnNextTurn(S_WYR_SmugglersCave_StoneLord_Leader_40756dfd-a16c-4586-b1c3-6f0de1c7f515, WYR_SmugglersCave_AD_StoneLordLeader_TakeTurn_Combat_e21ace18-126c-ea64-fad1-363ed58a6f44);
		DB_CombatReact_AD_OnNextTurn(S_WYR_SmugglersCave_Guild_Leader_2457049b-d7ee-43bc-932e-cc9e104933bc, WYR_SmugglersCave_AD_GuildLeader_TakeTurn_Combat_1f85f479-f9b4-3ebf-8efc-ff32ccdabbcf);
		
		// Exceptions to WYR_SmugglersCave_PAD_Suggestions that was removed due to incorrect writing/recording
		DB_WYR_SmugglersCave_SuggestionDialogExceptions((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		DB_WYR_SmugglersCave_SuggestionDialogExceptions((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba);
		//DB_WYR_SmugglersCave_SuggestionDialogExceptions((CHARACTER)S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a);
		
		
		DB_GLO_DefeatCounter_AllDefeatedGlobalFlag("WYR_SmugglersCave_SmugglersList",(FLAG)WYR_SmugglersCave_State_SmugglersDefeated_d6acc249-bd57-4076-ad5f-954c5eaad5c7);
		DB_GLO_DefeatCounter_AllDefeatedGlobalFlag("WYR_SmugglersCave_SmugglersList",(FLAG)WYR_SmugglersCave_State_SmugglersDead_24f5d15a-7c30-4e87-bd88-efcb53707572);
		
		DB_GLO_DefeatCounter_AllDefeatedGlobalFlag("WYR_SmugglersCave_AttackersList",(FLAG)WYR_SmugglersCave_State_AttackersDefeated_c9113226-cc30-48c0-896e-e7ed60080ac2); 
		DB_GLO_DefeatCounter_AllDefeatedGlobalFlag("WYR_SmugglersCave_AttackersList",(FLAG)WYR_SmugglersCave_State_AttackersDead_e4c30333-03bc-4cdf-a18d-cdc94ad449af); 
	}
	KB
	{
		//REGION DEBUG
		IF
		TextEvent("SCTeleportToEntrance")
		THEN
		PROC_TeleportPartiesTo((TRIGGER)S_DEBUG_Teleport_WYR_SmugglersCave_f8b3cf2c-6481-4ea8-9526-451861f648db, "");
		
		IF
		TextEvent("smug_clear")
		THEN
		PROC_WYR_Smugglers_ClearCave();
		
		IF
		TextEvent("smug_fill")
		THEN
		PROC_WYR_Smugglers_FillCave();
		//END_REGION
		
		QRY
		QRY_SelectCustomDialog_AfterGenerics(_Guilder,_Player)
		AND
		DB_WYR_SmugglersCave_AttackersList((CHARACTER)_Guilder)
		AND
		_Guilder != S_WYR_SmugglersCave_Guild_Leader_2457049b-d7ee-43bc-932e-cc9e104933bc
		THEN
		DB_SelectedDialog((DIALOGRESOURCE)GEB_AD_CantTalkNow_ae991ba1-8a2e-9cc7-b4c2-379af7f058c5,_Guilder);
		
		//REGION Journal Update - If players recieve a reward - give reward by using with hidden booster.
		PROC
		PROC_FlagReactionAfterDialog(_Player, (FLAG)WYR_SmugglersCave_AttackersLeader_PlayerReceivedReward_c2647ef0-962a-29c7-a2df-ccd8dc85b007, (DIALOGRESOURCE)WYR_SmugglersCave_AttackersLeader_0525a637-85f6-3c15-0707-69a9d9ab7b05)
		THEN
		QuestUpdate((CHARACTER)_Player, "HIDDEN_BGO_Boosters", "WYR_SmugglersCave_HelpedTheGuild");
		//END_REGION
		
		//REGION SceneManager - Setup NPCs
		PROC
		PROC_WYR_SmugglersCave_Smugglers_Setup()
		AND
		DB_WYR_SmugglersCave_SmugglersList(_Char)
		THEN
		DB_SceneManager((CHARACTER)_Char, "WYR_SmugglersCave_PreConfrontation");
		
		PROC
		PROC_WYR_SmugglersCave_Attackers_Setup()
		AND
		DB_WYR_SmugglersCave_AttackersList(_Char)
		THEN
		DB_SceneManager((CHARACTER)_Char, "WYR_SmugglersCave_PreConfrontation");
		//END_REGION
		
		//REGION SceneManager - Interruptions
		// If smugglers were attacked directly.
		PROC
		PROC_SceneInterrupted(_Attacked, _AttackOwner, "WYR_SmugglersCave_PreConfrontation", _Reason)
		AND
		DB_GLO_GenericSceneManager_ViolenceReason(_Reason)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_SmugglersCave_State_CombatBegun_a6487901-b349-b3d6-97ce-53c2d7488ff6)
		AND
		DB_WYR_SmugglersCave_SmugglersList((CHARACTER)_Attacked)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_SmugglersCave_State_CombatBegun_a6487901-b349-b3d6-97ce-53c2d7488ff6);
		PROC_GlobalSetFlagAndCache((FLAG)WYR_SmugglersCave_Event_PreemptivelyAttackedSmugglers_01390cda-9158-4e7f-9705-cbfb8e159710); // so dialog can reflect this flow.
		DB_WYR_SmugglersCave_CurrentPhase("FightBegin");
		PROC_WYR_SmugglersCave_SmugglersTurnHostileToPlayer((CHARACTER)_AttackOwner); // sceneOver is calledin this PROC.
		PROC_WYR_SmugglersCave_SmugglersTurnHostileToGuild();
		PROC_WYR_SmugglersCave_BeforeFightSpotting_Stop();
		PROC_WYR_SmugglersCave_DuringFightSpotting_Setup();
		
		// If attackers were attacked directly.
		PROC
		PROC_SceneInterrupted(_Attacked, _AttackOwner, "WYR_SmugglersCave_PreConfrontation", _Reason)
		AND
		DB_GLO_GenericSceneManager_ViolenceReason(_Reason)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_SmugglersCave_State_CombatBegun_a6487901-b349-b3d6-97ce-53c2d7488ff6)
		AND
		DB_WYR_SmugglersCave_AttackersList((CHARACTER)_Attacked)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_SmugglersCave_State_CombatBegun_a6487901-b349-b3d6-97ce-53c2d7488ff6);
		DB_WYR_SmugglersCave_CurrentPhase("FightBegin");
		PROC_WYR_SmugglersCave_SmugglersTurnHostileToPlayer((CHARACTER)_AttackOwner); // sceneOver is calledin this PROC.
		PROC_WYR_SmugglersCave_SmugglersTurnHostileToGuild();
		PROC_WYR_SmugglersCave_GuildTurnHostileToPlayer((CHARACTER)_AttackOwner);
		PROC_WYR_SmugglersCave_BeforeFightSpotting_Stop();
		//END_REGION
		
		
		//REGION Entering trigger for the dying attacker to play the dying attacker's AD.
		IF
		EnteredTrigger((CHARACTER)_Player, (TRIGGER)S_WYR_SmugglersCave_DyingAttacker_ADTrigger_42fb6c86-792f-4b2b-8772-f96187293508)
		AND
		DB_Players(_Player)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)WYR_SmugglersCave_AD_DyingAttacker_3d085140-6c05-d317-851c-265eb03395f9, S_WYR_SmugglersCave_DyingAttacker_b9ff6ee5-b7d1-4bed-af3b-eb6c39dcd169);
		//END_REGION
		
		
		//REGION Start dialog on spell
		IF
		DB_WYR_OrinsImpersonation_ChosenImpersonation(_,_,_,S_GLO_SmugglersCave_DyingAttacker_b9ff6ee5-b7d1-4bed-af3b-eb6c39dcd169)
		AND
		DB_WYR_SmugglersCave_DyingAttacker(S_GLO_SmugglersCave_DyingAttacker_b9ff6ee5-b7d1-4bed-af3b-eb6c39dcd169)
		THEN
		NOT DB_WYR_SmugglersCave_DyingAttacker(S_GLO_SmugglersCave_DyingAttacker_b9ff6ee5-b7d1-4bed-af3b-eb6c39dcd169);
		DB_WYR_SmugglersCave_DyingAttacker(S_GLO_Orin_bf24e0ec-a3a6-4905-bd2d-45dc8edf8101);
		
		IF
		DB_WYR_SmugglersCave_DyingAttacker(S_GLO_Orin_bf24e0ec-a3a6-4905-bd2d-45dc8edf8101)
		AND
		NOT DB_WYR_OrinsImpersonation_ChosenImpersonation(_,_,_,S_GLO_SmugglersCave_DyingAttacker_b9ff6ee5-b7d1-4bed-af3b-eb6c39dcd169)
		THEN
		NOT DB_WYR_SmugglersCave_DyingAttacker(S_GLO_Orin_bf24e0ec-a3a6-4905-bd2d-45dc8edf8101);
		DB_WYR_SmugglersCave_DyingAttacker(S_GLO_SmugglersCave_DyingAttacker_b9ff6ee5-b7d1-4bed-af3b-eb6c39dcd169);
		
		IF
		UsingSpellOnTarget(_Player,_DyingSmuggler,_Spell,_,_,_)
		AND
		DB_WYR_SmugglersCave_DyingAttacker((CHARACTER)_DyingSmuggler)
		AND
		NOT DB_WYR_SmugglersCave_DyingDialogStarted(_)
		AND
		SpellHasSpellFlag(_Spell,"IsHarmful",0)
		AND
		QRY_SelectAndStartDialog(_DyingSmuggler,_Player)
		THEN
		DB_WYR_SmugglersCave_DyingDialogStarted(1);
		
		IF
		DialogStarted(WYR_SmugglersCave_DyingAttacker_0a906b91-6c42-48d4-17b9-9cf7ff5f2fce,_)
		THEN
		DB_WYR_SmugglersCave_DyingDialogStarted(1);
		
		IF
		DialogStarted(WYR_OrinsImpersonation_OrinDyingAttacker_939f417e-0f96-4dee-aa06-4c2d735e8fc0,_)
		THEN
		DB_WYR_SmugglersCave_DyingDialogStarted(1);
		//END_REGION Start dialog on spell
		
		
		//REGION Corpse owning
		IF
		DB_WYR_Smugglers_BodyParts(_Part)
		THEN
		ClearOwnership(_Part);
		
		IF
		DB_WYR_Smugglers_Corpses(_Corpse)
		THEN
		PROC_ClearCorpseOwner(_Corpse);
		
		QRY
		QRY_CorpseLooting_BlockMakeOwned(S_GLO_SmugglersCave_DyingAttacker_b9ff6ee5-b7d1-4bed-af3b-eb6c39dcd169)
		THEN
		DB_NOOP(1);
		//END_REGION Corpse owning
		
		
		//REGION Entering trigger area starts PAD that observes the 2 sides are about to start fighting.
		// if its not the Exception player speakers.
		IF
		EnteredTrigger((CHARACTER)_Player, (TRIGGER)S_WYR_SmugglersCave_ApproachBattleArea_34d2cb75-cbf0-44f9-bf65-af8f4c3961b0)
		AND
		NOT DB_WYR_SmugglersCave_SuggestionDialogExceptions(_Player)
		AND
		DB_Players(_Player)
		AND
		QRY_OnlyOnce("WYR_SmugglerCave_PAD_Suggestions")
		THEN
		DB_WYR_SmugglersCave_CurrentPhase("PAD");
		PROC_TryStartAD((DIALOGRESOURCE)WYR_SmugglersCave_PAD_Suggestions_f1607e79-22f5-5dad-4b1e-ff58767c8649, _Player);
		PROC_ForceStopDialog(S_WYR_SmugglersCave_Guild_Leader_2457049b-d7ee-43bc-932e-cc9e104933bc);
		PROC_ForceStopDialog(S_WYR_SmugglersCave_StoneLord_Leader_40756dfd-a16c-4586-b1c3-6f0de1c7f515);
		
		// if its the Exception player speakers who don't have a PAD recorded, start it as if the PAD triggered.
		IF
		EnteredTrigger((CHARACTER)_Player, (TRIGGER)S_WYR_SmugglersCave_ApproachBattleArea_34d2cb75-cbf0-44f9-bf65-af8f4c3961b0)
		AND
		DB_WYR_SmugglersCave_SuggestionDialogExceptions(_Player)
		AND
		DB_Players(_Player)
		AND
		QRY_OnlyOnce("WYR_SmugglerCave_PAD_Suggestions")
		THEN
		PROC_ForceStopDialog(S_WYR_SmugglersCave_Guild_Leader_2457049b-d7ee-43bc-932e-cc9e104933bc);
		PROC_ForceStopDialog(S_WYR_SmugglersCave_StoneLord_Leader_40756dfd-a16c-4586-b1c3-6f0de1c7f515);
		PROC_GlobalSetFlagAndCache((FLAG)WYR_SmugglersCave_Event_CombatImminent_e93475dc-7813-4ddb-8c4e-69b65501f1b3);
		DB_WYR_SmugglersCave_CurrentPhase("FightImminent");
		PROC_TryStartAD((DIALOGRESOURCE)WYR_SmugglersCave_AD_FightImminent_7961610c-521e-8b8f-0a88-8a8a6d83aefa, S_WYR_SmugglersCave_Guild_Leader_2457049b-d7ee-43bc-932e-cc9e104933bc, S_WYR_SmugglersCave_StoneLord_Leader_40756dfd-a16c-4586-b1c3-6f0de1c7f515);
		//END_REGION
		
		
		//REGION At the end of Suggestion PAD, start the FightImminent AD between the attackers/smugglers.
		IF
		AutomatedDialogEnded((DIALOGRESOURCE)WYR_SmugglersCave_PAD_Suggestions_f1607e79-22f5-5dad-4b1e-ff58767c8649, _)
		AND
		NOT DB_GlobalFlag(WYR_SmugglersCave_State_CombatBegun_a6487901-b349-b3d6-97ce-53c2d7488ff6)
		AND
		NOT DB_WYR_SmugglersCave_CurrentPhase("BeforeFightSpotted")
		THEN
		DB_NOOP(1);
		
		IF
		AutomatedDialogEnded((DIALOGRESOURCE)WYR_SmugglersCave_PAD_Suggestions_f1607e79-22f5-5dad-4b1e-ff58767c8649, _)
		AND
		NOT DB_GlobalFlag(WYR_SmugglersCave_State_CombatBegun_a6487901-b349-b3d6-97ce-53c2d7488ff6)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_SmugglersCave_Event_CombatImminent_e93475dc-7813-4ddb-8c4e-69b65501f1b3);
		DB_WYR_SmugglersCave_CurrentPhase("FightImminent");
		PROC_TryStartAD((DIALOGRESOURCE)WYR_SmugglersCave_AD_FightImminent_7961610c-521e-8b8f-0a88-8a8a6d83aefa, S_WYR_SmugglersCave_Guild_Leader_2457049b-d7ee-43bc-932e-cc9e104933bc, S_WYR_SmugglersCave_StoneLord_Leader_40756dfd-a16c-4586-b1c3-6f0de1c7f515);
		//END_REGION
		
		
		//REGION At the end of FightImminent AD, start actual battle between the 2 factions.
		IF
		AutomatedDialogEnded((DIALOGRESOURCE)WYR_SmugglersCave_AD_FightImminent_7961610c-521e-8b8f-0a88-8a8a6d83aefa, _DialogID)
		AND
		NOT DB_GlobalFlag(WYR_SmugglersCave_State_CombatBegun_a6487901-b349-b3d6-97ce-53c2d7488ff6)
		AND
		DB_GlobalFlag(WYR_SmugglersCave_Event_CombatImminent_e93475dc-7813-4ddb-8c4e-69b65501f1b3)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_SmugglersCave_State_CombatBegun_a6487901-b349-b3d6-97ce-53c2d7488ff6);
		PROC_GlobalClearFlagAndCache((FLAG)WYR_SmugglersCave_Event_CombatImminent_e93475dc-7813-4ddb-8c4e-69b65501f1b3);
		DB_WYR_SmugglersCave_CurrentPhase("FightBegin");
		PROC_WYR_SmugglersCave_SmugglersTurnHostileToGuild();
		PROC_WYR_SmugglersCave_BeforeFightSpotting_Stop();
		PROC_WYR_SmugglersCave_DuringFightSpotting_Setup();
		//END_REGION
		
		
		//REGION Players starting dialog with smugglers before combat
		QRY
		QRY_SelectCustomDialog_AfterGenerics(_Smuggler,_Player)
		AND
		DB_WYR_SmugglersCave_SmugglersList((CHARACTER)_Smuggler)
		AND
		QRY_StartDialogCustom_Fixed(
			(DIALOGRESOURCE)WYR_SmugglersCave_PreConflict_1f13d520-f8a6-a76a-edb5-22990ae8e299,
			(CHARACTER)S_WYR_SmugglersCave_StoneLord_Leader_40756dfd-a16c-4586-b1c3-6f0de1c7f515,
					   S_WYR_SmugglersCave_Guild_Leader_2457049b-d7ee-43bc-932e-cc9e104933bc,	           
					   _Player,
			0, 0, 0, 1)
		THEN
		DB_NOOP(1);
		//END_REGION Players starting dialog with smugglers before combat
		
		
		//REGION Spot players to play dialogue to join BEFORE combat
		PROC
		PROC_WYR_SmugglersCave_BeforeFightSpotting_Setup()
		AND
		NOT DB_GlobalFlag(WYR_SmugglersCave_State_CombatBegun_a6487901-b349-b3d6-97ce-53c2d7488ff6)
		AND
		DB_WYR_SmugglersCave_StartDialogSpotters(_Character)
		AND
		QRY_WYR_SmugglersCave_CheckValidTimeStartDialog()
		THEN
		DB_SpotPlayers(_Character,"WYR_SmugglerCave_BeforeFightSpotting",NULL_00000000-0000-0000-0000-000000000000,NULL_00000000-0000-0000-0000-000000000000);
		DB_SpotPlayers_SpotterIgnoreCantTalk(_Character,"WYR_SmugglerCave_BeforeFightSpotting");
		
		// in editor, DB_Players is populated later than PROC_WYR_SmugglersCave_BeforeFightSpotting_Setup is called
		IF
		DB_SpotPlayers_SpotterIgnoreCantTalk(_Character,"WYR_SmugglerCave_BeforeFightSpotting")
		AND
		DB_Players(_Player)
		THEN
		DB_SpotPlayers_TargetIgnoreCantTalk(_Player,"WYR_SmugglerCave_BeforeFightSpotting");
		
		PROC
		PROC_WYR_SmugglersCave_BeforeFightSpotting_Stop()
		AND
		DB_WYR_SmugglersCave_StartDialogSpotters(_Character)
		THEN
		PROC_SpotPlayers_StopSpotting((CHARACTER)_Character, "WYR_SmugglerCave_BeforeFightSpotting");
		
		PROC
		PROC_SpotPlayers_Spotted(_,"WYR_SmugglerCave_BeforeFightSpotting",_Player)
		AND
		QRY_OnlyOnce("WYR_SmugglerCave_BeforeFightSpotting")
		THEN
		//PROC_ForceStopDialog(S_WYR_SmugglersCave_Guild_Leader_2457049b-d7ee-43bc-932e-cc9e104933bc);
		//PROC_ForceStopDialog(S_WYR_SmugglersCave_StoneLord_Leader_40756dfd-a16c-4586-b1c3-6f0de1c7f515);
		DB_WYR_SmugglersCave_CurrentPhase("BeforeFightSpotted");
		PROC_GlobalClearFlagAndCache((FLAG)WYR_SmugglersCave_Event_CombatImminent_e93475dc-7813-4ddb-8c4e-69b65501f1b3); // cancel the combat begun in case it was already starting.
		PROC_WYR_SmugglersCave_StartDialogBeforeCombat_Delayed();
		DB_WYR_SmugglersCave_SpottedPlayer(_Player);
		
		PROC
		PROC_WYR_SmugglersCave_StartDialogBeforeCombat_Delayed()
		THEN
		TimerLaunch("WYR_SmugglerCave_StartDialog_Delayed", 1000); 
		
		IF
		TimerFinished("WYR_SmugglerCave_StartDialog_Delayed")
		AND
		DB_WYR_SmugglersCave_SpottedPlayer(_Player)
		THEN
		PROC_WYR_SmugglersCave_StartDialogBeforeCombat(_Player);
		
		PROC
		PROC_WYR_SmugglersCave_StartDialogBeforeCombat((CHARACTER)_Player)
		AND
		NOT DB_GlobalFlag(WYR_SmugglersCave_State_CombatBegun_a6487901-b349-b3d6-97ce-53c2d7488ff6)
		AND
		//NOT QRY_StartDialog_Fixed(
		QRY_StartDialogCustom_Fixed(
			(DIALOGRESOURCE)WYR_SmugglersCave_PreConflict_1f13d520-f8a6-a76a-edb5-22990ae8e299,
			(CHARACTER)S_WYR_SmugglersCave_StoneLord_Leader_40756dfd-a16c-4586-b1c3-6f0de1c7f515,
					   S_WYR_SmugglersCave_Guild_Leader_2457049b-d7ee-43bc-932e-cc9e104933bc,	           
					   _Player,
			0, 0, 0, 1)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_WYR_SmugglersCave_CheckValidTimeStartDialog()
		AND
		DB_WYR_SmugglersCave_CurrentPhase("PAD")
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_WYR_SmugglersCave_CheckValidTimeStartDialog()
		AND
		DB_WYR_SmugglersCave_CurrentPhase("PreFight")
		THEN
		DB_NOOP(1);
		
		//END_REGION
		
		
		//REGION Spot players to play dialog when players are spotted DURING combat.
		PROC
		PROC_WYR_SmugglersCave_DuringFightSpotting_Setup()
		AND
		DB_WYR_SmugglersCave_StartDialogSpotters(_Character)
		THEN
		DB_SpotPlayers(_Character,"WYR_SmugglerCave_DuringFightSpotting",NULL_00000000-0000-0000-0000-000000000000,NULL_00000000-0000-0000-0000-000000000000);
		DB_SpotPlayers_IgnoreCombat(_Character,"WYR_SmugglerCave_DuringFightSpotting");
		
		PROC
		PROC_SpotPlayers_Spotted(_,"WYR_SmugglerCave_DuringFightSpotting",_Player)
		AND
		DB_Is_InCombat(S_WYR_SmugglersCave_Guild_Leader_2457049b-d7ee-43bc-932e-cc9e104933bc, _CombatID)
		AND
		QRY_OnlyOnce("WYR_SmugglerCave_DuringFightSpotting")
		THEN
		//DB_WYR_SmugglersCave_CombatID(_CombatID);
		//PauseCombat(_CombatID);
		PROC_WYR_SmugglersCave_SmugglersTurnHostileToPlayer((CHARACTER)_Player);
		//END_REGION
		
		
		//REGION Spot players to play dialogue AFTER combat
		IF
		DB_GlobalFlag((FLAG)WYR_SmugglersCave_Event_PostCombat_67b3c231-5dc4-4bb8-9fee-02d7d1074da3)
		AND
		DB_WYR_SmugglersCave_AfterFightSpotters(_Character)
		THEN
		DB_SpotPlayers(_Character,"WYR_SmugglerCave_AfterFightSpotting",NULL_00000000-0000-0000-0000-000000000000,NULL_00000000-0000-0000-0000-000000000000);
		
		PROC
		PROC_SpotPlayers_Spotted(_,"WYR_SmugglerCave_AfterFightSpotting",_Player)
		AND
		QRY_OnlyOnce("WYR_SmugglerCave_AfterFightSpotting")
		AND
		NOT QRY_StartDialog(
			(DIALOGRESOURCE)WYR_SmugglersCave_AttackersLeader_0525a637-85f6-3c15-0707-69a9d9ab7b05, //Guild_Leader
			(CHARACTER)S_WYR_SmugglersCave_Guild_Leader_2457049b-d7ee-43bc-932e-cc9e104933bc,
					   _Player)
		THEN
		DB_NOOP(1);
		//END_REGION
		
		
		//REGION Relation changes
		PROC
		PROC_WYR_SmugglersCave_SmugglersTurnHostileToPlayer((CHARACTER)_Player)
		THEN
		SetHostileAndEnterCombat(	(FACTION)ACT3_WYR_SmugglersCave_Smugglers_121b4ea8-2394-46d2-92e4-3635eaf4a8a0, 
									(FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, 
									(CHARACTER)S_WYR_SmugglersCave_StoneLord_Leader_40756dfd-a16c-4586-b1c3-6f0de1c7f515, //StoneLord_Leader
									(CHARACTER)_Player);
		PROC_SceneOver("WYR_SmugglersCave_PreConfrontation");
		
		
		PROC
		PROC_WYR_SmugglersCave_SmugglersTurnHostileToGuild()
		THEN
		SetHostileAndEnterCombat(	(FACTION)ACT3_WYR_SmugglersCave_Attackers_32963caf-28d5-4ccb-a82b-bae2a08778aa, 
									(FACTION)ACT3_WYR_SmugglersCave_Smugglers_121b4ea8-2394-46d2-92e4-3635eaf4a8a0, 
									(CHARACTER)S_WYR_SmugglersCave_Guild_Leader_2457049b-d7ee-43bc-932e-cc9e104933bc, 
									(CHARACTER)S_WYR_SmugglersCave_StoneLord_Leader_40756dfd-a16c-4586-b1c3-6f0de1c7f515);
		
		PROC
		PROC_WYR_SmugglersCave_GuildTurnHostileToPlayer((CHARACTER)_Player)
		THEN
		SetHostileAndEnterCombat((FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, (FACTION)ACT3_WYR_SmugglersCave_Attackers_32963caf-28d5-4ccb-a82b-bae2a08778aa, (CHARACTER)_Player, S_WYR_SmugglersCave_Guild_Leader_2457049b-d7ee-43bc-932e-cc9e104933bc);
		
		PROC
		PROC_WYR_SmugglersCave_GuildTurnAllyToPlayer()
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT3_WYR_SmugglersCave_Attackers_32963caf-28d5-4ccb-a82b-bae2a08778aa, 100); 
		//END_REGION
		
		
		//REGION Players choose to Help the Attackers (dialog option 1). // Attackers allied to players.
		PROC 
		PROC_GlobalFlagReactionAfterDialog((FLAG)WYR_SmugglersCave_Event_HelpAttackers_f4edeece-2562-4501-83f7-e98d9c2ddb28, _, _DialogID)
		AND
		DB_DialogPlayers(_DialogID, _Player, 1)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_SmugglersCave_State_CombatBegun_a6487901-b349-b3d6-97ce-53c2d7488ff6);
		PROC_WYR_SmugglersCave_SmugglersTurnHostileToPlayer((CHARACTER)_Player);
		PROC_WYR_SmugglersCave_SmugglersTurnHostileToGuild();
		PROC_WYR_SmugglersCave_GuildTurnAllyToPlayer();
		//END_REGION
		
		
		//REGION Players choose to attack the Attackers (dialog option 2 and 4-kill all) // Attackers hostile to players.
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)WYR_SmugglersCave_Event_AttackAttackers_159e5713-f63b-4350-b677-5a33d0fafe44, _, _DialogID)
		AND
		DB_DialogPlayers(_DialogID, _Player, 1)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_SmugglersCave_State_CombatBegun_a6487901-b349-b3d6-97ce-53c2d7488ff6);
		PROC_WYR_SmugglersCave_SmugglersTurnHostileToPlayer((CHARACTER)_Player);
		PROC_WYR_SmugglersCave_SmugglersTurnHostileToGuild();
		PROC_WYR_SmugglersCave_GuildTurnHostileToPlayer((CHARACTER)_Player);
		//END_REGION
		
		
		//REGION Players choose to ignore the Attackers (dialog option 3, stay neutral- but smugglers still turn hostile, they don't want survivors there) // attackers remain neutral towards players.
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)WYR_SmugglersCave_Event_IgnoreAttackers_5e4dcf25-145e-40b4-80a3-f2f18c62c5a8, _, _DialogID)
		AND
		DB_DialogPlayers(_DialogID, _Player, 1)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_SmugglersCave_State_CombatBegun_a6487901-b349-b3d6-97ce-53c2d7488ff6);
		PROC_WYR_SmugglersCave_SmugglersTurnHostileToPlayer((CHARACTER)_Player);
		PROC_WYR_SmugglersCave_SmugglersTurnHostileToGuild();
		//END_REGION
		
		
		//REGION Combat Init
		IF
		DB_WYR_SmugglersCave_SmugglersList(_Char)
		THEN
		DB_GLO_DefeatCounter(_Char, "WYR_SmugglersCave_SmugglersList");
		SetHasDialog(_Char,1);
		
		IF
		DB_WYR_SmugglersCave_AttackersList(_Char)
		THEN
		DB_GLO_DefeatCounter(_Char, "WYR_SmugglersCave_AttackersList");
		SetHasDialog(_Char,1);
		//END_REGION
		
		
		//REGION Post Combat checks, if Attackers win (by killing all Smugglers), and Attacker Leader survived, setup spotters to talk to players after combat.
		PROC
		PROC_GLO_DefeatCounter_AllDefeated("WYR_SmugglersCave_SmugglersList")
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_SmugglersCave_Event_PostCombat_67b3c231-5dc4-4bb8-9fee-02d7d1074da3); // TODO: flag has uses later
		PROC_CorpseLooting_ClearRedOutlinesForDefeatCounter("WYR_SmugglersCave_SmugglersList");
		//END_REGION
		
		
		//REGION Post Combat checks, if Smugglers win (by killing all Attackers), and Smuggler Leader survived, and players are not seen.
		PROC
		PROC_GLO_DefeatCounter_AllDefeated("WYR_SmugglersCave_AttackersList")
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_SmugglersCave_Event_PostCombat_67b3c231-5dc4-4bb8-9fee-02d7d1074da3); // TODO: flag has uses later
		PROC_CorpseLooting_ClearRedOutlinesForDefeatCounter("WYR_SmugglersCave_AttackersList");
		
		IF
		DB_GlobalFlag((FLAG)WYR_SmugglersCave_State_AttackersDefeated_c9113226-cc30-48c0-896e-e7ed60080ac2)
		AND
		NOT DB_Is_InCombat(S_WYR_SmugglersCave_StoneLord_Leader_40756dfd-a16c-4586-b1c3-6f0de1c7f515, _)
		//IsInCombat(S_WYR_SmugglersCave_StoneLord_Leader_40756dfd-a16c-4586-b1c3-6f0de1c7f515, 0)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)WYR_SmugglersCave_AD_SmugglerLeader_2750fc0e-e8e6-6c0a-24fb-80c446bb42bc, (CHARACTER)S_WYR_SmugglersCave_StoneLord_Leader_40756dfd-a16c-4586-b1c3-6f0de1c7f515);
		
		IF
		DB_GlobalFlag((FLAG)WYR_SmugglersCave_State_AttackersDefeated_c9113226-cc30-48c0-896e-e7ed60080ac2)
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT3_WYR_SmugglersCave_Smugglers_121b4ea8-2394-46d2-92e4-3635eaf4a8a0,0);
		
		PROC
		PROC_StateSet_Defeated(S_WYR_SmugglersCave_Guild_Leader_2457049b-d7ee-43bc-932e-cc9e104933bc)
		AND
		DB_WYR_SmugglersCave_AttackersList(_Smuggler)
		AND
		NOT DB_Defeated(_Smuggler)
		THEN
		PROC_NotifyWhenReadyToMoveOn(_Smuggler,"WYR_SmugglersCave_RunAwayPostCombat");
		
		PROC
		PROC_ReadyToMoveOn(S_WYR_SmugglersCave_Guild_Ranger_01_71d62377-4944-4ef9-b492-5cd95251ba6f,"WYR_SmugglersCave_RunAwayPostCombat") // only this char will AD since he's only VO we have left.
		AND
		QRY_OnlyOnce("WYR_SmugglersCave_RunAwayPostCombat")
		THEN
		PROC_TryStartAD(WYR_SmugglersCave_AD_RunAway_84cdeabb-d778-f77a-0243-b6c7ccf24d93,S_WYR_SmugglersCave_Guild_Ranger_01_71d62377-4944-4ef9-b492-5cd95251ba6f);
		
		PROC
		PROC_ReadyToMoveOn(_Smuggler,"WYR_SmugglersCave_RunAwayPostCombat")
		THEN
		PROC_DisappearOutOfSightTo(_Smuggler,S_GLO_OrinsImpersonation_DyingAttacker_PosTrigger_60bac7c3-a574-4336-9384-1281aacdef1c,"Run",0,"");
		//END_REGION
		
		
		//REGION On Long rest in case combat has been started, the smugglers and guild people are set offstage along with the smuggled items
		PROC
		PROC_LongRest()
		AND
		DB_GlobalFlag((FLAG)WYR_SmugglersCave_State_CombatBegun_a6487901-b349-b3d6-97ce-53c2d7488ff6)
		AND
		QRY_OnlyOnce("WYR_SmugglersCave_Resolved")
		THEN
		DB_WYR_SmugglersCave_CleanupOnLongRest(1);
		
		IF
		DB_WYR_SmugglersCave_CleanupOnLongRest(1)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_SmugglersCave_State_SmugglersDefeated_d6acc249-bd57-4076-ad5f-954c5eaad5c7)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_SmugglersCave_State_SmugglersWon_f82671e3-a381-49eb-bc02-d5fa27468428);
		
		IF
		DB_WYR_SmugglersCave_CleanupOnLongRest(1)
		AND
		DB_CurrentLevel("BGO_Main_A")
		THEN
		NOT DB_WYR_SmugglersCave_CleanupOnLongRest(1);
		PROC_WYR_SmugglersCave_ClearCave_Smugglers();
		PROC_WYR_SmugglersCave_ClearCave_Attackers();
		PROC_WYR_Smugglers_ClearCave();
		
		PROC
		PROC_WYR_SmugglersCave_ClearCave_Smugglers()
		AND
		DB_WYR_SmugglersCave_SmugglersList(_TargetNPC)
		AND
		IsInInventory(_TargetNPC,0)
		THEN
		PROC_SetOnStage(_TargetNPC, 0);
		
		PROC
		PROC_WYR_SmugglersCave_ClearCave_Attackers()
		AND
		DB_WYR_SmugglersCave_AttackersList(_TargetNPC)
		AND
		IsInInventory(_TargetNPC,0)
		THEN
		PROC_SetOnStage(_TargetNPC, 0);
		//END_REGION 
		
		
		//REGION Entering this trigger area causes PAD to play about the Moonrise Ship being seen before.
		IF
		EnteredTrigger((CHARACTER)_Player, (TRIGGER)S_WYR_SmugglersCave_SeenShipTrigger_16c94052-371d-4e38-9006-fa5ebe9d4b4c)
		AND
		DB_Players(_Player)
		AND
		QRY_OnlyOnce("WYR_SmugglerCave_PAD_MoonriseShip")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)WYR_SmugglersCave_PAD_SawMoonriseShip_c108c3ed-59e8-a1b4-a01d-b1182dc563ab, _Player);
		//END_REGION
		
		
		//REGION After dialogue with dying attacker, murder the dying attacker.
		IF
		DialogEnded((DIALOGRESOURCE)WYR_SmugglersCave_DyingAttacker_0a906b91-6c42-48d4-17b9-9cf7ff5f2fce, _)
		THEN
		Die(S_WYR_SmugglersCave_DyingAttacker_b9ff6ee5-b7d1-4bed-af3b-eb6c39dcd169,DEATHTYPE.DoT,1);
		//END_REGION
		
		
		//REGION Repeat AD if he's still alive for white box only. in final he won't have to use the DyingStatus 
		/*
		IF
		AutomatedDialogEnded((DIALOGRESOURCE)WYR_SmugglersCave_AD_DyingAttacker_3d085140-6c05-d317-851c-265eb03395f9, _)
		AND
		IsDead((CHARACTER)S_WYR_SmugglersCave_DyingAttacker_b9ff6ee5-b7d1-4bed-af3b-eb6c39dcd169, 0)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)WYR_SmugglersCave_AD_DyingAttacker_3d085140-6c05-d317-851c-265eb03395f9, S_WYR_SmugglersCave_DyingAttacker_b9ff6ee5-b7d1-4bed-af3b-eb6c39dcd169);
		//DebugText(S_WYR_SmugglersCave_DyingAttacker_b9ff6ee5-b7d1-4bed-af3b-eb6c39dcd169, "Restarting AD");
		*/
		//END_REGION
		
		
		//REGION Traps
		IF
		DualEntityEvent(_,_,"WYR_Smugglers_Trap_StartShooting")
		AND
		NOT DB_WYR_Smugglers_Trap_StartedShooting(1)
		THEN
		DB_WYR_Smugglers_Trap_StartedShooting(1);
		SetEntityEvent(S_WYR_Smugglers_Trap_Shooting_000_8f453355-bdcf-429d-8c3f-bd6144a89b88,"Trap_ChainReaction",1);
		SetEntityEvent(S_WYR_Smugglers_Trap_Shooting_009_4e563019-b382-4c73-ad2c-0f46326484fa,"Trap_ChainReaction",1);
		//END_REGION Traps
		
		
		//REGION Goods to be cleared
		PROC
		PROC_WYR_Smugglers_ClearCave()
		AND
		DB_WYR_Smugglers_GoodsTrigger(_Trigger)
		AND
		DB_WYR_Smugglers_Goods(_Item)
		AND
		IsInInventory(_Item,0)
		AND
		IsInTrigger(_Item,_Trigger,1)
		THEN
		SetOnStage(_Item,0);
		
		PROC
		PROC_WYR_Smugglers_ClearCave()
		AND
		TemplateIsInInventory((ITEMROOT)UNI_TadpolePowerJar_1ec327be-3b7f-4502-9586-860e057e09ae,BLD_Ship_Xebec_A_Booth_000_b5383213-4fbd-4f91-aa73-387ad63f6676,_Count)
		THEN
		TemplateRemoveFrom((ITEMROOT)UNI_TadpolePowerJar_1ec327be-3b7f-4502-9586-860e057e09ae,BLD_Ship_Xebec_A_Booth_000_b5383213-4fbd-4f91-aa73-387ad63f6676,_Count);
		
		PROC
		PROC_WYR_Smugglers_FillCave()
		AND
		DB_WYR_Smugglers_Goods(_Item)
		AND
		IsOnStage(_Item,0)
		THEN
		SetOnStage(_Item,1);
		
		//END_REGION Goods to be cleared
		
		
		//REGION Map to jail secret entrance
		// Reveal entrance so perception check is no longer needed.
		IF
		UseFinished(_Player, PUZ_GEN_Map_JailSecretEntrance_3a826fbc-bb9c-4164-a510-905c7610693b, 1)
		AND
		DB_Players(_Player)
		THEN
		SetEntityEvent((ITEM)S_WYR_WyrmRockPrison_SecretEntrance_ac85bbb6-b546-4104-a050-59f16e147f41, "StoryReveal", 1);
		//END_REGION
	}
	EXIT
	{
	}
}
