		DB_DEN_Thieflings_HideoutKids((CHARACTER)S_DEN_Pickpocket_540ddc1f-42c6-4347-ba03-b3cf3d3942ab);
		DB_DEN_Thieflings_HideoutKids((CHARACTER)S_DEN_PickpocketTrader_e1fda08b-45d4-41db-84b5-20e9931ba5af);
		
