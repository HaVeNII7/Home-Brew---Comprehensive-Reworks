		DB_GLO_LevelTraveler((CHARACTER)S_GLO_JergalAvatar_0133f2ad-e121-4590-b5f0-a79413919805, "SCL_Main_A", "GLO_Jergal_Act2");
		DB_GLO_LevelTraveler((CHARACTER)S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, "SCL_Main_A", "TWN_Korrilla");
		DB_GLO_LevelTraveler((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "SCL_Main_A", "ORI_Karlach_CampFix");
		DB_GLO_LevelTraveler((CHARACTER)S_GLO_DevilishOx_49eb5b4b-c6ed-4d37-8f68-97b1128b7d56, "SCL_Main_A", "GLO_DevilishOx");
		DB_GLO_LevelTraveler((CHARACTER)S_GLO_DarkUrge_Butler_f3486165-268f-4e41-9e0c-51485dfdff10, "SCL_Main_A", "DefaultMonster");
		
		DB_GLO_LevelTraveler((CHARACTER)S_DEN_TieflingLeader_475200ee-cc3c-4dbe-84b1-1820c02ea26a,"SCL_Main_A","COL_TadpolingCentre_Innocent_Zevlor");
		DB_GLO_LevelTraveler((CHARACTER)S_PLA_FlamingFist1_646a4195-4091-4dc9-81e1-cff2604f3911,"SCL_Main_A","COL_TadpolingCentre_Innocent_Yeva");
		
		// Dead Tieflings - remove their Anubis behaviours since they are dead
		DB_GLO_LevelTraveler((CHARACTER)S_DEN_Gatekeeper_847717b3-82eb-45a7-b875-78665c12ce9a,"SCL_Main_A","");
		DB_GLO_LevelTraveler((CHARACTER)S_DEN_Griefling_7ce0afc2-e8f2-4f2e-82d8-27df98acc3d8,"SCL_Main_A","");
