		DB_GLO_Backgrounds_Goal((TAG)HAUNTED_ONE_ce00b3b6-238e-4524-851b-3d1f2d2b1189, "Act2_HauntedOne_SurgeonKilledByNurses", 2ab29095-ec5c-46c1-86ef-305818cedad8);
		DB_GLO_Backgrounds_Goal((TAG)HAUNTED_ONE_ce00b3b6-238e-4524-851b-3d1f2d2b1189, "Act2_HauntedOne_ExecutionKilledGoblins", 9a501e5b-7e6b-43fd-9a77-ba1aae92f87d);
		DB_GLO_Backgrounds_Goal((TAG)HAUNTED_ONE_ce00b3b6-238e-4524-851b-3d1f2d2b1189, "Act2_HauntedOne_PixieKilled", 44e5b404-e3a1-4c19-9a60-8075efd18037);
		DB_GLO_Backgrounds_Goal((TAG)HAUNTED_ONE_ce00b3b6-238e-4524-851b-3d1f2d2b1189, "Act2_HauntedOne_GoblinFetchedBone", bb91826c-65cb-491a-93e8-626b481aff05);
		DB_GLO_Backgrounds_Goal((TAG)HAUNTED_ONE_ce00b3b6-238e-4524-851b-3d1f2d2b1189, "Act2_HauntedOne_ZhentTruthRevealed", 308a6523-0515-43cd-ab4b-729f0699a720);
		DB_GLO_Backgrounds_Goal((TAG)HAUNTED_ONE_ce00b3b6-238e-4524-851b-3d1f2d2b1189, "Act2_HauntedOne_MintharaTortured", 9e90090e-0781-4302-8ed4-0bf5358cbcc4);
		
		DB_GLO_Backgrounds_ChainAfterGoal("Act2_Soldier_OutdrankBrewer", "Act2_HauntedOne_BrewerOverdrinking");
		DB_GLO_Backgrounds_ChainAfterGoal("Act2_Soldier_MirrorSharTrialComplete", "Act2_HauntedOne_MirrorSharTrialCompleted");
		DB_GLO_Backgrounds_ChainAfterGlobalFlagInDialog((FLAG)TWN_Hospital_State_NursesKilledSurgeon_dc371af2-0788-43f9-990f-aaaf2192f8ca, "Act2_HauntedOne_SurgeonKilledByNurses");
		DB_GLO_Backgrounds_ChainAfterGlobalFlagInDialog((FLAG)SHA_OrthonLair_Event_OrthonKillsSelf_5779d2a2-1676-463d-905b-699e9c7b1bc7, "Act2_HauntedOne_OrthonContractLoophole");
		DB_GLO_Backgrounds_ChainAfterGlobalFlagInDialog((FLAG)SHA_NightsongPrison_State_ShadowheartKilledNightsong_3cac3cd6-4c16-44a6-8246-a91922821169, "Act2_HauntedOne_NightsongKilled");
		
		DB_GLO_Backgrounds_ChainAfterGlobalFlagInDialog((FLAG)SCL_Pixie_State_Dead_379ba580-46dc-db81-dae1-581117e54e03, "Act2_HauntedOne_PixieKilled");
		DB_GLO_Backgrounds_ChainAfterGlobalFlagInDialog((FLAG)SCL_EntryPoint_Event_GoblinDiesInShadowcurse_e5c11971-1b58-0fd9-044c-cb81fa8b2018, "Act2_HauntedOne_GoblinFetchedBone");
		
		
		DB_GLO_Backgrounds_ChainAfterGlobalFlagInDialog((FLAG)MOO_Background_HauntedOne_BreakControl_ae98dace-99d5-83ca-ff2e-360587d59e23, "Act2_HauntedOne_MoonriseGnollsFreed");
		DB_GLO_Backgrounds_ChainAfterGlobalFlagInDialog((FLAG)MOO_Execution_Event_GoblinsKillThemselves_26ffc4b9-58d5-02b2-1e9a-ea32d8935d11, "Act2_HauntedOne_ExecutionKilledGoblins");
		DB_GLO_Backgrounds_ChainAfterGlobalFlagInDialog((FLAG)MOO_Execution_Event_GoblinsSuffocate_bd978044-c6dd-8ef2-4bec-3e7da40defc1, "Act2_HauntedOne_ExecutionKilledGoblins");
		DB_GLO_Backgrounds_ChainAfterGlobalFlagInDialog((FLAG)MOO_Execution_Event_FightGoblins_b72d7ea2-16fb-f427-7317-4a7b1afad20b, "Act2_HauntedOne_ExecutionKilledGoblins");
		DB_GLO_Backgrounds_ChainAfterGlobalFlagInDialog((FLAG)MOO_Docks_Event_GuardJumped_c44a224f-3917-4438-91a8-20335d34fcdf, "Act2_HauntedOne_ZhentTruthRevealed");
		
		DB_GLO_Backgrounds_ChainAfterQuestUpdate("MOO_MintharaFate","MintharaPacified", "Act2_HauntedOne_MintharaTortured");
		
		//END_REGION
		
		//REGION COL
		
		DB_GLO_Backgrounds_MindflayerColonyVault_LootItems((ITEM)MAG_Illithid_MindOverload_Weapon_Longsword_000_e03d245e-63e0-49bd-b3ea-db221156a9ce);
		DB_GLO_Backgrounds_MindflayerColonyVault_LootItems((ITEM)S_COL_Vault_MemoryJar_193f87db-6a26-4f00-a289-63e247740176);
		
		DB_GLO_Backgrounds_ExploreColonyFully_Subregions((TRIGGER)S_COL_Morgue_SUB_884ab063-7c18-4887-a725-e8b9c6b0100c);
		DB_GLO_Backgrounds_ExploreColonyFully_Subregions((TRIGGER)S_COL_NecroLab_SUB_d4ed37da-ab88-415d-8131-917f954e4926);
		DB_GLO_Backgrounds_ExploreColonyFully_Subregions((TRIGGER)S_COL_TadpolingCentre_SUB_89b29154-b146-456f-8be9-3e10bf466844);
		DB_GLO_Backgrounds_ExploreColonyFully_Subregions((TRIGGER)S_COL_Barracks_SUB_2e97382e-959c-4f45-9f69-56952bda7851);
		DB_GLO_Backgrounds_ExploreColonyFully_Subregions((TRIGGER)S_COL_KethericShowdown_ChosenThree_Box_1581a588-b69f-41c9-a591-5959751f3cdf);
		
		//END_REGION COL
	}
	KB
	{
		//REGION Acolyte
		IF
		FlagSet((FLAG)TWN_CentralSquare_State_AllStatuePlaquesActivated_649ffcc7-2627-4815-91e2-05aba69dcd53, _, _)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Acolyte_CursedTownSharTests");
		
		//Temple Trials
		IF
		FlagSet(SHA_Trials_State_AllTrialsPassed_1e2b44c1-b11d-4aca-8cc5-627bf7a32c65, _, _)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Acolyte_SharTempleTrials");
		
		//Sole Dark Justiciar Survivor
		IF 
		DialogEnded(SHA_LastJusticiar_JusticiarAppears_a91cb7a5-6d80-7c81-b227-25d461dd0a2f, _)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Acolyte_SoleDarkJusticiarSurvivor");
		
		// Ketheric and Myrkul allegiance
		IF
		DialogEnded((DIALOGRESOURCE)COL_KethericShowdown_ChosenThree_94ef9fa6-729b-d34a-623a-74a8c3ba187f, _)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Acolyte_KethericMyrkulAllegiance");
		
		//Permadefeated He who was or made him leave while the quest is active
		IF
		QuestUpdateUnlocked(_Player, "SCL_ServantOfTheRaven", "ShadarKaiPermadefeatedOrLeft")
		AND
		DB_QuestIsAccepted("SCL_ServantOfTheRaven")
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Acolyte_HeWhoWasQuestDenied");
		//END_REGION
		
		//REGION Charlatan
		IF
		FlagSet(TWN_Distillery_State_PassedDrinkingCheck_4cb1dafc-ee34-4200-a984-ea91798f3e49, _Player, _ID)
		AND
		GetFlag(TWN_Distillery_State_TriedFakingDrinking_760bf00d-7a38-45e3-9445-ee8f6db8928f, _Player, 1)
		THEN
		SetFlag(TWN_Distillery_State_FakedDrinking_71c9f8e5-27ae-4578-afbe-6c311848ebfc, _Player, _ID);
		ClearFlag(TWN_Distillery_State_TriedFakingDrinking_760bf00d-7a38-45e3-9445-ee8f6db8928f, _Player, _ID);
		
		IF
		StatusApplied(S_TWN_Tollhouse_TollhouseMaster_3b460226-8ca2-4bbc-9bd7-8bb947aa2c06, "TWN_TOLLHOUSE_TECHNICAL_NOHELMET", _, _)
		AND
		GetClosestPlayer(S_TWN_Tollhouse_TollhouseMaster_3b460226-8ca2-4bbc-9bd7-8bb947aa2c06, _Player, _)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Charlatan_TollTakerGoldRemoval");
		
		//Jaheira truth Serum
		QRY
		QRY_GLO_Background_Charlatan_AnyPlayerDrank()
		AND
		DB_Players(_Player)
		AND
		GetFlag(HAV_Jaheira_State_DrankWine_f11d315b-78e7-7ef7-c20b-05f9e40acdbc, _Player, 1)
		THEN
		DB_NOOP(1);
		
		IF
		DialogEnded(HAV_Jaheira_a8318e4c-7e39-4f4f-1610-a9d3e7a1c1c8, _ID)
		AND
		DB_Players(_Player)
		AND
		DB_GlobalFlag(HAV_Jaheira_State_DrankWineButResisted_f5c522f5-d46e-4f60-b7ea-1fe77ec66e86)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Charlatan_JaheiraTruthSerum");
		
		// Marcus checkpoint solidarity
		IF
		DialogEnded(HAV_EnteringHaven_TadpoleCheckpoint_e51408cc-4f7a-5a5f-52e8-caf1359c1d6c, _ID)
		AND
		DB_GlobalFlag(HAV_EnteringHaven_State_FlamingSpyVouch_f3850740-f19b-44c0-a018-00fa00e87b31)
		AND
		NOT DB_GlobalFlag(GLO_HAV_EnteringHaven_TadpoleCheckpoint_RevealedMarcus_b6d58e9d-ae50-95c5-0776-60d68fd8c71b)
		AND
		DB_DialogPlayers(_ID, _Player, _)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Charlatan_MarcusLastLightCheckpointSolidarity");
		
		
		IF
		FlagSet(SHA_NightsongPrison_State_NightsongFreed_24f27b06-6665-79ed-d7bf-e4bf356ca2fa, _, _)
		AND
		DB_GlobalFlag(MOO_Isobel_State_AtMoonrise_a95b7f8f-1454-433f-a496-71c9306683ce)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Charlatan_AllegianceMoonriseLastLightSwitch");
		
		IF
		FlagSet(MOO_Necromancer_State_AtMoonrise_f64507bf-aa53-6de9-0b59-c19d649bb0a5, _, _)
		AND
		NOT DB_GlobalFlag(MOO_Isobel_State_AtMoonrise_a95b7f8f-1454-433f-a496-71c9306683ce)
		AND
		DB_GlobalFlag(HAV_TakingIsobel_State_DefendedIsobel_0d0255e4-dd08-47d7-9b40-cce21ec4a5bd)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Charlatan_AllegianceMoonriseLastLightSwitch");
		
		PROC
		PROC_MOO_KitchenFight_GnollsFrenzy()
		AND
		DB_Players(_Player)
		AND
		DB_InRegion(_Player, S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Charlatan_MoonriseFreedGnolls");
		
		PROC
		PROC_CharacterRegisterCrime_Success( _Player, "MOO_Jailbreak_SpokeWithPrisoner", _, _, _, _CrimeID)
		AND
		NOT DB_MOO_Backgrounds_CharlatanPrisonSpeakerCompleted(_Player)
		AND
		NOT DB_MOO_Backgrounds_CharlatanPrisonSpeaker(_Player, _)
		THEN
		DB_MOO_Backgrounds_CharlatanPrisonSpeaker(_Player, _CrimeID);
		
		//Didn't get caught
		IF
		OnCrimeRemoved(_CrimeID, _, _, _, _, _)
		AND
		DB_MOO_Backgrounds_CharlatanPrisonSpeaker(_Player, _CrimeID)
		AND
		NOT DB_MOO_Backgrounds_CharlatanPrisonSpeakerCompleted(_Player)
		THEN
		DB_MOO_Backgrounds_CharlatanPrisonSpeakerCompleted(_Player);
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Charlatan_MoonrisePrisonersCrime");
		
		//Got caught, but talked your way out of it
		IF
		OnCrimeResolved(_CrimeID, _, _Player, _, _, _) 
		AND
		DB_MOO_Backgrounds_CharlatanPrisonSpeaker(_Player, _CrimeID)
		AND
		QRY_MOO_Backgrounds_CanGetMoonrisePrisonersCrime((CHARACTER)_Player)
		THEN
		DB_MOO_Backgrounds_CharlatanPrisonSpeaker(_Player, _CrimeID);
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Charlatan_MoonrisePrisonersCrime");
		
		//Failed it
		IF
		OnCrimeResolved(_CrimeID, _, _Player, _, _, _) 
		AND
		DB_MOO_Backgrounds_CharlatanPrisonSpeaker(_Player, _CrimeID)
		AND
		NOT QRY_MOO_Backgrounds_CanGetMoonrisePrisonersCrime((CHARACTER)_Player)
		THEN
		DB_MOO_Backgrounds_CharlatanPrisonSpeaker(_Player, _CrimeID);
		
		QRY
		QRY_MOO_Backgrounds_CanGetMoonrisePrisonersCrime((CHARACTER)_Player)
		AND
		GetFlag(IsInPrison_c9b75b21-6eba-065e-7680-fc9a0c5838e4, _Player, 0)
		AND
		GetFaction(_Player, _PlayerFaction)
		AND
		GetRelation((FACTION)ACT2_MOO_Jailers_81d21487-9f41-4280-8e21-44495cdc762e, _PlayerFaction, _Relation)
		AND
		_Relation > 0
		THEN
		DB_NOOP(1);
		//END_REGION
		
		//REGION Criminal
		IF
		TemplateRemovedFrom(_NurseWeaponTemplate, _, _Nurse)
		AND
		DB_TWN_Hospital_NurseWeaponsTemplates(_NurseWeaponTemplate)
		AND
		IsTagged(_Nurse, (TAG)ACT2_TWN_HOSPITAL_NURSE_04e1eeed-7fad-46b5-8555-cbdea2214b6d, 1)
		AND
		NOT DB_TWN_Hospital_LootedNurseWeapons(_NurseWeaponTemplate)
		THEN
		DB_TWN_Hospital_LootedNurseWeapons(_NurseWeaponTemplate);
		PROC_TWN_Hospital_CheckUnlockNurseWeaponsBackgroundGoal();
		
		PROC
		PROC_TWN_Hospital_CheckUnlockNurseWeaponsBackgroundGoal()
		AND
		SysCount("DB_TWN_Hospital_LootedNurseWeapons", 1, 4)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Criminal_SurgeonNurseTools");
		
		IF
		TemplatesCombined(_, _, _, _, _, _Player, _BrewerPoison)
		AND
		GetTemplate(_BrewerPoison, UNI_Poison_Brewer_6db9ed3d-2d72-43ad-a2b8-02365728f29f)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Criminal_BrewerPoisonRecipe");
		
		IF
		AddedTo(S_TWN_CentralSquare_RitualDagger_2b07d6f1-d698-47e2-9531-500cbffd9853, (CHARACTER)_Player, _)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Criminal_TakeSharDagger");
		
		IF
		TemplateRemovedFrom(_, _, S_TWN_Tollhouse_Tolls_2b1ace93-a0ea-49a3-9328-b62117a62753)
		AND
		GetClosestPlayer(S_TWN_Tollhouse_Tolls_2b1ace93-a0ea-49a3-9328-b62117a62753, _Player, _)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Criminal_TollTakerLoot");
		
		//Act2_Criminal_MindflayerColonyVault
		IF
		AddedTo(DEC_Dungeon_Skeleton_Crawling_B_000_e88228ab-683a-472f-bb7a-877c1158c6c7,_Item,_)
		AND
		NOT DB_GLO_Backgrounds_MindflayerColonyVault_LootItems((ITEM)_Item)
		THEN
		DB_GLO_Backgrounds_MindflayerColonyVault_LootItems((ITEM)_Item);
		
		IF
		AddedTo(_Item,_PartyMember,_)
		AND
		DB_GLO_Backgrounds_MindflayerColonyVault_LootItems((ITEM)_Item)
		AND
		DB_PartyMembers((CHARACTER)_PartyMember)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Criminal_MindflayerColonyVault");
		
		IF
		AddedTo(_Item,_PartyMember,_)
		AND
		DB_GLO_Backgrounds_MindflayerColonyVault_LootItems((ITEM)_Item)
		AND
		DB_PartyMembers((CHARACTER)_PartyMember)
		THEN
		NOT DB_GLO_Backgrounds_MindflayerColonyVault_LootItems(_Item);
		
		//Orthon Gem
		IF
		FlagSet(SHA_Misc_State_HasOrthonGem_81dd03ea-b817-4dca-8be1-6019f012b462, _Player, _)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		NOT DB_GlobalFlag((FLAG)SHA_Orthon_State_DefeatedOnce_8dd589d6-90fc-4a3b-b369-10440bd56520)
		AND
		NOT DB_GlobalFlag((FLAG)SHA_Orthon_State_ContractEnded_26c35edd-3617-82b3-b4d7-1b7bb6410485)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Criminal_OrthonSharGem");
		
		//Taking Isobel
		IF
		FlagSet((FLAG)HAV_TakingIsobel_State_IsobelTakenAway_b1c15a65-8060-4b9e-a73f-bde4cc143f7d, _, _)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Criminal_DeliverIsobel");
		
		// Accept Marcus Proposition, Zrell version
		IF
		DialogEnded(MOO_Executioner_1e888683-64d6-47f1-3cde-f1d9f430e3e6, _)
		AND
		GetRelation((FACTION)ACT2_MOO_Executioner_19bbd2e1-3976-4104-9cd8-0000f061c3c3, (FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, _Relation)
		AND
		_Relation > -20
		AND
		DB_GlobalFlag(MOO_Executioner_Event_AskedToKidnapIsobel_59a781cf-4a28-fbc7-b032-05c051c0c9f4)
		AND
		NOT DB_GlobalFlag(MOO_Audience_State_GrantedPermission_ef5c0ad1-8aae-48b8-a438-5989b1778f9a)
		AND
		DB_Players(_Character)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Character, "Act2_Criminal_AcceptMarcusProposition");
		
		// Players get the moonlantern
		IF
		FlagSet((FLAG)SCL_Drider_State_HasDriderMoonlantern_a48372d0-609f-48a4-9774-956f6f614c3c, (CHARACTER)_Player, _)
		AND
		DB_Players(_Player)
		AND
		GetFlag((FLAG)HAV_TakingIsobel_State_IsobelGaveMoonlantern_2e9ac13e-9e09-c8b6-87e2-3f3998f5a6a7, NULL_00000000-0000-0000-0000-000000000000, 0)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Criminal_DriderMoonlantern");
		
		//Act2_Criminal_KethericIsobelMoonriseRooms
		IF
		EnteredTrigger(_Player, S_MOO_KethericRoomPoly_d16ef571-5545-4ae4-9c3f-2aae0daea6ea)
		AND
		DB_Players(_Player)
		AND
		NOT DB_MOO_Backgrounds_CriminalKethericRoom(1)
		THEN
		DB_MOO_Backgrounds_CriminalKethericRoom(1);
		PROC_MOO_Backgrounds_CriminalCheckEnteredRooms((CHARACTER)_Player);
		
		IF
		EnteredTrigger(_Player, S_MOO_IsobelRoomBox_25ef805a-d619-406a-8c60-2eec53e8183c)
		AND
		DB_Players(_Player)
		AND
		NOT DB_MOO_Backgrounds_CriminalIsobelRoom(1)
		THEN
		DB_MOO_Backgrounds_CriminalIsobelRoom(1);
		PROC_MOO_Backgrounds_CriminalCheckEnteredRooms((CHARACTER)_Player);
		
		PROC
		PROC_MOO_Backgrounds_CriminalCheckEnteredRooms((CHARACTER)_Player)
		AND
		QRY_State_IsBeforeState(S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6, "MOO", "MOO_State_Assault")
		AND
		DB_MOO_Backgrounds_CriminalKethericRoom(1)
		AND
		DB_MOO_Backgrounds_CriminalIsobelRoom(1)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Criminal_KethericIsobelMoonriseRooms");
		
		PROC
		PROC_GLO_Backgrounds_GuildArtisan_Trading(_Player, S_GOB_Quartermaster_646936f3-8d8d-484e-9361-cd1ed484c615, _)
		AND
		DB_Players(_Player)
		AND
		NOT DB_Defeated(S_GOB_Quartermaster_646936f3-8d8d-484e-9361-cd1ed484c615)
		AND
		DB_CurrentLevel("SCL_Main_A")
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Criminal_MoonriseRoahTrader");
		
		IF
		FlagSet(MOO_Jailbreak_State_GnomesHaveTools_740c0cea-1876-d336-7601-2418455692b1, _, _)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Criminal_GiveWulbrenTools");
		
		//END_REGION
		
		//REGION Entertainer
		PROC
		PROC_TWN_CentralSquare_SlideWallDown()
		AND
		GetClosestPlayer((ITEM)S_TWN_CentralSquare_Door_00e95616-f09c-446e-aa97-8d241fc68189, _Player, _)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Entertainer_CurseTownSqaurePuzzleOpen");
		
		IF
		DialogStarted((DIALOGRESOURCE)TWN_Hospital_Surgeon_10b263cd-b704-9eb2-71f9-2c7f6eb4739b, _)
		THEN
		DB_TWN_FateLearned("Surgeon");
		
		IF
		DialogStarted((DIALOGRESOURCE)TWN_Distillery_Brewer_c41d8459-3237-248f-c1bc-51e66892a65f, _)
		THEN
		DB_TWN_FateLearned("Brewer");
		
		IF
		DialogStarted((DIALOGRESOURCE)TWN_Tollhouse_TollhouseMaster_1fc993a8-c338-7cd6-aef2-add52d540d28, _)
		THEN
		DB_TWN_FateLearned("TollhouseCollector");
		
		IF
		DB_TWN_FateLearned("TollhouseCollector")
		AND
		DB_TWN_FateLearned("Brewer")
		AND
		DB_TWN_FateLearned("Surgeon")
		AND
		DB_TWN_FateLearned("Mason")
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Entertainer_TownLeadersFate");
		
		IF
		FlagSet((FLAG)TWN_Distillery_State_GotToThirdDrink_54370fb9-4d55-4577-ae8b-916361c8c1df, _Player, _)
		AND
		GetFlag((FLAG)TWN_Distillery_State_FailedPerformanceCheck_ed6c33b0-483c-4a4d-95c7-218fd21ca0ce, _Player, 0)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Entertainer_BrewerTallTalePerformance");
		
		//Saw Harper Funeral Scene
		IF
		FlagSet(HAV_General_HarperScout_001_HasMet_1678422b-35f5-4823-8ab8-d8894eebb14c, _Player, _)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Entertainer_HarperFuneralMeygan");
		
		// Completing Halsin's quest in act 2
		IF
		FlagSet((FLAG)GLO_LiftingTheCurse_State_BreathHasBeenRestored_2113b54e-a140-4aa0-97ac-219fa7b7d038, _, _)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Entertainer_ArtHalsinThaumielQuestCompleted");
		
		// Summoning the drider using the lyre
		IF
		TimerFinished("SCL_Drider_AppearsAfterUsingLyre")
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Entertainer_DriderSummoningHarp");
		
		IF
		FlagSet((FLAG)SCL_LiftingTheCurse_State_NightdomeDestroyed_ea76f9be-6d12-441d-8c63-de999d5b3e0c, _, _)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Entertainer_ShadowCurseSource");
		//END_REGION
		
		//REGION Folk Hero
		IF
		DB_PermaDefeated((CHARACTER)S_TWN_Tollhouse_TollhouseMaster_3b460226-8ca2-4bbc-9bd7-8bb947aa2c06)
		AND
		NOT DB_GlobalFlag((FLAG)TWN_Tollhouse_State_PeacefulResolution_2eb42178-c700-4742-9325-8fef38ed46ca)
		AND
		DB_Players(_Player)
		THEN
		DB_TWN_Hospital_TollhouseMasterKilledNoWeakening(1);
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_FolkHero_TownBossKilledNoAdvantage");
		
		IF
		DB_PermaDefeated((CHARACTER)S_TWN_Distillery_Brewer_4d9e3db3-9a78-4f4b-8101-1dd73c0f3be5)
		AND
		NOT DB_GlobalFlag((FLAG)TWN_Distillery_State_PeacefulResolution_ef40ccf6-a7d7-4fde-8fcf-82b947c29a44)
		AND
		DB_Players(_Player)
		THEN
		DB_TWN_Hospital_BrewerKilledNoWeakening(1);
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_FolkHero_TownBossKilledNoAdvantage");
		
		IF
		DB_PermaDefeated((CHARACTER)S_TWN_Hospital_Surgeon_e58b8b34-038b-4858-b817-c2a8096a9381)
		AND
		NOT DB_GlobalFlag((FLAG)TWN_Hospital_State_PeacefulResolution_3830c1aa-6271-4af8-ba6c-0537bad1c624)
		AND
		NOT DB_GlobalFlag((FLAG)TWN_Hospital_Event_MakeNursesKillEachOther_eeaccd5b-792a-4aa2-8503-17e0075422c7)
		AND
		DB_Players(_Player)
		THEN
		DB_TWN_Hospital_SurgeonKilledNoWeakening(1);
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_FolkHero_TownBossKilledNoAdvantage");
		
		IF
		DB_TWN_Hospital_TollhouseMasterKilledNoWeakening(1)
		AND
		DB_TWN_Hospital_BrewerKilledNoWeakening(1)
		AND
		DB_TWN_Hospital_SurgeonKilledNoWeakening(1)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_FolkHero_AllTownBossKilledNoAdvantage");
		
		//Last Light Alfira Reunion
		IF
		DialogEnded(HAV_AlfiraTale_Bard_741330b4-77ee-f113-3974-4d4d61763d29, _ID)
		AND
		DB_DialogPlayers(_ID, _Player, _)
		AND
		GetFlag(HAV_AlfiraTale_HasMet_Upset_6886508a-d28b-273f-e91b-3c671d1d3029, _Player, 0)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_FolkHero_LastLightAlfiraReunion");
		
		//Picked a side in the Marcus Isobel scene
		IF 
		DialogEnded((DIALOGRESOURCE)HAV_TakingIsobel_SpyCapture_1b698557-76c0-1166-6415-91fadb358985, _)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_FolkHero_PickSideIsobelMarcusConfrontation");
		
		// Harpers survive the ambush
		PROC
		PROC_GLO_DefeatCounter_AllPermaDefeated("SCL_HarperScouts_ShadowsDefeated")
		AND
		NOT QRY_GLO_Backgrounds_AnyDriderHarpersPermadefeated()
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_FolkHero_NoDeathsHarperShadowAmbush");
		
		QRY
		QRY_GLO_Backgrounds_AnyDriderHarpersPermadefeated()
		AND
		DB_SCL_HarperScouts_Scouts(_Harper)
		AND
		DB_PermaDefeated(_Harper)
		THEN
		DB_NOOP(1);
		
		// Rolan saved
		IF
		FlagSet(SCL_Prodigy_State_SavedFromShadows_ad212abc-6ab6-9923-6c3f-ebae3d7ba8a7, _, _)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_FolkHero_SavingRolan");
		
		IF
		DB_MOO_Jailbreak_Prisoner(_Prisoner, _)
		AND
		DB_PermaDefeated(_Prisoner)
		AND
		NOT DB_MOO_Backgrounds_FolkHeroFailedMoonriseJailbreak(1)
		THEN
		DB_MOO_Backgrounds_FolkHeroFailedMoonriseJailbreak(1);
		
		PROC
		PROC_MOO_Jailbreak_End()
		AND
		NOT DB_MOO_Backgrounds_FolkHeroFailedMoonriseJailbreak(1)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_FolkHero_MoonrisePrisonBreak");
		//END_REGION 
		
		//REGION Guild Artisan
		IF
		UseFinished(_Player, (ITEM)S_TWN_MasonsGuild_Plaque_fc0b2ed9-d912-4717-9b93-132ccda2f9e1, 1)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_GuildArtisan_FateOfMason");
		DB_TWN_FateLearned("Mason");
		
		IF
		CastedSpell(S_TWN_Hospital_Surgeon_e58b8b34-038b-4858-b817-c2a8096a9381, _Spell, _, _, _)
		AND
		DB_TWN_Hospital_SurgeonSpells(_Spell, _)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_GuildArtisan_SurgeonOperationWitness");
		
		IF
		TemplateRemovedFrom(MAG_Fire_HeatOnTakingFireDamage_Amulet_ad278f33-7c10-4779-88fc-d1448f25ae72, _, S_TWN_Tollhouse_ConfiscatedItems_9bb4a600-0da0-4e75-acb7-d1aa8ecde3d5)
		AND
		GetClosestPlayer(S_TWN_Tollhouse_Tolls_2b1ace93-a0ea-49a3-9328-b62117a62753, _Player, _)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_GuildArtisan_TollTakerLootRareItem");
		
		//Used all 3 gems in Shar Temple device
		IF
		FlagSet((FLAG)SHA_Trials_Event_UnlockNightsongChamber_8e857d0c-990b-4029-aa28-f5b935fb8c0f, _, _)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_GuildArtisan_SharTempleGemPuzzle");
		
		IF
		FlagSet(MOO_Jailbreak_State_GnomesHaveTools_740c0cea-1876-d336-7601-2418455692b1, _, _)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_GuildArtisan_WulbrenToolsReturned");
		//END_REGION
		
		//REGION Noble
		IF
		FlagSet(GEN_TransferNPCPayment_41179aa7-bc85-02b5-1399-71a651d9dc85, _Player, _ID)
		AND
		DB_DialogName((DIALOGRESOURCE)TWN_Tollhouse_TollhouseMaster_1fc993a8-c338-7cd6-aef2-add52d540d28, _ID)
		THEN
		DB_TWN_Tollhouse_GaveGold(1);
		
		IF
		DB_PermaDefeated((CHARACTER)S_TWN_Tollhouse_TollhouseMaster_3b460226-8ca2-4bbc-9bd7-8bb947aa2c06)
		AND
		NOT DB_TWN_Tollhouse_GaveGold(1)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Noble_NoGoldGivenTollTaker");
		
		//Used Balthazar's bell
		IF
		CastedSpell((CHARACTER)_Player, "Shout_SHA_GolemBell_Summon", _, _, _)
		AND
		DB_Players(_Player)
		AND
		QRY_SHA_Necromancer_CanSummonFleshGolem(_Player)
		AND
		DB_QRYRTN_SHA_Necromancer_SummonGolemToCombat(_CombatID)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Noble_BalthazarBellObtained");
		
		//Ketheric Story learned
		IF
		FlagSet((FLAG)GLO_Isobel_KnowsKethericFather_93182f99-8977-42bb-a3c5-094a7a686068, _, _)
		AND
		DB_GlobalFlag((FLAG)MOO_KethericsChambers_Knows_KethericsWife_265c4b21-25cb-4ea2-b9fe-0f37d035b886)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Noble_KethericStoryLearned");
		
		IF
		FlagSet((FLAG)MOO_KethericsChambers_Knows_KethericsWife_265c4b21-25cb-4ea2-b9fe-0f37d035b886, _, _)
		AND
		DB_GlobalFlag((FLAG)GLO_Isobel_KnowsKethericFather_93182f99-8977-42bb-a3c5-094a7a686068)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Noble_KethericStoryLearned");
		
		IF
		DialogStarted(HAV_Cat_f0f605ba-c88e-10ee-22a4-f46464c43e17, _ID)
		AND
		DB_DialogPlayers(_ID, _Player, _)
		AND
		IsTagged(_Player, (TAG)PETPAL_dc860a81-f3c2-4c1a-ab90-e7583324845c, 1)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Noble_MetLordlyCat");
		
		// Halsin recruited
		IF
		DB_GlobalFlag((FLAG)GLO_Origin_PartOfTheTeam_Halsin_77382f4f-8302-4642-b6ba-6f0bc8acf5c3)
		AND
		DB_GlobalFlag((FLAG)GLO_LiftingTheCurse_State_HalsinRecruitable_2c8b6be0-558d-485c-b4f2-93ec1926a2fa)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Noble_RecruitHalsin");
		
		// Finished Drider escort to tower
		PROC
		PROC_State_Changed(S_SCL_Drider_aa59ce01-3d2e-42e8-a539-c07e0ea292ab, "SCL_TheDrider", "ReachedMoonriseTower")
		AND
		DB_GlobalFlag((FLAG)SCL_Drider_State_SidedWithCaravan_57a698da-0149-48d1-91fa-9a84a5dcc293)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Noble_DriderEscortComplete");
		
		IF
		DB_PartOfTheTeam(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Noble_RecruitMinthara");
		
		IF
		DialogStarted(MOO_Audience_Ketheric_26cf4f1f-7f17-e59c-245c-6ed6e767d28f, _ID)
		AND
		DB_DialogPlayers(_ID, _Player, _)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Noble_MeetingKetheric");
		
		IF
		DialogStarted(MOO_Audience_RoofTransgression_72643ac1-4dcc-b11c-0410-815254c03095, _ID)
		AND
		DB_DialogPlayers(_ID, _Player, _)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Noble_MeetingKetheric");
		
		
		//END_REGION
		
		//REGION Outlander
		//Completed Shar Temple without visiting Haven or Moonrise
		IF
		DB_InRegion(_Player,S_HAV_Haven_SUB_6ac001f4-9c56-4a1b-963d-a509e158ffab)
		AND
		NOT DB_GlobalFlag(GLO_Haven_EverEnteredBefore_f1176fa0-ec29-410e-bffa-24623b19c8e4)
		THEN 
		PROC_GlobalSetFlagAndCache(GLO_Haven_EverEnteredBefore_f1176fa0-ec29-410e-bffa-24623b19c8e4);
		
		IF
		DB_GlobalFlag((FLAG)SHA_NightsongPrison_State_PlayerEnteredPrison_f2cbe7cf-5223-4522-a649-879d08638282)
		AND
		NOT DB_GlobalFlag(GLO_MoonriseTower_EverEnteredBefore_26aeabb0-7644-4897-9bbd-7a95e3e8930f)
		AND
		NOT DB_GlobalFlag(GLO_Haven_EverEnteredBefore_f1176fa0-ec29-410e-bffa-24623b19c8e4)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Outlander_CompleteSharNoLastLightMoonrise");
		
		//Act2_Outlander_ExploreColonyFully
		IF
		DB_InRegion(_Player,_Trigger)
		AND
		DB_GLO_Backgrounds_ExploreColonyFully_Subregions(_Trigger)
		AND
		DB_Players(_Player)
		AND
		NOT DB_GLO_Backgrounds_ExploreColonyFully_Visited(_Player,_Trigger)
		THEN
		DB_GLO_Backgrounds_ExploreColonyFully_Visited(_Player,_Trigger);
		
		IF
		DB_GLO_Backgrounds_ExploreColonyFully_Visited((CHARACTER)_Player,(TRIGGER)_Trigger)
		AND
		NOT QRY_GLO_Backgrounds_ExploreColonyFully_AnyRegionNotVisited(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Outlander_ExploreColonyFully");
		
		QRY
		QRY_GLO_Backgrounds_ExploreColonyFully_AnyRegionNotVisited((CHARACTER)_Player)
		AND
		DB_GLO_Backgrounds_ExploreColonyFully_Subregions(_Trigger)
		AND
		NOT DB_GLO_Backgrounds_ExploreColonyFully_Visited(_Player,_Trigger)
		THEN
		DB_NOOP(1);
		
		// Won hide and seek against Oliver
		IF
		FlagSet((FLAG)SCL_OliversDiary_FoundAgain_6596035e-4583-764f-52fb-c995ec9737bf, _, _)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Outlander_WonOliverHideNSeek");
		
		// Protected Halsin's portal during the ritual.
		IF
		FlagSet((FLAG)HAV_LiftingTheCurse_State_ChannelingComplete_1afd47bc-e8d5-464d-823a-7dba82fcf5c3, _, _)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Outlander_ProtectedHalsinPortal");
		
		// Visiting Moonrise and Last light without ever acquiring the moonlantern
		IF
		StatusApplied((CHARACTER)_Player, "SCL_MOONSHIELD", _, _)
		AND
		DB_Players(_Player)
		AND
		NOT DB_GLO_Backgrounds_ExploreShadowlands_BlockGoal(1)
		AND
		NOT QRY_MOO_IsInMOO(_Player)
		AND
		IsInTrigger(_Player, S_MOO_EntranceGoalBox_2c4f4d85-6d96-4ac9-becd-8d3c23657854, 0)
		THEN
		DB_GLO_Backgrounds_ExploreShadowlands_BlockGoal(1);
		
		PROC
		PROC_MOO_PlayerLeftMOO(_Player)
		AND
		NOT DB_GLO_Backgrounds_ExploreShadowlands_BlockGoal(1)
		AND
		IsInTrigger(_Player, S_MOO_EntranceGoalBox_2c4f4d85-6d96-4ac9-becd-8d3c23657854, 0)
		AND
		HasActiveStatus(_Player, "SCL_MOONSHIELD", 1)
		THEN
		DB_GLO_Backgrounds_ExploreShadowlands_BlockGoal(1);
		
		IF
		LeftTrigger(_Player, S_MOO_EntranceGoalBox_2c4f4d85-6d96-4ac9-becd-8d3c23657854)
		AND
		NOT DB_GLO_Backgrounds_ExploreShadowlands_BlockGoal(1)
		AND
		NOT QRY_MOO_IsInMOO(_Player)
		AND
		HasActiveStatus(_Player, "SCL_MOONSHIELD", 1)
		THEN
		RealtimeObjectTimerLaunch(_Player, "GLO_Backgrounds_CheckMoonshield", 1000);
		
		IF
		ObjectTimerFinished((CHARACTER)_Player, "GLO_Backgrounds_CheckMoonshield")
		AND
		NOT QRY_MOO_IsInMOO(_Player)
		AND
		IsInTrigger(_Player, S_MOO_EntranceGoalBox_2c4f4d85-6d96-4ac9-becd-8d3c23657854, 0)
		AND
		HasActiveStatus(_Player, "SCL_MOONSHIELD", 1)
		THEN
		DB_GLO_Backgrounds_ExploreShadowlands_BlockGoal(1);
		
		IF
		StatusApplied((CHARACTER)_Player, "GLO_PIXIESHIELD", _, _)
		AND
		DB_Players(_Player)
		THEN
		DB_GLO_Backgrounds_ExploreShadowlands_BlockGoal(1);
		
		IF
		EnteredTrigger(_Player, _Trigger)
		AND
		DB_Players(_Player)
		AND
		DB_GLO_Backgrounds_ExploreShadowlands_RegionTriggers(_Region, _Trigger)
		THEN
		DB_GLO_Backgrounds_ExploreShadowlands_Visited(_Player, _Region);
		
		IF
		DB_GLO_Backgrounds_ExploreShadowlands_Visited(_Player, "MOO_Moonrise")
		AND
		DB_GLO_Backgrounds_ExploreShadowlands_Visited(_Player, "HAV_LastLight")
		AND
		NOT DB_GLO_Backgrounds_ExploreShadowlands_BlockGoal(1)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Outlander_ExplorationWithoutMoonlantern");
		
		// Exploring the key areas of act 2
		IF
		EnteredTrigger(_Player, _Trigger)
		AND
		DB_Players(_Player)
		AND
		DB_GLO_Backgrounds_ExploreShadowlands_KeyAreas(_Trigger)
		THEN
		PROC_GLO_Backgrounds_ExploringTheShadowlands(_Player, _Trigger);
		
		PROC
		PROC_GLO_Backgrounds_ExploringTheShadowlands((CHARACTER)_Player, (TRIGGER)_Trigger)
		THEN
		DB_GLO_Backgrounds_ExploreShadowlands_KeyAreasExplored(_Player, _Trigger);
		
		PROC
		PROC_GLO_Backgrounds_ExploringTheShadowlands((CHARACTER)_Player, (TRIGGER)_Trigger)
		AND
		NOT QRY_GLO_Backgrounds_ExploreShadowlands_AnyAreaNotVisited(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Outlander_SCLFullyExplored");
		
		QRY
		QRY_GLO_Backgrounds_ExploreShadowlands_AnyAreaNotVisited((CHARACTER)_Player)
		AND
		DB_GLO_Backgrounds_ExploreShadowlands_KeyAreas(_Trigger)
		AND
		NOT DB_GLO_Backgrounds_ExploreShadowlands_KeyAreasExplored(_Player, _Trigger)
		THEN
		DB_NOOP(1);
		
		// Survive a stage 2 shadowcurse
		IF
		StatusApplied((CHARACTER)_Player, "SCL_SHADOW_CURSE_3", _, _)
		AND
		DB_Players(_Player)
		AND
		NOT DB_Downed(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Outlander_SurviveShadowCurseStage2");
		
		// Player long rests in SCL
		PROC
		PROC_LongRest_Player(_Player, _)
		AND
		DB_ActiveCamp("SCLMAIN")
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Outlander_LongRestSCL");
		
		// Never affected by the shadowcurse when reaching Nightsong.
		IF
		StatusApplied((CHARACTER)_Player, "SCL_SHADOW_CURSE", _, _)
		AND
		DB_Players(_Player)
		THEN
		DB_GLO_Backgrounds_AffectedByShadowcurse(_Player);
		
		IF
		LeftTrigger(_Player, (TRIGGER)S_SHA_NightsongPrison_SUB_0a302268-dd92-4462-99e5-ca7491815ec0)
		AND
		NOT DB_GLO_Backgrounds_AffectedByShadowcurse(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Outlander_NeverAffectedShadowCurse");
		
		// Defeating three combat encounters in SCL
		IF
		FlagSet(_CombatGroupPermaDefeated, _, _)
		AND
		DB_GLO_Backgrounds_ShadowlandsEncounters(_CombatGroupPermaDefeated)
		THEN
		PROC_IncreaseCounter("Act2_Backgrounds_EncountersBeaten");
		
		PROC
		PROC_CounterIncreased("Act2_Backgrounds_EncountersBeaten", 3)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Outlander_ThreeCombatEncountersSCL");
		
		IF
		TemplateAddedTo(MAG_Orthon_Hellfire_HandCrossbow_f5b3b579-3569-4f6d-835c-9c19245152d6, _, _Player, _)
		AND
		DB_Players((CHARACTER)_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Outlander_ObtainOrhtonCrossbow");
		
		IF
		DB_InRegion(_Player,_Trigger)
		AND
		DB_Players(_Player)
		AND
		DB_MOO_Backgrounds_OutlanderMoonriseOutsideEntranceDoors(_Door, _Trigger)
		THEN
		NOT DB_MOO_Backgrounds_OutlanderMoonriseOutsideEntranceDoors(_Door, _Trigger);
		
		IF
		UseFinished(_Player, _Door, 1)
		AND
		DB_MOO_Backgrounds_OutlanderMoonriseOutsideEntranceDoors(_Door, _Trigger)
		AND
		IsOpening(_Door, 1)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Outlander_ExploreMoonriseExteriorPath");
		
		IF
		EnteredTrigger(_Player, S_MOO_Oubliette_SUB_c6f54de0-1c8f-4cf8-bcf9-b13c8f53b05b)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Outlander_ExploreOubliette");
		//END_REGION
		
		//REGION Sage
		IF
		DB_InteractiveDialogSpeaker(_ID, S_MOO_Ketheric_e9918f3e-5b87-40a3-a9bd-61545151573f)
		THEN
		DB_TWN_FateLearned("Ketheric");
		
		IF
		DB_TWN_FateLearned("TollhouseCollector")
		AND
		DB_TWN_FateLearned("Brewer")
		AND
		DB_TWN_FateLearned("Surgeon")
		AND
		DB_TWN_FateLearned("Mason")
		AND
		DB_TWN_FateLearned("Ketheric")
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Sage_ThormFamilyFates");
		
		//Act2_Sage_ColonyMindPuzzleCompleted
		IF
		FlagSet(COL_Vault_State_Unlocked_d712a88e-1946-4f9d-8096-697254963072,_,_)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Sage_ColonyMindPuzzleCompleted");
		
		IF
		FlagSet(MOO_BalthazarsSecrets_State_BookcaseOpened_f24ceb4a-5095-4509-8daa-406dbf8f8685, _, _)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Sage_GainedAccessToNecromancerLab");
		
		IF
		UseFinished(_Player, _Book, 1)
		AND
		DB_MOO_BalthazarsSecrets_TrapBooks(_Book)
		AND
		_Book != S_MOO_TrapBook_001_bb48a971-aad4-4c10-8907-addb6d32ba94
		THEN
		DB_MOO_Backgrounds_FailedGainedAccessToNecromancerLabFlawlessly(1);
		
		IF
		FlagSet(MOO_BalthazarsSecrets_State_BookcaseOpened_f24ceb4a-5095-4509-8daa-406dbf8f8685, _, _)
		AND
		NOT DB_MOO_Backgrounds_FailedGainedAccessToNecromancerLabFlawlessly(1)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Sage_GainedAccessToNecromancerLabFlawlessly");
		
		PROC
		PROC_SHA_Mausoleum_OpenSecretDoors()
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Sage_SharTempleEntrancePuzzle");
		
		IF
		FlagSet((FLAG)SHA_Nightsong_HasMet_6b56f4b8-8bb3-5393-de12-d320fbb55218,_,_)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Sage_TruthOfNightsongDiscovered");
		
		//END_REGION
		
		//REGION Soldier
		IF
		FlagSet((FLAG)TWN_ArabellasPowers_State_ToldParentsDead_cc1a3765-9334-cb88-602f-49ca052de39c,NULL_00000000-0000-0000-0000-000000000000,_ID)
		AND
		DB_DialogPlayers(_ID,_Player,1)
		AND
		QRY_OnlyOnce("Background_Goal_Act2_Soldier_Arabella")
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Soldier_ToldArabellaTruth");
		
		IF
		FlagSet((FLAG)TWN_ArabellaPowers_State_HandledNews_Jergal_80a6a1bd-051a-b2d4-3c36-3dedeaf8d02b,NULL_00000000-0000-0000-0000-000000000000,_ID)
		AND
		DB_DialogPlayers(_ID,_Player,1)
		AND
		QRY_OnlyOnce("Background_Goal_Act2_Soldier_Arabella")
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Soldier_LiedToArabella");
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Charlatan_ArabellaParentsFate");
		
		IF
		DB_PermaDefeated((CHARACTER)S_TWN_Tollhouse_TollhouseMaster_3b460226-8ca2-4bbc-9bd7-8bb947aa2c06)
		AND
		DB_PermaDefeated((CHARACTER)S_TWN_Hospital_Surgeon_e58b8b34-038b-4858-b817-c2a8096a9381)
		AND
		DB_PermaDefeated((CHARACTER)S_TWN_Distillery_Brewer_4d9e3db3-9a78-4f4b-8101-1dd73c0f3be5)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Soldier_ThormFamilyMembersKilled");
		
		IF
		DB_PermaDefeated(_Boss)
		AND
		NOT DB_OnlyOnce("SCL_BossKilledInOneRound")
		AND
		DB_GlobalFlag((FLAG)CURRENTREGION_SCL_Main_A_f76b85b5-b557-4409-98fd-cc7b22f8292b)
		AND
		DB_Was_InCombat(_Boss, _CombatID)
		AND
		DB_CMB_RoundCounter(_CombatID, 2)
		AND
		DB_Players(_Player)
		AND
		DB_Was_InCombat(_Player, _CombatID)
		THEN
		PROC_TWN_CheckUnlockOneRoundBossKillGoal(_Player, (CHARACTER)_Boss);
		
		PROC
		PROC_TWN_CheckUnlockOneRoundBossKillGoal((CHARACTER)_Player, (CHARACTER)_Boss)
		AND
		IsTagged(_Player, (TAG)SOLDIER_d135f265-c2e1-4077-a836-b548ee871681, 1)
		AND
		IsBoss(_Boss, 1)
		AND
		QRY_OnlyOnce("SCL_BossKilledInOneRound")
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Soldier_Act2BossKilled");
		
		IF
		CastedSpell(S_TWN_Hospital_Surgeon_e58b8b34-038b-4858-b817-c2a8096a9381, _Spell, _, _, _)
		AND
		DB_TWN_Hospital_SurgeonSpells(_Spell, _)
		THEN
		DB_TWN_Hospital_SurgeonPerformedOperation(1);
		
		IF
		DB_PermaDefeated(S_TWN_Hospital_Surgeon_e58b8b34-038b-4858-b817-c2a8096a9381)
		AND
		NOT DB_TWN_Hospital_SurgeonPerformedOperation(1)
		AND
		GetClosestPlayer(S_TWN_Hospital_Surgeon_e58b8b34-038b-4858-b817-c2a8096a9381, _Player, _)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Soldier_NoInsurance");
		
		IF
		StatusApplied(_Player, "HAV_SELUNEOINTMENT", _, _)
		AND
		DB_Players((CHARACTER)_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Soldier_IsobelSeluneBlessing");
		
		IF
		FlagSet((FLAG)HAV_Siege_State_NoProtection_2da0dbf1-88ca-4cab-9c8f-ee8921822958, _, _)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Soldier_LastLightDestroyed");
		
		//Shar Mirror Trial
		IF
		FlagSet(SHA_Trials_Event_PlayersWinCombat_dea864a4-3c94-4315-8b02-c2f813cd57d2, _, _)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Soldier_MirrorSharTrialComplete");
		
		//Defeated Orthon
		IF
		FlagSet(SHA_Orthon_State_DefeatedOnce_8dd589d6-90fc-4a3b-b369-10440bd56520, _, _)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Soldier_OrthonKilled");
		
		//Completed the Drider/Harpers ambush
		PROC
		PROC_SCL_Drider_CheckWinner()
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Soldier_HarperDriderAmbushCompleted");
		
		PROC
		PROC_MOO_Assault_Over()
		AND
		DB_Players(_Player)
		AND
		DB_InRegion(_Player, S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Soldier_MoonriseDestroyed");
		
		PROC
		PROC_MOO_Assault_Over()
		AND
		DB_Players(_Player)
		AND
		DB_InRegion(_Player, S_MOO_Prison_SUB_b262cbea-f40c-47da-9f34-ba8ce5bf782b)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Soldier_MoonriseDestroyed");
		
		IF
		FlagSet(MOO_Assault_State_PrisonCombatDefeated_3ca7d513-98ff-4a47-9a7a-7fb8b2b42377, _, _)
		AND
		DB_Players(_Player)
		AND
		DB_InRegion(_Player, S_MOO_Prison_SUB_b262cbea-f40c-47da-9f34-ba8ce5bf782b)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Soldier_MoonriseSkeletonAssault");
		//END_REGION
		
		//REGION Urchin
		IF
		EnteredTrigger(_Player, S_MOO_Oubliette_SUB_c6f54de0-1c8f-4cf8-bcf9-b13c8f53b05b)
		AND
		DB_Players(_Player)
		AND
		NOT DB_MOO_Backgrounds_UrchinEnteredOubliette(1)
		THEN
		DB_MOO_Backgrounds_UrchinEnteredOubliette(1);
		
		IF
		LeftTrigger(_Player, S_MOO_Oubliette_SUB_c6f54de0-1c8f-4cf8-bcf9-b13c8f53b05b)
		AND
		DB_Players(_Player)
		AND
		DB_MOO_Backgrounds_UrchinEnteredOubliette(1)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_Urchin_EscapedOubliette");
		
		PROC
		PROC_MOO_KitchenFight_GnollsFrenzy()
		AND
		DB_Players(_Player)
		AND
		DB_InRegion(_Player, S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Urchin_MoonriseGnollsFreed");
		
		//Met both Act 2 Cats
		IF
		FlagSet(HAV_Cat_HasMet_dd1b4f56-3dd1-6a4d-e83f-042302cb9ab7, _Player, _)
		AND
		GetFlag(MOO_CatBusiness_HasMet_SwA_bc0cc772-4c2c-426a-b9f9-934181fe60b5, _Player, 1)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Urchin_MetAllAct2Cats");
		
		IF
		FlagSet(MOO_CatBusiness_HasMet_SwA_bc0cc772-4c2c-426a-b9f9-934181fe60b5, _Player, _)
		AND
		GetFlag(HAV_Cat_HasMet_dd1b4f56-3dd1-6a4d-e83f-042302cb9ab7, _Player, 1)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Urchin_MetAllAct2Cats");
		
		// Played both rounds of Hide and Seek with Oliver
		IF
		DialogStarted((DIALOGRESOURCE)SCL_OliversDiary_OliverShadow_7924b3e2-0329-7e1d-616c-6d2df0c43b68, _)
		AND
		DB_GlobalFlag((FLAG)SCL_OliversDiary_State_SecondRound_b361382e-f0a8-f6eb-902a-da4d5044f90e)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Urchin_PlayedBothGamesOliver");
		
		//Betrayed Balthazar
		PROC
		PROC_StateSet_PermaDefeated(S_SHA_Necromancer_53651a9f-7ea8-444f-ba2d-224390b72f7d)
		AND
		DB_GlobalFlag((FLAG)SHA_Necromancer_State_AskedHelp_1e06992f-24ad-254e-42aa-a0092f6f8431)
		AND
		QRY_State_IsBeforeState(S_SHA_Necromancer_53651a9f-7ea8-444f-ba2d-224390b72f7d, "SHA_Necromancer", "SHA_Necromancer_State_AtMoonrise")
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Urchin_BalthazarKilledPostMeeting");
		
		IF
		AddedTo(S_COL_NecromancerLab_MolEyepatch_fa9baba1-f855-449c-8327-9728a493b193, (CHARACTER)_Player,_)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act2_Urchin_MolFateDiscovered");
		
		//END_REGION
		
		//REGION Haunted One
		IF
		FlagSet((FLAG)HAV_Isobel_State_IsDead_af8b23d8-d04d-4e42-8a56-be909226e706, _, _)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_HauntedOne_IsobelKilled");
		
		IF
		FlagSet((FLAG)GLO_Jaheira_State_PermaDefeated_932fb5a1-00ba-4621-b7ae-877d40d7ddcd, _, _)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_HauntedOne_JaheiraKilled");
		
		IF
		FlagSet(SHA_Necromancer_State_PermaDefeated_c8fc43c5-f6bb-4c15-9869-8ceefc288ef2, _, _)
		AND
		DB_Players(_Player)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act2_HauntedOne_BalthazarKilled");
		
		//Act2_HauntedOne_KethericKilled
		PROC
		PROC_COL_KethericShowdown_AfterDefeat()
		AND
		DB_ORI_DarkUrge((CHARACTER)_DarkUrge)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_DarkUrge, "Act2_HauntedOne_KethericKilled");
		
		PROC
		PROC_MOO_KitchenFight_GnollsFrenzy()
		AND
		DB_ORI_DarkUrge(_DarkUrge)
		AND
		DB_InRegion(_DarkUrge, S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6)
		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_DarkUrge, "Act2_HauntedOne_MoonriseGnollsFreed");
		
		
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(342).Title("Act2_GLO_LevelTravelers");
Goal(342)
{
	INIT
