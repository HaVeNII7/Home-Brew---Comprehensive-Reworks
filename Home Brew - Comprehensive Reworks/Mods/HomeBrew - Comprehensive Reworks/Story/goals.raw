		AND
		DB_Is_InCombat(_Orb, _Combat)
		AND
		IsItem(_Orb,1)
		AND
		HasActiveStatus(_Orb,"OBLITERATIONORB_AURA",1)
		THEN
		SetOnStage(_Orb,0);
		
		//Remove Orbs if dying
