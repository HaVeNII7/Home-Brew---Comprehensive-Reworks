		DB_LOW_VoloFate_AlcoholSurfaceTriggers(S_LOW_VoloFate_AlcoholSurface_PointTrigger_06_472e4b41-7112-419f-8a26-6d5c46da944c);
		DB_LOW_VoloFate_AlcoholSurfaceTriggers(S_LOW_VoloFate_AlcoholSurface_PointTrigger_07_ffd26d29-e95f-4a9b-905e-3c3e46fac8e6);
		DB_LOW_VoloFate_AlcoholSurfaceTriggers(S_LOW_VoloFate_AlcoholSurface_PointTrigger_08_5357a6a0-be1c-4665-9e7e-242f12cfa8b4);
		DB_LOW_VoloFate_AlcoholSurfaceTriggers(S_LOW_VoloFate_AlcoholSurface_PointTrigger_09_6fc1e1e6-fa50-41ae-a200-0a9890933522);
		DB_LOW_VoloFate_AlcoholSurfaceTriggers(S_LOW_VoloFate_AlcoholSurface_PointTrigger_10_883569e5-a84f-462d-ad16-c69de10058e7);
		DB_LOW_VoloFate_AlcoholSurfaceTriggers(S_LOW_VoloFate_AlcoholSurface_PointTrigger_11_30006a37-0c61-4890-8e51-3deef8e23c2c);
		DB_LOW_VoloFate_AlcoholSurfaceTriggers(S_LOW_VoloFate_AlcoholSurface_PointTrigger_12_22d30b9d-c2bd-4679-9723-1fb7181d7ddc);
		DB_LOW_VoloFate_AlcoholSurfaceTriggers(S_LOW_VoloFate_AlcoholSurface_PointTrigger_13_c3096159-e821-48d2-94ed-f73edca792d3);
		DB_LOW_VoloFate_AlcoholSurfaceTriggers(S_LOW_VoloFate_AlcoholSurface_PointTrigger_14_395444d0-cc0d-491e-98bc-1694848f9ecd);
		DB_LOW_VoloFate_AlcoholSurfaceTriggers(S_LOW_VoloFate_AlcoholSurface_PointTrigger_15_7ff8895a-a437-4739-b2bc-f87322f55c29);
		DB_LOW_VoloFate_AlcoholSurfaceTriggers(S_LOW_VoloFate_AlcoholSurface_PointTrigger_16_eff54613-ad9c-48aa-a264-b3e7c9ca9faf);
		DB_LOW_VoloFate_AlcoholSurfaceTriggers(S_LOW_VoloFate_AlcoholSurface_PointTrigger_17_340cb6b6-18aa-43da-b0a9-55bbed262a37);
		
		// Used to fast-forward the situation in case of the Foundry destroyed
		DB_LOW_VoloFate_FoundryDestroyedFlags((FLAG)LOW_SteelWatchFoundry_State_Destroyed_cdfffe24-5082-4e41-b7c2-f1fef6da3a8a);
		DB_LOW_VoloFate_FoundryDestroyedFlags(LOW_SteelWatchFoundry_State_ShutDownByBrain_07595def-a21f-4edf-ab31-2974fc354d38);
		
		PROC_LOW_VoloFate_Setup();
	}
	KB
	{
		//REGION Situation setup
		IF
		DB_LOW_VoloFate_Thug_Support(_Thug)
		THEN
		DB_LOW_VoloFate_Thugs(_Thug);
		
		IF
		DB_LOW_VoloFate_Thugs(_Thug)
		THEN
		DB_LOW_VoloFate_Characters(_Thug);
		
		IF
		DB_LOW_VoloFate_Onlookers(_Onlooker)
		THEN
		DB_LOW_VoloFate_Characters(_Onlooker);
		
		PROC
		PROC_LOW_VoloFate_Setup()
		AND
		NOT DB_PermaDefeated(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)LOW_VoloFate_State_VoloArrivedInBG_5faacb8c-836d-4626-bb7d-418c643e494d);
		
		PROC
		PROC_LOW_VoloFate_Setup()
		AND
		DB_PermaDefeated(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa)
		THEN
		PROC_LOW_RemoveVoloAlcoholTrail();
		
		IF
		FlagSet((FLAG)LOW_VoloFate_State_VoloArrivedInBG_5faacb8c-836d-4626-bb7d-418c643e494d,_,_)
		THEN
		//TODO: despawn crowds and when the situation is resolved reenable them
		// TriggerSetCrowdSpawningEnable((TRIGGER)_Trigger, (INTEGER)_Enable)
		// TriggerDespawnCrowd((TRIGGER)_Trigger)
		TeleportTo(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,S_LOW_VoloFate_VoloPosTrigger_c9a7c968-ce75-4961-8a3c-349e4f52a622,"LOW_VoloFate_VoloInitTeleported");
		PROC_LOW_VoloExecution_SpotSetup();
		
		IF
		FlagSet((FLAG)LOW_VoloFate_State_VoloArrivedInBG_5faacb8c-836d-4626-bb7d-418c643e494d,_,_)
		AND
		DB_GlobalFlag((FLAG)GOB_VoloBallad_State_PlayersMetVolo_0c341094-ae74-4a72-b2b6-3cd98a43ae11)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_Volo_HasMet_07ff1071-2535-f215-72d3-224e360af5f2)
		THEN
		SetFlag((FLAG)GLO_Volo_HasMet_07ff1071-2535-f215-72d3-224e360af5f2);
		
		PROC
		PROC_LOW_VoloExecution_SpotSetup()
		AND
		DB_LOW_VoloFate_ExecutionDialog_Speakers(_Character)
		THEN
		DB_SpotPlayers(_Character,"LOW_VoloFate_ExecutionSpotting",NULL_00000000-0000-0000-0000-000000000000,NULL_00000000-0000-0000-0000-000000000000);
		DB_SpotPlayers_SpotTrigger(_Character,"LOW_VoloFate_ExecutionSpotting",(TRIGGER)S_LOW_VoloFate_ExecutionSpotTrigger_7e421d2a-198a-4777-ae2a-a8358476578c);
		DB_SpotPlayers_IncludeWildshapedPlayers(_Character,"LOW_VoloFate_ExecutionSpotting");
		
		IF
		DB_LOW_VoloFate_Characters(_Character)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_VoloFate_State_VoloArrivedInBG_5faacb8c-836d-4626-bb7d-418c643e494d)
		THEN
		PROC_SetOnStage(_Character,0);
		
		IF
		DB_LOW_VoloFate_Characters(_Character)
		AND
		DB_GlobalFlag((FLAG)LOW_VoloFate_State_VoloArrivedInBG_5faacb8c-836d-4626-bb7d-418c643e494d)
		THEN
		PROC_SetOnStage(_Character,1);
		DB_SceneManager(_Character,"LOW_VoloFate_ExecutionScene");
		
		IF
		DB_SceneManager((CHARACTER)S_LOW_VoloFate_Agitator_e896b270-21cd-4d5c-8b99-be87929f77f0,"LOW_VoloFate_ExecutionScene")
		THEN
		Equip((CHARACTER)S_LOW_VoloFate_Agitator_e896b270-21cd-4d5c-8b99-be87929f77f0,S_LOW_VoloFate_Agitator_Torch_c06f471a-7500-4201-942b-39a600a5bb03);
		SetWeaponUnsheathed((CHARACTER)S_LOW_VoloFate_Agitator_e896b270-21cd-4d5c-8b99-be87929f77f0,1,1);
		
		// TODO: Force update on entering trigger so Volo and exectuion cart are 100% visible by players?
		//END_REGION
		
		//REGION Items setup
		IF
		DB_LOW_VoloFate_ExecutionCart_PLT_Items(_Item)
		THEN
		SetOwner(_Item,(CHARACTER)S_LOW_VoloFate_Agitator_e896b270-21cd-4d5c-8b99-be87929f77f0);
		DB_LOW_VoloFate_Execution_Items(_Item);
		
		IF
		DB_LOW_VoloFate_Execution_Items(_Item)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_VoloFate_State_VoloArrivedInBG_5faacb8c-836d-4626-bb7d-418c643e494d)
		THEN
		PROC_SetOnStage(_Item,0);
		
		IF
		DB_LOW_VoloFate_Execution_Items(_Item)
		AND
		DB_GlobalFlag((FLAG)LOW_VoloFate_State_VoloArrivedInBG_5faacb8c-836d-4626-bb7d-418c643e494d)
		THEN
		PROC_SetOnStage(_Item,1);
		
		IF
		DB_LOW_VoloFate_NoExecution_Items(_Item)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_VoloFate_State_VoloArrivedInBG_5faacb8c-836d-4626-bb7d-418c643e494d)
		THEN
		PROC_SetOnStage(_Item,1);
		
		IF
		DB_LOW_VoloFate_NoExecution_Items(_Item)
		AND
		DB_GlobalFlag((FLAG)LOW_VoloFate_State_VoloArrivedInBG_5faacb8c-836d-4626-bb7d-418c643e494d)
		THEN
		PROC_SetOnStage(_Item,0);
		
		IF
		DestroyedBy((ITEM)_Item,_,_,_)
		AND
		DB_LOW_VoloFate_Execution_Items(_Item)
		THEN
		NOT DB_LOW_VoloFate_Execution_Items(_Item);
		
		IF
		DestroyedBy((ITEM)_Item,_,_,_)
		AND
		DB_LOW_VoloFate_NoExecution_Items(_Item)
		THEN
		NOT DB_LOW_VoloFate_NoExecution_Items(_Item);
		//END_REGION
		
		//REGION The Execution Scene
		PROC
		PROC_SpotPlayers_Spotted(_,"LOW_VoloFate_ExecutionSpotting",_Player)
		AND
		QRY_StartDialog(LOW_VoloFate_Execution_c407aee4-6981-43db-43cb-4609ea9b948a,S_LOW_VoloFate_Agitator_e896b270-21cd-4d5c-8b99-be87929f77f0,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,_Player)
		THEN
		PROC_SpotPlayers_StopSpotting("LOW_VoloFate_ExecutionSpotting");
		
		QRY
		QRY_SelectCustomDialog((CHARACTER)_Character,_Player)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_VoloFate_State_ExecutionSceneDone_ef057af1-d080-4c75-b454-15f71f1f669a)
		AND
		DB_LOW_VoloFate_ExecutionDialog_Speakers(_Character)
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)LOW_VoloFate_Execution_c407aee4-6981-43db-43cb-4609ea9b948a,S_LOW_VoloFate_Agitator_e896b270-21cd-4d5c-8b99-be87929f77f0,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,_Player)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)LOW_VoloFate_Execution_c407aee4-6981-43db-43cb-4609ea9b948a,_DialogID)
		AND
		DB_LOW_VoloFate_Thug_Support(_Thug)
		THEN
		PROC_DialogAddSpeakingActor(_DialogID,_Thug);
		
		IF
		FlagSet((FLAG)LOW_VoloFate_State_AlcoholTrailSurfaceRemoved_98974b7c-29e4-4345-887c-24a144a52213,_,_)
		THEN
		PROC_SceneOver("LOW_VoloFate_ExecutionScene");
		
		// Called from Agitator's anubis in case it fails to to explode Volo after players accept Volo's Fate
		IF
		FlagSet((FLAG)LOW_VoloFate_State_AgitatorFailedExplodeVolo_62e30e6c-58c7-4f61-9bd5-ba99f1919af7,_,_)
		THEN
		PROC_SceneOver("LOW_VoloFate_ExecutionScene");
		
		IF
		DialogEnded((DIALOGRESOURCE)LOW_VoloFate_Execution_c407aee4-6981-43db-43cb-4609ea9b948a,_DialogInst)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_VoloFate_State_AcceptedVolosFate_cdd3f96c-3b79-d4f7-cf60-a81c173d369a)
		AND
		DB_DialogPlayers(_DialogInst,_Player,_)
		THEN
		DB_LOW_VoloFate_PlayersToAttackOnDialogEnded(_Player);
		
		IF
		DialogEnded((DIALOGRESOURCE)LOW_VoloFate_Execution_c407aee4-6981-43db-43cb-4609ea9b948a,_)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_VoloFate_State_AcceptedVolosFate_cdd3f96c-3b79-d4f7-cf60-a81c173d369a)
		THEN
		PROC_SceneOver("LOW_VoloFate_ExecutionScene");
		
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)LOW_VoloFate_State_AcceptedVolosFate_cdd3f96c-3b79-d4f7-cf60-a81c173d369a)
		THEN
		SetHasDialog(S_LOW_VoloFate_Agitator_e896b270-21cd-4d5c-8b99-be87929f77f0,0);
		SetFlag((FLAG)LOW_VoloFate_State_AgitatorTriedExplodeVolo_642e4284-08c0-44cd-bf59-3eba7a877590);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)LOW_VoloFate_State_AcceptedVolosFate_cdd3f96c-3b79-d4f7-cf60-a81c173d369a)
		AND
		DB_LOW_VoloFate_Characters(_Character)
		AND
		_Character != S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa
		AND
		_Character != S_LOW_VoloFate_Agitator_e896b270-21cd-4d5c-8b99-be87929f77f0
		THEN
		PROC_GenericsSetBusyDialog(_Character);
		
		IF
		DB_PermaDefeated(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa)
		AND
		DB_GlobalFlag((FLAG)LOW_VoloFate_State_AgitatorThrewTorchAtBarrel_077b8b06-9d86-4eb4-b6cf-cd0b189b29ee)
		THEN
		PROC_LOW_VoloExplodedByAgitator();
		
		PROC
		PROC_LOW_VoloExplodedByAgitator()
		THEN
		PROC_SceneOver("LOW_VoloFate_ExecutionScene");
		
		PROC
		PROC_LOW_VoloExplodedByAgitator()
		AND
		DB_LOW_VoloFate_Characters(_Character)
		AND
		_Character != S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa
		THEN
		PROC_DisappearOutOfSight(_Character,"Walk",0,"");
		
		PROC
		PROC_SceneInterrupted(_,_,"LOW_VoloFate_ExecutionScene","Attacked")
		THEN
		PROC_SceneOver("LOW_VoloFate_ExecutionScene");
		
		PROC
		PROC_SceneInterrupted(_,_,"LOW_VoloFate_ExecutionScene","EnteredCombat")
		THEN
		PROC_SceneOver("LOW_VoloFate_ExecutionScene");
		
		PROC
		PROC_SceneInterrupted(_,_,"LOW_VoloFate_ExecutionScene","DisturbanceRegistering")
		THEN
		PROC_SceneOver("LOW_VoloFate_ExecutionScene");
		
		// In case players use Help on Volo
		IF
		StatusRemoved(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"TIED_TO_CHAIR",_,_)
		THEN
		PROC_SceneOver("LOW_VoloFate_ExecutionScene");
		
		PROC
		PROC_SceneOver("LOW_VoloFate_ExecutionScene")
		AND
		QRY_OnlyOnce("LOW_VoloExecutionSceneOver_OnlyOnce")
		THEN
		PROC_LOW_VoloFate_ExecutionSceneOver();
		
		PROC
		PROC_LOW_VoloFate_ExecutionSceneOver()
		THEN
		PROC_SpotPlayers_StopSpotting("LOW_VoloFate_ExecutionSpotting");
		PROC_GlobalSetFlagAndCache((FLAG)LOW_VoloFate_State_ExecutionSceneDone_ef057af1-d080-4c75-b454-15f71f1f669a);
		
		PROC
		PROC_LOW_VoloFate_ExecutionSceneOver()
		AND
		NOT QRY_LOW_VoloFate_IsFoundryDestroyed()
		THEN
		PROC_SetRelationMutual(ACT3_LOW_VoloFate_Thugs_3e181f1b-68a7-4b5b-9174-84668c56dde9,GLO_Volo_6c49b752-0dc2-4f85-86cf-0c2bd418305c,0);
		PROC_LOW_VoloFate_ThugsAggro();
		
		QRY
		QRY_LOW_VoloFate_IsFoundryDestroyed()
		AND
		DB_GlobalFlag((FLAG)LOW_SteelWatchFoundry_State_Destroyed_cdfffe24-5082-4e41-b7c2-f1fef6da3a8a)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_LOW_VoloFate_IsFoundryDestroyed()
		AND
		DB_GlobalFlag((FLAG)LOW_SteelWatchFoundry_State_ShutDownByBrain_07595def-a21f-4edf-ab31-2974fc354d38)
		THEN
		DB_NOOP(1);
		
		// Needed for the edge case of moving exploding barrels, thus triggering disturbance but also starting intro dialog
		PROC
		PROC_SetRelationMutual(ACT3_LOW_VoloFate_Thugs_3e181f1b-68a7-4b5b-9174-84668c56dde9,GLO_Volo_6c49b752-0dc2-4f85-86cf-0c2bd418305c,0)
		THEN
		PROC_ForceStopDialog(S_LOW_VoloFate_Agitator_e896b270-21cd-4d5c-8b99-be87929f77f0);
		
		IF
		RelationChanged((FACTION)ACT3_LOW_VoloFate_Thugs_3e181f1b-68a7-4b5b-9174-84668c56dde9,(FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360,0,1)
		AND
		DB_LOW_VoloFate_PlayersToAttackOnDialogEnded(_Player)
		THEN
		PROC_EnterCombat(_Player,S_LOW_VoloFate_Agitator_e896b270-21cd-4d5c-8b99-be87929f77f0);
		
		IF
		RelationChanged((FACTION)ACT3_LOW_VoloFate_Thugs_3e181f1b-68a7-4b5b-9174-84668c56dde9,(FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360,0,1)
		AND
		DB_LOW_VoloFate_PlayersToAttackOnDialogEnded(_Player)
		THEN
		NOT DB_LOW_VoloFate_PlayersToAttackOnDialogEnded(_Player);
		
		PROC
		PROC_LOW_VoloFate_ThugsAggro()
		AND
		NOT DB_GlobalFlag((FLAG)LOW_VoloFate_State_AgitatorThrewTorchAtBarrel_077b8b06-9d86-4eb4-b6cf-cd0b189b29ee)
		THEN
		Unequip((CHARACTER)S_LOW_VoloFate_Agitator_e896b270-21cd-4d5c-8b99-be87929f77f0,(ITEM)S_LOW_VoloFate_Agitator_Torch_c06f471a-7500-4201-942b-39a600a5bb03);
		DB_LOW_VoloFate_AgitatorSetsTrailOnFire(1);
		PROC_SetRelationToPlayers(ACT3_LOW_VoloFate_Thugs_3e181f1b-68a7-4b5b-9174-84668c56dde9,0);
		PROC_SetRelationToPlayers(GLO_Volo_6c49b752-0dc2-4f85-86cf-0c2bd418305c,100);
		
		IF
		Unequipped((ITEM)S_LOW_VoloFate_Agitator_Torch_c06f471a-7500-4201-942b-39a600a5bb03,(CHARACTER)S_LOW_VoloFate_Agitator_e896b270-21cd-4d5c-8b99-be87929f77f0)
		AND
		DB_LOW_VoloFate_AgitatorSetsTrailOnFire(1)
		AND
		GetPosition((TRIGGER)S_LOW_VoloFate_AlcoholSurface_PointTrigger_01_3ded610e-7af2-4f57-bf57-13cba85d9aec,_X,_Y,_Z)
		THEN
		NOT DB_LOW_VoloFate_AgitatorSetsTrailOnFire(1);
		ApplyStatus(S_LOW_VoloFate_Agitator_Torch_c06f471a-7500-4201-942b-39a600a5bb03,"BURNING",-1.0);
		DropTo((ITEM)S_LOW_VoloFate_Agitator_Torch_c06f471a-7500-4201-942b-39a600a5bb03,_X,_Y,_Z);
		
		PROC
		PROC_LOW_VoloFate_ExecutionSceneOver()
		AND
		NOT DB_GlobalFlag((FLAG)LOW_VoloFate_State_AgitatorThrewTorchAtBarrel_077b8b06-9d86-4eb4-b6cf-cd0b189b29ee)
		AND
		DB_LOW_VoloFate_Onlookers(_Onlooker)
		THEN
		//TODO: Make it part of their anubis behavior to make sure that they don't run into dangerous surfaces
		PROC_DisappearOutOfSightTo(_Onlooker,S_LOW_WaterQueensHouse_ChattyWaveservantDefaultPos_c0ea69cc-f846-4e8a-a6f0-0e9b12d8bf7f,"Run",0,"");
		//END_REGION
		
		//REGION Volo's Execution Cart
		IF
		EntityEvent(_,"LOW_VoloFate_VoloInitTeleported")
		THEN
		Use(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,(ITEM)S_LOW_VoloFate_Chair_fd4d80b5-be07-8a3c-485f-a8d2f32b96d3,"");
		SetTag(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,(TAG)AI_IGNORED_TARGET_ff6d7d1f-094f-432e-a117-fdc3a0ab7ac1);
		SetTag(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,(TAG)IGNORE_DANGEROUS_SURFACES_bbf62461-4af4-4631-807a-eb0bd988d9a6);
		SetCombatGroupID(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "e45c45e9-ba0f-29ca-c1d6-8bd5f2a58198");
		TemplateAddTo((ITEMROOT)BOOK_LOW_VolosFate_VoloDocksRendevouz_ff8decd6-f058-49c0-b70e-41058fa58102,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,1);
		TriggerRegisterForCharacter((TRIGGER)S_LOW_VoloFate_OnCart_Trigger_e59418a9-e7de-46db-89eb-dff597ef9171,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		PROC_SetCustomTradeTreasure(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"DEN_Volo_Trade");
		PROC_RemoveNPCADs(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		PROC_RemoveAllDialogEntriesForSpeaker(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		PROC_SceneOver("GOB_VoloScene");
		DB_LOW_VoloFate_Characters(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		DB_Dialogs(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,(DIALOGRESOURCE)LOW_VoloFate_Saved_ef5c2c41-6b6c-b6e1-3b41-499289d37f71);
		DB_NoLowAttitudeDialog(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		
		IF
		UseStarted(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, S_LOW_VoloFate_Chair_fd4d80b5-be07-8a3c-485f-a8d2f32b96d3)
		AND
		NOT DB_LOW_VolosTiedToChairStatusRemoved(1)
		AND
		NOT DB_Defeated(S_LOW_VoloFate_Chair_fd4d80b5-be07-8a3c-485f-a8d2f32b96d3)
		THEN
		ApplyStatus(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "TIED_TO_CHAIR", -1.0, 1, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		StatusApplied(S_LOW_VoloFate_ExecutionCart_f1ceb8d9-0122-8051-4345-e45bb5fa7664,"BURNING",_,_)
		AND
		GetSurfaceGroundAt(S_LOW_VoloFate_ExecutionCart_f1ceb8d9-0122-8051-4345-e45bb5fa7664,"SurfaceFire")
		AND
		QRY_OnlyOnce("LOW_VoloFate_ProlongCartFireSurface_OnlyOnce")
		THEN
		// Ensures that the fire surface lasts long enough to destroy the carriage
		TransformSurface(S_LOW_VoloFate_ExecutionCart_f1ceb8d9-0122-8051-4345-e45bb5fa7664, "Ignite", "Ground", 10.0, 30.0, NULL_00000000-0000-0000-0000-000000000000);
		SetFlag((FLAG)LOW_VoloFate_State_CartOnFire_ed9159f7-e71b-4698-8e5e-05bc2d6c5173);
		
		// Accounts for the chair destroyed
		IF
		ReposeRemoved(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,_)
		AND
		HasActiveStatus(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "TIED_TO_CHAIR", 1)
		THEN
		RemoveStatus(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "TIED_TO_CHAIR");
		
		IF
		LeftTrigger((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,(TRIGGER)S_LOW_VoloFate_OnCart_Trigger_e59418a9-e7de-46db-89eb-dff597ef9171)
		THEN
		TriggerUnregisterForCharacter((TRIGGER)S_LOW_VoloFate_OnCart_Trigger_e59418a9-e7de-46db-89eb-dff597ef9171,(CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		ClearTag(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,(TAG)IGNORE_DANGEROUS_SURFACES_bbf62461-4af4-4631-807a-eb0bd988d9a6);
		
		QRY
		QRY_CorpseLooting_BlockMakeOwned((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_CorpseLooting_BlockMakeOwned(_Character)
		AND
		DB_LOW_VoloFate_Thugs(_Character)
		THEN
		DB_NOOP(1);
		//END_REGION
		
		//REGION Volo's tied ADs. Handled here instead of anubis because Volo's constrained
		IF
		TurnStarted(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa)
		AND
		HasActiveStatus(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"TIED_TO_CHAIR",1)
		AND
		GetSurfaceGroundAt(S_LOW_VoloFate_ExecutionCart_f1ceb8d9-0122-8051-4345-e45bb5fa7664,"SurfaceFire")
		THEN
		// The AD refers to Volo about to get burnt
		PROC_TryStartAD((DIALOGRESOURCE)LOW_VoloFate_AD_CryHelpEachTurn_241ca02b-5780-49ae-2405-50484bffd868,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		
		IF
		TurnStarted(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa)
		AND
		HasActiveStatus(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"TIED_TO_CHAIR",1)
		AND
		NOT GetSurfaceGroundAt(S_LOW_VoloFate_ExecutionCart_f1ceb8d9-0122-8051-4345-e45bb5fa7664,"SurfaceFire")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)LOW_VoloFate_AD_BusyInCart_50500cab-db5d-52e3-0af2-ddfbc25a6289,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		//END_REGION
		
		//REGION Volo Saved
		QRY
		QRY_SelectCustomDialog(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,_Player)
		AND
		DB_GlobalFlag((FLAG)LOW_VoloFate_State_ExecutionSceneDone_ef057af1-d080-4c75-b454-15f71f1f669a)
		AND
		HasActiveStatus(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"TIED_TO_CHAIR",1)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)LOW_VoloFate_AD_BusyInCart_50500cab-db5d-52e3-0af2-ddfbc25a6289,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		
		IF
		StatusRemoved(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"TIED_TO_CHAIR",_,_)
		AND
		NOT DB_PermaDefeated(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa)
		THEN
		DB_LOW_VolosTiedToChairStatusRemoved(1);
		SetCombatGroupID(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "");
		SetEntityEvent(S_LOW_VoloFate_Chair_fd4d80b5-be07-8a3c-485f-a8d2f32b96d3,"LOW_VoloFate_VoloFreed");
		EndRepose(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		
		IF
		StatusApplied(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"TIED_TO_CHAIR",_,_)
		THEN
		DB_LOW_VolosTiedToChairStatusApplied(1);
		
		PROC
		PROC_BlockUseOfItem(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,(ITEM)S_LOW_VoloFate_Chair_fd4d80b5-be07-8a3c-485f-a8d2f32b96d3)
		AND
		DB_LOW_VolosTiedToChairStatusApplied(1)
		THEN
		DB_CustomUseItemResponse(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,S_LOW_VoloFate_Chair_fd4d80b5-be07-8a3c-485f-a8d2f32b96d3,0);
		PurgeOsirisQueue(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		
		IF
		DialogEnded((DIALOGRESOURCE)LOW_VoloFate_Saved_ef5c2c41-6b6c-b6e1-3b41-499289d37f71,_)
		THEN
		PROC_DisappearOutOfSight((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"Run",0,"LOW_VoloFate_VoloToCamp");
		
		IF
		EntityEvent(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"LOW_VoloFate_VoloToCamp")
		THEN
		QuestUpdate("HIDDEN_CTY_Boosters","LOW_VoloFate_SavedVolo");
		ToInventory(S_LOW_VoloFate_SlayerGuidebook_14631f45-3a21-436a-97b0-211a3acaccc0,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		SetFlag((FLAG)GLO_Volo_State_AtCamp_de1cadca-2eca-4cee-a3dc-e262bbb92277);
		PROC_ORI_SetupCamp((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, 1);
		PROC_RemoveAllDialogEntriesForSpeaker(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		PROC_SpotPlayers_StopSpotting("LOW_VoloFate_SavedSpotting");
		DB_Dialogs(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,(DIALOGRESOURCE)CAMP_Volo_f754e023-af3e-9ee6-d345-f7f88e7be0c8);
		PROC_SetAnubisConfig(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "GLO_Volo");
		//END_REGION
		
		//REGION Fast-forwarding the execution in case of Stealwatch Foundry explosion
		IF
		FlagSet(_Flag,_,_)
		AND
		DB_LOW_VoloFate_FoundryDestroyedFlags(_Flag)
		AND
		QRY_OnlyOnce("LOW_VoloFateResolved_OnlyOnce")
		THEN
		PROC_LOW_VoloFateResolved();
		
		PROC
		PROC_LOW_VoloFateResolved()
		THEN
		PROC_SceneOver("LOW_VoloFate_ExecutionScene");
		
		PROC
		PROC_LOW_VoloFateResolved()
		AND
		DB_LOW_VoloFate_Thugs(_Thug)
		AND
		NOT DB_Is_InCombat(_Thug,_)
		THEN
		PROC_DisappearOutOfSight(_Thug,"Run",0,"");
		
		PROC
		PROC_LOW_VoloFateResolved()
		AND
		DB_LOW_VoloFate_ExecutionCart_PLT_Items(_Item)
		AND
		Exists(_Item,1)
		THEN
		ClearOwnership(_Item);
		//END_REGION
		
		//REGION Tracking combat with the thugs + Edge case handling of players leaving/not participating in the combat while Volo's in it with the thugs
		IF
		EnteredCombat(_PartyMember,_CombatID)
		AND
		DB_PartyMembers((CHARACTER)_PartyMember)
		AND
		DB_Is_InCombat(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,_CombatID)
		AND
		DB_LOW_VoloFate_Thugs(_Thug)
		AND
		DB_Is_InCombat(_Thug,_CombatID)
		AND
		NOT DB_LOW_VoloFate_ExecutionCombat(_CombatID)
		THEN
		DB_LOW_VoloFate_ExecutionCombat(_CombatID);
		
		IF
		SwitchedCombat(_,_OldCombatID,_NewCombatID)
		AND
		DB_LOW_VoloFate_ExecutionCombat(_OldCombatID)
		THEN
		NOT DB_LOW_VoloFate_ExecutionCombat(_OldCombatID);
		DB_LOW_VoloFate_ExecutionCombat(_NewCombatID);
		
		IF
		CombatEnded(_CombatID)
		AND
		DB_LOW_VoloFate_ExecutionCombat(_CombatID)
		THEN
		NOT DB_LOW_VoloFate_ExecutionCombat(_CombatID);
		ClearTag(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,(TAG)AI_IGNORED_TARGET_ff6d7d1f-094f-432e-a117-fdc3a0ab7ac1);
		
		IF
		LeftCombat(_PartyMember,_CombatID)
		AND
		DB_LOW_VoloFate_ExecutionCombat(_CombatID)
		AND
		DB_PartyMembers((CHARACTER)_PartyMember)
		AND
		NOT QRY_LOW_PartyMembersInVoloExecutionCombat(_CombatID)
		THEN
		ClearTag(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,(TAG)AI_IGNORED_TARGET_ff6d7d1f-094f-432e-a117-fdc3a0ab7ac1);
		
		QRY
		QRY_LOW_PartyMembersInVoloExecutionCombat((GUIDSTRING)_CombatID)
		AND
		DB_PartyMembers(_PartyMember)
		AND
		DB_Is_InCombat(_PartyMember,_CombatID)
		THEN
		DB_NOOP(1);
		//END_REGION
		
		//REGION Volo Camp followup; Slayer Book spell-unlocks
		// All party members (excluding followers and summons) get the passive from reading the book
		IF
		GameBookInterfaceClosed((ITEM)S_LOW_VoloFate_SlayerGuidebook_14631f45-3a21-436a-97b0-211a3acaccc0,_Player)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_VoloFate_State_PlayersReadSlayerGuidebook_f051229c-d3b1-43eb-a3b5-c0fabaa4760e)
		AND
		DB_Players(_Player)
		AND
		DB_PartyMembers(_PartyMember)
		AND
		DB_GLO_Playable(_PartyMember)
		THEN
		AddPassive(_PartyMember,"LOW_VoloFate_SlayerKnowledge");
		PROC_GlobalSetFlagAndCache((FLAG)LOW_VoloFate_State_PlayersReadSlayerGuidebook_f051229c-d3b1-43eb-a3b5-c0fabaa4760e);
		PROC_LOW_Unlock_Slayer_DeathGrowl();
		
		// Making sure that new playable chars get the passive in case they join the party afterwards
		IF
		DB_PartyMembers(_PartyMember)
		AND
		DB_GlobalFlag((FLAG)LOW_VoloFate_State_PlayersReadSlayerGuidebook_f051229c-d3b1-43eb-a3b5-c0fabaa4760e)
		AND
		DB_GLO_Playable(_PartyMember)
		THEN
		AddPassive(_PartyMember,"LOW_VoloFate_SlayerKnowledge");
		
		// Unlocks Zone_Slayer_DeathGrowl for DU in Slayer form
		PROC
		PROC_LOW_Unlock_Slayer_DeathGrowl()
		AND
		QRY_OnlyOnce("LOW_Unlock_Slayer_DeathGrowl_OnlyOnce")
		AND
		DB_PartOfTheTeam(_Character)
		AND
		IsTagged(_Character,(TAG)REALLY_DARK_URGE_cd611d7d-b67d-42b4-a75c-a0c6091ef8a2,1)
		THEN
		SetTag(_Character,(TAG)VOLO_SLAYER_f09707c1-7c58-4611-a06b-ce34dd2826c6);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)GLO_Volo_State_LeftPlayerSide_11753e16-de80-ce61-859c-8c4e6ca57bfe)
		THEN
		PROC_DisappearOutOfSight((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"Run",0,"LOW_VoloFate_VoloLeftPlayerSide");
		ClearFlag((FLAG)GLO_Volo_State_AtCamp_de1cadca-2eca-4cee-a3dc-e262bbb92277, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		EntityEvent(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"LOW_VoloFate_VoloLeftPlayerSide")
		THEN
		TeleportTo(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,S_LOW_VoloFate_VoloPosTrigger_c9a7c968-ce75-4961-8a3c-349e4f52a622,"");
		PROC_SetOnStage(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,0);
		//END_REGION
		
		//REGION Debug
		IF
		FlagSet((FLAG)Debug_LOW_VoloFate_SaveAndCamp_3f2d8e49-a9d3-43fa-a126-6cf25e8f80b1,_,_)
		THEN
		DB_GlobalFlag((FLAG)Debug_LOW_VoloFate_SaveAndCamp_3f2d8e49-a9d3-43fa-a126-6cf25e8f80b1);
		SetFlag((FLAG)LOW_VoloFate_State_VoloArrivedInBG_5faacb8c-836d-4626-bb7d-418c643e494d);
		SetFlag((FLAG)LOW_VoloFate_State_ExecutionSceneDone_ef057af1-d080-4c75-b454-15f71f1f669a);
		Die((ITEM)S_LOW_VoloFate_Chair_fd4d80b5-be07-8a3c-485f-a8d2f32b96d3);
		PROC_SceneOver("LOW_VoloFate_ExecutionScene");
		
		IF
		StatusRemoved(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"TIED_TO_CHAIR",_,_)
		AND
		DB_GlobalFlag((FLAG)Debug_LOW_VoloFate_SaveAndCamp_3f2d8e49-a9d3-43fa-a126-6cf25e8f80b1)
		THEN
		PROC_DisappearOutOfSight((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"Run",0,"LOW_VoloFate_VoloToCamp");
		
		PROC
		PROC_LOW_VoloFate_ExecutionSceneOver()
		AND
		DB_GlobalFlag((FLAG)Debug_LOW_VoloFate_SaveAndCamp_3f2d8e49-a9d3-43fa-a126-6cf25e8f80b1)
		AND
		DB_LOW_VoloFate_Characters(_Character)
		AND
		_Character != S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa
		THEN
		Die(_Character,DEATHTYPE.Physical,0);
		
		IF
		FlagSet((FLAG)LOW_SlayerGuidebook_Event_GiveItem_8688f830-5f85-4321-ba0b-6b0be69ff902,_Player,_)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		DB_OffStage(S_LOW_VoloFate_SlayerGuidebook_14631f45-3a21-436a-97b0-211a3acaccc0)
		THEN
		PROC_SetOnStage(S_LOW_VoloFate_SlayerGuidebook_14631f45-3a21-436a-97b0-211a3acaccc0,1);
		
		IF
		FlagCleared((FLAG)LOW_VoloFate_State_VoloArrivedInBG_5faacb8c-836d-4626-bb7d-418c643e494d,_,_)
		THEN
		PROC_LOW_RemoveVoloAlcoholTrail();
		
		PROC
		PROC_LOW_RemoveVoloAlcoholTrail()
		AND
		DB_LOW_VoloFate_AlcoholSurfaceTriggers(_Trigger)
		THEN
		RemoveSurfaceLayer(_Trigger,"Ground",2.0);
		
		PROC
		PROC_LOW_RemoveVoloAlcoholTrail()
		THEN
		RemoveSurfaceLayer(S_LOW_VoloFate_AlcoholBarrel_08_28631414-14c6-4e2c-a6de-0d485d458f89,"Ground",1.0);
		
		IF
		TextEvent("Debug_ExecutionCart_SetOnStage")
		AND
		GetTextEventParamInteger(1,_Integer)
		AND
		DB_LOW_VoloFate_ExecutionCart_PLT_Items(_Item)
		THEN
		PROC_SetOnStage(_Item,_Integer);
		
		IF
		TextEvent("LOW_VoloFate_CheckCartSurfaceDuration")
		AND
		GetSurfaceTurns(S_LOW_VoloFate_ExecutionCart_f1ceb8d9-0122-8051-4345-e45bb5fa7664,"Ground",_Num)
		AND
		IntegerToString(_Num,_NumString)
		THEN
		DebugBreak(_NumString);
		
		IF
		TextEvent("LOW_VoloFate_CheckCartSurfaceSize")
		AND
		GetSurfaceSize(S_LOW_VoloFate_ExecutionCart_f1ceb8d9-0122-8051-4345-e45bb5fa7664,"Ground",_Size)
		THEN
		DB_NOOP(1);
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(650).Title("Act3b_LOW_WaterQueensHouse");
Goal(650)
{
	INIT
	{
		DB_DeadOnceFlag(S_LOW_AllandraGrey_32d78583-07c6-4160-9ec7-3a24b15149c8, LOW_AllandraGrey_State_DiedOnce_e953dd67-ea9c-47f8-b2c2-b77e8cbdf0cf);
		
		//REGION Water Queen's House - Temple
		DB_GLO_CharacterCorpseDialog((CHARACTER)S_LOW_InjuredWaveservant_c3a7ec85-cb65-4ffe-b0a8-93789613039d, (DIALOGRESOURCE)LOW_WaterQueensHouse_HolliDylford_SpeakWithDead_efae856c-b0ae-482d-ca16-aa057689fa18);
		DB_LOW_WaterQueensHouse_FuneralWaveservants((CHARACTER)S_LOW_Waveservant01_ab993a69-39be-47f4-9330-49d3e4958e12);
		DB_LOW_WaterQueensHouse_FuneralWaveservants((CHARACTER)S_LOW_Waveservant02_f8b70d49-2ab7-4fcd-8203-aa7ae0fcd99c);
		DB_LOW_WaterQueensHouse_FuneralWaveservants((CHARACTER)S_LOW_Waveservant03_eddd4c99-74bb-45d6-902b-f866f88e3f84);
		DB_LOW_WaterQueensHouse_FuneralWaveservants((CHARACTER)S_LOW_Waveservant04_28327055-7f42-4374-a483-3fd296fa26f6);
		DB_LOW_WaterQueensHouse_FuneralWaveservants((CHARACTER)S_LOW_Waveservant05_3995ac03-7410-468a-8b04-37d03409259d);
		DB_LOW_WaterQueensHouse_FuneralWaveservants((CHARACTER)S_LOW_AllandraGrey_32d78583-07c6-4160-9ec7-3a24b15149c8);
		
		DB_Dialogs((CHARACTER)S_LOW_Waveservant01_ab993a69-39be-47f4-9330-49d3e4958e12, (DIALOGRESOURCE)LOW_WaterQueensHouse_Waveservant01_e27d8840-e903-0b67-1e59-efbc606ce420);
		DB_Dialogs((CHARACTER)S_LOW_Waveservant02_f8b70d49-2ab7-4fcd-8203-aa7ae0fcd99c, (DIALOGRESOURCE)LOW_WaterQueensHouse_Waveservant02_f5b3ccb7-c524-e346-5911-7acb1b0d042d);
		DB_Dialogs((CHARACTER)S_LOW_Waveservant03_eddd4c99-74bb-45d6-902b-f866f88e3f84, (DIALOGRESOURCE)LOW_WaterQueensHouse_Waveservant03_1400a480-5a26-d0df-cae2-79789c09b8d9);
		DB_Dialogs((CHARACTER)S_LOW_Waveservant04_28327055-7f42-4374-a483-3fd296fa26f6, (DIALOGRESOURCE)LOW_WaterQueensHouse_Waveservant04_8fd8129e-079e-80b0-9ee8-b58ef3c6fb5a);
		DB_Dialogs((CHARACTER)S_LOW_Waveservant05_3995ac03-7410-468a-8b04-37d03409259d, (DIALOGRESOURCE)LOW_WaterQueensHouse_Waveservant05_9fdcda45-2e54-ff52-766c-e0c030f7784a);
		DB_Dialogs((CHARACTER)S_LOW_AllandraGrey_32d78583-07c6-4160-9ec7-3a24b15149c8, (DIALOGRESOURCE)LOW_WaterQueensHouse_AllandraGrey_a6d65561-469f-e63f-a2a2-1c0c0ed8f43c);
