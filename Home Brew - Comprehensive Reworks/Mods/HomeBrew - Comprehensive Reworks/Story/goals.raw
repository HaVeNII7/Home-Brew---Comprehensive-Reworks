		TeleportTo(S_LOW_KerriEvenfield_b7e59d50-dad4-40b3-88f7-e05d27134356, S_LOW_KerriFinalConfrontationTrigger_ff8f0f3e-10bf-4370-8bb8-a92c19e1a163,"LOW_OskarsBeloved_KerriTeleported",0,0,0,1,0);
