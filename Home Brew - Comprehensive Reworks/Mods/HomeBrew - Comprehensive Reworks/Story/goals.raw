		PROC
		PROC_GlobalFlagReactionAfterDialog(ORI_WyllConfrontation_State_KarlachLeftHostile_7571e7ce-ed9c-4495-a8c7-1bba1fc01c74, _Dialog)
		THEN
		PROC_Origins_CompanionLeavePermanently((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "CompanionHostile");
		SetFaction(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (FACTION)Origin_Karlach_Hostile_941ee2f1-775a-4418-80db-79f354a1c173);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog(ORI_WyllConfrontation_State_WyllLeftHostile_823f4d26-f3e7-44b3-aea6-4b953c071601, _Dialog)
		AND
		DB_ORI_WyllConfrontation_CampDialogues(_Dialog)
