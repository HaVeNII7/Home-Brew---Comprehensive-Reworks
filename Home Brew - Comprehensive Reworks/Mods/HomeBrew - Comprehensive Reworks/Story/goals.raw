		FlagSet(LOW_Evacuation_HasMet_MadeDealWithSailor_76df3b6e-c3c2-f9b3-d6b6-7e1dd160725f, _, _)
		THEN
		PROC_CharacterMoveTo(S_LOW_SteepsEvacuation_Sailor_91550f0a-a04b-4cb1-b0d9-3d83dc902dae, S_LOW_SteepsEvacuation_CaptainLeavesPoint_8d4469a5-eb82-471a-b1ee-1a6969a6b99b, "Walk", "LOW_SteepsEvacuation_CaptainLeaving");
		QuestUpdate("HIDDEN_CTY_Boosters","LOW_SteepEvacuation_ConvincedCaptain");
		
		IF
		EntityEvent(S_LOW_SteepsEvacuation_Sailor_91550f0a-a04b-4cb1-b0d9-3d83dc902dae, "LOW_SteepsEvacuation_CaptainLeaving")
		THEN
		PROC_DisappearOutOfSight(S_LOW_SteepsEvacuation_Sailor_91550f0a-a04b-4cb1-b0d9-3d83dc902dae, "Walk", 0, "");
		DB_LOW_SteepsEvactuation_BusyChildren((CHARACTER)S_LOW_SteepsEvacuation_Child1_4d171372-75ff-40d1-8ea0-7c80273db8e5);
		DB_LOW_SteepsEvactuation_BusyChildren((CHARACTER)S_LOW_SteepsEvacuation_Child1_4d171372-75ff-40d1-8ea0-7c80273db8e5);
		PROC_GenericsSetBusyDialog((CHARACTER)S_LOW_SteepsEvacuation_Child1_4d171372-75ff-40d1-8ea0-7c80273db8e5);
		PROC_GenericsSetBusyDialog((CHARACTER)S_LOW_SteepsEvacuation_Child2_8f095e66-076f-48cd-b85e-6e46b358675d);
		
		
		//Offstage family after long rest after getting them on the ship 
		PROC
		PROC_LongRest()
		AND
		NOT DB_LevelUnreachable("CTY_Main_A")
		AND
		DB_GlobalFlag(LOW_Evacuation_HasMet_MadeDealWithSailor_76df3b6e-c3c2-f9b3-d6b6-7e1dd160725f)
		AND
		DB_LOW_SteepsEvacuation_Characters(_Char)
		AND
		NOT DB_OffStage(_Char)
		THEN
		DB_ExecuteWhenObjectInCurrentLevel("GLO_OffStage",_Char);
		
		//END_REGION
	}
	EXIT
	{
	}
}
