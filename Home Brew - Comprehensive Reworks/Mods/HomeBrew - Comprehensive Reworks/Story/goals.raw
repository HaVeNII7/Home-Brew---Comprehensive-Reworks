		DB_QuestDef_State((FLAG)LOW_BhaalTemple_State_WasAbductedGale_74d236e1-eff9-4b73-a6e7-4e6402d5c84c, 									"LOW_FindBhaalTemple", "StartPoint_NoTargetList_AbductionOccured_Companion");
		DB_QuestDef_State((FLAG)LOW_BhaalTemple_State_WasAbductedMinthara_d1e51161-8462-4333-8676-74b4d0384054, 								"LOW_FindBhaalTemple", "StartPoint_NoTargetList_AbductionOccured_Companion");
