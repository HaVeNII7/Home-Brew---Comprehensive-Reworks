		DB_LOW_SWS_Bonecloak_Guards((CHARACTER)S_LOW_SWS_Bonecloak_FF_001_b6d526d6-a592-4db9-bcfd-3d04d4fab7fe);
		DB_LOW_SWS_Bonecloak_Guards((CHARACTER)S_LOW_SWS_Bonecloak_FF_002_9a305cf0-f6b0-4d7b-bb44-f35f571f318a);
		
		DB_LOW_SWS_Bonecloak_CivRunPos((CHARACTER)S_LOW_SWS_Bonecloak_Civ_000_119c5cd7-e968-4668-b97d-aab953041139,(TRIGGER)S_LOW_SWS_Bonecloak_Pos_Civ_Run_000_1acf0f6d-99f5-49c8-b8b6-a1c5e93b3979);
		DB_LOW_SWS_Bonecloak_CivRunPos((CHARACTER)S_LOW_SWS_Bonecloak_Civ_001_137e9a88-bfdd-4e35-ac80-f8777bd45a36,(TRIGGER)S_LOW_SWS_Bonecloak_Pos_Civ_Run_001_c56b13be-7051-4df8-878b-ec84eab6c79e);
		
		DB_LOW_SWS_Bonecloak_Civ_Pos((CHARACTER)S_LOW_SWS_Bonecloak_Civ_002_16a71001-aad5-4cd5-bfc8-c7f37a4afe79,(TRIGGER)S_LOW_SWS_Bonecloak_Pos_Civ_002_93e86fe5-def0-46ad-97a3-7c64e4fc6624);
		DB_LOW_SWS_Bonecloak_Civ_Pos((CHARACTER)S_LOW_SWS_Bonecloak_Civ_003_e18d081d-7acc-4f6f-bb31-2154ee5f3a3c,(TRIGGER)S_LOW_SWS_Bonecloak_Pos_Civ_003_4f1f0feb-7942-41e0-8be2-1c8539a960dc);
	}
	KB
	{
		IF
		DB_LOW_SWS_Bonecloak_Civ_Pos(_Civilian,_Pos)
		THEN
		SetOnStage(_Civilian,0);
		
		IF
		DB_LOW_SWS_Bonecloak_Guards(_Guard)
		THEN
		PROC_CharacterDisableCrime(_Guard,"DangerousMonsterReaction");
		PROC_CharacterDisableCrime(_Guard,"DangerousMonsterReactionFallback");
		
		
		
		QRY
		QRY_SelectCustomDialog_AfterGenerics(_Civilian,_Player)
		AND
		DB_LOW_SWS_Bonecloak_CivRunPos((CHARACTER)_Civilian,_)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		DB_LOW_SWS_Bonecloak_Guards(_Guard)
		AND
		NOT DB_LOW_SWS_Bonecloak_Guard_Chosen(_)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(_Guard,_Player)
		AND
		DB_Dialogs(_Guard,_Dialog)
		THEN
		DB_LOW_SWS_Bonecloak_Guard_Chosen(_Guard);
		DB_SelectedDialog(_Dialog,_Guard,_Player);
		
		QRY
		QRY_SelectCustomDialog_AfterGenerics(S_LOW_SWS_BasiliskGate_Criminal_c21a2d99-f10d-4211-8d6a-d04851bb177c,_Player)
		AND
		DB_LOW_SWS_Bonecloak_Guard_Chosen(_Guard)
		THEN
		NOT DB_LOW_SWS_Bonecloak_Guard_Chosen(_Guard);
		
		
		
		PROC
		PROC_LOW_SWS_Disabled()
		AND
		DB_LOW_SWS_Bonecloak_CivRunPos(_Civilian,_Pos)
		THEN
		PROC_DisappearOutOfSightTo(_Civilian,_Pos,"Run",1,"LOW_SWS_Bonecloack_Disappeared");
		
		IF
		EntityEvent(_Civilian,"LOW_SWS_Bonecloack_Disappeared")
		AND
		DB_LOW_SWS_Bonecloak_CivRunPos((CHARACTER)_Civilian,S_LOW_SWS_Bonecloak_Pos_Civ_Run_000_1acf0f6d-99f5-49c8-b8b6-a1c5e93b3979)
		THEN
		PROC_DisappearOutOfSightTo(S_LOW_SWS_Bonecloak_FF_000_1c25d7db-a379-4adc-9e06-3139e78356c1,S_LOW_SWS_Bonecloak_Pos_Civ_Run_000_1acf0f6d-99f5-49c8-b8b6-a1c5e93b3979,"Run",1,"");
		
		IF
		EntityEvent(_Civilian,"LOW_SWS_Bonecloack_Disappeared")
		AND
		DB_LOW_SWS_Bonecloak_CivRunPos((CHARACTER)_Civilian,S_LOW_SWS_Bonecloak_Pos_Civ_Run_001_c56b13be-7051-4df8-878b-ec84eab6c79e)
		THEN
		PROC_DisappearOutOfSightTo(S_LOW_SWS_Bonecloak_FF_001_b6d526d6-a592-4db9-bcfd-3d04d4fab7fe,S_LOW_SWS_Bonecloak_Pos_Civ_Run_001_c56b13be-7051-4df8-878b-ec84eab6c79e,"Run",1,"");
		PROC_DisappearOutOfSightTo(S_LOW_SWS_Bonecloak_FF_002_9a305cf0-f6b0-4d7b-bb44-f35f571f318a,S_LOW_SWS_Bonecloak_Pos_Civ_Run_001_c56b13be-7051-4df8-878b-ec84eab6c79e,"Run",1,"");
		
		
		PROC
		PROC_LOW_SWS_Transition()
		AND
		IsInTrigger(S_LOW_SWS_Bonecloak_SW_b421af30-3673-4c75-b92d-859cd212cad6,S_LOW_SWS_Bonecloak_Zone_SW_ac589a73-9d07-4cd3-b0e3-65c406d593c5,1)
		AND
		DB_LOW_SWS_Bonecloak_Civ_Pos(_Civilian,_Pos)
		THEN
		PROC_AppearOutOfSightTo(_Civilian,_Pos,_Civilian,"");
		
		
		//REGION Combat
		
		IF
		EnteredCombat(_Guard,_)
		AND
		DB_LOW_SWS_Bonecloak_Guards((CHARACTER)_Guard)
		THEN
		PROC_LOW_SWS_Bonecloak_DisperseCivs();
		
		PROC
		PROC_LOW_SWS_Bonecloak_DisperseCivs()
		AND
		DB_LOW_SWS_Bonecloak_CivRunPos(_Civ,_Pos)
		AND
		IsOnStage(_Civ,1)
		THEN
		PROC_DisappearOutOfSightTo(_Civ,_Pos,"Run",1,"");
		
		PROC
		PROC_LOW_SWS_Bonecloak_DisperseCivs()
		AND
		DB_LOW_SWS_Bonecloak_Civ_Pos(_Civ,_Pos)
		AND
		IsOnStage(_Civ,1)
		THEN
		PROC_DisappearOutOfSight(_Civ,"Run",1,"");
		
		//END_REGION Combat
	}
	EXIT
	{
	}
}
