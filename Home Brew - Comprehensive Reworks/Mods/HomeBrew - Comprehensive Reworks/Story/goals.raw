		DB_CMB_LevelUpNpcInRegion((CHARACTER)S_GLO_Nightsong_6c55edb0-901b-4ba4-b9e8-3475a8392d9b, "END_Main", 11,"LOW_NIGHTSONG_LEVEL_11");
