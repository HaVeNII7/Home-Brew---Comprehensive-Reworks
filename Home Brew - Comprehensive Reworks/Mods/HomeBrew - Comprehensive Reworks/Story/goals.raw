		AND
		DB_UND_DeadInTheWater_CorpseDisposers(_Disposer,_)
		AND
		DB_UND_FearfulRothe_Guards(_RotheGuard)
		THEN
		Die(_ExcavationDuergar,DEATHTYPE.DoT,1);
		Die(_CityDuergar,DEATHTYPE.DoT,1);
		Die(_Disposer,DEATHTYPE.DoT,1);
		Die(_RotheGuard,DEATHTYPE.DoT,1);
		
		//END_REGION
		
		//REGION Entering
		IF
		DB_InRegion(_Player, S_UND_DuergarCamp_SUB_05c3bf1f-29a6-437c-9a98-c1ff0ec53a53)
		AND
		DB_Players(_Player)
		AND
		NOT DB_GlobalFlag(GLO_DuergarCamp_EverEnteredBefore_ac0bae57-7006-4676-88b8-7498dde79c41)
		THEN
		PROC_GlobalSetFlagAndCache(GLO_DuergarCamp_EverEnteredBefore_ac0bae57-7006-4676-88b8-7498dde79c41);
		
		//END_REGION
		
		//REGION Guards
		IF
		DB_UND_DuergarGuards_City(_Duergar,_)
		THEN
		DB_GLO_DefeatCounter(_Duergar,"UND_PermaDefeatedDuergarCityGuards");
		
		IF
		DB_GlobalFlag((FLAG)UND_DuergarGuards_City_State_PermaDefeated_4624085c-cc07-4671-af4f-c8983b66ad17)
		AND
		DB_GlobalFlag((FLAG)UND_DuergarGuards_Excavation_State_PermaDefeated_3f30c825-10f1-4fa5-84b8-073f293e6650)
		AND
		DB_GlobalFlag((FLAG)UND_FearfulRothe_State_GuardsArePermaDefeated_60c74db1-dd75-96b6-5c9e-fa1d9a83bf58)
		AND
		DB_GlobalFlag((FLAG)UND_DeadInTheWater_State_DuergarsPermaDefeated_d3b422e2-134d-44db-8dbd-77cdfa67191b)
		THEN
		SetFlag((FLAG)UND_DuergarGuards_State_PermaDefeated_b2211d1b-3dea-9b74-b19c-71938ac4b218, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		
		//END_REGION
		
		//REGION Rails
		IF
		EnteredTrigger(_Player,S_UND_DuergarCamp_NoticedPlayersOnRails_3f7fdfa3-2d31-4598-bcb5-e06d7824f557)
		AND
		NOT DB_HiddenCharacters(_Player,_)
		AND
		QRY_OnlyOnce("UND_DuergarCamp_NoticedPlayersOnRails")
		AND
		NOT DB_OffStage(S_UND_DuergarRebelGuard_03_baac0ae3-7b2e-47e6-85e4-579f70d4b4fa)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)UND_DuergarRebelFrantic_AD_PlayersOnRails_9f7df45b-7226-5bbb-fa7e-412c346949df,(CHARACTER)S_UND_DuergarRebelGuard_03_baac0ae3-7b2e-47e6-85e4-579f70d4b4fa);
		TriggerUnregisterForPlayers(S_UND_DuergarCamp_NoticedPlayersOnRails_3f7fdfa3-2d31-4598-bcb5-e06d7824f557);
		
		//END_REGION
		
		//REGION Stone Masons VB
		IF
		DialogEnded(UND_DuergarRebelMason_01_9d3d6ad2-856d-f1b2-1faa-f6fc663f8eef,_ID)
		AND
		DB_GlobalFlag((FLAG)UND_DuergarRebelMason_State_LearnedHistory_a615b1b0-3e61-3f5e-5593-c8dbb6b12390)
		AND
		DB_DialogPlayers(_ID,_Player,_)
		AND
		QRY_OnlyOnce("UND_AncientCity_VB")
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)UND_AncientCity_VB_b433ae94-4a8e-e89b-c25f-539e93aa4d34, (CHARACTER)_Player);
		//END_REGION
		
		//REGION Defaced Statue
		IF
		UseStarted(_Player, S_UND_DefacedStatue_Statue_0308bca9-4008-4049-aa57-9097a1623270)
		AND
		DB_Players(_Player)
		AND
		QRY_OnlyOnce("UND_DefacedStatue_SawStatue")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)UND_DefacedStatue_PAD_0a040ffd-a85c-a747-b75c-033fa7dc9506,_Player);
		//END_REGION
		
		//REGION Thulla Hint
		IF
		UseStarted(_Player,_Item)
		AND
		DB_UND_ThullaHint_Hints(_Item)
		AND
		DB_Players(_Player)
		AND
		DB_OnlyOnce("UND_ThullaHint_AttemptedSurvivalCheck")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)UND_ThullaHint_SurvivalCheck_PAD_8c96d9db-f22d-3a68-bcb5-8fe8be03f26e, _Player);
		
		IF
		UseStarted(_Player,_Item)
		AND
		DB_UND_ThullaHint_Hints(_Item)
		AND
		DB_Players(_Player)
		AND
		QRY_OnlyOnce("UND_ThullaHint_AttemptedSurvivalCheck")
		THEN
		PROC_KnowledgeCheck(_Player, "UND_ThullaHint_SurvivalCheckOnHint", _Item, "Survival", (DIFFICULTYCLASS)DC_Legacy_10_625be976-7a67-4394-97c8-14c69715ae4b, (DIALOGRESOURCE)UND_ThullaHint_SurvivalCheck_PAD_8c96d9db-f22d-3a68-bcb5-8fe8be03f26e, (FLAG)UND_ThullaHint_State_SurvivalCheckSuccess_cd8d838f-e151-4544-b8ba-d7b355e05291);
		//END_REGION
		
		//REGION Hanged drows
		
		IF
		AddedTo(S_UND_DuergarCamp_HarperPin_4f3aed89-617b-487f-823a-a580606957e1,(CHARACTER)_Player, _)
		AND
		DB_Players(_Player)
		AND
		DB_GlobalFlag((FLAG)CRA_HarperBooster_State_ReadDocs_716e547e-ab9f-438f-8b18-61776310cdf9)
		AND
		QRY_OnlyOnce("UND_DuergarCamp_GotHarperPin")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)UND_DuergarCamp_PAD_HarperPin_c07e1414-5dff-ed66-5b1a-2a5d7edad471,_Player);
		
		IF
		AddedTo(S_UND_DuergarCamp_HarperPin_4f3aed89-617b-487f-823a-a580606957e1,(CHARACTER)_Player, _)
		AND
		DB_Players(_Player)
		AND
		NOT DB_GlobalFlag((FLAG)CRA_HarperBooster_State_ReadDocs_716e547e-ab9f-438f-8b18-61776310cdf9)
		AND
		DB_Players(_Roller)
		AND
		NOT DB_UND_DuergarCamp_HarperPin_HistoryCheck_InProgress(_Roller)
		AND
		NOT DB_UND_DuergarCamp_HarperPin_TriedHistoryCheck(_Roller)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(_Roller,_Player)
		THEN
		DB_UND_DuergarCamp_HarperPin_HistoryCheck_InProgress(_Roller);
		PROC_TrySkillCheck(_Roller,S_UND_DuergarCamp_HarperPin_4f3aed89-617b-487f-823a-a580606957e1,"History",(DIFFICULTYCLASS)DC_Legacy_10_625be976-7a67-4394-97c8-14c69715ae4b,"UND_DuergarCamp_HarperPin_HistoryCheck");
		
		PROC
		PROC_RollResult("UND_DuergarCamp_HarperPin_HistoryCheck",_Player,S_UND_DuergarCamp_HarperPin_4f3aed89-617b-487f-823a-a580606957e1,_Result)
		AND
		_Result != 2
		AND
		DB_UND_DuergarCamp_HarperPin_HistoryCheck_InProgress(_Player)
		THEN
		DB_UND_DuergarCamp_HarperPin_TriedHistoryCheck(_Player);
		
		PROC
		PROC_RollResult("UND_DuergarCamp_HarperPin_HistoryCheck",_Player,S_UND_DuergarCamp_HarperPin_4f3aed89-617b-487f-823a-a580606957e1,_)
		AND
		DB_UND_DuergarCamp_HarperPin_HistoryCheck_InProgress(_Player)
		THEN
		NOT DB_UND_DuergarCamp_HarperPin_HistoryCheck_InProgress(_Player);
		
		PROC
		PROC_RollResult("UND_DuergarCamp_HarperPin_HistoryCheck",_Player,S_UND_DuergarCamp_HarperPin_4f3aed89-617b-487f-823a-a580606957e1,1)
		AND
		QRY_OnlyOnce("UND_DuergarCamp_HarperPin_History")
		THEN
		SetFlag(UND_DuergarCamp_HarperPin_HistoryPassed_f4a3fc9b-e00d-7b76-6518-0b5270f6c9d3,_Player,0);
		PROC_TryStartAD((DIALOGRESOURCE)UND_DuergarCamp_PAD_HarperPin_c07e1414-5dff-ed66-5b1a-2a5d7edad471,_Player);
		
		PROC
		PROC_RollResult("UND_DuergarCamp_HarperPin_HistoryCheck",_Player,S_UND_DuergarCamp_HarperPin_4f3aed89-617b-487f-823a-a580606957e1,0)
		AND
		QRY_OnlyOnce("UND_DuergarCamp_HarperPin_History")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)UND_DuergarCamp_PAD_HarperPin_c07e1414-5dff-ed66-5b1a-2a5d7edad471,_Player);
		//END_REGION
		
		
		//REGION Nightfall Banquet
		QRY
		QRY_GLO_SkillCheck_CheckAdvantage(_Player, (TRIGGER)S_UND_NightFall_DialogTriggers_f10d731f-2dda-4343-af0e-8abd319cb224, _)
		AND
		IsTagged(_Player, SHAR_486e4a27-e6f9-40a5-9dd1-108a1d0f60eb, 1)
		THEN
		DB_QRYRTN_GLO_Skillcheck_CheckAdvantage(2);
		//END_REGION
		
		//REGION Hidden Stash
		IF
		DB_GlobalFlag((FLAG)UND_HiddenStash_PerceptionPassed_14bf0301-5c86-4cdc-9de5-7ccf1f152453)
		THEN
		SetCanInteract(S_UND_HiddenStash_LooseStone_121a4fd7-d1f0-4e11-b250-71f4ea1e6679, 1);
		TimerLaunch("UND_HiddenStash_StoneMovable", 3000);
		
		IF
		TimerFinished("UND_HiddenStash_StoneMovable")
		THEN
		PROC_LoopEffect(EFFECTRESOURCEGUID_VFX_Script_Perception_Default_01_46bd169e-bbb5-a6fe-0fe7-97c64f620d5d, S_UND_HiddenStash_LooseStone_121a4fd7-d1f0-4e11-b250-71f4ea1e6679, "UND_Hiddenstash_StoneFlashing", "WLD_Main_A", "");
		
		IF
		Moved(S_UND_HiddenStash_LooseStone_121a4fd7-d1f0-4e11-b250-71f4ea1e6679)
		AND
		QRY_OnlyOnce("UND_HiddenStash_StoneMoved")
		THEN
		SetCanInteract(S_UND_HiddenStash_Bag_fec2dad1-307e-4923-ba03-bef084116767, 1);
		PROC_StopLoopEffect(S_UND_HiddenStash_LooseStone_121a4fd7-d1f0-4e11-b250-71f4ea1e6679, "UND_Hiddenstash_StoneFlashing");
		TimerCancel("UND_HiddenStash_StoneMovable");
		TimerLaunch("UND_HiddenStash_Revealed", 1500);
		
		IF
		TimerFinished("UND_HiddenStash_Revealed")
		THEN
		PROC_LoopEffect(EFFECTRESOURCEGUID_VFX_Script_Perception_Default_01_46bd169e-bbb5-a6fe-0fe7-97c64f620d5d, S_UND_HiddenStash_Bag_fec2dad1-307e-4923-ba03-bef084116767, "UND_Hiddenstash_BagFlashing", "WLD_Main_A", "");
		
		IF
		UseStarted(_Player, S_UND_HiddenStash_Bag_fec2dad1-307e-4923-ba03-bef084116767)
		AND
		DB_Players(_Player)
		AND
		QRY_OnlyOnce("UND_Stopped_HiddenStashHighlight")
		THEN
		PROC_StopLoopEffect(S_UND_HiddenStash_Bag_fec2dad1-307e-4923-ba03-bef084116767, "UND_Hiddenstash_BagFlashing");
		TimerCancel("UND_HiddenStash_Revealed");
		
		IF
		Moved(S_UND_HiddenStash_Bag_fec2dad1-307e-4923-ba03-bef084116767)
		AND
		QRY_OnlyOnce("UND_Stopped_HiddenStashHighlight")
		THEN
		PROC_StopLoopEffect(S_UND_HiddenStash_Bag_fec2dad1-307e-4923-ba03-bef084116767, "UND_Hiddenstash_BagFlashing");
		TimerCancel("UND_HiddenStash_Revealed");
		
		IF
		AddedTo(S_UND_HiddenStash_Bag_fec2dad1-307e-4923-ba03-bef084116767, _, _)
		AND
		QRY_OnlyOnce("UND_Stopped_HiddenStashHighlight")
		THEN
		PROC_StopLoopEffect(S_UND_HiddenStash_Bag_fec2dad1-307e-4923-ba03-bef084116767, "UND_Hiddenstash_BagFlashing");
		TimerCancel("UND_HiddenStash_Revealed");
		//END_REGION
		
		//REGION Sharran Target Practice
		IF
		AddedTo(S_UND_SharranTargetPractice_Crossbow_7189447e-3897-48ec-b1e8-4c443192b52d, _Player, _)
		AND
		DB_Players((CHARACTER)_Player)
		THEN
		PROC_KnowledgeCheck(_Player, "UND_SharranTargetPracticeCrossbowPickup", (ITEM)S_UND_SharranTargetPractice_Crossbow_7189447e-3897-48ec-b1e8-4c443192b52d, "History", (DIFFICULTYCLASS)DC_Legacy_10_625be976-7a67-4394-97c8-14c69715ae4b, (DIALOGRESOURCE)UND_SharranTargetPractice_PAD_3615d820-9f27-8dca-8859-d3f71ec00a88, (FLAG)UND_SharranTargetPractice_HistoryCheckPassed_18ff2df8-e5b9-400a-be85-3f17580d144c);
		
		QRY
		QRY_GLO_SkillCheck_CheckAdvantage(_Player, (ITEM)S_UND_SharranTargetPractice_Crossbow_7189447e-3897-48ec-b1e8-4c443192b52d, _)
		AND
		IsTagged(_Player, SHAR_486e4a27-e6f9-40a5-9dd1-108a1d0f60eb, 1)
		THEN
		DB_QRYRTN_GLO_Skillcheck_CheckAdvantage(2);
		
		IF
		DB_GlobalFlag((FLAG)UND_SharranTargetPractice_HistoryCheckPassed_18ff2df8-e5b9-400a-be85-3f17580d144c)
		AND
		QRY_OnlyOnce("UND_SharranTargetPractice_CrossbowNameChanged")
		THEN
		SetStoryDisplayName(S_UND_SharranTargetPractice_Crossbow_7189447e-3897-48ec-b1e8-4c443192b52d,"UND_DuergarCamp_CrossbowRealName");
		//END_REGION
		
		//REGION Orb Of Darkvision
		IF
		UseStarted(_Player, S_UND_OrbOfDarkvision_TheOrb_55b586df-bd6a-40d3-b824-d214ac550ba0)
		AND
		DB_Players(_Player)
		THEN
		ApplyStatus(_Player,"DARKVISION", 60.0, 1, S_UND_OrbOfDarkvision_TheOrb_55b586df-bd6a-40d3-b824-d214ac550ba0);
		
		IF
		UseStarted(_Player, S_UND_OrbOfDarkvision_TheOrb_55b586df-bd6a-40d3-b824-d214ac550ba0)
		AND
		DB_Players(_Player)
		AND
		QRY_OnlyOnce("UND_OrbOfDarkvision_TriggeredAD")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)UND_OrbOfDarkvision_PAD_InteractingWithOrb_25b9647b-9899-c863-376b-1c1ff5926b03, _Player);
		//END_REGION
		
		//REGION Dark Justiciar Weapon Rack
		IF
		UseStarted(_Player, _Item)
		AND
		DB_Players(_Player)
		AND
		DB_UND_JusticiarWeaponRack_Objects(_Item)
		AND
		QRY_OnlyOnce("UND_DarkJusticiarWeaponRack_Examined")
		THEN
		PROC_KnowledgeCheck(_Player, "UND_DarkJusticiarWeapons_ReligionCheck", _Item, "Religion", (DIFFICULTYCLASS)DC_Legacy_10_625be976-7a67-4394-97c8-14c69715ae4b, (DIALOGRESOURCE)UND_JusticiarEquipment_PAD_a65faa80-2d1f-6a7c-690a-e159e8ab7209, (FLAG)UND_JusticiarWeaponRack_ReligionCheckSuccess_4efec57c-ce1a-4173-ae10-356784d2744f);
		
		QRY
		QRY_GLO_SkillCheck_CheckAdvantage(_Player, _Item, _)
		AND
		DB_UND_JusticiarWeaponRack_Objects((ITEM)_Item)
		AND
		IsTagged(_Player, SHAR_486e4a27-e6f9-40a5-9dd1-108a1d0f60eb, 1)
		THEN
		DB_QRYRTN_GLO_Skillcheck_CheckAdvantage(2);
		//END_REGION
		
		//REGION Dark Justiciar RD
		IF
		CharacterLootedCharacter(_Player,_DarkJusticiar)
		AND
		DB_UND_DarkJusticiarCorpse(_DarkJusticiar)
		AND
		NOT DB_UND_DarkJusticiarLootedCorpse(_DarkJusticiar)
		THEN
		PROC_IncreaseCounter("UND_DarkJusticiarCorpse_LootedCounter");
		DB_UND_DarkJusticiarLootedCorpse(_DarkJusticiar);
		
		IF
		CharacterLootedCharacter(_Player,_DarkJusticiar)
		AND
		DB_UND_DarkJusticiarCorpse(_DarkJusticiar)
		AND
		DB_GlobalCounter("UND_DarkJusticiarCorpse_LootedCounter", 2)
		AND
		DB_Players(_OtherPlayer)
		AND
		_OtherPlayer != _Player
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(_OtherPlayer,_Player)
		AND
		QRY_OnlyOnce("UND_DarkJusticiar_PlayInteractiveVB")
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)UND_DarkJusticiarCorpse_Looted_8cf0f15d-f13b-6071-0774-f630e0ede684,_Player)
		THEN
		DB_NOOP(1);
		
		IF
		CharacterLootedCharacter(_Player,_DarkJusticiar)
		AND
		DB_UND_DarkJusticiarCorpse(_DarkJusticiar)
		AND
		DB_GlobalCounter("UND_DarkJusticiarCorpse_LootedCounter", 2)
		AND
		QRY_OnlyOnce("UND_DarkJusticiar_PlayInteractiveVB")
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)UND_DarkJusticiarCorpse_Looted_Solo_7c665336-cefb-d32f-f0b8-3e89dda70d07,_Player)
		THEN
		DB_NOOP(1);
		
		IF
		DialogEnded((DIALOGRESOURCE)_DarkJusticiarDialog,_ID)
		AND
		DB_UND_DarkJusticiarDialogs(_DarkJusticiarDialog)
		AND
		DB_DialogPlayers(_ID, _Player, _)
		AND
		DB_GlobalFlag((FLAG)GLO_Halsin_Knows_DarkJusticiars_b63deb41-4b72-7c74-3e00-b60e4acf5d42)
		AND
		DB_GlobalFlag((FLAG)UND_DarkJusticiarsCorpses_Recognized_6926ad12-4a89-35c9-3d70-2ec613b25c8d)
		AND
		QRY_OnlyOnce("UND_DarkJusticiar_VBAfterDialog")
		THEN
		StartVoiceBark(UND_DarkJusticiarCorpse_VB_Recognized_3ac2e0c1-f43f-55d9-7e06-d9ad80ebd2d0,(CHARACTER)_Player);
		
		//END_REGION
		
		
		//REGION Broken Moonlantern
		IF
		AddedTo(S_UND_Nere_Moonlantern_Broken_5a76ae0a-d013-42e9-98b5-fa427a1cddbe, (CHARACTER)_Player, _)
		AND
		DB_Players(_Player)
		AND
		NOT DB_GlobalFlag((FLAG)UND_TheDrowNere_Event_MoonlanternBroken_8165207b-e0ad-1a9f-701f-ca7f63ead477)
		AND
		QRY_OnlyOnce("UND_BrokenMoonlantern_Looted")
		AND
		GetFlag(UND_BrokenMoonLantern_HasMet_abc77f3d-eb82-6874-b577-e801cb3b6cf4, _Player, 0) // User flag
		AND
		QRY_StartDialog_Fixed(UND_BrokenMoonlantern_26dfd5df-1d47-67f1-d8a3-8f5268e85d8d,_Player)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)UND_TheDrowNere_Event_MoonlanternBroken_8165207b-e0ad-1a9f-701f-ca7f63ead477);
		
		IF
		TemplateUseFinished((CHARACTER)_Player, _, S_UND_Nere_Moonlantern_Broken_5a76ae0a-d013-42e9-98b5-fa427a1cddbe, 1)
		AND
		DB_Players(_Player)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)UND_TheDrowNere_Event_MoonlanternBroken_8165207b-e0ad-1a9f-701f-ca7f63ead477);
		//END_REGION
		
		
		//REGION Rothe dialogues
		IF
		LeftCombat(_Rothe, _)
		AND
		DB_UND_DuergarCamp_Rothes((CHARACTER)_Rothe)
		AND
		DB_GlobalFlag((FLAG)UND_DuergarCamp_DeepRothe_State_RunningAway_a15445f0-e0cd-43c7-88ae-ffbcc28d97a0)
		THEN
		SetEntityEvent(_Rothe, "ClearPeaceReturn", 1);
		
		PROC
		PROC_StateSet_Defeated(_Rothe)
		AND
		DB_UND_DuergarCamp_RotheDiscussion((CHARACTER)_Rothe)
		THEN
		PROC_RemoveDialog(S_UND_DuergarCamp_Rothe_01_bc34c553-e236-4fd9-bd6f-2e18a56bcef0);
		PROC_RemoveDialog(S_UND_DuergarCamp_Rothe_02_e8c50208-b414-42cc-b49a-48003b13c762);
		DB_Dialogs((CHARACTER)S_UND_DuergarCamp_Rothe_01_bc34c553-e236-4fd9-bd6f-2e18a56bcef0,(DIALOGRESOURCE)UND_DuergarCamp_Rothe_01_62f21dd8-f1a4-703d-7277-8b1beefb331b);
		DB_Dialogs((CHARACTER)S_UND_DuergarCamp_Rothe_02_e8c50208-b414-42cc-b49a-48003b13c762,(DIALOGRESOURCE)UND_DuergarCamp_Rothe_02_dd7fb611-b759-484a-821b-e99e0fba1960);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog(UND_DuergarCamp_DeepRothe_Event_Leave_67e1d8e2-142c-45b1-b1a2-c17431053162)
		THEN
		PROC_SetRelationMutual((FACTION)ACT1_UND_DeepRothe_f291b19a-8ede-405a-9432-95648f741bbe, (FACTION)ACT1_UND_DuergarGuards_ec33d1c9-262d-05e5-5c15-05bcb84cc6a5, 0);
		SetFlag(UND_DuergarCamp_DeepRothe_State_RunningAway_a15445f0-e0cd-43c7-88ae-ffbcc28d97a0, NULL_00000000-0000-0000-0000-000000000000);
		//END_REGION
		
		
		//REGION Banters
		
		//Nere is defeated, the excavation is defeated.
		IF
		DB_GlobalFlag((FLAG)UND_DuergarGuards_Excavation_State_Defeated_3f30c825-10f1-4fa5-84b8-073f293e6650)
		AND
		DB_GlobalFlag((FLAG)UND_TheDrowNere_State_PermaDefeated_53f1e115-adf8-4608-b85c-08e0dc7d67ad)
		AND
		NOT DB_DuergarCamp_SafeForBanter(1)
		THEN
		DB_DuergarCamp_SafeForBanter(1);
		
		//Mutineers leave.
		PROC
		PROC_UND_DuergarMutineers_Leave()
		AND
		NOT DB_DuergarCamp_SafeForBanter(1)
		THEN
		DB_DuergarCamp_SafeForBanter(1);
		
		//Nere leaves.
		PROC
		PROC_UND_TheDrowNere_Leave()
		AND
		NOT DB_DuergarCamp_SafeForBanter(1)
		THEN
		DB_DuergarCamp_SafeForBanter(1);
		
		//Site deserted
		PROC
		PROC_UND_DuergarCamp_Deserted()
		AND
		NOT DB_DuergarCamp_SafeForBanter(1)
		THEN
		DB_DuergarCamp_SafeForBanter(1);
		
		IF
		DB_DuergarCamp_SafeForBanter(1)
		THEN
		TimerLaunch("UND_DuergarCamp_Banters", 10000);
		
		IF
		TimerFinished("UND_DuergarCamp_Banters")
		THEN
		PROC_RegisterWorldGossipTrigger((TRIGGER)S_PartyBanterTrigger_UND_DuergarInCleared_b5dbac59-3f23-4ed2-b448-83014d61f5ef);
		PROC_RegisterWorldGossipTrigger((TRIGGER)S_PartyBanterTrigger_UND_DuergarBalcony_afd31d8b-a002-499a-8a73-f21c2052bfad);
		
		PROC
		PROC_GLO_DefeatCounter_AllDefeated("UND_KethericCity_OozeAmbush")
		THEN
		DB_UND_KethericCity_OozeAmbushOver(1);
		
		IF
		DialogEnded(UND_PanicRoom_HiddenGnome_d0c4d689-b98f-2450-bc02-4b006b6e8cab,_)
		THEN
		DB_UND_KethericCity_CheckedPanicRoom(1);
		
		IF
		DB_UND_KethericCity_OozeAmbushOver(1)
		AND
		DB_UND_KethericCity_CheckedPanicRoom(1)
		THEN
		PROC_RegisterWorldGossipTrigger((TRIGGER)S_PartyBanterTrigger_UND_OozeStairs_f918c9b7-b45c-4ff1-8b56-aac6678979bc);
		
		//END_REGION
		
		
		//REGION Merregon Masks
		IF
		AddedTo(_Item,(CHARACTER)_Char, _)
		AND
		DB_Players(_Char)
		AND
		DB_UND_MerregonMask((ITEM)_Item)
		THEN
		NOT DB_UND_MerregonMask(_Item);
		PROC_IncreaseCounter("UND_MerregonMasksCollected_Counter");
		PROC_UND_MerregonMask_StartADReaction(_Char, _Item);
		
		PROC
		PROC_CounterIncreased("UND_MerregonMasksCollected_Counter", 4)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		QuestUpdateIsUnlocked(_Player, "HIDDEN_WLD_Boosters", "UND_MerregonMask_FoundAll", 0)
		THEN
		QuestUpdate(_Player, "HIDDEN_WLD_Boosters", "UND_MerregonMask_FoundAll");
		
		PROC
		PROC_UND_MerregonMask_StartADReaction((CHARACTER)_Character, (ITEM)_Mask)
		AND
		DB_OnlyOnce("UND_MerregonMask_AttemptedArcana")
		AND
		NOT DB_GlobalFlag((FLAG)UND_MerregonMask_State_FinishedAllComments_a0f1285a-32a5-8cc5-d79a-0c1a4826fa66)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)UND_MerregonMask_PAD_0a1a4729-23ef-0dac-bd03-3500c78399f1, _Character);
		
		PROC
		PROC_UND_MerregonMask_StartADReaction((CHARACTER)_Character, (ITEM)_Mask)
		AND
		QRY_OnlyOnce("UND_MerregonMask_AttemptedArcana")
		THEN
		PROC_KnowledgeCheck(_Character, "UND_DuergarCamp_FoundMerregonMask", _Mask, "Arcana", (DIFFICULTYCLASS)DC_Legacy_10_625be976-7a67-4394-97c8-14c69715ae4b, (DIALOGRESOURCE)UND_MerregonMask_PAD_0a1a4729-23ef-0dac-bd03-3500c78399f1, (FLAG)UND_MerregonMask_Event_ArcanaSuccess_b51a3710-de8f-34d8-fdc0-d0acefce5d76);
		
		QRY
		QRY_GLO_SkillCheck_CheckAdvantage((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _Item, _)
		AND
		DB_UND_MerregonMask(_Item)
		THEN
		DB_QRYRTN_GLO_Skillcheck_CheckAdvantage(2);
		
		QRY
		QRY_GLO_SkillCheck_CheckAdvantage(_Player, _Item, _)
		AND
		IsTagged(_Player, REALLY_PLANAR_4cb02915-7ad7-4141-907e-93253c6a8644, 1)
		AND
		DB_UND_MerregonMask(_Item)
		THEN
		DB_QRYRTN_GLO_Skillcheck_CheckAdvantage(2);
		//END_REGION
		
		
		//REGION Panic Room
		IF
		GameBookInterfaceClosed(S_UND_PanicJournal_fdd6f488-7598-4bb8-a533-55c8ff9ecb00,_Char)
		AND
		NOT DB_GlobalFlag(UND_PanicRoom_Knows_Journal_4a2f67b8-21dc-3d04-bc99-9425b8f12f40)
		AND
		QRY_SetConditionalGlobalFlag(UND_PanicRoom_Knows_Journal_4a2f67b8-21dc-3d04-bc99-9425b8f12f40,1)
		AND
		DB_GlobalFlag(UND_MerregonMask_Knows_Merregon_4cc68d90-721d-2655-d552-d5afe826b3b1)
		THEN
		StartVoiceBark(UND_PanicRoom_VB_99420472-a2c4-1318-0a5b-a6ce00be619e,_Char);
		//END_REGION
		
		//REGION Adamantine Knowledge Check
		IF
		TemplateAddedTo(LOOT_GEN_AdamantineScrap_8705b906-316d-4457-bc15-15a8ff568f67,_Item, _Player, _)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		QRY_OnlyOnce("UND_DuergarCamp_FoundAdamantine")
		THEN
		PROC_KnowledgeCheck(_Player, "UND_DuergarCamp_RecogniseAdamantine", _Item, "Intelligence", (DIFFICULTYCLASS)DC_Legacy_15_bddbb9b8-a242-4c3e-a2eb-3fd274c0c539, (DIALOGRESOURCE)UND_DuergarCamp_PAD_FoundAdamantine_30faab84-c4e1-0314-0239-2b54dba4f387, (FLAG)UND_DuergarCamp_State_AdamantineKnowledge_555bf26f-84fd-e988-e437-11f83628cce6);
		
		QRY
		QRY_GLO_SkillCheck_CheckAdvantage(_Player, _Item, _)
		AND
		GetTemplate(_Item, LOOT_GEN_AdamantineScrap_8705b906-316d-4457-bc15-15a8ff568f67)
		AND
		IsTagged(_Player, REALLY_DWARF_ad129444-0f41-4114-9ee5-2b9902d7ca8d, 1)
		THEN
		DB_QRYRTN_GLO_Skillcheck_CheckAdvantage(1);
		
		QRY
		QRY_GLO_SkillCheck_CheckAdvantage(_Player, _Item, _)
		AND
		GetTemplate(_Item, LOOT_GEN_AdamantineScrap_8705b906-316d-4457-bc15-15a8ff568f67)
		AND
		IsTagged(_Player, GUILD_ARTISAN_baf9fb0e-f535-40a0-bb78-3ec289d84e66, 1)
		THEN
		DB_QRYRTN_GLO_Skillcheck_CheckAdvantage(1);
		
		//END_REGION
		
		//REGION Nightfall banquet
		
		PROC
		PROC_GLO_KnowledgeCheckSuccess(_Character, "UND_NightfallBanquet", (TRIGGER)S_UND_NightFall_DialogTriggers_f10d731f-2dda-4343-af0e-8abd319cb224)
		THEN
		SetFlag((FLAG)UND_NightfallBanquet_ReligionCheckSuccessful_b9e5d7cd-7175-4129-9b48-ab9326d75c85, NULL_00000000-0000-0000-0000-000000000000, 0);
		StartVoiceBark(UND_RottenBanquet_VB_0abdba1d-dbe7-22bd-f14d-4c719cb94bc8, _Character);
		
		PROC
		PROC_GLO_KnowledgeCheckFailure(_Character, "UND_NightfallBanquet", (TRIGGER)S_UND_NightFall_DialogTriggers_f10d731f-2dda-4343-af0e-8abd319cb224)
		THEN
		StartVoiceBark(UND_RottenBanquet_VB_0abdba1d-dbe7-22bd-f14d-4c719cb94bc8, _Character);
		
		//END_REGION
		
		//REGION Rusty Weapons
		IF
		DB_UND_DuergarCamp_RustyWeapons(_Trigger)
		THEN
		PROC_TriggerRegisterForPlayers(_Trigger);
		
		IF
		DB_InRegion(_Player, _Trigger)
		AND
		DB_UND_DuergarCamp_RustyWeapons(_Trigger)
		AND
		DB_Players(_Player)
		THEN
		StartVoiceBark(UND_DuergarCamp_VB_SawRustyWeapons_0d54ca96-01ad-5719-79c1-9c769387b6a9, _Player);
		
		IF
		VoiceBarkStarted(UND_DuergarCamp_VB_SawRustyWeapons_0d54ca96-01ad-5719-79c1-9c769387b6a9, _)
		AND
		DB_UND_DuergarCamp_RustyWeapons(_Trigger)
		THEN
		PROC_TriggerUnregisterForPlayers(_Trigger);
		//END_REGION
		
		//REGION Mephits second wave
		
		IF
		DB_UND_MephitAmbush_SecondWave((CHARACTER)_Mephit, _)
		THEN
		PROC_SetOnStage(_Mephit,0);
		
		
		PROC
		PROC_GLO_DefeatCounter_Notify("UND_MephitAmbush_MephitAppear",_,_,2)
		AND
		QRY_OnlyOnce("UND_MephitAmbush_MephitAppear")
		AND
		DB_UND_MephitAmbush_SecondWave((CHARACTER)_Mephit,(TRIGGER)_Trigger)
		THEN
		AppearAt(_Mephit,_Trigger,1,UTIL_Spawn_01_510ff37e-0618-40e4-8ce0-236e3dc9c291,"");
		
		
		//END_REGION
		
		//REGION Oozes Ambush
		IF
		DB_GlobalFlag(GLO_DuergarCamp_EverEnteredBefore_ac0bae57-7006-4676-88b8-7498dde79c41)
		AND
		DB_AmbushTrigger_Ambusher_Appear(S_UND_KethericCity_OozesAmbushTrigger_bc8ced20-f0ed-431f-a527-df90b486d408,_Ooze,_Trigger,_,_,_)
		AND
		GUIDToString(_Trigger, _TriggerGUIDString)
		AND
		NOT DB_UND_KethericCity_AmbushingOoze_DrippingEffectRunning(_Ooze, (TRIGGER)_Trigger, (STRING)_TriggerGUIDString)
		THEN
		CreateSurface(_Trigger, "SurfaceAcid", 1.0, -1.0);
		DB_UND_KethericCity_AmbushingOoze_DrippingEffectRunning(_Ooze, (TRIGGER)_Trigger, (STRING)_TriggerGUIDString);
		PROC_LoopEffect(VFX_Characters_OOZE_Ochre_Jelly_Dripping_01_d3379af8-b2d2-cb80-2bd9-53ad0cad9f15, _Trigger, _TriggerGUIDString, "WLD_Main_A", "");
		
		IF
		WentOnStage((CHARACTER)_Ooze, 1)
		AND
		DB_UND_KethericCity_AmbushingOoze_DrippingEffectRunning(_Ooze, (TRIGGER)_Trigger, (STRING)_TriggerGUIDString)
		THEN
		NOT DB_UND_KethericCity_AmbushingOoze_DrippingEffectRunning(_Ooze, _Trigger, _TriggerGUIDString);
		PROC_StopLoopEffect(_Trigger, _TriggerGUIDString);
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(255).Title("Act1_UND_DuergarCamp_Misc_PostEA");
Goal(255)
{
	INIT
	{
		DB_GLO_CharacterCorpseDialog((CHARACTER)S_UND_HangedDrow_03_9c406179-6f8c-421d-8eb1-d2d23b4fdd5c,(DIALOGRESOURCE)UND_DuergarCamp_HangedDrow_Dead_fad15fc7-8247-2ae4-3f17-c9fbe72118d5);
