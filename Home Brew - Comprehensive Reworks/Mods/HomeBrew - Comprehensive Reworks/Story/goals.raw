		DB_Debug_GoldenPath_Step(S_Debug_GoldenPath_Step4_1a4691c1-bea2-495b-8598-22b9f91bb09b,S_Debug_Den_c9ca9582-5e5e-4ecf-9dd8-ddd94027df03,4);
		DB_Debug_GoldenPath_Step(S_Debug_GoldenPath_Step5_88debd90-ae63-4306-bd87-eaf8c097e015,S_DEN_DrowCavePos_05b0ace6-08fc-434a-8692-ca81f18449da,5);
		DB_Debug_GoldenPath_Step(S_Debug_GoldenPath_Step6_8e4d81ff-c050-4f1d-9076-c55867d733cc,S_FOR_DebugStartPoint_2c59b58f-0f35-4474-9ace-d94e8aa1ed1a,6);
