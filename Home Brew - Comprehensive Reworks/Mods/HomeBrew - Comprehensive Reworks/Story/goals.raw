		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act3_Soldier_CazadorDefeated");
		//END_REGION Soldier
		
		//REGION Urchin
		IF
		DB_GlobalFlag(LOW_BlushingMermaid_State_HagIsTrulyDead_c7c3e64d-dcfc-431b-a224-535a0c4a8e9c)
		AND
