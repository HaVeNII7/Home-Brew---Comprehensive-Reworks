		DB_OriginMayLeaveDialog((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255,(DIALOGRESOURCE)Astarion_InParty_53aba16e-55bb-a0fc-a444-522e237dbe46);
		DB_OriginMayLeaveDialog((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255,(DIALOGRESOURCE)HAG_GurHunter_64cafa8c-0e6b-ff68-a6f3-2da7c318e624);
		DB_OriginMayLeaveDialog((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255,(DIALOGRESOURCE)HAG_GurHunter_OM_Astarion_COM_26fdabd4-7604-cebe-11b0-4e7bbf08858d);
		
		DB_Inclusion_Object(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255,(FLAG)ORI_Inclusion_Astarion_d11b2268-6d2e-be4d-463a-53a2a5fb8a03,(FLAG)ORI_Inclusion_End_Astarion_51121c1d-1742-ffe0-1e27-373a816c7aa6);
		
		DB_Debug_CharacterAddFlags((FLAG)Debug_AddAstarion_b4462cbd-ffdc-0b6b-a367-b49c3dd0f66d,(CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255,(FLAG)Debug_AstarionIsPlayer_ea3679c7-0044-3645-b26b-40f87c58385a);
		DB_Debug_CharacterRemoveHideFlags((FLAG)Debug_RemoveHideAstarion_c7b8d25d-972a-6e17-cd67-a0fcb801da00,(CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255);
		
		DB_CompanionCanPartner((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, (FLAG)ORI_State_DatingAstarion_ba298c56-26b6-4918-9bd4-616668d369d8, (FLAG)ORI_State_PartneredWithAstarion_30819c8d-b39d-42e7-acd1-2a8c2c309994, (FLAG)ORI_State_WasPartneredWithAstarion_5a60943f-979b-4120-9b60-9e9b29529402, (FLAG)ORI_State_HandledBreakupWithAstarion_a8917c83-bcd4-4fb9-8459-649be92e2fbe, (FLAG)ORI_State_ChosePartnerOverAstarion_529d4115-ef78-49aa-b1f2-24994e4e75e3
		, "dateastarion");
		DB_CompanionIsDating((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, (FLAG)ORI_State_AstarionIsDating_532e4d60-1afe-47f0-9c51-c11aae22bd98);
		//END_REGION
		
		//REGION Leave Party Journal Entries
		DB_QuestDef_State_CompanionLeft((TAG)REALLY_ASTARION_ffd08582-7396-4cac-bcd4-8f9cd0fd8ef3, "ORI_COM_Astarion", "CompanionHostile");
		DB_QuestDef_State_CompanionLeft((TAG)REALLY_ASTARION_ffd08582-7396-4cac-bcd4-8f9cd0fd8ef3, "ORI_COM_Astarion", "CompanionLowRelation");
		DB_QuestDef_State_CompanionLeft((TAG)REALLY_ASTARION_ffd08582-7396-4cac-bcd4-8f9cd0fd8ef3, "ORI_COM_Astarion", "CompanionMurdered");
		DB_QuestDef_State_CompanionLeft((TAG)REALLY_ASTARION_ffd08582-7396-4cac-bcd4-8f9cd0fd8ef3, "ORI_COM_Astarion", "MetGur_AstarionDisappear");
		//END_REGION
		
		//REGION Astarion Specific
		DB_GlobalFlagInverter((FLAG)ORI_Astarion_Knows_Vampireness_43c71ab0-1aca-484a-950d-54106ae46da5,(FLAG)ORI_Astarion_Knows_NotVampireness_273469ff-cc2f-4675-bfa3-099a126b6cac);
		//END_REGION
		
		//REGION Camp Setup
		DB_ORI_OriginCampData((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, "WLDMAIN", (TRIGGER)S_CAMP_Astarion_A_d19215d0-0959-8f9f-63c6-c52a2833fb5f);
		DB_ORI_OriginCampData((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, "WLDCAVGRN", (TRIGGER)S_CAMP_Astarion_A_8ba72ac6-e510-87f9-663d-86e1f3353118);
		DB_ORI_OriginCampData((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, "WLDCAVSND", (TRIGGER)S_CAMP_Astarion_A_a58fdecb-9099-80e6-603c-bce004bbefea);
		DB_ORI_OriginCampData((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, "WLDDUNABB", (TRIGGER)S_CAMP_Astarion_A_a33645fc-59b5-8cb4-41d7-666f156b3398);
		DB_ORI_OriginCampData((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, "WLDDUNSHA", (TRIGGER)S_CAMP_Astarion_A_f6c39300-4700-8302-4278-bebed2ee250a);
		DB_ORI_OriginCampData((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, "WLDUND", (TRIGGER)S_CAMP_Astarion_A_1f863551-9835-8c19-3ec1-3eeef5374b2d);
		DB_ORI_OriginCampData((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, "WLDBAS", (TRIGGER)S_CAMP_Astarion_A_de8facad-5cc5-86c9-3244-e753137c4d91);
		//END_REGION
		
		DB_PermaDefeatedFlag(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, (FLAG)ORI_Astarion_State_PermaDefeated_7dbd9bb9-f0fd-c786-9860-256b9938bb31);
	}
	KB
	{
		//REGION Move to Camp
		PROC
		PROC_GLO_PartyMembers_AddHook((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255,(CHARACTER)_Player)
		AND
		QRY_OnlyOnce("RecruitedFirstTime_Astarion")
		THEN
		PROC_ORI_SetupCamp((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, 0);
		SetFlag((FLAG)ORI_Astarion_HasMet_7c64a986-6bfd-ae42-ba29-b35b7f2cd6cf, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		//EndRepose(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255);
		
		PROC
		PROC_GLO_PartyMembers_AddHook((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255,(CHARACTER)_Player)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		AND
		DB_Players(_AllPlayers)
		THEN
		QuestUpdate(_AllPlayers, "ORI_COM_Astarion", "RecruitedAstarion");
		
		IF
		TextEvent("astarion2camp")
		THEN
		PROC_ORI_SetupCamp((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, 1);
		
		IF
		EntityEvent((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255,"DebugTeleportedToCamp")
		THEN
		PROC_ORI_SetupCamp((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, 1);
		//END_REGION
		
		//REGION Unlocking Vampire Bite
		PROC
		PROC_CRA_WakeupDone()
		AND
		DB_Avatars(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		THEN
		AddSpell(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, "Target_VampireBite_Astarion", 1, 0);
		
		IF
		FlagSet(ORI_Astarion_Event_UnlockVampireBite_a887e372-d8a1-430f-809f-b0c7169920eb, _, _)
		THEN
		AddSpell(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, "Target_VampireBite_Astarion", 0, 0);
		RemoveStatus(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, "ORI_ASTARION_HIDDEN_RACE");
		DB_LongRestCountDown(2, (FLAG)ORI_Astarion_State_CompanionUnlockedBiteOneDayAgo_8ae9318f-96aa-4c47-b027-679deb42eb77);
		
		//END_REGION Unlocking Vampire Bite
		
		//REGION Tracking the last recruiter for the Bite camp night
		IF
		FlagSet((FLAG)OriginAddToParty_4870b2cd-210c-0fdc-9c58-4d0142bdae29, S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, _ID)
		AND
		DB_DialogPlayers(_ID, _Player, 1)
		THEN
		PROC_ORI_Astarion_StoreLastRecruiter((CHARACTER)_Player);
		
		IF
		FlagSet((FLAG)ORI_AstarionRecruitment_Event_InvitedToCamp_686f7a48-7a0a-0412-cf26-6a6deadcda91, _, _ID)
		AND
		DB_DialogPlayers(_ID, _Player, 1)
		THEN
		PROC_ORI_Astarion_StoreLastRecruiter((CHARACTER)_Player);
		
		// edge-case: the avatar-recruiter somehow leaves the party and Astarion is still in the team
		IF
		CharacterLeftParty(_Player)
		AND
		GetFlag(ORI_Astarion_State_LastRecruiter_516bb96d-3fff-4ab7-ab2d-3d0bc689ff90, _Player, 1)
		AND
		DB_PartOfTheTeam(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		AND
		QRY_GetBestAvatarForCompanion(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		AND
		DB_QRYRTN_GetBestAvatarForCompanion(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, _Avatar)
		THEN
		PROC_ORI_Astarion_StoreLastRecruiter(_Avatar);
		
		// recruiting via the debug book
		PROC
		PROC_DebugBook_RecruitCompanion(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, _Player)
		THEN
		PROC_ORI_Astarion_StoreLastRecruiter(_Player);
		
		PROC
		PROC_DebugBook_RecruitCamp(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, _Player)
		THEN
		PROC_ORI_Astarion_StoreLastRecruiter(_Player);
		
		PROC
		PROC_ORI_Astarion_StoreLastRecruiter((CHARACTER)_Recruiter)
		AND
		DB_ORI_Astarion_LastRecruiter(_OldLastRecruiter)
		THEN
		NOT DB_ORI_Astarion_LastRecruiter(_OldLastRecruiter);
		ClearFlag((FLAG)ORI_Astarion_State_LastRecruiter_516bb96d-3fff-4ab7-ab2d-3d0bc689ff90, _OldLastRecruiter);
		
		PROC
		PROC_ORI_Astarion_StoreLastRecruiter((CHARACTER)_LastRecruiter)
		THEN
		DB_ORI_Astarion_LastRecruiter((CHARACTER)_LastRecruiter);
		SetFlag((FLAG)ORI_Astarion_State_LastRecruiter_516bb96d-3fff-4ab7-ab2d-3d0bc689ff90, _LastRecruiter);
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(826).Title("GLO_Origin_Astarion_Forbiddance");
Goal(826)
{
	INIT
	{
	}
	KB
	{
		IF
		DB_ORI_Astarion_ForbiddanceTriggers(_Trigger)
		THEN
		TriggerRegisterForCharacter(_Trigger, S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255);
		
		//The Avatar always knows about his own weakness.
		IF
		DB_Avatars(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		THEN
		SetFlag(ORI_Astarion_Knows_Forbiddance_4e31ca68-aead-b37b-5bfb-7b22abbdb81b, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		EnteredTrigger(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, _Trigger)
		AND
		DB_Players(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		AND
		DB_ORI_Astarion_ForbiddanceTriggers(_Trigger)
		AND
		QRY_ORI_Astarion_ForbiddanceOwnersAlive(_Trigger)
		AND
		QRY_StartDialog_Fixed(Astarion_PAD_Forbiddance_75bf296f-9d0d-2c2e-3793-7ed097ca5a3f, S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		AND
		NOT DB_Avatars(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		THEN
		SetFlag(ORI_Astarion_Knows_Forbiddance_4e31ca68-aead-b37b-5bfb-7b22abbdb81b, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		QRY
		QRY_ORI_Astarion_ForbiddanceOwnersAlive((TRIGGER)_Trigger)
		AND
		DB_ORI_Astarion_ForbiddanceOwners(_Trigger, _Owner)
		AND
		NOT DB_Dead(_Owner)
		THEN
		DB_NOOP(1);
		
		IF
		AutomatedDialogStarted(Astarion_PAD_Forbiddance_75bf296f-9d0d-2c2e-3793-7ed097ca5a3f, _)
		THEN
		PROC_ORI_Astarion_DisableForbiddanceTriggers();
		
		IF
		FlagSet((FLAG)ORI_Astarion_Knows_ForbiddanceFromAstarion_3355a992-8bec-475b-8d72-b52794af0e92, _, _)
		THEN
		PROC_ORI_Astarion_DisableForbiddanceTriggers();
		
		PROC
		PROC_ORI_Astarion_DisableForbiddanceTriggers()
		AND
		DB_ORI_Astarion_ForbiddanceTriggers(_Trigger)
		THEN
		TriggerUnregisterForCharacter(_Trigger, S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255);
		
		PROC
		PROC_ORI_Astarion_DisableForbiddanceTriggers()
		THEN
		SysClear("DB_ORI_Astarion_ForbiddanceTriggers", 2);
		SysClear("DB_ORI_Astarion_ForbiddanceTriggerOwners", 2);
		GoalCompleted;
	}
	EXIT
	{
	}
}
Goal(827).Title("GLO_Origin_Astarion_PostEA");
Goal(827)
{
