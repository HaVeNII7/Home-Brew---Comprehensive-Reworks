{
	INIT
	{
		DB_ShovelArea((ITEM)S_CRE_BuriedMound_01_ebfd3008-856c-4573-b2c4-4fd8560fbbcc,(ITEM)S_CRE_BuriedChest_01_9dc16fc4-9f80-448f-ad43-74c6a9ffb5a0);
		
		DB_ShovelArea((ITEM)S_CRE_BuriedMound_02_5ce302d6-f890-4309-9647-2f1e0794e33c,(ITEM)S_CRE_BuriedChest_02_56ba4f23-72d8-4103-a8cf-c389401db323);
		
		DB_ShovelArea((ITEM)S_CRE_BuriedMound_03_1a65a722-06c9-4e30-bf85-ef0f788eadd1,(ITEM)S_CRE_BuriedChest_03_ed1d5510-e077-4dd8-b697-4a650df6e544);
		
		DB_ShovelArea((ITEM)S_CRE_BuriedMound_04_08a623c4-6a2f-4d17-8271-948f3352cee0,(ITEM)S_CRE_BuriedChest_04_d8e9d8d1-065d-4b63-887d-0b753f5169f1);
		
		DB_ShovelArea((ITEM)S_CRE_BuriedMound_05_d136bc3f-7623-45f3-a0eb-57a741ca486d,(ITEM)S_CRE_BuriedChest_05_ce26b3ec-bab9-4b2a-a53a-d7fea81c2d5b);
		
		DB_ShovelArea((ITEM)S_CRE_BuriedMound_06_b996fbf6-9620-4b0f-937c-460d0e9b99c4,(ITEM)S_CRE_BuriedChest_06_3adcadb4-dab8-4d8f-9654-89bfee75c406);
		
	}
	KB
	{
	}
	EXIT
