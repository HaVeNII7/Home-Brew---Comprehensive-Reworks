		PROC_UND_AdamantineForge_SpawnLava();
		
		PROC
		PROC_DialogFlagSetup((DIALOGRESOURCE)UND_CINE_AdamantineGolemSpawn_TurnValve_ab4f9f21-4173-dc1f-ff94-47032efcacd1, _, _)
		THEN
