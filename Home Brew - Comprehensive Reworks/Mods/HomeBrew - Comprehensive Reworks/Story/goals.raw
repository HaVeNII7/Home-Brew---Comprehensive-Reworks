		SetFlag((FLAG)LOW_OskarsBeloved_State_FledPossession_1e218b07-c517-451a-94f8-a853bcb03bc0);
		QuestUpdate("GLO_DoubtingArtist", "ArtistIsDead_AbandonedInPossession");
