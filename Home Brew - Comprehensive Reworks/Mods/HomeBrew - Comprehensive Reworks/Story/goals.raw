		DB_Avatars((CHARACTER)_Player)
		AND
		_Player != S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679
		AND
		NOT DB_Players((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		THEN
		DB_SelectedDialog((DIALOGRESOURCE)CAMP_NightsongShadowheartVisit_CFM_3327ccbc-a1c6-47ee-05ac-e735523036a5, (CHARACTER)S_GLO_Nightsong_6c55edb0-901b-4ba4-b9e8-3475a8392d9b, S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679, _Player);
		NOT DB_SelectedDialog((DIALOGRESOURCE)CAMP_NightsongShadowheartVisit_CFM_3327ccbc-a1c6-47ee-05ac-e735523036a5, (CHARACTER)S_GLO_Nightsong_6c55edb0-901b-4ba4-b9e8-3475a8392d9b, _Player);
		
		
		PROC
		PROC_Camp_Act2_NightsongShadowHeart_SelectCFM((GUIDSTRING)_Player)
		AND
		_Player != S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679
		AND
		NOT DB_Avatars((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		AND
		NOT QRY_SameUser((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679, (CHARACTER)_Player)
		THEN
		DB_SelectedDialog((DIALOGRESOURCE)CAMP_NightsongShadowheartVisit_PAD_WrongAvatar_08cfd4cc-3bdc-7d76-9285-6cf68d8cf940, _Player);
		NOT DB_SelectedDialog((DIALOGRESOURCE)CAMP_NightsongShadowheartVisit_CFM_3327ccbc-a1c6-47ee-05ac-e735523036a5, (CHARACTER)S_GLO_Nightsong_6c55edb0-901b-4ba4-b9e8-3475a8392d9b, _Player);
		
		PROC
		PROC_Camp_Act2_NightsongShadowHeart_SelectCFM((GUIDSTRING)_Player)
		AND
		_Player != S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679
		AND
		NOT DB_Avatars((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		AND
		NOT DB_Avatars((CHARACTER)_Player)
		THEN
		DB_SelectedDialog((DIALOGRESOURCE)CAMP_NightsongShadowheartVisit_PAD_WrongAvatar_08cfd4cc-3bdc-7d76-9285-6cf68d8cf940, _Player);
		NOT DB_SelectedDialog((DIALOGRESOURCE)CAMP_NightsongShadowheartVisit_CFM_3327ccbc-a1c6-47ee-05ac-e735523036a5, (CHARACTER)S_GLO_Nightsong_6c55edb0-901b-4ba4-b9e8-3475a8392d9b, _Player);
		
		PROC
		PROC_Camp_Act2_NightsongShadowHeart_SelectCFM((GUIDSTRING)_Player)
