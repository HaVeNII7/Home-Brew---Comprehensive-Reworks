		//REGION HAV
		DB_Subregion((TRIGGER)S_HAV_Haven_SUB_6ac001f4-9c56-4a1b-963d-a509e158ffab, "HAV_Haven_SUB", 0, 1);
		DB_Subregion(S_HAV_IsobelRoom_SUB_4310edec-0ce2-4ac0-adbd-c02d60b92c3d, "HAV_IsobelRoom_SUB", 0, 2);
		DB_Subregion(S_HAV_Haven_SUB_Cellar_eee18cb6-443a-4b8f-ad19-58dff3d731d8, "HAV_Haven_SUB_Cellar", 1, 1);
		DB_HAV_HavenAreas((TRIGGER)S_HAV_Haven_SUB_6ac001f4-9c56-4a1b-963d-a509e158ffab);
		DB_HAV_HavenAreas((TRIGGER)S_HAV_Haven_SUB_Cellar_eee18cb6-443a-4b8f-ad19-58dff3d731d8);
		//END_REGION HAV
		
		//REGION Cursed Town
		DB_Subregion(S_TWN_Tollhouse_SUB_50e2410a-7d5e-48c3-abba-2b64c0c0d325, "TWN_Tollhouse_SUB", 1, 1);
		DB_Subregion(S_TWN_Distillery_SUB_7e2fdbcd-538e-4287-9f7c-477026bf81e5, "TWN_Distillery_SUB", 1, 1);
		DB_Subregion(S_TWN_MasonsGuild_SUB_6a7702c0-e417-4d84-a10b-0b582c0fbd44, "TWN_MasonsGuild_SUB", 1, 1);
		DB_Subregion(S_TWN_Hospital_SUB_2ec2cc09-94ab-4479-bacd-cd5ca6911833, "TWN_Hospital_SUB", 1, 1);
		DB_Subregion(S_TWN_CentralSquare_SecretRoom_SUB_b9d720fe-bac9-45fe-8f71-b2bd8e382b81, "TWN_CentralSquare_SecretRoom_SUB", 0, 1);
		DB_Subregion((TRIGGER)S_TWN_Hospital_Morgue_SUB_e826c097-ebe8-4532-9b6f-aae2f3eec294, "TWN_Hospital_Morgue_SUB", 0, 1);
		//END_REGION Cursed Town
		//REGION COL
		DB_Subregion(S_COL_Colony_SUB_c72269e5-0719-4379-a8ea-ca2ca199d0a3, "COL_Colony_SUB", 0, 1);
		DB_Subregion(S_MOO_Oubliette_SUB_c6f54de0-1c8f-4cf8-bcf9-b13c8f53b05b,"COL_Oubliette_SUB",0,2);
		DB_Subregion(S_COL_Morgue_SUB_884ab063-7c18-4887-a725-e8b9c6b0100c,"COL_Morgue_SUB",0,2);
		DB_Subregion(S_COL_NecroLab_SUB_d4ed37da-ab88-415d-8131-917f954e4926,"COL_NecroLab_SUB",0,3);
		DB_Subregion(S_COL_TadpolingCentre_SUB_89b29154-b146-456f-8be9-3e10bf466844,"COL_TadpolingCentre_SUB",0,2);
		DB_Subregion(S_COL_Barracks_SUB_2e97382e-959c-4f45-9f69-56952bda7851,"COL_Barracks_SUB",0,2);
		//END_REGION
		
		//REGION CAMP
		DB_Subregion((TRIGGER)S_CAMP_SCLMAIN_Area_32e38308-f42c-49c9-8d62-0a0617395465,"CAMP_SUB",0, 1);
		DB_Subregion((TRIGGER)S_CAMP_SHARTEMPLE_Area_000_5e748dd0-ac68-4b58-bb05-5460fb9034ff,"CAMP_SUB",0, 1);
		DB_Subregion((TRIGGER)S_CAMP_HAVEN_Area_001_17e7cf27-0b17-4629-8b67-1d7c40fbe53f,"CAMP_SUB",0, 1);
		DB_Subregion((TRIGGER)S_CAMP_MOONRISE_Area_000_166fae21-95f4-4764-b740-a33faefb3d75,"CAMP_SUB",0, 1);
		//END_REGION
	}
	KB
	{
		//REGION Checking if Entity is anywhere in HAV
		//just check main subs
		QRY
		QRY_HAV_IsInHaven((GUIDSTRING)_Entity)
		AND
		IsInTrigger(_Entity, S_HAV_Haven_SUB_6ac001f4-9c56-4a1b-963d-a509e158ffab, 1)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_HAV_IsInHaven((GUIDSTRING)_Entity)
		AND
		IsInTrigger(_Entity, S_HAV_Haven_SUB_Cellar_eee18cb6-443a-4b8f-ad19-58dff3d731d8, 1)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_HAV_AnyPartyMemberInHaven()
		AND
		DB_PartyMembers(_PartyMember)
		AND
		QRY_HAV_IsInHaven(_PartyMember)
		THEN
		DB_NOOP(1);
		
		IF
		DB_InRegion(_PartyMember,(TRIGGER)_Trigger)
		AND
		DB_HAV_HavenAreas(_Trigger)
		AND
		DB_PartyMembers(_PartyMember)
		AND
		NOT DB_HAV_AnyPartyMemberInHaven(1)
		THEN
		DB_HAV_AnyPartyMemberInHaven(1);
		
		IF
		LeftTrigger(_PartyMember,(TRIGGER)_Trigger)
		AND
		DB_HAV_HavenAreas(_Trigger)
		AND
		DB_PartyMembers(_PartyMember)
		AND
		DB_HAV_AnyPartyMemberInHaven(1)
		AND
		NOT QRY_HAV_AnyPartyMemberInHaven()
		THEN
		NOT DB_HAV_AnyPartyMemberInHaven(1);
		
		//END_REGION
	}
	EXIT
	{
	}
}
