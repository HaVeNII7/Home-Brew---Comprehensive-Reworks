		DB_UND_Bulette_CombatArenas((FLAG)UND_Bulette_State_Arena004_InProgress_1efb30da-229c-4a92-bb6b-2e028f8751fa, (TRIGGER)S_UND_Bulette_CombatArena_004_1cc4e212-9201-4008-b16b-88764e11dd7e);
