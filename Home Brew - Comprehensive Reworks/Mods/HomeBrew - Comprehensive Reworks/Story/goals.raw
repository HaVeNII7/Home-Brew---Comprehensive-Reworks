		DB_HAG_HagSpawn_HusbandResurrectWithWand_WasWaitForDialogEnd(_ID);
		PROC_HAG_HagSpawn_HusbandResurrectedWithWand();
		
		PROC
		PROC_HAG_HagSpawn_HusbandResurrectedWithWand()
