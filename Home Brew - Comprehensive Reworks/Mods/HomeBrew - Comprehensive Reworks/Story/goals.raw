	KB
	{
		IF
		DB_LOW_MindflayerOutburst_Characters(_Character)
		THEN
		PROC_SetOnStage(_Character,0);
		
		IF
		DB_GlobalFlag((FLAG)GLO_BrainEscalation_State_NetherBrainReleased_06e31f1d-7e29-47ab-bce6-0f17cdc9c47e)
		AND
		DB_CurrentLevel("CTY_Main_A")
		AND
		QRY_OnlyOnce("LOW_SetupMindflayerOutbursts_OnlyOnce")
		THEN
		PROC_LOW_SetupMindflayerOutbursts();
		
		PROC
		PROC_LOW_SetupMindflayerOutbursts()
		AND
		DB_LOW_MindflayerOutburst_TurnedCivilians(_,_Trigger,_)
		THEN
		PROC_TriggerRegisterForParty(_Trigger);
		
		PROC
		PROC_LOW_SetupMindflayerOutbursts()
		AND
		DB_LOW_MindflayerOutburst_Characters(_Character)
		THEN
		PROC_SetOnStage((GUIDSTRING)_Character,1);
		
		PROC
		PROC_LOW_SetupMindflayerOutbursts()
		AND
		DB_LOW_MindflayerOutburst_TurnedCivilians(_Character,_,_Scene)
		THEN
		DB_SceneManager(_Character,_Scene);
		
		PROC
		PROC_LOW_SetupMindflayerOutbursts()
		THEN
		NOT DB_OneShotPartyTrigger((TRIGGER)S_LOW_BG_Lvl1Warning_fbbefd03-3745-4374-bc87-8b1cb42fd3e1);
		NOT DB_OneShotPartyTrigger((TRIGGER)S_LOW_BG_Lvl2Warning_5f24cfac-e422-41b2-b6fe-696d4f98e936);
		NOT DB_OneShotPartyTrigger((TRIGGER)S_LOW_BaldursGate_Lvl3Warning_37707943-c06d-4f3a-a65d-1c6cb6928db8);
		PROC_TriggerUnregisterForPlayers((TRIGGER)S_LOW_BG_Lvl2Warning_5f24cfac-e422-41b2-b6fe-696d4f98e936);
		PROC_TriggerUnregisterForPlayers((TRIGGER)S_LOW_BaldursGate_SlowZone_ca99b6a7-9dc9-4f74-87c4-410aa22af3c9);
		PROC_TriggerUnregisterForPlayers((TRIGGER)S_LOW_BaldursGate_RapidMindMeldArea_d7ff0c9f-c071-4960-bbbf-0962dfca11bf);
		
		PROC
		PROC_SceneInterrupted(_Character,_PartyMember,_Scene,"Attacked")
		AND
		DB_LOW_MindflayerOutburst_TurnedCivilians((CHARACTER)_Character,_Trigger,_Scene)
		THEN
		PROC_LOW_MindflayerOutrburstTriggered(_Trigger,_PartyMember,_Scene);
		
		PROC
		PROC_SceneInterrupted(_Character,_PartyMember,_Scene,"EnteredCombat")
		AND
		DB_LOW_MindflayerOutburst_TurnedCivilians((CHARACTER)_Character,_Trigger,_Scene)
		THEN
		PROC_LOW_MindflayerOutrburstTriggered(_Trigger,_PartyMember,_Scene);
		
		IF
		EnteredTrigger(_PartyMember,_Trigger)
		AND
		DB_LOW_MindflayerOutburst_TurnedCivilians(_,_Trigger,_Scene)
		AND
		DB_PartyMembers(_PartyMember)
		AND
		NOT DB_LOW_TriggeredMindflayerOutbursts(_Trigger)
		THEN
		DB_LOW_TriggeredMindflayerOutbursts(_Trigger);
		PROC_LOW_MindflayerOutrburstTriggered(_Trigger,_PartyMember,_Scene);
		
		PROC
		PROC_LOW_MindflayerOutrburstTriggered((TRIGGER)_Trigger,(CHARACTER)_PartyMember,(STRING)_Scene)
		THEN
		PROC_SceneOver(_Scene);
		PROC_TriggerUnregisterForParty(_Trigger);
		PROC_GLO_Brainquakes_ShakeGroundAroundCharacter(_PartyMember);
		
		PROC
		PROC_LOW_MindflayerOutrburstTriggered((TRIGGER)_Trigger,(CHARACTER)_PartyMember,(STRING)_Scene)
		AND
		DB_LOW_MindflayerOutburst_TurnedCivilians(_Character,_Trigger,_)
		THEN
		// Display Name Should be Chnaged once turning is complete
		UseSpell(_Character,"Shout_LOW_MindFlayerFormCivilian",_Character);
		
		IF
		UsingSpell(_Character,"Shout_LOW_MindFlayerFormCivilian",_,_,_)
		AND
		DB_LOW_MindflayerOutburst_TurningCiviliansADs(_Character,_AD)
		THEN
		PROC_TryStartAD(_AD,_Character);
		
		PROC
		PROC_DisappearOutOfSight(_Character,"Run",0,"LOW_MindflayerOutburst_Civilians_DisappearOutOfSight")
		AND
		DB_LOW_MindflayerOutburst_RunningAwayCiviliansADs(_Character,_AD)
		THEN
		PROC_TryStartAD(_AD,_Character);
		
		IF
		StatusApplied(_Character,"LOW_MINDFLAYEROUTBURST_MINDFLAYERFORM",_,_)
		AND
		DB_LOW_MindflayerOutburst_TurnedCivilians((CHARACTER)_Character,_,_)
		THEN
		SetFaction(_Character,(FACTION)ACT3_LOW_MindflayerOutburst_Mindflayers_29138c5f-d984-4d4a-a9e9-cbc7c8f8aafd);
		
		IF
		StatusApplied(_Character,"LOW_MINDFLAYEROUTBURST_MINDFLAYERFORM",_,_)
		AND
		DB_LOW_MindflayerOutburst_NewbornMindflayerADs(_Character,_AD)
		THEN
		PROC_TryStartAD(_AD,_Character);
		
		IF
		StatusApplied(_Character,"LOW_MINDFLAYEROUTBURST_MINDFLAYERFORM",_,_)
		AND
		DB_LOW_MindflayerOutburst_TurnedCivilians((CHARACTER)_Character,_Trigger,_)
		AND
		NOT DB_LOW_MindflayerOutburst_CiviliansRanAway(_Trigger)
		THEN
		DB_LOW_MindflayerOutburst_CiviliansRanAway(_Trigger);
		PROC_LOW_MindflayerOutburst_CiviliansRunAway(_Trigger);
		
		IF
		StatusApplied(_Character,"LOW_MINDFLAYEROUTBURST_MINDFLAYERFORM",_,_)
		AND
		DB_LOW_MindflayerOutburst_TurnedCivilians((CHARACTER)_Character,_Trigger,_)
		AND
		NOT DB_LOW_MindflayerOutburst_CombatSurprise(_Trigger)
		THEN
		DB_LOW_MindflayerOutburst_CombatSurprise(_Trigger);
		RealtimeObjectTimerLaunch(_Trigger,"LOW_MindflayerOutburst_SurprisePartyMembersInCombat_Timer",1000);
		PROC_LOW_MindflayerOutburst_CombatSurprise(_Trigger);
		
		PROC
		PROC_LOW_MindflayerOutburst_CombatSurprise((TRIGGER)_Trigger)
		AND
		DB_LOW_MindflayerOutburst_Bystanders(_Character,_Trigger)
		AND
		IsTagged(_Character,(TAG)GUARD_0b52f35e-fb1f-4865-bcd2-5d21ef7343cd,1)
		AND
		NOT DB_LOW_MindflayerOutburst_Surprised(_Character,_Trigger)
		THEN
		DB_LOW_MindflayerOutburst_Surprised(_Character,_Trigger);
		PROC_MakeSurprised(_Character);
		
		IF
		ObjectTimerFinished(_Trigger,"LOW_MindflayerOutburst_SurprisePartyMembersInCombat_Timer")
		AND
		DB_LOW_MindflayerOutburst_CombatSurprise((TRIGGER)_Trigger)
		THEN
		NOT DB_LOW_MindflayerOutburst_CombatSurprise(_Trigger);
		
		IF
		DB_Is_InCombat(_PartyMember,_CombatID)
		AND
		DB_PartyMembers((CHARACTER)_PartyMember)
		AND
		DB_LOW_MindflayerOutburst_TurnedCivilians(_TurnedCivilian,_Trigger,_)
		AND
		DB_Is_InCombat(_TurnedCivilian,_CombatID)
		AND
		DB_LOW_MindflayerOutburst_CombatSurprise(_Trigger)
		AND
		NOT DB_LOW_MindflayerOutburst_Surprised(_PartyMember,_Trigger)
		THEN
		DB_LOW_MindflayerOutburst_Surprised(_PartyMember,_Trigger);
		PROC_MakeSurprised(_PartyMember);
		
		PROC
		PROC_LOW_MindflayerOutburst_CiviliansRunAway((TRIGGER)_Trigger)
		AND
		DB_LOW_MindflayerOutburst_Bystanders(_Character,_Trigger)
		AND
		IsTagged(_Character,(TAG)GUARD_0b52f35e-fb1f-4865-bcd2-5d21ef7343cd,0)
		AND
		IsTagged(_Character,(TAG)STEEL_WATCHER_bc09a589-e076-4b2d-8b86-f8cccbb64449,0)
		THEN
		NOT DB_LOW_MindflayerOutburst_Bystanders(_Character,_Trigger);
		PROC_DisappearOutOfSight(_Character,"Run",0,"LOW_MindflayerOutburst_Civilians_DisappearOutOfSight");
		
		PROC
		PROC_LOW_MindflayerOutburst_CiviliansRunAway((TRIGGER)_Trigger)
		AND
		DB_LOW_MindflayerOutburst_CrowdTriggers(_CrowdTrigger,_Trigger)
		THEN
		TriggerSetCrowdBehaviour(_CrowdTrigger, CROWDBEHAVIOUR.Flee);
		TriggerSetCrowdSpawningEnable((TRIGGER)_CrowdTrigger,0);
		
		IF
		DB_Is_InCombat(_Player,_CombatID)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		DB_LOW_MindflayerOutburst_TurnedCivilians(_TurnedCivilian,_Trigger,_)
		AND
		DB_Is_InCombat(_TurnedCivilian,_CombatID)
		AND
		NOT DB_LOW_MindflayerOutburst_CombatStartEmperorADTriggered(_Trigger)
		THEN
		DB_LOW_MindflayerOutburst_CombatStartEmperorADTriggered(_Trigger);
		PROC_EmperorAD((CHARACTER)_Player, (DIALOGRESOURCE)GLO_BrainEscalation_AD_MindflayerOutburstStarted_EmperorReaction_5222b924-e1e9-8e37-dc21-3c20e16a4928);
		PROC_ResetEmperorAD((CHARACTER)_Player, (DIALOGRESOURCE)GLO_BrainEscalation_AD_MindflayerOutburstStarted_EmperorReaction_5222b924-e1e9-8e37-dc21-3c20e16a4928);
		
		PROC
		PROC_GLO_BrainEscalationCombatEnded((GUIDSTRING)_CombatID)
		AND
		DB_LOW_MindflayerOutburst_Bystanders(_FlamingFist,_)
		AND
		QRY_GLO_IsOrWasInCombat(_FlamingFist,_CombatID)
		THEN
		PROC_DisappearOutOfSight(_FlamingFist,"Run",0,"LOW_MindflayerOutburst_FlamingFists_DisappearOutOfSight");
		
		PROC
		PROC_DisappearOutOfSight(_FlamingFist,"Run",0,"LOW_MindflayerOutburst_FlamingFists_DisappearOutOfSight")
		AND
		DB_LOW_MindflayerOutburst_Bystanders(_FlamingFist,_Trigger)
		AND
		NOT DB_LOW_MindflayerOutburst_FlamingFistPostCombatADTriggered(_Trigger)
		AND
		DB_LOW_MindflayerOutburst_RunningAwayFlamingFistsADs(_Trigger,_AD)
		AND
		IsTagged(_FlamingFist,(TAG)CONSTRUCT_22e5209c-eaeb-40dc-b6ef-a371794110c2,0)
		AND
		QRY_SpeakerIsAvailable(_FlamingFist)
		THEN
		DB_LOW_MindflayerOutburst_FlamingFistPostCombatADTriggered(_Trigger);
		PROC_TryStartAD(_AD,_FlamingFist);
		
		//REGION SWs turn hostile to FFs and allied to MFs on joining mindflayer outburst combats as they all serve Elder Brain
		IF
		DB_GLO_SteelWatchers((CHARACTER)_SteelWatcher)
		AND
		DB_Is_InCombat(_SteelWatcher,_CombatID)
		AND
		NOT DB_LOW_HostileSteelWatchers(_SteelWatcher)
		AND
		DB_LOW_MindflayerOutburst_TurnedCivilians(_TurnedCivilian,_,_)
		AND
		DB_Is_InCombat(_TurnedCivilian,_CombatID)
		THEN
		DB_LOW_HostileSteelWatchers(_SteelWatcher);
		SetFaction(_SteelWatcher,(FACTION)GLO_SteelWatcher_BrainControlled_Evil_32bd22de-7252-4c9b-a110-9afb810eb115);
		
		IF
		BaseFactionChanged(_SteelWatcher,_,(FACTION)GLO_SteelWatcher_BrainControlled_Evil_32bd22de-7252-4c9b-a110-9afb810eb115)
		AND
		DB_LOW_MindflayerOutburst_Bystanders(_SteelWatcher,_Trigger)
		THEN
		NOT DB_LOW_MindflayerOutburst_Bystanders(_SteelWatcher,_Trigger);
		//END_REGION
		
		//REGION Debug
		IF
		DB_LOW_MindflayerOutburst_Characters(_Character)
		AND
		HasActiveStatus(_Character,"LOW_MINDFLAYEROUTBURST_MINDFLAYERFORM",1)
		THEN
		RemoveStatus(_Character,"LOW_MINDFLAYEROUTBURST_MINDFLAYERFORM");
		//END_REGION
	}
	EXIT
	{
	}
}
