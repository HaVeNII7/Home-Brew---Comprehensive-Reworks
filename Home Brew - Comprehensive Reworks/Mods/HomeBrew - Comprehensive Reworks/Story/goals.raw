		IF
		HitpointsChanged(_Avatar, _RemainingHP)
		AND
		DB_ORI_Laezel_Romance2_EnableADs(1)
		AND
		_RemainingHP <= 50.0
		AND
		DB_ORI_Laezel_Romance2_AvatarOpponent((CHARACTER)_Avatar)
		AND
		QRY_OnlyOnce("ORI_Laezel_Romance2_LaezelOnAvatarHalfHealth_ADPlayed")
		THEN
