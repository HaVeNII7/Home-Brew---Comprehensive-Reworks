		LookFromTrigger(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, S_CAMP_BetrayalDrowPos_b9ca7f9e-b660-4cac-b7f9-f5e0fd66e7c4, 1);
		
