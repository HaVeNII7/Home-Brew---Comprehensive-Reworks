		DB_SpotPlayers(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f, "TWN_ArabellasPowers_SpottedPlayer_Chat", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		DB_SpotPlayers_SpotTrigger(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f, "TWN_ArabellasPowers_SpottedPlayer_Chat", S_TWN_ArabellasPowers_DialogBoxTrigger_69e3ca61-03c6-44b3-b10e-a2d95a0aa613);
		
		DB_Dialogs(S_TWN_Hospital_Reception_CorpseTender_64198bb1-d575-4b7b-bcf9-0c58d24020f1, (DIALOGRESOURCE)TWN_Hospital_Reception_CorpseTender_84142e2e-804e-c4d5-83f3-d1443b2a8321);
		DB_DialogBlockTradeButton(TWN_Hospital_Reception_CorpseTender_84142e2e-804e-c4d5-83f3-d1443b2a8321);
		
		DB_GLO_CharacterCorpseDialog(S_DEN_ParentA_d6d88c8b-6ba7-4350-b3b3-d60565a44e90,TWN_ArabellasPowers_ParentA_Dead_b13f2f9b-14ef-5f12-d67b-595cdaa913cb);
		DB_GLO_CharacterCorpseDialog((CHARACTER)S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f,TWN_ArabellasPowers_ZombieArabella_Dead_bd148d8e-3d64-39e3-c675-6ef01206b4dc);
		
		SetTag(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f,(TAG)ACT2_SHADOW_CURSE_IMMUNE_b47643e0-583c-4808-b108-f6d3b605b0a9);
		
		DB_TWN_ArabellaPowers_Parents((CHARACTER)S_DEN_ParentB_397467d4-1631-447b-a505-d44275dca78e, (FLAG)TWN_ArabellaPowers_State_Reacted_Mother_633f29f4-156e-892b-38c9-3909256b3b85);	
		DB_TWN_ArabellaPowers_Parents((CHARACTER)S_DEN_ParentA_d6d88c8b-6ba7-4350-b3b3-d60565a44e90, (FLAG)TWN_ArabellaPowers_State_Reacted_Father_ed409656-1a18-25b9-772b-db95623b95c7);
		
		SetOnStage(S_TWN_Hospital_Reception_TendedCorpse_d15d2347-6b23-4ad6-a49c-6e9d8c2069e7,0);
		
		PROC_TWN_ArabellasPowers_PreInit();
		PROC_TriggerRegisterForPlayers(S_TWN_ArabellasPowers_DialogBoxTrigger_69e3ca61-03c6-44b3-b10e-a2d95a0aa613);
		
		
		//Journal
		//Meet Arabella and Start, parents not seen
		DB_QuestDef_State_ConditionalFlag((FLAG)TWN_ArabellaPowers_State_MovedToCamp_b5f880bc-272e-e8a3-8ca1-b3dca3bce191, "TWN_FindArabellasParents", "ArabellaStart", 0, (FLAG)TWN_ArabellasPowers_State_ParentsFoundDead_e3077a60-12dd-fe83-bc56-f646091d4029);
		
		//Meet Arabella and Start, parents already seen
		DB_QuestDef_State_ConditionalFlag((FLAG)TWN_ArabellaPowers_Event_AskedForHelp_7537b739-d975-625f-fb7f-d037d8a90bf2, "TWN_FindArabellasParents", "ArabellaStartSawBodies", 1, (FLAG)TWN_ArabellasPowers_State_ParentsFoundDead_e3077a60-12dd-fe83-bc56-f646091d4029);
		
		
		//Resolved happily with Jergal
		DB_QuestDef_State((FLAG)CAMP_ArabellaAtCamp_State_JergalSceneDone_28bd7736-306f-49a8-9e4b-3473673aa1e6, "TWN_FindArabellasParents", "ArabellaTalkedJergal");
		
		//REGION Arabella removed from camp
		DB_GLO_Levels_RemoveArabellaFromCamp("INT_Main_A");
		DB_GLO_Levels_RemoveArabellaFromCamp("BGO_Main_A");
		DB_GLO_Levels_RemoveArabellaFromCamp("CTY_Main_A");
		//END_REGION
	}
	KB
	{
		//REGION init
		
		IF
		DB_TWN_ArabellasPowers_FirstEncounterShadows(_Shadow)
		THEN
		SetOnStage(_Shadow,0);
		
		IF
		DB_TWN_ArabellasPowers_FirstEncounterShadows(_Shadow)
		AND
		HasActiveStatus(_Shadow,"TWN_ARABELLAPOWERS_ARABELLAVINES",1)
		THEN
		RemoveStatus(_Shadow,"TWN_ARABELLAPOWERS_ARABELLAVINES");
		
		PROC
		PROC_TWN_ArabellasPowers_PreInit()
		AND
		QRY_OnlyOnce("TWN_ArabellasPowers_PreInit")
		THEN
		PROC_TWN_ArabellasPowers_Init();
		
		PROC
		PROC_TWN_ArabellasPowers_Init()
		AND
		QRY_TWN_ArabellasPowers_CanInitArabella()
		THEN
		PROC_TWN_ArabellasPowers_InitArabella();
		
		PROC
		PROC_TWN_ArabellasPowers_Init()
		AND
		NOT QRY_TWN_ArabellasPowers_CanInitArabella()
		THEN
		PROC_TWN_ArabellasPowers_InitGoblin();
		
		QRY
		QRY_TWN_ArabellasPowers_CanInitArabella()
		AND
		DB_GlobalFlag((FLAG)DEN_TieflingRefugees_State_LeftDen_003b304b-f058-4f8a-b9fa-a097e1b6b395)
		AND
		DB_GlobalFlag(DEN_ShadowDruid_State_SnakeCourtStarted_461195aa-0d53-44c3-bc45-3b8bbe59649d)
		AND
		NOT DB_GlobalFlag(DEN_ShadowDruid_State_KidDied_5b5de896-e733-47ae-81df-85a4b25ebfd1)
		AND
		NOT DB_PermaDefeated((CHARACTER)S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f)
		AND
		NOT DB_PermaDefeated((CHARACTER)S_DEN_ParentA_d6d88c8b-6ba7-4350-b3b3-d60565a44e90)
		AND
		NOT DB_PermaDefeated((CHARACTER)S_DEN_ParentB_397467d4-1631-447b-a505-d44275dca78e)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_TWN_ArabellasPowers_InitArabella()
		THEN
		PROC_CharacterFullRestore(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f);
		TeleportTo(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f,S_TWN_ArabellaPowers_ArabellaSpot_27a59458-175f-48b1-b611-205755d1645b,"SCL_TWN_ArabellaPowers_ArabellaTeleport");
		PROC_RemoveAllDialogEntriesForSpeaker(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f);
		DB_Dialogs(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f,TWN_ArabellasPowers_TownIntroduction_78c6743c-ff1d-386c-2205-209edaae1a06);
		SetOnStage(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f,1);
		SetFaction(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f,(FACTION)ACT2_TWN_Arabella_33166e4b-4fd9-474c-8a4e-a97d1bc60b0f);
		PROC_SetRelationMutual((FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, (FACTION)ACT2_TWN_Arabella_33166e4b-4fd9-474c-8a4e-a97d1bc60b0f, 50);
		SetFlag(TWN_ArabellaPowers_State_MovedToTown_9f385b21-1522-42c8-aa00-64dad6a46237);
		
		PROC
		PROC_TWN_ArabellasPowers_Init()
		AND
		DB_PermaDefeated((CHARACTER)S_DEN_ParentA_d6d88c8b-6ba7-4350-b3b3-d60565a44e90)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)TWN_ArabellasPowers_State_ParentA_DeadBeforeTown_c5d3fadc-0aae-40ae-8688-8b6c31450a8c);
		
		PROC
		PROC_TWN_ArabellasPowers_Init()
		AND
		DB_PermaDefeated((CHARACTER)S_DEN_ParentB_397467d4-1631-447b-a505-d44275dca78e)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)TWN_ArabellasPowers_State_ParentB_DeadBeforeTown_d7007710-b123-4725-9108-2b2e4fb24617);
		
		// the scripting above won't work if the tieflings die due to you skipping the conflict
		// and moving straight to Act 2, Init() is called before DB_Defeated is filled
		PROC
		PROC_TWN_ArabellasPowers_Init()
		AND
		NOT DB_GlobalFlag((FLAG)DEN_TieflingRefugees_State_LeftDen_003b304b-f058-4f8a-b9fa-a097e1b6b395)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)TWN_ArabellasPowers_State_ParentA_DeadBeforeTown_c5d3fadc-0aae-40ae-8688-8b6c31450a8c);
		PROC_GlobalSetFlagAndCache((FLAG)TWN_ArabellasPowers_State_ParentB_DeadBeforeTown_d7007710-b123-4725-9108-2b2e4fb24617);
		
		PROC
		PROC_TWN_ArabellasPowers_InitGoblin()
		THEN
		SetOnStage(S_TWN_Hospital_Reception_TendedCorpse_d15d2347-6b23-4ad6-a49c-6e9d8c2069e7,1);
		SetTag(S_TWN_Hospital_Reception_TendedCorpse_d15d2347-6b23-4ad6-a49c-6e9d8c2069e7, (TAG)ACT2_SHADOW_CURSE_IMMUNE_b47643e0-583c-4808-b108-f6d3b605b0a9);
		Use(S_TWN_Hospital_Reception_TendedCorpse_d15d2347-6b23-4ad6-a49c-6e9d8c2069e7,S_TWN_Hospital_Reception_CorpseTender_CorpseBed_22dff80b-9604-4612-862f-e75999d7c7f9,1,1,"TWN_Hospital_CorpseTender_UsedBed");
		
		PROC
		PROC_TWN_ArabellasPowers_InitArabella()
		THEN
		RemoveHarmfulStatuses(S_DEN_ParentB_397467d4-1631-447b-a505-d44275dca78e);
		PROC_SetOnStage(S_DEN_ParentB_397467d4-1631-447b-a505-d44275dca78e, 1);
		SetTag(S_DEN_ParentB_397467d4-1631-447b-a505-d44275dca78e, (TAG)ACT2_SHADOW_CURSE_IMMUNE_b47643e0-583c-4808-b108-f6d3b605b0a9);
		TeleportTo(S_DEN_ParentB_397467d4-1631-447b-a505-d44275dca78e,S_TWN_ArabellaPowers_ParentBPoint_eadeed84-81a1-48f6-b978-e393406c0b07,"SCL_TWN_ArabellaPowers_ParentBTeleport");
		Use(S_DEN_ParentB_397467d4-1631-447b-a505-d44275dca78e,S_TWN_Hospital_Reception_CorpseTender_CorpseBed_22dff80b-9604-4612-862f-e75999d7c7f9,1,1,"TWN_Hospital_CorpseTender_UsedBed");
		
		PROC
		PROC_TWN_ArabellasPowers_InitArabella()
		THEN
		RemoveHarmfulStatuses(S_DEN_ParentA_d6d88c8b-6ba7-4350-b3b3-d60565a44e90);
		PROC_SetOnStage(S_DEN_ParentA_d6d88c8b-6ba7-4350-b3b3-d60565a44e90, 1);
		SetTag(S_DEN_ParentA_d6d88c8b-6ba7-4350-b3b3-d60565a44e90, (TAG)ACT2_SHADOW_CURSE_IMMUNE_b47643e0-583c-4808-b108-f6d3b605b0a9);
		TeleportTo(S_DEN_ParentA_d6d88c8b-6ba7-4350-b3b3-d60565a44e90,S_TWN_ArabellaPowers_ParentAPoint_4fed0be7-a924-44ac-bd46-69839fb883ac,"SCL_TWN_ArabellaPowers_ParentATeleport");
		Use(S_DEN_ParentA_d6d88c8b-6ba7-4350-b3b3-d60565a44e90,S_TWN_ArabellaPowers_ParentABed_6b9e8498-9efe-48ed-bba2-8d60fdd723b7,1,1,"TWN_Hospital_CorpseTender_UsedBed");
		
		IF
		UseFinished(S_TWN_Hospital_Reception_TendedCorpse_d15d2347-6b23-4ad6-a49c-6e9d8c2069e7,S_TWN_Hospital_Reception_CorpseTender_CorpseBed_22dff80b-9604-4612-862f-e75999d7c7f9, 1)
		THEN
		Die(S_TWN_Hospital_Reception_TendedCorpse_d15d2347-6b23-4ad6-a49c-6e9d8c2069e7,DEATHTYPE.DoT,NULL_00000000-0000-0000-0000-000000000000,1,1,0.0);
		
		IF
		UseFinished(S_DEN_ParentB_397467d4-1631-447b-a505-d44275dca78e,S_TWN_Hospital_Reception_CorpseTender_CorpseBed_22dff80b-9604-4612-862f-e75999d7c7f9, 1)
		THEN
		Die(S_DEN_ParentB_397467d4-1631-447b-a505-d44275dca78e,DEATHTYPE.DoT,NULL_00000000-0000-0000-0000-000000000000,1,1,0.0);
		
		IF
		UseFinished(S_DEN_ParentA_d6d88c8b-6ba7-4350-b3b3-d60565a44e90,S_TWN_ArabellaPowers_ParentABed_6b9e8498-9efe-48ed-bba2-8d60fdd723b7, 1)
		THEN
		Die(S_DEN_ParentA_d6d88c8b-6ba7-4350-b3b3-d60565a44e90,DEATHTYPE.DoT,NULL_00000000-0000-0000-0000-000000000000,1,1,0.0);
		//END_REGION init
		
		//REGION trade with corpse tender
		
		IF
		FlagSet((FLAG)TWN_CorpseTender_State_PassedCorpseCheck_f187530a-0fe5-6fad-bc0e-4998df7b588e,_,_)
		AND
		DB_DialogBlockTradeButton(TWN_Hospital_Reception_CorpseTender_84142e2e-804e-c4d5-83f3-d1443b2a8321)
		THEN
		NOT DB_DialogBlockTradeButton(TWN_Hospital_Reception_CorpseTender_84142e2e-804e-c4d5-83f3-d1443b2a8321);
		
		//END_REGION trade with corpse tender
		
		//REGION Debug
		
		IF
		FlagSet((FLAG)TWN_ArabellasPowers_Debug_Teleport_a1ccd405-8ed6-4fdf-b19c-772b8f02edc7, _, _)
		AND
		GetHostCharacter(_Player)
		THEN
		PROC_GlobalSetFlagAndCache(DEN_ShadowDruid_State_SnakeCourtStarted_461195aa-0d53-44c3-bc45-3b8bbe59649d);
		PROC_GlobalSetFlagAndCache(DEN_TieflingRefugees_State_LeftDen_003b304b-f058-4f8a-b9fa-a097e1b6b395);
		TeleportTo(_Player, S_TWN_ArabellaDebugPoint_aef52933-e365-4e94-97a2-af67b32f59bc, "TWN_Debug_Teleport_To_Arabella", 1, 1, 1, 1, 1);
		Resurrect(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f);
		PROC_TWN_ArabellasPowers_Init();
		
		IF
		TextEvent("TWN_ArabellaPowers_Reset")
		THEN
		Resurrect(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f);
		PROC_TWN_ArabellasPowers_Init();
		
		IF
		TextEvent("TWN_ArabellaPowers_CheckParents")
		AND
		DB_GlobalFlag((FLAG)TWN_ArabellasPowers_State_ParentA_DeadBeforeTown_c5d3fadc-0aae-40ae-8688-8b6c31450a8c)
		AND
		GetHostCharacter(_Player)
		THEN
		DebugText(_Player,"Dad dead before twn");
		
		IF
		TextEvent("TWN_ArabellaPowers_CheckParents")
		AND
		NOT DB_GlobalFlag((FLAG)TWN_ArabellasPowers_State_ParentA_DeadBeforeTown_c5d3fadc-0aae-40ae-8688-8b6c31450a8c)
		AND
		GetHostCharacter(_Player)
		THEN
		DebugText(_Player,"Dad alive before twn");
		
		IF
		TextEvent("TWN_ArabellaPowers_CheckParents")
		AND
		DB_GlobalFlag((FLAG)TWN_ArabellasPowers_State_ParentB_DeadBeforeTown_d7007710-b123-4725-9108-2b2e4fb24617)
		AND
		GetHostCharacter(_Player)
		THEN
		DebugText(_Player,"Mom dead before twn");
		
		IF
		TextEvent("TWN_ArabellaPowers_CheckParents")
		AND
		NOT DB_GlobalFlag((FLAG)TWN_ArabellasPowers_State_ParentB_DeadBeforeTown_d7007710-b123-4725-9108-2b2e4fb24617)
		AND
		GetHostCharacter(_Player)
		THEN
		DebugText(_Player,"Mom alive before twn");
		
		IF
		DB_GlobalFlag((FLAG)DEN_AttackOnDen_State_RaiderVictory_abe1bce8-c234-4afe-a490-76210d98a078)
		AND
		NOT DB_Dead(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f)
		THEN
		Die(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f);
		
		IF
		DB_GlobalFlag((FLAG)DEN_AttackOnDen_State_RaiderVictory_abe1bce8-c234-4afe-a490-76210d98a078)
		THEN
		SetOnStage(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f,0);
		
		IF
		DB_GlobalFlag((FLAG)DEN_AttackOnDen_State_DenVictory_71c7f23e-3ff1-c9b8-3ef5-d75fa1b42c8d)
		THEN
		SetOnStage(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f,1);
		
		IF
		DB_GlobalFlag((FLAG)DEN_AttackOnDen_State_DenVictory_71c7f23e-3ff1-c9b8-3ef5-d75fa1b42c8d)
		AND
		DB_Dead(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f)
		AND
		NOT DB_GlobalFlag(TWN_ArabellaPowers_State_StayedAtTown_58722b05-d7d2-5199-6ae1-937ae5b91b2b)
		THEN
		Resurrect(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f);
		
		IF
		DB_GlobalFlag((FLAG)HAV_TieflingSurvivors_Debug_Setup_ee73faa7-3b8e-907b-84fe-8ad4aaf6f364)
		THEN
		PROC_TWN_ArabellasPowers_Init();
		
		IF
		TextEvent("TWN_ArabellaPowers_ResetParentsReaction")
		THEN
		ClearFlag((FLAG)TWN_ArabellasPowers_State_RecognisedParents_305b596e-fa8f-3c70-759d-47ce7648d074,NULL_00000000-0000-0000-0000-000000000000,0);
		
		IF
		TextEvent("TWN_ArabellaPowers_ResetParentsReaction")
		AND
		DB_TWN_ArabellaPowers_Parents(_,_Flag)
		THEN
		ClearFlag(_Flag,NULL_00000000-0000-0000-0000-000000000000,0);
		
		//END_REGION Debug
		
		//REGION Triggering TWN Dialog via trigger
		//Sets spotting
		PROC
		PROC_SpotPlayers_Spotted(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f, "TWN_ArabellasPowers_SpottedPlayer_Wave", _Player)
		AND
		DB_Players(_Player)
		THEN
		SetFlag((FLAG)TWN_ArabellaPowers_Event_SpottedPlayers_24f93cfe-7e12-4809-aa1c-2ce2a5c61a41, S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f, 0);
		PROC_SpotPlayers_CleanupSpotting("TWN_ArabellasPowers_SpottedPlayer_Wave");
		
		//Just tries once, if it fails, dialog can still by started normally by clicking on Arabella
		PROC
		PROC_SpotPlayers_Spotted(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f, "TWN_ArabellasPowers_SpottedPlayer_Chat", _Player)
		AND
		DB_Players(_Player)
		AND
		QRY_OnlyOnce("TWN_ArabellasPowers_FirstMetArabella")
		AND
		QRY_StartDialog(TWN_ArabellasPowers_TownIntroduction_78c6743c-ff1d-386c-2205-209edaae1a06, S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f, _Player)
		THEN
		PROC_SpotPlayers_StopSpotting(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f, "TWN_ArabellasPowers_SpottedPlayer_Chat");
		
		PROC
		PROC_SpotPlayers_Spotted(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f, "TWN_ArabellasPowers_SpottedPlayer_Chat", _)
		THEN
		PROC_SpotPlayers_CleanupSpotting("TWN_ArabellasPowers_SpottedPlayer_Chat");
		//END_REGION Triggering TWN dialog via trigger
		
		//REGION shadows appearing during introduction
		
		PROC
		PROC_StartDialog_AddExtraSpeakers(TWN_ArabellasPowers_TownIntroduction_78c6743c-ff1d-386c-2205-209edaae1a06,_ID)
		AND
		DB_TWN_ArabellasPowers_FirstEncounterShadows(_Shadow)
		THEN
		PROC_DialogAddSpeakingActor(_ID,_Shadow);
		
		IF
		FlagSet((FLAG)TWN_ArabellaPowers_Event_ShadowsTwisted_48a16669-dd92-adf4-0891-a6a73cbda346,_,_)
		AND
		DB_TWN_ArabellasPowers_FirstEncounterShadows(_Shadow)
		AND
		GetPosition(_Shadow,_X,_Y,_Z)
		THEN
		DebugText(_Shadow,"TWN_ARABELLAPOWERS_ARABELLAVINES");
		ApplyStatus(_Shadow,"TWN_ARABELLAPOWERS_ARABELLAVINES",-1.0,1,S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f);
		AppearAtPosition(_Shadow,_X,_Y,_Z,1,(ANIMATION)SHADOW_Rig_DFLT_CMBT_Initiative_01_325d7832-848b-8435-9d5b-4cabba822c48,"",0);
		
		IF
		DialogEnded(TWN_ArabellasPowers_TownIntroduction_78c6743c-ff1d-386c-2205-209edaae1a06,_)
		AND
		NOT DB_GlobalFlag(TWN_ArabellaPowers_Event_ShadowsTwisted_48a16669-dd92-adf4-0891-a6a73cbda346)
		AND
		DB_TWN_ArabellasPowers_FirstEncounterShadows(_Shadow)
		THEN
		PROC_GlobalSetFlagAndCache(TWN_ArabellaPowers_Event_ShadowsTwisted_48a16669-dd92-adf4-0891-a6a73cbda346);
		UseSpell(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f,"Target_TWN_ArabellaPowers_ShadowEnsnare",_Shadow);
		
		//END_REGION shadows appearing during introduction
		
		//REGION Moving to the camp
		PROC
		PROC_GlobalFlagReactionAfterDialog(TWN_ArabellaPowers_State_MovedToCamp_b5f880bc-272e-e8a3-8ca1-b3dca3bce191)
		THEN
		PROC_DisappearOutOfSight((CHARACTER)S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f,"Run",1,"TWN_ArabellaPowers_RunToCamp");
		
		IF
		EntityEvent((CHARACTER)_Arabella, "TWN_ArabellaPowers_RunToCamp")
		THEN
		PROC_ORI_SetupCamp(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f);
		PROC_RemoveAllDialogEntriesForSpeaker(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f);
		DB_Dialogs(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f, CAMP_ArabellaPowers_Arabella_d116229d-e77e-782b-1937-5271efa4e67e);
		DB_InCamp(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f);
		
		//END_REGION Moving to the camp
		
		//REGION Staying at Town
		
		//Arabella Disappears
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)TWN_ArabellaPowers_State_StayedAtTown_58722b05-d7d2-5199-6ae1-937ae5b91b2b)
		THEN
		PROC_DisappearOutOfSight((CHARACTER)S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f,"Run",1,"TWN_ArabellaPowers_RunToTown");
		
		IF
		TextEvent("TWN_ArabellaPowers_RunToTown")
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)TWN_ArabellaPowers_State_StayedAtTown_58722b05-d7d2-5199-6ae1-937ae5b91b2b);
		PROC_DisappearOutOfSight((CHARACTER)S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f,"Run",1,"TWN_ArabellaPowers_RunToTown");
		
		
		//Arabella Reappears in Town Dead
		//Either After Long Rest
		PROC
		PROC_LongRest()
		AND
		DB_GlobalFlag(TWN_ArabellaPowers_State_StayedAtTown_58722b05-d7d2-5199-6ae1-937ae5b91b2b)
		AND
		QRY_OnlyOnce("TWN_Arabella_AppearInTownDead")
		THEN
		PROC_ArabellaDiesInTown();
		
		//Or if players enter Nightsongs Prison
		IF
		DB_InRegion(_Player, (TRIGGER)S_SHA_NightsongPrison_SUB_0a302268-dd92-4462-99e5-ca7491815ec0)
		AND
		DB_GlobalFlag(TWN_ArabellaPowers_State_StayedAtTown_58722b05-d7d2-5199-6ae1-937ae5b91b2b)
		AND
		DB_Avatars(_Player)
		AND
		QRY_OnlyOnce("TWN_Arabella_AppearInTownDead")
		THEN
		PROC_ArabellaDiesInTown();
		
		PROC
		PROC_ArabellaDiesInTown()
		THEN
		PROC_Children_RemoveNPC(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f);
		SetOnStage(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f,1);
		TeleportTo(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f,S_TWN_ArabellaPower_DeathPoint_aebe7414-4089-43a2-af5b-008cc81fff52);
		Die(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f,DEATHTYPE.Physical,1);
		DB_ExecuteInLevel("TWN_Arabella_AppearInTownDead_Shadows","SCL_Main_A");
		
		PROC
		PROC_ExecuteInLevel("TWN_Arabella_AppearInTownDead_Shadows","SCL_Main_A")
		AND
		DB_TWN_ArabellasPowers_DeathShadows(_Shadow,_)
		THEN
		SetOnStage(_Shadow,1);
		ApplyStatus(_Shadow,"TWN_ARABELLAPOWERS_ARABELLAVINES",-1.0,1,NULL_00000000-0000-0000-0000-000000000000);
		
		PROC
		PROC_ExecuteInLevel("TWN_Arabella_AppearInTownDead_Shadows","SCL_Main_A")
		AND
		DB_TWN_ArabellasPowers_DeathShadows(_Shadow,1)
		THEN
		Die(_Shadow,DEATHTYPE.Physical,1);
		
		//END_REGION Staying at Town
		
		//REGION Finding parents
		
		IF
		CharacterLootedCharacter(_Player,_Parent)
		AND
		DB_TWN_ArabellaPowers_Parents(_Parent,_Flag)
		AND
		NOT DB_GlobalFlag((FLAG)TWN_ArabellasPowers_State_RecognisedParents_305b596e-fa8f-3c70-759d-47ce7648d074)
		THEN
		PROC_GlobalSetFlagAndCache(_Flag);
		PROC_GlobalSetFlagAndCache((FLAG)TWN_ArabellasPowers_State_RecognisedParents_305b596e-fa8f-3c70-759d-47ce7648d074);
		PROC_TryStartAD(TWN_ArabellasPowers_PAD_FoundParents_8c8ae214-cddd-ca9c-1cf1-a8650100c7bb,_Player);
		
		IF
		DB_GlobalFlag((FLAG)TWN_ArabellasPowers_State_RecognisedParents_305b596e-fa8f-3c70-759d-47ce7648d074)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)TWN_ArabellasPowers_State_ParentsFoundDead_e3077a60-12dd-fe83-bc56-f646091d4029);
		
		IF
		DialogStarted(TWN_ArabellasPowers_ParentA_Dead_b13f2f9b-14ef-5f12-d67b-595cdaa913cb,_)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)TWN_ArabellasPowers_State_ParentsFoundDead_e3077a60-12dd-fe83-bc56-f646091d4029);
		
		//END_REGION Finding parents
		
		//REGION Journal
		IF
		FlagSet((FLAG)TWN_ArabellasPowers_State_ParentsFoundDead_e3077a60-12dd-fe83-bc56-f646091d4029, _, _)
		AND
		QuestUpdateIsUnlocked(NULL_00000000-0000-0000-0000-000000000000, "TWN_FindArabellasParents", "ArabellaStart", 1)
		THEN
		QuestUpdate("TWN_FindArabellasParents", "FoundBodies");
		
		//Unhappy ending where Arabella runs off and dies if you already found her dead parents and are mean about it
		IF
		FlagSet(TWN_ArabellaPowers_State_StayedAtTown_58722b05-d7d2-5199-6ae1-937ae5b91b2b, _, _)
		AND
		DB_GlobalFlag(TWN_ArabellasPowers_State_ParentsFoundDead_e3077a60-12dd-fe83-bc56-f646091d4029)
		AND
		DB_GlobalFlag(TWN_ArabellaPowers_Event_ShadowsAppear_7347d8cb-34a7-63b8-b780-2075ae5d0965)
		THEN
		QuestUpdate("TWN_FindArabellasParents", "ArabellaStartFakeStart");
		QuestUpdate("TWN_FindArabellasParents", "ArabellaRanAway");
		
		IF
		FlagSet(TWN_ArabellasPowers_State_ToldParentsDead_cc1a3765-9334-cb88-602f-49ca052de39c, _, _)
		AND
		DB_InCamp(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f)
		THEN
		QuestUpdate("TWN_FindArabellasParents", "CheckOnArabella");
		
		IF
		DialogEnded(TWN_ArabellasPowers_TownIntroduction_78c6743c-ff1d-386c-2205-209edaae1a06, _)
		AND
		DB_GlobalFlag(TWN_ArabellaPowers_State_StayedAtTown_58722b05-d7d2-5199-6ae1-937ae5b91b2b)
		AND
		NOT DB_GlobalFlag(TWN_ArabellasPowers_State_ParentsFoundDead_e3077a60-12dd-fe83-bc56-f646091d4029)
		THEN
		QuestUpdate("TWN_FindArabellasParents", "ArabellaStartNoCamp");
		
		IF
		LevelGameplayStarted("BGO_Main_A", _)
		AND
		DB_QuestIsOpened("TWN_FindArabellasParents")
		AND
		NOT DB_GlobalFlag((FLAG)TWN_ArabellasPowers_State_ToldParentsDead_cc1a3765-9334-cb88-602f-49ca052de39c)
		AND
		DB_GlobalFlag(TWN_ArabellaPowers_State_StayedAtTown_58722b05-d7d2-5199-6ae1-937ae5b91b2b)
		THEN
		QuestUpdate("TWN_FindArabellasParents", "NeverToldParents");
		
		//END_REGION
		
		//REGION Arabells shouldn't react to dangeours shapeshift forms while in TWN
		PROC
		PROC_TWN_ArabellasPowers_PreInit()
		AND
		NOT DB_PermaDefeated((CHARACTER)S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f)
		THEN
		PROC_CRIME_DisableDangerousShapeshiftReactions(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f);
		
		IF
		EntityEvent(_, "TWN_ArabellaPowers_RunToCamp")
		THEN
		PROC_CRIME_EnableDangerousShapeshiftReactions(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f);
		//END_REGION
		
		//REGION Arabella removed from camp
		IF
		LevelLoaded(_Level)
		AND
		DB_GLO_Levels_RemoveArabellaFromCamp(_Level)
		AND
		DB_InCamp((CHARACTER)S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f)
		THEN
		NOT DB_InCamp(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f);
		
		IF
		LevelLoaded(_Level)
		AND
		DB_GLO_Levels_RemoveArabellaFromCamp(_Level)
		AND
		DB_CampLevelSwap_WasInCamp((CHARACTER)S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f)
		THEN
		NOT DB_CampLevelSwap_WasInCamp(S_DEN_SnakeKid_02257c1c-bbec-4ae3-9bcb-31c75a0a982f);
		//END_REGION
	}
	EXIT
	{
	}
}
