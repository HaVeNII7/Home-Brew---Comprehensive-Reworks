		DB_AmbushTrigger((TRIGGER)S_UND_MephitAmbush_Start_662c6eae-ab99-4806-a334-4d6f6f3cc062, NULL_00000000-0000-0000-0000-000000000000, (DIFFICULTYCLASS)DC_Legacy_0_98d69b07-f551-4d77-af31-41d074748dc0);
