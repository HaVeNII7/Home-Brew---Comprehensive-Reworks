		//PROC_LOW_BhaalTemple_Debug_SetWarnedOrin();
		PROC_LOW_BhaalTemple_Debug_GiveBhaalAmulet();
		//PROC_LOW_BhaalTemple_Debug_EnableWithers();
		PROC_GEN_OrinsAbduction_Debug_SetKilledGortash();
		
		
		IF
