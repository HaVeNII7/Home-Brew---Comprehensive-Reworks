		DB_GLO_ScryingEye_AbsoluteFactions((FACTION)ACT1_GOB_WolfPens_Worgs_2df5ac7c-486f-ad96-dabb-31cf3b26dc89);
		DB_GLO_ScryingEye_AbsoluteFactions((FACTION)ACT1_GOB_WolfPens_Worgs_2df5ac7c-486f-ad96-dabb-31cf3b26dc89);
		DB_GLO_ScryingEye_AbsoluteFactions((FACTION)ACT1_GOB_Torturers_8a9e7e9a-1e72-eed1-8175-6c8d50ef7372);
		
		PROC_CharacterDisableAllCrimes(S_GOB_Eye_7e80dd2a-19f6-4411-8a52-35c3878ef4c8);
	}
	KB
	{
		QRY
		QRY_GOB_ScryingEye_ShouldTrigger((CHARACTER)_Character)
		AND
		DB_Is_InCombat(_Character,_)
		THEN
		DB_NOOP(1);
		
		//Battlestations takes priority 
		QRY
		QRY_CRIME_GuardDisabled((CHARACTER)_Guard)
		AND
		DB_CRIME_Guards_RegionGuard("WLD_Main_A_GOB", "GOB_ThroneRoom", _Guard)
		AND
		DB_GlobalFlag(GOB_BattleStations_Event_ToStation_03a8bd66-c23f-4989-9a7b-775cf475104b)
		THEN
		DB_NOOP(1);
		
		//REGION Voice Bark on notice
		
		IF
		DB_Sees(_Player, (CHARACTER)S_GOB_Eye_7e80dd2a-19f6-4411-8a52-35c3878ef4c8)
		AND
		DB_Players(_Player)
		AND
		NOT DB_GlobalFlag(GOB_BattleStations_Event_ToStation_03a8bd66-c23f-4989-9a7b-775cf475104b)
		AND
		NOT DB_GlobalFlag(GOB_WolfPens_State_HalsinIsInParty_7d95447a-3fd3-4ac9-851f-b817106d54ef)
		AND
		NOT DB_GOB_ScryingEye_BlockEvent("GOB_GoblinThrone_NoticeScryingEye_VBPlayed")
		AND
		NOT DB_GOB_ScryingEye_BlockEvent("GOB_GoblinThrone_NoticeScryingEye_TimerLaunched")
		THEN
		DB_GOB_ScryingEye_BlockEvent("GOB_GoblinThrone_NoticeScryingEye_TimerLaunched");
		TimerLaunch("GOB_GoblinThrone_NoticeScryingEye_Timer", 1500);
		
		IF
		TimerFinished("GOB_GoblinThrone_NoticeScryingEye_Timer")
		AND
		DB_GOB_ScryingEye_BlockEvent("GOB_GoblinThrone_NoticeScryingEye_TimerLaunched")
		THEN
		NOT DB_GOB_ScryingEye_BlockEvent("GOB_GoblinThrone_NoticeScryingEye_TimerLaunched");
		
		IF
		TimerFinished("GOB_GoblinThrone_NoticeScryingEye_Timer")
		AND
		DB_Sees((CHARACTER)_Player, (CHARACTER)S_GOB_Eye_7e80dd2a-19f6-4411-8a52-35c3878ef4c8)
		AND
		DB_Players(_Player)
		AND
		NOT DB_GOB_ScryingEye_BlockEvent("GOB_GoblinThrone_NoticeScryingEye_VBPlayed")
		AND
		GetDistanceTo((CHARACTER)_Player, (CHARACTER)S_GOB_Eye_7e80dd2a-19f6-4411-8a52-35c3878ef4c8, (REAL)_Distance)
		AND
		_Distance < 15.0
		AND
		QRY_SpeakerIsAvailable(_Player)
		AND
		QRY_OncePerUserAndNearbyPlayers((CHARACTER)_Player, "GOB_GoblinThrone_NoticeScryingEye")
		THEN
		DB_GOB_ScryingEye_BlockEvent("GOB_GoblinThrone_NoticeScryingEye_VBPlayed");
		StartVoiceBark(GOB_GoblinThrone_VB_NoticeScryingEye_2892b0e3-13a5-b61f-c4b4-414b37d25eab, _Player);
		
		IF
		TimerFinished("GOB_GoblinThrone_NoticeScryingEye_Timer")
		AND
		DB_Sees((CHARACTER)_Player, (CHARACTER)S_GOB_Eye_7e80dd2a-19f6-4411-8a52-35c3878ef4c8)
		AND
		DB_Players(_Player)
		AND
		NOT DB_GOB_ScryingEye_BlockEvent("GOB_GoblinThrone_NoticeScryingEye_VBPlayed")
		AND
		NOT DB_GOB_ScryingEye_BlockEvent("GOB_GoblinThrone_NoticeScryingEye_TimerLaunched")
		THEN
		DB_GOB_ScryingEye_BlockEvent("GOB_GoblinThrone_NoticeScryingEye_TimerLaunched");
		TimerLaunch("GOB_GoblinThrone_NoticeScryingEye_Timer", 1500);
		
		IF
		DB_Sees(_Player,(CHARACTER)S_GOB_Eye_7e80dd2a-19f6-4411-8a52-35c3878ef4c8)
		AND
		DB_Players(_Player)
		AND
		NOT DB_GlobalFlag(GOB_State_ScryingEyeSeen_9ff6a163-91ac-34e9-f8e7-7902ebf2cfba)
		THEN
		PROC_GlobalSetFlagAndCache(GOB_State_ScryingEyeSeen_9ff6a163-91ac-34e9-f8e7-7902ebf2cfba);
		
		//END_REGION Voice Bark on notice
		/*
		QRY
		QRY_CrimeMurderGetCrimeTypesCustom(_Killer,(CHARACTER)S_GOB_Eye_7e80dd2a-19f6-4411-8a52-35c3878ef4c8)
		THEN
		DB_QRYRTN_CrimeMurderGetCrimeTypes("GOB_ScryingEye_Murder");
		*/
		
	}
	EXIT
	{
	}
}
