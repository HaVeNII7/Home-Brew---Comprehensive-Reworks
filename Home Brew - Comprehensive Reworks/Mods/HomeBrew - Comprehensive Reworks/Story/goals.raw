		//REGION Supreme Tadpole & Party Mind Flayer
		IF
		FlagSet(END_IllithidOptions_Event_GiveSupremeTadpole_a8128df9-dea6-4a4d-961d-9dbdc49ebb38, _Char, _)
		THEN
