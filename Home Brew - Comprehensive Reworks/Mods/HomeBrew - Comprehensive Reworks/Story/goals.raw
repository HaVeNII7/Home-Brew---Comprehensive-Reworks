		AND
		DB_ORI_Astarion_LastRecruiter(_LastRecruiter)
		THEN
		RegisterAsCompanion((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, _LastRecruiter);
		DB_BUGFIX_Marker("GUS-313660");
		
