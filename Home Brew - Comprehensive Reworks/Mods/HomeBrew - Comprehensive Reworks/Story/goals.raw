		DB_GlobalFlagReactionAfterDialog(COL_MizorasRescue_State_SavedMizora_148bcec2-5367-2b72-3c93-29fb32fc0181,(DIALOGRESOURCE)COL_MizorasRescue_OM_Wyll_COM_AOM_OOM_a988e571-00eb-904b-f8f5-0d767dd1aacb);
		
