		AND
		NOT DB_OnlyOnce("DEN_CapturedGoblin_GuardsDialog")
		THEN
		PROC_DEN_CapturedGoblin_GuardsDialog(_Player);
		
		PROC
		PROC_DEN_CapturedGoblin_TryAvenge((CHARACTER)_Player)
