		DB_GOB_BattleStations_AlarmOwnership(S_GOB_AlarmSystem_ThroneTrigger_d3f4f681-46e5-4afa-8118-664b0e741cb8);
		DB_GOB_BattleStations_AlarmOwnership(S_GOB_AlarmSystem_PensTrigger_6b3cac09-0af6-4177-ad93-8a544aba701b);
		DB_GOB_BattleStations_AlarmOwnership(S_GOB_AlarmSystem_DrowTrigger_aa34f1ff-9f92-4c0c-ada1-20a8327d2e89);
		
		DB_Dialogs(S_GOB_AlarmSystem_Entrance_85dd0ba7-5977-4595-b88d-54fea57f396b, GOB_BattleStations_EntranceAlarm_d5eeed6c-f44b-8ee1-8b64-2818cb4d05c4);
		DB_Dialogs(S_GOB_AlarmSystem_Main_A_284c988c-1008-4d2b-9928-1eb776095139, GOB_BattleStations_MainAAlarm_75657648-5fdf-9290-0964-4c62f88795ea);
		DB_Dialogs(S_GOB_AlarmSystem_Main_B_161e3796-a279-4f21-b6ed-0529d800b27c, GOB_BattleStations_MainBAlarm_a6612906-ada8-6515-0d58-71d7007c3aa5);
		DB_Dialogs(S_GOB_AlarmSystem_SpiderPit_1cbe32ed-c45f-4b16-8422-e1447f033464, GOB_BattleStations_SpiderAlarm_92d39b7c-f117-2615-5cc5-ee71dabd1ae7);
		DB_Dialogs(S_GOB_AlarmSystem_Throne_0e9b391e-c4f5-4431-8be7-537c5e99e299, GOB_BattleStations_ThroneAlarm_ae0da422-7c47-6728-f1ab-0eab9a50f5c9);
		DB_Dialogs(S_GOB_AlarmSystem_WolfPens_2d7e1d47-89b0-40fc-8ca4-3f1a09cdcaab, GOB_BattleStations_WolfPenAlarm_01ea8c6c-9f2b-18cf-abff-b002dc5056d2);
		DB_Dialogs(S_GOB_AlarmSystem_Drow_d0b405d2-b103-419b-9a51-f86f3545d47c, GOB_BattleStations_DrowAlarm_890d8eac-5132-1fae-5c7c-a0a8cc73d5cb);
		
		DB_DropMutingStatussesDialog(GOB_BattleStations_EntranceAlarm_d5eeed6c-f44b-8ee1-8b64-2818cb4d05c4);
		DB_DropMutingStatussesDialog(GOB_BattleStations_MainAAlarm_75657648-5fdf-9290-0964-4c62f88795ea);
		DB_DropMutingStatussesDialog(GOB_BattleStations_MainBAlarm_a6612906-ada8-6515-0d58-71d7007c3aa5);
		DB_DropMutingStatussesDialog(GOB_BattleStations_SpiderAlarm_92d39b7c-f117-2615-5cc5-ee71dabd1ae7);
		DB_DropMutingStatussesDialog(GOB_BattleStations_ThroneAlarm_ae0da422-7c47-6728-f1ab-0eab9a50f5c9);
		DB_DropMutingStatussesDialog(GOB_BattleStations_WolfPenAlarm_01ea8c6c-9f2b-18cf-abff-b002dc5056d2);
		DB_DropMutingStatussesDialog(GOB_BattleStations_DrowAlarm_890d8eac-5132-1fae-5c7c-a0a8cc73d5cb);
	}
	KB
	{
		//REGION Alarm setup
		
		IF
		DB_GOB_BattleStations_CombatAlarms(_,_Alarm,_)
		AND
		DB_Dialogs(_Alarm,_Dialog)
		THEN
		DB_FlagReactionAfterDialog(GOB_Battlestations_Event_TearOpenDrum_b68dc5ce-8599-b953-6b94-7ed37f5555a7,_Dialog);
		
		//END_REGION Alarm setup
		
		
		//REGION Alarm Ownership
		
		IF
		DB_GOB_BattleStations_AlarmOwnership(_Trigger)
		THEN
		DB_ItemOwnerShipTriggers("WLD_Main_A", _Trigger, S_GOB_GoblinKing_11337af0-6a57-426b-a820-c4b00923dd54);
		PROC_GOB_BattleStations_RegisterFallbackOwnersForTrigger(_Trigger);
		
		PROC
		PROC_GOB_BattleStations_RegisterFallbackOwnersForTrigger((TRIGGER)_Trigger)
		AND
		DB_GOB_BattleStations_CombatGroupCharacters(_FallbackOwner, _, _)
		AND
		_FallbackOwner != S_GOB_GoblinKing_11337af0-6a57-426b-a820-c4b00923dd54
		THEN
		DB_ItemOwnerShipTriggersFallback(_Trigger, _FallbackOwner);
		
		
		//END_REGION
		
		
		//REGION Vandalizing Alarm
		
		PROC
		PROC_FlagReactionAfterDialog(_Alarm, GOB_Battlestations_Event_TearOpenDrum_b68dc5ce-8599-b953-6b94-7ed37f5555a7)
		AND
		DB_GOB_BattleStations_CombatAlarms(_,(ITEM)_Alarm,_)
		AND
		IsDestroyed((ITEM)_Alarm, 0)
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(_Alarm);
		SetCanInteract(_Alarm, 0);
		Transform(_Alarm, DEC_Goblins_Camp_Drum_A_Broken_A_478a8561-c7ff-41a9-8319-a929a941de2c, DISGUISE_ceccc4eb-d774-4cd5-9147-12322b81b763);
		//PROC_CrimeVandaliseCheckOwner(S_GOB_Checkpoint_AlarmSystem_17ec4677-d265-43b5-99d1-f62b7051b5f2, _Player, _Player, -1);
		
		
		//END_REGION
		
		//REGION NPC defeats
		
		PROC
		PROC_StateSet_Defeated(S_GOB_GoblinKing_11337af0-6a57-426b-a820-c4b00923dd54)
		AND
		NOT DB_GlobalFlag((FLAG)GOB_BattleStations_Event_ToStation_03a8bd66-c23f-4989-9a7b-775cf475104b)
		THEN
		SetFlag(GOB_BattleStations_Event_ToStation_03a8bd66-c23f-4989-9a7b-775cf475104b, NULL_00000000-0000-0000-0000-000000000000, 0);
		PROC_SetRelationToPlayers(ACT1_GOB_WolfPens_7adb52e1-1e4d-5312-3b0e-eb262d0a72e0, 0);
		PROC_SetRelationToPlayers(ACT1_GOB_CheckpointGuards_20cb448e-72b9-d3fe-1567-206038efe6cc, 0);
		PROC_SetRelationToPlayers(ACT1_GOB_CheckpointBackup_ea8f51bb-4fd3-36f9-0674-5c845474b66e, 0);
		PROC_SetRelationToPlayers(ACT1_GOB_ScryingEyes_b9a148f1-9120-4ab0-a8f2-b6d37ff32b43, 0);
		
		PROC
		PROC_StateSet_PermaDefeated((CHARACTER)_Zhentarim)
		AND
		DB_GOB_BattleStations_Zhentarim(_Zhentarim)
		THEN
		NOT DB_GOB_BattleStations_Zhentarim(_Zhentarim);
		
		PROC
		PROC_StateSet_PermaDefeated((CHARACTER)_Character)
		AND
		DB_GOB_BattleStations_CombatGroupCharacters(_Character, _Combat, _Position)
		THEN
		NOT DB_GOB_BattleStations_CombatGroupCharacters(_Character, _Combat, _Position);
		
		PROC
		PROC_StateSet_PermaDefeated((CHARACTER)_Character)
		AND
		DB_GOB_BattleStations_PotentialReinforcements(_Character)
		THEN
		NOT DB_GOB_BattleStations_PotentialReinforcements(_Character);
		
		PROC
		PROC_StateSet_PermaDefeated((CHARACTER)_Character)
		AND
		DB_GOB_BattleStations_CombatGroupCharacters(_Character, _Group, _)
		AND
		DB_GlobalFlag((FLAG)GOB_BattleStations_Event_ToStation_03a8bd66-c23f-4989-9a7b-775cf475104b)
		AND
		DB_GOB_BattleStations_CombatGroupAreas(_Group, _Area)
		THEN
		TriggerUnregisterForCharacter(_Area, _Character);
		
		//END_REGION
		
		
		//REGION Alarm triggering
		IF
		DB_GOB_BattleStations_AlarmCharacters(_Character)
		AND
		DB_GOB_BattleStations_CombatAlarms(_Area, _, _)
		THEN
		TriggerRegisterForCharacter(_Area, _Character);
		
		//Fire alarm if state not proc'd.
		
		// first round - CombatRoundStarted might happen BEFORE DB_Is_InCombat is filled, using DB_CombatStarted instead
		IF
		DB_CombatStarted(_ID)
		AND
		NOT DB_GlobalFlag(GOB_BattleStations_Event_ToStation_03a8bd66-c23f-4989-9a7b-775cf475104b)
		AND
		NOT DB_GOB_BattleStations_AlarmFight(_ID)
		AND
		DB_GOB_BattleStations_AlarmCharacters((CHARACTER)_Character)
		AND
		DB_Is_InCombat(_Character, _ID)
		AND
		QRY_GOB_BattleStations_CheckPlayerHostility((GUIDSTRING)_ID)
		THEN
		PROC_GOB_BattleStations_DefineAlarmNPC(_Character, _ID);
		
		//second round and rounds after
		IF
		CombatRoundStarted(_ID, _)
		AND
		DB_CombatStarted(_ID)
		AND
		NOT DB_GlobalFlag(GOB_BattleStations_Event_ToStation_03a8bd66-c23f-4989-9a7b-775cf475104b)
		AND
		NOT DB_GOB_BattleStations_AlarmFight(_ID)
		AND
		DB_GOB_BattleStations_AlarmCharacters((CHARACTER)_Character)
		AND
		DB_Is_InCombat(_Character, _ID)
		AND
		QRY_GOB_BattleStations_CheckPlayerHostility((GUIDSTRING)_ID)
		THEN
		PROC_GOB_BattleStations_DefineAlarmNPC(_Character, _ID);
		
		QRY
		QRY_GOB_BattleStations_CheckPlayerHostility((GUIDSTRING)_ID)
		AND
		DB_Is_InCombat(_Player, _ID)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		DB_Is_InCombat(_OtherChar, _ID)
		AND
		NOT DB_Players((CHARACTER)_OtherChar)
		AND
		NOT DB_GOB_GiantSpiders(_OtherChar, _)
		AND
		IsEnemy(_OtherChar, _Player, 1)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_GOB_BattleStations_DefineAlarmNPC((CHARACTER)_Character, (GUIDSTRING)_ID)
		AND
		DB_GOB_BattleStations_CombatAlarms(_Area, _Alarm, _UsePos)
		AND
		NOT DB_Destroyed(_Alarm)
		AND
		DB_InRegion(_Character, _Area)
		AND
		NOT DB_GOB_BattleStations_AlarmFight(_ID)
		AND
		GetFlag(GOB_Battlestations_Event_TearOpenDrum_b68dc5ce-8599-b953-6b94-7ed37f5555a7, _Alarm, 0)
		THEN
		DB_GOB_BattleStations_AlarmFight(_ID);
		SetDualEntityEvent(_Character, _UsePos, "GOB_BattleStations_GoToAlarmPos");
		SetDualEntityEvent(_Character, _Alarm, "GOB_BattleStations_GoTriggerAlarm");
		
		IF
		CombatEnded(_ID)
		AND
		DB_GOB_BattleStations_AlarmFight(_ID)
		THEN
		NOT DB_GOB_BattleStations_AlarmFight(_ID);
		
		IF
		EntityEvent((ITEM)_Alarm, "GOB_BattleStations_StrikingDrum")
		AND
		DB_GOB_BattleStations_CombatAlarms(_, _Alarm, _)
		THEN
		SetFlag(GOB_BattleStations_Event_ToStation_03a8bd66-c23f-4989-9a7b-775cf475104b, NULL_00000000-0000-0000-0000-000000000000, 0);
		DB_GOB_BattleStations_ReinforceAlarm(_Alarm);
		
		IF
		FlagSet(GOB_BattleStations_Event_ToStation_03a8bd66-c23f-4989-9a7b-775cf475104b, _, _)
		AND
		DB_GOB_BattleStations_AlarmCharacters(_Character)
		AND
		DB_GOB_BattleStations_CombatAlarms(_Area, _, _)
		THEN
		TriggerUnregisterForCharacter(_Area, _Character);
		
		//END_REGION
		
		//REGION Battlestations state
		
		IF
		FlagSet(GOB_BattleStations_Event_ToStation_03a8bd66-c23f-4989-9a7b-775cf475104b, _, _)
		THEN
		PROC_GOB_BattleStations_Start();
		
		PROC
		PROC_GOB_BattleStations_Start()
		AND
		DB_GOB_BattleStations_CombatGroupCharacters(_Character, _, _)
		AND
		NOT DB_Is_InCombat(_Character, _)
		THEN
		SetCombatGroupID(_Character, "");
		FlushOsirisQueue(_Character);
		PROC_ForceStopDialog(_Character);
		PROC_RemoveAllDialogEntriesForSpeaker(_Character);
		
		PROC
		PROC_GOB_BattleStations_Start()
		AND
		DB_GOB_BattleStations_ReinforceAlarm(_Alarm)
		AND
		DB_GOB_BattleStations_PotentialReinforcements(_Character)
		AND
		SysCount("DB_GOB_BattleStations_ActualReinforcements", 1, _Count)
		AND
		_Count <= 3
		THEN
		DB_GOB_BattleStations_ActualReinforcements(_Character);
		
		IF
		DB_GOB_BattleStations_ActualReinforcements(_Character)
		AND
		DB_GOB_BattleStations_ReinforceAlarm(_Alarm)
		THEN
		SetDualEntityEvent(_Character, _Alarm, "GOB_BattleStations_GoReinforce");
		PROC_CharacterMoveTo(_Character, _Alarm, "Run", "");
		
		PROC
		PROC_GOB_BattleStations_Start()
		AND
		DB_GOB_BattleStations_Zhentarim(_Character)
		THEN
		PROC_DisappearOutOfSightTo(_Character,S_GOB_DrowLeavePos_d3fc3f03-0cf7-4f1d-930c-247ac08d654f,"Run",0,"GOB_BattleStations_ZhentarimFled");
		PROC_ForceStopDialog(_Character);
		
		IF
		EntityEvent(_Character,"GOB_BattleStations_ZhentarimFled")
		AND
		DB_GOB_BattleStations_Zhentarim((CHARACTER)_Character)
		THEN
		NOT DB_GOB_BattleStations_Zhentarim((CHARACTER)_Character);
		
		IF
		LeftLevel(_Character,"WLD_Main_A")
		AND
		DB_GOB_BattleStations_Zhentarim((CHARACTER)_Character)
		THEN
		NOT DB_GOB_BattleStations_Zhentarim((CHARACTER)_Character);
		
		PROC
		PROC_GOB_BattleStations_Start()
		AND
		DB_GOB_BattleStations_CombatGroupCharacters(_Character, _, _Position)
		AND
		_Position != NULL_00000000-0000-0000-0000-000000000000
		THEN
		PROC_CharacterMoveTo(_Character, _Position, "Run", "GOB_BattleStations_AtGuardPos");
		
		//Initialize patrols of characters with a patrol. (No position means there is a patrol)
		PROC
		PROC_GOB_BattleStations_Start()
		AND
		DB_GOB_BattleStations_CombatGroupCharacters(_Character, _, NULL_00000000-0000-0000-0000-000000000000)
		THEN
		SetEntityEvent(_Character, "GOB_BattlesStations_GoToStation");
		
		PROC
		PROC_GOB_BattleStations_Start()
		AND
		DB_GOB_BattleStations_CombatGroupCharacters(_Character, _Group, _)
		AND
		DB_GOB_BattleStations_CombatGroupAreas(_Group, _Area)
		THEN
		TriggerRegisterForCharacter(_Area, _Character);
		
		PROC
		PROC_GOB_BattleStations_Start()
		AND
		DB_GOB_BattleStations_Zhentarim(_)
		THEN
		Unlock(S_GOB_Storeroom_Door_c1b87294-c969-4c7c-8324-55ecd460a1c3);
		
		PROC
		PROC_GOB_BattleStations_Start()
		AND
		DB_GOB_BattleStations_CombatGroupCharacters(_Character, _, _)
		AND
		NOT DB_GOB_SpiderNest_VictimFactions(_Character,_) 
		AND
		NOT DB_GOB_BattleStations_Zhentarim(_Character)
		THEN
		SetFaction(_Character, ACT1_GOB_BattleStations_55f55a92-c2bf-4d69-a9aa-03f1178e5812);
		
		PROC
		PROC_GOB_BattleStations_Start()
		THEN
		DB_GOB_BattleStations_Active(1);
		
		// All battlestation characters are hostile in this case, so warning about crime reactions
		// on looting/stealing makes no sense anymore
		QRY
		QRY_CorpseLooting_BlockMakeOwned((CHARACTER)_Character)
		AND
		DB_GOB_BattleStations_Active(1)
		AND
		DB_GOB_BattleStations_CombatGroupCharacters(_Character, _, _)
		THEN
		DB_NOOP(1);
		
		
		IF
		EntityEvent((CHARACTER)_Zhentarim, "GOB_BattleStations_AtGuardPos")
		AND
		DB_GOB_BattleStations_Zhentarim(_Zhentarim)
		THEN
		NOT DB_GOB_BattleStations_Zhentarim(_Zhentarim);
		
		IF
		DB_GlobalFlag(GOB_BattleStations_Event_ToStation_03a8bd66-c23f-4989-9a7b-775cf475104b)
		AND
		NOT DB_GOB_BattleStations_Zhentarim(_)
		AND
		IsOpened(S_GOB_Storeroom_Door_c1b87294-c969-4c7c-8324-55ecd460a1c3, 1)
		THEN
		Close(S_GOB_Storeroom_Door_c1b87294-c969-4c7c-8324-55ecd460a1c3);
		Lock(S_GOB_Storeroom_Door_c1b87294-c969-4c7c-8324-55ecd460a1c3, "GOB_STOREROOM");
		
		//END_REGION
		
		//REGION Battlestations combat groups
		
		IF
		EnteredTrigger(_Character, _Area)
		AND
		DB_GOB_BattleStations_CombatGroupAreas(_Group, _Area)
		AND
		DB_GlobalFlag(GOB_BattleStations_Event_ToStation_03a8bd66-c23f-4989-9a7b-775cf475104b)
		AND
		DB_GOB_BattleStations_CombatGroupCharacters(_Character, _Group, _)
		THEN
		SetCombatGroupID(_Character, _Group);
		
		IF
		LeftTrigger(_Character, _Area)
		AND
		DB_GOB_BattleStations_CombatGroupAreas(_Group, _Area)
		AND
		DB_GlobalFlag(GOB_BattleStations_Event_ToStation_03a8bd66-c23f-4989-9a7b-775cf475104b)
		AND
		DB_GOB_BattleStations_CombatGroupCharacters(_Character, _Group, _)
		THEN
		SetCombatGroupID(_Character, "");
		
		IF
		TextEvent("startbattlestations")
		THEN
		SetFlag(GOB_BattleStations_Event_ToStation_03a8bd66-c23f-4989-9a7b-775cf475104b, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		//END_REGION
		
		//REGION War Drums
		PROC
		PROC_BlockUseOfItem(_Player, _WarDrum)
		AND
		DB_GOB_BattleStations_CombatAlarms(_, _WarDrum, _)
		AND
		DB_Players(_Player)
		AND
		HasActiveStatus(_WarDrum, "SILENCED", 1)
		THEN
		DB_CustomUseItemResponse(_Player, _WarDrum, 0);
		PROC_PlayCantUseItemAD(_Player);
		//END_REGION War Drums
	}
	EXIT
	{
	}
}
Goal(166).Title("Act1_GOB_Bravado");
Goal(166)
{
	INIT
	{
		DB_Dialogs(S_GOB_Bravado_Goblin_001_0ee08ad4-329e-40c1-a40b-a74e74c39055, (DIALOGRESOURCE)GOB_Bravado_Goblin_001_6c73e43a-e10a-4a5e-a4bd-82ba49b8ad09);
		DB_Dialogs(S_GOB_Bravado_Goblin_002_02291a93-e5d6-40f2-8cd0-f5edad8f4b6d, (DIALOGRESOURCE)GOB_Bravado_Goblin_002_5b97297e-bd88-1575-d90a-3171ae89704c);
		DB_Dialogs(S_GOB_Bravado_Goblin_003_6ca1d4f0-59fd-4c7f-9d07-bb158eef2246, (DIALOGRESOURCE)GOB_Bravado_Goblin_003_6bd7f2f8-088b-58ba-9978-598680620551);
		
		DB_Inclusion_Object(S_GOB_Bravado_Goblin_002_02291a93-e5d6-40f2-8cd0-f5edad8f4b6d, (FLAG)GOB_Bravado_Goblin002_StartInclusion_dba8b353-de8c-4447-a106-0d3ffba4dcb7, (FLAG)GOB_Bravado_Goblin002_EndInclusion_a1e1e216-f96e-47d8-a378-84bc3c90b8fa);
		DB_Inclusion_Object(S_GOB_Bravado_Goblin_003_6ca1d4f0-59fd-4c7f-9d07-bb158eef2246, (FLAG)GOB_Bravado_Goblin003_StartInclusion_b5435143-535a-4437-b53e-5015294606cc, (FLAG)GOB_Bravado_Goblin003_EndInclusion_63d653d4-dfd2-4a08-88a0-01cbf22bbe76);
	}
	KB
	{
		QRY
		QRY_SelectCustomDialog(S_GOB_Bravado_Goblin_002_02291a93-e5d6-40f2-8cd0-f5edad8f4b6d, _Player)
		AND
		NOT DB_GOB_Bravado_IntroHappened(1)
		THEN
		DB_SelectedDialog((DIALOGRESOURCE)GOB_Bravado_Goblin_001_6c73e43a-e10a-4a5e-a4bd-82ba49b8ad09, S_GOB_Bravado_Goblin_001_0ee08ad4-329e-40c1-a40b-a74e74c39055, NULL_00000000-0000-0000-0000-000000000000, _Player);
		
		QRY
		QRY_SelectCustomDialog(S_GOB_Bravado_Goblin_003_02291a93-e5d6-40f2-8cd0-f5edad8f4b6d, _Player)
		AND
		NOT DB_GOB_Bravado_IntroHappened(1)
		THEN
		DB_SelectedDialog((DIALOGRESOURCE)GOB_Bravado_Goblin_001_6c73e43a-e10a-4a5e-a4bd-82ba49b8ad09, S_GOB_Bravado_Goblin_001_0ee08ad4-329e-40c1-a40b-a74e74c39055, NULL_00000000-0000-0000-0000-000000000000, _Player);
		
		IF
		DialogEnded((DIALOGRESOURCE)GOB_Bravado_Goblin_001_6c73e43a-e10a-4a5e-a4bd-82ba49b8ad09, _)
		THEN
		DB_GOB_Bravado_IntroHappened(1);
	}
	EXIT
	{
	}
}
Goal(167).Title("Act1_GOB_Checkpoint");
Goal(167)
{
	INIT
	{
