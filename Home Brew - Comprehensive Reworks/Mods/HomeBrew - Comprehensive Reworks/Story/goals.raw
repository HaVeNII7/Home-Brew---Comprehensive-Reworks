		THEN
		DebugText(_Char, "BTDuelStatusRemove");
		PROC_LOW_BhaalTemple_Duel_DarkUrgeFaction_RemoveStatus();
		
		IF
		TextEvent("BTTryBreakDuelAD")
		AND
		GetHostCharacter(_Char)
		THEN
