		DB_GLO_MonkAmuletBanters((TRIGGER)S_CRE_MonkAmulet_StatueBanter_f83fe070-3bae-4996-a349-7e14f0a0573a, (DIALOGRESOURCE)CRE_MonkAmulet_AD_StatueBanter_f45d64a0-7ef1-c1e2-eda6-9664ba68f8f0);
		DB_GLO_MonkAmuletBanters((TRIGGER)S_CRE_MonkAmulet_BloodOfLathanderBanter_4e40660b-9ea9-4716-9379-a521f333a920, (DIALOGRESOURCE)CRE_MonkAmulet_AD_BloodOfLathanderBanter_2b192208-43cb-8542-810b-7c1497f5cd39);
