		DB_CampNight_Requirement((FLAG)NIGHT_ShadowHeart_WildMagic_5ce39313-f4bc-4aba-a51e-bfb9cd9ecfd1,(FLAG)SHADOWHEARTCOMPANION_09baaab1-c743-44d5-84e4-1915165b9935);
		DB_CampNight_CancelledBy((FLAG)NIGHT_ShadowHeart_WildMagic_5ce39313-f4bc-4aba-a51e-bfb9cd9ecfd1,(FLAG)ORI_Shadowheart_Knows_IncurableWound_bf04e5f1-0add-4b21-a3ec-be25a73bfe92);
		DB_CampNight_CancelledBy((FLAG)NIGHT_ShadowHeart_WildMagic_5ce39313-f4bc-4aba-a51e-bfb9cd9ecfd1,(FLAG)ORI_Shadowheart_Knows_WoundSuspicion_3ecd2181-fdd0-4314-b0bf-fbe2aafdef87);
		DB_CampNight_CRD((FLAG)NIGHT_ShadowHeart_WildMagic_5ce39313-f4bc-4aba-a51e-bfb9cd9ecfd1, (CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679, (DIALOGRESOURCE)CAMP_Shadowheart_CRD_WildMagic_302972f7-dc79-5f24-68c4-c0d9cccc31b1, NULL_00000000-0000-0000-0000-000000000000);
		
		
		//NIGHT_Shadowheart_Box
		DB_CampNight((FLAG)NIGHT_ShadowHeart_Box_2de162ec-4272-4750-945f-9d306c5ba0da,2010 /*3010 for avatar*/,(CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679);
		DB_CampNight_Camp((FLAG)NIGHT_ShadowHeart_Box_2de162ec-4272-4750-945f-9d306c5ba0da,"WLDMAIN");
		DB_CampNight_Camp((FLAG)NIGHT_ShadowHeart_Box_2de162ec-4272-4750-945f-9d306c5ba0da,"WLDCAVGRN");
		DB_CampNight_Camp((FLAG)NIGHT_ShadowHeart_Box_2de162ec-4272-4750-945f-9d306c5ba0da,"WLDCAVSND");
		DB_CampNight_Camp((FLAG)NIGHT_ShadowHeart_Box_2de162ec-4272-4750-945f-9d306c5ba0da,"WLDDUNABB");
		DB_CampNight_Camp((FLAG)NIGHT_ShadowHeart_Box_2de162ec-4272-4750-945f-9d306c5ba0da,"WLDDUNSHA");
		DB_CampNight_Camp((FLAG)NIGHT_ShadowHeart_Box_2de162ec-4272-4750-945f-9d306c5ba0da,"WLDUND");
		DB_CampNight_Camp((FLAG)NIGHT_ShadowHeart_Box_2de162ec-4272-4750-945f-9d306c5ba0da,"WLDBAS");
		DB_CampNight_Requirement((FLAG)NIGHT_ShadowHeart_Box_2de162ec-4272-4750-945f-9d306c5ba0da,(FLAG)NIGHT_ShadowHeart_WildMagic_5ce39313-f4bc-4aba-a51e-bfb9cd9ecfd1,(FLAG)SHADOWHEARTPARTY_88397c7c-b031-4cf8-be14-0fa976c85542);
		DB_CampNight_IVB((FLAG)NIGHT_ShadowHeart_Box_2de162ec-4272-4750-945f-9d306c5ba0da,(VOICEBARKRESOURCE)CAMP_Shadowheart_IVB_Box_ce9f8c2c-cc55-5bb8-f4e2-1d408611f054,(CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679);
		DB_CampNight_CancelledBy((FLAG)NIGHT_ShadowHeart_Box_2de162ec-4272-4750-945f-9d306c5ba0da,(FLAG)GOB_Orpheus_State_HadVoiceOfAbsoluteEvent_9546407d-19e3-4f26-88af-5970896997d7);
		//END_REGION
	}
	KB
	{
		IF
		LevelLoaded("WLD_Main_A")
		THEN
		SetFlag((FLAG)CURRENTREGION_WLD_Main_A_797d21c8-b2a9-4c86-a1e4-8ca3833a32ef,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_GlobalSetFlagAndCache((FLAG)VISITEDREGION_WLD_Main_A_925c721d-686b-4fbe-8c3c-d1233bf863b7);
		
		IF
		LevelUnloading("WLD_Main_A")
		THEN
		ClearFlag((FLAG)CURRENTREGION_WLD_Main_A_797d21c8-b2a9-4c86-a1e4-8ca3833a32ef,NULL_00000000-0000-0000-0000-000000000000,0);
		
		IF
		EnteredTrigger(_,(TRIGGER)S_FOR_AreaTrigger_1bdea0df-2dcc-4190-bfa0-b812ad96dbf1)
		THEN
		PROC_IncreaseCampQuality(2);
		
		//REGION Teleport NPC to camp for campfiremoment
		PROC
		PROC_CampfireMoment_PreDialog(_CFMDiag)
		AND
		DB_CampfireMoment_FixedSpeakers((DIALOGRESOURCE)_CFMDiag, _FixedSpeaker)
		AND
		DB_CampfireMoments_TeleportFixedSpeaker(_FixedSpeaker)
		AND
		DB_CurrentLevel(_Region)
		AND
		DB_Daisy_IdleTeleport(_Region,_TeleportPosition)
		THEN
		PROC_Poof(_FixedSpeaker, VFX_Script_Stub_Poof_01_NoSound_de020641-4dbd-855e-9b2f-f008a32d6737);
		TeleportTo(_FixedSpeaker,_TeleportPosition);
		PROC_Foop(_FixedSpeaker, VFX_Script_Stub_Poof_01_NoSound_de020641-4dbd-855e-9b2f-f008a32d6737);
		DB_CampfireMoment_ActiveDialog(_CFMDiag, _FixedSpeaker);
		
		PROC
		PROC_CampfireMoment_PostDialog((DIALOGRESOURCE)_CFMDiag)
		AND
		DB_CampfireMoment_ActiveDialog(_CFMDiag, _FixedSpeaker)
		THEN
		PROC_SetOnStage(_FixedSpeaker, 0);
		NOT DB_CampfireMoment_ActiveDialog(_CFMDiag, _FixedSpeaker);
		//END_REGION
		
		//REGION Reminder to sleep if people havent rested
		IF
		LeftCombat(_Player,_)
		AND
		NOT DB_OnlyOnce("CAMP_RestReminder_PlayedVoiceBark")
		AND
		DB_Players((CHARACTER)_Player)
		AND
		NOT DB_Defeated(_Player)
		THEN
		PROC_ObjectCountHelper(_Player,"CAMP_RestReminder_Counter");
		
		PROC
		PROC_LongRest()
		AND
		NOT DB_OnlyOnce("CAMP_RestReminder_PlayedVoiceBark")
		AND
		DB_Players(_Player)
		THEN
		PROC_ObjectCountHelperReset(_Player,"CAMP_RestReminder_Counter");
		ObjectTimerCancel(_Player,"CAMP_RestReminder_Timer");
		
		IF
		DB_ObjectCountHelper(_Player,"CAMP_RestReminder_Counter",_Any)
		AND
		NOT DB_Players((CHARACTER)_Player)
		THEN
		NOT DB_ObjectCountHelper(_Player,"CAMP_RestReminder_Counter",_Any);
		ObjectTimerCancel(_Player,"CAMP_RestReminder_Timer");
		
		IF
		DB_ObjectCountHelper(_Player,"CAMP_RestReminder_Counter",3)
		THEN
		ObjectTimerLaunch(_Player,"CAMP_RestReminder_Timer",30000,1);
		
		IF
		ObjectTimerFinished(_Player,"CAMP_RestReminder_Timer")
		AND
		NOT QRY_CAMP_RestReminder_StartVB((CHARACTER)_Player)
		THEN
		ObjectTimerLaunch(_Player,"CAMP_RestReminder_Timer",30000,1);
		
		QRY
		QRY_CAMP_RestReminder_StartVB((CHARACTER)_Player)
		AND
		NOT DB_CantTalk(_Player)
		AND
		NOT QRY_Camp_IsPlayerBlockedFromTeleportToCamp(_Player, 0)
		AND
		QRY_OnlyOnce("CAMP_RestReminder_PlayedVoiceBark")
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)CAMP_RestReminder_VB_94b130ed-dfc5-3fab-7346-a15ab10ff898,(CHARACTER)_Player);
		
		IF 
		VoiceBarkEnded((VOICEBARKRESOURCE)CAMP_RestReminder_VB_94b130ed-dfc5-3fab-7346-a15ab10ff898,_)
		THEN
		PROC_CAMP_ResetRestReminder();
		
		IF
		VoiceBarkFailed((VOICEBARKRESOURCE)CAMP_RestReminder_VB_94b130ed-dfc5-3fab-7346-a15ab10ff898)
		THEN
		PROC_CAMP_ResetRestReminder();
		
		PROC
		PROC_CAMP_ResetRestReminder()
		THEN
		NOT DB_OnlyOnce("CAMP_RestReminder_PlayedVoiceBark");
		
		PROC
		PROC_CAMP_ResetRestReminder()
		AND
		DB_Players(_Player)
		THEN
		PROC_ObjectCountHelperReset(_Player,"CAMP_RestReminder_Counter");
		ObjectTimerCancel(_Player,"CAMP_RestReminder_Timer");
		//END_REGION
		
		//REGION Camp Night Behaviours
		IF
		DB_HandlingRelationshipDialog(_Character, _CRD, NULL_00000000-0000-0000-0000-000000000000, "CAMP",_, _)
		THEN
		SetEntityEventDialog(_Character, "NightInProgress", _CRD);
		//END_REGION
		
		//REGION Specific Night Logic - FirstNightContemplation
		//If not done on the first night, skip it.
		PROC
		PROC_LongRest()
		THEN
		PROC_CampNight_ClearCampNight((FLAG)NIGHT_FirstNightContemplation_9e5cfbe2-f4f3-4249-a1b7-142a7899277a);
		//END_REGION
		
		//REGION Specific Night Logic - Ceremorphosis1
		//Shadowheart responds after talking to someone else first.
		IF
		DialogEnded(_Ceremorphosis1CRD,_)
		AND
		DB_CampNight_CRD((FLAG)NIGHT_Ceremorphosis1_98059567-b62a-4db8-9ce4-d39c792e0238,_Companion,_Ceremorphosis1CRD,_)
		AND
		_Ceremorphosis1CRD != CAMP_Night1_CRD_Shadowheart_04e27ea1-5c2b-46c5-fcfe-ab88d27ab91d
		AND
		DB_HandlingRelationshipDialog((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,(DIALOGRESOURCE)CAMP_Night1_CRD_Shadowheart_04e27ea1-5c2b-46c5-fcfe-ab88d27ab91d, NULL_00000000-0000-0000-0000-000000000000,"CAMP",_, _)
		AND
		NOT DB_LoopEffect((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679, _,"RelationshipMarker",_,_,_,_)
		AND
		QRY_OnlyOnce("CAMP_Night1_CRD_Shadowheart_Jealous")
		THEN
		PROC_ExclamationMark_Show(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679);
		//END_REGION
		
		//REGION Specific Night Logic - Ceremorphosis2
		PROC
		PROC_Try_CampRelationshipDialog((CHARACTER)_Camper,1)
		AND
		_Camper != S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604
		AND
		DB_Camp_QueuedNight((FLAG)NIGHT_Ceremorphosis2_485f589f-0da1-4eea-9a28-210f91837a69)
		AND
		DB_HandlingRelationshipDialog(_Camper,_Dialog, NULL_00000000-0000-0000-0000-000000000000,"CAMP",_, _)
		AND
		DB_PlayerInCamp(_Player)
		AND
		DB_Avatars(_Player)
		AND
		NOT DB_CantTalk(_Player)
		AND
		QRY_StartDialog_Fixed(_Dialog, _Camper, _Player)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_DialogFlagSetup(CAMP_Night2_CRD_Gale_adae2da4-11a7-2966-db5a-8342d8e64e15, _, _, _)
		THEN
		DB_DoNotFace(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604);
		DB_DoNotFace(S_ORI_GaleDouble_ddf3dd37-fa65-4351-9f55-e50b1211fcfe);
		
		IF
		DialogEnded(CAMP_Night2_CRD_Gale_adae2da4-11a7-2966-db5a-8342d8e64e15, _)
		THEN
		NOT DB_DoNotFace(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604);
		NOT DB_DoNotFace(S_ORI_GaleDouble_ddf3dd37-fa65-4351-9f55-e50b1211fcfe);
		
		
		//END_REGION
		
		//REGION Specific Night Logic - AstarionHungerA
		QRY
		QRY_Camp_SleepCutsceneOverride_CustomDialogStart((DIALOGRESOURCE)CAMP_AstarionHunger_IVB_SCO_Avatar_Choice_731b7b80-cbc9-9db4-dcc7-3e92b9c5087c,(CHARACTER)_Player,(CHARACTER)_Player2,(CHARACTER)_Player3,(CHARACTER)_Player4)
		THEN
		PROC_AstarionHungerA_TagCandidate(_Player);
		PROC_AstarionHungerA_TagCandidate(_Player2);
		PROC_AstarionHungerA_TagCandidate(_Player3);
		PROC_AstarionHungerA_TagCandidate(_Player4);
		PROC_CampfireMoment_PreDialog((DIALOGRESOURCE)CAMP_AstarionHunger_SCO_Avatar_Dream_d1459343-4983-96bb-d19c-faccaca636e4);
		PROC_CampfireMoment_Dialog((DIALOGRESOURCE)CAMP_AstarionHunger_SCO_Avatar_Dream_d1459343-4983-96bb-d19c-faccaca636e4);
		
		PROC
		PROC_AstarionHungerA_TagCandidate((CHARACTER)_Player)
		AND
		_Player != NULL_00000000-0000-0000-0000-000000000000
		AND
		_Player != S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255
		THEN
		SetTag(_Player,(TAG)ASTARIONHUNGER_CANDIDATE_bd4e9140-4749-42d2-82b5-235b288c88a3);
		DB_AstarionHunger_CandidateTagged(_Player);
		
		IF
		DialogEnded((DIALOGRESOURCE)CAMP_AstarionHunger_SCO_Avatar_Dream_d1459343-4983-96bb-d19c-faccaca636e4,_)
		THEN
		SetFlag((FLAG)ORI_Astarion_State_FirstDreamEnded_872b076a-0475-4184-a756-b3a0c9d872ae);
		PROC_SetOnStage((CHARACTER)S_GLO_Cazador_2f1880e6-1297-4ca3-a79c-9fabc7f179d3, 0);
		PROC_CampfireMoment_ClearCampfireMoment((DIALOGRESOURCE)CAMP_AstarionHunger_SCO_Avatar_Dream_d1459343-4983-96bb-d19c-faccaca636e4);
		PROC_CampfireMoment_PostDialog((DIALOGRESOURCE)CAMP_AstarionHunger_SCO_Avatar_Dream_d1459343-4983-96bb-d19c-faccaca636e4);
		StartInteractiveVoiceBark((VOICEBARKRESOURCE)CAMP_AstarionHunger_IVB_Avatar_Choice_ea5b622d-9fde-8a24-3250-b8c88df33f19,S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255);
		
		//Not relying on DB_DialogPlayers since some players may have been killed in the dialogue etc.
		IF
		DialogEnded((DIALOGRESOURCE)CAMP_AstarionHunger_SCO_Avatar_Dream_d1459343-4983-96bb-d19c-faccaca636e4,_)
		AND
		DB_AstarionHunger_CandidateTagged(_Player)
		THEN
		ClearTag(_Player,(TAG)ASTARIONHUNGER_CANDIDATE_bd4e9140-4749-42d2-82b5-235b288c88a3);
		NOT DB_AstarionHunger_CandidateTagged(_Player);
		
		IF
		TextEvent("hungera")
		THEN
		StartInteractiveVoiceBark((VOICEBARKRESOURCE)CAMP_AstarionHunger_IVB_Avatar_Choice_ea5b622d-9fde-8a24-3250-b8c88df33f19,S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255);
		SetFlag(NIGHT_AstarionHungerA_ec01fb84-d9ef-47b6-8b32-6620edd67d50);
		
		IF
		FlagSet(_SmallFeedFlag,NULL_00000000-0000-0000-0000-000000000000,_)
		AND
		DB_Camp_AstarionHungerA_SmallFeedFlag(_SmallFeedFlag)
		AND
		DB_Players(_Victim)
		AND
		GetFlag((FLAG)CAMP_Astarion_TheHungerA_BiteSpeaker_5b187157-60fd-a217-e4a8-9b1911e71850,_Victim,1)
		AND
		_Victim != S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604 // Gale's blood is not suitable for Astarion
		THEN
		DB_Camp_AstarionBite_VictimForWeakStatus((CHARACTER)_Victim);
		
		IF
		FlagSet((FLAG)CAMP_Astarion_TheHungerA_Drain_cb67cffc-791b-c790-3a79-6c3d68ce3609,NULL_00000000-0000-0000-0000-000000000000,_)
		AND
		DB_Players(_Victim)
		AND
		GetFlag((FLAG)CAMP_Astarion_TheHungerA_BiteSpeaker_5b187157-60fd-a217-e4a8-9b1911e71850,_Victim,1)
		THEN
		SetFlag((FLAG)GLO_Companion_Murder_2b416989-93e2-4853-b48a-7aeed3e69f7c, _Victim, 0); // we want to trigger all generic camp stuff when the flag is set
		ClearFlag((FLAG)GLO_Companion_Murder_2b416989-93e2-4853-b48a-7aeed3e69f7c, _Victim, 0); // but we don't want to wait till the end of the dialog to murder the companion
		DB_OriginMayLeaveDialog(_Victim, (DIALOGRESOURCE)CAMP_AstarionHunger_IVB_SCO_Avatar_Choice_731b7b80-cbc9-9db4-dcc7-3e92b9c5087c);
		DB_DialogDeath(_Victim);
		PROC_Origins_CompanionLeavePermanently(_Victim, "CompanionMurdered");
		PROC_ClearOriginLeavingDialogs(_Victim);
		PROC_DieImmediate(_Victim, DEATHTYPE.DoT, 1);
		DB_Origin_DontMakeCorpseOwned(_Victim);
		DB_Camp_StayInCampAfterLongRest(1); //prevent leaving camp
		DB_CAMP_Astarion_BiteSceneMurderVictim(_Victim);
		DB_CAMP_Astarion_ClearVictimBlood((CHARACTER)_Victim);
		
		
		//play VB on wakeup
		PROC
		PROC_CampNight_StartMorningMoments()
		AND
		DB_CAMP_Astarion_BiteSceneMurderVictim(_Victim)
		AND
		_Victim != S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255
		AND
		GetClosestAlivePlayer(_Victim,_Player,_Dist)
		AND
		_Dist < 20.0
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)CAMP_AstarionHunger_VB_AftermathAvatarKilled_9cc0573e-cae6-1b37-426e-805b8b638339,_Player);
		
		PROC
		PROC_CampNight_StartMorningMoments()
		AND
		DB_CAMP_Astarion_BiteSceneMurderVictim(_Victim)
		THEN
		NOT DB_CAMP_Astarion_BiteSceneMurderVictim(_Victim);
		
		IF
		FlagSet((FLAG)CAMP_Astarion_TheHungerA_HalfDrain_3f739f8d-d423-5020-eaf0-6f478b8cb1be,NULL_00000000-0000-0000-0000-000000000000,_)
		AND
		DB_Players(_Victim)
		AND
		GetFlag((FLAG)CAMP_Astarion_TheHungerA_BiteSpeaker_5b187157-60fd-a217-e4a8-9b1911e71850,_Victim,1)
		THEN
		DB_Camp_AvatarAstarionStealthBitPartymember(_Victim);
		
		IF
		FlagSet((FLAG)CAMP_Astarion_TheHungerA_BadDream_27d97b60-0e42-bb16-0606-803c17345576,NULL_00000000-0000-0000-0000-000000000000,_)
		AND
		DB_Players(_Victim)
		AND
		GetFlag((FLAG)CAMP_Astarion_TheHungerA_BiteSpeaker_5b187157-60fd-a217-e4a8-9b1911e71850,_Victim,1)
		THEN
		DB_Camp_AvatarAstarionStealthBitPartymember(_Victim);
		
		//play PAD on wakeup
		PROC
		PROC_CampNight_StartMorningMoments()
		AND
		DB_Camp_AvatarAstarionStealthBitPartymember(_Victim)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)CAMP_AstarionHunger_PAD_AftermathAvatarStealthDrain_775dcb4b-b054-c8b3-6154-958498252cab,_Victim);
		NOT DB_Camp_AvatarAstarionStealthBitPartymember(_Victim);
		
		IF
		FlagSet((FLAG)CAMP_Astarion_TheHungerA_LeaveParty_cc3d051f-c334-f432-e618-5e0de55924bf,_Victim,_)
		AND
		DB_Camp_AstarionHungerA_CompanionLeftFlag((CHARACTER)_Victim,_Flag)
		THEN
		SetFlag(_Flag,NULL_00000000-0000-0000-0000-000000000000,0);
		DB_OriginMayLeaveDialog(_Victim,(DIALOGRESOURCE)CAMP_AstarionHunger_IVB_SCO_Avatar_Choice_731b7b80-cbc9-9db4-dcc7-3e92b9c5087c);
		DB_Camp_AvatarAstarionBiteFailCompanionLeft(_Victim);
		
		//play VB on wakeup
		PROC
		PROC_CampNight_StartMorningMoments()
		AND
		DB_Camp_AvatarAstarionBiteFailCompanionLeft(_Victim)
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)CAMP_AstarionHunger_VB_AftermathAvatarCompanionLeft_c469123a-473a-af71-bf96-97c4dc5cb1f4,(CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255);
		NOT DB_Camp_AvatarAstarionBiteFailCompanionLeft(_Victim);
		//END_REGION
		
		//REGION Specific Night Logic - AstarionHungerC
		QRY
		QRY_Camp_SleepCutsceneOverride_CustomDialogStart((DIALOGRESOURCE)CAMP_AstarionHunger_SCO_Companion_AstarionSneaksOff_d6e52274-0458-7311-7990-ed53a7b694a0,(CHARACTER)_Player,(CHARACTER)_Player2,(CHARACTER)_Player3,(CHARACTER)_Player4)
		AND
		QRY_ObjectFilterOut(_Player,S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		AND
		DB_QRYRTN_ObjectFilterOut(_PlayerNotAstarion)
		AND
		QRY_ObjectFilterOut(_Player2,S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		AND
		DB_QRYRTN_ObjectFilterOut(_Player2NotAstarion)
		AND
		QRY_ObjectFilterOut(_Player3,S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		AND
		DB_QRYRTN_ObjectFilterOut(_Player3NotAstarion)
		AND
		QRY_ObjectFilterOut(_Player4,S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		AND
		DB_QRYRTN_ObjectFilterOut(_Player4NotAstarion)
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)CAMP_AstarionHunger_SCO_Companion_AstarionSneaksOff_d6e52274-0458-7311-7990-ed53a7b694a0,_PlayerNotAstarion,_Player2NotAstarion,_Player3NotAstarion,_Player4NotAstarion,S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_Camp_SleepCutsceneOverride_CustomDialogStart((DIALOGRESOURCE)CAMP_AstarionHunger_SCO_Companion_AstarionSneaksOff_d6e52274-0458-7311-7990-ed53a7b694a0,(CHARACTER)_Player,(CHARACTER)_Player2,(CHARACTER)_Player3,(CHARACTER)_Player4)
		THEN
		DB_NOOP(1);
		
		// Astarion victim
		// different player index depending on whether Astarion is in party or not
		IF
		DialogStarted(CAMP_AstarionHunger_SCO_Companion_359981f9-d660-96e2-3e94-218e92d5e479, _Inst)
		AND
		DB_Players(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		THEN
		DB_Camp_AstarionBiteDialog_PlayerIndex(2);
		
		IF
		DialogStarted(CAMP_AstarionHunger_SCO_Companion_359981f9-d660-96e2-3e94-218e92d5e479, _Inst)
		AND
		NOT DB_Players(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		THEN
		DB_Camp_AstarionBiteDialog_PlayerIndex(1);
		
		IF
		DialogEnded(CAMP_AstarionHunger_SCO_Companion_359981f9-d660-96e2-3e94-218e92d5e479, _Inst)
		AND
		DB_Camp_AstarionBiteDialog_PlayerIndex(_Index)
		AND
		DB_DialogPlayers(_Inst, _Avatar, _Index)
		THEN
		SetFlag(CAMP_Astarion_State_VictimOfAstarion_78dfbdb1-11c2-47ab-bf0c-f6819a2fe3f3, _Avatar);
		DB_Camp_AstarionBiteNightTarget((CHARACTER)_Avatar);
		
		IF
		DialogEnded((DIALOGRESOURCE)CAMP_AstarionHunger_SCO_Companion_359981f9-d660-96e2-3e94-218e92d5e479,_Inst)
		AND
		NOT DB_GlobalFlag((FLAG)CAMP_Astarion_TheHungerC_Leave_0e36d357-fd68-2e42-7ba6-b69efd57eb90)
		AND
		NOT DB_GlobalFlag((FLAG)CAMP_Astarion_TheHungerC_Kill_0cf812a4-59c0-564a-8825-95885d78d208)
		AND
		NOT DB_GlobalFlag((FLAG)CAMP_Astarion_TheHungerC_AvatarDeath_bf0c50fa-4d35-99b5-05e3-dace39929e1d)
		THEN
		DB_Camp_StayInCampAfterLongRest(1);
		DB_Camp_AstarionStillInPartyAfterBiteScene(1);
		
		PROC
		PROC_CampNight_StartMorningMoments()
		AND
		DB_Camp_AstarionStillInPartyAfterBiteScene(1)
		THEN
		PROC_CampRelationshipDialog(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, (DIALOGRESOURCE)CAMP_AstarionHungerC_CRD_Astarion_MorningAfter_daac36c3-6e0b-da21-52f3-5a79955d9af4, 0);
		PROC_Try_CampRelationshipDialog(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, 1);
		NOT DB_Camp_AstarionStillInPartyAfterBiteScene(1);
		
		// If at least one of these origins Gale, Wyll, Karlach, Laezel and Shadowheart present as companions
		PROC
		PROC_DialogFlagSetup(CAMP_AstarionHungerC_CRD_Astarion_MorningAfter_daac36c3-6e0b-da21-52f3-5a79955d9af4, _, _Player)
		AND
		QRY_CAMP_Astarion_AtLeastOneCompanionForMorningAfterDialogPresent()
		THEN
		PROC_GlobalSetFlagAndCache(CAMP_Astarion_MorningAfter_AtLeastOnceCompanionPresent_92706e50-7fc6-493b-b3d1-f19329eb0539);
		
		QRY
		QRY_CAMP_Astarion_AtLeastOneCompanionForMorningAfterDialogPresent()
		AND
		DB_CAMP_Astarion_MorningAfterCompanions(_Companion)
		AND
		DB_PlayerInCamp(_Companion)
		AND
		NOT DB_Avatars(_Companion)
		THEN
		DB_NOOP(1);
		
		IF
		DialogEnded((DIALOGRESOURCE)CAMP_AstarionHungerC_CRD_Astarion_MorningAfter_daac36c3-6e0b-da21-52f3-5a79955d9af4, _)
		AND
		DB_GlobalFlag(CAMP_Astarion_MorningAfter_AtLeastOnceCompanionPresent_92706e50-7fc6-493b-b3d1-f19329eb0539)
		THEN
		PROC_GlobalClearFlagAndCache(CAMP_Astarion_MorningAfter_AtLeastOnceCompanionPresent_92706e50-7fc6-493b-b3d1-f19329eb0539);
		
		IF
		FlagSet((FLAG)CAMP_Astarion_TheHungerC_AvatarDeath_bf0c50fa-4d35-99b5-05e3-dace39929e1d, _, _)
		AND
		DB_Camp_AstarionBiteDialog_PlayerIndex(_Index)
		AND
		DB_DialogPlayers(_Inst, _Avatar, _Index)
		THEN
		DB_CAMP_Astarion_ClearVictimBlood((CHARACTER)_Avatar);
		DB_DialogDeath((CHARACTER)_Avatar);
		PROC_DieImmediate((CHARACTER)_Avatar, DEATHTYPE.DoT, 0);
		
		// Astarion drains all blood
		IF
		DB_CAMP_Astarion_ClearVictimBlood(_Victim)
		THEN
		RealtimeObjectTimerLaunch(_Victim, "CAMP_Astarion_ClearVictimBlood", 1500);
		
		IF
		ObjectTimerFinished(_Victim, "CAMP_Astarion_ClearVictimBlood")
		THEN
		CreateSurface(_Victim, "SurfaceNone", 2.0, -1.0, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		DialogEnded((DIALOGRESOURCE)CAMP_AstarionHunger_SCO_Companion_359981f9-d660-96e2-3e94-218e92d5e479,_Inst)
		AND
		DB_GlobalFlag((FLAG)CAMP_Astarion_TheHungerC_AvatarDeath_bf0c50fa-4d35-99b5-05e3-dace39929e1d)
		AND
		DB_Camp_AstarionBiteDialog_PlayerIndex(_Index)
		AND
		DB_DialogPlayers(_Inst, _Avatar, _Index)
		THEN
		NOT DB_DialogDeath((CHARACTER)_Avatar);
		DB_Camp_StayInCampAfterLongRest(1);
		DB_CAMP_Astarion_DeadAvatar(_Avatar);
		DB_CAMP_Astarion_StandingStillDialogs_SteerTo(_Avatar);
		
		//play PAD on wakeup if Astarion killed Avatar (same phrase as if Avatar killed Astarion)
		PROC
		PROC_CampNight_StartMorningMoments()
		AND
		DB_CAMP_Astarion_DeadAvatar(_Victim)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)CAMP_AstarionHunger_PAD_AftermathAvatarKilled_538b7717-cbee-b956-8fd0-78d3e97603ad,(CHARACTER) S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255);
		NOT DB_CAMP_Astarion_DeadAvatar(_Victim);
		DB_CAMP_Astarion_WaitForResurrection((CHARACTER)_Victim);
		
		IF
		Resurrected(_Victim)
		AND
		DB_CAMP_Astarion_WaitForResurrection(_Victim)
		AND
		DB_InCamp((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		THEN
		NOT DB_CAMP_Astarion_WaitForResurrection(_Victim);
		DB_CAMP_Astarion_WaitForGainingControl(_Victim);
		MakePlayerActive(_Victim);
		
		IF
		GainedControl(_Victim)
		AND
		DB_CAMP_Astarion_WaitForGainingControl(_Victim)
		THEN
		NOT DB_CAMP_Astarion_WaitForGainingControl(_Victim);
		PROC_CampRelationshipDialog(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, (DIALOGRESOURCE)Astarion_InParty_53aba16e-55bb-a0fc-a444-522e237dbe46, (FLAG)ORI_Astarion_CRD_KilledYou_a020328d-2979-4ca1-ac5e-32ef07e23a02, 0);
		PROC_Try_CampRelationshipDialog(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, 1);
		
		IF
		DialogEnded((DIALOGRESOURCE)CAMP_AstarionHunger_SCO_Companion_359981f9-d660-96e2-3e94-218e92d5e479,_Inst)
		AND
		DB_GlobalFlag((FLAG)CAMP_Astarion_TheHungerC_Leave_0e36d357-fd68-2e42-7ba6-b69efd57eb90)
		AND
		DB_Camp_AstarionBiteDialog_PlayerIndex(_Index)
		AND
		DB_DialogPlayers(_Inst, _Avatar, _Index)
		THEN
		DB_Camp_StayInCampAfterLongRest(1);
		DB_Camp_AstarionBite_AvatarForReflectionDialog((CHARACTER)_Avatar);
		
		IF
		DialogEnded((DIALOGRESOURCE)CAMP_AstarionHunger_SCO_Companion_359981f9-d660-96e2-3e94-218e92d5e479,_Inst)
		AND
		DB_GlobalFlag((FLAG)CAMP_Astarion_TheHungerC_Kill_0cf812a4-59c0-564a-8825-95885d78d208)
		AND
		DB_Camp_AstarionBiteDialog_PlayerIndex(_Index)
		AND
		DB_DialogPlayers(_Inst, _Avatar, _Index)
		THEN
		DB_Camp_StayInCampAfterLongRest(1);
		DB_CAMP_Astarion_BiteSceneMurderVictim((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255);
		DB_Camp_AstarionBite_AvatarForReflectionDialog((CHARACTER)_Avatar);
		
		PROC
		PROC_CampNight_StartMorningMoments()
		AND
		DB_Camp_AstarionBite_AvatarForReflectionDialog(_Avatar)
		THEN
		NOT DB_Camp_AstarionBite_AvatarForReflectionDialog(_Avatar);
		PROC_GroupDiscussion_InstantStart(_Avatar, (VOICEBARKRESOURCE)GLO_Astarion_GD_IVB_VampireRevelation_0b2fc87f-0258-585c-d7f1-f458c0b03c78);
		
		//Astarion Bite - Happy status for Astarion, WEAK status for his Victim
		IF
		FlagSet((FLAG)CAMP_Astarion_TheHungerC_Bite_2b3eb508-5fdc-05a1-2493-fdcea9a0e447,_,_Inst)
		AND
		DB_Camp_AstarionBiteDialog_PlayerIndex(_Index)
		AND
		DB_DialogPlayers(_Inst, _Avatar, _Index)
		THEN
		DB_Camp_AstarionBite_VictimForWeakStatus((CHARACTER)_Avatar);
		
		PROC
		PROC_CampNight_StartMorningMoments()
		AND
		DB_Camp_AstarionBite_VictimForWeakStatus(_Victim)
		AND
		NOT DB_Defeated(_Victim)
		THEN
		ApplyStatus(_Victim, "ASTARION_WEAK", -1.0, 1, S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255);
		
		PROC
		PROC_CampNight_StartMorningMoments()
		AND
		DB_Camp_AstarionBite_VictimForWeakStatus(_Victim)
		THEN
		NOT DB_Camp_AstarionBite_VictimForWeakStatus(_Victim);
		ApplyStatus(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, "ASTARION_HAPPY", -1.0, 1, S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255);
		//END_REGION
		
		//REGION Astarion being kidnapped by Gur Hunter
		// we don't need to stay in the camp if no kidnapping happens
		IF
		DB_Camp_QueuedMorningCFM((DIALOGRESOURCE)CAMP_Astarion_Kidnapping_PLACEHOLDER_11111111-1111-1111-1111-111111111111)
		AND
		DB_GlobalFlag((FLAG)ORI_Astarion_State_WarnedAboutGurHunterAttack_e8985fe1-5545-4d30-9e7e-00877004a118)
		THEN
		NOT DB_Camp_StayInCampAfterLongRest(1);	
		
		PROC
		PROC_CampfireMoment_PreDialog((DIALOGRESOURCE)CAMP_Astarion_Kidnapping_PLACEHOLDER_11111111-1111-1111-1111-111111111111)
		AND
		DB_GlobalFlag((FLAG)ORI_Astarion_State_WarnedAboutGurHunterAttack_e8985fe1-5545-4d30-9e7e-00877004a118)
		THEN
		SetFlag((FLAG)ORI_Astarion_State_KilledGurHunterDuringNight_296b7ff4-c1f4-4ef3-b7be-e3fc6a836c09);
		Die(S_GLO_GurHunter_0e47fcb9-c0c4-4b0c-902b-2d13d209e760, DEATHTYPE.Physical, 1);
		DB_CampNight_Completed((FLAG)NIGHT_Astarion_Kidnapping_04183627-15b8-4fa1-bc09-fb24eabe01f2);
		
		PROC
		PROC_CampfireMoment_PreDialog((DIALOGRESOURCE)CAMP_Astarion_Kidnapping_PLACEHOLDER_11111111-1111-1111-1111-111111111111)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Astarion_State_WarnedAboutGurHunterAttack_e8985fe1-5545-4d30-9e7e-00877004a118)
		AND
		QRY_GetBestAvatarForCompanion((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		AND
		DB_QRYRTN_GetBestAvatarForCompanion((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, _Avatar)
		THEN
		SetFlag((FLAG)ORI_Astarion_State_GurGotAstarion_cd1687b8-3282-4121-aaa1-6de5eda6a9a4);
		DB_Camp_StayInCampAfterMorningCFM(CAMP_Astarion_Kidnapping_PLACEHOLDER_11111111-1111-1111-1111-111111111111);
		DB_CAMP_Astarion_GurKidnapping_PlayPAD(_Avatar);
		DB_CompanionLeaving(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, _Avatar);
		PROC_Origins_CompanionLeavePermanently((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, "MetGur_AstarionDisappear");
		PROC_SetOnStage(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, 0);
		DB_CampNight_Completed((FLAG)NIGHT_Astarion_Kidnapping_04183627-15b8-4fa1-bc09-fb24eabe01f2);
		
		IF
		MessageBoxClosed(_, "GLO_CompanionLeftPermanently")
		AND
		DB_CAMP_Astarion_GurKidnapping_PlayPAD(_Avatar)
		THEN
		NOT DB_CAMP_Astarion_GurKidnapping_PlayPAD(_Avatar);
		RealtimeObjectTimerLaunch(_Avatar, "CAMP_Astarion_GurKidnapping_PlayPAD", 2000); // can't start AD immediately, at least the first line is not shown on the screen
		
		IF
		ObjectTimerFinished(_Avatar, "CAMP_Astarion_GurKidnapping_PlayPAD")
		AND
		DB_Players(_Player)
		AND
		NOT DB_Avatars(_Player)
		AND
		QRY_StartDialog_Fixed(GLO_Astarion_PAD_AstarionKidnapped_6ce11a30-ad07-ef5e-7352-28fd78b75a92, _Player, _Avatar)
		AND
		QRY_OnlyOnce("CAMP_AstarionKidnapped_PAD")
		THEN
		DB_NOOP(1);
		//END_REGION Astarion being kidnapped by Gur Hunter
		
		//REGION Specific Night Logic - MonitorIntro
		IF
		DialogStarted((DIALOGRESOURCE)CAMP_MonitorIntro_CM_6aa2bfc3-d9e6-a2d8-d017-25d59d9f757a,_Inst)
		AND
		DB_DialogPlayers(_Inst,_Player,1)
		THEN
		DB_CampNight_MonitorIntro_Player(_Player);
		NOT DB_CampfireMoment_ActiveDialog((DIALOGRESOURCE)CAMP_MonitorIntro_CM_6aa2bfc3-d9e6-a2d8-d017-25d59d9f757a, (CHARACTER)S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8);
		/*
		PROC
		PROC_CampfireMoment_PostDialog((DIALOGRESOURCE)CAMP_MonitorIntro_CM_6aa2bfc3-d9e6-a2d8-d017-25d59d9f757a)
		AND
		DB_CampNight_MonitorIntro_Player(_Player)
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)FOR_Monitor_Dinner_c6618ea4-f1a5-086f-936e-402f4d74fa38, S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, _Player, NULL_00000000-0000-0000-0000-000000000000, S_Dummy_Monitor_DevilForm_4a4326cc-be91-4903-9bd6-31bbf5a9ff42)
		THEN
		SetOnStage(S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, 1);
		NOT DB_CampNight_MonitorIntro_Player(_Player);
		DB_CampNight_PreventAutomaticContinue(1);
		*/
		
		IF
		InstanceDialogChanged(_, CAMP_MonitorIntro_CFM_6aa2bfc3-d9e6-a2d8-d017-25d59d9f757a, FOR_Monitor_Dinner_c6618ea4-f1a5-086f-936e-402f4d74fa38, _)
		AND
		DB_CampNight_MonitorIntro_Player(_Player)
		THEN
		NOT DB_CampNight_MonitorIntro_Player(_Player);
		DB_CampNight_PreventAutomaticContinue(1);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)CAMP_MonitorIntro_CM_6aa2bfc3-d9e6-a2d8-d017-25d59d9f757a,(INTEGER)_ID)
		AND
		DB_PlayerInCamp(_Player)
		AND
		NOT DB_DialogRequestCache_SpeakerList_Speakers(_,_ID,_Player,_)
		THEN
		PROC_DialogAddListeningActor(_ID,_Player);
		
		IF
		DialogEnded((DIALOGRESOURCE)CAMP_MonitorIntro_CM_6aa2bfc3-d9e6-a2d8-d017-25d59d9f757a,_)
		THEN
		PROC_CampNight_EndCFM();
		
		//END_REGION
		
		//REGION Specific Night Logic - Monitor Reveals Party Secrets
		QRY
		QRY_Camp_Monitor_GetMonitorDummyForAvatar((CHARACTER)_Player)
		AND
		DB_QRYRTN_Camp_Monitor_GetMonitorDummyForAvatar(_Player,_Monitor)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_Camp_Monitor_GetMonitorDummyForAvatar((CHARACTER)_Player)
		AND
		DB_CAMP_Monitor_MonitorHumanDummies(_Monitor)
		AND
		NOT DB_QRYRTN_Camp_Monitor_GetMonitorDummyForAvatar(_Player,_)
		AND
		NOT DB_QRYRTN_Camp_Monitor_GetMonitorDummyForAvatar(_,_Monitor)
		THEN
		DB_QRYRTN_Camp_Monitor_GetMonitorDummyForAvatar(_Player,_Monitor);
		//END_REGION
		
		//REGION Specific Night Logic - Daisy 1 (sick-at-camp) - LaezelBeforeDream
		
		PROC
		PROC_DialogFlagSetup(CAMP_Daisy1_CRD_Laezel_BeforeDream_1375618b-f1e6-7f74-4748-beabc24cdc96,(GUIDSTRING)_Laezel,(GUIDSTRING)_Avatar)
		THEN
		ToInventory(S_CAMP_DaisyLaezelBlade_6fce621f-aca9-4462-b732-ab459be8014a,S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12,1,0,0);
			//Player executes Lae'zel:
		DB_GlobalFlagReactionAfterDialog((FLAG)CAMP_LaezelBeforeDream_Event_ExecuteLaezel_1a3d618c-b80e-78f2-d766-442f121ee540, CAMP_Daisy1_CRD_Laezel_BeforeDream_1375618b-f1e6-7f74-4748-beabc24cdc96);
			//Lae'zel went hostile against camp - killed:
		DB_GlobalFlagReactionAfterDialog((FLAG)CAMP_LaezelBeforeDream_Event_AttackedLaezel_dffe4643-709e-ac8c-ad62-450db550ca61, CAMP_Daisy1_CRD_Laezel_BeforeDream_1375618b-f1e6-7f74-4748-beabc24cdc96);
			//Player submitted to Lae'zel and got executed (for multiplayer purposes):
		DB_GlobalFlagReactionAfterDialog((FLAG)CAMP_LaezelBeforeDream_Event_LaezelKilledPlayer_83012c3a-bce6-fd00-f1c9-51dc86eb49da, CAMP_Daisy1_CRD_Laezel_BeforeDream_1375618b-f1e6-7f74-4748-beabc24cdc96);
			//Lae'zel stands down:	(FLAG)CAMP_LaezelBeforeDream_Event_LaezelPersuaded_39344ccb-5159-53f1-497e-db2cb383e9df
		
		IF
		FlagSet(CAMP_LaezelBeforeDream_Event_TakeBlade_ae9342da-d8d7-ad16-65d5-adb2c48be026,_Player,_)
		THEN
		ToInventory(S_CAMP_DaisyLaezelBlade_6fce621f-aca9-4462-b732-ab459be8014a,_Player,1,1,0);
		
		//Killing Lae'zel
		PROC
		PROC_GlobalFlagReactionAfterDialog(CAMP_LaezelBeforeDream_Event_ExecuteLaezel_1a3d618c-b80e-78f2-d766-442f121ee540,(DIALOGRESOURCE)_Dialog,(INTEGER)_DialogID)
		AND
		DB_DialogSpeakers(_DialogID,_Player,2)
		THEN
		PROC_Origins_CompanionLeavePermanently(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, "LaezelDied_KilledAtCampNight");
		PROC_CAMP_LaezelBeforeDream_KillLaezel(_Player);
		
		PROC
		PROC_CAMP_LaezelBeforeDream_KillLaezel((GUIDSTRING)_Player)
		AND
		DB_Players(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		THEN
		PROC_GLO_PartyMembers_MakeNPC(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		
		PROC
		PROC_CAMP_LaezelBeforeDream_KillLaezel((GUIDSTRING)_Player)
		THEN
		DB_CAMP_LaezelBeforeDream_LaezelKiller((CHARACTER)_Player);
		SetTag(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (TAG)BLOCK_RESURRECTION_22a75dbb-1588-407e-b559-5aa4e6d4e6a6);
		Die(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, DEATHTYPE.DoT, _Player, 1, 0);
		
		QRY
		QRY_CRIME_BlockRegisterCrime(_Player, (STRING)_, NULL_00000000-0000-0000-0000-000000000000, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (INTEGER)_)
		AND
		DB_CAMP_LaezelBeforeDream_LaezelKiller(_Player)
		THEN
		NOT DB_CAMP_LaezelBeforeDream_LaezelKiller(_Player);
		
		//Attacking Lae'zel
		PROC
		PROC_GlobalFlagReactionAfterDialog(CAMP_LaezelBeforeDream_Event_AttackedLaezel_dffe4643-709e-ac8c-ad62-450db550ca61,(DIALOGRESOURCE)_Dialog,(INTEGER)_DialogID)
		THEN
		PROC_CAMP_LaezelBeforeDream_SetLaezelHostileNPC();
		
		//Killing player
		PROC
		PROC_GlobalFlagReactionAfterDialog(CAMP_LaezelBeforeDream_Event_LaezelKilledPlayer_83012c3a-bce6-fd00-f1c9-51dc86eb49da,(DIALOGRESOURCE)_Dialog,(INTEGER)_DialogID)
		AND
		DB_DialogSpeakers(_DialogID,_Player,2)
		THEN
		Die(_Player, DEATHTYPE.DoT, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, 1, 0);
		PROC_CAMP_LaezelBeforeDream_SetLaezelHostileNPC();
		
		PROC
		PROC_CAMP_LaezelBeforeDream_SetLaezelHostileNPC()
		THEN
		DB_CAMP_LaezelBeforeDream_Combat(NULL_00000000-0000-0000-0000-000000000000);
		DB_CAMP_LaezelBeforeDream_LaezelHuntingDownPlayers(1);
		
		IF
		EnteredCombat(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12,_CombatGuid)
		AND
		DB_CAMP_LaezelBeforeDream_Combat(NULL_00000000-0000-0000-0000-000000000000)
		THEN
		NOT DB_CAMP_LaezelBeforeDream_Combat(NULL_00000000-0000-0000-0000-000000000000);
		DB_CAMP_LaezelBeforeDream_Combat(_CombatGuid);
		
		PROC
		PROC_LongRest()
		AND
		DB_CAMP_LaezelBeforeDream_Combat(_CombatGuid)
		THEN
		SetEntityEvent(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, "GLO_AllowCombatFallbackAD"); //(but she should be dead here anyway)
		NOT DB_CAMP_LaezelBeforeDream_Combat(_CombatGuid);
		
		IF
		DB_CAMP_LaezelBeforeDream_LaezelHuntingDownPlayers(1)
		AND
		NOT DB_Is_InCombat(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _)
		AND
		NOT DB_Defeated(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		THEN
		TimerLaunch("CAMP_LaezelBeforeDream_PickNextOpponentDelay", 3000);
		
		IF
		TimerFinished("CAMP_LaezelBeforeDream_PickNextOpponentDelay")
		AND
		NOT DB_Is_InCombat(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _)
		AND
		NOT DB_Defeated(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		NOT QRY_CAMP_LaezelBeforeDream_MoveToNextTarget()
		THEN
		Die(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, DEATHTYPE.Physical, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, 0, 0, 0.0);
		
		QRY
		QRY_CAMP_LaezelBeforeDream_MoveToNextTarget()
		AND
		QRY_OnlyOnce_Reset("CAMP_LaezelBeforeDream_HuntingTargetAcquired")
		AND
		DB_Players(_AlivePlayer)
		AND
		NOT DB_Defeated(_AlivePlayer)
		AND
		QRY_OnlyOnce("CAMP_LaezelBeforeDream_SearchForNewTarget")
		THEN
		PROC_CharacterMoveTo((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _AlivePlayer, "Run", "");
		
		IF
		DB_Camp_QueuedNight((FLAG)NIGHT_DaisyDream1_52669b07-9584-4c9d-8219-49679811fd4f)
		AND
		DB_GlobalFlag((FLAG)LAEZELCOMPANION_9c5bc0ce-cb2e-4685-b597-89a290837535)
		THEN
		NOT DB_CampNight_IVB((FLAG)NIGHT_DaisyDream1_52669b07-9584-4c9d-8219-49679811fd4f,(VOICEBARKRESOURCE)CAMP_Daisy1_IVB_dc0d3343-7256-e2a6-c211-14680236c139,(CHARACTER)NULL_00000000-0000-0000-0000-000000000000);
		DB_CampNight_CFM((FLAG)NIGHT_DaisyDream1_52669b07-9584-4c9d-8219-49679811fd4f,(DIALOGRESOURCE)CAMP_Daisy1_CRD_Laezel_BeforeDream_1375618b-f1e6-7f74-4748-beabc24cdc96);
		DB_CampfireMoment_FixedSpeakers((DIALOGRESOURCE)CAMP_Daisy1_CRD_Laezel_BeforeDream_1375618b-f1e6-7f74-4748-beabc24cdc96,(CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		
		QRY
		QRY_DialogAttackRequested_CustomResponse((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _Player)
		AND
		DB_DialogName(CAMP_Daisy1_CRD_Laezel_BeforeDream_1375618b-f1e6-7f74-4748-beabc24cdc96, _)
		AND
		QRY_TryStopDialogFor(_Player)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)CAMP_LaezelBeforeDream_Event_AttackedLaezel_dffe4643-709e-ac8c-ad62-450db550ca61);
		PROC_CAMP_LaezelBeforeDream_SetLaezelHostileNPC();
		
		PROC
		PROC_Camp_EveryoneWakeup()
		AND 
		DB_CAMP_LaezelBeforeDream_LaezelHuntingDownPlayers(1)
		THEN
		NOT DB_CAMP_LaezelBeforeDream_LaezelHuntingDownPlayers(1);
		//END_REGION
		
		//REGION Specific Night Logic - Shadowheart_Ultimatum
		IF
		DB_Players(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		AND
		DB_CampNight((FLAG)NIGHT_ShadowHeart_Ultimatum_27cd4564-b655-4f9e-88a2-f4431cffad90,_)
		THEN
		PROC_CampNight_ClearCampNight(NIGHT_ShadowHeart_Ultimatum_27cd4564-b655-4f9e-88a2-f4431cffad90);
		
		IF
		EntityEvent(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,"ORI_ToCamp")
		AND
		DB_CampNight((FLAG)NIGHT_ShadowHeart_Ultimatum_27cd4564-b655-4f9e-88a2-f4431cffad90,_)
		THEN
		PROC_CampNight_ClearCampNight(NIGHT_ShadowHeart_Ultimatum_27cd4564-b655-4f9e-88a2-f4431cffad90);
		
		PROC
		PROC_CampNight_StartSelected()
		AND
		DB_Camp_QueuedNight(CAMP_ShadowHeart_CM_Ultimatum_27cd4564-b655-4f9e-88a2-f4431cffad90)
		THEN
		PROC_ORI_SetupCamp(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,1);
		DB_OnlyOnce("ORI_ShadowHeart_ToCamp");
		//END_REGION
		
		//REGION Specific Night Logic - Shadowheart_LaezelFight
		
		//REGION Good Standing
		
		//If Lae'zel is dating Shadowheart or is high in approval, remove weary flag. Reason why it is a requirement rather than cancelling is because cancelling removes the camp night definition all together.
		
		IF
		FlagSet((FLAG)ORI_State_DatingShadowheart_e87f1e21-a758-47ae-8c0e-9e715eb289b5, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _)
		AND
		DB_GlobalFlag((FLAG)ORI_Shadowheart_State_LaezelWeary_a7b0e52b-0854-4194-bc09-cd1e78859620)
		THEN
		PROC_GlobalClearFlagAndCache((FLAG)ORI_Shadowheart_State_LaezelWeary_a7b0e52b-0854-4194-bc09-cd1e78859620);
		
		IF
		ApprovalRatingChangeAttempt((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _, _, _Approval)
		AND
		_Approval >= 20
		AND
		DB_GlobalFlag((FLAG)ORI_Shadowheart_State_LaezelWeary_a7b0e52b-0854-4194-bc09-cd1e78859620)
		THEN
		PROC_GlobalClearFlagAndCache((FLAG)ORI_Shadowheart_State_LaezelWeary_a7b0e52b-0854-4194-bc09-cd1e78859620);
		
		IF
		FlagCleared((FLAG)ORI_State_DatingShadowheart_e87f1e21-a758-47ae-8c0e-9e715eb289b5, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Shadowheart_State_LaezelWeary_a7b0e52b-0854-4194-bc09-cd1e78859620)
		AND
		DB_ApprovalRating((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _Approval)
		AND
		_Approval < 20
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)ORI_Shadowheart_State_LaezelWeary_a7b0e52b-0854-4194-bc09-cd1e78859620);
		
		IF
		ApprovalRatingChangeAttempt((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _, _, _Approval)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Shadowheart_State_LaezelWeary_a7b0e52b-0854-4194-bc09-cd1e78859620)
		AND
		_Approval < 20
		AND
		GetFlag((FLAG)ORI_State_DatingShadowheart_e87f1e21-a758-47ae-8c0e-9e715eb289b5, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, 0)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)ORI_Shadowheart_State_LaezelWeary_a7b0e52b-0854-4194-bc09-cd1e78859620);
		
		
		//END_REGION
		
		PROC
		PROC_CampNight_StartSelected()
		AND
		DB_Camp_QueuedNight(NIGHT_ShadowHeart_LaezelFight_a3445b22-7973-416b-b8a3-1856414589ea)
		THEN
		ClearFlag(ORI_Shadowheart_State_PreFight_83208bb5-4eb9-4394-845d-954d3ec3febb,NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		DB_Avatars(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		AND
		DB_Avatars(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		DB_CampNight((FLAG)NIGHT_ShadowHeart_LaezelFight_a3445b22-7973-416b-b8a3-1856414589ea,_)
		THEN
		PROC_CampNight_ClearCampNight(NIGHT_ShadowHeart_LaezelFight_a3445b22-7973-416b-b8a3-1856414589ea);
		
		IF
		FlagSet(CAMP_Shadowheart_Event_Wound_1eff6400-29f4-648d-e6aa-3c98250ad0b5,_,_)
		THEN
		ToInventory(S_GLO_PuzzleBox_326324f9-0920-8f0f-3e85-3781fbf48282,S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12,1,0,0);
		
		PROC
		PROC_LongRest()
		AND
		DB_GlobalFlag(CAMP_Shadowheart_Event_Wound_1eff6400-29f4-648d-e6aa-3c98250ad0b5)
		AND
		QRY_OnlyOnce("CAMP_Shadowheart_LaezelWound")
		THEN
		SetHitpoints(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679, 1);
		
		IF
		DialogEnded(CAMP_Shadowheart_IVB_CFM_LaezelFight_23f9c168-1017-fc9f-ed65-7e8a1e33a09f,_)
		AND
		DB_GlobalFlag(CAMP_Shadowheart_Event_Wound_1eff6400-29f4-648d-e6aa-3c98250ad0b5)
		THEN
		Drop(S_GLO_PuzzleBox_326324f9-0920-8f0f-3e85-3781fbf48282);
		PROC_GLO_PartyMembers_Remove(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12,1);
		Die(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12,DEATHTYPE.Explode,S_GLO_PuzzleBox_326324f9-0920-8f0f-3e85-3781fbf48282,1,1);
		
		IF
		DialogEnded(CAMP_Shadowheart_IVB_CFM_LaezelFight_23f9c168-1017-fc9f-ed65-7e8a1e33a09f,_ID)
		AND
		DB_DialogSpeakers(_ID,_Char,_Slot)
		AND
		GetFlag(CAMP_Shadowheart_Event_Kill_d4d8ed29-0297-5817-7ed5-7b420891e111,_Char,1)
		AND
		IntegerSubtract(3,_Slot,_Rem)
		AND
		DB_DialogSpeakers(_ID,_Other,_Rem)
		THEN
		PROC_Origins_CompanionLeavePermanently((CHARACTER)_Char,"CompanionHostile");
		Die(_Char,DEATHTYPE.Physical,_Other,1,1);
		
		IF
		DialogEnded(CAMP_Shadowheart_IVB_CFM_LaezelFight_23f9c168-1017-fc9f-ed65-7e8a1e33a09f,_ID)
		AND
		DB_DialogSpeakers(_ID,_Char,_)
		AND
		GetFlag(CAMP_Shadowheart_Event_Fight_9e208379-c14f-b65a-c4a2-a029162939cb,_Char,1)
		THEN
		PROC_Origins_CompanionLeavePermanently((CHARACTER)_Char,"CompanionHostile");
		SetEntityEvent(_Char,"NIGHT_Shadowheart_LaezelFight_Kick");
		DB_ShadowheartLaezelFight_Fight(1);
		PROC_Camp_HideAllNonPlayers();
		
		QRY
		QRY_Camp_DoNotHideCamper((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679)
		AND
		DB_ShadowheartLaezelFight_Fight(1)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_Camp_DoNotHideCamper((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		DB_ShadowheartLaezelFight_Fight(1)
		THEN
		DB_NOOP(1);
		
		//If not a fight and not ended during evening -> instant sleep till morning)
		IF
		DialogEnded(CAMP_Shadowheart_IVB_CFM_LaezelFight_23f9c168-1017-fc9f-ed65-7e8a1e33a09f,_ID)
		AND
		GetFlag((FLAG)CAMP_Shadowheart_Event_Fight_9e208379-c14f-b65a-c4a2-a029162939cb,(CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,0)
		AND
		GetFlag((FLAG)CAMP_Shadowheart_Event_Fight_9e208379-c14f-b65a-c4a2-a029162939cb,(CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12,0)
		AND
		GetFlag((FLAG)CAMP_ShadowheartLaezelFight_State_EndDuringEvening_35098479-0777-b67c-a6ec-004bf35ffc4d,NULL_00000000-0000-0000-0000-000000000000,0)
		THEN
		PROC_Camp_WakeUpAtNight();
		
		IF
		EntityEvent(_Char,"NIGHT_Shadowheart_LaezelFight_Kick")
		AND
		GetFaction(_Char,_Faction)
		THEN
		PROC_CAMP_ClearCampFaction((CHARACTER)_Char);
		PROC_SetRelationToPlayers(_Faction,0);
		
		IF
		EntityEvent(_Char,"NIGHT_Shadowheart_LaezelFight_Kick")
		AND
		DB_Players(_Other)
		AND
		DB_InCamp(_Other)
		THEN
		PROC_EnterCombat(_Other,_Char);
		
		//If they fail to enter combat due to distance or anything else, they run towards each other
		IF
		EntityEvent(_, "NIGHT_Shadowheart_LaezelFight_Kick")
		THEN
		PROC_CharacterMoveTo((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, "Run", "");
		PROC_CharacterMoveTo((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679, "Run", "");
		
		IF
		EntityEvent(_Char, "NIGHT_Shadowheart_LaezelFight_Kick")
		AND
		DB_Avatars(_Other)
		AND
		DB_InCamp(_Other)
		AND
		GetPosition(_Char, _X, _Y, _Z)
		AND
		FindValidPosition( _X, _Y, _Z, 5.0, _Other, 1,  _ValidX, _ValidY, _ValidZ)
		THEN
		TeleportToPosition(_Other, _ValidX, _ValidY, _ValidZ, "", 0, 0, 0, 0, 1);
		
		IF
		LeftCombat(_,_)
		AND
		DB_ShadowheartLaezelFight_Fight(1)
		AND
		NOT QRY_ShadowheartLaezelFight_CamperInCombat()
		THEN
		NOT DB_ShadowheartLaezelFight_Fight(1);
		PROC_Camp_WakeUpAtNight();
		
		QRY
		QRY_ShadowheartLaezelFight_CamperInCombat()
		AND
		DB_PartyMembers(_Member)
		AND
		DB_Is_InCombat(_Member,_)
		THEN
		DB_NOOP(1);
		
		IF
		StatusRemoved((CHARACTER)_Char,"KNOCKED_OUT",_,_)
		AND
		DB_InCamp(_Char)
		AND
		GetFlag(CAMP_Shadowheart_Event_Fight_9e208379-c14f-b65a-c4a2-a029162939cb,_Char,1)
		THEN
		PROC_DisappearOutOfSight(_Char,"Run",0,"");
		
		//Hide Bedrolls
		IF
		DialogStarted(CAMP_Shadowheart_IVB_CFM_LaezelFight_23f9c168-1017-fc9f-ed65-7e8a1e33a09f,_)
		AND
		DB_CampBed("WLDMAIN",_,_,_Bed,_,_,_)
		THEN
		PROC_CAMP_Shadowheart_LaezelFight_Hide(_Bed);
		
		
		PROC
		PROC_CAMP_Shadowheart_LaezelFight_Hide((GUIDSTRING)_Bed)
		AND
		IsOnStage(_Bed,1)
		THEN
		DB_CAMP_Shadowheart_LaezelFight_Hide(_Bed);
		SetOnStage(_Bed,0);
		
		IF
		DialogEnded(CAMP_Shadowheart_IVB_CFM_LaezelFight_23f9c168-1017-fc9f-ed65-7e8a1e33a09f,_)
		AND
		DB_CAMP_Shadowheart_LaezelFight_Hide(_Bed)
		THEN
		SetOnStage(_Bed,1);
		//END_REGION
		
		//REGION Specific Night Logic - Shadowheart_WildMagic
		IF
		DialogStarted(FOR_MoonhavenJournal_OM_ShadowHeart_8de50f1d-aaaf-fb50-0bcf-064f80fbe9bc,_)
		THEN
		PROC_CampNight_ForceComplete(NIGHT_ShadowHeart_WildMagic_5ce39313-f4bc-4aba-a51e-bfb9cd9ecfd1);
		//END_REGION
		
		//REGION Requirement for Astarion Tasting Party
		// only can be triggered with the player who was targeted by Astarion
		// Astarion should be in party with that character
		IF
		DB_Camp_AstarionBiteNightTarget(_Target)
		AND
		DB_CAMP_TastingParty_PotentialTargets(_Target)
		THEN
		NOT DB_CAMP_TastingParty_PotentialTargets(_Target);
		
		PROC
		PROC_Camp_PlayCampNight()
		AND
		DB_GlobalFlag((FLAG)ORI_Astarion_Knows_Vampireness_43c71ab0-1aca-484a-950d-54106ae46da5)
		AND
		DB_Camp_AstarionBiteNightTarget(_)
		AND
		NOT DB_GlobalFlag((FLAG)NIGHT_Astarion_TastingParty_52c2c940-2645-4cf9-9991-758a579fc7bd)
		AND
		NOT DB_GlobalFlag((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121)
		AND
		NOT DB_GlobalFlag((FLAG)NIGHT_GoblinHunt_RaiderCelebration_86fee25f-1069-4f17-89fa-4c5b69f82e0b)
		THEN
		PROC_CAMP_Astarion_CheckRequirementsForTastingParty();
		
		PROC
		PROC_CAMP_Astarion_CheckRequirementsForTastingParty()
		THEN
		PROC_GlobalClearFlagAndCache((FLAG)ORI_Astarion_State_InPartyWithBiteTarget_cb2eda5a-2443-4cb4-9c85-5359fd68cac2);
		PROC_GlobalClearFlagAndCache((FLAG)ORI_Astarion_State_TwoTargetsForTastingPartyInCamp_03853625-f648-4162-93d5-043b86cd7e74);
		
		PROC
		PROC_CAMP_Astarion_CheckRequirementsForTastingParty()
		AND
		DB_CAMP_TastingParty_PotentialTargetsInCamp(_Target)
		THEN
		NOT DB_CAMP_TastingParty_PotentialTargetsInCamp(_Target);
		
		PROC
		PROC_CAMP_Astarion_CheckRequirementsForTastingParty()
		AND
		DB_Camp_AstarionBiteNightTarget(_Target)
		AND
		GetReservedUserID(_Target, _UserID)
		AND
		GetReservedUserID((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, _UserID)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)ORI_Astarion_State_InPartyWithBiteTarget_cb2eda5a-2443-4cb4-9c85-5359fd68cac2);
		
		PROC
		PROC_CAMP_Astarion_CheckRequirementsForTastingParty()
		AND
		DB_CAMP_TastingParty_PotentialTargets(_Target)
		AND
		DB_OriginCampFlags(_Target, _CampFlag, _, _, _, _)
		AND
		DB_GlobalFlag(_CampFlag)
		THEN
		DB_CAMP_TastingParty_PotentialTargetsInCamp((CHARACTER)_Target);
		
		PROC
		PROC_CAMP_Astarion_CheckRequirementsForTastingParty()
		AND
		SysCount("DB_CAMP_TastingParty_PotentialTargetsInCamp", 1, _Count)
		AND
		_Count >= 2
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)ORI_Astarion_State_TwoTargetsForTastingPartyInCamp_03853625-f648-4162-93d5-043b86cd7e74);
		
		IF
		TextEvent("tp_check")
		THEN
		PROC_CAMP_Astarion_CheckRequirementsForTastingParty();
		//END_REGION Requirement for Astarion Tasting Party
		
		//REGION Requirement for ScarReading night for Astarion
		IF
		FlagSet((FLAG)ORI_Astarion_Knows_ScarsIsCazadorPoem_Character_ef171c6f-5376-275c-732c-823351d3102f, _, _)
		THEN
		SetFlag((FLAG)ORI_Astarion_Knows_ScarsIsCazadorPoem_Global_e0384248-60ef-4ed3-9bbe-d751461c93b8);
		//END_REGION Requirement for ScarReading night for Astarion
		
		//REGION Sound
		PROC
		PROC_CampNight_CallAudioNotifications()
		THEN
		PROC_CampNight_OwlBearCub_Sound();
		PROC_CampNight_Dog_Sound();
		
		//The owlbear only appears at night even if the flag is set during the day
		PROC
		PROC_CampNight_OwlBearCub_Sound()
		AND
		NOT DB_OnlyOnce("CAMP_Sound_UI_HUD_Camp_AnimalNotification_Owlbear")
		AND
		DB_GlobalFlag((FLAG)GOB_ChickenChase_State_OwlbearAcquired_da704027-02ea-717c-4390-f538e5e5cd7a)
		AND
		DB_Camp_QueuedNight((FLAG)NIGHT_OwlbearCub1_43696ea8-3bff-440d-bee8-9cd912e4e8b4)
		AND
		DB_Players(_Player)
		AND
		DB_InRegion(_Player, S_CAMP_Area_e5de9394-f3a1-4d6f-889a-271cd3f53985)
		AND
		QRY_OnlyOnce("CAMP_Sound_UI_HUD_Camp_AnimalNotification_Owlbear")
		THEN
		PlayHUDSound(_Player,"UI_HUD_Camp_AnimalNotification_Owlbear");
		
		//Call Dog sound during day as well
		IF
		TeleportedToCamp(_Player)
		AND
		NOT DB_Camp_NightMode(1)
		THEN
		PROC_CampNight_Dog_Sound();
		 
		PROC
		PROC_CampNight_Dog_Sound()
		AND
		NOT DB_OnlyOnce("CAMP_Sound_UI_HUD_Camp_AnimalNotification_Dog")
		AND
		DB_Players(_Player)
		AND
		DB_InRegion(_Player, S_CAMP_Area_e5de9394-f3a1-4d6f-889a-271cd3f53985)
		AND
		DB_GlobalFlag((FLAG)CAMP_Courier_Dog_Moved2Camp_7dcb7732-1c76-463a-bec9-251f30860e6c)
		AND
		QRY_OnlyOnce("CAMP_Sound_UI_HUD_Camp_AnimalNotification_Dog")
		THEN
		PlayHUDSound(_Player,"UI_HUD_Camp_AnimalNotification_Dog");
		//END_REGION
	}
	EXIT
	{
	}
}
