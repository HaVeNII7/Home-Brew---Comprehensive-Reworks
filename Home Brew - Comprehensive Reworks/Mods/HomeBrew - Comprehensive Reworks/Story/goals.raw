		THEN
		PROC_LOW_OskarsBeloved_JannathRunToOskarDead();
		
		PROC
		PROC_LOW_OskarsBeloved_JannathRunToOskarDead()
		AND
		NOT DB_PermaDefeated(S_LOW_Jannath_f64fa57e-8061-4eb4-8d46-1ac743e1852d)
		AND
