		PROC
		PROC_LOW_OskarsBeloved_StopPossession()
		AND
		IsOnStage(S_LOW_FlyingStatue_4b2c1831-6f04-4c62-bca2-af343f7db692,1)
		THEN
		PROC_Poof(S_LOW_FlyingStatue_4b2c1831-6f04-4c62-bca2-af343f7db692);
		
		PROC
