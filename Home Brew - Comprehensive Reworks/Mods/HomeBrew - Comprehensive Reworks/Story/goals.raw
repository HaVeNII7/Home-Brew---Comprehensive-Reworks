		DB_GlobalFlagReactionAfterDialog((FLAG)TWN_ArabellaPowers_State_StayedAtTown_58722b05-d7d2-5199-6ae1-937ae5b91b2b, TWN_ArabellasPowers_TownIntroduction_78c6743c-ff1d-386c-2205-209edaae1a06);
		
