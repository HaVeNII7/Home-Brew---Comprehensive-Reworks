Goal(152).Title("Act1_FOR_Monitor");
Goal(152)
{
	INIT
	{
		PROC_TriggerRegisterForPlayers(S_FOR_CambionDinnerAdd_beef42a3-d14d-4f2f-acf9-e0573f0e6e2e);
		
		//REGION Candles
		DB_FOR_Monitor_Candles((ITEM)S_FOR_CambionHearth_b781e423-dea9-4421-8ff2-a1417eacccaf);
		
		DB_FOR_Monitor_Candles((ITEM)S_FOR_Monitor_Candle_000_a419e4ad-8aee-47e5-a6f3-e1734d5f02e9);
		DB_FOR_Monitor_Candles((ITEM)S_FOR_Monitor_Candle_001_281553d5-08f2-4391-ace5-890d3a5276b8);
