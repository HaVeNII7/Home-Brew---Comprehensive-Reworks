		DB_GLO_CharacterCorpseDialog((CHARACTER)S_WYR_Flophouse_Mother_804e21a1-aea8-4bc7-a318-3de0b82404df, (DIALOGRESOURCE)WYR_Flophouse_Mother_Dead_bdb18b05-9c33-d636-2a8b-cb18afb44f81);
		
		DB_OneShotPlayerTrigger((TRIGGER)S_WYR_Flophouse_KillersLair_0791081e-aaae-46ee-ba27-50a6562fdef8);
		PROC_SetOnStage(S_WYR_Flophouse_Mother_804e21a1-aea8-4bc7-a318-3de0b82404df, 0);
		
		DB_WYR_Flophouse_Drawings((ITEM)S_WYR_Flophouse_TemplePlans_c1b085a2-0056-4dc3-869c-413c130362de, (DIALOGRESOURCE)WYR_Flophouse_PAD_TemplePlans_6fa7564c-5083-888a-1def-01454648a58d);
		
		DB_PerceptionSkillCustomAD((ITEM)S_WYR_Flophouse_Blood_17942808-1666-40a6-b150-0206a11c0058, (DIALOGRESOURCE)WYR_Flophouse_PAD_Blood_d92ad50e-36e8-222b-46ce-5b8c5fceccee);
		
		DB_HasItemTemplateScriptFlag(1, (DIALOGRESOURCE)WYR_SharessCaress_HollyphantDetective_710444e8-5786-08e5-a1b3-2d2c2a1b88b5, UNI_LOW_TargetList_4ece815c-aff2-45c3-8b07-dd3a04454243, 2);
		DB_ItemOwnerShipTriggers("BGO_Main_A", (TRIGGER)S_WYR_Flophouse_OwnershipTrigger_5ccd34d8-993b-4652-91d6-ee3010e55974, (CHARACTER)S_WYR_Flophouse_Janitor_baa78148-4111-47f3-ae72-502a3818fa75);
		DB_ItemOwnerShipTriggers("BGO_Main_A", (TRIGGER)S_WYR_Flophoouse_Ownership_2_fb323e26-7f35-4e7d-925c-4927356c1ff9, (CHARACTER)S_WYR_Flophouse_Janitor_baa78148-4111-47f3-ae72-502a3818fa75);
		DB_ItemOwnerShipClearItem("BGO_Main_A", (ITEM)S_DOOR_FlophouseKitchen_b618fde6-4c65-46fc-9b66-d9556dde8743);
		
		DB_DoNotFace(S_WYR_VampireSpawns_Dalyria_204a74d2-e6ad-4e9b-a275-f03cb5f3d975);
		DB_DoNotFace(S_WYR_VampireSpawns_Petra_6fb6e85e-ccd0-42ef-a37d-1e256a433f3b);
		
		//REGION Debug
		DB_Debug_WYR_Keys("fp_key1", (ITEM)S_WYR_Flophouse_FlowerKey_001_088989f1-3dce-46a1-a2fe-69b5181140d7);
		DB_Debug_WYR_Keys("fp_key2", (ITEM)S_WYR_Flophouse_FlowerKey_002_e9c14645-c52b-4c0d-b928-aaa84ba043a4);
		DB_Debug_WYR_Keys("fp_key3", (ITEM)S_WYR_Flophouse_FlowerKey_003_9996f9dd-d0e4-40a4-aef2-000f76449c8e);
		DB_Debug_WYR_Keys("fp_key4", (ITEM)S_WYR_Flophouse_FlowerKey_004_d9b7ec6c-1cfa-4c49-8999-8d2fba1e0306);
		DB_Debug_WYR_Keys("fp_key5", (ITEM)S_WYR_Flophouse_FlowerKey_005_461f5a98-a562-4eff-873f-879e304e41f8);
		DB_Debug_WYR_Keys("fp_key6", (ITEM)S_WYR_Flophouse_FlowerKey_006_66ce4fe6-4221-4c85-8510-a73c488b31b9);
		DB_Debug_WYR_Keys("fp_key7", (ITEM)S_WYR_Flophouse_FlowerKey_007_7cd80962-0e47-4cbb-9432-76493261186d);
		DB_Debug_WYR_Keys("fp_key8", (ITEM)S_WYR_Flophouse_FlowerKey_008_e1d08756-f239-4c44-9b4e-5ac07bfbd0b9);
		DB_Debug_WYR_Keys("fp_key9", (ITEM)S_WYR_Flophouse_FlowerKey_009_896952b3-ae61-4a22-be68-9e80979f5ee1);
		//END_REGION
		
		//REGION JournalINIT
		
		// Open hand
		PROC_TriggerRegisterForPlayers(S_WYR_Flophouse_FlowerTrigger_c93fb7b7-9807-4b72-b9a7-71ca9f79e524);
		DB_QuestDef_State((FLAG)WYR_SerialKiller_State_ValeriaSendToDevella_65f1a97d-1656-da36-6417-be1e44a87663, "WYR_OpenHandMurder", "WYR_ConvinceAnnoyingElephant_GoToDevella");
		DB_QuestDef_State((FLAG)WYR_OpenHand_State_ValeriaKnowsBrilgorInnocent_c395112d-e882-4a94-ab67-d0f624cd1ba9, "WYR_OpenHandMurder", "WYR_FinishMurderTribunal");
		DB_QuestDef_LevelLoaded("WYR_OpenHandMurder", "WYR_Endgame_DarkUrge", "END_Main");
		
		// Find Ffion
		DB_QuestDef_State((FLAG)END_General_State_Started_a0fd5f91-e4b3-4d01-84d3-9ff484139e99, "WYR_RedDwarfMother", "ReachedEnd");
		DB_QuestDef_State((FLAG)WYR_Mamzell_State_RecommendedDrow_7d3268b5-c8c3-e645-731b-eb105bb0589b, "WYR_RedDwarfMother", "Rewarded");
		DB_QuestDef_PermaDefeatedState("WYR_RedDwarfMother", "MamzellPermaDefeated", S_WYR_SharessCaress_Mamzell_fff7fecf-d6c0-478d-92fb-3aa854298cd2);
		//END_REGION JournalINIT
		
		TriggerRegisterForCharacter((TRIGGER)S_WYR_Flophouse_SUB_15e088a7-43db-417b-878d-e2121783a6aa, (CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255);
	}
	KB
	{
		//REGION Flowers Keys in the main room
		IF
		TemplateAddedTo(PUZ_GEN_Key_Flower_A_837fd379-2765-4436-a1d7-f0535a69effe, _, (CHARACTER)_Player, _)
		AND
		DB_Players(_Player)
		AND
		DB_GlobalFlag(WYR_OpenHand_State_PickedUpBloodiedKey_c3e0ca6c-32e9-47f6-8a54-b362ad43079a)
		AND
		QRY_OnlyOnce("WYR_Flophouse_PAD_FlowerKey")
		THEN
		PROC_WYR_SerialKiller_PlayKeyPAD(WYR_Flophouse_PAD_FlowerKey_c88d9efe-df59-599d-0bcb-f098814285de, _Player);
		
		PROC
		PROC_WYR_SerialKiller_PlayKeyPAD((DIALOGRESOURCE)_PAD, (CHARACTER)_Player)
		AND
		QRY_OnlyOnce("WYR_SerialKiller_KeyPAD")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)_PAD, _Player);
		//END_REGION Flowers Keys in the main room
		
		//REGION Secret Room
		// To access Dolor's room you need to unlock his door. However, it's hidden behind a wardrobe. Wardrobe is locked. The door is also locked.
		// If you unlock the wardrobe, it should also unlock the door.
		// If you unlock the door, it should also unlock the wardrobe (for example, you teleported inside the room without unlocking the wardrobe)
		// If the wardrobe is unlocked and you click on it you get teleported inside the room.
		// If the door is unlocked and wardrobe is not destroyed and you click on the door - you get teleported outside the room.
		// If you destroy the wardrobe then the door stops functioning as a teleporter and starts working as a regular door
		
		// Door -> Wardrobe
		PROC
		PROC_BlockUseOfItem(_Player, (ITEM)S_WYR_Flophouse_SecretDoor_4f29f629-5ab2-414c-a8a8-d64f1cde75b8)
		AND
		IsDestroyed((ITEM)S_WYR_Flophouse_SecretWardrobe_9da01dcb-0501-4125-9855-ce69ecc86df3, 0)
		AND
		IsLocked((ITEM)S_WYR_Flophouse_SecretDoor_4f29f629-5ab2-414c-a8a8-d64f1cde75b8, 0)
		THEN
		DB_CustomUseItemResponse(_Player, (ITEM)S_WYR_Flophouse_SecretDoor_4f29f629-5ab2-414c-a8a8-d64f1cde75b8, 0);
		TeleportTo(_Player, S_WYR_Flophouse_OutsideSecretRoom_e3195168-6493-4c9c-b67b-f6ce35a7f2ec, "WYR_Flophouse_DolorsRoomTeleport", 1, 1, 1, 0, 1);
		
		PROC
		PROC_BlockUseOfItem(_Player, (ITEM)S_WYR_Flophouse_SecretDoor_4f29f629-5ab2-414c-a8a8-d64f1cde75b8)
		AND
		IsDestroyed((ITEM)S_WYR_Flophouse_SecretWardrobe_9da01dcb-0501-4125-9855-ce69ecc86df3, 0)
		AND
		IsLocked((ITEM)S_WYR_Flophouse_SecretDoor_4f29f629-5ab2-414c-a8a8-d64f1cde75b8, 1)
		AND
		NOT QRY_ItemInMagicPockets(_Player, S_WYR_OpenHand_ShiftersFlowerKey_8ab130ef-4fad-4bfe-b667-f4a73c1c36c0)
		THEN
		DB_NOOP(1); // default behavior -> can't open the door
		
		PROC
		PROC_BlockUseOfItem(_Player, (ITEM)S_WYR_Flophouse_SecretDoor_4f29f629-5ab2-414c-a8a8-d64f1cde75b8)
		AND
		IsDestroyed((ITEM)S_WYR_Flophouse_SecretWardrobe_9da01dcb-0501-4125-9855-ce69ecc86df3, 0)
		AND
		IsLocked((ITEM)S_WYR_Flophouse_SecretDoor_4f29f629-5ab2-414c-a8a8-d64f1cde75b8, 1)
		AND
		QRY_ItemInMagicPockets(_Player, S_WYR_OpenHand_ShiftersFlowerKey_8ab130ef-4fad-4bfe-b667-f4a73c1c36c0)
		AND
		QRY_OnlyOnce("WYR_Flophouse_PAD_BloodiedFlowerKeyUsed")
		THEN
		DB_CustomUseItemResponse(_Player, (ITEM)S_WYR_Flophouse_SecretDoor_4f29f629-5ab2-414c-a8a8-d64f1cde75b8, 0);
		TeleportTo(_Player, S_WYR_Flophouse_OutsideSecretRoom_e3195168-6493-4c9c-b67b-f6ce35a7f2ec, "WYR_Flophouse_DolorsRoomTeleportWithKey", 1, 1, 1, 0, 1);
		
		IF
		EntityEvent(_Player, "WYR_Flophouse_DolorsRoomTeleport")
		AND
		QRY_OnlyOnce("WYR_Flophouse_DolorsRoomTeleport")
		THEN
		PROC_WYR_Flophouse_UnlockDolorsRoom();
		
		IF
		EntityEvent(_Player, "WYR_Flophouse_DolorsRoomTeleportWithKey")
		AND
		QRY_OnlyOnce("WYR_Flophouse_DolorsRoomTeleportWithKey")
		THEN
		PROC_WYR_Flophouse_UnlockDolorsRoom();
		PROC_TryStartAD((DIALOGRESOURCE)WYR_Flophouse_PAD_BloodiedFlowerKeyUsed_85d3dcd8-78ac-64e1-2b9e-51a1e99681b3, _Player);
		
		PROC
		PROC_WYR_Flophouse_UnlockDolorsRoom()
		AND
		IsLocked((ITEM)S_WYR_Flophouse_SecretDoor_4f29f629-5ab2-414c-a8a8-d64f1cde75b8, 1)
		THEN
		Unlock((ITEM)S_WYR_Flophouse_SecretDoor_4f29f629-5ab2-414c-a8a8-d64f1cde75b8);
		
		PROC
		PROC_WYR_Flophouse_UnlockDolorsRoom()
		AND
		IsLocked((ITEM)S_WYR_Flophouse_SecretWardrobe_9da01dcb-0501-4125-9855-ce69ecc86df3, 1)
		THEN
		Unlock((ITEM)S_WYR_Flophouse_SecretWardrobe_9da01dcb-0501-4125-9855-ce69ecc86df3);
		
		PROC
		PROC_OneShotTriggerEntered(_Player, S_WYR_Flophouse_KillersLair_0791081e-aaae-46ee-ba27-50a6562fdef8)
		THEN
		SetFlag((FLAG)LOW_SerialKiller_State_LairDiscovered_eff76e55-2409-4318-b036-dd8693686aa9, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		UseStarted(_Player, _Item)
		AND
		DB_WYR_Flophouse_Drawings(_Item, _PAD)
		THEN
		PROC_TryStartAD(_PAD, _Player);
		
		IF
		DestroyingBy(S_WYR_Flophouse_KillersBed_9e7a4562-f03e-4bf3-8835-4a9ab7276d1d, _, _, _)
		THEN
		SetEntityEvent(S_WYR_Flophouse_Blood_17942808-1666-40a6-b150-0206a11c0058, "StoryCancel");
		TeleportTo(S_WYR_Flophouse_Mother_804e21a1-aea8-4bc7-a318-3de0b82404df, S_WYR_Flophouse_Mother_UnderBedPos_6ebbee20-ad97-4924-b26a-aa4c401af707, "WYR_Flophouse_FionnTeleported");
		
		IF
		EntityEvent(S_WYR_Flophouse_Mother_804e21a1-aea8-4bc7-a318-3de0b82404df, "WYR_Flophouse_FionnTeleported")
		THEN
		SetFlag((FLAG)WYR_Flophouse_State_FoundMother_db3f08a3-0365-498f-a12d-6d39feb6e1aa);
		
		// this flag set either in the dialog or after you simply destroyed the bed
		IF
		FlagSet((FLAG)WYR_Flophouse_State_FoundMother_db3f08a3-0365-498f-a12d-6d39feb6e1aa, NULL_00000000-0000-0000-0000-000000000000, _)
		THEN
		PROC_ClearCorpseOwner((CHARACTER)S_WYR_Flophouse_Mother_804e21a1-aea8-4bc7-a318-3de0b82404df);
		PROC_SetOnStage(S_WYR_Flophouse_Mother_804e21a1-aea8-4bc7-a318-3de0b82404df, 1);
		//END_REGION Secret Room
		
		//REGION Journal
		// Open Hand Murder
		PROC
		PROC_WYR_SerialKiller_PlayKeyPAD(WYR_Flophouse_PAD_FlowerKey_c88d9efe-df59-599d-0bcb-f098814285de, _)
		AND
		QRY_QuestUpdateIsUnlockedForAny("WYR_OpenHandMurder", "FindKeyOrigin")
		THEN
		QuestUpdate("WYR_OpenHandMurder", "FollowTheKeyBecauseKey");
		
		IF
		EnteredTrigger(_Player, S_WYR_Flophouse_FlowerTrigger_c93fb7b7-9807-4b72-b9a7-71ca9f79e524)
		AND
		QRY_QuestUpdateIsUnlockedForAny("WYR_OpenHandMurder", "FindKeyOrigin")
		THEN
		PROC_TryStartAD(GLO_PerceptionSuccess_48825dbe-a320-7c4c-fe3e-372b717d5bc9, _Player);
		QuestUpdate("WYR_OpenHandMurder", "FollowTheKeyBecauseFlophouse");
		PROC_TriggerUnregisterForPlayers(S_WYR_Flophouse_FlowerTrigger_c93fb7b7-9807-4b72-b9a7-71ca9f79e524);
		
		IF
		AddedTo(S_WYR_OpenHand_ShiftersFlowerKey_8ab130ef-4fad-4bfe-b667-f4a73c1c36c0, _Player, _)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		DB_WasInRegion(_Player, S_WYR_Flophouse_KillersLair_0791081e-aaae-46ee-ba27-50a6562fdef8)
		AND
		NOT DB_GlobalFlag(LOW_SerialKiller_Knows_TargetList_262314d1-43bf-4ea5-ae23-4a77bfab2671)
		THEN
		QuestUpdate("WYR_OpenHandMurder", "FollowTheKeyBecauseAlradyEnterLair");
		
		IF
		DB_GlobalFlag((FLAG)LOW_SerialKiller_Knows_TargetList_262314d1-43bf-4ea5-ae23-4a77bfab2671)
		AND
		NOT QRY_WYR_OpenHand_TalkedYannis()
		THEN
		QuestUpdate("WYR_OpenHandMurder", "GettingTargetList");
		
		IF
		DB_GlobalFlag((FLAG)LOW_SerialKiller_Knows_TargetList_262314d1-43bf-4ea5-ae23-4a77bfab2671)
		AND
		QRY_WYR_OpenHand_TalkedYannis()
		THEN
		QuestUpdate("WYR_OpenHandMurder", "TargetListMeetValeria");
		
		IF
		DB_PermaDefeated(S_GLO_HollyphantDetective_acf70307-3bb9-4b91-b894-fa2120916f58)
		AND
		DB_QuestIsOpened("WYR_OpenHandMurder")
		THEN
		QuestUpdate("WYR_OpenHandMurder", "WYR_ValeriaIsDead");
		
		// WYR_RedDwarfMother
		// FoundClues
		IF
		GameBookInterfaceClosed(S_WYR_SharessCaress_LibrarianJournal_a8ccd594-470f-42c6-a729-b2588422ab06, _)
		AND
		DB_QuestIsAccepted("WYR_RedDwarfMother")
		THEN
		QuestUpdate("WYR_RedDwarfMother", "FoundClues");
		
		IF
		GameBookInterfaceClosed(S_WYR_SharessCaress_LibrarianJournal_a8ccd594-470f-42c6-a729-b2588422ab06, _)
		AND
		NOT DB_QuestIsAccepted("WYR_RedDwarfMother")
		THEN
		DB_WYR_Flohhouse_RedDwarfMother_HoldQuestUpdates("FoundClues");
		
		// ReadDiary
		IF
		GameBookInterfaceClosed(S_WYR_Flophouse_MothersDiary_a4eaa138-91dd-41d7-b0ae-4ee1ad743d04, _)
		AND
		DB_QuestIsAccepted("WYR_RedDwarfMother")
		THEN
		QuestUpdate("WYR_RedDwarfMother", "ReadDiary");
		
		IF
		GameBookInterfaceClosed(S_WYR_Flophouse_MothersDiary_a4eaa138-91dd-41d7-b0ae-4ee1ad743d04, _)
		AND
		NOT DB_QuestIsAccepted("WYR_RedDwarfMother")
		THEN
		DB_WYR_Flohhouse_RedDwarfMother_HoldQuestUpdates("ReadDiary");
		
		// FoundCorpse_Knew
		IF
		FlagSet(WYR_Flophouse_State_FoundMother_db3f08a3-0365-498f-a12d-6d39feb6e1aa,_,_)
		AND
		DB_QuestIsAccepted("WYR_RedDwarfMother")
		THEN
		QuestUpdate("WYR_RedDwarfMother", "FoundCorpse_Knew");
		
		IF
		FlagSet(WYR_Flophouse_State_FoundMother_db3f08a3-0365-498f-a12d-6d39feb6e1aa,_,_)
		AND
		NOT DB_QuestIsAccepted("WYR_RedDwarfMother")
		THEN
		DB_WYR_Flohhouse_RedDwarfMother_HoldQuestUpdates("FoundCorpse_Knew");
		
		// Starting the quest from flophouse patrons
		IF
		FlagSet(WYR_Flophouse_Cook_Event_KnowsFfionDead_cbcb0e1b-a49f-41eb-6b9e-c7c47331a230,_,_)
		AND
		NOT DB_PermaDefeated(S_WYR_SharessCaress_Mamzell_fff7fecf-d6c0-478d-92fb-3aa854298cd2)
		THEN
		QuestUpdate("WYR_RedDwarfMother", "FoundCorpse_DidntKnow");
		
		IF
		FlagSet(WYR_Flophouse_Janitor_Event_KnowsFfionDead_cfaf2473-45df-a7a6-1b22-1db93e65175b,_,_)
		AND
		NOT DB_PermaDefeated(S_WYR_SharessCaress_Mamzell_fff7fecf-d6c0-478d-92fb-3aa854298cd2)
		THEN
		QuestUpdate("WYR_RedDwarfMother", "FoundCorpse_DidntKnow");
		
		// Starting the quest from Mamzell
		IF
		FlagSet((FLAG)WYR_SharessCaress_FindingFionn_State_AcceptedQuest_148d7a7b-95d6-14cc-0436-4a1e4129a099, _,_)
		THEN
		QuestUpdate("WYR_RedDwarfMother", "LearnedMissing");
		
		IF
		FlagSet((FLAG)WYR_SharessCaress_FindingFionn_State_AcceptedQuest_148d7a7b-95d6-14cc-0436-4a1e4129a099, _,_)
		AND
		DB_WYR_Flohhouse_RedDwarfMother_HoldQuestUpdates(_HeldQuestUpdate)
		THEN
		NOT DB_WYR_Flohhouse_RedDwarfMother_HoldQuestUpdates(_HeldQuestUpdate);
		QuestUpdate("WYR_RedDwarfMother", _HeldQuestUpdate);
		
		//NotRewarded
		IF
		DialogEnded((DIALOGRESOURCE)WYR_SharessCaress_Taproom_Mamzell_fabd9025-999d-3f1b-a9f9-cac645c599c4,_)
		AND
		DB_GlobalFlag((FLAG)WYR_Mamzell_Knows_FfionnDead_aa6c9b49-5d59-4143-9660-6ce4fd879d8e)
		AND
		DB_QuestIsOpened("WYR_RedDwarfMother")
		THEN
		QuestUpdate("WYR_RedDwarfMother", "NotRewarded");
		//END_REGION Journal
		
		//REGION Astarion's PAD
		IF
		EnteredTrigger((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, (TRIGGER)S_WYR_Flophouse_SUB_15e088a7-43db-417b-878d-e2121783a6aa)
		THEN
		TriggerUnregisterForCharacter((TRIGGER)S_WYR_Flophouse_SUB_15e088a7-43db-417b-878d-e2121783a6aa, (CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255);
		PROC_TryStartAD((DIALOGRESOURCE)WYR_VampireSpawns_PAD_HuntingGround_bb424453-3163-2465-714b-9afb7591a4b2, S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255);
		//END_REGION
		
		//REGION Debug
		IF
		TextEvent("sk_list")
		AND
		GetHostCharacter(_Player)
		THEN
		ToInventory(S_WYR_Flophouse_TargetList_a97afb67-9c29-49f9-b298-c41311868a78, _Player, 1, 1, 1);
		
		IF
		TextEvent(_TextEvent)
		AND
		DB_Debug_WYR_Keys(_TextEvent, _Key)
		AND
		GetHostCharacter(_Player)
		THEN
		ToInventory(_Key, _Player, 1, 1, 1);
		//END_REGION
	}
	EXIT
	{
	}
}
