Goal(496).Title("Act3_GEN_FlorrickExecution");
Goal(496)
{
	INIT
	{
		DB_LOW_BasiliskGate_FlorrickExecution_CountDownDays(5);
		
		//signature DB_Act3_FlorrickExecution_Hangmen(_Npc, _BaseCharacterRoot, _HangedCharacterRoot, _HangingSpot, _InvisiblePedestal, _CanBeHanged, _Phase) 
		//_Phase can be 0 = nothing, 1 = hanging, 2 = hanged body was meddled with
		DB_Act3_FlorrickExecution_Hangmen((GUIDSTRING)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9,
			(CHARACTERROOT)S_GLO_Desire_58f75d85-2b4c-4a66-a67d-adbd264cfe95,
			(CHARACTERROOT)S_GLO_Desire_HangedPhysics_e7b4bc5b-3ca5-4579-8a54-2de1075cf5a3, 
			(TRIGGER)S_LOW_BasiliskGate_FlorrickExecution_HangingSpot_Florrick_343dfb1c-7175-42c6-bca7-dc53cc46c617, 
			(ITEM)S_LOW_BasiliskGate_FlorrickExecution_HangingSupport_Florrick_d93cdd3f-4fac-49ec-8cd5-2eb9d04bc522, 
			1,
			0);
		DB_Act3_FlorrickExecution_Hangmen((GUIDSTRING)S_LOW_BasiliskGate_FlorricksCoHangman_01_bb541277-bc52-4d5f-95f3-e7f5e62eeeeb, 
			(CHARACTERROOT)LOW_BasiliskGate_HumanMaleHanging_01_fe6fc02a-a73f-4836-b976-e23d5e057e8d,
			(CHARACTERROOT)LOW_BasiliskGate_HumanMaleHanging_01_HangedPhysics_14c3b132-214c-42c4-97ea-b6e03b8f61d9, 
			(TRIGGER)S_LOW_BasiliskGate_FlorrickExecution_HangingSpot_01_acf2dc0b-0ffa-44ae-a232-70f41ddf914b, 
			(ITEM)S_LOW_BasiliskGate_FlorrickExecution_HangingSupport_01_c5c22ded-c7a9-41f8-bea0-7e4d0da472d3, 
			1, 
			0);
		DB_Act3_FlorrickExecution_Hangmen((GUIDSTRING)S_LOW_BasiliskGate_FlorricksCoHangman_02_35aca423-db49-4308-acf3-e16c831d565c,
			(CHARACTERROOT)LOW_BasiliskGate_HumanMaleHanging_02_002827e6-8b00-42f4-b679-1e9b9140c23d, 
			(CHARACTERROOT)LOW_BasiliskGate_HumanMaleHanging_02_HangedPhysics_e66901d5-8a8f-4def-be48-d0981c7cef18, 
			(TRIGGER)S_LOW_BasiliskGate_FlorrickExecution_HangingSpot_02_bd93a80d-bbaa-4b0d-8464-fdeb47db29e4, 
			(ITEM)S_LOW_BasiliskGate_FlorrickExecution_HangingSupport_02_03b0622e-c16e-48be-aa42-13e2d9013035, 
			1, 
			0);
		
		SetOnStage(S_LOW_BasiliskGate_FlorricksCoHangman_01_bb541277-bc52-4d5f-95f3-e7f5e62eeeeb, 0);
		SetOnStage(S_LOW_BasiliskGate_FlorricksCoHangman_02_35aca423-db49-4308-acf3-e16c831d565c, 0);
		
		DB_Act3_FlorrickExecution_MeddleWithHangedBody_DamageTypeWhitelist("Psychic");
		DB_Act3_FlorrickExecution_MeddleWithHangedBody_DamageTypeWhitelist("Necrotic");
		DB_Act3_FlorrickExecution_MeddleWithHangedBody_DamageTypeWhitelist("Poison");
	}
	KB
	{
		//REGION counting down days to execution on long rests
		PROC
		PROC_LongRest()
		AND
		DB_GlobalFlag(LOW_BasiliskGate_State_FlorrickExecutionKnown_aff10649-cfc1-b6d0-0984-5572383cda0a)
		AND
		DB_LOW_BasiliskGate_FlorrickExecution_CountDownDays(_PrevDays)
		AND
		IntegerSubtract(_PrevDays,1,_CurrentDays)
		AND
		NOT QRY_LOW_BasiliskGate_FlorrickExecution(_CurrentDays)
		THEN
		NOT DB_LOW_BasiliskGate_FlorrickExecution_CountDownDays(_PrevDays);
		DB_LOW_BasiliskGate_FlorrickExecution_CountDownDays(_CurrentDays);
		PROC_FlorrickExecution_ReinstatePosters(); //does stuff only if CTY is loaded
		
		IF //dialog with florrick in prison - set the right days remaining value
		DialogStarted(WYR_WyrmRockPrison_Florrick_40d9f384-7637-91b7-01aa-556a76ac20e1, _)
		AND
		DB_LOW_BasiliskGate_FlorrickExecution_CountDownDays(_Days)
		THEN
		DialogSetVariableInt((DIALOGRESOURCE)WYR_WyrmRockPrison_Florrick_40d9f384-7637-91b7-01aa-556a76ac20e1,"LOW_BasiliskGate_FlorrickExecutionCountdownDays_55b150cf-4040-e2b3-89e4-ba2737fbbe01",_Days);
		//END_REGION
		
		//REGION disable Florrick hanging (others still get executed)
		IF 
		DB_GlobalFlag(WYR_WyrmRockPrison_State_FlorrickEscaped_a84a5b16-ca29-43c3-91bf-17def670ba07)
		AND
		DB_Act3_FlorrickExecution_Hangmen(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _BaseCharacterRoot, _HangedCharacterRoot, _HangingSpot, _InvisiblePedestal, 1, 0) 
		THEN
		PROC_Act3_FlorrickExecution_DisableFlorrickHanging();
		
		IF
		DB_PermaDefeated(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9)
		AND
		DB_Act3_FlorrickExecution_Hangmen(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _BaseCharacterRoot, _HangedCharacterRoot, _HangingSpot, _InvisiblePedestal, 1, 0) 
		THEN
		PROC_Act3_FlorrickExecution_DisableFlorrickHanging();
		
		PROC
		PROC_Act3_FlorrickExecution_DisableFlorrickHanging()
		AND
		DB_Act3_FlorrickExecution_Hangmen(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _BaseCharacterRoot, _HangedCharacterRoot, _HangingSpot, _InvisiblePedestal, 1, 0)
		THEN
		NOT DB_Act3_FlorrickExecution_Hangmen(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _BaseCharacterRoot, _HangedCharacterRoot, _HangingSpot, _InvisiblePedestal, 1, 0);
		DB_Act3_FlorrickExecution_Hangmen(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _BaseCharacterRoot, _HangedCharacterRoot, _HangingSpot, _InvisiblePedestal, 0, 0);
		//END_REGION
		
		//REGION The execution
		QRY //run the execution
		QRY_LOW_BasiliskGate_FlorrickExecution(0)
		AND
		DB_Act3_FlorrickExecution_Hangmen(_Npc, _BaseCharacterRoot, _HangedCharacterRoot, _HangingSpot, _InvisiblePedestal, 1, 0) 
		THEN
		SetOnStage(_Npc, 1);
		Transform(_Npc, _HangedCharacterRoot, (SHAPESHIFTRULE)Disguise_ceccc4eb-d774-4cd5-9147-12322b81b763);
		ApplyStatus(_Npc, "DIE_HANGING_TECHNICAL", -1.0, 1, NULL_00000000-0000-0000-0000-000000000000);
		NOT DB_Act3_FlorrickExecution_Hangmen(_Npc, _BaseCharacterRoot, _HangedCharacterRoot, _HangingSpot, _InvisiblePedestal, 1, 0);
		DB_Act3_FlorrickExecution_Hangmen(_Npc, _BaseCharacterRoot, _HangedCharacterRoot, _HangingSpot, _InvisiblePedestal, 1, 1);
		PROC_DieImmediate((CHARACTER)_Npc, DEATHTYPE.Physical, 0);
		PROC_GLO_Tutorials_TrackedTimerStart("Act3b_LOW_BasiliskGate_FlorrickExecution_DelayedTeleportToGallows", 100); //prevents blood spawn on death for Florrick 
		
		PROC
		PROC_GLO_Tutorials_TrackedTimerFinished("Act3b_LOW_BasiliskGate_FlorrickExecution_DelayedTeleportToGallows")
		AND
		DB_Act3_FlorrickExecution_Hangmen(_Npc, _, _, _HangingSpot, _, 1, 1) 
		THEN
		TeleportTo(_Npc, _HangingSpot);
		
		PROC
		PROC_GLO_Tutorials_TrackedTimerFinished("Act3b_LOW_BasiliskGate_FlorrickExecution_DelayedTeleportToGallows")
		AND
		DB_Act3_FlorrickExecution_Hangmen(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _, _, _, _, _, 1)
		THEN
		SetFlag(LOW_BasiliskGate_State_FlorrickExecuted_32a5fd87-95c0-255a-3473-ac288c798df8);
		PROC_BasiliskGate_FlorrickExecution_FlorrickExecuted();
		TriggerRegisterForCharacter((TRIGGER)S_LOW_BasiliskGate_FlorrickExecution_BodyPresenceCheckArea_46b08f47-5c64-4f98-8667-6d514bb2c0cc, S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9);
		
		PROC
		PROC_GLO_Tutorials_TrackedTimerFinished("Act3b_LOW_BasiliskGate_FlorrickExecution_DelayedTeleportToGallows")
		AND
		DB_LOW_BasiliskGate_FlorrickExecution_CountDownDays(_Val)
		THEN
		NOT DB_LOW_BasiliskGate_FlorrickExecution_CountDownDays(_Val);
		//END_REGION
		
		//REGION Meddling with the bodies
		PROC
		PROC_Act3_FlorrickExecution_CancelHangedState((GUIDSTRING)_HangedNpc)
		AND
		DB_Act3_FlorrickExecution_Hangmen(_HangedNpc, _BaseCharacterRoot, _HangedCharacterRoot, _HangingSpot, _InvisiblePedestal, _CanBeHanged, 1) 
		THEN
		SetOnStage(_InvisiblePedestal, 0);
		RemoveStatus(_HangedNpc, "DIE_HANGING_TECHNICAL");
		Transform(_HangedNpc, _BaseCharacterRoot, (SHAPESHIFTRULE)Disguise_ceccc4eb-d774-4cd5-9147-12322b81b763);
		NOT DB_Act3_FlorrickExecution_Hangmen(_HangedNpc, _BaseCharacterRoot, _HangedCharacterRoot, _HangingSpot, _InvisiblePedestal, _CanBeHanged, 1);
		DB_Act3_FlorrickExecution_Hangmen(_HangedNpc, _BaseCharacterRoot, _HangedCharacterRoot, _HangingSpot, _InvisiblePedestal, _CanBeHanged, 2);
		
		//picked up body
		IF
		AddedTo(_HangedNpc, _, _)
		AND
		DB_Act3_FlorrickExecution_Hangmen(_HangedNpc, _, _, _, _, _, 1)
		THEN
		PROC_Act3_FlorrickExecution_CancelHangedState(_HangedNpc);
		
		//moved body
		IF
		ForceMoveStarted(_, _HangedNpc, _)
		AND
		DB_Act3_FlorrickExecution_Hangmen(_HangedNpc, _, _, _, _, _, 1)
		THEN
		PROC_Act3_FlorrickExecution_CancelHangedState(_HangedNpc);
		
		//physically damaged the body
		IF
		AttackedBy(_HangedNpc, _, _, _DamageType, _DamageAmount, _, _)
		AND
		DB_Act3_FlorrickExecution_Hangmen(_HangedNpc, _, _, _, _, _, 1)
		AND
		NOT DB_Act3_FlorrickExecution_MeddleWithHangedBody_DamageTypeWhitelist(_DamageType)
		AND
		_DamageAmount > 0
		THEN
		PROC_Act3_FlorrickExecution_CancelHangedState(_HangedNpc);
		
		//this mainly catches pulverizing of the body
		IF
		DeathTypeChanged(_HangedNpc, _NewDeathType)
		AND
		DB_Act3_FlorrickExecution_Hangmen(_HangedNpc, _, _, _, _, _, 1)
		AND
		_NewDeathType != DEATHTYPE.Physical
		THEN
		PROC_Act3_FlorrickExecution_CancelHangedState(_HangedNpc);
		
		//flag for guard dialog reactivity
		IF
		LeftTrigger(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, (TRIGGER)S_LOW_BasiliskGate_FlorrickExecution_BodyPresenceCheckArea_46b08f47-5c64-4f98-8667-6d514bb2c0cc)
		THEN
		SetFlag((FLAG)LOW_BasiliskGate_FlorrickExecution_FlorrcikBodyGone_6e1907c4-e474-483e-974a-b1ab422dee8b);
		
		IF
		AddedTo(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _, _)
		THEN
		SetFlag((FLAG)LOW_BasiliskGate_FlorrickExecution_FlorrcikBodyGone_6e1907c4-e474-483e-974a-b1ab422dee8b);
		
		IF
		RemovedFrom(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _)
		AND
		DB_InRegion(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, (TRIGGER)S_LOW_BasiliskGate_FlorrickExecution_BodyPresenceCheckArea_46b08f47-5c64-4f98-8667-6d514bb2c0cc)
		THEN
		ClearFlag((FLAG)LOW_BasiliskGate_FlorrickExecution_FlorrcikBodyGone_6e1907c4-e474-483e-974a-b1ab422dee8b);
		
		IF
		DB_InRegion(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, (TRIGGER)S_LOW_BasiliskGate_FlorrickExecution_BodyPresenceCheckArea_46b08f47-5c64-4f98-8667-6d514bb2c0cc)
		AND
		IsInInventory(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, 0)
		THEN
		ClearFlag((FLAG)LOW_BasiliskGate_FlorrickExecution_FlorrcikBodyGone_6e1907c4-e474-483e-974a-b1ab422dee8b);
		//END_REGION
		
		IF //execute Florrick on start of END
		LevelLoaded("END_Main")
		AND
		NOT DB_GlobalFlag(WYR_WyrmRockPrison_State_FlorrickEscaped_a84a5b16-ca29-43c3-91bf-17def670ba07)
		AND
		QRY_LOW_BasiliskGate_FlorrickExecution(0)
		THEN
		DB_NOOP(1);
	}
	EXIT
	{
	}
}
Goal(497).Title("Act3_GEN_Gur");
Goal(497)
{
	INIT
	{
		DB_PermaDefeatedFlag(S_WYR_GurCamp_GurLeader_5e52cf9c-b673-45b7-888c-2c105eb4d890, GLO_GurCamp_State_GurLeaderPermaDefeated_2dd63ae4-02c6-4360-8bdd-4d8d938a56e0);
	}
	KB
	{
		IF
		FlagSet((FLAG)GLO_GurCamp_State_GurLeaderPermaDefeated_2dd63ae4-02c6-4360-8bdd-4d8d938a56e0, _, _)
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT3_WYR_GurCamp_87fe8d0d-31c9-4b10-8fc6-f0c232c24b13, 0);
	}
	EXIT
	{
	}
}
Goal(498).Title("Act3_GEN_Misc");
Goal(498)
{
	INIT
	{
	}
	KB
	{
		//REGION Wyrm Rock's waypoint
		IF
		DB_WaypointUnlocked("WAYP_WYR_WyrmRock", _)
		THEN
		DB_WYR_WyrmRock_WaypointWasDiscovered(1);
		
		IF
		FlagSet((FLAG)IRN_IronThrone_State_Destroyed_91795368-af06-4b56-9ac1-b78995aa9ea9, _, _)
		THEN
		PROC_WYR_WyrmRock_CheckBlockWaypoint();
		
		IF
		FlagSet((FLAG)GLO_Foundry_State_ControlCentreDestroyed_456906c5-40a6-429e-8e1c-7120a2ef631b, _, _)
		THEN
		PROC_WYR_WyrmRock_CheckBlockWaypoint();
		
		PROC
		PROC_WYR_WyrmRock_CheckBlockWaypoint()
		AND
		DB_WYR_WyrmRock_WaypointWasDiscovered(1)
		THEN
		PROC_LockWaypointForAll("WAYP_WYR_WyrmRock");
		DB_WYR_WyrmRock_WaypointIsLocked(1);
		
		IF
		FlagSet((FLAG)GLO_Gortash_State_PermaDefeated_74dd56ff-7e00-42a6-a0f3-0d122f364769, _, _)
		AND
		DB_WYR_WyrmRock_WaypointIsLocked(1)
		THEN
		PROC_UnlockWaypointForAll("WAYP_WYR_WyrmRock");
		//END_REGION
	}
	EXIT
	{
	}
}
