		DB_GlobalFlagReactionAfterDialog((FLAG)Debug_IRN_IronThrone_StateChange_CountdownFinished_d448c691-e09e-4e8e-9403-10a5c7200d63, (DIALOGRESOURCE)DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea);
		DB_GlobalFlagReactionAfterDialog((FLAG)Debug_IRN_IronThrone_StateChange_BackAtDocks_MajoritySaved_1a52a283-3e07-4d8f-acb6-5b963d8c99fe, (DIALOGRESOURCE)DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea);
		DB_GlobalFlagReactionAfterDialog((FLAG)Debug_IRN_IronThrone_StateChange_BackAtDocks_MajorityDead_38c21a66-a63a-4df8-9db2-623768674798, (DIALOGRESOURCE)DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea);
		DB_GlobalFlagReactionAfterDialog((FLAG)Debug_IRN_IronThrone_StateChange_BackAtDocks_AllButOne_8dd3929c-0c53-41c2-b795-879a1bef3240, (DIALOGRESOURCE)DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea);
		DB_GlobalFlagReactionAfterDialog((FLAG)Debug_IRN_IronThrone_StateChange_BackAtDocks_AllDead_1edf6e8d-64da-443d-b762-750c28bc5e9d, (DIALOGRESOURCE)DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea);
		DB_GlobalFlagReactionAfterDialog((FLAG)Debug_IRN_IronThrone_StateChange_BackAtDocks_SpokespersonDead_107bdd2a-d5ff-4aee-8638-268876cff74e, (DIALOGRESOURCE)DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea);
		
		DB_Debug_IRN_StateFlags((FLAG)Debug_IRN_IronThrone_StateChange_CountdownOngoing_03ea8ea9-c7da-4dd4-b2f2-8d2c504b9bc4);
		DB_Debug_IRN_StateFlags((FLAG)Debug_IRN_IronThrone_StateChange_CountdownFinished_d448c691-e09e-4e8e-9403-10a5c7200d63);
		DB_Debug_IRN_StateFlags((FLAG)Debug_IRN_IronThrone_StateChange_BackAtDocks_MajoritySaved_1a52a283-3e07-4d8f-acb6-5b963d8c99fe);
		DB_Debug_IRN_StateFlags((FLAG)Debug_IRN_IronThrone_StateChange_BackAtDocks_MajorityDead_38c21a66-a63a-4df8-9db2-623768674798);
		DB_Debug_IRN_StateFlags((FLAG)Debug_IRN_IronThrone_StateChange_BackAtDocks_AllButOne_8dd3929c-0c53-41c2-b795-879a1bef3240);
		DB_Debug_IRN_StateFlags((FLAG)Debug_IRN_IronThrone_StateChange_BackAtDocks_AllDead_1edf6e8d-64da-443d-b762-750c28bc5e9d);
		DB_Debug_IRN_StateFlags((FLAG)Debug_IRN_IronThrone_StateChange_BackAtDocks_SpokespersonDead_107bdd2a-d5ff-4aee-8638-268876cff74e);
		//REGION Iron Throne debug
	}
	KB
	{
		//REGION TWN
		IF
		FlagSet((FLAG)Debug_Teleport_TWN_MasonsGuild_Trap_37211761-df67-40f9-b6c0-1db58271845a, _, _)
		THEN
		DB_PerceptionSkillCheckADBlocked(S_TWN_MasonsGuild_OuterSlidingWallActivator_9b41b366-52ca-4812-8d23-18b407334b2f);
		SetEntityEvent(S_TWN_MasonsGuild_OuterSlidingWallActivator_9b41b366-52ca-4812-8d23-18b407334b2f, "StoryReveal");
		Unlock((ITEM)S_TWN_MasonsGuild_OuterSlidingWallActivator_9b41b366-52ca-4812-8d23-18b407334b2f);
		PROC_TWN_MasonsGuild_ActivateOuterSlidingWall();
		//END_REGION
		
		//REGION Colony setup
		
		IF
		FlagSet(Debug_Teleport_MOO_Colony_0d349ae9-0879-40ac-951f-1cbd3386a255, _, _)
		AND
		NOT DB_CurrentLevel("SCL_Main_A")
		THEN
		PROC_TeleportPartiesTo(S_Debug_MOO_Colony_8fbf5b97-1c77-43b2-b297-15bafa092cd4, "Debug_COL_Teleported_NoAudience");
		
		IF
		FlagSet(Debug_Teleport_COL_Colony_WithNecromancer_7cfae272-5f13-de8a-8cb1-51cc3905bee8, _, _)
		AND
		NOT DB_CurrentLevel("SCL_Main_A")
		THEN
		PROC_TeleportPartiesTo(S_Debug_MOO_Colony_8fbf5b97-1c77-43b2-b297-15bafa092cd4, "Debug_COL_Teleported_WithAudience");
		
		//END_REGION
		
		//REGION Origins
		//Laezel
		IF
		DB_GlobalFlag((FLAG)Debug_Laezel_State_SetOrpheusPath_60e43db4-c655-4bc7-8537-a2ff7518b520)
		THEN
		SetTag(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (TAG)LAEZEL_ORPHEUSPATH_616688cd-b203-4f14-8c33-086bb83062a3);
		
		IF
		DB_GlobalFlag((FLAG)Debug_Laezel_State_SetVlaakithPath_ef510030-c318-4d1c-beac-3cbdc6e3452c)
		THEN
		ClearTag(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, (TAG)LAEZEL_ORPHEUSPATH_616688cd-b203-4f14-8c33-086bb83062a3);
		
		//END_REGION
		
		//REGION Creche
		IF
		FlagSet(Debug_Teleport_CRE_SecurityOffice_1d25e1b8-d41c-49cd-8b1f-3e49ae8a232f, _, _)
		THEN
		DB_CRE_SkipToInquisitor(1);
		//END_REGION
		
		//REGION Endgame
		IF
		FlagSet(Debug_END_MorphicPool_GortashPact_1f85c5c2-fa36-4443-b457-58df642f72fb, _, _)
		THEN
		PROC_GlobalSetFlagAndCache(WYR_KillDirectorGortash_State_AgreedToMeetInUndercity_1375d542-cf0a-49fd-927b-5c6bbce13ce4);
		ClearFlag(Debug_END_MorphicPool_GortashPact_1f85c5c2-fa36-4443-b457-58df642f72fb);
		
		IF
		FlagSet(Debug_END_IllithidOptions_MindFlayerForm_e2610cf2-1ac2-4502-808b-a6a9ea43b7bb, _Player, _)
		THEN
		ClearFlag(Debug_END_IllithidOptions_MindFlayerForm_e2610cf2-1ac2-4502-808b-a6a9ea43b7bb, _Player);
		PROC_END_General_ApplyMindFlayerForm((CHARACTER)_Player);
		
		IF
		FlagSet(Debug_END_IllithidOptions_GetSupremeTadpole_50731772-e893-4a45-9691-5e0fe21f8fd9, _Player, _)
		AND
		NOT DB_CurrentLevel("END_MAIN")
		THEN
		DebugText(_Player, "Option only available in END_MAIN");
		ClearFlag(Debug_END_IllithidOptions_GetSupremeTadpole_50731772-e893-4a45-9691-5e0fe21f8fd9, _Player);
		//END_REGION
		
		//REGION Party Presets
		IF
		DB_Debug_PartyPresets(_PartyPresetFlag, _Preset, _TeleportPos, _)
		THEN
		DB_FlagReactionAfterDialog(_PartyPresetFlag, (DIALOGRESOURCE)DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea);
		
		PROC
		PROC_FlagReactionAfterDialog(_Player, _PartyPresetFlag)
		AND
		DB_Debug_PartyPresets(_PartyPresetFlag, _Preset, _TeleportPos, _)
		THEN
		ObjectTimerLaunch(_Player, "Debug_LoadPartyPresetAndTeleport", 500); // delay to set up other things (NPCs etc)
		
		IF
		ObjectTimerFinished(_Player, "Debug_LoadPartyPresetAndTeleport")
		AND
		DB_Debug_PartyPresets(_PartyPresetFlag, _Preset, _TeleportPos, _)
		AND
		_TeleportPos != NULL_00000000-0000-0000-0000-000000000000
		AND
		GetFlag(_PartyPresetFlag, _Player, 1)
		THEN
		ClearFlag(_PartyPresetFlag, _Player);
		LoadPartyPreset(_Preset, _TeleportPos);
		TimerLaunch(_Preset, 3000);
		
		IF
		ObjectTimerFinished(_Player, "Debug_LoadPartyPresetAndTeleport")
		AND
		DB_Debug_PartyPresets(_PartyPresetFlag, _Preset, NULL_00000000-0000-0000-0000-000000000000, _)
		AND
		GetFlag(_PartyPresetFlag, _Player, 1)
		THEN
		ClearFlag(_PartyPresetFlag, _Player);
		LoadPartyPreset(_Preset, _Player);
		TimerLaunch(_Preset, 3000);
		
		IF
		TimerFinished(_Preset)
		AND
		DB_Debug_PartyPresets(_PartyPresetFlag, _Preset, _TeleportPos, _XP)
		AND
		DB_Players(_Player)
		THEN
		AddExplorationExperience((CHARACTER)_Player, _XP);
		TemplateAddTo(LOOT_Camp_Pack_398e7328-ce90-4c02-94a2-93341fac499a, _Player, 1, 0);
		//END_REGION Party Presets
		
		//REGION Gale debug
		
		IF
		DialogEnded((DIALOGRESOURCE)DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea, _ID)
		AND
		DB_DialogPlayers(_ID, _Player, 1)
		AND
		DB_Debug_ORI_Gale_GiveMagicItem(_Item, _Flag)
		AND
		GetFlag(_Flag, _Player, 1)
		THEN
		PROC_ToInventoryAndOnStage(_Item, _Player, -1, 1, 0);
		ClearFlag(_Flag, _Player, 0);
		
		IF
		FlagSet((FLAG)Debug_ORI_Gale_Event_BombApproval_a2a7eec8-895b-c5fc-6950-464a6b7c518e, _Player, _)
		AND
		DB_ApprovalRating((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, (CHARACTER)_Player,_CurrentApproval)
		AND
		IntegerSubtract(20,_CurrentApproval,_Delta)
		AND
		ChangeApprovalRating((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, _Player, 0, _Delta,_)
		THEN
		ClearFlag((FLAG)Debug_ORI_Gale_Event_BombApproval_a2a7eec8-895b-c5fc-6950-464a6b7c518e, _Player, 0);
		
		
		IF
		FlagSet((FLAG)Debug_ORI_Gale_Event_RomanceStartApproval_5646119c-8108-ed97-0062-34ac7836d14a, _Player, _)
		AND
		DB_ApprovalRating((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, (CHARACTER)_Player,_CurrentApproval)
		AND
		DB_CampNight_Requirement_Approval(NIGHT_Gale_LearnSpell_393b05ff-d866-4115-8ece-872232ce44cf, (CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, _MinApproval)
		AND
		IntegerSubtract(_MinApproval,_CurrentApproval,_Delta)
		AND
		ChangeApprovalRating((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, _Player, 0, _Delta,_)
		THEN
		ClearFlag((FLAG)Debug_ORI_Gale_Event_RomanceStartApproval_5646119c-8108-ed97-0062-34ac7836d14a, _Player, 0);
		
		IF
		FlagSet((FLAG)Debug_ORI_Gale_Event_ForceElminsterOnstage_6f56d9dc-741b-6c83-8392-11c68c6cb093, _, _)
		THEN
		SetOnStage(S_GLO_Elminster_75bb6396-1132-4064-bafe-205a3f156b9b, 1);
		
		//END_REGION
		
		//REGION WYR
		
		IF
		FlagSet(Debug_WYR_South_HaveReportForRavengard_41a91b17-2e22-416f-a0b4-2c70ffd10c66,_Player,_)
		THEN
		ClearFlag(Debug_WYR_South_HaveReportForRavengard_41a91b17-2e22-416f-a0b4-2c70ffd10c66,_Player);
		
		IF
		FlagSet(Debug_WYR_South_HaveReportForRavengard_41a91b17-2e22-416f-a0b4-2c70ffd10c66,_Char,_)
		AND
		Exists(S_WYR_Posthouse_UrgentReportForDukeRavengard_d9922125-23f8-405c-a2cc-f448621cd178,1)
		THEN
		ToInventory(S_WYR_Posthouse_UrgentReportForDukeRavengard_d9922125-23f8-405c-a2cc-f448621cd178,_Char,1,1,1);
		
		IF
		FlagSet(Debug_WYR_South_HaveReportForRavengard_41a91b17-2e22-416f-a0b4-2c70ffd10c66,_Char,_)
		AND
		Exists(S_WYR_Posthouse_UrgentReportForDukeRavengard_d9922125-23f8-405c-a2cc-f448621cd178,0)
		AND
		Exists(S_WYR_UrgentReportForDukeRavengard_cc57cc55-4b45-4cd6-bea4-2f2981a342e3,0)
		THEN
		ToInventory(S_WYR_UrgentReportForDukeRavengard_cc57cc55-4b45-4cd6-bea4-2f2981a342e3,_Char,1,1,1);
		
		//END_REGION WYR
		
		//REGION Wyrmway entrance
		IF
		FlagSet(Debug_Teleport_WYR_Wyrmway_08702d0b-518d-0688-1757-9a03c2f0de3b, _Player, _)
		THEN
		AddSpell((CHARACTER)_Player, "Target_ShockingGrasp", 1, 1);
		DB_Debug_WYR_WyrmRockPrison_RemoveTrespass(1);
		//END_REGION
		
		//REGION Iron Throne debug
		PROC
		PROC_GlobalFlagReactionAfterDialog(_Flag, (DIALOGRESOURCE)DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea)
		AND
		DB_Debug_IRN_StateFlags(_Flag)
		THEN
		PROC_DEBUG_IRN_ChangeState(_Flag);
		
		PROC
		PROC_DEBUG_IRN_ChangeState((FLAG)_Flag)
		THEN
		DB_NOOP(1);
		
		//Loading Party Presets and teleporting to one of the two starting positions
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)Debug_IRN_DontLoadPreset_1e5d52c2-912d-406f-aac5-154b6baf6fb0)
		THEN
		TimerLaunch("IRN_Debug_Teleport", 500);
		
		IF
		PartyPresetLoaded("IRN_Level11_Bard_Wizard_Fighter_Rogue", _)
		THEN
		TimerLaunch("IRN_Debug_Teleport", 500);
		
		IF
		PartyPresetLoaded("IRN_Level11_Fighter_Warlock_Rogue_Wizard", _)
		THEN
		TimerLaunch("IRN_Debug_Teleport", 500);
		
		IF
		TimerFinished("IRN_Debug_Teleport")
		AND
		DB_GlobalFlag((FLAG)Debug_IRN_StartAtIronThrone_0cb11aba-95b2-40d0-aa36-e66eda320ce6)
		THEN
		ClearFlag((FLAG)Debug_IRN_StartAtIronThrone_0cb11aba-95b2-40d0-aa36-e66eda320ce6);
		PROC_TeleportPartiesTo((TRIGGER)S_IRN_Debug_StartCountdownPos_66dd9741-ba35-4e0f-bc97-b0e2f0f301c0, "");
		
		IF
		TimerFinished("IRN_Debug_Teleport")
		AND
		DB_GlobalFlag((FLAG)Debug_IRN_StartAtDockWarehouse_38af5a36-6694-4842-bd08-dfdcc97636ec)
		THEN
		ClearFlag((FLAG)Debug_IRN_StartAtDockWarehouse_38af5a36-6694-4842-bd08-dfdcc97636ec);
		PROC_TeleportPartiesTo((TRIGGER)S_LOW_DockWarehouse_ReturnFromIronThronePos_d1a59a82-8b4b-4f0a-a382-14a997888333, "");
		//END_REGION Iron Throne debug
	}
	EXIT
	{
	}
}
