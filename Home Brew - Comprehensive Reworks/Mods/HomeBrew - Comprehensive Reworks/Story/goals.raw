		DB_DoNotFaceDialog((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, (DIALOGRESOURCE)WYR_KillDirectorGortash_AD_AfterCeremony_bc07218f-1a0b-70ad-934b-c7c110f6d648);
		DB_DoNotFaceDialog((CHARACTER)S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, (DIALOGRESOURCE)WYR_KillDirectorGortash_AD_AfterCeremony_bc07218f-1a0b-70ad-934b-c7c110f6d648);
		DB_DoNotFaceDialog((CHARACTER)S_WYR_DillardPortyr_4ae37244-c9eb-41b3-82fb-c302abd01f1e, (DIALOGRESOURCE)WYR_KillDirectorGortash_AD_AfterCeremony_bc07218f-1a0b-70ad-934b-c7c110f6d648);
		DB_DoNotFaceDialog((CHARACTER)S_WYR_Patriar_001_36105366-a525-4e6f-8e25-db6da2682978, (DIALOGRESOURCE)WYR_KillDirectorGortash_AD_AfterCeremony_bc07218f-1a0b-70ad-934b-c7c110f6d648);
		DB_DoNotFaceDialog((CHARACTER)S_WYR_Patriar_002_e03365dc-cb4b-4e80-b2fd-311b09e6986d, (DIALOGRESOURCE)WYR_KillDirectorGortash_AD_AfterCeremony_bc07218f-1a0b-70ad-934b-c7c110f6d648);
		//END_REGION
		
		DB_WYR_KillDirectorGortash_FakePatriars((CHARACTER)S_WYR_CoronationHallWitness_01_b3048943-8bf0-4819-b13a-90a9aa9d44eb, (TRIGGER)S_WYR_CoronationHallWitness_01_DeathPos_22dcdc4d-4283-4c36-ac6b-017d9823392a);
		DB_WYR_KillDirectorGortash_FakePatriars((CHARACTER)S_WYR_CoronationHallWitness_02_44646c53-a11f-4430-9bd3-57b154ebe40d, (TRIGGER)S_WYR_CoronationHallWitness_02_DeathPos_41812c13-d98c-4e14-b1da-d8ab5b627cd7);
		DB_WYR_KillDirectorGortash_FakePatriars((CHARACTER)S_WYR_CoronationHallWitness_03_e30086c1-9717-4f9d-9752-4b9d69505ed3, (TRIGGER)S_WYR_CoronationHallWitness_03_DeathPos_9fcaa155-9e8c-4269-b2c9-f7bbf4040969);
		DB_WYR_KillDirectorGortash_FakePatriars((CHARACTER)S_WYR_CoronationHallWitness_04_f6903d56-6f4b-4574-a9d6-4c07c87e0924, (TRIGGER)S_WYR_CoronationHallWitness_04_DeathPos_1c4ed1be-dcc2-447d-abaf-89e777a0256f);
		DB_WYR_KillDirectorGortash_FakePatriars((CHARACTER)S_WYR_CoronationHallWitness_05_9d4dcc39-79c0-4451-8445-6e55d2ca6e02, (TRIGGER)S_WYR_CoronationHallWitness_05_DeathPos_b218cc2c-80ee-45c7-a10e-771280c3f12f);
		DB_WYR_KillDirectorGortash_FakePatriars((CHARACTER)S_WYR_CoronationHallWitness_06_2df6edc3-6a62-43d7-bf18-4041f7507175, (TRIGGER)S_WYR_CoronationHallWitness_06_DeathPos_f4c4bdb2-2440-42d0-b2df-194472f5aa0a);
		DB_WYR_KillDirectorGortash_FakePatriars((CHARACTER)S_WYR_CoronationHallWitness_07_254b0dba-2d9c-4a2b-8296-e1464be21fef, (TRIGGER)S_WYR_CoronationHallWitness_07_DeathPos_167433a3-df5a-4005-bac6-383200223b5e);
		DB_WYR_KillDirectorGortash_FakePatriars((CHARACTER)S_WYR_CoronationHallWitness_08_e944f197-5db8-42ca-a506-66ec0db0607e, (TRIGGER)S_WYR_CoronationHallWitness_08_DeathPos_d74f5740-16df-408c-911a-d87ffb0d423c);
		DB_WYR_KillDirectorGortash_FakePatriars((CHARACTER)S_WYR_CoronationHallWitness_09_b12eff34-7557-4eed-9279-5c143ce46b71, (TRIGGER)S_WYR_CoronationHallWitness_09_DeathPos_14e87cb7-6d76-4c06-83d4-5b4502411b98);
		
		//REGION Crowds at the entrance
		DB_WYR_KillDirectorGortash_CrowdsAtEntrance((TRIGGER)CCT_BsG_RFG_TalkREAC_054_f5874485-88ee-4aac-a830-38ba70e4abd3);
		DB_WYR_KillDirectorGortash_CrowdsAtEntrance((TRIGGER)CCT_BsG_RFG_Talk_055_a7060238-6fdf-4d64-8458-8af82a03ea9f);
		//END_REGION
		
		//REGION Patching
		DB_WYR_KillDirectorGortash_CalmSteelWatch_Patched(1);
		//END_REGION
		
		//REGION // incorrect item in Gortash's chest is replaced with the correct one
		ToInventory(S_WYR_KillDirectorGortash_IllithidJar_5f01dce4-7d62-4914-bfb8-ec34f7d483bf, S_Debug_WYR_AsylumChest_a171f3f6-0957-4796-be62-e491b9c2b560, 1, 0, 1); 
		TemplateAddTo(UNI_TadpolePowerJar_1ec327be-3b7f-4502-9586-860e057e09ae, S_WYR_KillDirectorGortash_GortashsChest_5065d932-5680-4c2b-8a9b-b94c5f524f82, 1, 0);
		//END_REGION
	}
	KB
	{
		//REGION Init
		IF
		DB_WYR_KillDirectorGortash_AudienceHallNPCs(_Char, _Dialog, _, _, _)
		THEN
		DB_DoNotFaceDialog(_Char, (DIALOGRESOURCE)WYR_KillDirectorGortash_AD_AudienceHallGroupDialog_0d95b9b2-fd21-63d4-a86c-7a6073203476);
		DB_SceneManager(_Char, "WYR_KillDirectorGortash_Ceremony");
		DB_SpotPlayers(_Char, "WYR_KillDirectorGortash_Ceremony", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		DB_SpotPlayers_IncludeWildshapedPlayers(_Char, "WYR_KillDirectorGortash_Ceremony");
		DB_SpotPlayers_SpotTrigger(_Char, "WYR_KillDirectorGortash_Ceremony", (TRIGGER)S_WYR_KillDirectorGortash_CeremonySpotArea_100d8f61-8c18-477a-b0d1-d400f7740e81);
		DB_Dialogs(_Char, _Dialog);
		
		IF
		DB_WYR_KillDirectorGortash_AudienceHallNPCs(_Patriar, _, _PatriarBench, _, _)
		AND
		_PatriarBench != NULL_00000000-0000-0000-0000-000000000000
		THEN
		Use(_Patriar, _PatriarBench, "");
		
		IF
		DB_WYR_KillDirectorGortash_CeremonySteelWatchers(_SteelWatcher)
		AND
		_SteelWatcher != S_WYR_AudienceHall_SteelWatcher_004_fc380f9b-a440-4356-aaa1-7e74311f17e7 // this fellow needs to be able to react to crimes
		THEN
		DB_SceneManager(_SteelWatcher, "WYR_KillDirectorGortash_Ceremony");
		
		IF
		DB_WYR_KillDirectorGortash_Banites(_, _BackupBanite)
		THEN
		PROC_SetOnStage(_BackupBanite, 0);
		
		IF
		DB_WYR_KillDirectorGortash_AudienceHallBanites(_Banite, _Dialog)
		THEN
		DB_Dialogs(_Banite, _Dialog);
		PROC_SetOnStage(_Banite, 0);
		
		IF
		DB_WYR_KillDirectorGortash_AudienceHallServants(_Servant, _Dialog)
		THEN
		DB_Dialogs(_Servant, _Dialog);
		//END_REGION
		
		//REGION Main dialogs setup
		IF
		DB_WYR_KillDirectorGortash_MainDialogs(_Dialog, _DialogTrigger)
		THEN
		DB_DropMutingStatussesDialog(_Dialog);
		PROC_TriggerRegisterForParty(_DialogTrigger);
		
		// Add all non-hidden characters to the dialog when they enter the trigger / stop being hidden while in trigger
		IF
		DB_DialogName(_Dialog, _ID)
		AND
		NOT DB_DialogEnding(_Dialog, _ID)
		AND
		DB_WYR_KillDirectorGortash_MainDialogs(_Dialog, _Trigger)
		AND
		DB_PartyMembers(_PartyMember)
		AND
		DB_InRegion(_PartyMember, _Trigger)
		AND
		NOT DB_HiddenCharacters(_PartyMember, _)
		AND
		NOT DB_DialogPlayers(_, _PartyMember, _)
		THEN
		PROC_DialogAddListeningActor(_ID, _PartyMember);
		//END_REGION
		
		//REGION Ceremony
		QRY
		QRY_SelectCustomDialog_AfterGenerics((CHARACTER)_Char, _Player)
		AND
		DB_WYR_KillDirectorGortash_AudienceHallNPCs(_Char, _, _, _, _)
		AND
		DB_GlobalFlag((FLAG)WYR_KillDirectorGortash_State_BeforeCeremony_23a195be-a8d7-4678-94af-743dea65fd95)
		AND
		QRY_WYR_KillDirectorGortash_StartCeremonyDialog((CHARACTER)_Player)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_SpotPlayers_Spotted(_Char, "WYR_KillDirectorGortash_Ceremony", _Player)
		AND
		DB_WYR_KillDirectorGortash_AudienceHallNPCs(_Char, _, _, _, _)
		AND
		DB_GlobalFlag((FLAG)WYR_KillDirectorGortash_State_BeforeCeremony_23a195be-a8d7-4678-94af-743dea65fd95)
		AND
		NOT DB_WYR_KillDirectorGortash_StartCeremonyDialogPassed(1)
		AND
		QRY_WYR_KillDirectorGortash_StartCeremonyDialog(_Player)
		THEN
		DB_WYR_KillDirectorGortash_StartCeremonyDialogPassed(1);
		
		QRY
		QRY_WYR_KillDirectorGortash_StartCeremonyDialog((CHARACTER)_Player)
		AND
		NOT QRY_WYR_KillDirectorGortash_CeremonyOrOMFailed((CHARACTER)_Player)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_WYR_KillDirectorGortash_CeremonyOrOMFailed((CHARACTER)_Player)
		AND
		NOT QRY_StartDialog_Fixed(WYR_KillDirectorGortash_Ceremony_5149a422-854a-9e05-433a-0520d87eb112, S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, _Player)
		AND
		NOT DB_QRYRTN_StartDialog_FailReason("OriginMomentOverride")
		THEN
		DB_NOOP(1);
		
		IF
		DialogStarted((DIALOGRESOURCE)WYR_KillDirectorGortash_Ceremony_5149a422-854a-9e05-433a-0520d87eb112, _)
		THEN
		SetFlag((FLAG)WYR_KillDirectorGortash_State_ConductingCeremony_9c978077-c7a4-46bf-9528-a5133f61c875);
		
		IF
		FlagSet(WYR_KillDirectorGortash_Event_SyncGortashAndRavengardPositions_45f954b5-2d4f-4705-a374-5e1bf723e6c2, _, _)
		THEN
		PROC_CharacterMoveTo((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, (TRIGGER)S_WYR_KillDirectorGortash_GortashAfterCeremonyPos_dd449a60-f892-4170-bdef-26f24a5afd84, "Walk", "");
		PROC_CharacterMoveTo((CHARACTER)S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, S_WYR_KillDirectorGortash_RavengardAfterCeremonyPos_4077a027-c2f9-410e-889a-63da89f9948e, "Walk", "");
		
		IF
		DialogEnded((DIALOGRESOURCE)WYR_KillDirectorGortash_Ceremony_5149a422-854a-9e05-433a-0520d87eb112, _)
		THEN
		SetFlag((FLAG)WYR_KillDirectorGortash_State_AfterCeremony_a05a6945-21ad-400d-80bc-7b4934571c57);
		
		IF
		FlagSet(WYR_KillDirectorGortash_State_AfterCeremony_a05a6945-21ad-400d-80bc-7b4934571c57, _, _)
		THEN
		NOT DB_CustomDialogRange(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, 50);
		SetFlag((FLAG)GLO_Gortash_HasMet_74cffb8f-fc93-4c67-a12e-aa2cc8890291);
		SetFlag((FLAG)WYR_KillDirectorGortash_State_GortashBecameArchduke_b91a5012-d49b-429d-9b86-b75686fa7582);
		ObjectSetTitle(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, "WYR_KillDirectorGortash_GortashAfterCeremony"); // ArchDuke
		//END_REGION
		
		//REGION Gortash moves to his office immediately after the ceremony
		// if the player killed Orin before meeting Gortash in the Audience Hall
		// then Gortash immediately goes to his office
		PROC
		PROC_GlobalFlagReactionAfterDialog(WYR_KillDirectorGortash_Event_MoveGortashToHisOffice_b73e0d24-c6ba-43a1-b848-18f1a5333c1c)
		THEN
		PROC_NotifyWhenReadyToMoveOn((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, "WYR_KillDirectorGortash_GortashIsReadyToMoveToHisOffice");
		
		PROC
		PROC_ReadyToMoveOn((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, "WYR_KillDirectorGortash_GortashIsReadyToMoveToHisOffice")
		THEN
		PROC_WYR_KillDirectorGortash_MoveGortashToHisOffice();
		
		PROC
		PROC_WYR_KillDirectorGortash_MoveGortashToHisOffice()
		THEN
		PROC_GlobalSetFlagAndCache(WYR_KillDirectorGortash_State_HasRoofAccess_7582278e-27b8-4788-a511-2ff3d3af42bf);
		TriggerRegisterForCharacter((TRIGGER)S_WYR_WyrmRock_AudienceHallArea_a078f420-9f5e-452b-9391-e96e754b61c8, (CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac);
		PROC_CharacterMoveTo((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, S_WYR_GortashsPositionInOffice_fff3874c-e03b-4802-b0ba-e3584b8ca5ee, "Walk", "WYR_KillDirectorGortash_ArrivedAtOffice");
		PROC_WYR_KillDirectorGortash_UpdateRoofSteelWatchersFaction();
		
		IF
		LeftTrigger((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, (TRIGGER)S_WYR_WyrmRock_AudienceHallArea_a078f420-9f5e-452b-9391-e96e754b61c8)
		AND
		DB_GlobalFlag((FLAG)WYR_KillDirectorGortash_State_AfterCeremony_a05a6945-21ad-400d-80bc-7b4934571c57)
		THEN
		PROC_SceneManager_RemoveFromScene((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, "WYR_KillDirectorGortash_Ceremony");
		TriggerUnregisterForCharacter((TRIGGER)S_WYR_WyrmRock_AudienceHallArea_a078f420-9f5e-452b-9391-e96e754b61c8, (CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac);
		
		// Roof Steel Watchers become neutral to the player UNLESS someone is already fighting them
		PROC
		PROC_WYR_KillDirectorGortash_UpdateRoofSteelWatchersFaction()
		AND
		DB_WYR_KillDirectorGortash_RoofSteelWatchers(_RoofSteelWatcher, _)
		AND
		NOT DB_Is_InCombat(_RoofSteelWatcher, _)
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT3_WYR_WyrmRock_RoofSteelWatchers_523adbc8-5a94-4b33-aaac-1d1941fb1ac8, 50);
		//END_REGION
		
		//REGION Ceremony Aftermath
		PROC
		PROC_GLO_LevelSwap_LeavingFromTo("BGO_Main_A", "ReadyCheck_ToLOWFromWYR")
		AND
		DB_WYR_KillDirectorGortash_CeremonyAutoCompletionConditions(_Flag)
		AND
		DB_GlobalFlag(_Flag)
		AND
		NOT DB_OnlyOnce("WYR_KillDirectorGortash_CeremonyAftermath")
		THEN
		PROC_WYR_KillDirectorGortash_CeremonyAftermath();
		
		PROC
		PROC_RegionSwapReadyCheckPassed(_, "WaypointTravel_RegionSwap")
		AND
		DB_CurrentLevel("BGO_Main_A")
		AND
		DB_WYR_KillDirectorGortash_CeremonyAutoCompletionConditions(_Flag)
		AND
		DB_GlobalFlag(_Flag)
		AND
		NOT DB_OnlyOnce("WYR_KillDirectorGortash_CeremonyAftermath")
		THEN
		PROC_WYR_KillDirectorGortash_CeremonyAftermath();
		
		PROC
		PROC_WYR_KillDirectorGortash_CeremonyAftermath()
		AND
		QRY_OnlyOnce("WYR_KillDirectorGortash_CeremonyAftermath")
		THEN
		PROC_WYR_KillDirectorGortash_EndCeremony();
		
		PROC
		PROC_WYR_KillDirectorGortash_EndCeremony()
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_KillDirectorGortash_State_CeremonyEnded_9aeab401-c087-4f2e-9894-859df23680dc);
		
		PROC
		PROC_WYR_KillDirectorGortash_EndCeremony()
		THEN
		PROC_WYR_KillDirectorGortash_RemoveServantsFromAudienceHall();
		PROC_WYR_KillDirectorGortash_RemovePatriarsFromAudienceHall();
		PROC_WYR_KillDirectorGortash_ReplaceFlamingFistsInAudienceHall();
		PROC_WYR_KillDirectorGortash_RemoveRavengardFromAudienceHall();
		PROC_WYR_KillDirectorGortash_ReplaceBodyguardsInOffice();
		PROC_WYR_KillDirectorGortash_TeleportGortashToOffice();
		
		//REGION Removing Patriars
		PROC
		PROC_WYR_KillDirectorGortash_RemovePatriarsFromAudienceHall()
		AND
		DB_PermaDefeated((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		THEN
		PROC_WYR_KillDirectorGortash_SendPatriarsHome();
		
		PROC
		PROC_WYR_KillDirectorGortash_RemovePatriarsFromAudienceHall()
		AND
		NOT DB_PermaDefeated((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		THEN
		PROC_WYR_KillDirectorGortash_KillPatriars();
		
		PROC
		PROC_WYR_KillDirectorGortash_SendPatriarsHome()
		AND
		DB_WYR_KillDirectorGortash_AudienceHallNPCs(_NPC, _, _, 1, _)
		THEN
		PROC_SetOnStage(_NPC, 0);
		
		PROC
		PROC_WYR_KillDirectorGortash_SendPatriarsHome()
		AND
		DB_WYR_KillDirectorGortash_FakePatriars(_NPC, _)
		THEN
		PROC_SetOnStage(_NPC, 0);
		
		PROC
		PROC_WYR_KillDirectorGortash_SendPatriarsHome()
		AND
		DB_WYR_WyrmRock_MessHallBodyguards(_NPC, _)
		THEN
		PROC_SetOnStage(_NPC, 0);
		
		PROC
		PROC_WYR_KillDirectorGortash_KillPatriars()
		AND
		DB_WYR_KillDirectorGortash_AudienceHallNPCs(_NPC, _, _, 1, _DeathPos)
		AND
		NOT DB_PermaDefeated(_NPC)
		THEN
		TeleportTo(_NPC, _DeathPos, "WYR_KillDirectorGortash_CharacterTeleportedToPostCeremonyDeath");
		
		PROC
		PROC_WYR_KillDirectorGortash_KillPatriars()
		AND
		DB_WYR_KillDirectorGortash_FakePatriars(_NPC, _DeathPos)
		AND
		NOT DB_PermaDefeated(_NPC)
		THEN
		TeleportTo(_NPC, _DeathPos, "WYR_KillDirectorGortash_CharacterTeleportedToPostCeremonyDeath");
		
		PROC
		PROC_WYR_KillDirectorGortash_KillPatriars()
		AND
		DB_WYR_WyrmRock_MessHallBodyguards(_NPC, _DeathPos)
		AND
		NOT DB_PermaDefeated(_NPC)
		THEN
		TeleportTo(_NPC, _DeathPos, "WYR_KillDirectorGortash_CharacterTeleportedToPostCeremonyDeath");
		
		IF
		EntityEvent((CHARACTER)_NPC, "WYR_KillDirectorGortash_CharacterTeleportedToPostCeremonyDeath")
		AND
		NOT DB_WYR_KillDirectorGortash_CustomDeathTypes(_NPC, _)
		THEN
		DB_CorpseCleanup_Ignore(_NPC);
		Die(_NPC, DEATHTYPE.Physical, NULL_00000000-0000-0000-0000-000000000000, 1, 1, 1.0);
		DB_WYR_KillDirectorGortash_SpawnBlood((CHARACTER)_NPC);
		
		IF
		EntityEvent((CHARACTER)_NPC, "WYR_KillDirectorGortash_CharacterTeleportedToPostCeremonyDeath")
		AND
		DB_WYR_KillDirectorGortash_CustomDeathTypes(_NPC, _DeathType)
		THEN
		DB_CorpseCleanup_Ignore(_NPC);
		Die(_NPC, _DeathType, NULL_00000000-0000-0000-0000-000000000000, 1, 1, 1.0);
		// no blood for these ones - they got incinerated
		
		PROC
		PROC_WYR_KillDirectorGortash_KillPatriars()
		THEN
		DB_WYR_KillDirectorGortash_PatriarsKilled(1);
		
		QRY
		QRY_CorpseLooting_BlockMakeOwned(_NPC)
		AND
		DB_WYR_KillDirectorGortash_PatriarsKilled(1)
		AND
		DB_WYR_KillDirectorGortash_AudienceHallNPCs(_NPC, _, _, 1, _)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_CorpseLooting_BlockMakeOwned(_NPC)
		AND
		DB_WYR_KillDirectorGortash_PatriarsKilled(1)
		AND
		DB_WYR_KillDirectorGortash_FakePatriars(_NPC, _)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_CorpseLooting_BlockMakeOwned(_NPC)
		AND
		DB_WYR_KillDirectorGortash_PatriarsKilled(1)
		AND
		DB_WYR_KillDirectorGortash_MessHallBodyguards(_NPC, _)
		THEN
		DB_NOOP(1);
		
		// spawn blood upon returning to BGO_Main
		// because when NPCs die on leaving to CTY_Main_A, there is no blood upon returning
		// crowds are also disabled only upon returning to BGO_Main,
		// because disabling them on level unloading doesn't work
		IF
		FlagSet((FLAG)CURRENTREGION_BGO_Main_A_11239767-48ad-4879-8312-b9164b6e4978, _, _)
		AND
		DB_OnlyOnce("WYR_KillDirectorGortash_CeremonyAftermath")
		AND
		QRY_OnlyOnce("WYR_KillDirectorGortash_CeremonyAftermath_DelayedActions")
		THEN
		PROC_WYR_KillDirectorGortash_SpawnBlood();
		PROC_WYR_KillDirectorGortash_RemovePatriarCrowds();
		
		PROC
		PROC_WYR_KillDirectorGortash_SpawnBlood()
		AND
		DB_WYR_KillDirectorGortash_SpawnBlood(_NPC)
		THEN
		CreatePuddle(_NPC, "SurfaceBlood", 3, 15, 12, 12, 1.0);
		
		PROC
		PROC_WYR_KillDirectorGortash_SpawnBlood()
		THEN
		CreatePuddle(S_WYR_KillDirectorGortash_BloodSplatter_dce43aa1-eec5-44d5-b296-47c889264f75, "SurfaceBlood", 3, 15, 12, 12, 1.0);
		
		PROC
		PROC_WYR_KillDirectorGortash_SpawnBlood()
		THEN
		LoadLevelTemplate(LT_CoronationRoom_Massacre_A_000_94ee7c91-3c06-435b-a47f-174bc790b078);
		
		PROC
		PROC_WYR_KillDirectorGortash_RemovePatriarCrowds()
		AND
		QRY_OnlyOnce("WYR_KillDirectorGortash_RemoveCrowdsFromAudienceHall")
		AND
		DB_WYR_WyrmRock_Crowds(_Crowd, "WYR_WyrmRock_AudienceHall")
		THEN
		TriggerSetCrowdSpawningEnable(_Crowd, 0);
		TriggerDespawnCrowd(_Crowd);
		
		PROC
		PROC_WYR_KillDirectorGortash_RemovePatriarCrowds()
		AND
		QRY_OnlyOnce("WYR_KillDirectorGortash_RemoveCrowdsFromMessHall")
		AND
		DB_WYR_WyrmRock_Crowds(_Crowd, "WYR_WyrmRock_MessHall")
		THEN
		TriggerSetCrowdSpawningEnable(_Crowd, 0);
		TriggerDespawnCrowd(_Crowd);
		//END_REGION
		
		//REGION Replacing FFs with Banites
		PROC
		PROC_WYR_KillDirectorGortash_ReplaceFlamingFistsInAudienceHall()
		AND
		NOT DB_PermaDefeated(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		AND
		DB_WYR_WyrmRock_AudienceHallGuards(_Guard, _)
		THEN
		PROC_SetOnStage(_Guard, 0);
		
		PROC
		PROC_WYR_KillDirectorGortash_ReplaceFlamingFistsInAudienceHall()
		AND
		NOT DB_PermaDefeated(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		THEN
		PROC_SetOnStage(S_WYR_WyrmRock_RoofGuard_001_2de31d40-ad10-4051-8901-4ad9609bcf6c, 0);
		
		PROC
		PROC_WYR_KillDirectorGortash_ReplaceFlamingFistsInAudienceHall()
		AND
		NOT DB_PermaDefeated(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		AND
		DB_WYR_KillDirectorGortash_AudienceHallBanites(_Banite, _)
		THEN
		PROC_SetOnStage(_Banite, 1);
		
		PROC
		PROC_WYR_KillDirectorGortash_ReplaceFlamingFistsInAudienceHall()
		THEN
		NOT DB_ItemOwnerShipTriggersFallback((TRIGGER)S_WYR_WyrmsRock_AudienceHall_Ownership_a6ea8c9d-a3c6-4525-b20f-716b6cbfecbe, (CHARACTER)S_WYR_WyrmRock_AudienceHallGuard_001_d3dea7b0-3c9d-431b-9671-e6a00b726a9c);
		NOT DB_ItemOwnerShipTriggersFallback((TRIGGER)S_WYR_WyrmsRock_AudienceHall_Ownership_a6ea8c9d-a3c6-4525-b20f-716b6cbfecbe, (CHARACTER)S_WYR_KillDirectorGortash_AudienceHallBanite_001_42dbfa85-8b0a-4a8b-8908-56f9f2948e00);
		
		//END_REGION
		
		//REGION Removing Servants
		PROC
		PROC_WYR_KillDirectorGortash_RemoveServantsFromAudienceHall()
		AND
		DB_WYR_KillDirectorGortash_AudienceHallServants(_Servant, _)
		THEN
		PROC_SetOnStage(_Servant, 0);
		//END_REGION
		
		//REGION Removing Ravengard
		PROC
		PROC_WYR_KillDirectorGortash_RemoveRavengardFromAudienceHall()
		AND
		NOT DB_GlobalFlag((FLAG)CAMP_Ravengard_State_RavengardInCamp_37309008-04cf-493c-8ca6-43034d331a8a)
		AND
		QRY_OnlyOnce("WYR_KillDirectorGortash_RemoveRavengardFromAudienceHall")
		THEN
		PROC_SetOnStage((CHARACTER)S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, 0);
		SetCanFight(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, 1);
		SetCanJoinCombat(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, 1);
		PROC_WYR_KillDirectorGortash_RemoveRavengardFromAudienceHall_Intern();
		 
		// if Gortash is perma defeated (including knocked out, surrendered, petrified etc)
		// then Ravengard is killed by Gortash's minions
		// doesn't matter if Ravengard is knocked out, surrendered or whatever, he just dies
		PROC
		PROC_WYR_KillDirectorGortash_RemoveRavengardFromAudienceHall_Intern()
		AND
		QRY_WYR_KillDirectorGortash_CharacterIsActuallyPermaDefeated((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		AND
		IsDead(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, 0)
		THEN
		SetFlag(GLO_Ravengard_State_KilledOffScreenAfterCeremony_940499e9-dd0d-4b5b-9e45-e8675f61abbf);
		Die(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, DEATHTYPE.Psychic, NULL_00000000-0000-0000-0000-000000000000, 0, 1, 0.0);
		
		// if Gortash is not perma defeated, but Iron Throne is destroyed, then Gortash just kills Ravengard
		PROC
		PROC_WYR_KillDirectorGortash_RemoveRavengardFromAudienceHall_Intern()
		AND
		NOT QRY_WYR_KillDirectorGortash_CharacterIsActuallyPermaDefeated((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		AND
		IsDead(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, 0)
		AND
		DB_GlobalFlag(IRN_IronThrone_State_Destroyed_91795368-af06-4b56-9ac1-b78995aa9ea9)
		THEN
		SetFlag(GLO_Ravengard_State_KilledOffScreenAfterCeremony_940499e9-dd0d-4b5b-9e45-e8675f61abbf);
		Die(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, DEATHTYPE.Psychic, NULL_00000000-0000-0000-0000-000000000000, 0, 1, 0.0);
		
		// if Gortash is not perma defeated and Ravengard is not defeated, then we send Ravengard to IT
		PROC
		PROC_WYR_KillDirectorGortash_RemoveRavengardFromAudienceHall_Intern()
		AND
		NOT QRY_WYR_KillDirectorGortash_CharacterIsActuallyPermaDefeated((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		AND
		NOT DB_Defeated(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03)
		AND
		NOT DB_GlobalFlag(IRN_IronThrone_State_Destroyed_91795368-af06-4b56-9ac1-b78995aa9ea9)
		THEN
		SetEntityEvent(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, "WYR_KillDirectorGortash_RavengardSentToIronThrone");
		
		// if Ravengard is defeated, then we do nothing
		
		QRY
		QRY_WYR_KillDirectorGortash_CharacterIsActuallyPermaDefeated((CHARACTER)_Char)
		AND
		IsDead(_Char, 1)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_WYR_KillDirectorGortash_CharacterIsActuallyPermaDefeated((CHARACTER)_Char)
		AND
		DB_PermaDefeated(_Char)
		THEN
		DB_NOOP(1);
		
		// not perma defeated, but will be soon
		QRY
		QRY_WYR_KillDirectorGortash_CharacterIsActuallyPermaDefeated((CHARACTER)_Char)
		AND
		DB_Defeated(_Char)
		AND
		DB_DefeatedCauses(_Char, _DefeatCause, _)
		AND
		NOT DB_GameOver_DefeatCausesNotGameOver(_DefeatCause)
		THEN
		DB_NOOP(1);
		
		IF
		EntityEvent(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, "WYR_KillDirectorGortash_RavengardSentToIronThrone")
		THEN
		TeleportTo(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, S_IRN_Ravengard_Pos_3d27f038-b773-4abd-bf3f-f569e0d93d28, "", 0, 0, 0, 0, 1);
		SetFlag((FLAG)IRN_IronThrone_State_RavengardPresent_2e102a34-500a-4cd2-ba93-51d1a8b96496);
		DB_PreventPermaDefeated(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03);
		//END_REGION
		
		//REGION Replace dead bodyguards in the office
		PROC
		PROC_WYR_KillDirectorGortash_ReplaceBodyguardsInOffice()
		AND
		DB_WYR_KillDirectorGortash_Banites(_OriginalBanite, _BackupBanite)
		AND
		DB_Defeated(_OriginalBanite)
		THEN
		PROC_SetOnStage(_OriginalBanite, 0);
		RemoveSurfaceLayer(_OriginalBanite, "Ground", 8.0);
		PROC_SetOnStage(_BackupBanite, 1);
		SetFaction(_BackupBanite, (FACTION)ACT3_WYR_WyrmRock_Gortash_bfc76c31-9f16-4f27-af3f-c6b6747230dc);
		
		PROC
		PROC_WYR_KillDirectorGortash_ReplaceBodyguardsInOffice()
		AND
		DB_PermaDefeated(S_WYR_GortashsOffice_SteelWatcher_5967b1c5-8e3c-4064-83e3-5219aa204c3d)
		THEN
		PROC_WYR_KillDirectorGortash_ReplaceSteelWatcher();
		
		PROC
		PROC_WYR_KillDirectorGortash_ReplaceSteelWatcher()
		AND
		DB_WYR_KillDirectorGortash_SteelWatcherReplacement(_SteelWatcher)
		AND
		NOT DB_Defeated(_SteelWatcher)
		THEN
		DB_WYR_KillDirectorGortash_SteelWatcherReplacement_Temp((CHARACTER)_SteelWatcher);
		
		PROC
		PROC_WYR_KillDirectorGortash_ReplaceSteelWatcher()
		AND
		QRY_GetRandom("DB_WYR_KillDirectorGortash_SteelWatcherReplacement_Temp", 1, "DB_WYR_KillDirectorGortash_SteelWatcherReplacement_Choosen")
		AND
		DB_WYR_KillDirectorGortash_SteelWatcherReplacement_Choosen((CHARACTER)_SteelWatcher)
		THEN
		PROC_SetOnStage(S_WYR_GortashsOffice_SteelWatcher_5967b1c5-8e3c-4064-83e3-5219aa204c3d, 0);
		RemoveSurfaceLayer(S_WYR_GortashsOffice_SteelWatcher_5967b1c5-8e3c-4064-83e3-5219aa204c3d, "Ground", 8.0);
		TeleportTo(_SteelWatcher, S_WYR_SteelWatcherReplacementPos_7ff8e450-5881-4671-bb33-7e21eff3b0d7);
		SetFaction(_SteelWatcher, (FACTION)ACT3_WYR_WyrmRock_Gortash_bfc76c31-9f16-4f27-af3f-c6b6747230dc);
		NOT DB_WYR_KillDirectorGortash_ActiveSteelWatcher(S_WYR_GortashsOffice_SteelWatcher_5967b1c5-8e3c-4064-83e3-5219aa204c3d);
		DB_WYR_KillDirectorGortash_ActiveSteelWatcher(_SteelWatcher);
		//END_REGION
		
		//REGION Teleporting Gortash to his Office
		PROC
		PROC_WYR_KillDirectorGortash_TeleportGortashToOffice()
		AND
		NOT DB_GlobalFlag((FLAG)WYR_KillDirectorGortash_State_InOffice_12233623-2dc3-4dbe-b493-b491fdf6321d)
		THEN
		TeleportTo(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, S_WYR_GortashsPositionInOffice_fff3874c-e03b-4802-b0ba-e3584b8ca5ee, "WYR_KillDirectorGortash_ArrivedAtOffice");
		
		IF
		EntityEvent((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, "WYR_KillDirectorGortash_ArrivedAtOffice")
		THEN
		SetFlag((FLAG)WYR_KillDirectorGortash_State_InOffice_12233623-2dc3-4dbe-b493-b491fdf6321d);
		PROC_RemoveDialog(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac);
		DB_Dialogs(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, (DIALOGRESOURCE)WYR_KillDirectorGortash_GortashInOffice_b032707c-5cf3-be12-b590-d35f59019fd7);
		LookFromTrigger((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, S_WYR_GortashsPositionInOffice_fff3874c-e03b-4802-b0ba-e3584b8ca5ee, 0);
		PROC_SceneOver("WYR_KillDirectorGortash_Ceremony");
		PROC_SpotPlayers_StopSpotting((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, "WYR_KillDirectorGortash_Ceremony");
		DB_SpotPlayers_IncludeWildshapedPlayers(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, "WYR_KillDirectorGortash_SpottingInOffice");
		DB_SpotPlayers((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, "WYR_KillDirectorGortash_SpottingInOffice", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		DB_SpotPlayers_CustomRadius((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, "WYR_KillDirectorGortash_SpottingInOffice", 15.0);
		PROC_KillDirectorGortash_SetUpSceneManagerInOffice();
		
		IF
		EntityEvent((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, "WYR_KillDirectorGortash_ArrivedAtOffice")
		AND
		GetCombatGroupID(S_WYR_KillDirectorGortash_GortashsBodyguard_001_8b142ad1-8ca5-487c-9ecd-93fb4172ea25, _CombatGroupID)
		THEN
		SetCombatGroupID(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, _CombatGroupID);
		
		PROC
		PROC_KillDirectorGortash_SetUpSceneManagerInOffice()
		THEN
		DB_SceneManager(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, "WYR_KillDirectorGortash_SceneInOffice");
		
		PROC
		PROC_KillDirectorGortash_SetUpSceneManagerInOffice()
		AND
		DB_WYR_KillDirectorGortash_Banites(_OriginalBanite, _)
		AND
		NOT DB_Defeated(_OriginalBanite)
		THEN
		DB_SceneManager(_OriginalBanite, "WYR_KillDirectorGortash_SceneInOffice");
		
		PROC
		PROC_KillDirectorGortash_SetUpSceneManagerInOffice()
		AND
		DB_WYR_KillDirectorGortash_Banites(_, _BackupBanite)
		AND
		NOT DB_OffStage(_BackupBanite)
		AND
		NOT DB_Defeated(_BackupBanite)
		THEN
		DB_SceneManager(_BackupBanite, "WYR_KillDirectorGortash_SceneInOffice");
		
		PROC
		PROC_KillDirectorGortash_SetUpSceneManagerInOffice()
		AND
		DB_WYR_KillDirectorGortash_ActiveSteelWatcher(_SteelWatcher)
		AND
		NOT DB_Defeated(_SteelWatcher)
		AND
		NOT DB_GlobalFlag(GLO_Foundry_State_ControlCentreDestroyed_456906c5-40a6-429e-8e1c-7120a2ef631b)
		THEN
		DB_SceneManager(_SteelWatcher, "WYR_KillDirectorGortash_SceneInOffice");
		
		IF
		FlagSet((FLAG)GLO_Foundry_State_ControlCentreDestroyed_456906c5-40a6-429e-8e1c-7120a2ef631b, _, _)
		AND
		DB_WYR_KillDirectorGortash_ActiveSteelWatcher(_SteelWatcher)
		THEN
		PROC_SceneManager_RemoveFromScene(_SteelWatcher, "WYR_KillDirectorGortash_SceneInOffice");
		//END_REGION
		
		//END_REGION
		
		//REGION Helper Flags
		IF
		DB_PermaDefeated((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_KillDirectorGortash_State_InOffice_12233623-2dc3-4dbe-b493-b491fdf6321d) // not in the office = killed during the ceremony
		THEN
		SetFlag((FLAG)WYR_KillDirectorGortash_State_GortashPermaDefeatedDuringCeremony_11e3ccc3-8a61-4ed5-9ec2-0a0e1fd4a8d7);
		
		IF
		DB_Defeated((CHARACTER)S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03)
		AND
		NOT DB_OnlyOnce("WYR_KillDirectorGortash_RemoveRavengardFromAudienceHall") // hasn't been removed from the Audience Hall - defeated during the ceremony
		AND
		DB_DefeatedCauses((CHARACTER)S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, _DefeatCause, _)
		AND
		NOT DB_GameOver_DefeatCausesNotGameOver(_DefeatCause) // we don't care about temp banishement or temp petrification
		THEN
		TimerLaunch("WYR_KillDirectorGortash_RavengardDiesInFlames", 500); // little delay, since simply killing also puts a char into DB_Defeated
		
		IF
		TimerFinished("WYR_KillDirectorGortash_RavengardDiesInFlames")
		AND
		IsDead((CHARACTER)S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, 0) // he is in DB_PreventPermaDefeated, so we need to use an engine query
		THEN
		SetFlag((FLAG)GLO_Ravengard_State_KilledByMizoraInWyrmsRock_3934a26b-64ff-4d1a-9ead-cb7040c195f6);
		SetFlag((FLAG)WYR_Ravengard_State_KilledBeforeIRN_bb43c67a-cc36-4498-9e76-1faaf010cc2a);
		PROC_GlobalSetFlagAndCache((FLAG)WYR_KillDirectorGortash_State_RavengardKilledDuringCeremony_40b81270-9d42-4e46-bd96-6295c8b2b7e2);
		Die(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, DEATHTYPE.Incinerate, S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a, 1, 0, 1.0);
		DB_WYR_KillDirectorGortash_RavengardDiesInFlames(1);
		
		IF
		Died((CHARACTER)S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03)
		AND
		DB_WYR_KillDirectorGortash_RavengardDiesInFlames(1)
		AND
		GetClosestAlivePlayer(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, _Player, _)
		THEN
		NOT DB_WYR_KillDirectorGortash_RavengardDiesInFlames(1);
		StartVoiceBark((VOICEBARKRESOURCE)WYR_KillDirectorGortash_VB_RavengardDiesInFlames_977ab5df-8976-5e9d-2f3e-03e2b8d271f0, _Player);
		
		IF
		KilledBy(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, (CHARACTER)_Killer, _, _)
		AND
		DB_PartyMembers(_Killer)
		AND
		NOT DB_OnlyOnce("WYR_KillDirectorGortash_RemoveRavengardFromAudienceHall") // hasn't been removed from the Audience Hall - killed during the ceremony
		AND
		NOT DB_GlobalFlag((FLAG)WYR_KillDirectorGortash_State_RavengardKilledDuringCeremony_40b81270-9d42-4e46-bd96-6295c8b2b7e2)
		THEN
		PROC_WYR_KillDirectorGortash_RavengardKilledDuringCeremony(_Killer);
		
		PROC
		PROC_WYR_KillDirectorGortash_RavengardKilledDuringCeremony((CHARACTER)_Killer)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_KillDirectorGortash_State_RavengardKilledDuringCeremony_40b81270-9d42-4e46-bd96-6295c8b2b7e2);
		
		// normal flow - killed in combat
		PROC
		PROC_WYR_KillDirectorGortash_RavengardKilledDuringCeremony((CHARACTER)_Killer)
		AND
		DB_Is_InCombat(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, _CombatID)
		AND
		DB_Is_InCombat(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, _CombatID)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_KillDirectorGortash_State_WyllKilledRavengard_80e08ace-1e47-47b2-9f32-1587957eeacf);
		
		// somehow one-shotted outside combat, but both are in the Audience Hall
		PROC
		PROC_WYR_KillDirectorGortash_RavengardKilledDuringCeremony((CHARACTER)_Killer)
		AND
		IsInTrigger(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, (TRIGGER)S_WYR_WyrmRock_AudienceHallArea_a078f420-9f5e-452b-9391-e96e754b61c8, 1)
		AND
		IsInTrigger(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, (TRIGGER)S_WYR_WyrmRock_AudienceHallArea_a078f420-9f5e-452b-9391-e96e754b61c8, 1)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_KillDirectorGortash_State_WyllKilledRavengard_80e08ace-1e47-47b2-9f32-1587957eeacf);
		
		PROC
		PROC_WYR_KillDirectorGortash_RavengardKilledDuringCeremony((CHARACTER)_Killer)
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		AND
		DB_GlobalFlag(WYR_KillDirectorGortash_State_WyllKilledRavengard_80e08ace-1e47-47b2-9f32-1587957eeacf)
		AND
		QRY_ORI_Wyll_RavengardKilled_AD(_Killer)
		THEN
		DB_NOOP(1);
		//END_REGION
		
		//REGION Hostility
		IF
		FlagSet(WYR_KillDirectorGortash_Event_StartFight_8a332662-5a53-4b4c-a788-1341a9718b10, _, _ID)
		AND
		DB_DialogName(_Dialog, _ID) // here we only care if this flag was set in a dialog
		THEN
		DB_WYR_KillDirectorGortash_StartFightAfterDialog(_ID);
		
		IF
		DialogEnded(_, _ID)
		AND
		DB_WYR_KillDirectorGortash_StartFightAfterDialog(_ID)
		THEN
		NOT DB_WYR_KillDirectorGortash_StartFightAfterDialog(_ID);
		PROC_WYR_WyrmRock_GoToAlertState("GortashAttacked");
		
		PROC
		PROC_SceneInterrupted(_, _Player, "WYR_KillDirectorGortash_Ceremony", _Reason)
		AND
		DB_GLO_GenericSceneManager_ViolenceReason(_Reason)
		THEN
		PROC_ForceStopDialog(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac);
		PROC_SceneOver("WYR_KillDirectorGortash_Ceremony");
		PROC_WYR_WyrmRock_GoToAlertState("GortashAttacked");
		
		QRY
		QRY_DialogAttackRequested_CustomResponse((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, (CHARACTER)_Player)
		AND
		DB_DialogPlayers(_DialogID, _Player, _)
		AND
		DB_DialogName((DIALOGRESOURCE)WYR_KillDirectorGortash_Ceremony_5149a422-854a-9e05-433a-0520d87eb112, _DialogID)
		THEN
		PROC_TryStopDialogFor(_Player);
		PROC_SceneOver("WYR_KillDirectorGortash_Ceremony");
		PROC_WYR_WyrmRock_GoToAlertState("GortashAttacked");
		//END_REGION
		
		//REGION Audience Hall Combat
		IF
		DB_Is_InCombat(_SteelWatcher,_CombatID)
		AND
		DB_WYR_KillDirectorGortash_CeremonySteelWatchers((CHARACTER)_SteelWatcher)
		AND
		DB_WYR_WyrmRock_AudienceHallGuards(_Guard,_Dialog)
		AND
		NOT DB_Defeated(_Guard)
		AND
		NOT DB_WYR_WyrmRock_AudienceHallGuards_JoinedCombat(_Guard)
		THEN
		DB_WYR_WyrmRock_AudienceHallGuards_JoinedCombat(_Guard);
		PROC_EnterCombat(_Guard,_SteelWatcher);
		
		IF
		LeftCombat(_Guard,_)
		AND
		DB_WYR_WyrmRock_AudienceHallGuards_JoinedCombat(_Guard)
		THEN
		NOT DB_WYR_WyrmRock_AudienceHallGuards_JoinedCombat(_Guard);
		
		// Gortash defeated before the ceremony is over - immediately send away the patriars and servants
		// important for the case when he gets one-shotted and the fight doesn't even start
		IF
		FlagSet((FLAG)GLO_Gortash_State_PermaDefeated_74dd56ff-7e00-42a6-a0f3-0d122f364769, _, _)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_KillDirectorGortash_State_CeremonyEnded_9aeab401-c087-4f2e-9894-859df23680dc)
		THEN
		PROC_WYR_KillDirectorGortash_SendPatriarsAway();
		PROC_WYR_KillDirectorGortash_SendServantsAway();
		
		IF
		DB_WYR_KillDirectorGortash_AudienceHallCombatID(_CombatID)
		THEN
		PROC_WYR_KillDirectorGortash_SendPatriarsAway();
		PROC_WYR_KillDirectorGortash_SendServantsAway();
		
		PROC
		PROC_WYR_KillDirectorGortash_SendPatriarsAway()
		AND
		QRY_OnlyOnce("WYR_KillDirectorGortash_SendFakePatriarsAway")
		AND
		DB_WYR_KillDirectorGortash_FakePatriars(_NPC, _)
		THEN
		PROC_WYR_KillDirectorGortash_CheckNotifyWhenReadyToMoveOn(_NPC);
		
		PROC
		PROC_WYR_KillDirectorGortash_SendPatriarsAway()
		AND
		QRY_OnlyOnce("WYR_KillDirectorGortash_SendPatriarsAway")
		AND
		DB_WYR_KillDirectorGortash_AudienceHallNPCs(_NPC, _, _, 1, _)
		THEN
		PROC_WYR_KillDirectorGortash_CheckNotifyWhenReadyToMoveOn(_NPC);
		
		PROC
		PROC_WYR_KillDirectorGortash_SendServantsAway()
		AND
		QRY_OnlyOnce("WYR_KillDirectorGortash_SendServantsAway")
		AND
		DB_WYR_KillDirectorGortash_AudienceHallServants(_NPC, _)
		THEN
		PROC_WYR_KillDirectorGortash_CheckNotifyWhenReadyToMoveOn(_NPC);
		
		PROC
		PROC_WYR_KillDirectorGortash_CheckNotifyWhenReadyToMoveOn((CHARACTER)_NPC)
		AND
		NOT DB_PermaDefeated(_NPC)
		THEN
		SetCanFight(_NPC, 0);
		SetCanJoinCombat(_NPC, 0);
		PROC_NotifyWhenReadyToMoveOn(_NPC, "WYR_KillDirectorGortash_AudienceHallCivilianEscape");
		
		PROC
		PROC_ReadyToMoveOn(_NPC, "WYR_KillDirectorGortash_AudienceHallCivilianEscape")
		THEN
		PROC_DisappearOutOfSightTo(_NPC, S_WYR_KillDirectorGortash_EscapePoint_c986d44f-ee55-4ad2-8c18-41f6a1644de0, "Run", 0, "");
		//END_REGION
		
		//REGION Office
		IF
		DB_WYR_KillDirectorGortash_Banites(_Banite, _)
		THEN
		DB_GLO_DefeatCounter(_Banite, "WYR_KillDirectorGortash_MainBodyguards");
		
		// unlink Gortash and Ravengard from the Audience Hall combat group
		IF
		LeftTrigger((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, (TRIGGER)S_WYR_WyrmRock_AudienceHallArea_a078f420-9f5e-452b-9391-e96e754b61c8)
		AND
		GetCombatGroupID(S_WYR_WyrmRock_AudienceHallGuard_001_d3dea7b0-3c9d-431b-9671-e6a00b726a9c, _CombatGroupID)
		AND
		GetCombatGroupID(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, _CombatGroupID)
		THEN
		SetCombatGroupID(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, "");
		
		IF
		LeftTrigger((CHARACTER)S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, (TRIGGER)S_WYR_WyrmRock_AudienceHallArea_a078f420-9f5e-452b-9391-e96e754b61c8)
		AND
		GetCombatGroupID(S_WYR_WyrmRock_AudienceHallGuard_001_d3dea7b0-3c9d-431b-9671-e6a00b726a9c, _CombatGroupID)
		AND
		GetCombatGroupID(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, _CombatGroupID)
		THEN
		SetCombatGroupID(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, "");
		
		IF
		EnteredTrigger((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, (TRIGGER)S_WYR_WyrmRock_RoofArea_6f590602-360a-4b7f-b936-f04f44a33dee)
		AND
		QRY_OnlyOnce("WYR_KillDirectorGortash_UpdateFactionsInGortashsOffice")
		THEN
		PROC_WYR_KillDirectorGortash_UpdateFactionsInGortashsOffice();
		
		PROC
		PROC_WYR_KillDirectorGortash_UpdateFactionsInGortashsOffice()
		AND
		DB_WYR_KillDirectorGortash_Banites(_Banite, _Replacement)
		AND
		NOT DB_PermaDefeated(_Banite)
		THEN
		SetFaction(_Banite, (FACTION)ACT3_WYR_WyrmRock_Gortash_bfc76c31-9f16-4f27-af3f-c6b6747230dc);
		
		PROC
		PROC_WYR_KillDirectorGortash_UpdateFactionsInGortashsOffice()
		AND
		NOT DB_PermaDefeated(S_WYR_GortashsOffice_SteelWatcher_5967b1c5-8e3c-4064-83e3-5219aa204c3d)
		THEN
		SetFaction(S_WYR_GortashsOffice_SteelWatcher_5967b1c5-8e3c-4064-83e3-5219aa204c3d, (FACTION)ACT3_WYR_WyrmRock_Gortash_bfc76c31-9f16-4f27-af3f-c6b6747230dc);
		
		PROC
		PROC_SpotPlayers_Spotted((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, "WYR_KillDirectorGortash_SpottingInOffice", _Player)
		AND
		QRY_StartDialog((DIALOGRESOURCE)WYR_KillDirectorGortash_GortashInOffice_b032707c-5cf3-be12-b590-d35f59019fd7, S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, _Player)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)WYR_KillDirectorGortash_GortashInOffice_b032707c-5cf3-be12-b590-d35f59019fd7, _ID)
		AND
		DB_WYR_KillDirectorGortash_DefaultBodyguards(_Bodyguard)
		AND
		NOT DB_PermaDefeated(_Bodyguard)
		THEN
		PROC_DialogAddSpeakingActor(_ID, _Bodyguard, 0, 1);
		
		IF
		DB_Is_InCombat(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, _CombatID)
		AND
		DB_InRegion(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, S_WYR_WyrmRock_RoofArea_6f590602-360a-4b7f-b936-f04f44a33dee)
		AND
		DB_WYR_KillDirectorGortash_RoofSteelWatchers(_RoofSteelWatcher, 1)
		AND
		NOT DB_CantMove(_RoofSteelWatcher)
		AND
		NOT DB_Is_InCombat(_RoofSteelWatcher, _)
		THEN
		PROC_ForceStopDialog(_RoofSteelWatcher);
		PROC_SetRelationToPlayers((FACTION)ACT3_WYR_WyrmRock_RoofSteelWatchers_523adbc8-5a94-4b33-aaac-1d1941fb1ac8, 0);
		PROC_NotifyWhenReadyToMoveOn(_RoofSteelWatcher, "WYR_KillDirectorGoratsh_MoveToGortash");
		
		PROC
		PROC_ReadyToMoveOn(_RoofSteelWatcher, "WYR_KillDirectorGoratsh_MoveToGortash")
		THEN
		PROC_CharacterMoveTo(_RoofSteelWatcher, S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, "Run", "");
		
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)WYR_KillDirectorGortash_State_GortashTurnedHostile_c003c217-b263-4473-9e4f-9a90aaf43cc9)
		AND
		GetFaction(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, _Faction)
		THEN
		PROC_SetRelationToPlayers(_Faction, 0);
		
		// any funny business in Gortash's office with him present - fight to death
		PROC
		PROC_SceneInterrupted(_, _, "WYR_KillDirectorGortash_SceneInOffice", _Reason)
		AND
		DB_GLO_GenericSceneManager_ViolenceReason(_Reason)
		THEN
		PROC_WYR_KillDirectorGortash_MakeOfficeHostile();
		
		PROC
		PROC_SceneInterrupted(_, _Char, "WYR_KillDirectorGortash_SceneInOffice", "DisturbanceRegistering")
		AND
		DB_SceneManager_DisturbanceRegistering(_Char, _Reason, _, _, _, _)
		AND
		DB_WYR_KillDirectorGortash_ForbiddenCrimes(_ForbiddenCrime)
		AND
		QRY_CRIME_IsCrimeFamilyMember(_Reason, _ForbiddenCrime)
		AND
		IsInTrigger(_Char, (TRIGGER)S_WYR_GortashsOfficeArea_d3c1c480-47bd-48cf-95c2-1ba9ed5a4bd0, 1)
		THEN
		PROC_WYR_KillDirectorGortash_MakeOfficeHostile();
		
		QRY
		QRY_DialogAttackRequested_CustomResponse((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, (CHARACTER)_Player)
		AND
		DB_DialogPlayers(_DialogID, _Player, _)
		AND
		DB_DialogName((DIALOGRESOURCE)WYR_KillDirectorGortash_GortashInOffice_b032707c-5cf3-be12-b590-d35f59019fd7, _DialogID)
		THEN
		PROC_TryStopDialogFor(_Player);
		PROC_WYR_WyrmRock_GoToAlertState("GortashAttacked");
		
		PROC
		PROC_WYR_KillDirectorGortash_MakeOfficeHostile()
		AND
		GetFaction(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, _Faction)
		THEN
		PROC_SpotPlayers_StopSpotting((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, "WYR_KillDirectorGortash_SpottingInOffice");
		PROC_SceneOver("WYR_KillDirectorGortash_SceneInOffice");
		PROC_ForceStopDialog(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac);
		PROC_SetRelationToPlayers(_Faction, 0);
		
		PROC
		PROC_WYR_KillDirectorGortash_MakeOfficeHostile()
		AND
		DB_WYR_KillDirectorGortash_AudienceHallBanites(_Banite, _)
		AND
		QRY_OnlyOnce("WYR_KillDirectorGortash_MakeAudienceHallBanitesHostile")
		AND
		GetFaction(_Banite, _Faction)
		THEN
		PROC_SetRelationToPlayers(_Faction, 0);
		//END_REGION Office
		
		//REGION Brainquakes on coming back with Orin's Netherstone
		IF
		EnteredTrigger(_Player, (TRIGGER)S_WYR_WyrmRock_GroundFloor_f470521a-d53c-4239-ad06-5f6ef55bd611)
		AND
		GetFlag((FLAG)LOW_BhaalTemple_State_HasNetherstone_818fd00e-6780-4712-980e-5c7c25ba9987, _Player, 1)
		AND
		QRY_OnlyOnce("WYR_KillDirectorGortash_GroundBrainquake")
		THEN
		PROC_GLO_Brainquakes_StartForcedEvent((CHARACTER)_Player, "WYR_KillDirectorGortash_GroundFloorBrainquakeEnded");
		
		IF
		EnteredTrigger(_Player, (TRIGGER)S_WYR_GortashsOfficeArea_d3c1c480-47bd-48cf-95c2-1ba9ed5a4bd0)
		AND
		GetFlag((FLAG)LOW_BhaalTemple_State_HasNetherstone_818fd00e-6780-4712-980e-5c7c25ba9987, _Player, 1)
		AND
		QRY_OnlyOnce("WYR_KillDirectorGortash_RoofBrainquake")
		THEN
		PROC_GLO_Brainquakes_StartForcedEvent((CHARACTER)_Player, "WYR_KillDirectorGortash_RoofBrainquakeEnded");
		//END_REGION
		
		//REGION Roof Access
		IF
		DB_GlobalFlag(WYR_KillDirectorGortash_State_InOffice_12233623-2dc3-4dbe-b493-b491fdf6321d)
		AND
		DB_GlobalFlag(GLO_Orin_State_PermaDefeated_c716e4d9-e6ed-445c-a710-ee4d91c67298)
		AND
		DB_GlobalFlag((FLAG)CURRENTREGION_BGO_Main_A_11239767-48ad-4879-8312-b9164b6e4978)
		AND
		NOT DB_GlobalFlag(WYR_KillDirectorGortash_State_HasRoofAccess_7582278e-27b8-4788-a511-2ff3d3af42bf)
		THEN
		PROC_GlobalSetFlagAndCache(WYR_KillDirectorGortash_State_HasRoofAccess_7582278e-27b8-4788-a511-2ff3d3af42bf);
		
		IF
		FlagSet(WYR_KillDirectorGortash_State_HasRoofAccess_7582278e-27b8-4788-a511-2ff3d3af42bf, _, _)
		THEN
		ClearOwnership(S_WYR_WyrmRock_DoorToRoof_99cede9e-36e3-49cc-97c0-b6799d498e91);
		ClearOwnership(S_Teleport_InvisibleDoor_A_WyrmRockBottomSpiral_dc367158-c538-4637-8316-3c1b6a2d196c);
		PROC_WYR_WyrmRock_GiveAccessToRoof();
		
		IF
		DB_CurrentLevel("BGO_Main_A")
		AND
		DB_GlobalFlag((FLAG)IRN_IronThrone_State_Destroyed_91795368-af06-4b56-9ac1-b78995aa9ea9)
		AND
		QRY_OnlyOnce("WYR_WyrmRock_MakeSteelWatchersHostile")
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT3_WYR_WyrmRock_RoofSteelWatchers_523adbc8-5a94-4b33-aaac-1d1941fb1ac8, 0);
		
		// can't just give them Gortash's faction - if we attack them it shouldn't make Gortash hostile
		IF
		DB_CurrentLevel("BGO_Main_A")
		AND
		DB_GlobalFlag(GLO_Orin_State_PermaDefeated_c716e4d9-e6ed-445c-a710-ee4d91c67298)
		AND
		NOT DB_GlobalFlag((FLAG)IRN_IronThrone_State_Destroyed_91795368-af06-4b56-9ac1-b78995aa9ea9)
		AND
		GetRelation((FACTION)ACT3_WYR_WyrmRock_Gortash_bfc76c31-9f16-4f27-af3f-c6b6747230dc, (FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, _Relation)
		AND
		_Relation > 0
		AND
		QRY_OnlyOnce("WYR_WyrmRock_UpdateRoofSteelWatchersFaction")
		THEN
		PROC_SetRelationMutual((FACTION)ACT3_WYR_WyrmRock_RoofSteelWatchers_523adbc8-5a94-4b33-aaac-1d1941fb1ac8, (FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, 50);
		//END_REGION Roof Access
		
		//REGION Gortash moves to the Morphic Pool
		IF
		LeftTrigger(_PartyMember, S_WYR_Fortress_SUB_94ca5a54-0813-48b4-9f55-4cb039a63c82)
		AND
		DB_PartyMembers(_PartyMember)
		AND
		DB_GlobalFlag(WYR_KillDirectorGortash_State_AgreedToMeetInUndercity_1375d542-cf0a-49fd-927b-5c6bbce13ce4)
		AND
		NOT DB_PermaDefeated(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac)
		AND
		NOT QRY_TriggerEvents_AnyPartyMemberInTrigger(S_WYR_Fortress_SUB_94ca5a54-0813-48b4-9f55-4cb039a63c82)
		AND
		QRY_OnlyOnce("WYR_KillDirectorGortash_MoveToUndercity")
		THEN
		PROC_NotifyWhenReadyToMoveOn((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, "WYR_KillDirectorGortash_MoveToUndercity");
		
		PROC
		PROC_ReadyToMoveOn((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, "WYR_KillDirectorGortash_MoveToUndercity")
		THEN
		PROC_SpotPlayers_StopSpotting((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, "WYR_KillDirectorGortash_SpottingInOffice");
		PROC_SceneOver("WYR_KillDirectorGortash_SceneInOffice");
		TeleportTo(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, S_END_MorphicGortashPoint_6bf2ed03-4bc6-4383-b17a-1b8fc71c8082, "WYR_KillDirectorGortash_TeleportedToUndercity");
		
		IF
		EntityEvent((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, "WYR_KillDirectorGortash_TeleportedToUndercity")
		THEN
		SetFlag(WYR_KillDirectorGortash_Event_TeleportedToUndercity_9914f986-f994-4001-9493-d943cb67e35a);
		//END_REGION
		
		//REGION Mindmeld with the Netherbrain
		IF
		AddedTo(S_WYR_CrownController_Gortash_383be300-d328-4152-86df-4927482d1fd7, (CHARACTER)_Player, _)
		AND
		DB_Players(_Player)
		AND
		QRY_GLO_EmperorPrelude_NotLastNetherstone((ITEM)S_WYR_CrownController_Gortash_383be300-d328-4152-86df-4927482d1fd7)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_Orin_State_PermaDefeated_c716e4d9-e6ed-445c-a710-ee4d91c67298)
		AND
		QRY_OnlyOnce("WYR_KillDirectorGortash_NetherbrainMindmeld")
		THEN
		DB_WYR_KillDirectorGortash_MindmeldDialogPlayer((CHARACTER)_Player);
		
		// if a player character in a dialog after which they leave the party, but the player also sends Gortash's gauntlet to that player character
		// we cancel the mindmeld dialog
		IF
		DB_WYR_KillDirectorGortash_MindmeldDialogPlayer(_Player)
		AND
		DB_GLO_PartyMembers_DismissAfterDialog(_, _Player)
		THEN
		NOT DB_WYR_KillDirectorGortash_MindmeldDialogPlayer(_Player);
		PROC_WYR_KillDirectorGortash_ReplaceLeavingPlayer(_Player);
		
		PROC
		PROC_WYR_KillDirectorGortash_ReplaceLeavingPlayer((CHARACTER)_LeavingPlayer)
		AND
		QRY_GetClosestAvailableCharacterTo(_LeavingPlayer, 0, 0, NULL_00000000-0000-0000-0000-000000000000, _LeavingPlayer, 0)
		AND
		DB_ClosestAvailableCharacterTo_PreferAvatar(_NewPlayer, _LeavingPlayer, _, _)
		THEN
		DB_WYR_KillDirectorGortash_MindmeldDialogPlayer(_NewPlayer);
		
		IF
		DB_WYR_KillDirectorGortash_MindmeldDialogPlayer(_Player)
		AND
		NOT DB_CantTalk(_Player)
		THEN
		NOT DB_WYR_KillDirectorGortash_MindmeldDialogPlayer(_Player);
		PROC_WYR_KillDirectorGortash_LaunchMindmeldDialog(_Player);
		
		PROC
		PROC_WYR_KillDirectorGortash_LaunchMindmeldDialog((CHARACTER)_Player)
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)WYR_KillDirectorGortash_NetherbrainMindmeld_673f3fd9-0e41-8d53-153b-72af69991378, _Player)
		THEN
		DB_NOOP(1);
		//END_REGION
		
		//REGION Ceremony pass / posters
		IF
		TemplateUseFinished(_Player, _Template, _, 1)
		AND
		DB_WYR_KillDirectorGortash_CeremonyInfoObjectTemplates(_Template)
		AND
		NOT DB_GlobalFlag(WYR_KillDirectorGortash_Knows_CeremonyLocationAndGortashName_5eb9384c-4108-4a68-85eb-ba72931a7bc9)
		THEN
		PROC_GlobalSetFlagAndCache(WYR_KillDirectorGortash_Knows_CeremonyLocationAndGortashName_5eb9384c-4108-4a68-85eb-ba72931a7bc9);
		PROC_TryStartAD((DIALOGRESOURCE)WYR_KillDirectorGortash_PAD_LearnedCeremony_296b127a-8e00-38f1-7759-538714bc9938, _Player);
		//END_REGION
		
		//REGION Debug
		IF
		FlagSet(Debug_WYR_KillDirectorGortash_Event_MeetGortashInHisOffice_ca4a33a9-db24-4e97-bf3a-0dab4b808e89, _Player, _)
		THEN
		PROC_Debug_WYR_KillDirectorGortash_SendGortashToHisOffice();
		PROC_TeleportPartiesTo((TRIGGER)S_Debug_Teleport_WYR_GortashsOffice_4734d350-a015-47ad-a97c-749c9c0bb477, "");
		
		IF
		TextEvent("gortash_send_to_office")
		THEN
		PROC_Debug_WYR_KillDirectorGortash_SendGortashToHisOffice();
		
		PROC
		PROC_Debug_WYR_KillDirectorGortash_SendGortashToHisOffice()
		THEN
		SetFlag((FLAG)WYR_KillDirectorGortash_State_AfterCeremony_a05a6945-21ad-400d-80bc-7b4934571c57);
		TeleportTo(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, S_WYR_GortashsPositionInOffice_fff3874c-e03b-4802-b0ba-e3584b8ca5ee, "WYR_KillDirectorGortash_ArrivedAtOffice");
		PROC_WYR_KillDirectorGortash_ReplaceBodyguardsInOffice();
		PROC_WYR_KillDirectorGortash_UpdateRoofSteelWatchersFaction();
		
		IF
		TextEvent("gortash_killbodyguards")
		THEN
		Die(S_WYR_GortashsOffice_SteelWatcher_5967b1c5-8e3c-4064-83e3-5219aa204c3d, DEATHTYPE.DoT, 1);
		
		IF
		TextEvent("gortash_killbodyguards")
		AND
		DB_WYR_KillDirectorGortash_Banites(_OriginalBanite, _)
		THEN
		Die(_OriginalBanite, DEATHTYPE.DoT, 1);
		
		IF
		TextEvent("kdg_hideswah")
		AND
		DB_WYR_KillDirectorGortash_CeremonySteelWatchers(_SteelWatcher)
		THEN
		PROC_SetOnStage(_SteelWatcher, 0);
		
		IF
		TextEvent("kdg_ceremonyaftermath")
		THEN
		PROC_WYR_KillDirectorGortash_CeremonyAftermath();
		//END_REGION
		
		//REGION Ravengard force removal
		IF
		EnteredTrigger(_Player, (TRIGGER)S_WYR_KillDirectorGortash_RavengardRemovalArea_Bridge_77770f96-ebfa-4e9e-9a27-a3ef0090d7ba)  // near mizora
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		AND
		DB_GlobalFlag(WYR_KillDirectorGortash_State_GortashBecameArchduke_b91a5012-d49b-429d-9b86-b75686fa7582)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_WyrmRock_State_AlertState_3d238a15-bb39-411a-8023-23385c98f2b8) //If it's already on alert state, only register when all players left the area and failsafe to avoid him disappearing in the middle of combat if one party member enters the trigger
		AND
		NOT DB_GlobalFlag(WYR_KillDirectorGortash_State_RavengardForceRemoval_cda5ec5a-5614-45d5-aa60-f99e210dab5d)
		THEN
		PROC_GlobalSetFlagAndCache(WYR_KillDirectorGortash_State_RavengardForceRemoval_cda5ec5a-5614-45d5-aa60-f99e210dab5d);
		
		IF
		EnteredTrigger(_Player, (TRIGGER)S_WYR_KillDirectorGortash_RavengardRemovalArea_GroundFloor_244e4e54-52bd-4812-bac7-6206166e5195) // ground floor of the fortress
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		AND
		DB_GlobalFlag(WYR_KillDirectorGortash_State_GortashBecameArchduke_b91a5012-d49b-429d-9b86-b75686fa7582)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_WyrmRock_State_AlertState_3d238a15-bb39-411a-8023-23385c98f2b8) //If it's already on alert state, only register when all players left the area and failsafe to avoid him disappearing in the middle of combat if one party member enters the trigger
		AND
		NOT DB_GlobalFlag(WYR_KillDirectorGortash_State_RavengardForceRemoval_cda5ec5a-5614-45d5-aa60-f99e210dab5d)
		THEN
		PROC_GlobalSetFlagAndCache(WYR_KillDirectorGortash_State_RavengardForceRemoval_cda5ec5a-5614-45d5-aa60-f99e210dab5d);
		
		IF
		FlagSet((FLAG)WYR_KillDirectorGortash_State_GortashBecameArchduke_b91a5012-d49b-429d-9b86-b75686fa7582, _, _)
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		AND
		NOT DB_GlobalFlag(WYR_KillDirectorGortash_State_RavengardForceRemoval_cda5ec5a-5614-45d5-aa60-f99e210dab5d)
		THEN
		DB_TriggerEvents_AllPartyMembersLeft(S_WYR_WyrmRock_AudienceHallArea_a078f420-9f5e-452b-9391-e96e754b61c8, "WYR_KillDirectorGortash_WaitForAllPartyMembersToLeaveAudienceHall");
		
		IF
		EntityEvent(_, "WYR_KillDirectorGortash_WaitForAllPartyMembersToLeaveAudienceHall")
		AND
		NOT DB_GlobalFlag(WYR_KillDirectorGortash_State_RavengardForceRemoval_cda5ec5a-5614-45d5-aa60-f99e210dab5d)
		THEN
		PROC_GlobalSetFlagAndCache(WYR_KillDirectorGortash_State_RavengardForceRemoval_cda5ec5a-5614-45d5-aa60-f99e210dab5d);
		
		IF
		FlagSet((FLAG)WYR_KillDirectorGortash_State_RavengardForceRemoval_cda5ec5a-5614-45d5-aa60-f99e210dab5d, _, _)
		THEN
		PROC_TriggerUnregisterForPlayers(S_WYR_KillDirectorGortash_RavengardRemovalArea_244e4e54-52bd-4812-bac7-6206166e5195);
		PROC_ForceStopDialog(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03);
		PROC_RemoveDialog(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03);
		SetCanFight(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, 0);
		SetCanJoinCombat(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, 0);
		LeaveCombat(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03);
		PROC_WYR_KillDirectorGortash_RavengardReadyToDisappear();
		
		PROC
		PROC_WYR_KillDirectorGortash_RavengardReadyToDisappear()
		AND
		DB_CantMove(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03)
		THEN
		PROC_WYR_KillDirectorGortash_RemoveRavengardFromAudienceHall();
		
		PROC
		PROC_WYR_KillDirectorGortash_RavengardReadyToDisappear()
		AND
		NOT DB_CantMove(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03)
		THEN
		PROC_CharacterMoveTo((CHARACTER)S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, S_WYR_WyrmRock_DoorToRoof_99cede9e-36e3-49cc-97c0-b6799d498e91, "Run", "WYR_KillDirectorGortash_RavengardReadyToDisappear");
		
		IF
		EntityEvent(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, "WYR_KillDirectorGortash_RavengardReadyToDisappear")
		THEN
		PROC_WYR_KillDirectorGortash_RemoveRavengardFromAudienceHall();
		//END_REGION
		
		//REGION No bribes in the Audience Hall
		IF
		DB_WYR_WyrmRock_AudienceHallGuards(_Guard, _)
		THEN
		DB_CrimeEluding_CantBeEludedUsing(_Guard, "Bribe");
		//END_REGION
		
		//REGION Gortash Death Test
		IF
		TextEvent("gortashtochasm")
		AND
		GetHostCharacter(_Player)
		THEN
		TeleportTo(_Player, S_Debug_WYR_KillDirectorGortash_WatchPos_b04f63c3-1ff7-4e28-a036-81ec9688a429);
		TeleportTo(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, S_Debug_WYR_KillDirectorGortash_WatchPos_b04f63c3-1ff7-4e28-a036-81ec9688a429, "");
		
		IF
		TextEvent("gortashinchasm")
		THEN
		TeleportTo(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, S_Debug_WYR_KillDirectorGortash_DeathPos_18e9c1d4-ed6f-42e7-a296-efaecb2fe092);
		
		IF
		TextEvent("removepatriarcrowds")
		THEN
		PROC_WYR_KillDirectorGortash_RemovePatriarCrowds();
		//END_REGION
		
		//REGION Disperse attendants near the entrance
		IF
		FlagSet((FLAG)WYR_KillDirectorGortash_State_GortashBecameArchduke_b91a5012-d49b-429d-9b86-b75686fa7582, _, _)
		AND
		DB_WYR_KillDirectorGortash_CrowdsAtEntrance(_CrowdTrigger)
		THEN
		TriggerSetCrowdSpawningEnable(_CrowdTrigger, 0);
		TriggerSetCrowdBehaviour(_CrowdTrigger, CROWDBEHAVIOUR.Disperse);
		
		IF
		FlagSet((FLAG)WYR_KillDirectorGortash_State_GortashBecameArchduke_b91a5012-d49b-429d-9b86-b75686fa7582, _, _)
		THEN
		TimerLaunch("WYR_KillDirectorGortash_ForceRemoveEntranceCrowds", 6000);
		
		IF
		TimerFinished("WYR_KillDirectorGortash_ForceRemoveEntranceCrowds")
		AND
		DB_WYR_KillDirectorGortash_CrowdsAtEntrance(_CrowdTrigger)
		THEN
		TriggerDespawnCrowd((TRIGGER)_CrowdTrigger);
		//END_REGION
		
		//REGION Fade between Karlach's OM and main Ceremony dialog
		IF
		TextEvent("forcestop")
		THEN
		PROC_ForceStopDialog(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac);
		//END_REGION
		
		//REGION Making Steel Watchers less hostile after meeting with Gortash
		IF
		DB_GlobalFlag((FLAG)WYR_KillDirectorGortash_State_SteelWatcherInvitationHappened_f73940d9-d4d9-43d1-9a4c-766713b6d984)
		AND
		DB_WYR_KillDirectorGortash_CalmSteelWatch_Patched(1)
		AND
		NOT DB_WYR_KillDirectorGortash_CalmSteelWatch_Done(1)
		THEN
		PROC_WYR_KillDirectorGortash_CalmSteelWatch();
		
		IF
		DB_GlobalFlag((FLAG)LOW_SteelWatchFoundry_State_Destroyed_cdfffe24-5082-4e41-b7c2-f1fef6da3a8a)
		AND
		DB_WYR_KillDirectorGortash_CalmSteelWatch_Patched(1)
		AND
		NOT DB_WYR_KillDirectorGortash_CalmSteelWatch_Done(1)
		THEN
		PROC_WYR_KillDirectorGortash_CalmSteelWatch();
		
		IF
		DB_GlobalFlag((FLAG)GLO_Gortash_State_PermaDefeated_74dd56ff-7e00-42a6-a0f3-0d122f364769)
		AND
		DB_WYR_KillDirectorGortash_CalmSteelWatch_Patched(1)
		AND
		NOT DB_WYR_KillDirectorGortash_CalmSteelWatch_Done(1)
		THEN
		PROC_WYR_KillDirectorGortash_CalmSteelWatch();
		
		IF
		DB_GlobalFlag((FLAG)WYR_KillDirectorGortash_State_OfferedAlliance_03713386-ba9a-46b8-9911-554b89072d88)
		AND
		DB_WYR_KillDirectorGortash_CalmSteelWatch_Patched(1)
		AND
		NOT DB_WYR_KillDirectorGortash_CalmSteelWatch_Done(1)
		THEN
		PROC_WYR_KillDirectorGortash_CalmSteelWatch();
		
		PROC
		PROC_WYR_KillDirectorGortash_CalmSteelWatch()
		THEN
		DB_WYR_KillDirectorGortash_CalmSteelWatch_Done(1);
		//END_REGION
		
		//REGION Flag for Mizora
		IF
		FlagSet((FLAG)GLO_Gortash_State_PermaDefeated_74dd56ff-7e00-42a6-a0f3-0d122f364769, _, _)
		THEN
		SetFlag(GLO_Gortash_State_Encountered_01d67e4c-32c6-4ea8-bf4d-a499467692f7);
		
		IF
		FlagSet((FLAG)GLO_Gortash_HasMet_74cffb8f-fc93-4c67-a12e-aa2cc8890291, _, _)
		THEN
		SetFlag(GLO_Gortash_State_Encountered_01d67e4c-32c6-4ea8-bf4d-a499467692f7);
		//END_REGION
		
		//REGION
		IF
		TextEvent("wyr_loadgore")
		THEN
		LoadLevelTemplate(LT_CoronationRoom_Massacre_A_000_94ee7c91-3c06-435b-a47f-174bc790b078);
		
		IF
		TextEvent("wyr_unloadgore")
		THEN
		UnloadLevelTemplate(LT_CoronationRoom_Massacre_A_000_94ee7c91-3c06-435b-a47f-174bc790b078);
		
		IF
		TextEvent("wyr_testbodyguards")
		AND
		DB_WYR_KillDirectorGortash_Banites(_Banite, _Replacement)
		THEN
		SetOnStage(_Banite, 1);
		SetFaction(_Banite, (FACTION)ACT3_WYR_WyrmRock_Gortash_bfc76c31-9f16-4f27-af3f-c6b6747230dc);
		SetOnStage(_Replacement, 1);
		SetFaction(_Replacement, (FACTION)ACT3_WYR_WyrmRock_Gortash_bfc76c31-9f16-4f27-af3f-c6b6747230dc);
		//END_REGION
		
		//REGION Goal Completion
		IF
		FlagSet(END_General_State_Started_a0fd5f91-e4b3-4d01-84d3-9ff484139e99, _, _)
		THEN
		GoalCompleted;
		//END_REGION
	}
	EXIT
	{
	}
}
