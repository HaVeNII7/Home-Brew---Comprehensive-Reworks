		DB_GlobalFlagReactionAfterDialog((FLAG)WYR_SharessCaress_Event_RatLeaves_776f59b9-fa4a-eec2-9ed5-339830950b93, WYR_SharessCaress_BasementRat_97307063-4fbf-8900-8a96-8d4697b9d73d);
		
		DB_ItemOwnerShipTriggers("BGO_Main_A", (TRIGGER)S_WYR_SharessCaress_Kitchen_OwnershipArea_034fc976-9cdc-4a43-bda7-5cf5074bb09f, (CHARACTER)S_WYR_SharessCaress_Chef_21284965-3c4b-465b-8837-ba699dbaaeb6);
		//END_REGION
		
		//REGION Boasting Crooks
		DB_Dialogs(S_WYR_SharessCaress_BoastingCrooks_Zhent_b8cc3112-5a9e-4306-b91a-2eb50391fe94, WYR_SharessCaress_BoastingCrooks_Zhent_36737cea-99c4-d03e-a18c-563f5b3d4fb0);
		DB_Dialogs(S_WYR_SharessCaress_BoastingCrooks_RivingtonRat_59f97331-f6bc-45b5-bf21-03ea4341e99e, WYR_SharessCaress_BoastingCrooks_Rat_ba171f3b-5f7a-3bb1-e743-6bde055960df);
		DB_DialogMoneyTransfer(1, (DIALOGRESOURCE)WYR_SharessCaress_BoastingCrooks_Rat_ba171f3b-5f7a-3bb1-e743-6bde055960df, 100, 2); // Player (speaker 2) paying to the NPC (default speaker 1)
		
		DB_DialogMoneyTransfer(1, (DIALOGRESOURCE)WYR_SharessCaress_BoastingCrooks_Threeway_968d248c-af8e-6546-80f4-ba8bd60eea4f, 100, 3, 2);  // Player (speaker 3) paying to the NPC (speaker 2)
		
		DB_WYR_BoastingCrooks_Speakers((CHARACTER)S_WYR_SharessCaress_BoastingCrooks_Zhent_b8cc3112-5a9e-4306-b91a-2eb50391fe94);
		DB_WYR_BoastingCrooks_Speakers(S_WYR_SharessCaress_BoastingCrooks_RivingtonRat_59f97331-f6bc-45b5-bf21-03ea4341e99e);
		
		DB_DialogBlockAttackButton((DIALOGRESOURCE)WYR_SharessCaress_BoastingCrooks_Threeway_968d248c-af8e-6546-80f4-ba8bd60eea4f);
		//END_REGION
		
		//REGION Nymph-s Grotto room
		DB_Dialogs(
			S_WYR_SharessCaress_NymphRoom_Nymph_bc3a5dac-3179-4a7c-bd3f-1391eb6d5497,
			S_WYR_SharessCaress_NymphRoom_FlamingFist_b5cb7f36-6ab8-48fb-9ddb-0bcb67807e44,
			S_WYR_SharessCaress_NymphRoom_NetherbrainFlamingFist_a19ad7b2-ef28-4d85-a422-c8abd6fecfc8,
			WYR_SharessCaress_NymphRoom_ThreeWay_NymphFlamingFist_35797ab0-20f8-8cff-896b-ad042cf735fb);
		
		DB_WYR_SharessCaress_NymphRoom_SceneCharacters((CHARACTER)S_WYR_SharessCaress_NymphRoom_Nymph_bc3a5dac-3179-4a7c-bd3f-1391eb6d5497);
		DB_WYR_SharessCaress_NymphRoom_SceneCharacters((CHARACTER)S_WYR_SharessCaress_NymphRoom_FlamingFist_b5cb7f36-6ab8-48fb-9ddb-0bcb67807e44);
		
		DB_DialogBlockAttackButton((DIALOGRESOURCE)WYR_SharessCaress_NymphRoom_ThreeWay_NymphFlamingFist_35797ab0-20f8-8cff-896b-ad042cf735fb);
		//END_REGION
		
		//REGION Nymph and the flaming fist
		DB_Dialogs(
			S_WYR_SharessCaress_Nymph_01_662b787e-d5f1-4bd2-b398-36961bda0ab4,
			S_WYR_SharessCaress_FlamingFist_01_350212e9-a8d6-43aa-8595-61e0d69b46f1,
