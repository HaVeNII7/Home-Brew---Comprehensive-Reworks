		DB_ORI_OriginCampData((CHARACTER)S_FOR_OwlBear_Cub_001_c66b2865-6613-4372-b97a-e330c1d75d09,"WLDDUNABB",(TRIGGER)S_CAMP_WLDDUNABB_OwlbearCub_a3a089f4-3677-49c3-b7e0-497353326dba);
		DB_ORI_OriginCampData((CHARACTER)S_FOR_OwlBear_Cub_001_c66b2865-6613-4372-b97a-e330c1d75d09,"WLDBAS",(TRIGGER)S_CAMP_WLDBAS_OwlbearCub_73ebb6e1-5e36-47ab-a261-953704341a37);
		DB_ORI_OriginCampData((CHARACTER)S_FOR_OwlBear_Cub_001_c66b2865-6613-4372-b97a-e330c1d75d09,"WLDCAVGRN",(TRIGGER)S_CAMP_WLDCAVGRN_OwlbearCub_15ea3317-09fd-4e1b-819a-db66d737ddeb);
		DB_ORI_OriginCampData((CHARACTER)S_FOR_OwlBear_Cub_001_c66b2865-6613-4372-b97a-e330c1d75d09,"WLDDUNSHA",(TRIGGER)S_CAMP_WLDDUNSHA_OwlbearCub_92e843a5-d852-48dd-9d95-581320bfc55e);
		DB_ORI_OriginCampData((CHARACTER)S_FOR_OwlBear_Cub_001_c66b2865-6613-4372-b97a-e330c1d75d09,"WLDCAVSND",(TRIGGER)S_CAMP_WLDCAVSND_OwlbearCub_88726453-eb0f-4a73-b97a-5c7b1424dddf);
		DB_ORI_OriginCampData((CHARACTER)S_FOR_OwlBear_Cub_001_c66b2865-6613-4372-b97a-e330c1d75d09,"WLDUND",(TRIGGER)S_CAMP_WLDUND_OwlbearCub_870bf3d7-85be-4f66-9170-0d303c184e51);
		//END_REGION
	}
	KB
	{
		//REGION Teleport To Camp - Halsin
		IF
		EntityEvent(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, "DebugTeleportedToCamp")
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		DB_Dialogs(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, (DIALOGRESOURCE)CAMP_Halsin2_c0ab0f6f-3ffc-d06d-0d6d-d1aaef70dfe4);
		PROC_ORI_SetupCamp((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1);
		//END_REGION
		
		//REGION Teleport To Camp - Volo
		IF
		EntityEvent(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"DebugTeleportedToCamp")
		AND
		NOT DB_GlobalFlag(GLO_Volo_State_AtCamp_de1cadca-2eca-4cee-a3dc-e262bbb92277)
		THEN
		PROC_GOB_VoloBallad_MoveVoloToCamp(CAMP_VoloOperation_ba7c506d-c743-5dc9-7d98-eeea7b4ef2a2);
		
		PROC
		PROC_GOB_VoloBallad_MoveVoloToCamp((DIALOGRESOURCE)_Dialog)
		THEN
		ClearFlag(GLO_Volo_State_AtDen_c1bb44ab-c358-46d1-a261-34356bf1d071, NULL_00000000-0000-0000-0000-000000000000, 0);
		ClearFlag((FLAG)GLO_Volo_State_AtGoblinCamp_fc815506-028d-582d-a953-4182d682aa07, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		SetFlag((FLAG)GLO_Volo_State_AtCamp_de1cadca-2eca-4cee-a3dc-e262bbb92277, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		SetCanTrade(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,1);
		PROC_SetCustomTradeTreasure(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"DEN_Volo_Trade");
		PROC_RemoveNPCADs(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		PROC_RemoveAllDialogEntriesForSpeaker(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		PROC_ORI_SetupCamp((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, 1);
		PROC_SceneOver("GOB_VoloScene");
		PROC_CharacterEnableAllCrimes(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		DB_Dialogs(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, _Dialog);
		//END_REGION
		
		//REGION FollowerCRD - Volo
		//First time in camp
		IF
		DB_InCamp((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa)
		AND
		DB_Dialogs((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, (DIALOGRESOURCE)CAMP_VoloOperation_ba7c506d-c743-5dc9-7d98-eeea7b4ef2a2)
		AND
		QRY_OnlyOnce("FCRD_Volo_Intro_Act1")
		THEN
		PROC_CampRelationshipDialog((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,(DIALOGRESOURCE)CAMP_VoloOperation_ba7c506d-c743-5dc9-7d98-eeea7b4ef2a2,(FLAG)FCRD_Volo_Intro_Act1_03b22a7f-5292-407e-b0a5-8acc6139c2ca,0);
		PROC_Try_CampRelationshipDialog((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,1);
		
		//Research Done for Operation
		IF
		DB_InCamp((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa)
		AND
		DB_GlobalFlag((FLAG)GLO_Volo_State_Researched_2cf45e20-a429-7d90-283a-47033bdbf62c)
		AND
		DB_Dialogs((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, (DIALOGRESOURCE)CAMP_VoloOperation_ba7c506d-c743-5dc9-7d98-eeea7b4ef2a2)
		AND
		QRY_OnlyOnce("FCRD_Volo_Researched")
		THEN
		PROC_CampRelationshipDialog((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,(DIALOGRESOURCE)CAMP_VoloOperation_ba7c506d-c743-5dc9-7d98-eeea7b4ef2a2,(FLAG)FCRD_Volo_Researched_478ef96b-b7db-45c0-b470-43937a6e76e6,0);
		PROC_Try_CampRelationshipDialog((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,1);
		
		//Back in camp act3
		IF
		DB_InCamp((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa)
		AND
		DB_Dialogs((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, (DIALOGRESOURCE)CAMP_Volo_f754e023-af3e-9ee6-d345-f7f88e7be0c8)
		AND
		QRY_OnlyOnce("FCRD_Volo_Intro_Act3")
		THEN
		PROC_CampRelationshipDialog((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,(DIALOGRESOURCE)CAMP_Volo_f754e023-af3e-9ee6-d345-f7f88e7be0c8,(FLAG)FCRD_Volo_Intro_Act3_41326d20-3f33-4219-ba20-d4c24ef573b0,0);
		PROC_Try_CampRelationshipDialog((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,1);
		//END_REGION
		
		//REGION Teleport To Camp - Owlbear Cub
		IF
		EntityEvent(S_FOR_OwlBear_Cub_001_c66b2865-6613-4372-b97a-e330c1d75d09, "DebugTeleportedToCamp")
		THEN
		SetFlag(CAMP_OwlbearCub_State_BecameCampFollower_a9742288-21b5-428a-9efa-a2e73981c02f);
		PROC_CampNight_ForceComplete(NIGHT_OwlbearCub1_43696ea8-3bff-440d-bee8-9cd912e4e8b4);
		PROC_CampNight_ForceComplete(NIGHT_OwlbearCub2_5cc6fbd5-0b70-4fb5-a29c-9b7ed9e39fcc);
		PROC_RemoveAllDialogEntriesForSpeaker((CHARACTER)S_FOR_OwlBear_Cub_001_c66b2865-6613-4372-b97a-e330c1d75d09);
		PROC_ORI_SetupCamp(S_FOR_OwlBear_Cub_001_c66b2865-6613-4372-b97a-e330c1d75d09,1);
		//END_REGION
		
		//REGION FollowerCRD - Courier Dog
		//First time in camp
		IF
		DB_InCamp((CHARACTER)S_FOR_Courier_Dog_3059f69c-068d-4e28-8491-55953c027901)
		AND
		QRY_OnlyOnce("FCRD_Courier_Dog_Intro")
		THEN
		PROC_CampRelationshipDialog((CHARACTER)S_FOR_Courier_Dog_3059f69c-068d-4e28-8491-55953c027901,(DIALOGRESOURCE)CAMP_Courier_Dog_2f2ab0f4-9b0e-3991-b6dd-44474a25e7a3,(FLAG)FCRD_Courier_Dog_Intro_78632996-e7a4-448b-b4f9-73f99efc4e89,0);
		PROC_Try_CampRelationshipDialog((CHARACTER)S_FOR_Courier_Dog_3059f69c-068d-4e28-8491-55953c027901,1);
		
		//Scratch has a gift for you (repeatable)
		IF
		FlagSet((FLAG)CAMP_Courier_Dog_State_FoundSomething_79f866c3-a40c-8088-6a93-780369ee747f,NULL_00000000-0000-0000-0000-000000000000,_)
		AND
		DB_InCamp((CHARACTER)S_FOR_Courier_Dog_3059f69c-068d-4e28-8491-55953c027901)
		THEN
		PROC_CampRelationshipDialog((CHARACTER)S_FOR_Courier_Dog_3059f69c-068d-4e28-8491-55953c027901,(DIALOGRESOURCE)CAMP_Courier_Dog_2f2ab0f4-9b0e-3991-b6dd-44474a25e7a3,(FLAG)FCRD_Courier_Dog_FoundSomething_bb50376f-a161-4aeb-9df9-39b7e004e59e,0);
		PROC_Try_CampRelationshipDialog((CHARACTER)S_FOR_Courier_Dog_3059f69c-068d-4e28-8491-55953c027901,1);
		
		//Repeatable CRD
		IF
		DB_RelationshipDialogsFinished((CHARACTER)S_FOR_Courier_Dog_3059f69c-068d-4e28-8491-55953c027901,(DIALOGRESOURCE)CAMP_Courier_Dog_2f2ab0f4-9b0e-3991-b6dd-44474a25e7a3,(FLAG)FCRD_Courier_Dog_FoundSomething_bb50376f-a161-4aeb-9df9-39b7e004e59e)
		THEN
		NOT DB_RelationshipDialogsFinished((CHARACTER)S_FOR_Courier_Dog_3059f69c-068d-4e28-8491-55953c027901,(DIALOGRESOURCE)CAMP_Courier_Dog_2f2ab0f4-9b0e-3991-b6dd-44474a25e7a3,(FLAG)FCRD_Courier_Dog_FoundSomething_bb50376f-a161-4aeb-9df9-39b7e004e59e);
		
		//Dead friend: owlbearcub
		IF
		DB_InCamp((CHARACTER)S_FOR_Courier_Dog_3059f69c-068d-4e28-8491-55953c027901)
		AND
		DB_GlobalFlag((FLAG)CAMP_OwlbearCubDog_State_Friends_e1b55fd2-8172-4f1c-b5e6-12ba2646f355)
		AND
		DB_GlobalFlag((FLAG)GLO_OwlbearCub_State_PermaDefeated_e407829a-d8ff-4759-9dbc-89f2b2f33151)
		AND
		NOT DB_GlobalFlag((FLAG)CAMP_Courier_Dog_State_TalkedAboutDeadOwlBearCub_028dfb80-078b-45d2-8da0-d0e30819cc47)
		AND
		QRY_OnlyOnce("FCRD_Courier_Dog_DeadOwlbearcub")
		THEN
		PROC_CampRelationshipDialog((CHARACTER)S_FOR_Courier_Dog_3059f69c-068d-4e28-8491-55953c027901,(DIALOGRESOURCE)CAMP_Courier_Dog_2f2ab0f4-9b0e-3991-b6dd-44474a25e7a3,(FLAG)FCRD_Courier_Dog_DeadOwlbear_b5217155-fbc8-4749-90fb-44afa976f83e,0);
		PROC_Try_CampRelationshipDialog((CHARACTER)S_FOR_Courier_Dog_3059f69c-068d-4e28-8491-55953c027901,1);
		
		//Dead friend: Escaped Equerry
		IF
		DB_InCamp((CHARACTER)S_FOR_Courier_Dog_3059f69c-068d-4e28-8491-55953c027901)
		AND
		DB_GlobalFlag((FLAG)WYR_Posthouse_State_PlayerReclaimedDog_513268de-0000-f621-2e77-13bb6c5fd74f)
		AND
		NOT DB_GlobalFlag((FLAG)CAMP_Courier_Dog_State_TalkedAboutPosthouseKennels_7f7bca08-d4eb-5c0f-c3cd-93db1f57363c)
		AND
		QRY_OnlyOnce("FCRD_Courier_Dog_Equerry")
		THEN
		PROC_CampRelationshipDialog((CHARACTER)S_FOR_Courier_Dog_3059f69c-068d-4e28-8491-55953c027901,(DIALOGRESOURCE)CAMP_Courier_Dog_2f2ab0f4-9b0e-3991-b6dd-44474a25e7a3,(FLAG)FCRD_Courier_Dog_Equerry_a20ba168-80f3-4a44-9359-4c7ebb3459b6,0);
		PROC_Try_CampRelationshipDialog((CHARACTER)S_FOR_Courier_Dog_3059f69c-068d-4e28-8491-55953c027901,1);
		//END_REGION
		
		//REGION FollowerCRD - Mizora's Romance
		IF
		DB_InCamp((CHARACTER)S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a)
		AND
		DB_GlobalFlag((FLAG)CAMP_Mizora_State_SuggestRomance_7e3e4852-5fac-4b51-9fc9-036d315b720d)
		AND
		NOT DB_CAMP_Mizora_StopSuggestingRomance(1)
		AND
		QRY_OnlyOnce("FCRD_Mizora_SuggestRomance")
		THEN
		PROC_CampRelationshipDialog((CHARACTER)S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a,(DIALOGRESOURCE)CAMP_Mizora_d1ad5fc6-6d64-e1b6-3f9d-e702a5c2d164,28755ce9-cb14-4baa-8e6a-bbdc88a4393d,0);
		PROC_Try_CampRelationshipDialog((CHARACTER)S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a,1);
		
		IF
		DialogEnded((DIALOGRESOURCE)CAMP_Mizora_d1ad5fc6-6d64-e1b6-3f9d-e702a5c2d164, _ID)
		AND
		DB_DialogPlayers(_ID, _Player, _)
		AND
		DB_GlobalFlag((FLAG)CAMP_Mizora_State_SuggestRomance_7e3e4852-5fac-4b51-9fc9-036d315b720d)
		AND
		GetFlag((FLAG)CAMP_Mizora_Event_RomanceOffered_c0544c56-c976-d8f5-6c77-accb1195c0ef, _Player, 0)
		AND
		QRY_OnlyOnce_Reset("FCRD_Mizora_SuggestRomance")
		THEN
		ClearFlag((FLAG)CAMP_Mizora_State_SuggestRomance_7e3e4852-5fac-4b51-9fc9-036d315b720d);
		DB_LongRestCountDown(1,(FLAG)CAMP_Mizora_State_SuggestRomance_7e3e4852-5fac-4b51-9fc9-036d315b720d);
		NOT DB_RelationshipDialogsFinished((CHARACTER)S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a,(DIALOGRESOURCE)CAMP_Mizora_d1ad5fc6-6d64-e1b6-3f9d-e702a5c2d164,28755ce9-cb14-4baa-8e6a-bbdc88a4393d);
		
		IF
		FlagSet((FLAG)CAMP_Mizora_Event_Gloating_507fcad8-eba4-21a6-95c8-917d71d20daa, _,_)
		THEN
		DB_CAMP_Mizora_StopSuggestingRomance(1);
		
		IF
		FlagSet((FLAG)CAMP_Mizora_Event_FinalDiscussion_75b5d361-e4c9-2271-ce84-bd32752aa7b8,_,_)
		THEN
		DB_CAMP_Mizora_StopSuggestingRomance(1);
		
		IF
		DB_CAMP_Mizora_StopSuggestingRomance(1)
		AND
		DB_LongRestCountDown(_Turn,(FLAG)CAMP_Mizora_State_SuggestRomance_7e3e4852-5fac-4b51-9fc9-036d315b720d)
		THEN
		NOT DB_LongRestCountDown(_Turn,(FLAG)CAMP_Mizora_State_SuggestRomance_7e3e4852-5fac-4b51-9fc9-036d315b720d);
		
		IF
		DB_CAMP_Mizora_StopSuggestingRomance(1)
		AND
		DB_GlobalFlag((FLAG)CAMP_Mizora_State_SuggestRomance_7e3e4852-5fac-4b51-9fc9-036d315b720d)
		THEN
		PROC_CancelRelationshipDialog((CHARACTER)S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a, (DIALOGRESOURCE)CAMP_Mizora_d1ad5fc6-6d64-e1b6-3f9d-e702a5c2d164,28755ce9-cb14-4baa-8e6a-bbdc88a4393d);
		PROC_GlobalClearFlagAndCache((FLAG)CAMP_Mizora_State_SuggestRomance_7e3e4852-5fac-4b51-9fc9-036d315b720d);
		
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(76).Title("_Gustav_CampFollowers_PostEA");
Goal(76)
{
	INIT
	{
		//REGION Camp Followers
		//DON'T FORGET TO MAKE THESE CHARACTERS GLOBAL! They travel with you when you move to new regions
		
		DB_OriginCampFlags((CHARACTER)S_GLO_Nightsong_6c55edb0-901b-4ba4-b9e8-3475a8392d9b, (FLAG)NIGHTSONG_ba0a2ed7-5bc4-41a5-a42f-7d4c729ef3c9, (FLAG)NULL_00000000-0000-0000-0000-000000000000, (FLAG)NULL_00000000-0000-0000-0000-000000000000, (FLAG)NULL_00000000-0000-0000-0000-000000000000, (FLAG)NULL_00000000-0000-0000-0000-000000000000);
