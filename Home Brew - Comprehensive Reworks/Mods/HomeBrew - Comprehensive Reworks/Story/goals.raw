		AND
		DB_QuestDef_State((FLAG)ORI_Astarion_State_BecameVampireLord_c446ce94-efd8-45d5-b407-284177b6b57e, "GLO_GatherYourAllies", "LordAstarionPromisesSupport")
		THEN
