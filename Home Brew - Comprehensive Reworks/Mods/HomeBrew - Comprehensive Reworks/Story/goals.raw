		PROC
		PROC_ORI_Karlach_SetAfterWyllConfrontationDialog((FLAG)_Branch)
		AND
		DB_Camp_NightMode(1)
		AND
		QRY_OnlyOnce("ORI_Karlach_SetReactionToWyllConfrontation")
		THEN
		DB_CampNight_CRD((FLAG)NIGHT_WyllConfrontation_NotRecruited_b35ff12a-ceae-4bf8-94e2-5050576e4d6e,(CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)_Branch);
		DB_CampNight_CRD((FLAG)NIGHT_WyllConfrontation_2576ba4e-90a9-4da0-bb40-6f012ed4a888,(CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)_Branch);
		DB_CampNight_EveryCRDGetsExclamationMark((FLAG)NIGHT_WyllConfrontation_NotRecruited_b35ff12a-ceae-4bf8-94e2-5050576e4d6e);
		DB_CampNight_EveryCRDGetsExclamationMark((FLAG)NIGHT_WyllConfrontation_2576ba4e-90a9-4da0-bb40-6f012ed4a888);
		
		PROC
		PROC_ORI_Karlach_SetAfterWyllConfrontationDialog((FLAG)_Branch)
		AND
		NOT DB_Camp_NightMode(1)
		AND
		QRY_OnlyOnce("ORI_Karlach_SetReactionToWyllConfrontation")
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)_Branch, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 0);
		
		IF
		FlagSet((FLAG)CAMP_MizorasJudgement_Event_Judged_c6d2140f-312d-65d4-e66e-92de4258b3f4,_,_)
		AND
		NOT DB_PartOfTheTeam((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		DB_Defeated((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		SetTag(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c,(TAG)BLOCK_RESURRECTION_22a75dbb-1588-407e-b559-5aa4e6d4e6a6);
		Die(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		
		IF
