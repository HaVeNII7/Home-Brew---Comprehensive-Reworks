		THEN
		PROC_CheckShouldSavegamePatchInLevel_SetBugfixMarker("Release Patch 5", "WLD_Main_A", "GUS-303364_WLD");
		
		PROC
		PROC_ApplySavegamePatchInLevel("WLD_Main_A", "GUS-303364_WLD")
