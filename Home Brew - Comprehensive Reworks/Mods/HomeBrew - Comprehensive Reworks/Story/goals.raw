		PROC_TeleportPartiesTo(S_Debug_Teleport_LOW_BhaalTemple_Inner_86321aa0-40d0-4244-982d-f1da2709726d, "LOW_BhaalTemple_Debug_ArrivedInTemple_Combat");
		
