	KB
	{
		//REGION Debug
		IF
		TextEvent("releasepatient")
		THEN
		PROC_TWN_Hospital_ReleasePatient();
		
		IF
		TextEvent("usechair")
		THEN
		Use(S_TWN_Hospital_Patient_70280618-041e-4029-b0b8-9b9cb4b7c494, S_TWN_Hospital_Chair_5cf9348a-4162-484d-833d-50671254f770, "TWN_Hospital_PatientOnChair");
		//END_REGION Debug
		
		//REGION Init
		IF
		ReposeAdded(S_TWN_Hospital_Patient_70280618-041e-4029-b0b8-9b9cb4b7c494, S_TWN_Hospital_Chair_5cf9348a-4162-484d-833d-50671254f770)
		THEN
		ApplyStatus(S_TWN_Hospital_Patient_70280618-041e-4029-b0b8-9b9cb4b7c494, "TWN_HOSPITAL_UNDEROPERATION", -1.0);
		
		IF
		StatusApplied(S_TWN_Hospital_Patient_70280618-041e-4029-b0b8-9b9cb4b7c494, "TWN_HOSPITAL_UNDEROPERATION", _, _)
		THEN
		Lock(S_TWN_Hospital_Chair_5cf9348a-4162-484d-833d-50671254f770, "TWN_Hospital_ChairRestraintsKey");
		
		IF
		DB_TWN_Hospital_Assistants(_Assistant)
		AND
		DB_TWN_Bosses_SpotTrigger((CHARACTER)S_TWN_Hospital_Surgeon_e58b8b34-038b-4858-b817-c2a8096a9381, _SpotID, _SpotTrigger)
		THEN
		DB_SceneManager(_Assistant, "TWN_Hospital_Operation");
		DB_GLO_DieFlag((FLAG)TWN_Hospital_Event_MakeNursesKillEachOtherWithClear_1047d1d0-7c2e-4531-b9f2-7aca6bd2e02f, _Assistant, DEATHTYPE.DoT, NULL_00000000-0000-0000-0000-000000000000);
		DB_SpotPlayers_SpotTrigger(_Assistant, _SpotID, _SpotTrigger);
		
		IF
		FlagSet((FLAG)TWN_Hospital_Event_KillPatient_e2659889-0153-4b54-9b91-d5bf91d69c70, _Speaker, _ID)
		THEN
		SetFlag((FLAG)TWN_Hospital_Event_KillPatientWithClear_51591e21-b8b1-4ffb-a9c8-d79e55d7370f, _Speaker, _ID);
		
		IF
		FlagSet((FLAG)TWN_Hospital_Event_MakeNursesKillEachOther_eeaccd5b-792a-4aa2-8503-17e0075422c7, _Speaker, _ID)
		THEN
		SetFlag((FLAG)TWN_Hospital_Event_MakeNursesKillEachOtherWithClear_1047d1d0-7c2e-4531-b9f2-7aca6bd2e02f, _Speaker, _ID);
		//END_REGION Init
		
		//REGION Main Dialog
		QRY
		QRY_SelectCustomDialog(S_TWN_Hospital_Patient_70280618-041e-4029-b0b8-9b9cb4b7c494, _Player)
		AND
		NOT DB_PermaDefeated(S_TWN_Hospital_Surgeon_e58b8b34-038b-4858-b817-c2a8096a9381)
		AND
		NOT DB_CantTalk(S_TWN_Hospital_Surgeon_e58b8b34-038b-4858-b817-c2a8096a9381)
		AND
		NOT DB_TWN_Hospital_SceneOver(1)
		THEN
		DB_SelectedDialog((DIALOGRESOURCE)TWN_Hospital_Surgeon_10b263cd-b704-9eb2-71f9-2c7f6eb4739b, S_TWN_Hospital_Surgeon_e58b8b34-038b-4858-b817-c2a8096a9381, _Player);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)TWN_Hospital_Surgeon_10b263cd-b704-9eb2-71f9-2c7f6eb4739b, (INTEGER)_ID)
		THEN
		PROC_DialogAddSpeakingActor(_ID, S_TWN_Hospital_Patient_70280618-041e-4029-b0b8-9b9cb4b7c494);
		PROC_DialogAddSpeakingActor(_ID, S_TWN_Hospital_ZealousAssistant_000_2250bda0-cf27-4567-8a71-b1a066113eb7);
		PROC_DialogAddSpeakingActor(_ID, S_TWN_Hospital_ZealousAssistant_001_e2c2a930-2eb5-419f-9020-c141a0fd0753);
		PROC_DialogAddSpeakingActor(_ID, S_TWN_Hospital_ZealousAssistant_002_a9e86a16-f426-4772-a187-39256c4568a1);
		PROC_DialogAddSpeakingActor(_ID, S_TWN_Hospital_ZealousAssistant_003_2be9d074-245f-4f4f-9385-260d08f4ea73);
		
		IF
		FlagSet(TWN_Hospital_Event_KillPatient_e2659889-0153-4b54-9b91-d5bf91d69c70, NULL_00000000-0000-0000-0000-000000000000, _)
		THEN
		PROC_SceneManager_RemoveFromScene(S_TWN_Hospital_Patient_70280618-041e-4029-b0b8-9b9cb4b7c494, "TWN_Hospital_Operation");
		
		IF
		FlagSet((FLAG)TWN_Hospital_Event_MakeNursesKillEachOther_eeaccd5b-792a-4aa2-8503-17e0075422c7, NULL_00000000-0000-0000-0000-000000000000, _)
		THEN
		PROC_SceneOver("TWN_Hospital_Operation");
		
		IF
		FlagSet(TWN_Hospital_State_PeacefulResolution_3830c1aa-6271-4af8-ba6c-0537bad1c624, NULL_00000000-0000-0000-0000-000000000000, _)
		THEN
		PROC_SceneOver("TWN_Hospital_Operation");
		//END_REGION Main Dialog
		
		//REGION Scene interruption & releasing the patient
		// Interrupting the scene makes the NPCs hostile
		PROC 
		PROC_SceneInterrupted(_, _, "TWN_Hospital_Operation", _)
		THEN
		PROC_TWN_Hospital_SceneCancelled();
		
		PROC 
		PROC_SceneInterrupted(_, _, "TWN_Hospital_Operation", "Died")
		THEN
		SetFlag(TWN_Hospital_State_OperationParticipantDied_a8a7c54f-5cbc-4270-b368-77a3b322885d, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		Unlocked(S_TWN_Hospital_Chair_5cf9348a-4162-484d-833d-50671254f770, _, _)
		AND
		QRY_TWN_Hospital_PatientRestrained()
		THEN
		PROC_TWN_Hospital_ReleasePatient();
		
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)TWN_Hospital_Event_ReleasePatient_b8dd8f9e-a7a1-47c8-a27f-2a84f5201aa4)
		THEN
		Unlock((ITEM)S_TWN_Hospital_Chair_5cf9348a-4162-484d-833d-50671254f770);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)TWN_Hospital_Event_ReleasePatient_b8dd8f9e-a7a1-47c8-a27f-2a84f5201aa4)
		AND
		QRY_TWN_Hospital_PatientRestrained()
		THEN
		PROC_TWN_Hospital_ReleasePatient();
		
		QRY
		QRY_TWN_Hospital_PatientRestrained()
		AND
		HasActiveStatus(S_TWN_Hospital_Patient_70280618-041e-4029-b0b8-9b9cb4b7c494, "TWN_HOSPITAL_UNDEROPERATION", 1)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_TWN_Hospital_ReleasePatient()
		AND
		NOT DB_GlobalFlag(TWN_Hospital_State_PatientReleased_2d47b88f-3c8e-4f74-8833-6934c7a6b70d)
		THEN
		PROC_TWN_Hospital_SceneCancelled();
		RemoveStatus(S_TWN_Hospital_Patient_70280618-041e-4029-b0b8-9b9cb4b7c494, "TWN_HOSPITAL_UNDEROPERATION");
		PROC_GlobalSetFlagAndCache(TWN_Hospital_State_PatientReleased_2d47b88f-3c8e-4f74-8833-6934c7a6b70d);
		PROC_TryStartAD((DIALOGRESOURCE)TWN_Hospital_Patient_AD_78e2bdef-50a0-ea30-ad81-aa2693c4fda1, S_TWN_Hospital_Patient_70280618-041e-4029-b0b8-9b9cb4b7c494);
		PROC_DisappearOutOfSightTo((CHARACTER)S_TWN_Hospital_Patient_70280618-041e-4029-b0b8-9b9cb4b7c494, S_TWN_Hospital_PatientEscapePosition_2904fff5-f507-440d-b54c-23bc11120c59, "Run", 0, "");
		
		PROC
		PROC_TWN_Hospital_SceneCancelled()
		AND
		GetFaction(S_TWN_Hospital_Surgeon_e58b8b34-038b-4858-b817-c2a8096a9381, _Faction)
		THEN
		PROC_SceneOver("TWN_Hospital_Operation");
		DB_TWN_Hospital_SceneOver(1);
		PROC_SetRelationToPlayers(_Faction, 0);
		PROC_SpotPlayers_StopSpotting(S_TWN_Hospital_Surgeon_e58b8b34-038b-4858-b817-c2a8096a9381, "TWN_Hospital_Surgeon");
		PROC_ForceStopDialog(S_TWN_Hospital_Surgeon_e58b8b34-038b-4858-b817-c2a8096a9381);
		//END_REGION Scene interruption & releasing the patient
		
		//REGION Blood Bank
		IF
		EnteredTrigger(_Player, S_TWN_BloodBank_AstarionReactionTrigger_0a838d1b-8958-4452-a042-f8414dcfef3d)
		AND
		IsInPartyWith(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, _Player, 1)
		AND
		GetDistanceTo(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, _Player, _Dist)
		AND
		_Dist < 8.0
		AND
		QRY_OnlyOnce("TWN_BloodBankApproached")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)TWN_ApproachedBloodBankInventoryList_PAD_7ad869f1-904c-88d3-8abe-7a0fbfec4596, S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255);
		PROC_TriggerUnregisterForPlayers(S_TWN_BloodBank_AstarionReactionTrigger_0a838d1b-8958-4452-a042-f8414dcfef3d);
		
		IF
		AddedTo(S_TWN_BloodBankInventoryList_ccf165b7-1cf6-4111-a8a5-54526a50396d, (CHARACTER)_Player, _)
		AND
		DB_Players(_Player)
		AND
		IsInPartyWith(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, _Player, 1)
		AND
		GetDistanceTo(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, _Player, _Dist)
		AND
		_Dist < 8.0
		AND
		QRY_OnlyOnce("TWN_BloodBankInventoryList")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)TWN_InteractedWithBloodBankInventoryList_PAD_c770e379-31e0-f7d0-45a2-2f541a240e52, S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255);
		
		IF
		GameBookInterfaceClosed(S_TWN_BloodBankInventoryList_ccf165b7-1cf6-4111-a8a5-54526a50396d, _Player)
		AND
		IsInPartyWith(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, _Player, 1)
		AND
		GetDistanceTo(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, _Player, _Dist)
		AND
		_Dist < 8.0
		AND
		QRY_OnlyOnce("TWN_BloodBankInventoryList")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)TWN_InteractedWithBloodBankInventoryList_PAD_c770e379-31e0-f7d0-45a2-2f541a240e52, S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255);
		//END_REGION Blood Bank
		
		//REGION Reception area
		
		PROC
		PROC_GlobalFlagReactionAfterDialog(TWN_Hospital_Reception_State_InLine_fd4c6ba1-e9f9-c8f5-e186-de837786d82a)
		AND
		NOT DB_GlobalFlag(TWN_Hospital_Reception_State_GainedAcess_f2f3f438-e6a4-4114-aaef-777db362be6a)
		THEN
		PROC_RemoveDBTrespassTrigger(S_TWN_Hospital_Reception_Trespass_901ec9f8-4307-4940-a884-e6f226071869,S_TWN_Hospital_Reception_OutTrigger_8f53c658-1ae4-42c8-813b-2451d05d73ea);
		DB_TrespassTrigger(S_TWN_Hospital_Reception_Tresspass_InLine_02ad008a-5aa2-424e-9035-fa320c239127,S_TWN_Hospital_Reception_OutTrigger_InLine_83559f44-29f7-4e72-adcb-ccccd8f8c391,"TWN_Hospital_Trespass");
		
		IF
		DB_GlobalFlag(TWN_Hospital_Reception_State_GainedAcess_f2f3f438-e6a4-4114-aaef-777db362be6a)
		THEN
		PROC_TWN_Reception_ClearTrespass();
		
		IF
		DB_GlobalFlag(TWN_Hospital_State_SurgeonDead_0820e94c-7007-4459-b935-2d33fbbf6aa9)
		THEN
		PROC_TWN_Reception_ClearTrespass();
		
		IF
		EnteredTrigger(_Player,S_TWN_Reception_ClearenceArea_37604104-5c59-41cb-b1e3-5ef7789f295d) //trigger only registered for players
		THEN
		PROC_TWN_Reception_ClearTrespass();
		
		PROC
		PROC_TWN_Reception_ClearTrespass()
		THEN
		PROC_RemoveDBTrespassTrigger(S_TWN_Hospital_Reception_Trespass_901ec9f8-4307-4940-a884-e6f226071869,S_TWN_Hospital_Reception_OutTrigger_8f53c658-1ae4-42c8-813b-2451d05d73ea);
		PROC_RemoveDBTrespassTrigger(S_TWN_Hospital_Reception_Tresspass_InLine_02ad008a-5aa2-424e-9035-fa320c239127,S_TWN_Hospital_Reception_OutTrigger_InLine_83559f44-29f7-4e72-adcb-ccccd8f8c391);
		PROC_TriggerUnregisterForPlayers(S_TWN_Reception_ClearenceArea_37604104-5c59-41cb-b1e3-5ef7789f295d);
		
		//trespass crime procs this particular override of PROC_DialogFlagSetup
		PROC
		PROC_DialogFlagSetup(TWN_Hospital_Reception_Receptionist_4cd1d078-0986-0370-2b67-b44db32af089,S_TWN_Hospital_Reception_Receptionist_3baf6794-2c83-4bd3-b2dd-70b4a9f98503,_Player,_,_,_)
		AND
		GetHitpointsPercentage(_Player,_HP)
		AND
		_HP<=40.0
		THEN
		SetFlag((FLAG)TWN_Hospital_Reception_State_LowHP_49c94af4-756c-fabd-ed7a-a88005598aed,NULL_00000000-0000-0000-0000-000000000000,0);
		
		//clicking on the receptionist triggers this override of PROC_DialogFlagSetup
		PROC
		PROC_DialogFlagSetup(TWN_Hospital_Reception_Receptionist_4cd1d078-0986-0370-2b67-b44db32af089,S_TWN_Hospital_Reception_Receptionist_3baf6794-2c83-4bd3-b2dd-70b4a9f98503,_Player)
		AND
		GetHitpointsPercentage(_Player,_HP)
		AND
		_HP<=40.0
		THEN
		SetFlag((FLAG)TWN_Hospital_Reception_State_LowHP_49c94af4-756c-fabd-ed7a-a88005598aed,NULL_00000000-0000-0000-0000-000000000000,0);
		
		IF
		DialogEnded(TWN_Hospital_Reception_Receptionist_4cd1d078-0986-0370-2b67-b44db32af089,_)
		THEN
		ClearFlag((FLAG)TWN_Hospital_Reception_State_LowHP_49c94af4-756c-fabd-ed7a-a88005598aed,NULL_00000000-0000-0000-0000-000000000000,0);
		
		//END_REGION Reception area
		
		//REGION Combat support
		IF
		CastedSpell(S_TWN_Hospital_Surgeon_e58b8b34-038b-4858-b817-c2a8096a9381, _Spell, _, _, _)
		AND
		DB_TWN_Hospital_SurgeonSpells(_Spell, _Status)
		AND
		QRY_TWN_Hospital_ClearStoredSpell()
		THEN
		DB_TWN_Hospital_LastSurgeonAttack(_Spell);
		
		QRY
		QRY_TWN_Hospital_ClearStoredSpell()
		AND
		DB_TWN_Hospital_LastSurgeonAttack(_Spell)
		THEN
		NOT DB_TWN_Hospital_LastSurgeonAttack(_Spell);
		
		IF
		AnimationEvent(S_TWN_Hospital_Surgeon_e58b8b34-038b-4858-b817-c2a8096a9381, "Script_SpellFinished", _)
		AND
		DB_TWN_Hospital_LastSurgeonAttack(_LastSpell)
		AND
		DB_TWN_Hospital_SurgeonSpells(_LastSpell, _Status)
		THEN
		NOT DB_TWN_Hospital_LastSurgeonAttack(_LastSpell);
		RemoveStatus(S_TWN_Hospital_Surgeon_e58b8b34-038b-4858-b817-c2a8096a9381, _Status);
		//END_REGION
		
		//REGION Nurses kill Surgeon
		IF
		FlagSet((FLAG)TWN_Hospital_Event_KillPatient_e2659889-0153-4b54-9b91-d5bf91d69c70, _, _)
		THEN
		TeleportTo(S_TWN_Hospital_Patient_70280618-041e-4029-b0b8-9b9cb4b7c494, (TRIGGER)S_TWN_Hospital_PatientCinematicDeathPos_bfaf1100-040a-43ee-ac89-cc5da75c5248, "TWN_Hospital_PatientTeleportedToDeathPos", 0, 0, 0, 1, 1);
		
		IF
		EntityEvent(S_TWN_Hospital_Patient_70280618-041e-4029-b0b8-9b9cb4b7c494, "TWN_Hospital_PatientTeleportedToDeathPos")
		THEN
		Die(S_TWN_Hospital_Patient_70280618-041e-4029-b0b8-9b9cb4b7c494, DEATHTYPE.Physical, S_TWN_Hospital_Surgeon_e58b8b34-038b-4858-b817-c2a8096a9381, 0, 1, 0.0);
		Use((CHARACTER)S_TWN_Hospital_Surgeon_e58b8b34-038b-4858-b817-c2a8096a9381, (ITEM)S_TWN_Hospital_Chair_5cf9348a-4162-484d-833d-50671254f770, "");
		//END_REGION
		
		//REGION PAD After surgeon dies
		IF
		DialogStarted((DIALOGRESOURCE)TWN_Hospital_Surgeon_10b263cd-b704-9eb2-71f9-2c7f6eb4739b, _ID)
		AND
		DB_DialogPlayers(_ID, _Player, 1)
		THEN
		DB_TWN_Hospital_PlayerForDeathPAD(_Player);
		
		IF
		FlagSet((FLAG)TWN_Hospital_State_SurgeonPermaDefeated_0820e94c-7007-4459-b935-2d33fbbf6aa9, _, _)
		AND
		NOT DB_TWN_Hospital_PlayerForDeathPAD(_)
		AND
		GetClosestAlivePlayer(S_TWN_Hospital_Surgeon_e58b8b34-038b-4858-b817-c2a8096a9381, _Player, _)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)TWN_Hospital_PAD_SurgeonDead_77cb98b7-e472-a604-bbda-8af444173251, _Player);
		
		IF
		FlagSet((FLAG)TWN_Hospital_State_SurgeonPermaDefeated_0820e94c-7007-4459-b935-2d33fbbf6aa9, _, _)
		AND
		DB_TWN_Hospital_PlayerForDeathPAD(_Player)
		THEN
		NOT DB_TWN_Hospital_PlayerForDeathPAD(_Player);
		PROC_TryStartAD((DIALOGRESOURCE)TWN_Hospital_PAD_SurgeonDead_77cb98b7-e472-a604-bbda-8af444173251, _Player);
		//END_REGION
		
		//REGION Peaceful Resolution XP
		IF
		FlagSet(TWN_Hospital_Event_MakeNursesKillEachOther_eeaccd5b-792a-4aa2-8503-17e0075422c7, _, _)
		AND
		DB_TWN_Hospital_Assistants(_Nurse)
		THEN
		PROC_PeacefulResolve(_Nurse);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog(TWN_Hospital_State_SurgeonKilledHimself_04969d92-f292-43c7-82a1-cd3ec967cded)
		THEN
		PROC_PeacefulResolve((CHARACTER)S_TWN_Hospital_Surgeon_e58b8b34-038b-4858-b817-c2a8096a9381);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog(TWN_Hospital_State_NursesKilledSurgeon_dc371af2-0788-43f9-990f-aaaf2192f8ca)
		THEN
		PROC_PeacefulResolve((CHARACTER)S_TWN_Hospital_Surgeon_e58b8b34-038b-4858-b817-c2a8096a9381);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog(TWN_Hospital_State_NursesKilledSurgeon_dc371af2-0788-43f9-990f-aaaf2192f8ca)
		AND
		DB_TWN_Hospital_Assistants(_Nurse)
		THEN
		PROC_PeacefulResolve(_Nurse);
		//END_REGION
		
		//REGION Morgue lever
		
		PROC
		PROC_BlockUseOfItem(_Player,(ITEM)S_TWN_Morgue_CliffDoorLever_5db0e117-1c05-4672-8e45-c88a8cfb7121)
		AND
		DB_Players(_Player)
		AND
		NOT DB_TWN_MorgueCliffLeverUnlocked(1)
		THEN
		DB_CustomUseItemResponse(_Player,(ITEM)S_TWN_Morgue_CliffDoorLever_5db0e117-1c05-4672-8e45-c88a8cfb7121,0);
		PROC_TryStartAD((DIALOGRESOURCE)GLO_AD_UnlockedElsewhere_2b333f67-01d7-46ad-2c26-bf00d3c34440,_Player);
		
		IF
		UseFinished(_Player,(ITEM)S_TWN_Morgue_CliffDoorLever_5db0e117-1c05-4672-8e45-c88a8cfb7121,1)
		AND
		DB_TWN_MorgueCliffLeverUnlocked(1)
		THEN
		DB_TWN_MorgueCliffDoorUnlocked(1);
		PROC_ItemUnlockAndOpen((ITEM)S_TWN_Morgue_CliffDoor_540a1bca-1a02-4ed0-ba2e-da1c9834656b);
		PROC_TryStartAD((DIALOGRESOURCE)GLO_AD_MechanicalClunk_a96814b5-9d5b-cf71-b0c3-39d4aea3dfd6,S_TWN_Morgue_CliffDoor_540a1bca-1a02-4ed0-ba2e-da1c9834656b);
		
		IF
		Opened(S_TWN_Morgue_CliffDoor_540a1bca-1a02-4ed0-ba2e-da1c9834656b)
		THEN
		DB_TWN_MorgueCliffDoorUnlocked(1);
		DB_TWN_MorgueCliffLeverUnlocked(1);
		
		IF
		UseFinished(_Player,(ITEM)S_TWN_Morgue_CliffDoorLeverUnlocker_bfc472a0-1ca0-4330-9aa5-528268795e56,1)
		AND
		NOT DB_TWN_MorgueCliffDoorUnlocked(1)
		AND
		NOT DB_TWN_MorgueCliffLeverUnlocked(1)
		THEN
		DB_TWN_MorgueCliffLeverUnlocked(1);
		PROC_TryStartAD((DIALOGRESOURCE)GLO_AD_MechanicalClunk_a96814b5-9d5b-cf71-b0c3-39d4aea3dfd6,S_TWN_Morgue_CliffDoorLeverUnlocker_bfc472a0-1ca0-4330-9aa5-528268795e56);
		PROC_TryStartAD((DIALOGRESOURCE)GLO_AD_MechanicalClunk_a96814b5-9d5b-cf71-b0c3-39d4aea3dfd6,S_TWN_Morgue_CliffDoorLever_5db0e117-1c05-4672-8e45-c88a8cfb7121);
		
		IF
		UseFinished(_Player,(ITEM)S_TWN_Morgue_CliffDoorButton_ed0f5fde-4063-4086-accb-d9e27d95f5f0,1)
		AND
		NOT DB_TWN_MorgueCliffDoorUnlocked(1)
		THEN
		DB_TWN_MorgueCliffDoorUnlocked(1);
		DB_TWN_MorgueCliffLeverUnlocked(1);
		PROC_ItemUnlockAndOpen((ITEM)S_TWN_Morgue_CliffDoor_540a1bca-1a02-4ed0-ba2e-da1c9834656b);
		PROC_TryStartAD((DIALOGRESOURCE)GLO_AD_MechanicalClunk_a96814b5-9d5b-cf71-b0c3-39d4aea3dfd6,S_TWN_Morgue_CliffDoor_540a1bca-1a02-4ed0-ba2e-da1c9834656b);
		
		//END_REGION Morgue lever
	}
	EXIT
	{
	}
}
Goal(469).Title("Act2_TWN_Korrilla");
Goal(469)
{
	INIT
	{
		PROC_TriggerRegisterForPlayers(S_GLO_KorrillaAppearCheck_e92bd605-d256-4031-b976-ef65614586c7);
		
	}
	KB
	{
		//REGION debug
		IF
		TextEvent("TWN_TestKorrilla")
		THEN
		PROC_TeleportPartiesTo(S_GLO_KorrillaAppearCheck_e92bd605-d256-4031-b976-ef65614586c7, "");
		//END_REGION
		
		IF
		DB_InRegion(_Player ,S_GLO_KorrillaAppearCheck_e92bd605-d256-4031-b976-ef65614586c7)
		AND
		DB_Players(_Player)
		AND
		QRY_OnlyOnce("TWN_Korrilla_Appear")
		THEN
		PROC_TWN_TeleportKorrillaAndWatch(S_GLO_KorrillaTownPos_552a7659-99de-4bf5-9108-8ab093fb0f56, _Player);
		
		//Korrilla teleports in and watches the palyer
		PROC
		PROC_TWN_TeleportKorrillaAndWatch((TRIGGER)_Trigger, (CHARACTER)_Player)
		THEN
		TeleportTo(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, _Trigger, "", 0, 0, 0, 0, 1);
		CharacterDisableAllCrimes(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297);
		PROC_GLO_Monitor_EntityFoop(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297);
		DB_Dialogs((CHARACTER)S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, (DIALOGRESOURCE)TWN_KorrillaTheSpy_Korrilla_aab4f3d2-4018-3855-d62d-62dc7cd1fef5);
		SetHitpointsPercentage(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, 100.0);
		LookAtEntity(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, _Player, 30.0);
		SetVisible(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, 1);
		PROC_GLO_Warlock_ApplyAllStatuses();
		ObjectTimerLaunch(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, "TWN_KorrillaPresenceTimer", 30000, 0);
		
		IF
		ObjectTimerFinished(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, "TWN_KorrillaPresenceTimer")
		THEN
		PROC_GLO_Warlock_TeleportOut();
		
		//IF Korrilla is approached by the player and she sees it, she teleports away
		IF
		StatusApplied(_Player, "TWN_KORRILLATHESPY_ISNEAR", _, _)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		DB_Sees((CHARACTER)S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, _Player)
		THEN
		PROC_GLO_Warlock_TeleportOut();
		PROC_TryStartAD(GLO_KorrillaTheSpy_PAD_KorrillaVanishesReaction_d67b6532-f773-6e07-3a4f-615aa3b949dc, _Player);
		
		IF
		DB_Sees((CHARACTER)S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, _Player)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		HasActiveStatus(_Player, "TWN_KORRILLATHESPY_ISNEAR", 1)
		THEN
		PROC_GLO_Warlock_TeleportOut();
		PROC_TryStartAD(GLO_KorrillaTheSpy_PAD_KorrillaVanishesReaction_d67b6532-f773-6e07-3a4f-615aa3b949dc, _Player);
		
		IF
		DialogEnded(TWN_KorrillaTheSpy_Korrilla_aab4f3d2-4018-3855-d62d-62dc7cd1fef5, _ID)
		AND
		DB_DialogPlayers(_ID, _Player, _)
		THEN
		PROC_GLO_Warlock_TeleportOut();
		PROC_TryStartAD(GLO_KorrillaTheSpy_PAD_KorrillaVanishesReaction_d67b6532-f773-6e07-3a4f-615aa3b949dc, _Player);
		
	}
	EXIT
	{
	}
}
Goal(470).Title("Act2_TWN_LiftingTheCurse_Finale");
Goal(470)
{
	INIT
	{
		SetOnStage((ITEM)S_TWN_ActExit_4df293a7-c9b7-4be4-b4a9-42400ddbe209, 0);
		
		PROC_TriggerRegisterForPlayers(S_TWN_LeaveAct2DaisyWarningBox_4505f623-2c5d-4eae-ba0b-b86d156ce775);
		DB_DialogBlockTradeButton(GLO_ThrallOfTheAbsolute_LeaveWithoutKethericStone_e89ef423-ba39-2243-4383-dd28eef77c74);
		DB_IgnoreMutingStatussesDialog(GLO_ThrallOfTheAbsolute_LeaveWithoutKethericStone_e89ef423-ba39-2243-4383-dd28eef77c74);
		DB_AddCharactersInTriggerToDialog(GLO_ThrallOfTheAbsolute_AttemptLeaveAct2_0bc75b6b-86a4-dd78-7f2d-160aa6d70f7d, S_TWN_LeaveAct2DaisyWarningBox_4505f623-2c5d-4eae-ba0b-b86d156ce775, 1, 1, 1, 1);
		DB_AddCharactersInTriggerToDialog(GLO_ThrallOfTheAbsolute_LeaveWithoutKethericStone_e89ef423-ba39-2243-4383-dd28eef77c74, S_TWN_LeaveAct2DaisyWarningBox_4505f623-2c5d-4eae-ba0b-b86d156ce775, 1, 1, 1, 1);
		
		DB_TopicalGreeting((FLAG)TG_GLO_LiftingTheCurse_LiftedCurse_ac891d02-3650-4c3d-b180-f83465761882);
		DB_TopicalGreetingEndCondition_FlagSet((FLAG)TG_GLO_LiftingTheCurse_LiftedCurse_ac891d02-3650-4c3d-b180-f83465761882, (FLAG)VISITEDREGION_INT_Main_A_a2e1a618-d211-484e-9389-6b37308b8da1);
	}
	KB
	{
		IF
		TextEvent("finaletest")
		THEN
		SetOnStage((ITEM)S_TWN_ActExit_4df293a7-c9b7-4be4-b4a9-42400ddbe209, 1);
		SetFlag((FLAG)SCE_Epilogue_State_HasStarted_9b4bae0b-6464-4b0e-a0e3-41201c0c3c9e);
		PROC_SCE_StartSetupDebrief();
		PROC_TeleportPartiesTo(S_Debug_TWN_MarchingArmy_e1dd0c36-8d2e-49cb-afb5-84b8fc9a3439,"");
		
		
		IF
		DB_GlobalFlag((FLAG)GLO_LiftingTheCurse_State_BreathHasBeenRestored_2113b54e-a140-4aa0-97ac-219fa7b7d038)
		THEN
		DB_SCE_Debrief_Participant(S_HAV_SpiritOfTheLand_1403cdfd-0660-4592-90c6-bfe4607ccd3a, S_SCE_SpiritPoint_f540bdee-3239-40a7-a9c9-b03200e0bace, HAV_HalsinQuest_Spirit_85232c87-9912-7c37-c068-3196688f88b3);
		
		
		PROC
		PROC_BlockUseOfItem(_Player, S_TWN_ActExit_4df293a7-c9b7-4be4-b4a9-42400ddbe209)
		THEN
		PROC_TWN_Finale_Act2ExitUsed((CHARACTER)_Player);
		
		PROC
		PROC_TWN_Finale_Act2ExitUsed((CHARACTER)_Player)
		AND
		_Player != S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323
		THEN
		PROC_TWN_Finale_StartCheck((CHARACTER)_Player);
		
		PROC //We do not want Halsin in the main speaker slot if the curse has not been lifted.
		PROC_TWN_Finale_Act2ExitUsed((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_LiftingTheCurse_State_BreathHasBeenRestored_2113b54e-a140-4aa0-97ac-219fa7b7d038)
		AND
		NOT QRY_TWN_Finale_CannotFindReplacement()
		AND
		DB_ClosestAvailableCharacterTo_PreferAvatar(_Player, (ITEM)S_TWN_ActExit_4df293a7-c9b7-4be4-b4a9-42400ddbe209, _, 1)
		THEN
		PROC_TWN_Finale_StartCheck((CHARACTER)_Player);
		
		QRY
		QRY_TWN_Finale_CannotFindReplacement()
		AND
		NOT QRY_GetClosestAvailableCharacterTo((ITEM)S_TWN_ActExit_4df293a7-c9b7-4be4-b4a9-42400ddbe209, 0)
		THEN
		PROC_PlayCantUseItemAD((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		DB_CustomUseItemResponse((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, S_TWN_ActExit_4df293a7-c9b7-4be4-b4a9-42400ddbe209, 0);
		
		PROC
		PROC_TWN_Finale_Act2ExitUsed((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		AND
		DB_GlobalFlag((FLAG)GLO_LiftingTheCurse_State_BreathHasBeenRestored_2113b54e-a140-4aa0-97ac-219fa7b7d038)
		THEN
		PROC_TWN_Finale_StartCheck((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		
		PROC
		PROC_TWN_Finale_StartCheck((CHARACTER)_Player)
		AND
		NOT QRY_TWN_Finale_CannotUse((CHARACTER)_Player)
		THEN
		DB_TWN_Finale_InitiatingPlayer(_Player);
		//ReadyCheckGlobal("TWN_Finale_ReadyCheck", "TWN_Finale_DepartureCheck", 1, _Player);
		//Level swap system will take over from here
		
		
		QRY
		QRY_TWN_Finale_CannotUse((CHARACTER)_Player)
		AND
		NOT QRY_SpeakerIsAvailable(_Player)
		THEN
		PROC_PlayCantUseItemAD(_Player);
		DB_CustomUseItemResponse(_Player, S_TWN_ActExit_4df293a7-c9b7-4be4-b4a9-42400ddbe209, 0);
		
		//Moonrise Assault
		QRY
		QRY_TWN_Finale_CannotUse((CHARACTER)_Player)
		AND
		QRY_SpeakerIsAvailable(_Player)
		AND
		DB_GlobalFlag(MOO_Assault_State_InProgress_0f3a8f5d-7402-4220-bebb-d4b21d3db08d)
		THEN
		PROC_TWN_Finale_BlockAct2DaisyDialog(_Player, GLO_ThrallOfTheAbsolute_AttemptLeaveAct2_0bc75b6b-86a4-dd78-7f2d-160aa6d70f7d);
		DB_CustomUseItemResponse(_Player, S_TWN_ActExit_4df293a7-c9b7-4be4-b4a9-42400ddbe209, 0);
		
		//Nightsong dead path
		QRY
		QRY_TWN_Finale_CannotUse((CHARACTER)_Player)
		AND
		QRY_SpeakerIsAvailable(_Player)
		AND
		DB_State_Current(S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6, "MOO", "MOO_State_NightsongDeath")
		AND
		NOT DB_GlobalFlag(SCE_Debrief_State_Setup_0ebc6b35-0f07-4a73-b6b8-9782ecbcaccf)
		THEN
		PROC_TWN_Finale_BlockAct2DaisyDialog(_Player, GLO_ThrallOfTheAbsolute_AttemptLeaveAct2_0bc75b6b-86a4-dd78-7f2d-160aa6d70f7d);
		DB_CustomUseItemResponse(_Player, S_TWN_ActExit_4df293a7-c9b7-4be4-b4a9-42400ddbe209, 0);
		
		//Leaving without Ketheric Stone
		QRY
		QRY_TWN_Finale_CannotUse((CHARACTER)_Player)
		AND
		QRY_SpeakerIsAvailable(_Player)
		AND
		DB_GlobalFlag(GLO_EmperorPrelude_State_KethericStoneCollected_98cc3440-0316-4056-9aeb-d8b6e7c79b64)
		AND
		NOT QRY_GLO_EmperorPrelude_NetherstoneIsInMagicPocketsOrCamp(S_COL_CrownController_Ketheric_06b8891b-e71c-423b-8482-2680c3c16a4d)
		THEN
		PROC_TWN_Finale_BlockAct2DaisyDialog(_Player, GLO_ThrallOfTheAbsolute_LeaveWithoutKethericStone_e89ef423-ba39-2243-4383-dd28eef77c74);
		DB_CustomUseItemResponse(_Player, S_TWN_ActExit_4df293a7-c9b7-4be4-b4a9-42400ddbe209, 0);
		
		PROC
		PROC_TWN_Finale_BlockAct2DaisyDialog((CHARACTER)_Player, (DIALOGRESOURCE)_Dialog)
		AND
		QRY_StartDialogCustom_Fixed(_Dialog, NULL_00000000-0000-0000-0000-000000000000, _Player, 0, 0, 0, 0)
		THEN
		DB_NOOP(1); 
		
		QRY
		QRY_GLO_LevelSwap_CustomTransition((CHARACTER)_Player, "ReadyCheck_ToBGFromSCL", (STRING)_)
		THEN
		PROC_TWN_Finale_ReadyCheck_Passed();
		
		
		//Halsin leaves forever if the curse is not lifted
		IF
		DialogEnded(TWN_Finale_LeavingAct_06d434ac-008b-1994-5dc5-f8fcd681553d, _)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_LiftingTheCurse_State_BreathHasBeenRestored_2113b54e-a140-4aa0-97ac-219fa7b7d038)
		THEN
		PROC_Origins_CompanionLeavePermanently((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, "TWN_StayingInSCL");
		PROC_DisappearOutOfSight(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, "Walk", 0, "SCE_Halsin_LeavesForever");
		
		QRY
		QRY_PartyMembers_BlockLeaveMessage("TWN_StayingInSCL")
		AND
		DB_PermaDefeated(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		THEN
		DB_NOOP(1);
		
		//Halsin joins camp if somehow curse is lifted but you left him behind and never got the option to add him to your party, clears Camp2 dialog for InParty
		IF
		DialogEnded(TWN_Finale_LeavingAct_06d434ac-008b-1994-5dc5-f8fcd681553d, _)
		AND
		DB_GlobalFlag((FLAG)GLO_LiftingTheCurse_State_BreathHasBeenRestored_2113b54e-a140-4aa0-97ac-219fa7b7d038)
		AND
		NOT DB_InCamp(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		AND
		NOT DB_PartyMembers(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		THEN
		PROC_ORI_SetupCamp((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1);
		PROC_GlobalSetFlagAndCache((FLAG)GLO_LiftingTheCurse_State_HalsinRecruitable_2c8b6be0-558d-485c-b4f2-93ec1926a2fa);
		PROC_RemoveAllDialogEntriesForSpeaker(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		DB_Dialogs(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, Halsin_InParty_890c2586-6b71-ca01-5bd6-19d533181c71);
		DB_InCamp(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		
		//Halsin joins camp for the INT forced camp night
		PROC
		PROC_FallbackCamp_OnCampNightQueued(_Flag)
		AND
		DB_CampNight_ForceOnLevelSwap(_Flag, "ReadyCheck_ToBGFromSCL", _, _)
		AND
		DB_GlobalFlag((FLAG)GLO_LiftingTheCurse_State_BreathHasBeenRestored_2113b54e-a140-4aa0-97ac-219fa7b7d038)
		AND
		NOT DB_InCamp(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		AND
		NOT DB_PartyMembers(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		THEN
		PROC_ORI_SetupCamp((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1);
		PROC_GlobalSetFlagAndCache((FLAG)GLO_LiftingTheCurse_State_HalsinRecruitable_2c8b6be0-558d-485c-b4f2-93ec1926a2fa);
		PROC_RemoveAllDialogEntriesForSpeaker(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		DB_Dialogs(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, Halsin_InParty_890c2586-6b71-ca01-5bd6-19d533181c71);
		DB_InCamp(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		
		PROC
		PROC_TWN_Finale_ReadyCheck_Passed()
		AND
		DB_TWN_Finale_InitiatingPlayer(_Player)
		AND
		NOT QRY_StartDialog_Fixed((DIALOGRESOURCE)TWN_Finale_LeavingAct_06d434ac-008b-1994-5dc5-f8fcd681553d, _Player)
		THEN
		NOT DB_OnlyOnce("TWN_Finale_LeavingAct");
		
		PROC
		PROC_TWN_Finale_ReadyCheck_Passed()
		AND
		DB_SCE_Debrief_BackOnStage(_NPC)
		AND
		NOT DB_PermaDefeated(_NPC)
		AND
		IsOnStage(_NPC, 0)
		THEN
		SetOnStage(_NPC, 1);
		
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)TWN_Finale_LeavingAct_06d434ac-008b-1994-5dc5-f8fcd681553d, (INTEGER)_ID)
		AND
		DB_Players(_Player)
		AND
		NOT DB_TWN_Finale_InitiatingPlayer(_Player)
		THEN
		PROC_DialogAddListeningActor(_ID, _Player);
		
		IF
		DialogStarted((DIALOGRESOURCE)TWN_Finale_LeavingAct_06d434ac-008b-1994-5dc5-f8fcd681553d, _InstanceID)
		THEN
		DialogSetTeleportPartyOnEnded(_InstanceID, (TRIGGER)S_INT_ActTeleport_c9aa7107-72d5-46d4-893d-32fe41506bf0);
		
		//REGION Origins can't leave act 2 without covering some topic.
		
		QRY
		QRY_TWN_Finale_CannotUse((CHARACTER)_Player)
		AND
		NOT DB_CustomUseItemResponse(_Player, S_TWN_ActExit_4df293a7-c9b7-4be4-b4a9-42400ddbe209, _)
		AND
		QRY_SCL_PartyMemberShadowcursed()
		THEN
		DB_CustomUseItemResponse(_Player, S_TWN_ActExit_4df293a7-c9b7-4be4-b4a9-42400ddbe209, 0);
		
		QRY
		QRY_SCL_PartyMemberShadowcursed()
		AND
		DB_PartyMembers(_Character)
		AND
		DB_CustomDefeatedState(_Character, "SCL_Shadowcurse")
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_TWN_Finale_CannotUse((CHARACTER)_Player)
		AND
		NOT DB_CustomUseItemResponse(_Player, S_TWN_ActExit_4df293a7-c9b7-4be4-b4a9-42400ddbe209, _)
		AND
		QRY_TWN_Finale_CompanionHasUnfinishedBusiness_Internal()
		THEN
		DB_TWN_Finale_CompanionHasUnfinishedBusiness_LevelSwapData(_Player);
		DB_CustomUseItemResponse(_Player, S_TWN_ActExit_4df293a7-c9b7-4be4-b4a9-42400ddbe209, 0);
		
		QRY
		QRY_TWN_Finale_CompanionHasUnfinishedBusiness_Internal()
		AND
		QRY_TWN_Finale_CompanionHasUnfinishedBusiness()
		AND
		DB_TWN_Finale_InitiatingPlayer(_Player)
		THEN
		ReadyCheckGlobal("TWN_Finale_CompanionReadyCheck", "TWN_Finale_CompanionReadyCheck", 1, _Player);
		
		IF
		ReadyCheckPassed("TWN_Finale_CompanionReadyCheck")
		AND
		DB_TWN_Finale_CompanionHasUnfinishedBusiness_LevelSwapData((CHARACTER)_Player)
		THEN
		PROC_GLO_LevelSwapCheckPartyAvailableAndProceed("ReadyCheck_ToBGFromSCL",_Player);
		NOT DB_TWN_Finale_CompanionHasUnfinishedBusiness_LevelSwapData(_Player);
		
		IF
		ReadyCheckFailed("TWN_Finale_CompanionReadyCheck")
		AND
		DB_TWN_Finale_CompanionHasUnfinishedBusiness_LevelSwapData((CHARACTER)_Player)
		THEN
		NOT DB_TWN_Finale_CompanionHasUnfinishedBusiness_LevelSwapData(_Player);
		
		//Overload for specific characters
		QRY
		QRY_TWN_Finale_CompanionHasUnfinishedBusiness()
		AND
		1 == 0
		THEN
		DB_NOOP(1);
		
		
		//END_REGION
		
		//REGION Halsin Inclusion
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)TWN_Finale_LeavingAct_06d434ac-008b-1994-5dc5-f8fcd681553d, (INTEGER)_ID)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_LiftingTheCurse_State_BreathHasBeenRestored_2113b54e-a140-4aa0-97ac-219fa7b7d038)
		AND
		NOT DB_PermaDefeated(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		AND
		NOT QRY_TWN_Finale_HalsinNotPresent()
		THEN
		PROC_DialogAddSpeakingActor(_ID, S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		
		QRY
		QRY_TWN_Finale_HalsinNotPresent()
		AND
		QRY_State_IsBeforeState((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, "SCL_LiftingTheCurse", "SCL_LiftingTheCurse_State_HalsinInAct2")
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_TWN_Finale_HalsinNotPresent()
		AND 
		DB_State_Current(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, "SCL_LiftingTheCurse", "SCL_LiftingTheCurse_State_HalsinInShadowFell")
		THEN
		DB_NOOP(1);
		//END_REGION
		
		//REGION Lifting The Curse TG
		
		//TG - 76 - Lifted the Curse
		IF
		DB_GlobalFlag((FLAG)GLO_LiftingTheCurse_State_BreathHasBeenRestored_2113b54e-a140-4aa0-97ac-219fa7b7d038)
		AND
		DB_GlobalFlag((FLAG)SCE_Epilogue_State_HasStarted_9b4bae0b-6464-4b0e-a0e3-41201c0c3c9e)
		AND
		QRY_OnlyOnce("TG_GLO_LiftingTheCurse_Lifted")
		AND
		DB_Avatars(_Avatar)
		THEN
		SetFlag((FLAG)TG_GLO_LiftingTheCurse_LiftedCurse_ac891d02-3650-4c3d-b180-f83465761882, _Avatar);
		
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(471).Title("Act2_TWN_MarchingArmy");
Goal(471)
{
	INIT
	{
		DB_OneShot_VoiceBarkTrigger((TRIGGER)S_TWN_MarchingArmy_VistaTrigger_001_cf53f301-bfc5-4d22-a937-6cf8aea0c4bc, TWN_MarchingArmy_VB_Warning_5bb3c3da-9df8-bed8-89c3-c4356441cce0, "PerUserAndNearbyPlayers");
		DB_OneShot_VoiceBarkTrigger((TRIGGER)S_TWN_MarchingArmy_VistaTrigger_002_2c10b3b5-2cf4-4511-916b-099ba981eb6a, TWN_MarchingArmy_VB_Warning_5bb3c3da-9df8-bed8-89c3-c4356441cce0, "PerUserAndNearbyPlayers");
		
