	KB
	{
		//REGION GENERAL LOGIC
		IF
		FlagSet((FLAG)_IPRDFlag, (CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _)
		AND
		DB_ORI_Karlach_InPartyOMFlags(_IPRDFlag, _BranchGlobalFlag)
		THEN
		SetFlag(_BranchGlobalFlag, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		TagSet((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, BLOCK_RESURRECTION_22a75dbb-1588-407e-b559-5aa4e6d4e6a6)
		THEN
		DB_DeadStateFlag(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c,(FLAG)GLO_Karlach_State_Dead_26f3c3b0-a9c8-40d6-8950-67c9b8e134e2);
		DB_GLO_CharacterCorpseDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)PLA_KarlachRecruitment_Dead_Karlach_fad65f7a-c6bd-d258-b53d-2da039e7e4c9);
		
		IF
		TagCleared((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, BLOCK_RESURRECTION_22a75dbb-1588-407e-b559-5aa4e6d4e6a6)
		THEN
		NOT DB_GLO_CharacterCorpseDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)PLA_KarlachRecruitment_Dead_Karlach_fad65f7a-c6bd-d258-b53d-2da039e7e4c9);
		
		IF
		DB_PartOfTheTeam((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		NOT DB_DeadStateFlag(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (FLAG)GLO_Karlach_State_Dead_26f3c3b0-a9c8-40d6-8950-67c9b8e134e2);
		NOT DB_GLO_CharacterCorpseDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)PLA_KarlachRecruitment_Dead_Karlach_fad65f7a-c6bd-d258-b53d-2da039e7e4c9);
		
		// Rage statuses
		IF
		StatusApplied(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _Status, _, _)
		AND
		IsStatusFromGroup(_Status, "SG_Rage", 1)
		AND
		HasAppliedStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_RAGE_FLAMES", 0)
		THEN
		ApplyStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_RAGE_FLAMES", -1.0, 1);
		
		IF
		StatusRemoved(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _Status, _, _)
		AND
		IsStatusFromGroup(_Status, "SG_Rage", 1)
		AND
		HasAppliedStatusWithGroup(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "SG_Rage", 0)
		THEN
		RemoveStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_RAGE_FLAMES");
		
		IF
		DialogEnded((DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, _ID)
		AND
		DB_DialogPlayers(_ID, _Player, _)
		THEN
		ClearFlag((FLAG)ORI_Karlach_State_ReturnToDefaultBranch_938d12db-730b-52f2-2b51-6c276f848057, _Player);
		
		PROC
		PROC_DialogFlagSetup((DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _Player)
		AND
		NOT DB_ORI_Karlach_ReopenedTadpoleBranchForPlayer(_Player)
		AND
		GetFlag((FLAG)ORI_Karlach_State_BlockTadpoleBranch_e1b99918-f6c4-347a-a2f8-de85a9a44f0f, _Player, 1)
		AND
		GetFlag((FLAG)GLO_Tadpole_Event_FirstConsumed_fab5ae97-23b5-4bf2-88ae-0b1bd57523d8, _Player, 1)
		THEN
		DB_ORI_Karlach_ReopenedTadpoleBranchForPlayer(_Player);
		ClearFlag(ORI_Karlach_State_BlockTadpoleBranch_e1b99918-f6c4-347a-a2f8-de85a9a44f0f, _Player);
		//END_REGION
		
		//REGION Paladins of Tyr: leaving act 1 and not finishing it.
		IF
		LevelGameplayStarted("SCL_Main_A", _)
		AND
		DB_GlobalFlag((FLAG)ORI_Karlach_State_PromisedToDealWithPaladins_41e9f88c-0f3e-427a-911f-5df379642fe4)
		AND
		NOT DB_GlobalFlag((FLAG)PLA_KarlachRecruitmentTollhouse_State_PaladinsPermaDefeated_d78dbc95-8d8e-4b3a-b618-ccfb48c31375)
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		PROC_Origins_ForceLowApprovalLeavingDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		
		IF
		LevelGameplayStarted("CRE_Main_A", _)
		AND
		DB_GlobalFlag((FLAG)ORI_Karlach_State_PromisedToDealWithPaladins_41e9f88c-0f3e-427a-911f-5df379642fe4)
		AND
		NOT DB_GlobalFlag((FLAG)PLA_KarlachRecruitmentTollhouse_State_PaladinsPermaDefeated_d78dbc95-8d8e-4b3a-b618-ccfb48c31375)
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		PROC_Origins_ForceLowApprovalLeavingDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		
		//END_REGION
		
		//REGION Betraying the tieflings
		PROC
		PROC_DEN_AttackOnDen_BetrayTieflings()
		THEN
		PROC_Origins_ForceLowApprovalLeavingDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		//END_REGION
		
		//REGION Soul Coin Discovery
		// We can't use magic pockets flags because we want to check for every time players get a soul coin or she joins the party
		IF
		TemplateAddedTo((ROOT)LOOT_SoulCoin_8c68e68d-96d4-45d6-804c-5f31ac948ff3, _SoulCoin, (CHARACTER)_Player, _)
		AND
		NOT DB_OnlyOnce("ORI_Karlach_FoundSoulCoin")
		AND
		DB_GlobalFlag((FLAG)ORI_Karlach_Knows_InfernalEngineExists_9b6d609a-2081-b5de-7dd6-12c425a8bc17)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Karlach_Event_ReachedOverdrive_8c308560-7a87-49f5-ae52-143b48dd963b)
		AND
		DB_Players(_Player)
		AND
		DB_Players((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		IsInMagicPockets(_SoulCoin, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 1)
		AND
		QRY_OnlyOnce("ORI_Karlach_FoundSoulCoin")
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_SoulCoin_c5905063-6ab2-4491-b8df-360d0e7db346, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 0);
		
		PROC
		PROC_GLO_PartyMembers_AddHook((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _Avatar)
		AND
		NOT DB_OnlyOnce("ORI_Karlach_FoundSoulCoin")
		AND
		DB_GlobalFlag((FLAG)ORI_Karlach_Knows_InfernalEngineExists_9b6d609a-2081-b5de-7dd6-12c425a8bc17)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Karlach_Event_ReachedOverdrive_8c308560-7a87-49f5-ae52-143b48dd963b)
		AND
		TemplateGetCountInMagicPockets((ITEMROOT)LOOT_SoulCoin_8c68e68d-96d4-45d6-804c-5f31ac948ff3, _Avatar, _Count)
		AND
		_Count > 0
		AND
		QRY_OnlyOnce("ORI_Karlach_FoundSoulCoin")
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)Karlach_InParty_12459660-b66e-9b0b-9963-670e0993543d, (FLAG)ORI_Karlach_IPRD_SoulCoin_c5905063-6ab2-4491-b8df-360d0e7db346, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 0);
		
		IF
		FlagSet(ORI_Karlach_State_HasSoulCoin_9e5fb882-7511-401d-befa-f40261dc56de, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _)
		AND
		DB_Avatars((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		QRY_OnlyOnce("ORI_Karlach_FoundSoulCoin")
		THEN
		DB_ORI_SoulCoinDiscovery_StartSoulCoinDialog(1);
		
		IF
		DB_ORI_SoulCoinDiscovery_StartSoulCoinDialog(1)
		AND
		NOT DB_CantTalk(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		QRY_StartDialog_Fixed(ORI_Karlach_FoundSoulCoin_b413b479-39e8-d999-ebda-ebd106af9641, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		NOT DB_ORI_SoulCoinDiscovery_StartSoulCoinDialog(1);
		//END_REGION Soul Coin Discovery
		
		//REGION Cooling down for you
		// Already had a status after speaking with Karlach
		IF
		DB_GlobalFlag(ORI_Karlach_State_HelpingAboutBurningOthers_96189a7e-1c8d-c908-adb9-bc8e8ce4b1a7)
		AND
		NOT DB_ORI_CoolingDownForYou_PlayerWithResistance(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		QRY_ORI_CoolingDownForYou_HasValidResistanceStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		PROC_ORI_CoolingDownForYou_Dialog(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		
		IF
		DB_GlobalFlag(ORI_Karlach_State_HelpingAboutBurningOthers_96189a7e-1c8d-c908-adb9-bc8e8ce4b1a7)
		AND
		DB_ORI_Partnered(_Player, (CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		NOT DB_ORI_CoolingDownForYou_PlayerWithResistance(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		QRY_ORI_CoolingDownForYou_HasValidResistanceStatus(_Player)
		THEN
		PROC_ORI_CoolingDownForYou_Dialog(_Player);
		
		// Check when applying statuses
		IF
		StatusApplied(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _Status, _, _)
		AND
		DB_GlobalFlag(ORI_Karlach_State_HelpingAboutBurningOthers_96189a7e-1c8d-c908-adb9-bc8e8ce4b1a7)
		AND
		NOT DB_ORI_CoolingDownForYou_PlayerWithResistance(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		QRY_ORI_CoolingDownForYou_HasValidResistanceStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		PROC_ORI_CoolingDownForYou_Dialog(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		
		IF
		StatusApplied((CHARACTER)_Player, _Status, _, _)
		AND
		DB_GlobalFlag(ORI_Karlach_State_HelpingAboutBurningOthers_96189a7e-1c8d-c908-adb9-bc8e8ce4b1a7)
		AND
		QRY_ORI_GetPartnerOrDatingAvatar((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		DB_QRYRTN_ORI_PartnerOrDatingAvatar(_Player, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		NOT DB_ORI_CoolingDownForYou_PlayerWithResistance(_Player)
		AND
		QRY_ORI_CoolingDownForYou_HasValidResistanceStatus(_Player)
		THEN
		PROC_ORI_CoolingDownForYou_Dialog(_Player);
		
		IF
		AttackedBy(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _, _, "Cold", _, _, _)
		AND
		DB_GlobalFlag(ORI_Karlach_State_HelpingAboutBurningOthers_96189a7e-1c8d-c908-adb9-bc8e8ce4b1a7)
		THEN
		PROC_ORI_CoolingDownForYou_Dialog(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		
		// Check statuses valid for both Karlach and the avatar
		QRY
		QRY_ORI_CoolingDownForYou_HasValidResistanceStatus((CHARACTER)_Player)
		AND
		DB_ORI_CoolingDownForYou_ValidStatuses(_Status, 0)
		AND
		HasAppliedStatus(_Player, _Status, 1)
		THEN
		DB_NOOP(1);
		
		// Check statuses valid for only the avatar
		QRY
		QRY_ORI_CoolingDownForYou_HasValidResistanceStatus((CHARACTER)_Player)
		AND
		_Player != S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c
		AND
		DB_ORI_CoolingDownForYou_ValidStatuses(_Status, 1)
		AND
		HasAppliedStatus(_Player, _Status, 1)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_ORI_CoolingDownForYou_Dialog((CHARACTER)_Player)
		THEN
		DB_ORI_CoolingDownForYou_PlayerWithResistance(_Player);
		PROC_GlobalClearFlagAndCache(ORI_Karlach_State_WaitingForSolution_e1bf36eb-9538-d684-442e-162807e37456);
		DB_ORI_CoolingDownForYou_StartDialog(_Player);
		
		IF
		DB_ORI_CoolingDownForYou_StartDialog(_Player)
		AND
		NOT DB_CantTalk(_Player)
		THEN
		NOT DB_ORI_CoolingDownForYou_StartDialog(_Player);
		PROC_ORI_CoolingDownForYou_Dialog_Internal((CHARACTER)_Player);
		
		PROC
		PROC_ORI_CoolingDownForYou_Dialog_Internal((CHARACTER)_Player)
		AND
		_Player != S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c
		AND
		QRY_ORI_GetPartnerOrDatingAvatar(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		DB_QRYRTN_ORI_PartnerOrDatingAvatar((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _Player)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(_Player, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		QRY_StartDialog_Fixed(CAMP_Karlach_ROM_CoolingDownForYou_6df8c8ce-b7e7-33ea-8f52-9fedb1a79f3f, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _Player)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_ORI_CoolingDownForYou_Dialog_Internal((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		QRY_ORI_GetPartnerOrDatingAvatar(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		DB_QRYRTN_ORI_PartnerOrDatingAvatar((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _Player)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(_Player, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		QRY_StartDialog_Fixed(CAMP_Karlach_ROM_CoolingDownForYou_6df8c8ce-b7e7-33ea-8f52-9fedb1a79f3f, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _Player)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_SelectCustomDialog_AfterGenerics(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _Player)
		AND
		DB_GlobalFlag(ORI_Karlach_State_HelpingAboutBurningOthers_96189a7e-1c8d-c908-adb9-bc8e8ce4b1a7)
		AND
		QRY_ORI_GetPartnerOrDatingAvatar(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		DB_QRYRTN_ORI_PartnerOrDatingAvatar((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (CHARACTER)_Player)
		THEN
		DB_SelectedDialog(CAMP_Karlach_ROM_CoolingDownForYou_6df8c8ce-b7e7-33ea-8f52-9fedb1a79f3f, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, _Player);
		
		PROC
		PROC_DialogStarted((DIALOGRESOURCE)CAMP_Karlach_ROM_CoolingDownForYou_6df8c8ce-b7e7-33ea-8f52-9fedb1a79f3f, _)
		THEN
		SetFlag((FLAG)ORI_Karlach_State_BlockCoolingDownForYou_9347aa1b-94f9-92b0-a9ea-8916b9af7d52, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		StatusRemoved((CHARACTER)_Player, _Status, _, _)
		AND
		DB_ORI_CoolingDownForYou_PlayerWithResistance(_Player)
		AND
		NOT QRY_ORI_CoolingDownForYou_HasValidResistanceStatus(_Player)
		THEN
		PROC_ORI_CoolingDownForYou_RemoveResistance(_Player);
		
		PROC
		PROC_ORI_CoolingDownForYou_RemoveResistance((CHARACTER)_Player)
		THEN
		NOT DB_ORI_CoolingDownForYou_PlayerWithResistance(_Player);
		
		PROC
		PROC_ORI_CoolingDownForYou_RemoveResistance((CHARACTER)_Player)
		AND
		NOT DB_ORI_CoolingDownForYou_PlayerWithResistance(_Player)
		THEN
		NOT DB_ORI_CoolingDownForYou_StartDialog(_Player);
		
		PROC
		PROC_ORI_CoolingDownForYou_RemoveResistance((CHARACTER)_Player)
		AND
		NOT DB_ORI_CoolingDownForYou_PlayerWithResistance(_)
		THEN
		PROC_GlobalSetFlagAndCache(ORI_Karlach_State_WaitingForSolution_e1bf36eb-9538-d684-442e-162807e37456);
		
		// Clear scene if Karlach leaves the camp or after a long rest.
		PROC
		PROC_Camp_EveryoneWakeupEndHook()
		AND
		DB_GlobalFlag(ORI_Karlach_State_HelpingAboutBurningOthers_96189a7e-1c8d-c908-adb9-bc8e8ce4b1a7)
		THEN
		PROC_ORI_CoolingDownForYou_Clear();
		
		PROC
		PROC_Camp_Leave((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		DB_GlobalFlag(ORI_Karlach_State_HelpingAboutBurningOthers_96189a7e-1c8d-c908-adb9-bc8e8ce4b1a7)
		THEN
		PROC_ORI_CoolingDownForYou_Clear();
		
		PROC
		PROC_ORI_CoolingDownForYou_Clear()
		AND
		DB_ORI_CoolingDownForYou_PlayerWithResistance(_Player)
		THEN
		PROC_ORI_CoolingDownForYou_RemoveResistance((CHARACTER)_Player);
		
		PROC
		PROC_ORI_CoolingDownForYou_Clear()
		THEN
		ClearFlag(ORI_Karlach_State_HelpingAboutBurningOthers_96189a7e-1c8d-c908-adb9-bc8e8ce4b1a7, NULL_00000000-0000-0000-0000-000000000000);
		
		//END_REGION Cooling down for you
		
		//REGION Burning state
		IF
		FlagSet(ORI_Karlach_Event_SetHighLevelBurningState_a4f81325-2eb2-4606-8066-773cc782b9dc, _, _)
		THEN
		ClearFlag(ORI_Karlach_Event_SetHighLevelBurningState_a4f81325-2eb2-4606-8066-773cc782b9dc, NULL_00000000-0000-0000-0000-000000000000);
		RemoveStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_BURNING_LOWLEVEL_VFX", S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		ApplyStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_BURNING_HIGHLEVEL_VFX", 60.0, 1, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		
		IF
		FlagSet(ORI_Karlach_Event_SetLowLevelBurningState_e693ee79-85af-4940-8ab4-8a9a10a8635f, _, _)
		THEN
		ClearFlag(ORI_Karlach_Event_SetLowLevelBurningState_e693ee79-85af-4940-8ab4-8a9a10a8635f, NULL_00000000-0000-0000-0000-000000000000);
		RemoveStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_BURNING_HIGHLEVEL_VFX", S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		ApplyStatus(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_BURNING_LOWLEVEL_VFX", 60.0, 1, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		
		IF
		StatusApplied(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "ORI_KARLACH_BURNING_HIGHLEVEL_VFX", _, _)
		AND
