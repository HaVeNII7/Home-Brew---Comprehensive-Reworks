	KB
	{
		//REGION State Transition
		IF
		DB_SHA_LastJusticiar_Rats(_Rat)
		THEN
		DB_SHA_LastJusticiar_RatsAlive(_Rat);
		DB_Dialogs(_Rat, (DIALOGRESOURCE)SHA_LastJusticiar_RatsCalm_10a5c4e9-71ac-1b3d-fe89-a92f0fabfc24);
		
		IF
		DB_SHA_LastJusticiar_UltimatumRats(_Rat,_)
		THEN
		SetOnStage(_Rat, 0);
		
		IF
		DB_PermaDefeated(_Rat)
		AND
		DB_SHA_LastJusticiar_RatsAlive((CHARACTER)_Rat,(INTEGER)_Int)
		THEN
		NOT DB_SHA_LastJusticiar_RatsAlive(_Rat,_Int);
		
		IF
		DB_PermaDefeated(_Rat)
		AND
		DB_SHA_LastJusticiar_Rats((CHARACTER)_Rat)
		THEN
		PROC_Foop(_Rat);
		PROC_SHA_LastJusticiar_RatDeath();
		
		IF
		DB_PermaDefeated(S_SHA_LastJusticiar_594ba359-ce55-4b54-9efc-94eca306c540)
		THEN
		PROC_State_Progress(S_SHA_LastJusticiar_594ba359-ce55-4b54-9efc-94eca306c540, "SHA_LastJusticiar", "SHA_LastJusticiar_State_JusticiarKilled");
		
		IF
		DialogEnded((DIALOGRESOURCE)SHA_LastJusticiar_RatsUltimatum_c2d6a196-c24e-fa56-d420-9d49a6f31192, _)
		THEN
		PROC_State_Progress(S_SHA_LastJusticiar_594ba359-ce55-4b54-9efc-94eca306c540, "SHA_LastJusticiar", "SHA_LastJusticiar_State_RatsHostile");
		
		PROC
		PROC_GLO_DefeatCounter_AllPermaDefeated("SHA_LastJusticiar_DefeatCounter_UltimatumRats")
		THEN
		PROC_State_Progress(S_SHA_LastJusticiar_594ba359-ce55-4b54-9efc-94eca306c540, "SHA_LastJusticiar", "SHA_LastJusticiar_State_JusticiarAppeared");
		
		PROC
		PROC_SHA_LastJusticiar_RatDeath()
		THEN
		PROC_State_IfCurrentProgress(S_SHA_LastJusticiar_594ba359-ce55-4b54-9efc-94eca306c540, "SHA_LastJusticiar", "SHA_LastJusticiar_State_RatsNegotiation", "SHA_LastJusticiar_State_RatsUltimatum");
		
		PROC
		PROC_SHA_LastJusticiar_RatDeath()
		THEN
		PROC_State_IfCurrentProgress(S_SHA_LastJusticiar_594ba359-ce55-4b54-9efc-94eca306c540, "SHA_LastJusticiar", "SHA_LastJusticiar_State_RatsPanicked", "SHA_LastJusticiar_State_RatsNegotiation");
		
		PROC
		PROC_SHA_LastJusticiar_RatDeath()
		THEN
		PROC_State_IfCurrentProgress(S_SHA_LastJusticiar_594ba359-ce55-4b54-9efc-94eca306c540, "SHA_LastJusticiar", "SHA_LastJusticiar_State_RatsCalm", "SHA_LastJusticiar_State_RatsPanicked");
		//END_REGION
		
		//REGION Rat Panic
		IF
		DB_GlobalFlag((FLAG)SHA_LastJusticiar_State_RatsPanicked_f9d36246-2278-4905-bea1-1452a30cdce7)
		AND
		DB_SHA_LastJusticiar_RatsAlive(_Rat)
		THEN
		PROC_RemoveDialog(_Rat);
		DB_Dialogs(_Rat, (DIALOGRESOURCE)SHA_LastJusticiar_RatsPanicked_f5e8d130-fa60-7fbe-906e-27309b0b180d);
		//END_REGION
		
		//REGION Rat Negotiation
		IF
		DB_GlobalFlag((FLAG)SHA_LastJusticiar_State_RatsNegotiation_ae2cc45a-dd79-452c-ad7e-311d867b151d)
		AND
		DB_SHA_LastJusticiar_NegotiationAreas(_NegotiationArea)
		THEN
		PROC_TriggerRegisterForPlayers(_NegotiationArea);
		
		IF
		DB_GlobalFlag((FLAG)SHA_LastJusticiar_State_RatsNegotiation_ae2cc45a-dd79-452c-ad7e-311d867b151d)
		AND
		DB_SHA_LastJusticiar_RatsAlive(_Rat)
		THEN
		PROC_RemoveDialog(_Rat);
		
		IF
		DB_GlobalFlag((FLAG)SHA_LastJusticiar_State_RatsNegotiation_ae2cc45a-dd79-452c-ad7e-311d867b151d)
		THEN
		PROC_RemoveDialog(S_SHA_LastJusticiar_Rat_Diplorat_ab07a441-2d97-493a-b516-7a4094877303);
		DB_Dialogs(S_SHA_LastJusticiar_Rat_Diplorat_ab07a441-2d97-493a-b516-7a4094877303, (DIALOGRESOURCE)SHA_LastJusticiar_RatsNegotiate_592f63db-b2b3-9383-9160-1643321f02ce);
		
		IF
		DB_InRegion(_Player, _NegotiationArea)
		AND
		DB_Players(_Player)
		AND
		DB_SHA_LastJusticiar_NegotiationAreas(_NegotiationArea)
		AND
		NOT DB_OnlyOnce("SHA_LastJusticiar_DiploratSuccessfullyAppeared")
		AND
		IsInCombat(_Player, 0)
		AND
		GetPosition(_Player, _PlayerX, _PlayerY, _PlayerZ)
		AND
		FindValidPosition(_PlayerX, _PlayerY, _PlayerZ, 12.0, (CHARACTER)S_SHA_LastJusticiar_Rat_Diplorat_ab07a441-2d97-493a-b516-7a4094877303, 1, _RatX, _RatY, _RatZ)
		AND
		QRY_OnlyOnce("SHA_LastJusticiar_DiploratSuccessfullyAppeared")
		THEN
		AppearAtPosition((CHARACTER)S_SHA_LastJusticiar_Rat_Diplorat_ab07a441-2d97-493a-b516-7a4094877303, _RatX, _RatY, _RatZ, 1, NULL_00000000-0000-0000-0000-000000000000, "SHA_LastJusticiar_DiploratAppeared", 0);
		
		IF
		DB_GlobalFlag((FLAG)SHA_LastJusticiar_State_RatsNegotiation_ae2cc45a-dd79-452c-ad7e-311d867b151d)
		THEN
		PROC_SHA_LastJusticiar_RatRetreat();
		
		IF
		EntityEvent(_Rat, "SHA_LastJusticiar_DiploratAppeared")
		THEN
		ObjectTimerLaunch(_Rat, "SHA_LastJusticiar_StartSpottingBufferTimer", 1500);
		
		IF
		ObjectTimerFinished(_Rat, "SHA_LastJusticiar_StartSpottingBufferTimer")
		THEN
		DB_SpotPlayers((CHARACTER)_Rat, "SHA_LastJusticiar_DiploratSpotting", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		
		PROC
		PROC_SpotPlayers_Spotted(_Rat, "SHA_LastJusticiar_DiploratSpotting", _Player)
		AND
		QRY_StartDialog((DIALOGRESOURCE)SHA_LastJusticiar_RatsNegotiate_592f63db-b2b3-9383-9160-1643321f02ce, _Rat, _Player)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)SHA_LastJusticiar_State_PlayerTruce_1d54b03b-926a-c36d-7480-e29659f6c506)
		THEN
		PROC_DisappearOutOfSight((CHARACTER)S_SHA_LastJusticiar_Rat_Diplorat_ab07a441-2d97-493a-b516-7a4094877303, "Run", 0, "SHA_LastJusticiar_DiploratLeft");
		
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)SHA_LastJusticiar_State_SharedTreasure_bbd04557-5cae-4802-aa7e-9cb86af7b698, (DIALOGRESOURCE)SHA_LastJusticiar_RatsNegotiate_592f63db-b2b3-9383-9160-1643321f02ce, _ID)
		AND
		DB_DialogPlayers(_ID, _Player, _)
		THEN
		PROC_TriggerRegisterForPlayers((TRIGGER)S_SHA_LastJusticiar_StashBox_3f27273c-51f0-4116-8f80-ccd04e0eea44);
		PROC_ShowMarker((CHARACTER)_Player, "SHA_LastJusticiarStash");
		
		IF
		EnteredTrigger(_Player, (TRIGGER)S_SHA_LastJusticiar_StashBox_3f27273c-51f0-4116-8f80-ccd04e0eea44)
		THEN
		PROC_TriggerUnregisterForPlayers((TRIGGER)S_SHA_LastJusticiar_StashBox_3f27273c-51f0-4116-8f80-ccd04e0eea44);
		SetEntityEvent((ITEM)S_SHA_SecretCompartment_Helper_36a78fb7-0b75-4e79-897f-cd289dedd504, "SHA_Secret_RevealCompartment");
		PROC_HideMarker((CHARACTER)_Player, "SHA_LastJusticiarStash");
		
		PROC
		PROC_SHA_LastJusticiar_RatRetreat()
		AND
		DB_SHA_LastJusticiar_RatsAlive(_Rat)
		THEN
		PROC_ForceStopDialog(_Rat);
		PROC_DisappearOutOfSight((CHARACTER)_Rat, "Run", 1, "SHA_LastJusticiar_RatRetreat");
		
		IF // Normal flow + Player has access to killcombat
		DB_Is_InCombat(S_SHA_LastJusticiar_Rat_Diplorat_ab07a441-2d97-493a-b516-7a4094877303, _ID)
		AND
		NOT DB_GlobalFlag((FLAG)SHA_LastJusticiar_State_Hostile_ed6bc07d-6041-49c3-9fc5-bc604bc8543b)
		AND
		DB_InRegion((CHARACTER)_Char, (TRIGGER)S_SHA_LastJusticiar_NegotiationArea_002_7ec4ae2a-d61b-441e-bc8e-a9e437a2b468)
		AND
		DB_Is_InCombat(_Char, _ID)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)SHA_LastJusticiar_State_Hostile_ed6bc07d-6041-49c3-9fc5-bc604bc8543b);
		
		IF //In case the player one shot kills the diplorat
		AttackedBy(S_SHA_LastJusticiar_Rat_Diplorat_ab07a441-2d97-493a-b516-7a4094877303, _, _Char, _, _, _, _)
		AND
		NOT DB_GlobalFlag((FLAG)SHA_LastJusticiar_State_Hostile_ed6bc07d-6041-49c3-9fc5-bc604bc8543b)
		AND
		DB_InRegion((CHARACTER)_Char, (TRIGGER)S_SHA_LastJusticiar_NegotiationArea_002_7ec4ae2a-d61b-441e-bc8e-a9e437a2b468)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)SHA_LastJusticiar_State_Hostile_ed6bc07d-6041-49c3-9fc5-bc604bc8543b);
		
		//END_REGION
		
		//REGION Rat Ultimatum
		IF
		DB_GlobalFlag((FLAG)SHA_LastJusticiar_State_Hostile_ed6bc07d-6041-49c3-9fc5-bc604bc8543b)
		AND
		IsForceUpdate(S_SHA_LastJusticiar_UltimatumLure_4700da81-8c8e-455f-9158-dc2b6c204f29, 1)
		THEN
		SetForceUpdate(S_SHA_LastJusticiar_UltimatumLure_4700da81-8c8e-455f-9158-dc2b6c204f29, 0);
		
		IF
		DB_GlobalFlag((FLAG)SHA_LastJusticiar_State_Hostile_ed6bc07d-6041-49c3-9fc5-bc604bc8543b)
		THEN
		SetOnStage(S_SHA_LastJusticiar_UltimatumLure_4700da81-8c8e-455f-9158-dc2b6c204f29, 0);
		
		IF
		AttackedBy(_Rat, _Player, _, _, _, _, _)
		AND
		NOT DB_GlobalFlag((FLAG)SHA_LastJusticiar_State_Hostile_ed6bc07d-6041-49c3-9fc5-bc604bc8543b)
		AND
		DB_SHA_LastJusticiar_UltimatumRats((CHARACTER)_Rat, _)
		AND
		IsEnemy((CHARACTER)_Rat, (CHARACTER)_Player, 0)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)SHA_LastJusticiar_State_Hostile_ed6bc07d-6041-49c3-9fc5-bc604bc8543b);
		
		IF
		DB_GlobalFlag((FLAG)SHA_LastJusticiar_State_Ultimatum_05b19df2-2521-4fca-a540-41103a267d32)
		THEN
		PROC_TriggerRegisterForPlayers((TRIGGER)S_SHA_LastJusticiar_UltimatumDialogTrigger_2da51c13-8e94-4da2-aef0-9a0802d7b335);
		PROC_TriggerRegisterForParty((TRIGGER)S_SHA_LastJusticiation_UltimatumLureArea_56305d1e-25cf-443e-8299-00d7ed144d04);
		PROC_SHA_LastJusticiar_CheckWaveThreshold();
		SetOnStage(S_SHA_LastJusticiar_UltimatumLure_4700da81-8c8e-455f-9158-dc2b6c204f29, 1);
		
		IF
		DB_GlobalFlag((FLAG)SHA_LastJusticiar_State_Ultimatum_05b19df2-2521-4fca-a540-41103a267d32)
		AND
		DB_SHA_LastJusticiar_RatsAlive(_Rat)
		THEN
		PROC_RemoveDialog(_Rat);
		
		IF
		DB_GlobalFlag((FLAG)SHA_LastJusticiar_State_Hostile_ed6bc07d-6041-49c3-9fc5-bc604bc8543b)
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT2_SHA_LastJusticiar_Rats_66080136-112f-4c7d-8b63-0863c87743f3, 0);
		
		IF
		DB_SHA_LastJusticiar_UltimatumRats(_Rat, _)
		THEN
		DB_GLO_DefeatCounter(_Rat, "SHA_LastJusticiar_DefeatCounter_UltimatumRats");
		
		IF
		DB_InRegion(_Player, (TRIGGER)S_SHA_LastJusticiar_UltimatumDialogTrigger_2da51c13-8e94-4da2-aef0-9a0802d7b335)
		AND
		DB_Players(_Player)
		AND
		QRY_OnlyOnce("SHA_LastJusticiar_StartUltimatumDialog")
		AND
		QRY_StartDialog((DIALOGRESOURCE)SHA_LastJusticiar_RatsUltimatum_c2d6a196-c24e-fa56-d420-9d49a6f31192, (CHARACTER)S_SHA_LastJusticiar_UltimatumSpeaker_5df7b066-7780-4dc5-a040-5aaea73a927e, _Player)
		AND
		DB_SHA_LastJusticiar_UltimatumRats(_Fighter, 0)
		AND
		IsOnStage(_Fighter, 0)
		AND
		QRY_OnlyOnce("SHA_LastJusticiar_SpawnFallBack")
		THEN
		PROC_SHA_LastJusticiar_CheckWaveThreshold();
		
		IF
		DB_InRegion(_Player, (TRIGGER)S_SHA_LastJusticiation_UltimatumLureArea_56305d1e-25cf-443e-8299-00d7ed144d04)
		AND
		DB_PartyMembers(_Player)
		AND
		NOT DB_GlobalFlag((FLAG)SHA_LastJusticiar_State_Hostile_ed6bc07d-6041-49c3-9fc5-bc604bc8543b)
		AND
		NOT QRY_CheckOtherPartyMembersInTrigger(_Player, (TRIGGER)S_SHA_LastJusticiation_UltimatumLureArea_56305d1e-25cf-443e-8299-00d7ed144d04)
		AND
		IsForceUpdate(S_SHA_LastJusticiar_UltimatumLure_4700da81-8c8e-455f-9158-dc2b6c204f29, 0)
		THEN
		SetForceUpdate(S_SHA_LastJusticiar_UltimatumLure_4700da81-8c8e-455f-9158-dc2b6c204f29, 1);
		
		// When a rat is defeated, check if 70% of the wave remains. If so, spawn a new wave
		IF
		DB_PermaDefeated(_Rat)
		AND
		DB_SHA_LastJusticiar_CurrentUltimatumWaveMembers(_Rat)
		THEN
		PROC_SHA_LastJusticiar_CheckWaveThreshold();
		
		IF
		DB_PermaDefeated(_Rat)
		AND
		DB_SHA_LastJusticiar_CurrentUltimatumWaveMembers(_Rat)
		THEN
		PROC_Poof(_Rat);
		
		IF
		LeftTrigger(_Player, (TRIGGER)S_SHA_LastJusticiation_UltimatumLureArea_56305d1e-25cf-443e-8299-00d7ed144d04)
		AND
		DB_PartyMembers(_Player)
		AND
		NOT QRY_CheckOtherPartyMembersInTrigger(_Player, (TRIGGER)S_SHA_LastJusticiation_UltimatumLureArea_56305d1e-25cf-443e-8299-00d7ed144d04)
		AND
		IsForceUpdate(S_SHA_LastJusticiar_UltimatumLure_4700da81-8c8e-455f-9158-dc2b6c204f29, 1)
		THEN
		SetForceUpdate(S_SHA_LastJusticiar_UltimatumLure_4700da81-8c8e-455f-9158-dc2b6c204f29, 0);
		
		IF
		WentOnStage(S_SHA_LastJusticiar_UltimatumLure_4700da81-8c8e-455f-9158-dc2b6c204f29, 1)
		AND
		DB_PartyMembers(_Player)
		AND
		DB_InRegion(_Player, (TRIGGER)S_SHA_LastJusticiation_UltimatumLureArea_56305d1e-25cf-443e-8299-00d7ed144d04)
		AND
		IsForceUpdate(S_SHA_LastJusticiar_UltimatumLure_4700da81-8c8e-455f-9158-dc2b6c204f29, 0)
		THEN
		SetForceUpdate(S_SHA_LastJusticiar_UltimatumLure_4700da81-8c8e-455f-9158-dc2b6c204f29, 1);
		
		IF
		WentOnStage(S_SHA_LastJusticiar_UltimatumLure_4700da81-8c8e-455f-9158-dc2b6c204f29, 0)
		AND
		IsForceUpdate(S_SHA_LastJusticiar_UltimatumLure_4700da81-8c8e-455f-9158-dc2b6c204f29, 1)
		THEN
		SetForceUpdate(S_SHA_LastJusticiar_UltimatumLure_4700da81-8c8e-455f-9158-dc2b6c204f29, 0);
		
		// Check if we need to spawn a new wave
		PROC
		PROC_SHA_LastJusticiar_CheckWaveThreshold()
		AND
		DB_SHA_LastJusticiar_UltimatumNewWaveTreshold(_Treshold)
		AND
		SysCount("DB_SHA_LastJusticiar_CurrentUltimatumWaveMembers", 1, _TotalMembers)
		AND
		QRY_GLO_DefeatCounter_Count("SHA_LastJusticiar_DefeatCounter_UltimatumWave", "PermaDefeated")
		AND
		DB_QRYRTN_GLO_DefeatCounter_Count(_DefeatedRats)
		AND
		QRY_SHA_LastJusticiar_CheckCanSpawnRats(_TotalMembers, _DefeatedRats, _Treshold)
		THEN
		PROC_SHA_LastJusticiar_SpawnUltimatumWave();
		
		QRY
		QRY_SHA_LastJusticiar_CheckCanSpawnRats((INTEGER)_TotalMembers, (INTEGER)_DefeatedRats, (INTEGER)_Treshold)
		AND
		_TotalMembers <= 0 // Guard against divisions by 0, always force spawning them in this case.
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_SHA_LastJusticiar_CheckCanSpawnRats((INTEGER)_TotalMembers, (INTEGER)_DefeatedRats, (INTEGER)_Treshold)
		AND
		_TotalMembers > 0
		AND
		IntegerSubtract(_TotalMembers, _DefeatedRats, _CurrentMembers)
		AND
		IntegerToReal(_TotalMembers, _RealTotal)
		AND
		IntegerToReal(_CurrentMembers, _RealCurrent)
		AND
		RealDivide(_RealCurrent, _RealTotal, _Ratio)
		AND
		RealProduct(_Ratio, 100.0, _RealPercentage)
		AND
		RealToInteger(_RealPercentage, _Percentage)
		AND
		_Percentage <= _Treshold
		THEN
		DB_NOOP(1);
		
		// When a new wave is spawned clear the already defeated characters from the defeat counter
		PROC
		PROC_SHA_LastJusticiar_SpawnUltimatumWave()
		AND
		DB_GLO_DefeatCounter(_Fighter, "SHA_LastJusticiar_DefeatCounter_UltimatumWave")
		AND
		DB_PermaDefeated(_Fighter)
		THEN
		NOT DB_GLO_DefeatCounter(_Fighter, "SHA_LastJusticiar_DefeatCounter_UltimatumWave");
		
		PROC
		PROC_SHA_LastJusticiar_SpawnUltimatumWave()
		AND
		DB_GlobalCounter("SHA_LastJusticiar_UltimatumWaveCounter", _CurrentWave)
		AND
		DB_SHA_LastJusticiar_UltimatumRats(_Fighter, _CurrentWave)
		THEN
		DB_SHA_LastJusticiar_CurrentUltimatumWaveMembers(_Fighter);
		DB_GLO_DefeatCounter(_Fighter, "SHA_LastJusticiar_DefeatCounter_UltimatumWave");
		AppearAt(_Fighter, _Fighter, 1, NULL_00000000-0000-0000-0000-000000000000, "SHA_LastJusticiar_UltimatumFighterAppeared", 0);
		
		PROC
		PROC_SHA_LastJusticiar_SpawnUltimatumWave()
		THEN
		PROC_IncreaseCounter("SHA_LastJusticiar_UltimatumWaveCounter");
		
		IF
		EnteredCombat(_Fighter, _ID)
		AND
		DB_SHA_LastJusticiar_UltimatumRats((CHARACTER)_Fighter, 2)
		AND
		DB_Players(_Player)
		AND
		QRY_IsInRange(_Fighter, _Player, 18.0)
		AND
		QRY_OnlyOnce("SHA_LastJusticiar_RatHorde")
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)SHA_LastJusticiar_VB_KillRats_9d65cadb-beca-198e-1ccc-1ef9e26caed8, _Player);
		
		IF
		VoiceBarkFailed((VOICEBARKRESOURCE)SHA_LastJusticiar_VB_KillRats_9d65cadb-beca-198e-1ccc-1ef9e26caed8)
		AND
		DB_OnlyOnce("SHA_LastJusticiar_RatHorde")
		THEN
		NOT DB_OnlyOnce("SHA_LastJusticiar_RatHorde");
		
		//END_REGION
		
		//REGION Rat Ultimatum - Horde
		
		IF
		DB_SHA_LastJusticiar_PackRat(_Rat)
		THEN
		SetOnStage(_Rat, 0);
		
		IF
		DB_GlobalFlag((FLAG)SHA_LastJusticiar_State_Ultimatum_05b19df2-2521-4fca-a540-41103a267d32)
		THEN
		TimerLaunch("SHA_LastJusticiar_TravelRatSpawn", 5000);
		
		IF
		TimerFinished("SHA_LastJusticiar_TravelRatSpawn")
		AND
		DB_SHA_LastJusticiar_RatHoles(_, _Trigger)
		THEN
		PROC_TriggerRegisterForParty(_Trigger);
		
		IF
		DB_GlobalFlag((FLAG)SHA_LastJusticiar_State_Hostile_ed6bc07d-6041-49c3-9fc5-bc604bc8543b)
		AND
		DB_SHA_LastJusticiar_RatHoles(_, _Trigger)
		THEN
		PROC_TriggerUnregisterForParty(_Trigger);
		
		IF
		DB_GlobalFlag((FLAG)SHA_LastJusticiar_State_Hostile_ed6bc07d-6041-49c3-9fc5-bc604bc8543b)
		AND
		DB_SHA_LastJusticiar_RatActive(_Rat, _)
		THEN
		PROC_DisappearOutOfSight(_Rat, "Run" , 0 , "");
		
		IF
		EnteredTrigger(_Char, _Trigger)
		AND
		DB_SHA_LastJusticiar_RatHoles(_Hole, _Trigger)
		AND
		NOT DB_SHA_LastJusticiar_RatActive(_, _Hole)
		AND
		SysCount("DB_SHA_LastJusticiar_RatActive", 2, _Count)
		AND
		_Count <= 8
		THEN
		PROC_SHA_LastJusticiar_DeterminePackSize((ITEM)_Hole);
		
		IF
		EnteredTrigger(_Char, _Trigger)
		AND
		DB_SHA_LastJusticiar_RatHoles(_Hole, _Trigger)
		AND
		NOT DB_SHA_LastJusticiar_RatActive(_, _)
		THEN
		PROC_SHA_LastJusticiar_DeterminePackSize((ITEM)_Hole);
		
		PROC
		PROC_SHA_LastJusticiar_DeterminePackSize((ITEM)_Hole)
		AND
		Random(4, _PackAddition)
		AND
		IntegerSum(_PackAddition, 2, _Pack)
		THEN
		PROC_SHA_LastJusticiar_TryPackRatAppear((ITEM)_Hole, (INTEGER)_Pack);
		
		PROC
		PROC_SHA_LastJusticiar_TryPackRatAppear((ITEM)_Hole, (INTEGER)_Pack)
		AND
		DB_SHA_LastJusticiar_PackRat(_Rat)
		AND
		NOT DB_SHA_LastJusticiar_RatActive(_Rat, _)
		AND
		QRY_SHA_LastJusticiar_PackSize((INTEGER)_Pack)
		AND
		Random(10, _Random)
		AND
		IntegerProduct(_Random, 300, _Timer)
		THEN
		TeleportTo(_Rat, _Hole, "", 0, 0, 0, 0, 0);
		SetDualEntityEvent(_Rat, _Hole, "SHA_LastJusticiar_RatSpawned", 1);
		DB_SHA_LastJusticiar_RatActive(_Rat, _Hole);
		ObjectTimerLaunch(_Rat, "SHA_LastJusticiar_SpawnDelay", _Timer);
		
		QRY
		QRY_SHA_LastJusticiar_PackSize((INTEGER)_Pack)
		AND
		SysCount("DB_SHA_LastJusticiar_RatActive", 2, _Count)
		AND
		_Count <= _Pack
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_SHA_LastJusticiar_PackSize((INTEGER)_Pack)
		AND
		NOT DB_SHA_LastJusticiar_RatActive(_, _)
		THEN
		DB_NOOP(1);
		
		IF
		ObjectTimerFinished(_Rat, "SHA_LastJusticiar_SpawnDelay")
		THEN
		SetOnStage(_Rat, 1);
		
		IF
		EntityEvent(_Rat, "SHA_LastJusticiar_RatLeft")
		AND
		DB_SHA_LastJusticiar_RatActive((CHARACTER)_Rat, _Hole)
		THEN
		PROC_Poof(_Rat);
		NOT DB_SHA_LastJusticiar_RatActive(_Rat, _Hole);
		
		IF
		EntityEvent(_Rat, "SHA_LastJusticiar_RatSquee")
		AND
		DB_SHA_LastJusticiar_RatActive((CHARACTER)_Rat, _Hole)
		AND
		Random(11, _Rand)
		AND
		_Rand > 7
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)SHA_LastJusticiar_AD_GrabAttention_de3c3537-7e1a-6518-29ed-c8bfd278e4f8, _Rat);
		
		IF
		Deactivated(_Rat)
		AND
		DB_SHA_LastJusticiar_RatActive((CHARACTER)_Rat, _)
		AND
		NOT DB_PermaDefeated(_Rat)
		THEN
		DB_SHA_LastJusticiar_RatInActive(_Rat);
		ObjectTimerLaunch(_Rat, "SHA_LastJusticiar_RemoveTimer", 2000);
		
		IF
		Activated(_Rat)
		AND
		DB_SHA_LastJusticiar_RatInActive((CHARACTER)_Rat)
		AND
		DB_SHA_LastJusticiar_RatActive((CHARACTER)_Rat, _)
		THEN
		NOT DB_SHA_LastJusticiar_RatInActive(_Rat);
		ObjectTimerCancel(_Rat, "SHA_LastJusticiar_RemoveTimer");
		
		IF
		ObjectTimerFinished(_Rat, "SHA_LastJusticiar_RemoveTimer")
		THEN
		NOT DB_SHA_LastJusticiar_RatInActive((CHARACTER)_Rat);
		SetEntityEvent(_Rat, "SHA_LastJusticiar_RatLeft", 1);
		
		//END_REGION
		
		//REGION Justiciar Appeared
		IF
		DB_PermaDefeated(_Rat)
		AND
		DB_SHA_LastJusticiar_UltimatumRats((CHARACTER)_Rat,_)
		THEN
		DB_SHA_LastJusticiar_LastRatFighterKilled(_Rat);
		
		IF
		DB_SHA_LastJusticiar_LastRatFighterKilled(_Rat)
		AND
		DB_SHA_LastJusticiar_LastRatFighterKilled(_OtherRat)
		AND
		_Rat != _OtherRat
		THEN
		NOT DB_SHA_LastJusticiar_LastRatFighterKilled(_OtherRat);
		
		IF
		DB_GlobalFlag((FLAG)SHA_LastJusticiar_State_JusticiarAppeared_1bb2fe4b-2c35-48d8-93ed-3e9e834557f6)
		AND
		DB_SHA_LastJusticiar_LastRatFighterKilled(_Rat)
		AND
		GetPosition(_Rat, _X, _Y, _Z)
		AND
		FindValidPosition(_X, _Y, _Z, 10.0, (CHARACTER)S_SHA_LastJusticiar_594ba359-ce55-4b54-9efc-94eca306c540, 1, _NewX, _NewY, _NewZ)
		THEN
		AppearAtPosition((CHARACTER)S_SHA_LastJusticiar_594ba359-ce55-4b54-9efc-94eca306c540, _NewX, _NewY, _NewZ, 1, NULL_00000000-0000-0000-0000-000000000000, "SHA_LastJusticiar_AppearedWildshaped", 0);
		
		IF
		DB_GlobalFlag((FLAG)SHA_LastJusticiar_Event_JusticiarTransforms_1ac06720-c2c2-4e84-bdf3-9b820235c948)
		THEN
		PROC_SHA_LastJusticiar_RevealJusticiar();
		
		IF
		EntityEvent(S_SHA_LastJusticiar_594ba359-ce55-4b54-9efc-94eca306c540, "SHA_LastJusticiar_AppearedWildshaped")
		AND
		DB_SHA_LastJusticiar_LastRatFighterKilled(_Rat)
		AND
		GetClosestAlivePlayer(_Rat, _Player, _Dist)
		AND
		_Dist <= 16.0
		AND
		NOT QRY_StartDialogCustom((DIALOGRESOURCE)SHA_LastJusticiar_JusticiarAppears_a91cb7a5-6d80-7c81-b227-25d461dd0a2f, S_SHA_LastJusticiar_594ba359-ce55-4b54-9efc-94eca306c540, _Player, 0, 0, 1, 0)
		THEN
		PROC_SHA_LastJusticiar_RevealJusticiar();
		
		PROC
		PROC_SHA_LastJusticiar_RevealJusticiar()
		THEN
		RemoveTransforms(S_SHA_LastJusticiar_594ba359-ce55-4b54-9efc-94eca306c540);
		PROC_SetRelationToPlayers((FACTION)ACT2_SHA_LastJusticiar_90c58abd-3aed-44da-af2b-9fd399b56d70, 0);
		
		PROC
		PROC_SHA_LastJusticiar_RevealJusticiar()
		AND
		DB_InRegion((CHARACTER)_Char, (TRIGGER)S_SHA_LastJusticiar_NegotiationArea_002_7ec4ae2a-d61b-441e-bc8e-a9e437a2b468)
		THEN
		PROC_EnterCombat(_Char, S_SHA_LastJusticiar_594ba359-ce55-4b54-9efc-94eca306c540);
		
		//END_REGION
		
		//REGION Ritual Circle
		
		IF
		AutomatedDialogEnded((DIALOGRESOURCE)SHA_LastJusticiar_PAD_RitualCircle_bc91866a-3893-5707-3253-e4a71f5b4bd9, _)
		AND
		QRY_OnlyOnce("SHA_LastJusticiar_RitualInteracted")
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)SHA_LastJusticiar_State_RitualCircleDiplorat_63d07871-153d-458f-98a8-87c72c2de001);
		PROC_State_Progress(S_SHA_LastJusticiar_594ba359-ce55-4b54-9efc-94eca306c540, "SHA_LastJusticiar", "SHA_LastJusticiar_State_RatsNegotiation");
		
		IF
		GameBookInterfaceClosed((ITEM)S_SHA_RitualBook_bf5d638b-f70a-4de0-b816-f892b15de919, _Player)
		AND
		DB_Players(_Player)
		AND
		NOT DB_OnlyOnce("SHA_LastJusticiar_ReadRitualBook")
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)SHA_LastJusticiar_PAD_RitualBook_905bc919-1efa-a7d5-a61e-41237635e728, _Player)
		AND
		QRY_OnlyOnce("SHA_LastJusticiar_ReadRitualBook")
		THEN
		DB_NOOP(1);
		
		//END_REGION
		
		//REGION Debug
		IF
		TextEvent("SHA_LastJusticiar_SetState_Panicked")
		THEN
		PROC_State_Progress(S_SHA_LastJusticiar_594ba359-ce55-4b54-9efc-94eca306c540, "SHA_LastJusticiar", "SHA_LastJusticiar_State_RatsPanicked");
		
		IF
		TextEvent("SHA_LastJusticiar_SetState_Negotiation")
		THEN
		PROC_State_Progress(S_SHA_LastJusticiar_594ba359-ce55-4b54-9efc-94eca306c540, "SHA_LastJusticiar", "SHA_LastJusticiar_State_RatsNegotiation");
		
		IF
		TextEvent("SHA_LastJusticiar_SetState_Ultimatum")
		THEN
		PROC_State_Progress(S_SHA_LastJusticiar_594ba359-ce55-4b54-9efc-94eca306c540, "SHA_LastJusticiar", "SHA_LastJusticiar_State_RatsUltimatum");
		
		IF
		TextEvent("SHA_LastJusticiar_SetState_Hostile")
		THEN
		PROC_State_Progress(S_SHA_LastJusticiar_594ba359-ce55-4b54-9efc-94eca306c540, "SHA_LastJusticiar", "SHA_LastJusticiar_State_RatsHostile");
		
		IF
		TextEvent("SHA_LastJusticiar_SetState_Apperance")
		THEN
		DB_SHA_LastJusticiar_LastRatFighterKilled((CHARACTER)S_SHA_LastJusticiar_Rat_UltimatumFighter_000_e0a6fcf0-266a-4875-b2e7-7fc4b2a1139f);
		PROC_State_Progress(S_SHA_LastJusticiar_594ba359-ce55-4b54-9efc-94eca306c540, "SHA_LastJusticiar", "SHA_LastJusticiar_State_JusticiarAppeared");
		
		IF
		FlagSet((FLAG)Debug_SHA_MeetLastJusticiar_bd18c238-10f8-48b3-a241-d93b726a093b, _Player, _)
		THEN
		PROC_State_Progress(S_SHA_LastJusticiar_594ba359-ce55-4b54-9efc-94eca306c540, "SHA_LastJusticiar", "SHA_LastJusticiar_State_JusticiarAppeared");
		TeleportTo(S_SHA_LastJusticiar_594ba359-ce55-4b54-9efc-94eca306c540, S_SHA_LastJusticiar_UltimatumDialogTrigger_2da51c13-8e94-4da2-aef0-9a0802d7b335, "SHA_LastJusticiar_JusticiarToLastRat");
		TeleportTo(_Player, S_SHA_LastJusticiar_UltimatumDialogTrigger_2da51c13-8e94-4da2-aef0-9a0802d7b335);
		//END_REGION
	}
	EXIT
	{
	}
}
