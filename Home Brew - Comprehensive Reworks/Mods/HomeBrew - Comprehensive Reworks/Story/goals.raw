	}
	KB
	{
		//REGION Procs that build the paper
		
		//Builds the dynamic papers daily
		
		PROC
		PROC_Act3_GLO_Gazette_HandleNumbering((INTEGER)_IssueNumber)
		AND
		IntegerSum(_IssueNumber, 1, _NewIssueNumber)
		THEN
		DB_Act3_GLO_Gazette_IssueNumber(_NewIssueNumber);
		NOT DB_Act3_GLO_Gazette_IssueNumber(_IssueNumber);
		PROC_Act3_GLO_Gazette_BuildIssue(_NewIssueNumber);
		
		PROC
		PROC_Act3_GLO_Gazette_BuildIssue((INTEGER)_NewIssueNumber)
		AND
		DB_Act3_GLO_Gazette_TodaysIssue(_OldIssue)
		AND
		IntegerToString(_NewIssueNumber, _IssueConcatString)
		AND
		Concatenate("LOW_Gazette_Issue", _IssueConcatString, _IssueToBuild)
		THEN
		DB_Act3_GLO_Gazette_TodaysIssue(_IssueToBuild);
		NOT DB_Act3_GLO_Gazette_TodaysIssue(_OldIssue);
		PROC_Act3_GLO_Gazette_ChooseBestHeadline();
		PROC_Act3_GLO_Gazette_AddHeadline(_IssueToBuild);
		PROC_Act3_GLO_Gazette_ChooseBestFooter();
		PROC_Act3_GLO_Gazette_AddFooter(_IssueToBuild);
		PROC_Act3_GLO_Gazette_ChooseBestArticle();
		PROC_Act3_GLO_Gazette_AddArticles(_IssueToBuild);
		PROC_Act3_GLO_Gazette_ChooseBestArticle();
		PROC_Act3_GLO_Gazette_AddArticles(_IssueToBuild);
		PROC_Act3_GLO_Gazette_ChooseBestArticle();
		PROC_Act3_GLO_Gazette_AddArticles(_IssueToBuild);
		PROC_Act3_GLO_Gazette_ChooseBestArticle();
		PROC_Act3_GLO_Gazette_AddArticles(_IssueToBuild);
		PROC_Act3_GLO_Gazette_ChooseBestHeadline();
		PROC_Act3_GLO_Gazette_AddHeadline(_IssueToBuild);
		SetEditionForCustomBook(_IssueToBuild, _NewIssueNumber);
		
		
		PROC
		PROC_Act3_GLO_Gazette_ChooseBestHeadline()
		AND
		DB_Act3_GLO_Gazette_Articles(_ThisArticle, _Priority, "Headline")
		AND
		DB_Act3_GLO_Gazette_BestHeadline(_BestArticle, _BestPriority)
		AND
		_Priority > _BestPriority
		THEN
		DB_Act3_GLO_Gazette_BestHeadline(_ThisArticle, _Priority);
		NOT DB_Act3_GLO_Gazette_BestHeadline(_BestArticle, _BestPriority);
		
		PROC
		PROC_Act3_GLO_Gazette_ChooseBestArticle()
		AND
		DB_Act3_GLO_Gazette_Articles(_ThisArticle, _Priority, "Article")
		AND
		DB_Act3_GLO_Gazette_BestArticle(_BestArticle, _BestPriority)
		AND
		_Priority > _BestPriority
		THEN
		DB_Act3_GLO_Gazette_BestArticle(_ThisArticle, _Priority);
		NOT DB_Act3_GLO_Gazette_BestArticle(_BestArticle, _BestPriority);
		
		PROC
		PROC_Act3_GLO_Gazette_ChooseBestFooter()
		AND
		DB_Act3_GLO_Gazette_Articles(_ThisArticle, _Priority, "Footer")
		AND
		DB_Act3_GLO_Gazette_BestFooter(_BestArticle, _BestPriority)
		AND
		_Priority > _BestPriority
		THEN
		DB_Act3_GLO_Gazette_BestFooter(_ThisArticle, _Priority);
		NOT DB_Act3_GLO_Gazette_BestFooter(_BestArticle, _BestPriority);
		
		
		PROC
		PROC_Act3_GLO_Gazette_AddHeadline((STRING)_IssueToBuild)
		AND
		DB_Act3_GLO_Gazette_BestHeadline((STRING)_BestHeadline, (INTEGER)_BestPriority)
		AND
		DB_Act3_GLO_Gazette_Illustrations(_BestHeadline, _Image)
		THEN
		AddEntryToCustomBook(_IssueToBuild, _BestHeadline);
		AddIllustrationToCustomBook(_IssueToBuild, _Image);
		DB_Act3_GLO_Gazette_BestHeadline(_BestHeadline, 0);
		DB_Act3_GLO_Gazette_Articles(_BestHeadline, 0, "Headline");
		NOT DB_Act3_GLO_Gazette_Illustrations(_BestHeadline, _Image);
		NOT DB_Act3_GLO_Gazette_Articles(_BestHeadline, _BestPriority, "Headline");
		NOT DB_Act3_GLO_Gazette_BestHeadline(_BestHeadline, _BestPriority);
		
		PROC
		PROC_Act3_GLO_Gazette_AddArticles((STRING)_IssueToBuild)
		AND
		DB_Act3_GLO_Gazette_BestArticle((STRING)_BestArticle, (INTEGER)_BestPriority)
		THEN
		AddEntryToCustomBook(_IssueToBuild, _BestArticle);
		DB_Act3_GLO_Gazette_BestArticle(_BestArticle, 0);
		DB_Act3_GLO_Gazette_Articles(_BestArticle, 0, "Article");
		NOT DB_Act3_GLO_Gazette_Articles(_BestArticle, _BestPriority, "Article");
		NOT DB_Act3_GLO_Gazette_BestArticle(_BestArticle, _BestPriority);
		
		PROC
		PROC_Act3_GLO_Gazette_AddFooter((STRING)_IssueToBuild)
		AND
		DB_Act3_GLO_Gazette_BestFooter((STRING)_BestFooter, (INTEGER)_BestPriority)
		THEN
		AddEntryToCustomBook(_IssueToBuild, _BestFooter);
		DB_Act3_GLO_Gazette_BestFooter(_BestFooter, 0);
		DB_Act3_GLO_Gazette_Articles(_BestFooter, 0, "Footer");
		NOT DB_Act3_GLO_Gazette_Articles(_BestFooter, _BestPriority, "Footer");
		NOT DB_Act3_GLO_Gazette_BestFooter(_BestFooter, _BestPriority);
		
		
		//END_REGION
		
		//REGION Logic for triggering the paper build
		
		PROC
		PROC_LongRest()
		AND
		DB_GlobalFlag(GLO_Gazette_DailyGazettePrinting_5d9ab902-38c1-4a54-baa5-683d49614762)
		AND
		DB_Act3_GLO_Gazette_IssueNumber(_OldIssueNumber)
		THEN
		PROC_Act3_GLO_Gazette_HandleNumbering(_OldIssueNumber);
		
		//END_REGION
		
		//REGION Does all the work to listen for and update article priorities
		
		PROC
		PROC_Act3_GLO_Gazette_UpdatePriority((STRING)_ArticleName, (INTEGER)_NewPriority)
		AND
		DB_Act3_GLO_Gazette_Articles(_ArticleName, _OldPriority, _String)
		THEN
		DB_Act3_GLO_Gazette_Articles(_ArticleName, _NewPriority, _String);
		NOT DB_Act3_GLO_Gazette_Articles(_ArticleName, _OldPriority, _String);
		
		
		IF
		FlagSet(_ArticleFlag, _, _)
		AND
		DB_Act3_GLO_Gazette_FlagCancel(_ArticleFlag, _ArticleName)
		AND
		DB_Act3_GLO_Gazette_Articles(_ArticleName, _Priority, _String)
		THEN
		NOT DB_Act3_GLO_Gazette_Articles(_ArticleName, _Priority, _String);
		
		//REGION Cancelled articles that are currently selected as best get moved to priority 0
		IF
		FlagSet(_ArticleFlag, _, _)
		AND
		DB_Act3_GLO_Gazette_FlagCancel(_ArticleFlag, _ArticleName)
		AND
		DB_Act3_GLO_Gazette_BestHeadline(_ArticleName, _Priority)
		THEN
		DB_Act3_GLO_Gazette_BestHeadline(_ArticleName, 0);
		NOT DB_Act3_GLO_Gazette_BestHeadline(_ArticleName, _Priority);
		
		IF
		FlagSet(_ArticleFlag, _, _)
		AND
		DB_Act3_GLO_Gazette_FlagCancel(_ArticleFlag, _ArticleName)
		AND
		DB_Act3_GLO_Gazette_BestArticle(_ArticleName, _Priority)
		THEN
		DB_Act3_GLO_Gazette_BestArticle(_ArticleName, 0);
		NOT DB_Act3_GLO_Gazette_BestArticle(_ArticleName, _Priority);
		
		IF
		FlagSet(_ArticleFlag, _, _)
		AND
		DB_Act3_GLO_Gazette_FlagCancel(_ArticleFlag, _ArticleName)
		AND
		DB_Act3_GLO_Gazette_BestFooter(_ArticleName, _Priority)
		THEN
		DB_Act3_GLO_Gazette_BestFooter(_ArticleName, 0);
		NOT DB_Act3_GLO_Gazette_BestFooter(_ArticleName, _Priority);
		//END_REGION
		
		IF
		FlagSet(_ArticleFlag, _, _)
		AND
		DB_Act3_GLO_Gazette_FlagReactions(_ArticleFlag, _ArticleName, _NewPriority)
		THEN
		PROC_Act3_GLO_Gazette_UpdatePriority(_ArticleName, _NewPriority);
		
		//END_REGION
		
		//REGION Handles buying and opening papers
		
		//Captures the issue for the paper that was bought
		IF
		AddedTo(_Item, _Player, "Regular")
		AND
		DB_Players((CHARACTER)_Player)
		AND
		GetTemplate(_Item, _Template)
		AND
		_Template == UNI_LOW_BaldursMouth_DailyPaper_5ffe11b1-4949-47cd-ab49-80053db261f9
		AND
		DB_Act3_GLO_Gazette_TodaysIssue(_Issue)
		AND
		NOT DB_Act3_GLO_Gazette_OwnedPapers(_Item, _Issue)
		THEN
		SetStoryDisplayName(_Item, _Issue);
		DB_Act3_GLO_Gazette_OwnedPapers(_Item, _Issue);
		
		
		//Handles opening the correct copy of the paper
		IF
		TemplateUseFinished(_Player, UNI_LOW_BaldursMouth_DailyPaper_5ffe11b1-4949-47cd-ab49-80053db261f9, _Item, _)
		AND
		DB_Act3_GLO_Gazette_OwnedPapers(_Item, _Issue)
		THEN
		OpenReferencedBookUI(_Player, _Issue, _Item);
		
		//END_REGION
		
		//REGION Handles opening the paper objects in game
		IF
		TemplateUseStarted(_Player, UNI_LOW_BaldursMouth_DailyPaper_5ffe11b1-4949-47cd-ab49-80053db261f9, _Item)
		AND
		NOT DB_Act3_GLO_Gazette_OwnedPapers(_Item, _)
		AND
		DB_Act3_GLO_Gazette_TodaysIssue(_Issue)
		THEN
		SetStoryDisplayName(_Item, _Issue);
		DB_Act3_GLO_Gazette_OwnedPapers(_Item, _Issue);
		
		IF
		TemplateUseStarted(_Player, UNI_LOW_BaldursMouth_DailyPaper_5ffe11b1-4949-47cd-ab49-80053db261f9, _Item)
		AND
		NOT DB_GlobalFlag(GLO_Gazette_DailyGazettePrinting_5d9ab902-38c1-4a54-baa5-683d49614762)
		AND
		DB_Act3_GLO_Gazette_TodaysIssue("LOW_Gazette_Issue86")
		AND
		QRY_OnlyOnce("Act3_GLO_NewspaperPrinting")
		THEN
		PROC_GlobalSetFlagAndCache(GLO_Gazette_DailyGazettePrinting_5d9ab902-38c1-4a54-baa5-683d49614762);
		//END_REGION
		
		//REGION Emperor response after hearing of Stelmane's death
		// Emperor appears after the player reads about Duke Stelmane
		IF
		CustomBookUIClosed((CHARACTER)_Player, "LOW_Gazette_Issue86")
		THEN
		PROC_GLO_Gazette_TryEmperorResponseStelmaneDead(_Player);
		
		PROC
		PROC_GLO_Gazette_TryEmperorResponseStelmaneDead((CHARACTER)_Player)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_Daisy_State_TriggerDaisyStelmane_0ea9e817-7b69-4ced-97ec-d579740198e3)
		AND
		DB_Players(_Player)
		AND
		IsTagged(_Player, (TAG)ILLITHID_HIDDEN_CHECK_4835ba9d-c0d6-40fb-ad62-88f875b536c2, 1)
		AND
		QRY_OnlyOncePerUser(_Player, "GLO_Gazette_EmperorResponseStelmaneDead")
		THEN
		SetFlag((FLAG)GLO_Daisy_State_TriggerDaisyStelmane_0ea9e817-7b69-4ced-97ec-d579740198e3);
		PROC_EmperorAD(_Player, (DIALOGRESOURCE)WYR_Posthouse_StelmaneDead_EmperorAD_4ea6fcaa-2e07-d783-4c6d-04da54a6557a);
		DB_GLO_Gazette_EmperorRespondedStelmanesDeath_Player(_Player);
		
		// Jaheira responds to death of Duke Stelmane after nearby partymember reads broadsheet
		IF
		AutomatedDialogEnded(WYR_Posthouse_StelmaneDead_EmperorAD_4ea6fcaa-2e07-d783-4c6d-04da54a6557a, _)
		AND
		DB_GLO_Gazette_EmperorRespondedStelmanesDeath_Player(_Player)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(_Player, S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a)
		AND
		NOT QRY_StartDialog_Fixed(WYR_Posthouse_PAD_Jaheira_StelmaneDead_c60b1065-40f9-9b47-be94-20f6e998558b, S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a)
		THEN
		NOT DB_GLO_Gazette_EmperorRespondedStelmanesDeath_Player(_Player);
		
		// Jaheira responds to death of Duke Stelmane after reading broadsheet
		IF
		AutomatedDialogEnded(WYR_Posthouse_StelmaneDead_EmperorAD_4ea6fcaa-2e07-d783-4c6d-04da54a6557a, _)
		AND
		DB_GLO_Gazette_EmperorRespondedStelmanesDeath_Player(S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a)
		AND
		NOT QRY_StartDialog_Fixed(WYR_Posthouse_PAD_Jaheira_StelmaneDead_c60b1065-40f9-9b47-be94-20f6e998558b, S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a)
		THEN
		NOT DB_GLO_Gazette_EmperorRespondedStelmanesDeath_Player(S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a);
		
		// clean up DB
		IF
		AutomatedDialogEnded(WYR_Posthouse_PAD_Jaheira_StelmaneDead_c60b1065-40f9-9b47-be94-20f6e998558b, _)
		AND
		DB_GLO_Gazette_EmperorRespondedStelmanesDeath_Player(_Player)
		THEN
		NOT DB_GLO_Gazette_EmperorRespondedStelmanesDeath_Player(_Player);
		
		PROC
		PROC_LongRest()
		AND
		DB_GlobalFlag(GLO_Daisy_State_TriggerDaisyStelmane_0ea9e817-7b69-4ced-97ec-d579740198e3)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_Gazette_StelmanesDeathIsOldNews_f7b59448-5254-4557-83b3-ccab76f03786)
		THEN
		SetFlag((FLAG)GLO_Gazette_StelmanesDeathIsOldNews_f7b59448-5254-4557-83b3-ccab76f03786);
		//END_REGION
		
		//REGION Handles the Headline AD logic for the Paper Boys
		IF
		DB_Act3_GLO_Gazette_BestHeadline(_BestArticle, 0)
		AND
		DB_Act3_GLO_Gazette_HeadlineFlags(_BestArticle, _Flag)
		THEN
		PROC_GlobalSetFlagAndCache(_Flag);
		DB_Act3_GLO_Gazette_ActiveHeadlineFlag(_Flag);
		
		PROC
		PROC_LongRest()
		AND
		DB_Act3_GLO_Gazette_ActiveHeadlineFlag(_Flag)
		THEN
		PROC_GlobalClearFlagAndCache(_Flag);
		NOT DB_Act3_GLO_Gazette_ActiveHeadlineFlag(_Flag);
		//END_REGION
		
		//REGION For handling Paper Boy actions
		IF
		DB_LOW_BaldursMouth_PaperBoySpots((CHARACTER)_PaperBoy)
		THEN
		DB_SpotPlayers(_PaperBoy, "LOW_BaldursMouth_PaperBoyADStart", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		DB_SpotPlayers_Continuous(_PaperBoy, "LOW_BaldursMouth_PaperBoyADStart");
		
		PROC
		PROC_SpotPlayers_Spotted(_PaperBoy, "LOW_BaldursMouth_PaperBoyADStart", _Player)
		AND
		DB_Players(_Player)
		AND
		NOT DB_DialogRequestCache_DialogInstance(LOW_BaldursMouth_AD_PaperBoys_2f9f653b-f5af-f8c0-d17f-47c3a0af158d, _)
		THEN
		PROC_TryStartAD(LOW_BaldursMouth_AD_PaperBoys_2f9f653b-f5af-f8c0-d17f-47c3a0af158d, _PaperBoy);
		
		PROC
		PROC_LongRest()
		AND
		DB_LOW_BaldursMouth_PaperBoyFlags(_, _PaperBoyFlag)
		AND
		DB_GlobalFlag(_PaperBoyFlag)
		THEN
		PROC_GlobalClearFlagAndCache(_PaperBoyFlag);
		
		//Estra + Paper Boy scene, then sets paper boy to normal street crier behaviour
		PROC
		PROC_SpotPlayers_Spotted(_PaperBoy, "LOW_BaldursMouth_PaperBoyAndEstraAD", _Player)
		THEN
		PROC_TryStartAD(LOW_BaldursMouth_AD_EstraAndPaperBoy_aa811f9c-ada3-65ef-45e1-b46f6990af1e, _PaperBoy, S_LOW_BaldursMouth_EstraStir_0517dac3-e9f9-4d40-a863-2034f4a865fb);
		
		IF
		AutomatedDialogEnded(LOW_BaldursMouth_AD_EstraAndPaperBoy_aa811f9c-ada3-65ef-45e1-b46f6990af1e, _)
		THEN
		DB_LOW_BaldursMouth_PaperBoySpots(S_LOW_BaldursMouth_PaperBoy_Stormshore_af043ce6-ed49-4bc1-9d9a-d62331f59407);
		//END_REGION
		
		//REGION Prints a special paper on Gortash's Death
		IF
		FlagSet((FLAG)GLO_Gortash_State_PermaDefeated_74dd56ff-7e00-42a6-a0f3-0d122f364769, _, _)
		AND
		QRY_OnlyOnce("Gazette_Gortash_Dead_Special_Paper")
		THEN
		TimerLaunch("Gazette_Gortash_Dead_Special_Paper", 200);
		PROC_GlobalSetFlagAndCache((FLAG)GLO_Gazette_State_GortashHeadline_82ce6057-2424-49ca-bc8e-b6d2248ade8d);
		
		IF
		TimerFinished("Gazette_Gortash_Dead_Special_Paper")
		AND
		DB_Act3_GLO_Gazette_IssueNumber(_OldIssueNumber)
		THEN
		PROC_Act3_GLO_Gazette_HandleNumbering(_OldIssueNumber);
		
		IF
		FlagSet((FLAG)GLO_Gortash_State_PermaDefeated_74dd56ff-7e00-42a6-a0f3-0d122f364769, _, _)
		AND
		DB_GlobalFlag(LOW_BaldursMouth_State_NegativeArticleStarted_b1f2debb-9174-441f-9b1e-0e3bc9aba3eb)
		THEN
		ClearFlag(LOW_BaldursMouth_State_NegativeArticleStarted_b1f2debb-9174-441f-9b1e-0e3bc9aba3eb);
		
		IF
		FlagSet((FLAG)GLO_Gortash_State_PermaDefeated_74dd56ff-7e00-42a6-a0f3-0d122f364769, _, _)
		AND
		NOT DB_GlobalFlag(GLO_Gazette_DailyGazettePrinting_5d9ab902-38c1-4a54-baa5-683d49614762)
		THEN
		PROC_GlobalSetFlagAndCache(GLO_Gazette_DailyGazettePrinting_5d9ab902-38c1-4a54-baa5-683d49614762);
		
		PROC
		PROC_LongRest()
		AND
		DB_GlobalFlag((FLAG)GLO_Gazette_State_GortashHeadline_82ce6057-2424-49ca-bc8e-b6d2248ade8d)
		THEN
		PROC_GlobalClearFlagAndCache((FLAG)GLO_Gazette_State_GortashHeadline_82ce6057-2424-49ca-bc8e-b6d2248ade8d);
		
		//END_REGION
		
		//REGION Restocking papers in the world
		
		PROC
		PROC_LongRest()
		THEN
		DB_ExecuteInLevel("GLO_Gazette_Paperstacks_AddDailyPapers","CTY_Main_A");
		
		PROC
		PROC_ExecuteInLevel("GLO_Gazette_Paperstacks_AddDailyPapers","CTY_Main_A")
		AND
		DB_GLO_Gazette_PaperStacks(_Stack)
		AND
		TemplateIsInInventory(UNI_LOW_BaldursMouth_DailyPaper_5ffe11b1-4949-47cd-ab49-80053db261f9, _Stack, _Count)
		AND
		_Count < 1
		THEN
		TemplateAddTo(UNI_LOW_BaldursMouth_DailyPaper_5ffe11b1-4949-47cd-ab49-80053db261f9, _Stack, 1, 0);
		
		IF
		DestroyedBy(_Stack, _, _, _)
		AND
		DB_GLO_Gazette_PaperStacks(_Stack)
		THEN
		NOT DB_GLO_Gazette_PaperStacks(_Stack);
		
		//END_REGION
		
		
		//REGION Restocking the backloag of articles
		IF
		DB_Act3_GLO_Gazette_IssueNumber(101)
		AND
		QRY_OnlyOnce("Act3_GLO_Gazette_RefillGenericArticles")
		THEN
		PROC_GLO_Gazette_RestockArticles();
		
		PROC
		PROC_GLO_Gazette_RestockArticles()
		AND
		DB_Act3_GLO_Gazette_ArticlesRestock(_Article, _Priority, _Type)
		THEN
		DB_Act3_GLO_Gazette_Articles(_Article, _Priority, _Type);
		NOT DB_Act3_GLO_Gazette_ArticlesRestock(_Article, _Priority, _Type);
		
		
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(510).Title("Act3_GLO_Gortash");
Goal(510)
{
	INIT
	{
	}
	KB
	{
		//REGION Gortash's Gauntlet with the Netherstone
		IF
		TemplateAddedTo(MAG_Gortash_Gloves_f7d87a7a-e5aa-4bc9-ba51-4e2df3e0bae0, _Gloves, (CHARACTER)_Player, _)
		AND
		DB_Players(_Player)
		AND
		QRY_OnlyOnce("GLO_Gortash_NetherstoneRemoved")
		THEN
		RequestDelete((ITEM)_Gloves);
		TemplateAddTo(MAG_Gortash_Gloves_WithoutNetherstone_6ea2650e-c12b-43d9-873e-f3d426d30d18, _Player, 1, 1);
		ToInventory(S_WYR_CrownController_Gortash_383be300-d328-4152-86df-4927482d1fd7, _Player, 1, 1, 1);
		DB_WYR_KillDirectorGortash_CanTransformGortash(1); // only transform during the dialog, we don't want the player to see the transformation in the gameplay
		Transform(S_GLO_BaneDummyForGortashSwD_c2e4f43d-c5e6-4f86-9bfc-2dd3804408f5, GLO_Gortash_Stoneless_ForBaneDummy_238f77bd-45cf-4bc1-8ac8-6fc1201abbcd, (SHAPESHIFTRULE)Disguise_ceccc4eb-d774-4cd5-9147-12322b81b763);
		DB_AddCharactersInTriggerToDialog((DIALOGRESOURCE)WYR_KillDirectorGortash_NetherbrainMindmeld_673f3fd9-0e41-8d53-153b-72af69991378, (TRIGGER)S_WYR_KillDirectorGortash_OfficeMainRoom_34997f3f-f6a9-4a86-bd6d-6867360539a4, 1);
		DB_AddCharactersInTriggerToDialog((DIALOGRESOURCE)GLO_EmperorPrelude_EndReady_27c34570-216b-3b6d-928e-938948d3591d, (TRIGGER)S_WYR_KillDirectorGortash_OfficeMainRoom_34997f3f-f6a9-4a86-bd6d-6867360539a4, 1);
		
		IF
		DialogStarted(WYR_KillDirectorGortash_NetherbrainMindmeld_673f3fd9-0e41-8d53-153b-72af69991378, _)
		AND
		DB_WYR_KillDirectorGortash_CanTransformGortash(1)
		THEN
		Transform(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, CINE_GLO_Gortash_Dead_8eb69922-1d83-4284-93f9-c568325b6bd6, (SHAPESHIFTRULE)DisguiseKeepName_c7c3381e-b901-416e-a0c4-bc745e1ff54a);
		
		IF
		DialogStarted((DIALOGRESOURCE)GLO_EmperorPrelude_EndReady_27c34570-216b-3b6d-928e-938948d3591d, _)
		AND
		DB_WYR_KillDirectorGortash_CanTransformGortash(1)
		THEN
		Transform(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, CINE_GLO_Gortash_Dead_8eb69922-1d83-4284-93f9-c568325b6bd6, (SHAPESHIFTRULE)DisguiseKeepName_c7c3381e-b901-416e-a0c4-bc745e1ff54a);
		//END_REGION
		
		//REGION Teleporting Bane for SwD
		IF
		EnteredLevel(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, _, "END_Main")
		THEN
		TeleportTo(S_GLO_BaneDummyForGortashSwD_c2e4f43d-c5e6-4f86-9bfc-2dd3804408f5, S_GLO_Asylum_BanePos_10b37f93-057d-438c-8c73-ceda370b2b8e, "", 0, 0, 0, 0, 1);
		//END_REGION
	}
	EXIT
	{
	}
}
