		PROC
		PROC_Jaheira_ClearADs((GUIDSTRING)_Jaheira, (DIALOGRESOURCE)_ExistingADs)
		THEN
		NOT DB_HAV_Jaheira_CurrentADs(_ExistingADs);
		NOT DB_CombatReact_AD_OnNextTurn(_Jaheira, _ExistingADs);
		
		PROC
		PROC_Jaheira_AddADs((GUIDSTRING)_Jaheira, (DIALOGRESOURCE)_NewADs)
		THEN
