		DB_UND_Bulette_CombatArenas((FLAG)UND_Bulette_State_Arena002_InProgress_e2fceb55-6268-4cef-9883-ae63de160b6f, (TRIGGER)S_UND_Bulette_CombatArena_002_abe46858-e46a-43c6-bb32-4c93ac3cd40b);
