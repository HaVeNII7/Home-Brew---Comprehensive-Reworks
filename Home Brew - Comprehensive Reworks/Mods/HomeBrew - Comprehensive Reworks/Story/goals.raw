		SetFlag(SCL_Inquisition_State_InvestigateMason_25dec181-2a8b-44f0-83c4-bf2c6ac5e360,_Player,0,1);
		
		IF
		TextEvent("SCL_Inquisition_State_InvestigateMason")
		AND
		DB_Players(_Player)
		THEN
		SetFlag(SCL_Inquisition_State_InvestigateMason_25dec181-2a8b-44f0-83c4-bf2c6ac5e360,_Player,0,1);
		
		IF
		TextEvent("SCL_Inquisition_State_FoundMasonResistance")
		AND
		DB_Players(_Player)
		THEN
		SetFlag(SCL_Inquisition_State_FoundMasonResistance_bb178587-5a4d-43cf-a60e-6f6b2d8cc558,_Player,0,1);
		
		IF
		TextEvent("SCL_Inquisition_State_MoveToNextAct")
		AND
		DB_Players(_Player)
		THEN
		SetFlag(SCL_Inquisition_State_MovedToNextAct_4e58af2b-2988-4d14-a584-291618a5d2b0,_Player,0,1);
		
		//END_REGION DEBUG
		
		IF
		GameBookInterfaceClosed(S_SCL_InquisitionLedger_1e90ae65-f0aa-4b85-b85e-c67a1a9fac40,_Player)
		THEN
		SetFlag(SCL_Inquisition_State_ReadInquisitorOrder_593fd6de-219a-4388-9291-a629300ae75e,_Player,0,1);
		
		IF
		GameBookInterfaceClosed(S_SCL_BannedSeluneItemsNote_2eb9e0b0-87aa-4171-a78c-c033da18ad45,_Player)
		THEN
		SetFlag(SCL_Inquisition_State_ReadPottersNote_b582a96f-5c68-4143-abd9-029827be2f25,_Player,0,1);
		SetFlag(SCL_Inquisition_State_SearchLastLight_ca757872-22bc-46a6-beab-6ef21b556ac7,_Player,0,1);
		
		IF
		GameBookInterfaceClosed(S_HAV_SeluniteResistanceNote_c2827852-5cc1-46ec-8ab0-254e52150966,_Player)
		THEN
		SetFlag(SCL_Inquisition_State_DiscoveredLastLight_87adc0f4-f40f-440d-8312-5438d90bcf66,_Player,0,1);
		SetFlag(SCL_Inquisition_State_InvestigateMason_25dec181-2a8b-44f0-83c4-bf2c6ac5e360,_Player,0,1);
		
		IF
		GameBookInterfaceClosed(S_TWN_MasonGuild_Log_be5a1904-ec39-4821-950c-f051a701812b,_Player)
		THEN
		SetFlag(SCL_Inquisition_State_FoundMasonResistance_bb178587-5a4d-43cf-a60e-6f6b2d8cc558,_Player,0,1);
	}
	EXIT
	{
	}
}
Goal(907).Title("Shared_CombatDialogs");
Goal(907)
{
	INIT
	{
		NOT DB_NPCAttackAD((CHARACTER)NULL_00000000-0000-0000-0000-000000000000, (DIALOGRESOURCE)NULL_00000000-0000-0000-0000-000000000000);
	}
	KB
	{
		//REGION Interrupt repeated automated dialogs for characters entering combat
		// Enter combat while in repeating AD -> stop AD
		IF
		EnteredCombat(_Participant, _CombatID)
		AND
		DB_DialogNPCs(_DialogID,_Participant,_)
		AND
		DB_DialogName(_DialogName, _DialogID)
		AND
		DialogGetCategory(_DialogID,"Repeated automated NPC Dialog")
		THEN
		PROC_ForceStopDialog(_Participant);
		
		IF
		CombatStarted(_CombatID)
		THEN
		DB_CombatDialogs_CombatStarted(_CombatID);
		
		IF
		CombatEnded(_CombatID)
		THEN
		NOT DB_CombatDialogs_CombatStarted(_CombatID);
		
		// Special case: AD was started more or less at the same time as the combat
		// (e.g. from Anubis behaviour after interactive dialog ended that also
		//  initiates combat) -> immediately stop it when we get the AutomatedDialgStarted
		// event to cut off the first line asap (or ideally prevent it from showing at all)
		IF
		AutomatedDialogStarted(_, _DialogID)
		AND
		DB_DialogNPCs(_DialogID, _Participant, _)
		AND
		// Got EnteredCombat event, but no CombatStarted yet
		DB_Is_InCombat(_Participant, _CombatID)
		AND
		NOT DB_CombatDialogs_CombatStarted(_CombatID)
		AND
		DB_DialogName(_DialogName, _DialogID)
		AND
		DialogGetCategory(_DialogID,"Repeated automated NPC Dialog")
		THEN
		PROC_ForceStopDialog(_Participant);
		//END_REGION
		
		//REGION Combat ADs
		IF
		StartAttack(_, _, _NPC, _StoryActionID)
		AND
		_NPC != NULL_00000000-0000-0000-0000-000000000000
		AND
		IsCharacter(_NPC, 1)
		THEN
		PROC_TryStartNPCAttackAD((CHARACTER)_NPC, _StoryActionID);
		
		IF
		StartAttackPosition(_, _, _, _, _NPC, _StoryActionID)
		AND
		_NPC != NULL_00000000-0000-0000-0000-000000000000
		AND
		IsCharacter(_NPC, 1)
		THEN
		PROC_TryStartNPCAttackAD((CHARACTER)_NPC, _StoryActionID);
		
		PROC
		PROC_TryStartNPCAttackAD((CHARACTER)_NPC, (INTEGER)_StoryActionID)
		AND
		NOT DB_NPCAttackAD_StoryActionHandled(_NPC, _StoryActionID)
		AND
		DB_NPCAttackAD(_NPC, _Dialog)
		AND
		NOT DB_CantTalk_IgnoreCombat(_NPC)
		AND
		// Don't do this if the NPC is already in an AD
		NOT DB_DialogNPCs(_, _NPC, _)
		AND
		DB_Is_InCombat(_NPC, _CombatGUID)
		AND
		NOT DB_NPCAttackAD_Timer(_CombatGUID, _)
		AND
		QRY_GetFairRand("GLO_NPCAttackAD", 10)
		AND
		DB_FairRand_ReturnVal(0)
		AND
		GUIDToString(_CombatGUID, _CombatGUIDString)
		AND
		Concatenate("GLO_NPCAttackAD_Timer_", _CombatGUIDString, _TimerName)
		THEN
		DB_NPCAttackAD_Timer(_CombatGUID, _TimerName);
		TimerLaunch(_TimerName, 45000);
		// Don't play more than once even if we hit multiple targets with the same attack
		// (although the timer will generally catch that too, depending on how long it is
		//  and how long the animations take)
		DB_NPCAttackAD_StoryActionHandled(_NPC, _StoryActionID);
		PROC_TryStartAD(_Dialog, _NPC);
		
		IF
		TimerFinished(_TimerName)
		AND
		DB_NPCAttackAD_Timer(_CombatGUID, _TimerName)
		THEN
		NOT DB_NPCAttackAD_Timer(_CombatGUID, _TimerName);
		
		// Clean up
		IF
		TurnStarted(_NPC)
		AND
		DB_NPCAttackAD_StoryActionHandled((CHARACTER)_NPC, _StoryActionID)
		THEN
		NOT DB_NPCAttackAD_StoryActionHandled(_NPC, _StoryActionID);
		
		IF
		LeftCombat(_NPC, _)
		AND
		DB_NPCAttackAD_StoryActionHandled((CHARACTER)_NPC, _StoryActionID)
		THEN
		NOT DB_NPCAttackAD_StoryActionHandled(_NPC, _StoryActionID);
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(908).Title("Start");
Goal(908)
{
	INIT
	{
		DB_Origins((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255);
		DB_Origins((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604);
		DB_Origins((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		DB_Origins((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d);
		DB_Origins((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679);
		
		DB_CharacterCreationTransitionInfo("TUT_Avernus_C", "GUS_CGI01_Part2");
		
	}
	KB
	{
		IF
		DB_Origins(_Origin)
		THEN
		DB_GEB_UnavailableDialog(_Origin, (DIALOGRESOURCE)GLO_AD_CompanionCantTalk_5b47f078-c7c2-3f21-d96f-93c0652aa2f2);
		
		PROC
		PROC_Shared_CharacterCreationFinished()
		THEN
