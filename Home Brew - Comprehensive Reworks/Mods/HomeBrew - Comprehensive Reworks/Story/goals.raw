		DB_GLO_Spells_Portent_Challenges("DIVINATION_SCHOOL_ABJURATION");
		DB_GLO_Spells_Portent_Challenges("DIVINATION_SCHOOL_CONJURATION");
		DB_GLO_Spells_Portent_Challenges("DIVINATION_SCHOOL_DIVINATION");
