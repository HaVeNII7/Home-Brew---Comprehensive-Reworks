		DB_TWN_MarchingArmy_CrowdTriggers((TRIGGER)S_MarchingArmyCrowd_022_b309b78d-26dc-47d1-b867-8b2132701622);
		DB_TWN_MarchingArmy_CrowdTriggers((TRIGGER)S_MarchingArmyCrowd_023_8524358e-e664-4a40-a695-8a00ed14f3df);
		DB_TWN_MarchingArmy_CrowdTriggers((TRIGGER)S_MarchingArmyCrowd_024_cc67c952-efb1-44e0-92cc-1bad0848a60f);
		DB_TWN_MarchingArmy_CrowdTriggers((TRIGGER)S_MarchingArmyCrowd_025_03bf3bc0-fb77-4afe-9197-a5bb9d9644f8);
		DB_TWN_MarchingArmy_CrowdTriggers((TRIGGER)S_MarchingArmyCrowd_027_e6cca9aa-575d-45b2-b007-5048660ecc19);
		DB_TWN_MarchingArmy_CrowdTriggers((TRIGGER)S_MarchingArmyCrowd_028_08daca52-45b0-426e-af84-ee6312809837);
		DB_TWN_MarchingArmy_CrowdTriggers((TRIGGER)S_MarchingArmyCrowd_029_6b493556-f8d3-4e5d-ac48-7cc0624b14fe);
		DB_TWN_MarchingArmy_CrowdTriggers((TRIGGER)S_MarchingArmyCrowd_030_b43dd9d1-8f1d-4760-9048-b74bb0f22b05);
		DB_TWN_MarchingArmy_CrowdTriggers((TRIGGER)S_MarchingArmyCrowd_031_de8763e2-b381-4961-84ab-c5a535e08ad3);
		DB_TWN_MarchingArmy_CrowdTriggers((TRIGGER)S_MarchingArmyCrowd_032_f07c2d88-1ca2-45fd-8484-1f9cec5c553d);
		DB_TWN_MarchingArmy_CrowdTriggers((TRIGGER)S_MarchingArmyCrowd_033_561f8cbb-489a-4a6f-a4d5-6844e793ef15);
		DB_TWN_MarchingArmy_CrowdTriggers((TRIGGER)S_MarchingArmyCrowd_034_c49c653f-5568-462f-949a-6beb7f891e8d);
		DB_TWN_MarchingArmy_CrowdTriggers((TRIGGER)S_MarchingArmyCrowd_035_106caadc-b24f-4d51-a974-73c13cf40bea);
	}
	KB
	{
		//REGION Debug
		IF
		TextEvent("twn_armyleft")
		THEN
		PROC_TWN_MarchingArmy_ArmyLeft();
		//END_REGION
		
		//REGION Arrest
		IF
		DB_TWN_MarchingArmy_PrisonTrigger(_PrisonTrigger)
		THEN
		PROC_TriggerRegisterForPlayers(_PrisonTrigger);
		
		IF
		EnteredTrigger(_Player, S_TWN_MarchingArmy_ArrestTrigger_f17b1dd9-746f-48a5-8864-eb41f8c3f58f)
		AND
		DB_Players(_Player)
		THEN
		PROC_TWN_MarchingArmy_StartArrestDialog(_Player);
		
		PROC
		PROC_TWN_MarchingArmy_StartArrestDialog((CHARACTER)_Player)
		AND
		NOT QRY_TWN_MarchingArmy_TryStartArrestDialog(_Player)
		THEN
		DB_TWN_MarchingArmy_MainCriminal((CHARACTER)_Player);
		PROC_TWN_MarchingArmy_PrepareCriminals(_Player);
		PROC_TWN_MarchingArmy_TeleportAllCriminalsToPrison(_Player);
		
		QRY
		QRY_TWN_MarchingArmy_TryStartArrestDialog((CHARACTER)_Player)
		AND
		QRY_StartDialog(TWN_MarchingArmy_Arrest_17c8a1e6-2855-601f-1dfd-535352e93fd4, _Player)
		AND
		DB_DialogRequestCache_SpeakerList_Players((DIALOGRESOURCE)TWN_MarchingArmy_Arrest_17c8a1e6-2855-601f-1dfd-535352e93fd4, _, _MainPlayerSpeaker, 1) // Player speaker might be different to _Player.
		THEN
		DB_TWN_MarchingArmy_MainCriminal((CHARACTER)_MainPlayerSpeaker);
		
		// dialog success & player backed off - teleport away
		IF
		DialogEnded(TWN_MarchingArmy_Arrest_17c8a1e6-2855-601f-1dfd-535352e93fd4, _ID)
		AND
		DB_TWN_MarchingArmy_MainCriminal(_Player)
		AND
		DB_DialogPlayers(_ID, _Player, _)
		AND
		GetFlag(TWN_MarchingArmy_Event_BackedOff_7cdfe338-196e-4e9d-88b0-901684611175, _Player, 1)
		THEN
		PROC_TWN_MarchingArmy_PrepareCriminals(_Player);
		PROC_TWN_MarchingArmy_TeleportCriminalsAway(_Player);
		
		IF
		DialogEnded(TWN_MarchingArmy_Arrest_17c8a1e6-2855-601f-1dfd-535352e93fd4, _ID)
		AND
		DB_TWN_MarchingArmy_MainCriminal(_Player)
		AND
		DB_DialogPlayers(_ID, _Player, _)
		AND
		GetFlag(TWN_MarchingArmy_Event_BackedOff_7cdfe338-196e-4e9d-88b0-901684611175, _Player, 0)
		THEN
		PROC_TWN_MarchingArmy_PrepareCriminals(_Player);
		PROC_TWN_MarchingArmy_TeleportAllCriminalsToPrison(_Player);
		
		PROC
		PROC_TWN_MarchingArmy_PrepareCriminals((CHARACTER)_MainCriminal)
		AND
		DB_Players(_OtherCriminal) // including the main criminal (original _Player)
		AND
		IsInPartyWith(_OtherCriminal, _MainCriminal, 1)
		AND
		InSamePartyGroup(_OtherCriminal, _MainCriminal, 1)
		THEN
		DB_TWN_MarchingArmy_Criminals((CHARACTER)_MainCriminal, (CHARACTER)_OtherCriminal); // need a separate DB. Teleporting the first criminal in prison unlinks him from the group
		
		PROC
		PROC_TWN_MarchingArmy_TeleportCriminalsAway((CHARACTER)_MainCriminal)
		AND
		DB_TWN_MarchingArmy_Criminals(_MainCriminal, _OtherCriminal)
		THEN
		PROC_ForceStopDialog(_OtherCriminal);
		TeleportTo(_OtherCriminal, S_TWN_MarchingArmy_OutTrigger_8125fba4-005f-4096-8fe8-eb4f25e086fd, "", 0);
		ClearFlag(TWN_MarchingArmy_Event_BackedOff_7cdfe338-196e-4e9d-88b0-901684611175, _MainCriminal);
		NOT DB_TWN_MarchingArmy_MainCriminal(_MainCriminal);
		
		PROC
		PROC_TWN_MarchingArmy_TeleportAllCriminalsToPrison((CHARACTER)_MainCriminal)
		AND
		DB_TWN_MarchingArmy_Criminals(_MainCriminal, _OtherCriminal)
		THEN
		PROC_ForceStopDialog(_OtherCriminal);
		PROC_TWN_MarchingArmy_TeleportCriminalToPrison((CHARACTER)_OtherCriminal);
		
		PROC
		PROC_TWN_MarchingArmy_TeleportAllCriminalsToPrison((CHARACTER)_MainCriminal)
		AND
		NOT QRY_TWN_MarchingArmy_PrisonCellShouldBeUsed()
		AND
		NOT QRY_OncePerUserAndNearbyPlayers_IsSet(_MainCriminal, "MOO_Oubliette_Entry_Once")
		THEN
		DB_TWN_MarchinArmy_SkipVB(1); // first time we enter Oubliette/Corpse Pit there is a voice bark about it triggered in another place, so we skip ours
		
		PROC
		PROC_TWN_MarchingArmy_TeleportCriminalToPrison((CHARACTER)_Criminal)
		AND
		NOT QRY_TWN_MarchingArmy_PrisonCellShouldBeUsed()
		THEN
		TeleportTo(_Criminal, S_TWN_MarchingArmy_CorpsePit_9c8e91a2-bf0a-47e6-a38b-d331baa5413f, "", 0);
		
		PROC
		PROC_TWN_MarchingArmy_TeleportCriminalToPrison((CHARACTER)_Criminal)
		AND
		QRY_TWN_MarchingArmy_PrisonCellShouldBeUsed()
		AND
		DB_RegionPrison("SCL_Main_A_MOO", _PrisonCell, _PrisonSpawnPoint)
		AND
		DB_PlayerPrison(_PrisonTrigger, _, _, _FugitiveStatus)
		THEN
		PROC_CrimeTeleportCharacterToPrison(S_MOO_PrisonWarden_66b3e4c0-2f82-4c0a-9333-73a5194f88c7, _Criminal, _PrisonCell, _PrisonSpawnPoint, _FugitiveStatus);
		
		QRY
		QRY_TWN_MarchingArmy_PrisonCellShouldBeUsed()
		AND
		NOT DB_GlobalFlag(MOO_Jailbreak_State_TunnelPathOpen_ef0aa614-2a18-7bd1-0f79-c3aca59ec3ab)
		AND
		NOT DB_GlobalFlag(MOO_Jailbreak_State_GuardsCleanedOut_d7ca2c67-8eb1-db4d-a16c-2bc3c17deeb7)
		THEN
		DB_NOOP(1);
		
		IF
		EnteredTrigger(_Player, _PrisonTrigger)
		AND
		DB_TWN_MarchingArmy_PrisonTrigger(_PrisonTrigger)
		AND
		DB_TWN_MarchingArmy_Criminals(_MainCriminal, _Player)
		AND
		Random(4000, _Rand)
		AND
		IntegerSum(_Rand, 1000, _GetUpTimer)
		THEN
		NOT DB_TWN_MarchingArmy_Criminals(_MainCriminal, _Player);
		ApplyStatus(_Player, "KNOCKED_DOWN", 6.0, 1);
		RealtimeObjectTimerLaunch(_Player, "TWN_MarchingArmy_AfterCaptured", _GetUpTimer);
		
		IF
		ObjectTimerFinished(_Player, "TWN_MarchingArmy_AfterCaptured")
		THEN
		RemoveStatus(_Player, "KNOCKED_DOWN");
		
		IF
		ObjectTimerFinished((CHARACTER)_Player, "TWN_MarchingArmy_AfterCaptured")
		AND
		DB_TWN_MarchingArmy_MainCriminal(_Player)
		AND
		NOT DB_TWN_MarchinArmy_SkipVB(1)
		AND
		QRY_OncePerUserAndNearbyPlayers(_Player, "TWN_MarchingArmy_CommentOnBeingImprisoned")
		THEN
		StartVoiceBark(TWN_MarchingArmy_VB_Arrested_86eaddd7-ba96-390a-529b-7ec482acd2df, _Player);
		
		IF
		ObjectTimerFinished((CHARACTER)_Player, "TWN_MarchingArmy_AfterCaptured")
		AND
		DB_TWN_MarchingArmy_MainCriminal(_Player)
		THEN
		NOT DB_TWN_MarchingArmy_MainCriminal(_Player);
		
		IF
		ObjectTimerFinished((CHARACTER)_Player, "TWN_MarchingArmy_AfterCaptured")
		AND
		DB_TWN_MarchinArmy_SkipVB(1)
		THEN
		NOT DB_TWN_MarchinArmy_SkipVB(1);
		//END_REGION Arrest
		
		//REGION Army Leaving
		PROC
		PROC_TWN_MarchingArmy_RemoveArmyArrest()
		THEN
		PROC_TriggerUnregisterForPlayers(S_TWN_MarchingArmy_ArrestTrigger_f17b1dd9-746f-48a5-8864-eb41f8c3f58f);
		SetOnStage((ITEM)S_TWN_ActExit_4df293a7-c9b7-4be4-b4a9-42400ddbe209, 1);
		
		PROC
		PROC_TWN_MarchingArmy_ArmyLeft()
		AND
		QRY_OnlyOnce("TWN_MarchingArmy_ArmyLeft")
		THEN
		PROC_TWN_MarchingArmy_ClearCrowds();
		PROC_TWN_MarchingArmy_RemoveArmyArrest();
		PROC_RemoveOneShotVoiceBarkTrigger((TRIGGER)S_TWN_MarchingArmy_VistaTrigger_001_cf53f301-bfc5-4d22-a937-6cf8aea0c4bc, TWN_MarchingArmy_VB_Warning_5bb3c3da-9df8-bed8-89c3-c4356441cce0);
		PROC_RemoveOneShotVoiceBarkTrigger((TRIGGER)S_TWN_MarchingArmy_VistaTrigger_002_2c10b3b5-2cf4-4511-916b-099ba981eb6a, TWN_MarchingArmy_VB_Warning_5bb3c3da-9df8-bed8-89c3-c4356441cce0);
		DB_OneShot_VoiceBarkTrigger((TRIGGER)S_TWN_MarchingArmy_VistaTrigger_001_cf53f301-bfc5-4d22-a937-6cf8aea0c4bc, (VOICEBARKRESOURCE)TWN_Finale_VB_ArmyLeft_bfecfa02-68f9-269c-ed3a-8a9f46866cff, "PerUserAndNearbyPlayers");
		DB_OneShot_VoiceBarkTrigger((TRIGGER)S_TWN_MarchingArmy_VistaTrigger_002_2c10b3b5-2cf4-4511-916b-099ba981eb6a, (VOICEBARKRESOURCE)TWN_Finale_VB_ArmyLeft_bfecfa02-68f9-269c-ed3a-8a9f46866cff, "PerUserAndNearbyPlayers");
		UnloadLevelTemplate(LT_SCL_ArmyCamp_A_000_0a7ec39f-1826-4d10-b727-a068527d9aef);
		LoadLevelTemplate(LT_SCL_ArmyCampEmpty_6c2a7425-066a-4577-9068-25383a1da221);
		
		PROC
		PROC_TWN_MarchingArmy_ClearCrowds()
		AND
		DB_TWN_MarchingArmy_CrowdTriggers(_Trigger)
		THEN
		TriggerSetCrowdSpawningEnable(_Trigger, 0);
		TriggerDespawnCrowd(_Trigger);
		NOT DB_TWN_MarchingArmy_CrowdTriggers(_Trigger);
		//END_REGION
		
		//REGION Debug
		IF
		TextEvent("ma_towyr")
		THEN
		PROC_TeleportPartiesTo(S_WYR_Start_9e9d2c52-d0d6-4024-bca9-bd5afd92c611, "");
		
		IF
		TextEvent("ma_topit")
		AND
		GetHostCharacter(_Player)
		THEN
		TeleportTo(_Player, S_TWN_MarchingArmy_CorpsePit_9c8e91a2-bf0a-47e6-a38b-d331baa5413f, "", 0);
		//END_REGION Debug
	}
	EXIT
	{
	}
}
Goal(472).Title("Act2_TWN_MasonsGuild");
Goal(472)
{
	INIT
	{
		DB_ItemDialog_NarratorAD((ITEM)S_TWN_MasonsGuild_MasonPlaque_fc0b2ed9-d912-4717-9b93-132ccda2f9e1, (DIALOGRESOURCE)TWN_MasonsGuild_AD_MasonPlaque_8e31c2a9-3ff9-1e26-2792-105405ef9601);
		
		DB_GLO_MovingObject((ITEM)S_TWN_MasonsGuild_TrapWall_d5d0851a-8a0a-4194-b5fb-2be3255dd1e3, "TWN_MasonsGuild_TrapWall_Move", (TRIGGER)S_TWN_MasonsGuild_TrapWall_DefaultPos_e90d9140-f629-4fbe-8477-a941b9dcc871, (TRIGGER)S_TWN_MasonsGuild_TrapWall_NewPos_ce1860df-bf36-4b80-8076-d3668886b4d0, 2.0, 0.0, 0, "TWN_MasonsGuild_TrapWall_Moved", 0);
		DB_GLO_MovingObject((ITEM)S_TWN_MasonsGuild_Blocker_001_3509e836-cf2c-4df5-9665-16ad6ca9fa46, "TWN_MasonsGuild_Blocker_Move", (TRIGGER)S_TWN_MasonsGuild_Blocker_001_DefaultPos_521187e4-ec42-4424-916c-023d50fa394c, (TRIGGER)S_TWN_MasonsGuild_Blocker_001_NewPos_fa00437a-6398-44c3-a2b0-9189499bbf04, 12.0, 0.0, 0, "TWN_MasonsGuild_Blocker_001_Moved", 0);
		DB_GLO_MovingObject((ITEM)S_TWN_MasonsGuild_Blocker_002_b6829a21-9e2e-47af-996b-5c2ba61ebfb8, "TWN_MasonsGuild_Blocker_Move", (TRIGGER)S_TWN_MasonsGuild_Blocker_002_DefaultPos_394e4231-011c-42d3-ad87-376812134873, (TRIGGER)S_TWN_MasonsGuild_Blocker_002_NewPos_de4d31eb-dc63-4c63-ab12-f84d88be58f3, 12.0, 0.0, 0, "TWN_MasonsGuild_Blocker_002_Moved", 0);
		
		DB_TWN_MasonsGuild_DamageDealers((ITEM)S_TWN_MasonsGuild_DamageDealer_000_e7053ba8-8f50-4214-b908-728d04349a02);
		DB_TWN_MasonsGuild_DamageDealers((ITEM)S_TWN_MasonsGuild_DamageDealer_001_04ec4d69-ede3-42ec-8175-7db4a9a18e58);
		DB_TWN_MasonsGuild_DamageDealers((ITEM)S_TWN_MasonsGuild_DamageDealer_002_3b25a38d-e864-4b2d-91c6-44de662701fd);
		
		DB_TWN_MasonsGuild_Gratings((ITEM)S_TWN_MasonsGuild_Blocker_001_3509e836-cf2c-4df5-9665-16ad6ca9fa46, (TRIGGER)S_TWN_MasonsGuild_Blocker_001_Area_e5345ea2-96a0-4da9-a903-5079d3886af3, S_TWN_MasonsGuild_Blocker_001_Helper_b2c7eee8-5ab1-41a1-86b4-bbadb8b8b808);
		DB_TWN_MasonsGuild_Gratings((ITEM)S_TWN_MasonsGuild_Blocker_002_b6829a21-9e2e-47af-996b-5c2ba61ebfb8, (TRIGGER)S_TWN_MasonsGuild_Blocker_002_Area_07bdd194-5774-47fa-a992-e41d8b2b4baf, S_TWN_MasonsGuild_Blocker_002_Helper_53bd1f5f-312a-4740-ac2e-66ede13dac36);
		
		PROC_TriggerRegisterForParty((TRIGGER)S_TWN_MasonsGuild_TrapArea_5691684e-407b-4898-9412-fefc5d57b273);
		
		// Characters and Items in this area are pushed by the trap away, to avoid them being stuck inside a part of the trap (sliding wall, sliding grating)
		DB_TWN_MasonsGuild_PushObjectsAreas((TRIGGER)S_TWN_MasonsGuild_Blocker_001_Area_e5345ea2-96a0-4da9-a903-5079d3886af3);
		DB_TWN_MasonsGuild_PushObjectsAreas((TRIGGER)S_TWN_MasonsGuild_Blocker_002_Area_07bdd194-5774-47fa-a992-e41d8b2b4baf);
		DB_TWN_MasonsGuild_PushObjectsAreas((TRIGGER)S_TWN_MasonsGuild_TrapWall_ProblemArea_8bda35b1-1c4c-446b-8e9c-9fa31cc30fe0);
		
		// Trap States
		DB_GLO_ExclusiveFlag("TWN_MasonsGuild_TrapState", (FLAG)TWN_MasonsGuild_Trap_State_Deactivated_8348a548-b0ce-4ecb-aa6a-a9f762bf6b7c);
		DB_GLO_ExclusiveFlag("TWN_MasonsGuild_TrapState", (FLAG)TWN_MasonsGuild_Trap_State_Activating_ccee51cd-05b8-4881-8347-6179803eb8c2);
		DB_GLO_ExclusiveFlag("TWN_MasonsGuild_TrapState", (FLAG)TWN_MasonsGuild_Trap_State_Activated_7197cc96-d0d5-4866-b148-fc49db58e717);
		DB_GLO_ExclusiveFlag("TWN_MasonsGuild_TrapState", (FLAG)TWN_MasonsGuild_Trap_State_Deactivating_cb3e78be-5fd9-42f1-a667-872463fc4605);
		PROC_GlobalSetFlagAndCache(TWN_MasonsGuild_Trap_State_Deactivated_8348a548-b0ce-4ecb-aa6a-a9f762bf6b7c);
		
		DB_TWN_MasonsGuild_Trap_MaxShots(5);
		
		DB_ItemDialog_NarratorAD((ITEM)S_TWN_Masonry_FakeMasonBones_b02a9ee9-19c4-4fe3-961d-01cf6450cb4f,(DIALOGRESOURCE)TWN_MasonGuild_AD_FakeMasonBones_269356a9-32ee-dc30-68bd-968b3d77feed);
		
		DB_ItemDialog_NarratorAD((ITEM)S_TWN_MasonApprentice_02_e34c404d-b237-4706-b39c-402e8ecca229,(DIALOGRESOURCE)TWN_Masonry_AD_MasonApprentice_01_25d2c4df-a3a6-1847-77c1-469ae57ac5a6);
	}
	KB
	{
		//REGION Debug
		IF
		TextEvent("mg_gr1")
		THEN
		SetEntityEvent(S_TWN_MasonsGuild_Blocker_001_Helper_b2c7eee8-5ab1-41a1-86b4-bbadb8b8b808, "TWN_MasonsGuild_Push");
		
		IF
		TextEvent("mg_gr2")
		THEN
		SetEntityEvent(S_TWN_MasonsGuild_Blocker_002_Helper_53bd1f5f-312a-4740-ac2e-66ede13dac36, "TWN_MasonsGuild_Push");
		
		IF
		TextEvent("mg_sw")
		THEN
		SetEntityEvent(S_TWN_MasonsGuild_TrapWall_Helper_fe8a3c9b-e213-416e-aafe-70cf13ea432e, "TWN_MasonsGuild_Push");
		
		IF
		TextEvent("mg_sw_on")
		THEN
		PROC_SetOnStage(S_TWN_MasonsGuild_TrapWall_d5d0851a-8a0a-4194-b5fb-2be3255dd1e3, 1);
		
		IF
		TextEvent("mg_sw_off")
		THEN
		PROC_SetOnStage(S_TWN_MasonsGuild_TrapWall_d5d0851a-8a0a-4194-b5fb-2be3255dd1e3, 0);
		
		IF
		TextEvent("mg_push")
		THEN
		PROC_TWN_MasonsGuild_CheckMoveObjectsOut((TRIGGER)S_TWN_MasonsGuild_TrapWall_ProblemArea_8bda35b1-1c4c-446b-8e9c-9fa31cc30fe0);
		PROC_TWN_MasonsGuild_CheckMoveObjectsOut((TRIGGER)S_TWN_MasonsGuild_Blocker_001_Area_e5345ea2-96a0-4da9-a903-5079d3886af3);
		PROC_TWN_MasonsGuild_CheckMoveObjectsOut((TRIGGER)S_TWN_MasonsGuild_Blocker_002_Area_07bdd194-5774-47fa-a992-e41d8b2b4baf);
		
		IF
		TextEvent("explodetrap")
		AND
		DB_TWN_MasonsGuild_Gratings(_Blocker, _BlockerArea, _BlockerHelper)
		AND
		DB_Players(_Player)
		AND
		IsInTrigger(_Player, _BlockerArea, 1)
		THEN
		CreateExplosion(_Player, "Projectile_TWN_MasonsGuild_Grating", -1, _BlockerHelper);
		
		IF
		TextEvent("mg_activatetrap")
		AND
		GetHostCharacter(_Player)
		THEN
		PROC_TWN_MasonsGuild_BaitTrap_Activate(_Player);
		
		IF
		TextEvent("mg_deactivatetrap")
		THEN
		PROC_TWN_MasonsGuild_BaitTrap_Deactivate();
		
		IF
		TextEvent("mg_basement")
		THEN
		PROC_TeleportPartiesTo(S_Debug_TWN_MasonsGuild_Basement_81854678-2b13-4287-99c3-3a7432308173, "");
		
		IF
		TextEvent("mg_oopen")
		THEN
		Open((ITEM)S_TWN_MasonsGuild_OuterSlidingWall_d6a70398-f14f-4462-be77-06a4a02a3b38);
		
		IF
		TextEvent("mg_oclose")
		THEN
		Close((ITEM)S_TWN_MasonsGuild_OuterSlidingWall_d6a70398-f14f-4462-be77-06a4a02a3b38);
		
		IF
		TextEvent("mg_iopen")
		THEN
		Open((ITEM)S_TWN_MasonsGuild_InnerSlidingWall_405982d4-e4b2-4181-a21a-eb748b32e1d2);
		
		IF
		TextEvent("mg_iclose")
		THEN
		Close((ITEM)S_TWN_MasonsGuild_InnerSlidingWall_405982d4-e4b2-4181-a21a-eb748b32e1d2);
		//END_REGION Debug
		
		//REGION Trap Init
		IF
		DB_TWN_MasonsGuild_Gratings(_Blocker, _BlockerArea, _)
		THEN
		TriggerRegisterForItems(_BlockerArea);
		//END_REGION Trap Init
		
		//REGION Outer Sliding Wall
		// if the player somehow got behind the wall without unlocking the area first then
		// we open the door from the within and unlock the heraldic stone which serves as a button
		IF
		UseStarted(_Player, S_TWN_MasonsGuild_OuterSlidingWallBackupLever_0c144415-8ad1-4ec6-96f0-9e1245da757b)
		AND
		IsLocked(S_TWN_MasonsGuild_OuterSlidingWallActivator_9b41b366-52ca-4812-8d23-18b407334b2f, 1)
		THEN
		DB_PerceptionSkillCheckADBlocked(S_TWN_MasonsGuild_OuterSlidingWallActivator_9b41b366-52ca-4812-8d23-18b407334b2f);
		SetEntityEvent(S_TWN_MasonsGuild_OuterSlidingWallActivator_9b41b366-52ca-4812-8d23-18b407334b2f, "StoryReveal");
		Unlock((ITEM)S_TWN_MasonsGuild_OuterSlidingWallActivator_9b41b366-52ca-4812-8d23-18b407334b2f);
		PROC_TWN_MasonsGuild_ActivateOuterSlidingWall();
		
		IF
		Unlocked((ITEM)S_TWN_MasonsGuild_OuterSlidingWallActivator_9b41b366-52ca-4812-8d23-18b407334b2f, _, _)
		THEN
		PROC_TWN_MasonsGuild_ActivateOuterSlidingWall();
		
		PROC
		PROC_TWN_MasonsGuild_ActivateOuterSlidingWall()
		AND
		QRY_OnlyOnce("TWN_MasonsGuild_ActivateOuterSlidingWall")
		THEN
		PROC_TWN_MasonsGuild_OpenCloseSlidingWall((ITEM)S_TWN_MasonsGuild_OuterSlidingWall_d6a70398-f14f-4462-be77-06a4a02a3b38);
		
		IF
		DualEntityEvent(_, (ITEM)_SlidingWall, "TWN_MasonsGuild_OuterSlidingWall_Move")
		THEN
		PROC_TWN_MasonsGuild_OpenCloseSlidingWall((ITEM)S_TWN_MasonsGuild_OuterSlidingWall_d6a70398-f14f-4462-be77-06a4a02a3b38);
		//END_REGION Outer Sliding Wall
		
		//REGION Secret Region for the storage in the masons lair
		IF
		DualEntityEvent(_, (ITEM)_SlidingWall, "TWN_MasonsGuild_InnerSlidingWall_Move")
		THEN
		PROC_TWN_MasonsGuild_OpenCloseSlidingWall((ITEM)S_TWN_MasonsGuild_InnerSlidingWall_405982d4-e4b2-4181-a21a-eb748b32e1d2);
		
		PROC
		PROC_TWN_MasonsGuild_OpenCloseSlidingWall((ITEM)_SlidingWall)
		AND
		QRY_TWN_MasonsGuild_SlidingWallIsNotMoving(_SlidingWall)
		AND
		IsClosed((ITEM)_SlidingWall, 1)
		THEN
		Open((ITEM)_SlidingWall);
		
		PROC
		PROC_TWN_MasonsGuild_OpenCloseSlidingWall((ITEM)_SlidingWall)
		AND
		QRY_TWN_MasonsGuild_SlidingWallIsNotMoving(_SlidingWall)
		AND
		IsOpened((ITEM)_SlidingWall, 1)
		THEN
		Close((ITEM)_SlidingWall);
		
		QRY
		QRY_TWN_MasonsGuild_SlidingWallIsNotMoving((ITEM)_SlidingWall)
		AND
		IsClosing(_SlidingWall, 0)
		AND
		IsOpening(_SlidingWall, 0)
		THEN
		DB_NOOP(1);
		//END_REGION Secret Region for the storage in the masons lair
		
		//REGION Bait Trap
		IF
		DB_TWN_MasonsGuild_PushObjectsAreas(_Trigger)
		THEN
		TriggerRegisterForItems(_Trigger);
		PROC_TriggerRegisterForParty(_Trigger);
		
		IF
		EnteredTrigger(_PartyMember, _Trigger)
		AND
		DB_TWN_MasonsGuild_PushObjectsAreas(_Trigger)
		THEN
		SetTag(_PartyMember, (TAG)ACT2_TWN_MASONSGUILD_VALIDTRAPTARGET_dda79ecf-88ae-4ac7-a714-1530e395783c);
		DB_TWN_MasonsGuild_PushableObjects((TRIGGER)_Trigger, (GUIDSTRING)_PartyMember);
		
		IF
		LeftTrigger(_PartyMember, _Trigger)
		AND
		DB_TWN_MasonsGuild_PushObjectsAreas(_Trigger)
		AND
		Exists(_PartyMember,1)
		THEN
		ClearTag(_PartyMember, (TAG)ACT2_TWN_MASONSGUILD_VALIDTRAPTARGET_dda79ecf-88ae-4ac7-a714-1530e395783c);
		
		IF
		LeftTrigger(_PartyMember, _Trigger)
		AND
		DB_TWN_MasonsGuild_PushObjectsAreas(_Trigger)
		THEN
		NOT DB_TWN_MasonsGuild_PushableObjects((TRIGGER)_Trigger, (GUIDSTRING)_PartyMember);
		
		IF
		ItemEnteredTrigger(_Item, _Trigger, _)
		AND
		DB_TWN_MasonsGuild_PushObjectsAreas(_Trigger)
		AND
		NOT DB_TWN_MasonsGuild_Gratings(_Item, _, _)
		AND
		NOT DB_TWN_MasonsGuild_DamageDealers(_Item)
		AND
		_Item != S_TWN_MasonsGuild_TrapWall_d5d0851a-8a0a-4194-b5fb-2be3255dd1e3
		AND
		Exists(_Item,1)
		THEN
		SetTag(_Item, (TAG)ACT2_TWN_MASONSGUILD_VALIDTRAPTARGET_dda79ecf-88ae-4ac7-a714-1530e395783c);
		DB_TWN_MasonsGuild_PushableObjects((TRIGGER)_Trigger, (GUIDSTRING)_Item);
		
		IF
		ItemLeftTrigger(_Item, _Trigger, _)
		AND
		DB_TWN_MasonsGuild_PushObjectsAreas(_Trigger)
		AND
		NOT DB_TWN_MasonsGuild_Gratings(_Item, _, _)
		AND
		NOT DB_TWN_MasonsGuild_DamageDealers(_Item)
		AND
		_Item != S_TWN_MasonsGuild_TrapWall_d5d0851a-8a0a-4194-b5fb-2be3255dd1e3
		THEN
		PROC_TWN_MasonsGuild_RemovePushableObject(_Item);
		
		PROC
		PROC_TWN_MasonsGuild_RemovePushableObject((ITEM)_Item)
		AND
		Exists(_Item,1)
		THEN
		ClearTag(_Item, (TAG)ACT2_TWN_MASONSGUILD_VALIDTRAPTARGET_dda79ecf-88ae-4ac7-a714-1530e395783c);
		
		PROC
		PROC_TWN_MasonsGuild_RemovePushableObject((ITEM)_Item)
		AND
		DB_TWN_MasonsGuild_PushableObjects((TRIGGER)_Trigger, (GUIDSTRING)_Item)
		THEN
		NOT DB_TWN_MasonsGuild_PushableObjects((TRIGGER)_Trigger, (GUIDSTRING)_Item);
		
		IF
		DualEntityEvent((CHARACTER)_Character, S_TWN_MasonsGuild_Bait_60017535-5852-4122-9f55-7416d6c60f28, "TWN_MasonsGuild_TrappedChestUsed")
		AND
		DB_PartyMembers(_Character)
		AND
		QRY_CharacterGetOwnerOrSelf(_Character)
		AND
		DB_QRYRTN_CharacterGetOwnerOrSelf(_OwnerOrSelf)
		THEN
		PROC_TWN_MasonsGuild_BaitTrap_Activate(_OwnerOrSelf);
		
		IF 
		DestroyedBy((ITEM)S_TWN_MasonsGuild_Bait_60017535-5852-4122-9f55-7416d6c60f28, _, _Owner, _)
		AND
		IsInTrigger(S_TWN_MasonsGuild_Bait_60017535-5852-4122-9f55-7416d6c60f28, (TRIGGER)S_TWN_MasonsGuild_TrapArea_5691684e-407b-4898-9412-fefc5d57b273, 1)
		THEN
		PROC_TWN_MasonsGuild_BaitTrap_Activate(_Owner);
		
		// "Throw" and "Use as Improvised Weapon(melee)" actions
		// don't generate PreMovedBy and MovedBy events
		IF 
		Moved(S_TWN_MasonsGuild_Bait_60017535-5852-4122-9f55-7416d6c60f28)
		AND
		GetClosestPlayer(S_TWN_MasonsGuild_Bait_60017535-5852-4122-9f55-7416d6c60f28, _Character, _)
		THEN
		PROC_TWN_MasonsGuild_BaitTrap_Activate(_Character);
		
		IF 
		PreMovedBy(S_TWN_MasonsGuild_Bait_60017535-5852-4122-9f55-7416d6c60f28, _Character)
		AND
		IsInTrigger(S_TWN_MasonsGuild_Bait_60017535-5852-4122-9f55-7416d6c60f28, (TRIGGER)S_TWN_MasonsGuild_TrapArea_5691684e-407b-4898-9412-fefc5d57b273, 1)
		THEN
		PROC_TWN_MasonsGuild_BaitTrap_Activate(_Character);
		
		IF
		AddedTo((ITEM)S_TWN_MasonsGuild_Bait_60017535-5852-4122-9f55-7416d6c60f28, (CHARACTER)_Character, _)
		AND
		IsInTrigger(S_TWN_MasonsGuild_Bait_60017535-5852-4122-9f55-7416d6c60f28, (TRIGGER)S_TWN_MasonsGuild_TrapArea_5691684e-407b-4898-9412-fefc5d57b273, 1)
		THEN
		PROC_TWN_MasonsGuild_BaitTrap_Activate(_Character);
		
		PROC
		PROC_TWN_MasonsGuild_BaitTrap_Activate((CHARACTER)_Player)
		AND
		DB_GlobalFlag((FLAG)TWN_MasonsGuild_Trap_State_Deactivated_8348a548-b0ce-4ecb-aa6a-a9f762bf6b7c)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)TWN_MasonsGuild_Trap_State_Activating_ccee51cd-05b8-4881-8347-6179803eb8c2);
		DB_DangerZone((TRIGGER)S_TWN_MasonsGuild_TrapArea_5691684e-407b-4898-9412-fefc5d57b273, "TWN_MasonsGuild_TrapArea");
		DB_TWN_MasonsGuild_BaitTrap_Victim(_Player);
		PROC_TWN_MasonsGuild_BaitTrap_ActivateGratings();
		ObjectTimerLaunch(S_TWN_MasonsGuild_TrapWall_d5d0851a-8a0a-4194-b5fb-2be3255dd1e3, "TWN_MasonsGuild_TrapWallMove", 1000);
		
		// both gratings destroyed - activate the trap wall immediately
		PROC
		PROC_TWN_MasonsGuild_BaitTrap_ActivateGratings()
		AND
		DB_TWN_MasonsGuild_Gratings(_Grating, _, _)
		AND
		NOT DB_PermaDefeated(_Grating)
		THEN
		PROC_GLO_MovingObject_Move(_Grating);
		SetCanInteract(_Grating, 1);
		
		PROC
		PROC_TWN_MasonsGuild_BaitTrap_ActivateGratings()
		AND
		DB_TWN_MasonsGuild_Gratings(_Grating, _GratingArea, _GratingHelper)
		AND
		NOT DB_PermaDefeated(_Grating)
		THEN
		SetEntityEvent(_GratingHelper, "TWN_MasonsGuild_Push");
		
		IF
		ObjectTimerFinished(S_TWN_MasonsGuild_TrapWall_d5d0851a-8a0a-4194-b5fb-2be3255dd1e3, "TWN_MasonsGuild_TrapWallMove")
		THEN
		PROC_GLO_MovingObject_Move(S_TWN_MasonsGuild_TrapWall_d5d0851a-8a0a-4194-b5fb-2be3255dd1e3);
		
		PROC
		PROC_GLO_MovingObject_FinishedMovement(S_TWN_MasonsGuild_TrapWall_d5d0851a-8a0a-4194-b5fb-2be3255dd1e3, _, (TRIGGER)S_TWN_MasonsGuild_TrapWall_NewPos_ce1860df-bf36-4b80-8076-d3668886b4d0, _)
		THEN
		PROC_TWN_MasonsGuild_BaitTrap_ActivateDamageDealers();
		
		PROC
		PROC_TWN_MasonsGuild_BaitTrap_ActivateDamageDealers()
		AND
		DB_TWN_MasonsGuild_DamageDealers(_DamageDealer)
		AND
		NOT DB_PermaDefeated(_DamageDealer)
		THEN
		SetEntityEvent(_DamageDealer, "TWN_MasonsGuild_ActivateDamageDealer");
		PROC_LoopEffect(VFX_Script_UND_KathericCity_FireTrap_Large_Pilot_01_03983ec4-9cf0-3167-502a-9d7929c865c1, _DamageDealer, "TWN_MasonsGuild_DamageDealerFireVFX", "SCL_Main_A", "");
		
		PROC
		PROC_GLO_MovingObject_FinishedMovement(S_TWN_MasonsGuild_TrapWall_d5d0851a-8a0a-4194-b5fb-2be3255dd1e3, _, (TRIGGER)S_TWN_MasonsGuild_TrapWall_NewPos_ce1860df-bf36-4b80-8076-d3668886b4d0, _)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)TWN_MasonsGuild_Trap_State_Activated_7197cc96-d0d5-4866-b148-fc49db58e717);
		
		PROC
		PROC_GLO_MovingObject_FinishedMovement(S_TWN_MasonsGuild_TrapWall_d5d0851a-8a0a-4194-b5fb-2be3255dd1e3, _, (TRIGGER)S_TWN_MasonsGuild_TrapWall_NewPos_ce1860df-bf36-4b80-8076-d3668886b4d0, _)
		AND
		DB_TWN_MasonsGuild_BaitTrap_Victim(_Player)
		AND
		QRY_TriggerEvents_AnyPartyMemberInTrigger((TRIGGER)S_TWN_MasonsGuild_TrapArea_5691684e-407b-4898-9412-fefc5d57b273)
		THEN
		ForceTurnBasedMode(_Player, 1);
		
		IF
		EntityEvent((ITEM)_DamageDealer, "TWN_MasonsGuild_ShotMade")
		AND
		DB_TWN_MasonsGuild_DamageDealers(_DamageDealer)
		AND
		DB_TWN_MasonsGuild_DamageDealersShots(_DamageDealer, _Shots)
		AND
		IntegerSum(_Shots, 1, _NewShots)
		THEN
		NOT DB_TWN_MasonsGuild_DamageDealersShots(_DamageDealer, _Shots);
		DB_TWN_MasonsGuild_DamageDealersShots(_DamageDealer, _NewShots);
		
		IF
		EntityEvent((ITEM)_DamageDealer, "TWN_MasonsGuild_ShotMade")
		AND
		DB_TWN_MasonsGuild_DamageDealers(_DamageDealer)
		AND
		NOT DB_TWN_MasonsGuild_DamageDealersShots(_DamageDealer, _)
		THEN
		DB_TWN_MasonsGuild_DamageDealersShots(_DamageDealer, 1);
		
		// as soon as 3 shots are made (or a damage dealer is destroyed) we check if we need to deactivate the trap
		// we only deactivate the trap if all the damage dealers either destroyed or made 3 shots
		IF
		DestroyedBy(_DamageDealer, _, _, _)
		AND
		DB_TWN_MasonsGuild_DamageDealers(_DamageDealer)
		THEN
		PROC_StopLoopEffect(_DamageDealer, "TWN_MasonsGuild_DamageDealerFireVFX");
		
		IF
		DestroyedBy(_DamageDealer, _, _, _)
		AND
		DB_TWN_MasonsGuild_DamageDealers(_DamageDealer)
		AND
		NOT QRY_TWN_MasonsGuild_HasActiveDamageDealers()
		THEN
		RealtimeObjectTimerLaunch(S_TWN_MasonsGuild_TrapWall_d5d0851a-8a0a-4194-b5fb-2be3255dd1e3, "TWN_MasonsGuild_BaitTrap_Deactivate", 1000);
		
		IF
		DB_TWN_MasonsGuild_DamageDealersShots(_DamageDealer, _ShotsMade)
		AND
		DB_TWN_MasonsGuild_Trap_MaxShots(_ShotsMade)
		AND
		NOT QRY_TWN_MasonsGuild_HasActiveDamageDealers()
		THEN
		RealtimeObjectTimerLaunch(S_TWN_MasonsGuild_TrapWall_d5d0851a-8a0a-4194-b5fb-2be3255dd1e3, "TWN_MasonsGuild_BaitTrap_Deactivate", 1000);
		
		QRY
		QRY_TWN_MasonsGuild_HasActiveDamageDealers()
		AND
		DB_TWN_MasonsGuild_DamageDealers(_DamageDealer)
		AND
		IsDestroyed(_DamageDealer, 0)
		AND
		NOT DB_TWN_MasonsGuild_DamageDealersShots(_DamageDealer, _)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_TWN_MasonsGuild_HasActiveDamageDealers()
		AND
		DB_TWN_MasonsGuild_DamageDealers(_DamageDealer)
		AND
		IsDestroyed(_DamageDealer, 0)
		AND
		DB_TWN_MasonsGuild_DamageDealersShots(_DamageDealer, _Shots)
		AND
		DB_TWN_MasonsGuild_Trap_MaxShots(_MaxShots)
		AND
		_Shots < _MaxShots
		THEN
		DB_NOOP(1);
		
		IF
		ObjectTimerFinished(S_TWN_MasonsGuild_TrapWall_d5d0851a-8a0a-4194-b5fb-2be3255dd1e3, "TWN_MasonsGuild_BaitTrap_Deactivate")
		THEN
		PROC_TWN_MasonsGuild_BaitTrap_Deactivate();
		
		PROC
		PROC_TWN_MasonsGuild_BaitTrap_Deactivate()
		AND
		NOT DB_GlobalFlag((FLAG)TWN_MasonsGuild_Trap_State_Deactivating_cb3e78be-5fd9-42f1-a667-872463fc4605)
		THEN
		PROC_GlobalSetFlagAndCache(TWN_MasonsGuild_Trap_State_Deactivating_cb3e78be-5fd9-42f1-a667-872463fc4605);
		PROC_TWN_MasonsGuild_BaitTrap_DeactiveDamageDealers();
		SysClear("DB_TWN_MasonsGuild_DamageDealersShots", 2);
		SysClear("DB_TWN_MasonsGuild_BaitTrap_Victim", 1);
		SetEntityEvent(S_TWN_MasonsGuild_TrapWall_InvisibleHelper_fe8a3c9b-e213-416e-aafe-70cf13ea432e, "TWN_MasonsGuild_Push"); // push the objects out to avoid the players beings stuck
		PROC_GLO_MovingObject_Move(S_TWN_MasonsGuild_TrapWall_d5d0851a-8a0a-4194-b5fb-2be3255dd1e3);
		PROC_GLO_MovingObject_Move(S_TWN_MasonsGuild_Blocker_001_3509e836-cf2c-4df5-9665-16ad6ca9fa46);
		PROC_GLO_MovingObject_Move(S_TWN_MasonsGuild_Blocker_002_b6829a21-9e2e-47af-996b-5c2ba61ebfb8);
		PROC_DangerZone_Safe("TWN_MasonsGuild_TrapArea");
		
		PROC
		PROC_TWN_MasonsGuild_BaitTrap_DeactiveDamageDealers()
		AND
		DB_TWN_MasonsGuild_DamageDealers(_DamageDealer)
		AND
		NOT DB_PermaDefeated(_DamageDealer)
		THEN
		SetEntityEvent(_DamageDealer, "TWN_MasonsGuild_DeactivateDamageDealer");
		PROC_StopLoopEffect(_DamageDealer, "TWN_MasonsGuild_DamageDealerFireVFX");
		
		PROC
		PROC_GLO_MovingObject_FinishedMovement(S_TWN_MasonsGuild_TrapWall_d5d0851a-8a0a-4194-b5fb-2be3255dd1e3, _, (TRIGGER)S_TWN_MasonsGuild_TrapWall_DefaultPos_e90d9140-f629-4fbe-8477-a941b9dcc871, _)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)TWN_MasonsGuild_Trap_State_Deactivated_8348a548-b0ce-4ecb-aa6a-a9f762bf6b7c);
		
		// fallback for the cases when a party member / item is stuck behind or inside the stone wall (or inside one of the gratings), this might block the player completely
		// usually the pushback should move the object out
		// but if it fails, we do a manual teleport
		PROC
		PROC_GLO_MovingObject_FinishedMovement(S_TWN_MasonsGuild_TrapWall_d5d0851a-8a0a-4194-b5fb-2be3255dd1e3, _, (TRIGGER)S_TWN_MasonsGuild_TrapWall_DefaultPos_e90d9140-f629-4fbe-8477-a941b9dcc871, _)
		THEN
		PROC_TWN_MasonsGuild_CheckMoveObjectsOut(S_TWN_MasonsGuild_TrapWall_ProblemArea_8bda35b1-1c4c-446b-8e9c-9fa31cc30fe0);
		
		PROC
		PROC_GLO_MovingObject_FinishedMovement(_Blocker, _, _BlockerNewPos, _)
		AND
		DB_GLO_MovingObject(_Blocker, "TWN_MasonsGuild_Blocker_Move", _, _BlockerNewPos, _, _, _, _, _)
		AND
		DB_TWN_MasonsGuild_Gratings(_Blocker, _BlockerArea, _)
		THEN
		PROC_TWN_MasonsGuild_CheckMoveObjectsOut(_BlockerArea);
		
		PROC
		PROC_TWN_MasonsGuild_CheckMoveObjectsOut((TRIGGER)_Trigger)
		AND
		DB_TWN_MasonsGuild_PushableObjects(_Trigger, _Object)
		AND
		IsInTrigger(_Object, _Trigger, 1)
		AND
		GetPosition(S_TWN_MasonsGuild_TrapWall_FallbackTeleportPos_0e508696-bd06-4035-b756-ec19fa14e9d2, _X, _Y, _Z)
		THEN
		PROC_TWN_MasonsGuild_MoveStuckObjectOut(_Object, _X, _Y, _Z);
		
		PROC
		PROC_TWN_MasonsGuild_MoveStuckObjectOut((GUIDSTRING)_Object, (REAL)_X, (REAL)_Y, (REAL)_Z)
		AND
		NOT QRY_TWN_MasonsGuild_FindValidPosition(_Object, _X, _Y, _Z)
		THEN
		TeleportTo(_Object, S_TWN_MasonsGuild_TrapWall_FallbackTeleportPos_0e508696-bd06-4035-b756-ec19fa14e9d2, "", 0, 1, 1, 1, 1);
		
		QRY
		QRY_TWN_MasonsGuild_FindValidPosition((GUIDSTRING)_Object, (REAL)_X, (REAL)_Y, (REAL)_Z)
		AND
		FindValidPosition(_X, _Y, _Z, 2.0, _Object, 0, _ValidX, _ValidY, _ValidZ)
		THEN
		TeleportToPosition(_Object, _ValidX, _ValidY, _ValidZ, "", 0, 1, 1, 1, 1);
		//END_REGION Bait Trap
		
		IF
		GameBookInterfaceClosed(S_TWN_MasonsGuild_TreasureMap_cbd3d1da-eae7-4714-8fd8-3e32b53e6134,_Player)
		THEN
		PROC_ShowMarker(_Player,"MOO_Prison_MasonMarker");
		
		PROC
		PROC_Shovel_CleanupMound((ITEM)S_MOO_BuriedMound_02_635e4ec7-0bd1-4c6f-847f-9c1500d62efb)
		AND
		DB_Players(_Player)
		THEN
		PROC_HideMarker(_Player,"MOO_Prison_MasonMarker");
	}
	EXIT
	{
	}
}
Goal(473).Title("Act2_TWN_Misc");
Goal(473)
{
	INIT
	{
		//REGION Aasimar Survivor
		
		//Directing the players to the booster, bc place is so big and we can afford it
		DB_OneShot_VoiceBarkTrigger(S_TWN_AasimarSurvivor_DoorNoticeTrigger_68ef2709-25fe-4738-b318-f2780ffb8d49,TWN_AasimarSurvivor_VB_NoticedDoor_c6ca60a8-13d6-09ba-da30-4a5cbb5a5747);
		
		DB_TWN_AasimarSurvivor_OchreJelly((CHARACTER)S_TWN_AasimarSurvivor_FetidOoze_002_2689011e-9c19-42a5-a44e-990ca571261a);
		DB_TWN_AasimarSurvivor_OchreJelly(S_TWN_AasimarSurvivor_FetidOoze_003_41afd575-f2d1-4f05-98c4-baa140f684a4);
		DB_TWN_AasimarSurvivor_OchreJelly(S_TWN_AasimarSurvivor_FetidOoze_001_95cd289a-33f3-4221-bf65-45efe3329762);
		
		//TODO - Rework it to work with new activation range feature or hack it to only force update when someone is in the morgue
		SetForceUpdate(S_TWN_AasimarSurvivor_AnimatedArmor_000_950ba3d5-6871-4be5-9e1a-38619c044f50, 1); //Temp fix for Armor being visually culled from the high cliffs - waiting on GUS-179376 for proper support
		
		Die(S_TWN_AasimarSurvivor_AnimatedArmor_000_950ba3d5-6871-4be5-9e1a-38619c044f50,DEATHTYPE.DoT,NULL_00000000-0000-0000-0000-000000000000,0,1,1.0);
		
		DB_SCL_ShadowCurse_Immune(S_TWN_AasimarSurvivor_AnimatedArmor_000_950ba3d5-6871-4be5-9e1a-38619c044f50);
		
		DB_AmbushTrigger((TRIGGER)S_TWN_AasimarSurvivor_ArmorHostilityBox_d600c6b0-0279-487b-b065-37fae3763347, NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		//END_REGION
		
		//REGION Morgue Zombies
		
		DB_TWN_HospitalMorgue_Zombies(S_TWN_MorgueZombie_01_fdba6b05-c6de-4079-97dc-6abfddc5a75b);
		DB_TWN_HospitalMorgue_Zombies(S_TWN_MorgueZombie_02_88dafec7-53e1-421c-865c-f4ef51f54fd2);
		DB_TWN_HospitalMorgue_Zombies(S_TWN_MorgueZombie_03_a76458a6-e964-48ba-8305-3bbae695ce35);
		DB_TWN_HospitalMorgue_Zombies(S_TWN_MorgueZombie_04_e81c4052-960c-4d06-b1dc-4fe5a973f3cc);
		DB_TWN_HospitalMorgue_Zombies(S_TWN_MorgueZombie_05_57136905-ef79-4a05-a1bb-e26d221ffa2e);
		DB_TWN_HospitalMorgue_Zombies(S_TWN_MorgueZombie_06_1fbcbafb-edd6-4bab-bcfc-61d649e9804a);
		
		//END_REGION
		
		//REGION Help Wanted Poster
		DB_ItemDialog_NarratorAD(S_TWN_HelpWantedPoster_16b8555b-9688-4f87-9481-ee0879fda353, (DIALOGRESOURCE)TWN_HelpWantedPoster_AD_3883aa3a-d9ff-bc75-27a5-cf09c14ff3cd);
		//END_REGION Help Wanted Poster
		
		//REGION Fisherman Note
		DB_ItemDialog_NarratorAD((ITEM)S_TWN_FishermanNote_c7455544-ded3-4500-8318-766863aa9b08, (DIALOGRESOURCE)TWN_FishermanNote_AD_7fb512de-63c6-e548-f3b5-955ebab8b359);
		//END_REGION Fisherman Note
		
		//REGION Confiscated Crates
		DB_TWN_Tollhouse_ConfiscatedCrates((ITEM)S_TWN_DalelandsCrate_8e378444-78f6-4751-9448-d90f981f6a7f, (DIALOGRESOURCE)TWN_Tollhouse_PAD_DalelandsCrate_a06b02f9-8e41-6d01-d431-5e07130dcbd7);
		DB_TWN_Tollhouse_ConfiscatedCrates((ITEM)S_TWN_CormyrCrate_6b33af1d-d030-4218-87f8-b3837e56025b, (DIALOGRESOURCE)TWN_Tollhouse_PAD_CormyrCrate_7ee5a591-aef8-708a-e570-30376afcc88a);
		DB_TWN_Tollhouse_ConfiscatedCrates((ITEM)S_TWN_ThayCrate_968f2b5a-e741-403e-a8f9-3d3845f313cd, (DIALOGRESOURCE)TWN_Tollhouse_PAD_ThayCrate_aedb66ec-10b1-81c3-0f59-3241c04c8c83);
		//END_REGION Confiscated Crates
		
		//REGION Missing Pets
		DB_ItemDialog_PlayerVB(S_TWN_MissingPetsCollarsPile_b7680bb0-4a59-4b66-ad76-f9d332265b9a, (VOICEBARKRESOURCE)TWN_MissingPetsCollarsPile_VB_46901677-75b9-b662-ce4d-8a3a9436802e);
		DB_ItemDialog_PlayerVB(S_TWN_MissingPetsBoard_bea366ad-dd39-40e5-a287-cb98190f0763, (VOICEBARKRESOURCE)TWN_MissingPetsBoard_VB_bcd6a4c8-2c26-9537-ce48-fb9d8dc58ce2);
		//END_REGION Missing Pets
		
		//REGION Vlaakith Attack
		PROC_TWN_VlaakithAttack_Init();
		
		DB_TWN_VlaakithAttack_GithGroup((CHARACTER)S_TWN_VlaakithAttack_Melee_001_9aae708f-6fd1-453f-b5a6-959814f0672f);
		DB_TWN_VlaakithAttack_GithGroup((CHARACTER)S_TWN_VlaakithAttack_Caster_000_e4141a02-f5e7-4a0c-a7af-d3dda6610c1b);
		DB_TWN_VlaakithAttack_GithGroup((CHARACTER)S_TWN_VlaakithAttack_Melee_000_d29ba948-3631-4779-bd7a-400dcd7a51a3);
		DB_TWN_VlaakithAttack_GithGroup((CHARACTER)S_TWN_VlaakithAttack_Ranger_000_b7e639ba-9e1d-42cd-8305-e8c02f00f1a1);
		DB_TWN_VlaakithAttack_GithGroup((CHARACTER)S_TWN_VlaakithAttack_Ranger_001_dabc5b38-7606-48cb-99ef-e7edcc49e1a9);
		
		DB_GLO_CharacterCorpseDialog((CHARACTER)S_TWN_VlaakithAttack_Melee_000_d29ba948-3631-4779-bd7a-400dcd7a51a3, (DIALOGRESOURCE)TWN_VlaakithAttack_Melee_000_Dead_79841c0b-79e1-4a01-6d92-58a80e80e062);
		PROC_TriggerRegisterForParty((TRIGGER)S_TWN_GithRadarAmbushActivationArea_0506dfbf-aa7d-4e58-914a-858dd1525a75);
		
		// Combat NPC Reactivity
		DB_CombatReact_AD_OnEntered(S_TWN_VlaakithAttack_Caster_000_e4141a02-f5e7-4a0c-a7af-d3dda6610c1b, (DIALOGRESOURCE)TWN_VlaakithAttack_AD_Caster_000_CombatStarts_e5d7ae88-ff97-7e4b-74fc-7d136a227046);
		DB_CombatReact_AD_OnNextTurn(S_TWN_VlaakithAttack_Caster_000_e4141a02-f5e7-4a0c-a7af-d3dda6610c1b, (DIALOGRESOURCE)TWN_VlaakithAttack_AD_Caster_000_TakingTurn_001_7b09b907-9742-a382-54fb-ac99e497f920);
		DB_CombatReact_AD_OnNextTurn(S_TWN_VlaakithAttack_Caster_000_e4141a02-f5e7-4a0c-a7af-d3dda6610c1b, (DIALOGRESOURCE)TWN_VlaakithAttack_AD_Caster_000_TakingTurn_002_e71c74fe-d7ff-1a1d-a39e-1671d9bd5e5e);
		DB_CombatReact_AD_OnNextTurn(S_TWN_VlaakithAttack_Caster_000_e4141a02-f5e7-4a0c-a7af-d3dda6610c1b, (DIALOGRESOURCE)TWN_VlaakithAttack_AD_Caster_000_TakingTurn_003_69558b1d-d5bf-2bbf-d139-a59d20675e48);
		
		//END_REGION Vlaakith Attack
		
		//REGION Misc VB Triggers
		DB_OneShot_VoiceBarkTrigger(S_TWN_VBTrigger_MausoleumEntry_750d14ea-4e7a-4ed1-87ef-61af69c918a2, (VOICEBARKRESOURCE)TWN_Mausoleum_VB_Entrance_77694433-0d01-14e5-7005-f1057b5cc312, "PerUserAndNearbyPlayers");
		//END_REGION
		
		PROC_RegisterWorldGossipTrigger(S_PartyBanterTrigger_Hospital_Morgue_fd5b94c0-226b-4e96-8fdc-5de75dc9dbcd);
		DB_WorldGossip_RegionTrigger(S_PartyBanterTrigger_Hospital_Morgue_fd5b94c0-226b-4e96-8fdc-5de75dc9dbcd, BANTERREGION_TWN_Morgue_6ed2181f-9eef-42dc-bc4e-7d51d92e520f);
		
		DB_PartyProgress_Trigger((TRIGGER)S_TWN_MainSub_169edf4a-bd51-4964-adb0-4d47956d5fae, (FLAG)TWN_State_EverEnteredBefore_5d5b52ea-d366-4f56-a6f1-8aac8470a130);
	}
	KB
	{
		//REGION Aasimar Survivor
		
		IF
		DB_TWN_AasimarSurvivor_OchreJelly(_Ooze)
		THEN
		DB_AmbushTrigger_Ambusher((TRIGGER)S_TWN_AasimarSurvivor_ArmorHostilityBox_d600c6b0-0279-487b-b065-37fae3763347, _Ooze, 1);
		DB_SCL_ShadowCurse_Immune(_Ooze);
		
		PROC
		PROC_LaunchAmbush(S_TWN_AasimarSurvivor_ArmorHostilityBox_d600c6b0-0279-487b-b065-37fae3763347,_Player)
		THEN
		Resurrect(S_TWN_AasimarSurvivor_AnimatedArmor_000_950ba3d5-6871-4be5-9e1a-38619c044f50);
		PROC_SetRelationToPlayers((FACTION)Act2_TWN_AasimarSurvivor_AnimatedArmors_5bc4c87b-eb79-4d63-afff-ffde152fbc5f, 0);
		
		PROC
		PROC_CancelAmbush(S_TWN_AasimarSurvivor_ArmorHostilityBox_d600c6b0-0279-487b-b065-37fae3763347)
		THEN
		Resurrect(S_TWN_AasimarSurvivor_AnimatedArmor_000_950ba3d5-6871-4be5-9e1a-38619c044f50);
		PROC_SetRelationToPlayers((FACTION)Act2_TWN_AasimarSurvivor_AnimatedArmors_5bc4c87b-eb79-4d63-afff-ffde152fbc5f, 0);
		
		IF
		Resurrected(S_TWN_AasimarSurvivor_AnimatedArmor_000_950ba3d5-6871-4be5-9e1a-38619c044f50)
		THEN
		ApplyStatus(S_TWN_AasimarSurvivor_AnimatedArmor_000_950ba3d5-6871-4be5-9e1a-38619c044f50, "TWN_ARMOUR_SHADOW", -1.0, 1, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		DB_AmbushRevealed(S_TWN_AasimarSurvivor_ArmorHostilityBox_d600c6b0-0279-487b-b065-37fae3763347)
		AND
		QRY_OnlyOnce("TWN_AasimarSurvivor_OozesSplash")
		AND
		DB_TWN_AasimarSurvivor_OchreJelly(_Ooze)
		THEN
		PlayEffect(_Ooze,VFX_Enemies_Fetid_Ooze_Spawn_Impact_Root_01_aef1bcfe-cb5c-b617-6bab-9ba5e56a46f5);
		
		PROC
		PROC_LaunchAmbush(S_TWN_AasimarSurvivor_ArmorHostilityBox_d600c6b0-0279-487b-b065-37fae3763347,_Player)
		AND
		QRY_OnlyOnce("TWN_AasimarSurvivor_OozesSplash")
		AND
		DB_TWN_AasimarSurvivor_OchreJelly(_Ooze)
		THEN
		PlayEffect(_Ooze,VFX_Enemies_Fetid_Ooze_Spawn_Impact_Root_01_aef1bcfe-cb5c-b617-6bab-9ba5e56a46f5);
		
		PROC
		PROC_CancelAmbush(S_TWN_AasimarSurvivor_ArmorHostilityBox_d600c6b0-0279-487b-b065-37fae3763347)
		AND
		QRY_OnlyOnce("TWN_AasimarSurvivor_OozesSplash")
		AND
		DB_TWN_AasimarSurvivor_OchreJelly(_Ooze)
		THEN
		PlayEffect(_Ooze,VFX_Enemies_Fetid_Ooze_Spawn_Impact_Root_01_aef1bcfe-cb5c-b617-6bab-9ba5e56a46f5);
		//END_REGION
		
		//REGION Morgue Zombies
		
		IF
		DB_TWN_HospitalMorgue_Zombies(_Zombie)
		THEN
		SetAmbushing(_Zombie,1);
		
		IF
		EnteredCombat(_Zombie, _)
		AND
		DB_TWN_HospitalMorgue_Zombies(_Zombie)
		AND
		HasActiveStatus(_Zombie, "TWN_MORGUE_MUMMYSLEEP", 1)
		THEN
		RemoveStatus(_Zombie, "TWN_MORGUE_MUMMYSLEEP");
		PlayAnimation(_Zombie, STAT_KO_Peace_01_End_37fe9557-0310-4273-9e28-03c1613e4101, "");
		SetAmbushing(_Zombie, 0);
		
		//END_REGION
		
		//REGION Envoy
		IF
		Moved(S_TWN_EnvoyMessage_d2b7c49d-78f6-4e03-8fa8-d71e7f95f30e)
		THEN
		SetGravity(S_TWN_EnvoyMessage_d2b7c49d-78f6-4e03-8fa8-d71e7f95f30e, GRAVITYTYPE.Enabled);
		
		IF
		PreMovedBy(S_TWN_EnvoySkull_b4409059-17c5-4656-8f2a-b21c2026e1c6, _)
		THEN
		SetGravity(S_TWN_EnvoyMessage_d2b7c49d-78f6-4e03-8fa8-d71e7f95f30e, GRAVITYTYPE.Enabled);
		//END_REGION Envoy
		
		//REGION Confiscated Crates
		IF
		UseFinished(_Player, _Crate, 1)
		AND
		DB_TWN_Tollhouse_ConfiscatedCrates(_Crate, _AD)
		AND
		GUIDToString(_AD, _ADString)
		AND
		QRY_OncePerUserAndNearbyPlayers(_Player, _ADString)
		THEN
		PROC_TryStartAD(_AD, _Player);
		//END_REGION Confiscated Crates
		
		//REGION Prayers on the wall
		IF
		UseFinished(_Player, S_TWN_PrayersAndCharms_95df1b04-2fc9-4c79-8971-c08f760085a1, 1)
		AND
		QRY_OncePerUserAndNearbyPlayers(_Player, "TWN_PrayersAndCharms")
		THEN
		StartVoiceBark(TWN_CharmAndPrayers_VB_c12648c9-aac7-5dbc-3681-c49877014849, _Player);
		//END_REGION Prayers on the wall
		
		//REGION Vlaakith Attack
		IF
		DB_TWN_VlaakithAttack_GithGroup(_GithAmbusher)
		THEN
		DB_GLO_DefeatCounter(_GithAmbusher, "TWN_VlaakithAttack");
		
		IF
		DB_TWN_VlaakithAttack_GithGroup(_Gith)
		AND
		NOT DB_TWN_VlaakithAttack_CastedLight(_Gith)
		THEN
		SetForceUpdate(_Gith, 1); // Force update giths for a moment so they can cast the light spell and it follows the rules.
		UseSpell(_Gith, "Target_Light", _Gith);
		
		IF
		CastedSpell((CHARACTER)_Gith, "Target_Light", _, _, _)
		AND
		DB_TWN_VlaakithAttack_GithGroup(_Gith)
		AND
		NOT DB_TWN_VlaakithAttack_CastedLight(_Gith)
		THEN
		DB_TWN_VlaakithAttack_CastedLight(_Gith);
		SetForceUpdate(_Gith, 0);
		SetOnStage(_Gith, 0);
		
		IF
		CastSpellFailed((CHARACTER)_Gith, "Target_Light", _, _, _)
		AND
		DB_TWN_VlaakithAttack_GithGroup(_Gith)
		AND
		NOT DB_TWN_VlaakithAttack_CastedLight(_Gith)
		THEN
		DB_TWN_VlaakithAttack_CastedLight(_Gith);
		SetForceUpdate(_Gith, 0);
		SetOnStage(_Gith, 0);
		
		//Case going back to CRE and back to SCL.
		IF
		DB_CurrentLevel("SCL_Main_A")
		THEN
		PROC_TWN_VlaakithAttack_Init();
		
		PROC
		PROC_TWN_VlaakithAttack_Init()
		AND
		DB_GlobalFlag((FLAG)CRE_ChainOfCommand_State_HuntedByVlaakith_dd45fe4c-894b-4c3a-8a81-f3ea3186cf82)
		AND
		QRY_OnlyOnce("TWN_VlaakithAttackSetUp")
		THEN
		PROC_TriggerRegisterForPlayers(S_TWN_VlaakithAttack_SpawnTrigger_0cff9ad6-11b6-423b-87a4-514431f67554);
		
		//GithRadar logic
		IF
		EnteredTrigger(_Player, (TRIGGER)S_TWN_GithRadarAmbushActivationArea_0506dfbf-aa7d-4e58-914a-858dd1525a75)
		AND
		DB_Players(_Player)
		AND
		IsInInventoryOf((ITEM)S_GLO_GithRadar_4aca442e-5ecb-4611-b481-5eaf35596dea, _Player, 1)
		AND
		QRY_OnlyOnce("TWN_VlaakithAttack_RadarActivated")
		THEN
		PlaySound(_Player, "SE_Pendulum_Psionic_Detector"); 
		StartVoiceBark((VOICEBARKRESOURCE)TWN_VlaakithAttack_VB_GithRadarGoesOffComment_e02a7f11-c79a-10dc-2942-88ab776ef8aa, _Player);
		DB_TWN_VlaakithAttack_RadarWentOff(_Player);
		
		PROC
		PROC_GLO_DefeatCounter_AllDefeated("TWN_VlaakithAttack")
		AND
		DB_TWN_VlaakithAttack_RadarWentOff(_Player)
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)TWN_VlaakithAttack_VB_RealizeGithRadarFunction_674fdb1a-706d-84c6-9289-ea260efaa08b, _Player);
		
		//If the radar went off, the players get an advantage in the coming fight against the Gith Ambushers 
		IF
		EnteredTrigger(_, S_TWN_VlaakithAttack_SpawnTrigger_0cff9ad6-11b6-423b-87a4-514431f67554)
		AND
		DB_TWN_VlaakithAttack_RadarWentOff(_)
		AND
		QRY_OnlyOnce("TWN_VlaakithAttack_PlayersAlerted")
		AND
		DB_PartyMembers(_PartyMember)
		AND
		DB_InRegion(_PartyMember, (TRIGGER)S_TWN_GithRadarAmbushActivationArea_0506dfbf-aa7d-4e58-914a-858dd1525a75)
		THEN
		ApplyStatus(_PartyMember, "TWN_GITHRADAR_ALERT", -1.0, 1, NULL_00000000-0000-0000-0000-000000000000);
		DB_TWN_VlaakithAttack_PartyMemberAlerted((CHARACTER)_PartyMember);
		
		IF
		EnteredTrigger(_, S_TWN_VlaakithAttack_SpawnTrigger_0cff9ad6-11b6-423b-87a4-514431f67554)
		AND
		DB_TWN_VlaakithAttack_GithGroup(_Gith)
		THEN
		PROC_Foop(_Gith); // TODO: Add VFX so it appears they come from another plane.
		
		IF
		EnteredTrigger(_Player, S_TWN_VlaakithAttack_SpawnTrigger_0cff9ad6-11b6-423b-87a4-514431f67554)
		THEN
		PROC_TriggerUnregisterForPlayers(S_TWN_VlaakithAttack_SpawnTrigger_0cff9ad6-11b6-423b-87a4-514431f67554);
		
		IF
		LeftCombat(_PartyMember, _)
		AND
		DB_TWN_VlaakithAttack_PartyMemberAlerted((CHARACTER)_PartyMember)
		THEN
		RemoveStatus(_PartyMember, "TWN_GITHRADAR_ALERT", NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		StatusRemoved(_PartyMember, "TWN_GITHRADAR_ALERT", _, _)
		THEN
		NOT DB_TWN_VlaakithAttack_PartyMemberAlerted((CHARACTER)_PartyMember);
		
		IF
		TextEvent("TWN_SetUpGithAttack")
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)CRE_ChainOfCommand_State_HuntedByVlaakith_dd45fe4c-894b-4c3a-8a81-f3ea3186cf82);
		PROC_TWN_VlaakithAttack_Init();
		//END_REGION Vlaakith Attack
	}
	EXIT
	{
	}
}
