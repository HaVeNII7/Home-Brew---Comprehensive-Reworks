		Dying(S_END_MindBattleHelper_be50f7cd-c14a-4131-82d3-29337f3a4759)
		AND
		DB_Is_InCombat(S_END_MindBrain_f8bb04a3-22e5-41b0-aed7-5dcf852343d1, _Combat)
		AND
		DB_Is_InCombat(_Orb, _Combat)
		AND
