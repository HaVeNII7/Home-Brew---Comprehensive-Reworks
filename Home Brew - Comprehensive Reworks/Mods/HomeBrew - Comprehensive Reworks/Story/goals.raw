		DB_OriginNPCAlignment((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, (FACTION)Origin_Minsc_7512afc3-d78a-795d-39fa-ce662dfa7649);
		
		DB_OriginRecruitmentDialog((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, (DIALOGRESOURCE)Minsc_Recruitment_630440f5-b71a-8764-94e8-b62544254cff);
		DB_OriginInPartyDialog((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, (DIALOGRESOURCE)Minsc_InParty_d0554ced-ca60-938b-362c-07b0c77610d7);
		DB_OriginWarning1Dialog(S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba,DIALOGRESOURCEGUID_Minsc_Warning1_673bf1bb-91d7-f0c1-9b80-7c2fcb66d24e);
		DB_OriginWarning2Dialog(S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba,DIALOGRESOURCEGUID_Minsc_Warning2_937053f1-7066-982e-c717-85e3e7ce36f8);
		DB_OriginLeavingDialog(S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba,DIALOGRESOURCEGUID_Minsc_Leaving_17833995-3375-c8cd-621a-678af492c546);
		
		DB_Inclusion_Object(S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba,(FLAG)ORI_Inclusion_Minsc_4d56209b-b778-4f03-a67f-0ab763dbdce1,(FLAG)ORI_Inclusion_End_Minsc_83c663c9-8aed-4a51-92ff-07eccaebe076);
		
		DB_Debug_CharacterAddFlags((FLAG)Debug_AddMinsc_e13376a2-10f4-68f3-4b4c-710938b1c143, (CHARACTER)CHARACTERGUID_S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba,(FLAG)Debug_MinscIsPlayer_0e87a51a-9281-191e-a506-3545e442ad1c);
		DB_Debug_CharacterRemoveHideFlags((FLAG)Debug_RemoveHideMinsc_9786a6cb-7486-39b9-c22d-faf1638c8f03, (CHARACTER)CHARACTERGUID_S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba);
		
		SetHasDialog((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, 1);
		//END_REGION
		
		DB_GLO_Minsc_BooDialogs((DIALOGRESOURCE)Minsc_Recruitment_630440f5-b71a-8764-94e8-b62544254cff);
		DB_GLO_Minsc_BooDialogs((DIALOGRESOURCE)Minsc_InParty_d0554ced-ca60-938b-362c-07b0c77610d7);
		DB_GLO_Minsc_BooDialogs((DIALOGRESOURCE)Minsc_Leaving_17833995-3375-c8cd-621a-678af492c546);
		DB_GLO_Minsc_BooDialogs((DIALOGRESOURCE)LOW_Guildhall_Roah_OM_Minsc_COM_OOM_4207f162-c56e-4c6a-7bdc-9c01bec8131b);
		DB_GLO_Minsc_BooDialogs((DIALOGRESOURCE)LOW_Guildhall_BossFriol_OM_Minsc_COM_OOM_0450ca65-21fe-04d9-b50f-71aef887d00a);
		DB_GLO_Minsc_BooDialogs((DIALOGRESOURCE)Minsc_InPartyEND_5f5091d1-3514-6f4e-e542-5e49a6a07bea);
		
		DB_PermaDefeatedFlag((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, (FLAG)GLO_Minsc_State_PermaDefeated_ba8e77ff-b6af-4e78-9707-6ec7d412f886);
		DB_PermaDefeatedFlag(S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, (FLAG)ORI_Minsc_State_PermaDefeated_e61d7a9c-5c7c-4149-809d-49ca73ebf5ef);
		DB_ReactOutOfRegion((TAG)REALLY_MINSC_aeb694fc-83fb-452d-819a-b97ba442dc42);
		DB_DeadOnceFlag((CHARACTER)S_GLO_Boo_d49e3b49-a089-4465-b453-28dc79e82bb3, (FLAG)GLO_Boo_State_Dead_547e9b0b-f638-409a-889a-e4b35374a71b);
		DB_GLO_CharacterCorpseDialog((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, (DIALOGRESOURCE)Minsc_SWD_f781594b-c7f1-a3f8-7661-4a49394fc4b3);
		
		//REGION Topical Greetings
		DB_TopicalGreeting((FLAG)TG_ORI_MinscNotSaved_8a3e9c32-1fff-4041-88f3-224b2a446846);
		DB_TopicalGreeting((FLAG)TG_ORI_MinscRecruited_8f04323d-6f9c-45b0-b5ef-f9edee340976);
		//END_REGION
		
		DB_OriginMayLeaveDialog(S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, CAMP_DarkUrge_CFM_BloodweddingFollowup_2111a7a8-1f57-4e72-f518-acdaaddc0a67);
	}
	KB
	{
		//REGION Move to Camp
		PROC
		PROC_GLO_PartyMembers_AddHook((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba,(CHARACTER)_Player)
		AND
		QRY_OnlyOnce("RecruitedFirstTime_Minsc")
		THEN
		PROC_ORI_SetupCamp((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, 0);
		SetFlag((FLAG)ORI_Minsc_HasMet_70ddd64b-6f91-1d6c-b3e6-8ecddc30ab04, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		
		IF
		TextEvent("minsc2camp")
		THEN
		SetEntityEvent((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, "DebugTeleportedToCamp");
		
		IF
		EntityEvent((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, "DebugTeleportedToCamp")
		AND
		DB_GLO_PartyMembers_DefaultFaction(S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, _PlayerFaction)
		THEN
		PROC_GLO_PartyMembers_ClearCompanionHostilityForOriginalFaction((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba);
		SetFaction((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, _PlayerFaction);
		PROC_ORI_SetupCamp((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, 1);
		//END_REGION
		
		//REGION Boo
		// Add Boo to dialogs as extra speaker
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)_MinscDialog,(INTEGER)_ID)
		AND
		DB_GLO_Minsc_BooDialogs(_MinscDialog)
		AND
		QRY_SpeakerIsAvailable(S_GLO_Boo_d49e3b49-a089-4465-b453-28dc79e82bb3, 0, 0, 0)
		THEN
		SetFlag((FLAG)GLO_Minsc_State_BooIsSpeaker_510afc2e-7350-4993-9f29-d52e941ab4cf, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		PROC_DialogAddSpeakingActor(_ID, S_GLO_Boo_d49e3b49-a089-4465-b453-28dc79e82bb3);
		
		IF
		DialogEnded(_Dialog, _Inst)
		AND
		DB_GLO_Minsc_BooDialogs(_Dialog)
		THEN
		ClearFlag((FLAG)GLO_Minsc_State_BooIsSpeaker_510afc2e-7350-4993-9f29-d52e941ab4cf, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		
		IF
		FlagSet((FLAG)ORI_Minsc_State_ReunitedWithBoo_491635de-7395-5fe4-f8ce-be3288707a80, _, _)
		THEN
		PROC_SetOnStage(S_GLO_Boo_d49e3b49-a089-4465-b453-28dc79e82bb3, 0);
		
		// ensure we can have Boo as speaker when we assign him when offstage
		QRY
		QRY_SpeakerIsAvailable(S_GLO_Boo_d49e3b49-a089-4465-b453-28dc79e82bb3, 0, 0, 0)
		AND
		DB_OffStage(S_GLO_Boo_d49e3b49-a089-4465-b453-28dc79e82bb3)
		AND
		QRY_SpeakerIsInCurrentLevel(S_GLO_Boo_d49e3b49-a089-4465-b453-28dc79e82bb3)
		THEN
		DB_NOOP(1);
		
		// Boo has same faction as Minsc
		IF
		BaseFactionChanged((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, _, _NewFaction)
		THEN
		SetFaction(S_GLO_Boo_d49e3b49-a089-4465-b453-28dc79e82bb3, _NewFaction);
		
		// Boo goes where Minsc goes
		IF
		EnteredLevel(S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, _, _NewRegion)
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba)
		THEN
		TeleportTo(S_GLO_Boo_d49e3b49-a089-4465-b453-28dc79e82bb3, S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba);
		PROC_SetOnStage(S_GLO_Boo_d49e3b49-a089-4465-b453-28dc79e82bb3, 0); // Boo needs to stay off stage
		
		// Minsc says his famous line when he throws Boo at a creature
		IF
		OnThrown((CHARACTER)_Throwee, (ROOT)Boo_FindFamiliar_6f65f77f-4583-4dd7-be15-b737d0175061, (CHARACTER)_Player, (INTEGER)_StoryActionID, _, _, _)
		AND
		DB_Players(_Player)
		AND
		ConcatenateInteger("GLO_Minsc_ThrowingBoo", _StoryActionID, _TimerName)
		THEN
		DB_GLO_Minsc_BooThrow(_Player, _Throwee, _TimerName, _StoryActionID);
		ObjectTimerLaunch(_Player, _TimerName, 5000, 0);
		
		IF
		AttackedBy((CHARACTER)_Defender, (CHARACTER)_Player, _, _, _, "Attack", (INTEGER)_StoryActionID)
		AND
		DB_Players(_Player)
		AND
		DB_GLO_Minsc_BooThrow(_Player, _Throwee, _TimerName, _StoryActionID)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)Minsc_Boo_AD_ThrowBoo_476d9ed6-7686-4e85-0a81-6f74f99c99a5, (CHARACTER)_Player);
		NOT DB_GLO_Minsc_BooThrow(_Player, _Throwee, _TimerName, _StoryActionID);
		
		// clean up database in case of a miss
		IF
		ObjectTimerFinished((CHARACTER)_Player, _TimerName)
		AND
		DB_GLO_Minsc_BooThrow(_Player, _Throwee, _TimerName, _StoryActionID)
		THEN
		NOT DB_GLO_Minsc_BooThrow(_Player, _Throwee, _TimerName, _StoryActionID);
		//END_REGION
		
		//REGION Minsc Recruitment
		// TG when Minsc is not saved from Absolute
		IF
		FlagSet((FLAG)ORI_Minsc_State_NotSavedFromAbsolute_c8fdabdd-a9fa-4dbb-b693-9c7b12e1f56b, _, _)
		THEN
		PROC_TopicalGreeting_UnlockTopic((FLAG)TG_ORI_MinscNotSaved_8a3e9c32-1fff-4041-88f3-224b2a446846);
		
		IF
		DB_PermaDefeated(S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Minsc_State_NotSavedFromAbsolute_c8fdabdd-a9fa-4dbb-b693-9c7b12e1f56b)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Minsc_State_SavedFromAbsolute_62e1d5ec-7c7e-70c2-68de-cadc7c7f5f20)
		THEN
		PROC_TopicalGreeting_UnlockTopic((FLAG)TG_ORI_MinscNotSaved_8a3e9c32-1fff-4041-88f3-224b2a446846);
		
		// Set the good guy Minsc faction on Minsc once he is saved
		IF
		FlagSet((FLAG)ORI_Minsc_State_SavedFromAbsolute_62e1d5ec-7c7e-70c2-68de-cadc7c7f5f20, _, _)
		THEN
		SetFaction((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, (FACTION)Origin_Minsc_7512afc3-d78a-795d-39fa-ce662dfa7649);
		SetCombatGroupID((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, "");
		
		// Set recruitment dialog on Minsc once he found Boo
		IF
		FlagSet((FLAG)ORI_Minsc_State_ReunitedWithBoo_491635de-7395-5fe4-f8ce-be3288707a80, _, _)
		THEN
		PROC_GLO_Origins_SetRecruitmentDialog((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, (DIALOGRESOURCE)Minsc_Recruitment_630440f5-b71a-8764-94e8-b62544254cff);
		
		// Minsc was rejected by the player
		IF
		FlagSet(ORI_Minsc_State_SavedButNotRecruited_8d437b31-7b27-478a-8c76-4cc095006d3f, _, _)
		THEN
		PROC_DisappearOutOfSight((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, "Run", 0, "GLO_Minsc_SavedAndLeft");
		
		IF
		EntityEvent(S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, "GLO_Minsc_SavedAndLeft")
		THEN
		PROC_SetOnStage(S_GLO_Boo_d49e3b49-a089-4465-b453-28dc79e82bb3, 0);
		
		PROC
		PROC_GLO_PartyMembers_AddHook((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, _Player)
		THEN
		ClearTag((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, (TAG)BLOCK_RESURRECTION_22a75dbb-1588-407e-b559-5aa4e6d4e6a6);
		SetFlag((FLAG)TG_ORI_MinscRecruited_8f04323d-6f9c-45b0-b5ef-f9edee340976, _Player);
		
		// Block Viconia branch in Minsc InParty if she was dealt with before Minsc was recruited
		PROC
		PROC_GLO_PartyMembers_AddHook((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, _Player)
		AND
		DB_GlobalFlag((FLAG)LOW_Grotto_State_ViconiaDefeated_8e27eb4e-8d52-4966-8aa4-e658ff595097)
		THEN
		SetFlag((FLAG)Minsc_InParty_DiscussedViconia_337240af-75ac-5b3b-8b7d-d79acd076442);
		
		// First time Minsc gets recruited or a new Avatar gets rating with Minsc
		IF
		ApprovalRatingChangeAttempt((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, _Avatar, _, _, _)
		AND
		DB_Avatars(_Avatar)
		AND
		NOT DB_ORI_Minsc_AlreadyInitializedApproval(_Avatar)
		AND
		ChangeApprovalRating(S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, _Avatar, 1, 40, _)
		THEN
		DB_ORI_Minsc_AlreadyInitializedApproval(_Avatar);
		
		IF
		ApprovalRatingChangeAttempt((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, _Avatar, _, _, _NewApproval)
		AND
		DB_Avatars(_Avatar)
		AND
		NOT DB_ApprovalRating((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, _Avatar, _)
		THEN
		DB_ApprovalRating((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, _Avatar, _NewApproval);
		//END_REGION
		
		//REGION Minsc leaves
		// Jaheira leaves party
		PROC
		PROC_Origins_CompanionLeavePermanently((CHARACTER)S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a, _)
		THEN
		PROC_Origins_ForceLowApprovalLeavingDialog((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba);
		
		// Jaheira is killed
		IF
		DB_PermaDefeated((CHARACTER)S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a)
		THEN
		PROC_Origins_ForceLowApprovalLeavingDialog((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba);
		
		// Jaheira left permanently
		IF
		FlagSet((FLAG)ORI_Jaheira_State_LeftPermanently_f463d0a1-87d7-4cff-978f-a1834bfd551c, _, _)
		THEN
		PROC_Origins_ForceLowApprovalLeavingDialog((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba);
		
		PROC
		PROC_Origins_CompanionLeavePermanently((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, _Reason)
		THEN
		SetFlag((FLAG)ORI_Minsc_State_LeftPermanently_e2deaab0-bcd6-4dfa-9e53-26e3b764035b);
		//END_REGION
		
		//REGION Debug
		// Minsc Reveal
		PROC
		PROC_DebugBook_Event("MinscCountingHouseReveal", _Player)
		THEN
		TeleportTo(_Player, S_Debug_LOW_CountingHouse_MinscCountingHouseTeleport_94e404db-ab30-4ad1-bbbb-528604b4460e);
		
		// Bribing Roah
		PROC
		PROC_DebugBook_Event("MinscRoahBribe", _Player)
		THEN
		PROC_State_Progress(S_LOW_Guildhall_SUB_adf8c225-5a74-4c9b-86ea-198aca6fabae, "LOW_Guildhall_State", "LOW_Guildhall_State_PreCoup");
		SetFlag((FLAG)LOW_CountingHouse_State_RobbersEscaped_16197488-9cc2-48e2-94ae-36225025d4d8);
		TeleportPartiesWithMovie((TRIGGER)S_LOW_MinscHideout_Debug_BribeSceneTeleportTrigger_204897e0-0246-4bc7-b423-ad5e1db840e1, "LOW_MinscHideout_Debug_TeleportedToRoahBribe", "");
		
		// Recruitment
		PROC
		PROC_DebugBook_Event("MinscSetupRecruitment", _Player)
		THEN
		TeleportTo(S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, _Player);
		SetFlag((FLAG)LOW_CountingHouse_State_RobbersEscaped_16197488-9cc2-48e2-94ae-36225025d4d8);
		ApplyStatus(S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, "KNOCKED_OUT", -1.0, 1, _Player);
		
		// Search for Boo
		PROC
		PROC_DebugBook_Event("MinscSearchForBoo", _Player)
		THEN
		SetFlag((FLAG)LOW_CountingHouse_State_RobbersEscaped_16197488-9cc2-48e2-94ae-36225025d4d8);
		SetFlag((FLAG)ORI_Minsc_State_SavedFromAbsolute_62e1d5ec-7c7e-70c2-68de-cadc7c7f5f20);
		SetFlag((FLAG)ORI_Minsc_State_SavingBoo_c0bb9916-a2e0-416a-9117-1724bc5854c4);
		ClearFlag((FLAG)ORI_Minsc_State_BooSaved_86765e52-75f0-4b7a-a346-c55265ec4af9);
		ClearFlag((FLAG)ORI_Minsc_State_ReunitedWithBoo_491635de-7395-5fe4-f8ce-be3288707a80);
		PROC_TeleportPartiesTo(S_LOW_MinscHideout_MinscMeetingPoint_df3a2aa8-e232-4100-9d53-578941868569, "LOW_MinscHideout_Debug_TeleportedToBoo");
		TeleportTo(S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, S_LOW_MinscHideout_MinscMeetingPoint_df3a2aa8-e232-4100-9d53-578941868569, "LOW_MinscHideout_Debug_TeleportedToBoo", 1, 1, 1, 1, 1);
		
		// Boo Reunion
		PROC
		PROC_DebugBook_Event("MinscBooReunion", _Player)
		THEN
		SetFlag((FLAG)LOW_CountingHouse_State_RobbersEscaped_16197488-9cc2-48e2-94ae-36225025d4d8);
		SetFlag((FLAG)ORI_Minsc_State_SavedFromAbsolute_62e1d5ec-7c7e-70c2-68de-cadc7c7f5f20);
		SetFlag((FLAG)ORI_Minsc_State_SavingBoo_c0bb9916-a2e0-416a-9117-1724bc5854c4);
		SetFlag((FLAG)ORI_Minsc_State_BooSaved_86765e52-75f0-4b7a-a346-c55265ec4af9);
		SetFlag((FLAG)ORI_Minsc_State_ReunitedWithBoo_491635de-7395-5fe4-f8ce-be3288707a80);
		TeleportPartiesWithMovie(S_LOW_MinscHideout_Debug_FindBooPos_dcf079db-cb12-4c05-a3a8-a9caa6e375f0, "LOW_MinscHideout_Debug_TeleportedToBoo", "");
		TeleportTo(S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, S_LOW_MinscHideout_Debug_FindBooPos_dcf079db-cb12-4c05-a3a8-a9caa6e375f0, "LOW_MinscHideout_Debug_TeleportedToBoo", 1, 1, 1, 1, 1);
		
		// Warning Nine-Fingers
		PROC
		PROC_DebugBook_Event("MinscWarnNineFingers", _Player)
		AND
		NOT DB_PartOfTheTeam((CHARACTER)S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba)
		THEN
		PROC_DebugBook_Event("MinscRecruitCompanion", _Player);
		
		PROC
		PROC_DebugBook_Event("MinscWarnNineFingers", _Player)
		THEN
		TeleportPartiesWithMovie(S_Debug_LOW_Guildhall_NineFingers_d2a4ae42-663f-49c0-85b6-40d490d373b0, "LOW_GuildHall_Debug_TeleportedToNineFingers", "");
		TeleportTo(S_Player_Minsc_0de603c5-42e2-4811-9dad-f652de080eba, S_Debug_LOW_Guildhall_NineFingers_d2a4ae42-663f-49c0-85b6-40d490d373b0, "LOW_GuildHall_Debug_TeleportedToNineFingers", 1, 1, 1, 1, 1);
		//END_REGION
	}
	EXIT
	{
	}
}
