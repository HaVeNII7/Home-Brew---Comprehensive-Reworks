		THEN
		NOT DB_END_General_SupremeTadpoleHolder(_Player);
		
		IF
		FlagSet(END_General_Event_DialogFullCeremorph_d968607c-405b-4a57-9956-477e9708b5b5, _Char, _)
		THEN
