		AND
		QRY_StartDialog_Fixed(HAG_Hagspawn_HusbandResurrected_772cdfca-b029-58f2-e08f-f9ed4ceeec2a, (CHARACTER)S_HAG_Hagspawn_HusbandJake_133bf997-7c0d-4c64-88c9-9b9cd439dbb5, _Character)
		THEN
