		THEN
		PROC_GLO_Backgrounds_CompleteGoal((CHARACTER)_Player, "Act1_FolkHero_Harpies");
		
		/*// Bugbear Ninja
		IF
		DialogEnded(DEN_Stargazing_80173a64-2d66-49af-ce22-918f8452d3a8, _DialogInstance)
		AND
		DB_DialogPlayers(_DialogInstance, _Player, _)
