		PROC
		PROC_END_General_TryStartSupremeTadpoleDialog((CHARACTER)_Player)
		AND
		DB_GlobalFlag(END_BrainBattle_Event_Started_3cd63c2e-7343-45dd-9137-4cabca2179a6)
		AND
