	}
	KB
	{
		//REGION Entrance checkpoint
		// Scene setup
		IF
		DB_WYR_Circus_EntranceSceneCharacter((CHARACTER)_Character)
		THEN
		PROC_SceneDialogOnly("WYR_Circus_EntranceCheckpoint_Scene", _Character, S_WYR_Circus_EntranceFamily_CheckpointSceneArea_a62463cd-7a1b-4bd3-9dfe-b61743f69c14);
		
		IF
		DB_SceneManager(_Character, "WYR_Circus_EntranceCheckpoint_Scene")
		AND
		NOT DB_WYR_Circus_EntranceSceneCharacter(_Character)
		THEN
		NOT DB_SceneManager(_Character, "WYR_Circus_EntranceCheckpoint_Scene");
		
		PROC
		PROC_StateSet_Defeated(_Character)
		AND
		DB_WYR_Circus_EntranceSceneCharacter((CHARACTER)_Character)
		THEN
		NOT DB_WYR_Circus_EntranceSceneCharacter(_Character);
		
		IF
		FlagSet((FLAG)WYR_Circus_State_CheckpointSceneEnded_570c10d7-b7b9-9805-c78e-c03375a5f051,_,_)
		THEN
		NOT DB_WYR_Circus_EntranceSceneCharacter(S_WYR_Circus_EntranceCivilian_30c7b090-5bc1-41d1-a87a-ae7b6ade6cfa);
		
		IF
		DB_PermaDefeatedOrOffstage(S_WYR_Circus_EntranceGuard_63ef213e-7a72-4126-9d5f-2f7d60ee9178)
		THEN
		PROC_SceneOver("WYR_Circus_EntranceCheckpoint_Scene");
		
		IF
		FlagSet(WYR_Circus_State_CheckpointGainedAccess_6c332552-395f-6f80-a0e7-d2450ab0812d,_,_)
		THEN
		PROC_SceneOver("WYR_Circus_EntranceCheckpoint_Scene");
		
		// Starting the dialog
		PROC
		PROC_BlockUseOfItem(_Player, S_WYR_Circus_EntranceGate_243c4eaa-d26b-4eda-8c04-b1f00c4d7492)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_State_CheckpointGainedAccess_6c332552-395f-6f80-a0e7-d2450ab0812d)
		AND
		CanSee((CHARACTER)S_WYR_Circus_EntranceGuard_63ef213e-7a72-4126-9d5f-2f7d60ee9178, _Player, 1)
		AND
		QRY_WYR_Circus_TryStartEntranceCheckpointDialog(_Player)
		THEN
		DB_CustomUseItemResponse(_Player, S_WYR_Circus_EntranceGate_243c4eaa-d26b-4eda-8c04-b1f00c4d7492, 0);
		
		PROC
		PROC_BlockLockpickItem(_Player, S_WYR_Circus_EntranceGate_243c4eaa-d26b-4eda-8c04-b1f00c4d7492)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_State_CheckpointGainedAccess_6c332552-395f-6f80-a0e7-d2450ab0812d)
		AND
		CanSee((CHARACTER)S_WYR_Circus_EntranceGuard_63ef213e-7a72-4126-9d5f-2f7d60ee9178, _Player, 1)
		AND
		QRY_WYR_Circus_TryStartEntranceCheckpointDialog(_Player)
		THEN
		DB_CustomLockpickItemResponse(_Player, S_WYR_Circus_EntranceGate_243c4eaa-d26b-4eda-8c04-b1f00c4d7492, 0);
		
		QRY
		QRY_SelectCustomDialog_AfterGenerics((CHARACTER)_NPC, (CHARACTER)_Player)
		AND
		DB_WYR_Circus_EntranceSceneCharacter(_NPC)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_State_CheckpointGainedAccess_6c332552-395f-6f80-a0e7-d2450ab0812d)
		AND
		QRY_WYR_Circus_TryStartEntranceCheckpointDialog(_Player)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_WYR_Circus_TryStartEntranceCheckpointDialog((CHARACTER)_Player)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_WYR_Circus_EntranceGuard_63ef213e-7a72-4126-9d5f-2f7d60ee9178, _Player)
		AND
		QRY_StartDialog_Fixed(
			(DIALOGRESOURCE)WYR_Circus_Checkpoint_5117a414-8890-f4db-a844-8bf632d62086,
			S_WYR_Circus_EntranceGuard_63ef213e-7a72-4126-9d5f-2f7d60ee9178,
			NULL_00000000-0000-0000-0000-000000000000,
			NULL_00000000-0000-0000-0000-000000000000,
			_Player)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers(WYR_Circus_Checkpoint_5117a414-8890-f4db-a844-8bf632d62086, _Inst)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_WYR_Circus_GhoulSniffer_cda5ce1f-c0d1-4e15-b1c5-0d785fa935bf, S_WYR_Circus_EntranceGuard_63ef213e-7a72-4126-9d5f-2f7d60ee9178)
		THEN
		PROC_DialogAddSpeakingActor(_Inst, S_WYR_Circus_GhoulSniffer_cda5ce1f-c0d1-4e15-b1c5-0d785fa935bf);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers(WYR_Circus_Checkpoint_5117a414-8890-f4db-a844-8bf632d62086, _Inst)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_State_CheckpointSceneEnded_570c10d7-b7b9-9805-c78e-c03375a5f051)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_WYR_Circus_EntranceCivilian_30c7b090-5bc1-41d1-a87a-ae7b6ade6cfa, S_WYR_Circus_EntranceGuard_63ef213e-7a72-4126-9d5f-2f7d60ee9178)
		THEN
		PROC_DialogAddSpeakingActor(_Inst, S_WYR_Circus_EntranceCivilian_30c7b090-5bc1-41d1-a87a-ae7b6ade6cfa);
		
		// Trespassing
		IF
		FlagSet(WYR_Circus_State_CheckpointGainedAccess_6c332552-395f-6f80-a0e7-d2450ab0812d,_,_)
		THEN
		PROC_RemoveDBTrespassTrigger(
			S_WYR_Circus_CheckpointTrespassArea_f3f8880b-fad4-4c33-816f-d620a5f9a6bf,
			S_WYR_Circus_CheckpointTrespassOutPos_081f81cb-3362-4f5a-a6df-569122f4b29e,
			(CHARACTER)S_WYR_Circus_EntranceGuard_63ef213e-7a72-4126-9d5f-2f7d60ee9178);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)WYR_Circus_State_CheckpointGainedAccess_6c332552-395f-6f80-a0e7-d2450ab0812d)
		AND
		NOT DB_Defeated(S_WYR_Circus_EntranceGuard_63ef213e-7a72-4126-9d5f-2f7d60ee9178)
		AND
		IsDestroyed(S_WYR_Circus_EntranceGate_243c4eaa-d26b-4eda-8c04-b1f00c4d7492, 0)
		AND
		NOT QRY_IsOpeneding(S_WYR_Circus_EntranceGate_243c4eaa-d26b-4eda-8c04-b1f00c4d7492)
		THEN
		Open(S_WYR_Circus_EntranceGate_243c4eaa-d26b-4eda-8c04-b1f00c4d7492);
		
		IF
		FlagSet((FLAG)WYR_Circus_State_CheckpointGainedAccess_6c332552-395f-6f80-a0e7-d2450ab0812d,_,_)
		THEN
		ClearOwnership((ITEM)S_WYR_Circus_EntranceGate_243c4eaa-d26b-4eda-8c04-b1f00c4d7492);
		
		IF
		EnteredTrigger(_Player, (TRIGGER)S_WYR_Circus_SUB_22d3f3ff-3cbb-4240-a3ab-051889832375)
		AND
		DB_PartyMembers(_Player)
		AND 
		NOT DB_GlobalFlag((FLAG)WYR_Circus_State_CheckpointGainedAccess_6c332552-395f-6f80-a0e7-d2450ab0812d)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_Circus_State_CheckpointGainedAccess_6c332552-395f-6f80-a0e7-d2450ab0812d);
		
		IF
		FlagSet((FLAG)WYR_Circus_Clown_State_Hostile_59c1f674-0985-4d4d-9679-b8a1e4982f45,_,_)
		AND 
		NOT DB_GlobalFlag((FLAG)WYR_Circus_State_CheckpointGainedAccess_6c332552-395f-6f80-a0e7-d2450ab0812d)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_Circus_State_CheckpointGainedAccess_6c332552-395f-6f80-a0e7-d2450ab0812d);
		
		IF
		FlagSet(WYR_Circus_State_CheckpointGainedAccess_6c332552-395f-6f80-a0e7-d2450ab0812d,_,_)
		THEN
		ClearTag(S_WYR_Circus_EntranceGuard_63ef213e-7a72-4126-9d5f-2f7d60ee9178, (TAG)ACT3_WYR_CIRCUS_CANTOPEN_FRONTGATE_a26aebde-e284-4ee6-8103-79fcea12fe95);
		
		IF
		Opened(S_WYR_Circus_EntranceGate_243c4eaa-d26b-4eda-8c04-b1f00c4d7492)
		THEN
		ClearTag(S_WYR_Circus_EntranceGuard_63ef213e-7a72-4126-9d5f-2f7d60ee9178, (TAG)ACT3_WYR_CIRCUS_CANTOPEN_FRONTGATE_a26aebde-e284-4ee6-8103-79fcea12fe95);
		
		// Asking questions
		IF
		FlagSet(WYR_Circus_Event_CheckpointAskedQuestion_3cc9ed1d-5776-f570-959f-4e809c24dc85, _Player, _)
		AND
		DB_WYR_Circus_CheckpointQuestionsAsked((CHARACTER)_Player,_CurrentCount)
		AND
		IntegerSum(_CurrentCount, 1, _NewCount)
		THEN
		NOT DB_WYR_Circus_CheckpointQuestionsAsked(_Player, _CurrentCount);
		DB_WYR_Circus_CheckpointQuestionsAsked((CHARACTER)_Player, _NewCount);
		
		IF
		FlagSet(WYR_Circus_Event_CheckpointAskedQuestion_3cc9ed1d-5776-f570-959f-4e809c24dc85, _Player, _)
		AND
		NOT DB_WYR_Circus_CheckpointQuestionsAsked((CHARACTER)_Player,_)
		THEN
		DB_WYR_Circus_CheckpointQuestionsAsked((CHARACTER)_Player, 1);
		
		IF
		FlagSet(WYR_Circus_Event_CheckpointAskedQuestion_3cc9ed1d-5776-f570-959f-4e809c24dc85, _Player, _DialogInstance)
		THEN
		ClearFlag(WYR_Circus_Event_CheckpointAskedQuestion_3cc9ed1d-5776-f570-959f-4e809c24dc85, _Player, _DialogInstance);
		
		IF
		DB_WYR_Circus_CheckpointQuestionsAsked(_Player, _Count)
		AND
		_Count >= 2
		THEN
		SetFlag((FLAG)WYR_Circus_State_CheckpointAskedTooMany_ac7f416a-c267-3506-b42b-e9360d39b9fd, _Player, 0);
		
		// Splatter
		PROC
		PROC_DialogFlagSetup((DIALOGRESOURCE)WYR_Circus_Checkpoint_5117a414-8890-f4db-a844-8bf632d62086, _,_,_, _Player)
		AND
		GetAppliedSplatterLevel(_Player, SPLATTERTYPE.Dirt, _SplatterLevel)
		AND
		DB_WYR_Circus_SplattersLevels(_SplatterLevel)
		THEN
		DB_WYR_Circus_PlayerSplatterFlags((FLAG)WYR_Circus_State_Dirty_b4c3e532-1230-7b41-ca72-a452f26bdd7e, (CHARACTER)_Player);
		
		PROC
		PROC_DialogFlagSetup((DIALOGRESOURCE)WYR_Circus_Checkpoint_5117a414-8890-f4db-a844-8bf632d62086, _,_,_, _Player)
		AND
		GetAppliedSplatterLevel(_Player, SPLATTERTYPE.Blood, _SplatterLevel)
		AND
		DB_WYR_Circus_SplattersLevels(_SplatterLevel)
		THEN
		DB_WYR_Circus_PlayerSplatterFlags((FLAG)WYR_Circus_Checkpoint_State_Bloodied_f7587580-c1e1-32ad-a3df-5c895e539567, (CHARACTER)_Player);
		
		IF
		DB_WYR_Circus_PlayerSplatterFlags((FLAG)_Flag, (CHARACTER)_Player)
		THEN
		SetFlag(_Flag, _Player, 0);
		
		IF
		DialogActorLeft((DIALOGRESOURCE)WYR_Circus_Checkpoint_5117a414-8890-f4db-a844-8bf632d62086, _, _Player, _)
		AND
		DB_WYR_Circus_PlayerSplatterFlags(_Flag, (CHARACTER)_Player)
		THEN
		NOT DB_WYR_Circus_PlayerSplatterFlags(_Flag, (CHARACTER)_Player);
		ClearFlag(_Flag, _Player, 0);
		
		// Entrance civilian
		IF
		DB_InRegion(_, (TRIGGER)S_WYR_Circus_SUB_22d3f3ff-3cbb-4240-a3ab-051889832375)
		AND 
		DB_GlobalFlag((FLAG)WYR_Circus_State_CheckpointGainedAccess_6c332552-395f-6f80-a0e7-d2450ab0812d)
		AND
		NOT DB_GlobalFlag(WYR_Circus_EntranceCivilian_Event_PlayerEntered_81faaf61-0a04-4b1b-9dbc-330e1d310a58)
		AND 
		NOT DB_GlobalFlag((FLAG)WYR_Circus_Clown_State_Hostile_59c1f674-0985-4d4d-9679-b8a1e4982f45)
		AND
		NOT DB_WYR_Circus_EntranceCivilian_CanEnterTimerStarted(1)
		THEN
		DB_WYR_Circus_EntranceCivilian_CanEnterTimerStarted(1);
		TimerLaunch("WYR_Circus_EntranceCivilianCanEnter_Timer", 3000);
		
		IF
		TimerFinished("WYR_Circus_EntranceCivilianCanEnter_Timer")
		AND
		DB_WYR_Circus_EntranceCivilian_CanEnterTimerStarted(1)
		THEN
		PROC_GlobalSetFlagAndCache(WYR_Circus_EntranceCivilian_Event_PlayerEntered_81faaf61-0a04-4b1b-9dbc-330e1d310a58);
		NOT DB_WYR_Circus_EntranceCivilian_CanEnterTimerStarted(1);
		
		PROC
		PROC_WYR_Circus_OnCombatStarted()
		AND
		NOT DB_PermaDefeatedOrOffstage(S_WYR_Circus_EntranceCivilian_30c7b090-5bc1-41d1-a87a-ae7b6ade6cfa)
		AND
		IsInTrigger(S_WYR_Circus_EntranceCivilian_30c7b090-5bc1-41d1-a87a-ae7b6ade6cfa, (TRIGGER)S_WYR_Circus_SUB_22d3f3ff-3cbb-4240-a3ab-051889832375, 0)
		THEN
		PROC_DisappearOutOfSightTo(S_WYR_Circus_EntranceCivilian_30c7b090-5bc1-41d1-a87a-ae7b6ade6cfa, S_WYR_Circus_PatronsOutsideLeavePos_c85479f5-c2d3-435c-a169-031cb6789967, "Run", 0, "");
		
		IF
		FlagSet((FLAG)WYR_Circus_State_PostCombat_ee4b2f6e-9d52-4bc5-bde6-bc0e1c015de4,_,_)
		AND
		NOT DB_PermaDefeatedOrOffstage(S_WYR_Circus_EntranceCivilian_30c7b090-5bc1-41d1-a87a-ae7b6ade6cfa)
		THEN
		PROC_DisappearOutOfSightTo(S_WYR_Circus_EntranceCivilian_30c7b090-5bc1-41d1-a87a-ae7b6ade6cfa, S_WYR_Circus_PatronsOutsideLeavePos_c85479f5-c2d3-435c-a169-031cb6789967, "Run", 0, "");
		
		// Son & Father at the entrance
		PROC
		PROC_SceneInterrupted(_, _Player, "WYR_Circus_EntranceCheckpoint_Scene", "DisturbanceRegistering")
		THEN
		PROC_WYR_Circus_ProcessGroupSceneInterrupted((CHARACTER)_Player, "WYR_Circus_EntranceFamily_SceneDialogOnly");
		
		// disappear immediately if combat starts
		IF
		FlagSet((FLAG)WYR_Circus_Clown_State_Hostile_59c1f674-0985-4d4d-9679-b8a1e4982f45,_,_)
		AND
		DB_WYR_Circus_ShowPatrons_DisappearGroup("WYR_Circus_EntranceFamily_SceneDialogOnly", _Character, _,_)
		THEN
		PROC_WYR_Circus_GroupScene_ForceEndForCharacter(_Character);
		
		// walk away if the player enters the circus (I guess they decided no to go after all...)
		IF
		DB_InRegion(_, (TRIGGER)S_WYR_Circus_SUB_22d3f3ff-3cbb-4240-a3ab-051889832375)
		AND 
		DB_GlobalFlag((FLAG)WYR_Circus_State_CheckpointGainedAccess_6c332552-395f-6f80-a0e7-d2450ab0812d)
		AND
		NOT DB_WYR_Circus_EntranceFamily_EnteredCircusTimerStarted(1)
		THEN
		DB_WYR_Circus_EntranceFamily_EnteredCircusTimerStarted(1);
		TimerLaunch("WYR_Circus_EntranceFamilyEnteredCircus_Timer", 6000);
		
		IF
		TimerFinished("WYR_Circus_EntranceFamilyEnteredCircus_Timer")
		AND
		DB_WYR_Circus_ShowPatrons_DisappearGroup("WYR_Circus_EntranceFamily_SceneDialogOnly", _Character, _,_)
		AND
		NOT DB_PermaDefeatedOrOffstage(_Character)
		THEN
		PROC_SceneOver("WYR_Circus_EntranceFamily_SceneDialogOnly");
		PROC_NotifyWhenReadyToMoveOn(_Character, "WYR_Circus_EntranceFamilyEnteredCircus_Notify");
		
		PROC
		PROC_ReadyToMoveOn(_Character, "WYR_Circus_EntranceFamilyEnteredCircus_Notify")
		AND
		DB_WYR_Circus_ShowPatrons_DisappearGroup(_Scene, _Character, _SceneTrigger, _LeaveToTrigger)
		THEN
		NOT DB_WYR_Circus_ShowPatrons_DisappearGroup(_Scene, _Character, _SceneTrigger, _LeaveToTrigger);
		PurgeOsirisQueue(_Character);
		PROC_DisappearOutOfSightTo(_Character, _LeaveToTrigger, "Walk", 0, "");
		//END_REGION
		
		//REGION Patrons
		IF
		DB_WYR_Circus_ShowPatrons(_Character,_,_)
		THEN
		PROC_SelfHealing_Disable(_Character);
		
		IF
		DB_WYR_Circus_ShowPatrons(_Patron, "Run", _)
		THEN
		SetFlag((FLAG)GEB_DontAppearAfter_a1085866-f30e-4165-865c-9992feec580e, _Patron, 0);
		
		// Patrons run offstage when combat starts
		PROC
		PROC_WYR_Circus_OnCombatStarted()
		AND
		DB_WYR_Circus_ShowPatrons(_Patron, "Run", _)
		AND
		NOT DB_PermaDefeatedOrOffstage(_Patron)
		AND
		NOT DB_WYR_Circus_PatronReadyToRun(_Patron)
		THEN
		SetCanJoinCombat(_Patron, 0);
		LeaveCombat(_Patron);
		DB_WYR_Circus_PatronReadyToRun(_Patron);
		
		IF
		DB_WYR_Circus_PatronReadyToRun(_Patron)
		AND
		NOT DB_CantMove(_Patron)
		AND
		NOT DB_Is_PolymorphedByPlayer(_Patron)
		AND
		NOT DB_Defeated(_Patron)
		AND
		NOT DB_Offstage(_Patron)
		THEN
		NOT DB_WYR_Circus_PatronReadyToRun(_Patron);
		PROC_CancelDisappearOutOfSight(_Patron);
		PurgeOsirisQueue(_Patron);
		PROC_DisappearOutOfSightTo(_Patron, S_WYR_Circus_PatronsDisappearPos_af65c343-97f2-4e76-b4fc-3be88fcc5328, "Run", 0, "");
		
		// Patrons flee combat to a more safe location in the circus
		PROC
		PROC_WYR_Circus_OnCombatStarted()
		AND
		DB_WYR_Circus_ShowPatrons(_Patron, "Flee",_)
		AND
		DB_WYR_Circus_ShowPatrons_FleePos(_Patron, _PosTrigger)
		AND
		NOT DB_WYR_Circus_PatronReadyToFlee(_Patron, _)
		THEN
		DB_WYR_Circus_PatronReadyToFlee(_Patron, _PosTrigger);
		
		IF
		DB_WYR_Circus_PatronReadyToFlee((CHARACTER)_Patron, (TRIGGER)_PosTrigger)
		AND
		NOT DB_WYR_Circus_PatronEnableCanJoinCombat(_Patron)
		AND
		CanJoinCombat(_Patron, 1)
		THEN
		DB_WYR_Circus_PatronEnableCanJoinCombat(_Patron);
		SetCanJoinCombat(_Patron, 0);
		LeaveCombat(_Patron);
		
		IF
		DB_WYR_Circus_PatronReadyToFlee((CHARACTER)_NPC, (TRIGGER)_PosTrigger)
		AND
		NOT DB_CantMove(_NPC)
		AND
		NOT DB_Is_PolymorphedByPlayer(_NPC)
		AND
		NOT DB_Defeated(_NPC)
		AND
		NOT DB_Offstage(_NPC)
		THEN
		NOT DB_WYR_Circus_PatronReadyToFlee(_NPC, _PosTrigger);
		PROC_CharacterMoveTo(_NPC, _PosTrigger, "Run", "WYR_Circus_Event_PatronFleesOnCombataStart");
		
		IF
		EntityEvent(_Patron, "WYR_Circus_Event_PatronFleesOnCombataStart")
		AND
		NOT DB_PermaDefeatedOrOffstage(_Patron)
		AND
		DB_WYR_Circus_PatronEnableCanJoinCombat((CHARACTER)_Patron)
		THEN
		SetCanJoinCombat(_Patron, 1);
		SetCanFight(_Patron, 1);
		
		IF
		EntityEvent(_Patron, "WYR_Circus_Event_PatronFleesOnCombataStart")
		AND
		DB_WYR_Circus_ShowPatrons_Flee_SubstituteDisappearGroup(_Scene2, (CHARACTER)_Patron, _SceneArea2, _DisappearPos2)
		AND
		DB_WYR_Circus_ShowPatrons_DisappearGroup(_Scene, (CHARACTER)_Patron, _SceneArea, _DisappearPos)
		THEN
		PROC_SceneOver(_Scene);
		NOT DB_WYR_Circus_ShowPatrons_DisappearGroup(_Scene, _Patron, _SceneArea, _DisappearPos);
		DB_WYR_Circus_ShowPatrons_DisappearGroup(_Scene2, _Patron, _SceneArea2, _DisappearPos2);
		
		// ADs during combat
		IF
		TurnStarted((CHARACTER)_Player)
		AND
		DB_GlobalFlag((FLAG)WYR_Circus_Clown_State_Hostile_59c1f674-0985-4d4d-9679-b8a1e4982f45)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_State_PostCombat_ee4b2f6e-9d52-4bc5-bde6-bc0e1c015de4)
		AND
		DB_PartyMembers(_Player)
		AND
		DB_WYR_Circus_ShowPatrons_CombatBark(_Patron, _AD)
		AND
		NOT DB_CantTalk_IgnoreCombat(_Patron)
		AND
		NOT DB_WYR_Circus_CombatBarksBlocked(_)
		AND
		DB_Sees(_Player, _Patron)
		THEN
		DB_WYR_Circus_CombatBarksBlocked(_AD);
		PROC_TryStartAD(_AD, _Patron);
		
		IF
		AutomatedDialogEnded(_AD, _)
		AND
		DB_WYR_Circus_CombatBarksBlocked(_AD)
		THEN
		PROC_WYR_Circus_UnblockCombatBarks(_AD);
		
		IF
		AutomatedDialogRequestFailed(_AD, _)
		AND
		DB_WYR_Circus_CombatBarksBlocked(_AD)
		THEN
		PROC_WYR_Circus_UnblockCombatBarks(_AD);
		
		IF
		AutomatedDialogForceStopping(_AD, _)
		AND
		DB_WYR_Circus_CombatBarksBlocked(_AD)
		THEN
		PROC_WYR_Circus_UnblockCombatBarks(_AD);
		
		PROC
		PROC_WYR_Circus_UnblockCombatBarks((DIALOGRESOURCE)_AD)
		THEN
		NOT DB_WYR_Circus_CombatBarksBlocked(_AD);
		
		PROC
		PROC_WYR_Circus_UnblockCombatBarks((DIALOGRESOURCE)_AD)
		AND
		DB_WYR_Circus_ShowPatrons_CombatBark(_Patron, _AD)
		THEN
		NOT DB_WYR_Circus_ShowPatrons_CombatBark(_Patron, _AD);
		
		PROC
		PROC_StateSet_PermaDefeated(_Patron)
		AND
		DB_WYR_Circus_ShowPatrons_CombatBark((CHARACTER)_Patron, _AD)
		THEN
		NOT DB_WYR_Circus_ShowPatrons_CombatBark((CHARACTER)_Patron, _AD);
		
		// Combat ends for the patrons
		IF
		DB_GlobalFlag((FLAG)WYR_Circus_State_PostCombat_ee4b2f6e-9d52-4bc5-bde6-bc0e1c015de4)
		AND
		DB_WYR_Circus_ShowPatrons(_Patron, "Stay", "Kill")
		AND
		NOT DB_PermaDefeatedOrOffstage(_Patron)
		AND
		NOT DB_Is_InCombat(_Patron, _)
		AND
		NOT DB_WYR_Circus_PatronCanFightEnabled(_Patron)
		THEN
		DB_WYR_Circus_PatronCanFightEnabled(_Patron);
		PROC_SetCanFight(_Patron, 1);
		
		// Disappear on scene interruption
		IF
		DB_WYR_Circus_ShowPatrons_DisappearGroup((STRING)_SceneID, (CHARACTER)_Character, (TRIGGER)_SceneTrigger, _)
		THEN
		DB_WYR_Circus_DisappearScene((STRING)_SceneID);
		PROC_SceneDialogOnly(_SceneID, _Character, _SceneTrigger);
		SetFlag((FLAG)GEB_DontAppearAfter_a1085866-f30e-4165-865c-9992feec580e, _Character, 0);
		
		IF
		DB_WYR_Circus_DisappearScene((STRING)_SceneID)
		AND
		NOT DB_WYR_Circus_ShowPatrons_DisappearGroup((STRING)_SceneID, _,_,_)
		THEN
		NOT DB_WYR_Circus_DisappearScene(_SceneID);
		
		PROC
		PROC_SceneInterrupted(_, _Player, _Scene, "DisturbanceRegistering")
		AND
		DB_WYR_Circus_DisappearScene(_Scene)
		THEN
		PROC_WYR_Circus_ProcessGroupSceneInterrupted((CHARACTER)_Player, _Scene);
		
		PROC
		PROC_WYR_Circus_ProcessGroupSceneInterrupted((CHARACTER)_Player, (STRING)_Scene)
		AND
		DB_SceneManager_DisturbanceRegistering(_Player, _Reason, _,_,_, _CrimeID)
		AND
		QRY_CRIME_IsAssaultOrMurder(_Reason)
		AND
		DB_WYR_Circus_ShowPatrons_DisappearGroup(_Scene, _Character, _,_)
		AND
		NOT DB_PermaDefeatedOrOffstage(_Character)
		THEN
		PROC_SceneOver(_Scene);
		PROC_NotifyWhenReadyToMoveOn(_Character, "WYR_Circus_DisappearGroupInterrupted_Notify");
		
		PROC
		PROC_ReadyToMoveOn(_Character, "WYR_Circus_DisappearGroupInterrupted_Notify")
		AND
		DB_WYR_Circus_ShowPatrons_DisappearGroup(_Scene, _Character, _SceneTrigger, _LeaveToTrigger)
		THEN
		NOT DB_WYR_Circus_ShowPatrons_DisappearGroup(_Scene, _Character, _SceneTrigger, _LeaveToTrigger);
		SetCanJoinCombat(_Character, 0);
		PROC_SetCanFight(_Character, 0);
		PROC_DisappearOutOfSightTo(_Character, _LeaveToTrigger, "Sprint", 0, "");
		
		// force ending for some custom cases
		PROC
		PROC_WYR_Circus_GroupScene_ForceEndForCharacter((CHARACTER)_Character)
		AND
		DB_WYR_Circus_ShowPatrons_DisappearGroup(_Scene, _Character, _,_)
		AND
		NOT DB_PermaDefeatedOrOffstage(_Character)
		THEN
		PROC_SceneOver(_Scene);
		PROC_NotifyWhenReadyToMoveOn(_Character, "WYR_Circus_DisappearGroupInterrupted_Notify");
		//END_REGION
		
		//REGION Clown show: Scene
		PROC
		PROC_WYR_Circus_InitShowScene()
		AND
		DB_WYR_Circus_PartOfShowScene(_Character, _,_,_)
		THEN
		DB_SceneManager(_Character, "WYR_Circus_ClownPreShowScene"); 
		
		PROC
		PROC_WYR_Circus_InitShowScene()
		THEN
		DB_SpotPlayers(S_WYR_Circus_Clown_21f541c1-e1bc-49a8-888f-d8a330c47336, "WYR_Circus_ClownPreShowScene", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		DB_SpotPlayers_SpotTrigger(S_WYR_Circus_Clown_21f541c1-e1bc-49a8-888f-d8a330c47336, "WYR_Circus_ClownPreShowScene", S_WYR_Circus_ClownPreShowSpotArea_0fb69c88-839a-4132-950e-a43f297d273e);
		
		PROC
		PROC_SceneInterrupted(_, _, "WYR_Circus_ClownPreShowScene", _Interruption)
		AND
		DB_GLO_GenericSceneManager_ViolenceReason(_Interruption)
		THEN
		PROC_WYR_Circus_StartCombat();
		//END_REGION
		
		//REGION Clown show: Pre-show dialog 
		PROC
		PROC_SpotPlayers_Spotted(_, "WYR_Circus_ClownPreShowScene", _Player)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_Clown_State_Hostile_59c1f674-0985-4d4d-9679-b8a1e4982f45)
		AND
		QRY_GetClosestAvailableCharacterTo(_Player, 0)
		AND
		DB_ClosestAvailableCharacterTo_PreferAvatar(_ClosestAvatar, _Player, _, 1)
		AND
		QRY_SpeakerIsAvailable(_ClosestAvatar, 0, 0)
		AND
		IsInTrigger(_ClosestAvatar, S_WYR_Circus_ClownPreShowAddToDialogArea_fb3d57c2-5ccd-4b7a-a885-feb2fd6898aa, 1)
		AND
		QRY_OnlyOnce("WYR_Circus_ClownPreShowSceneStarted_OnlyOnce")
		AND
		NOT QRY_StartDialog_Fixed(
			(DIALOGRESOURCE)WYR_Circus_Clown_PreShow_3201c8cc-8a13-cd0d-3b3c-d89bec8ba767, 
			S_WYR_Circus_Clown_21f541c1-e1bc-49a8-888f-d8a330c47336,
			S_WYR_Circus_Beast_03_fd8e7a4b-38cf-40c3-b4bf-8bbe084b5ca3,
			S_WYR_Circus_CuriousFan_48b86ab3-bf79-4466-b44d-1342ee76d57f,
			S_WYR_Circus_FanClubKid_02_6afc0210-436a-4ec0-99b1-f95140b3557d,
			_ClosestAvatar)
		THEN
		PROC_WYR_Circus_StartCombat();
		
		PROC
		PROC_SpotPlayers_Spotted(_, "WYR_Circus_ClownPreShowScene", _Player)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_Clown_State_Hostile_59c1f674-0985-4d4d-9679-b8a1e4982f45)
		AND
		NOT DB_OnlyOnce("WYR_Circus_ClownPreShowSceneStarted_OnlyOnce")
		AND
		NOT QRY_StartDialog_Fixed(
			(DIALOGRESOURCE)WYR_Circus_Clown_PreShow_3201c8cc-8a13-cd0d-3b3c-d89bec8ba767, 
			S_WYR_Circus_Clown_21f541c1-e1bc-49a8-888f-d8a330c47336,
			S_WYR_Circus_Beast_03_fd8e7a4b-38cf-40c3-b4bf-8bbe084b5ca3,
			S_WYR_Circus_CuriousFan_48b86ab3-bf79-4466-b44d-1342ee76d57f,
			S_WYR_Circus_FanClubKid_02_6afc0210-436a-4ec0-99b1-f95140b3557d,
			_Player)
		THEN
		PROC_WYR_Circus_StartCombat();
		
		QRY
		QRY_SelectCustomDialog_AfterGenerics((CHARACTER)_NPC, (CHARACTER)_Player)
		AND
		DB_WYR_Circus_PartOfShowScene(_NPC, 1,_,_)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_Clown_State_Hostile_59c1f674-0985-4d4d-9679-b8a1e4982f45)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_State_PostCombat_ee4b2f6e-9d52-4bc5-bde6-bc0e1c015de4)
		THEN
		DB_SelectedDialog(
			(DIALOGRESOURCE)WYR_Circus_Clown_PreShow_3201c8cc-8a13-cd0d-3b3c-d89bec8ba767, 
			S_WYR_Circus_Clown_21f541c1-e1bc-49a8-888f-d8a330c47336,
			S_WYR_Circus_Beast_03_fd8e7a4b-38cf-40c3-b4bf-8bbe084b5ca3,
			S_WYR_Circus_CuriousFan_48b86ab3-bf79-4466-b44d-1342ee76d57f,
			S_WYR_Circus_FanClubKid_02_6afc0210-436a-4ec0-99b1-f95140b3557d,
			_Player);
		PROC_SpotPlayers_StopSpotting(S_WYR_Circus_Clown_21f541c1-e1bc-49a8-888f-d8a330c47336, "WYR_Circus_ClownPreShowScene");
		
		PROC
		PROC_StartDialog_AddExtraSpeakers(WYR_Circus_Clown_PreShow_3201c8cc-8a13-cd0d-3b3c-d89bec8ba767, _Inst)
		AND
		DB_WYR_Circus_PartOfShowScene(_Character, _,1,_)
		THEN
		PROC_DialogAddSpeakingActor(_Inst, _Character);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers(WYR_Circus_Clown_PreShow_3201c8cc-8a13-cd0d-3b3c-d89bec8ba767, _Inst)
		AND
		DB_Avatars(_Avatar)
		AND
		NOT DB_Is_WildShaped(_Avatar) // Cine request
		AND
		IsInTrigger(_Avatar, S_WYR_Circus_ClownPreShowAddToDialogArea_fb3d57c2-5ccd-4b7a-a885-feb2fd6898aa, 1)
		THEN
		PROC_DialogAddListeningActor(_Inst, _Avatar);
		
		IF
		DialogRequestFailed(WYR_Circus_Clown_PreShow_3201c8cc-8a13-cd0d-3b3c-d89bec8ba767, _)
		THEN
		PROC_WYR_Circus_StartCombat();
		
		// cant-t move and approach the scene
		PROC
		PROC_DialogFlagSetup(WYR_Circus_Clown_PreShow_3201c8cc-8a13-cd0d-3b3c-d89bec8ba767, _,_,_,_,_)
		AND
		DB_DialogRequestCache_SpeakerList_Players(WYR_Circus_Clown_PreShow_3201c8cc-8a13-cd0d-3b3c-d89bec8ba767, _, _Player, _)
		AND
		DB_Is_EngineBlock_Move((CHARACTER)_Player)
		THEN
		SetFlag((FLAG)WYR_Circus_State_PreShowCantMove_a3f94e23-c024-4f37-b8e7-b89e0d5cd911, _Player);
		
		IF
		DialogEnded(WYR_Circus_Clown_PreShow_3201c8cc-8a13-cd0d-3b3c-d89bec8ba767, _Inst)
		AND
		DB_DialogPlayers(_Inst, _Player, _)
		AND
		GetFlag(WYR_Circus_State_PreShowCantMove_a3f94e23-c024-4f37-b8e7-b89e0d5cd911, _Player, 1)
		THEN
		ClearFlag(WYR_Circus_State_PreShowCantMove_a3f94e23-c024-4f37-b8e7-b89e0d5cd911, _Player);
		
		// Damage from the dialog
		PROC
		PROC_FlagReactionAfterDialog(_Character, (FLAG)WYR_Circus_Event_StabPlayer_85cec1bd-2d3f-4b68-4ecf-6bb6da53e611)
		AND
		NOT DB_Defeated(S_WYR_Circus_Beast_03_fd8e7a4b-38cf-40c3-b4bf-8bbe084b5ca3)
		AND
		GetDistanceTo(S_WYR_Circus_Beast_03_fd8e7a4b-38cf-40c3-b4bf-8bbe084b5ca3, _Character, _Distance)
		AND
		_Distance < 10.0
		THEN
		PROC_WYR_Circus_BeastAttacks((CHARACTER)_Character);
		
		PROC
		PROC_WYR_Circus_BeastAttacks((CHARACTER)_Character)
		THEN
		Attack(S_WYR_Circus_Beast_03_fd8e7a4b-38cf-40c3-b4bf-8bbe084b5ca3, _Character, 1);
		
		PROC
		PROC_WYR_Circus_BeastAttacks((CHARACTER)_Character)
		AND
		HasActiveStatus(_Character, "PRONE_FALLEN", 0)
		THEN
		ApplyStatus(_Character, "PRONE_FALLEN", 6.0, 0, S_WYR_Circus_Beast_03_fd8e7a4b-38cf-40c3-b4bf-8bbe084b5ca3);
		//END_REGION
		
		//REGION Clown show: Companion branch for the Show dialog
		IF
		FlagSet((FLAG)WYR_Circus_Event_ShowSendCompanion_17c5041c-d83e-cd5b-9ba6-feba725e81e5, _Companion, _DialogInstance)
		AND
		NOT DB_WYR_Circus_ShowSendCompanion(_,_,_)
		AND
		DB_DialogPlayers(_DialogInstance, _Player, _Index)
		THEN
		DB_WYR_Circus_ShowSendCompanion((CHARACTER)_Companion, (CHARACTER)_Player, _Index);
		
		IF
		DialogEnded(WYR_Circus_Clown_PreShow_3201c8cc-8a13-cd0d-3b3c-d89bec8ba767,_Instance)
		AND
		DB_WYR_Circus_ShowSendCompanion(_Companion, _Player, 1)
		AND
		NOT QRY_StartDialog_Fixed(
			(DIALOGRESOURCE)WYR_Circus_Clown_PreShow_Companions_d901ebe4-cd17-36f4-b21b-c0654eb4d99a, 
			S_WYR_Circus_Clown_21f541c1-e1bc-49a8-888f-d8a330c47336,
			S_WYR_Circus_Beast_03_fd8e7a4b-38cf-40c3-b4bf-8bbe084b5ca3,
			S_WYR_Circus_FanClubKid_02_6afc0210-436a-4ec0-99b1-f95140b3557d,
			_Companion,
			_Player)
		THEN
		PROC_WYR_Circus_StartCombat();
		
		PROC
		PROC_StartDialog_AddExtraSpeakers(WYR_Circus_Clown_PreShow_Companions_d901ebe4-cd17-36f4-b21b-c0654eb4d99a, _Inst)
		AND
		DB_WYR_Circus_PartOfShowScene(_Character, _,_,1)
		THEN
		PROC_DialogAddSpeakingActor(_Inst, _Character);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers(WYR_Circus_Clown_PreShow_Companions_d901ebe4-cd17-36f4-b21b-c0654eb4d99a, _Inst)
		AND
		DB_WYR_Circus_ShowSendCompanion(_, _Avatar, _Index)
		AND
		_Index != 1
		AND
		DB_Avatars(_Avatar)
		AND
		IsInTrigger(_Avatar, S_WYR_Circus_ClownPreShowAddToDialogArea_fb3d57c2-5ccd-4b7a-a885-feb2fd6898aa, 1)
		THEN
		PROC_DialogAddListeningActor(_Inst, _Avatar);
		
		IF
		DialogEnded(WYR_Circus_Clown_PreShow_Companions_d901ebe4-cd17-36f4-b21b-c0654eb4d99a,_)
		THEN
		PROC_WYR_Circus_StartCombat();
		
		PROC
		PROC_WYR_Circus_OnCombatStarted()
		AND
		DB_WYR_Circus_ShowSendCompanion(_Companion, _Player, _Index)
		THEN
		NOT DB_WYR_Circus_ShowSendCompanion(_Companion, _Player, _Index);
		//END_REGION
		
		//REGION Clown show: Interruptions handling
		IF
		DialogEnded(WYR_Circus_Clown_PreShow_3201c8cc-8a13-cd0d-3b3c-d89bec8ba767,_)
		AND
		NOT DB_WYR_Circus_ShowSendCompanion(_,_,_)
		THEN
		PROC_WYR_Circus_StartCombat();
		
		IF
		DialogEnded(WYR_Circus_Clown_PreShow_3201c8cc-8a13-cd0d-3b3c-d89bec8ba767,_)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_Event_ClownTriggersAttack_5184f147-8f58-5954-0089-86b6d3b2e410)
		THEN
		PROC_SpotPlayers_RestartSpotting(S_WYR_Circus_Clown_21f541c1-e1bc-49a8-888f-d8a330c47336,"WYR_Circus_ClownPreShowScene");
		
		IF
		FlagSet((FLAG)WYR_Circus_Event_GoOnStage_1f416988-6a27-4564-01a2-7e32954fa1af,_Character,_)
		THEN
		PROC_CharacterMoveTo((CHARACTER)_Character, S_WYR_Circus_PlayerShowPos_a845d9c7-2c31-4928-b394-ab3ee86c46ad,"Sprint","WYR_Circus_WentOnDribblesStage");
		
		// beast on the stage
		QRY
		QRY_SelectADForRequest((CHARACTER)S_WYR_Circus_Beast_03_fd8e7a4b-38cf-40c3-b4bf-8bbe084b5ca3, (CHARACTER)_Player)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_WYR_Circus_DoppelClown_21f541c1-e1bc-49a8-888f-d8a330c47336, _Player)
		THEN
		DB_SelectedDialog(
			(DIALOGRESOURCE)WYR_Circus_Clown_1e8e8b23-51b3-8399-9dd7-ab269ae938ba, 
			S_WYR_Circus_Clown_21f541c1-e1bc-49a8-888f-d8a330c47336,
			_Player);
		//END_REGION
		
		//REGION Clown show: Combat Starts
		PROC
		PROC_WYR_Circus_StartCombat()
		AND
		DB_WYR_Circus_ShowSendCompanion(_Companion, _, _)
		THEN
		SetHasDialog(_Companion, 1);
		
		PROC
		PROC_WYR_Circus_StartCombat()
		AND
		NOT DB_GlobalFlag(WYR_Circus_Clown_State_Hostile_59c1f674-0985-4d4d-9679-b8a1e4982f45)
		AND
		NOT DB_GlobalFlag(WYR_Circus_State_PostCombat_ee4b2f6e-9d52-4bc5-bde6-bc0e1c015de4)
		THEN
		PROC_SceneOver("WYR_Circus_ClownPreShowScene");
		PROC_SpotPlayers_StopSpotting(S_WYR_Circus_Clown_21f541c1-e1bc-49a8-888f-d8a330c47336, "WYR_Circus_ClownPreShowScene");
		PROC_GlobalSetFlagAndCache(WYR_Circus_Clown_State_Hostile_59c1f674-0985-4d4d-9679-b8a1e4982f45);
		PROC_WYR_Circus_OnCombatStarted();
		
		PROC
		PROC_WYR_Circus_OnCombatStarted()
		AND
		NOT DB_PermaDefeated(WYR_Circus_Clown_1e8e8b23-51b3-8399-9dd7-ab269ae938ba)
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(WYR_Circus_Clown_1e8e8b23-51b3-8399-9dd7-ab269ae938ba);
		
		PROC
		PROC_WYR_Circus_OnCombatStarted()
		THEN
		NOT DB_DoNotFace(S_WYR_Circus_CuriousFan_48b86ab3-bf79-4466-b44d-1342ee76d57f);
		
		PROC
		PROC_WYR_Circus_OnCombatStarted()
		AND
		DB_WYR_Circus_BeastCages(_, _Beast, _)
		THEN
		PROC_WYR_Circus_PrepareBeastForCombat(_Beast);
		
		PROC
		PROC_WYR_Circus_PrepareBeastForCombat((CHARACTER)_Beast)
		AND
		NOT DB_PermaDefeatedOrOffstage(_Beast)
		AND
		NOT QRY_WYR_Circus_BeastCalmed(_Beast)
		AND
		GetCombatGroupID(S_WYR_Circus_DoppelClown_21f541c1-e1bc-49a8-888f-d8a330c47336, _GroupID)
		THEN
		DB_GLO_DefeatCounter(_Beast, "WYR_Circus_Absolutists");
		SetCombatGroupAndEnterCombat(_Beast, _GroupID, S_WYR_Circus_DoppelClown_21f541c1-e1bc-49a8-888f-d8a330c47336);
		
		PROC
		PROC_WYR_Circus_OnCombatStarted()
		AND
		GetCombatGroupID(S_WYR_Circus_DoppelClown_21f541c1-e1bc-49a8-888f-d8a330c47336, _GroupID)
		AND
		DB_WYR_Circus_Absolutists(_Character)
		AND
		NOT DB_PermaDefeatedOrOffstage(_Character)
		THEN
		DB_GLO_DefeatCounter(_Character, "WYR_Circus_Absolutists");
		SetCombatGroupAndEnterCombat(_Character, _GroupID, S_WYR_Circus_DoppelClown_21f541c1-e1bc-49a8-888f-d8a330c47336);
		
		PROC
		PROC_WYR_Circus_OnCombatStarted()
		THEN
		PROC_SetRelationToPlayers(Act3_WYR_Circus_Clown_d10eb6f8-a38c-4bd6-8bed-b155a6e5ab5a, 0);
		PROC_SetRelationMutual(Act3_WYR_Circus_Clown_d10eb6f8-a38c-4bd6-8bed-b155a6e5ab5a, Act3_WYR_Circus_Patrons_cf592db8-2a56-4d75-8185-33b77bfa5051, 0);
		PROC_SetRelationMutual(Act3_WYR_Circus_Clown_d10eb6f8-a38c-4bd6-8bed-b155a6e5ab5a, ACT3_WYR_Circus_Workers_1c52504e-5262-4670-a834-6248e68534ad, 0);
		PROC_SetRelationMutual(ACT3_WYR_Circus_Beasts_5afda7e4-e61a-4d23-af6d-86fdef9322a8, Act3_WYR_Circus_Workers_1c52504e-5262-4670-a834-6248e68534ad, 0);
		PROC_SetRelationMutual(Act3_WYR_Circus_Beasts_5afda7e4-e61a-4d23-af6d-86fdef9322a8, Act3_WYR_Circus_Patrons_cf592db8-2a56-4d75-8185-33b77bfa5051, 0);
		PROC_SetRelationMutual(Act3_WYR_Circus_Beasts_5afda7e4-e61a-4d23-af6d-86fdef9322a8, ACT3_WYR_Circus_Ringmaster_c8ee67a5-f6c1-46ab-8957-b1e4018adbf8, 50);
		PROC_SetRelationMutual(Act3_WYR_Circus_Clown_d10eb6f8-a38c-4bd6-8bed-b155a6e5ab5a, ACT3_WYR_Circus_Ringmaster_c8ee67a5-f6c1-46ab-8957-b1e4018adbf8, 50);
		PROC_SetRelationToPlayers(Act3_WYR_Circus_Beasts_5afda7e4-e61a-4d23-af6d-86fdef9322a8, 0);
		
		// Fallback to combat
		IF
		TurnStarted(S_WYR_Circus_DoppelClown_21f541c1-e1bc-49a8-888f-d8a330c47336)
		AND
		DB_Is_InCombat(S_WYR_Circus_DoppelClown_21f541c1-e1bc-49a8-888f-d8a330c47336, _CombatID)
		AND
		NOT DB_GlobalFlag(WYR_Circus_Clown_State_Hostile_59c1f674-0985-4d4d-9679-b8a1e4982f45)
		AND
		QRY_IsEnemyToAnyPlayerInCombat(S_WYR_Circus_DoppelClown_21f541c1-e1bc-49a8-888f-d8a330c47336, _CombatID)
		THEN
		PROC_WYR_Circus_StartCombat();
		
		// AD
		PROC
		PROC_WYR_Circus_StartCombat()
		THEN
		DB_WYR_Circus_ClownWantsToYellAD(1);
		
		IF
		DB_WYR_Circus_ClownWantsToYellAD(1)
		AND
		NOT DB_CantTalk_IgnoreCombat((CHARACTER)S_WYR_Circus_DoppelClown_21f541c1-e1bc-49a8-888f-d8a330c47336)
		AND
		QRY_OnlyOnce("WYR_Circus_StartCombatClownAD_OnlyOnce")
		THEN
		NOT DB_WYR_Circus_ClownWantsToYellAD(1);
		PROC_TryStartAD((DIALOGRESOURCE)WYR_Circus_AD_Clown_Attack_ba7dd863-e0c2-1246-c721-5882d242dbee, S_WYR_Circus_DoppelClown_21f541c1-e1bc-49a8-888f-d8a330c47336);
		
		// Misc
		IF
		DB_WYR_Circus_Absolutists(_NPC)
		THEN
		DB_CRIME_Guards_NoSummonBy(_NPC);
		
		QRY
		QRY_CorpseLooting_BlockMakeOwned(_Character)
		AND
		DB_WYR_Circus_Absolutists(_Character)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_CorpseLooting_BlockMakeOwned(_Beast)
		AND
		DB_WYR_Circus_BeastReleasedFlags(_Beast,_)
		THEN
		DB_NOOP(1);
		
		// Disabling trespassing
		PROC
		PROC_WYR_Circus_OnCombatStarted()
		THEN
		PROC_RemoveDBTrespassTrigger(
			S_WYR_Circus_BouncerTrespassArea_eeb030bd-c1ff-4562-bbc3-8fbe3ec1d3c6, 
			S_WYR_Circus_BouncerTrespassOutPos_a4515583-c7d3-434a-97c3-839bc453faaa, 
			S_WYR_Circus_Bouncer_08106e46-8ac2-49c4-adb3-dcc2aa585aa7);
		
		// remove trespassing when dialog starts
		IF
		DialogStarted(WYR_Circus_Clown_PreShow_3201c8cc-8a13-cd0d-3b3c-d89bec8ba767, _)
		THEN
		PROC_RemoveDBTrespassTrigger(
			S_WYR_Circus_StageTrespassArea_fc55638f-6156-4d8d-ada2-7eebab6e3e9d, 
			S_WYR_Circus_StageTrespassOutPos_0deb2e38-5f3b-4ac8-85b1-db48ab156f7e);
		
		PROC
		PROC_WYR_Circus_OnCombatStarted()
		THEN
		PROC_RemoveDBTrespassTrigger(
			S_WYR_Circus_StageTrespassArea_fc55638f-6156-4d8d-ada2-7eebab6e3e9d, 
			S_WYR_Circus_StageTrespassOutPos_0deb2e38-5f3b-4ac8-85b1-db48ab156f7e);
		//END_REGION
		
		//REGION Clown show: Combat Ends
		PROC
		PROC_GLO_DefeatCounter_AllDefeated("WYR_Circus_Absolutists")
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_Circus_State_PostCombat_ee4b2f6e-9d52-4bc5-bde6-bc0e1c015de4);
		
		IF
		FlagSet(WYR_Circus_State_PostCombat_ee4b2f6e-9d52-4bc5-bde6-bc0e1c015de4,_,_)
		THEN
		PROC_GlobalSetFlagAndCache(GLO_Gortash_Knows_AttackedByOrin_3dbc99c9-06c2-4471-88dd-ecc7537eeee9);
		PROC_GlobalSetFlagAndCache(WYR_Circus_State_MetDoppelgangerClown_c1d1c6ec-374b-bae1-6ad7-8289a1dfb346);
		
		IF
		DB_PermaDefeated(S_WYR_Circus_DoppelClown_21f541c1-e1bc-49a8-888f-d8a330c47336)
		AND
		DB_Was_InCombat(S_WYR_Circus_DoppelClown_21f541c1-e1bc-49a8-888f-d8a330c47336, _CombatID)
		AND
		DB_Players(_Player)
		AND
		DB_Was_InCombat(_Player, _CombatID)
		AND
		NOT DB_CantTalk(_Player) //includes combat check
		AND
		NOT DB_WYR_Circus_PostCombatVBPlayed(1)
		THEN
		DB_WYR_Circus_PostCombatVBPlayed(1);
		RealtimeObjectTimerLaunch(_Player, "WYR_Circus_VB_PostCombat_Timer", 1500);
		
		IF
		ObjectTimerFinished(_Player, "WYR_Circus_VB_PostCombat_Timer")
		THEN
		StartVoiceBark(WYR_Circus_VB_PostCombat_db39eab5-e4d4-b068-1a72-364337d1c2fb, (CHARACTER)_Player);
		
		QRY
		QRY_GLO_Doppelgangers_BlockGenericReactionPAD(_Absolutist)
		AND
		DB_WYR_Circus_Absolutists(_Absolutist)
		THEN
		DB_NOOP(1);
		
		// Removing NPCs on long rest
		PROC
		PROC_LongRestOrLevelUnloading("BGO_Main_A")
		AND
		DB_GlobalFlag((FLAG)WYR_Circus_State_GotDribblesQuest_780f6847-84a7-ff3e-f8bb-670d625c1a87)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_State_Gone_151fd307-4cb8-44ba-8998-40e1d748b707)
		AND
		DB_WYR_Circus_ShowPatrons(_Patron,_,_)
		AND
		NOT DB_OffStage(_Patron)
		AND
		NOT QRY_WYR_Circus_DeadOutsideCircus(_Patron)
		THEN
		PROC_CancelDisappearOutOfSight(_Patron);
		PROC_SetOnStage(_Patron, 0);
		
		// Burry the clown on the temple-s graveyard
		PROC
		PROC_LongRestOrLevelUnloading("BGO_Main_A")
		AND
		DB_GlobalFlag((FLAG)WYR_Circus_State_GotDribblesQuest_780f6847-84a7-ff3e-f8bb-670d625c1a87)
		THEN
		PROC_WYR_Circus_BorrowClown();
		
		PROC
		PROC_WYR_Circus_BorrowClown()
		AND
		NOT DB_WYR_Circus_AbsolutistsCorpsesBurried(1)
		AND
		GetPosition(S_WYR_Circus_Clown_DeadArea_85b576cc-f551-4322-a2c6-cca443850938, _X, _Y, _Z)
		AND
		FindValidPosition(_X, _Y, _Z, 10.0, S_WYR_Circus_DoppelClown_21f541c1-e1bc-49a8-888f-d8a330c47336, 0, _vX, _vY, _vZ)
		THEN
		TeleportToPosition(S_WYR_Circus_DoppelClown_21f541c1-e1bc-49a8-888f-d8a330c47336, _vX, _vY, _vZ);
		DB_WYR_Circus_AbsolutistsCorpsesBurried(1);
		//END_REGION
		
		//REGION Clown show: Edge cases to handle players leaving combat and resting
		// Fabllack if players leave combat and rest
		// 1) Ringmaster alive -> Circus won
		PROC
		PROC_LongRestOrLevelUnloading("BGO_Main_A")
		AND
		DB_GlobalFlag((FLAG)WYR_Circus_Clown_State_Hostile_59c1f674-0985-4d4d-9679-b8a1e4982f45)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_State_PostCombat_ee4b2f6e-9d52-4bc5-bde6-bc0e1c015de4)
		AND
		NOT DB_GlobalFlag(WYR_Circus_State_Gone_151fd307-4cb8-44ba-8998-40e1d748b707)
		AND
		NOT DB_GlobalFlag(WYR_Circus_State_AboutToLeave_39876ea2-3a3a-441d-96be-f907b6226239)
		AND
		NOT DB_PermaDefeatedOrOffstage(S_WYR_Circus_Ringmaster_c95af77b-6fc3-4c73-ac7c-087124f4b1e4)
		THEN
		PROC_WYR_Circus_LeftCombat_CircusWon();
		
		PROC
		PROC_WYR_Circus_LeftCombat_CircusWon()
		THEN
		PROC_WYR_Circus_KillAllAbsolutists();
		PROC_WYR_Circus_KillPatrons();
		
		PROC
		PROC_WYR_Circus_LeftCombat_CircusWon()
		AND
		NOT DB_PermaDefeatedOrOffstage(S_WYR_Circus_Bouncer_08106e46-8ac2-49c4-adb3-dcc2aa585aa7)
		AND
		TriggerGetRandomPosition(S_WYR_Circus_ClownPreShowCombatArea_2ea315a6-c570-45d1-a984-0142838ccab3, _X, _Y, _Z)
		THEN
		PurgeOsirisQueue(S_WYR_Circus_Bouncer_08106e46-8ac2-49c4-adb3-dcc2aa585aa7);
		Die(S_WYR_Circus_Bouncer_08106e46-8ac2-49c4-adb3-dcc2aa585aa7, DEATHTYPE.Physical, 1);
		PROC_TeleportToSafePosition(S_WYR_Circus_Bouncer_08106e46-8ac2-49c4-adb3-dcc2aa585aa7, _X, _Y, _Z);
		
		PROC
		PROC_WYR_Circus_LeftCombat_CircusWon()
		THEN
		PROC_Helper_SafeTeleportTo((CHARACTER)S_WYR_Circus_Ringmaster_c95af77b-6fc3-4c73-ac7c-087124f4b1e4, S_WYR_Circus_Ringmaster_PostCombatPos_fbd722db-155d-430a-96d6-b897cb798c4f);
		
		// 2) Ringmaster died -> Absolutists won, circus disappeared. Flaming fists came and killed the absolutists afterwards.
		PROC
		PROC_LongRestOrLevelUnloading("BGO_Main_A")
		AND
		DB_GlobalFlag((FLAG)WYR_Circus_Clown_State_Hostile_59c1f674-0985-4d4d-9679-b8a1e4982f45)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_State_PostCombat_ee4b2f6e-9d52-4bc5-bde6-bc0e1c015de4)
		AND
		NOT DB_GlobalFlag(WYR_Circus_State_Gone_151fd307-4cb8-44ba-8998-40e1d748b707)
		AND
		NOT DB_GlobalFlag(WYR_Circus_State_AboutToLeave_39876ea2-3a3a-441d-96be-f907b6226239)
		AND
		DB_Defeated(S_WYR_Circus_Ringmaster_c95af77b-6fc3-4c73-ac7c-087124f4b1e4)
		THEN
		PROC_WYR_Circus_LeftCombat_AbsolutistsWon();
		
		PROC
		PROC_WYR_Circus_LeftCombat_AbsolutistsWon()
		AND
		DB_WYR_Circus_BeastCages(_, _Beast, _)
		AND
		NOT QRY_WYR_Circus_BeastCalmed(_Beast)
		THEN
		DB_WYR_Circus_DoNotDisappearWithCircus((CHARACTER)_Beast);
		
		PROC
		PROC_WYR_Circus_LeftCombat_AbsolutistsWon()
		AND
		DB_WYR_Circus_ShowPatrons(_Patron, _, "Kill")
		THEN
		DB_WYR_Circus_DoNotDisappearWithCircus((CHARACTER)_Patron);
		
		PROC
		PROC_WYR_Circus_LeftCombat_AbsolutistsWon()
		THEN
		PROC_WYR_Circus_FlamingFistsAppear();
		PROC_WYR_Circus_KillAllAbsolutists();
		PROC_WYR_Circus_KillPatrons();
		PROC_WYR_Circus_MakeCircusDisappear();
		
		PROC
		PROC_WYR_Circus_FlamingFistsAppear()
		AND
		DB_WYR_Circus_FlamingFists(_Fist)
		THEN
		PROC_SetOnStage(_Fist, 1);
		
		PROC
		PROC_WYR_Circus_FlamingFistsAppear()
		THEN
		DB_Dialogs(S_WYR_Circus_FlamingFist_01_4caa11fb-d04d-45fd-bc11-e825833498c6, (DIALOGRESOURCE)WYR_Circus_FlamingFist_01_17d8b1a2-00b0-6cc3-6af3-dcba290414f5);
		DB_Dialogs(S_WYR_Circus_FlamingFist_02_8ad04b31-7d78-4077-83a2-9490ebdd1831, (DIALOGRESOURCE)WYR_Circus_FlamingFist_02_0cf44ed1-5eb9-3283-f86c-03b5fc9a6343);
		
		IF
		DB_WYR_Circus_FlamingFists(_Fist)
		THEN
		PROC_SetOnStage(_Fist, 0);
		
		// fastforward kill commands
		PROC
		PROC_WYR_Circus_KillPatrons()
		AND
		DB_WYR_Circus_ShowPatrons(_Patron, _, "Kill")
		AND
		NOT DB_PermaDefeatedOrOffstage(_Patron)
		AND
		TriggerGetRandomPosition(S_WYR_Circus_ClownPreShowCombatArea_2ea315a6-c570-45d1-a984-0142838ccab3, _X, _Y, _Z)
		THEN
		PurgeOsirisQueue(_Patron);
		Die(_Patron, DEATHTYPE.Physical, 1);
		PROC_TeleportToSafePosition(_Patron, _X, _Y, _Z);
		
		PROC
		PROC_WYR_Circus_KillPatrons()
		AND
		DB_WYR_Circus_ShowPatrons(_Patron, _, "Disappear")
		AND
		NOT DB_PermaDefeatedOrOffstage(_Patron)
		THEN
		PROC_CancelDisappearOutOfSight(_Patron);
		PROC_SetOnStage(_Patron, 0);
		
		PROC
		PROC_WYR_Circus_KillAllAbsolutists()
		AND
		DB_WYR_Circus_Absolutists(_Character)
		AND
		NOT DB_PermaDefeatedOrOffstage(_Character)
		AND
		TriggerGetRandomPosition(S_WYR_Circus_ClownPreShowCombatArea_2ea315a6-c570-45d1-a984-0142838ccab3, _X, _Y, _Z)
		THEN
		PurgeOsirisQueue(_Character);
		Die(_Character, DEATHTYPE.Physical, 1);
		PROC_TeleportToSafePosition(_Character, _X, _Y, _Z);
		
		PROC
		PROC_WYR_Circus_KillAllAbsolutists()
		AND
		DB_WYR_Circus_BeastCages(_, _Beast, _)
		AND
		NOT DB_PermaDefeatedOrOffstage(_Beast)
		AND
		NOT QRY_WYR_Circus_BeastCalmed(_Beast)
		THEN
		PROC_WYR_Circus_KillBeastAndOpenCage(_Beast);
		
		PROC
		PROC_WYR_Circus_KillBeastAndOpenCage((CHARACTER)_Beast)
		AND
		DB_WYR_Circus_BeastCages(_Cage, _Beast, _)
		AND
		NOT DB_Destroyed(_Cage)
		AND
		IsOpened(_Cage, 0)
		THEN
		Open(_Cage);
		
		PROC
		PROC_WYR_Circus_KillBeastAndOpenCage((CHARACTER)_Beast)
		THEN
		PROC_CancelDisappearOutOfSight(_Beast);
		PurgeOsirisQueue(_Beast);
		Die(_Beast, DEATHTYPE.Physical, 1);
		//END_REGION
		
		//REGION Beasts: Cages
		// Tagging for AI
		IF
		DB_WYR_Circus_BeastCages(_Cage, _Beast, _InCageTrigger)
		THEN
		SetTag(_Cage, (TAG)ACT3_WYR_CIRCUS_BEASTCAGE_c2e9f87c-ec66-4519-bbf6-fb8ce249e6dc);
		TriggerRegisterForCharacter(_InCageTrigger, _Beast);
		
		IF
		LeftTrigger(_Beast, _InCageTrigger)
		AND
		DB_WYR_Circus_BeastCages(_Cage, _Beast, _InCageTrigger)
		AND
		IsTagged(_Cage, ACT3_WYR_CIRCUS_BEASTCAGE_c2e9f87c-ec66-4519-bbf6-fb8ce249e6dc,1)
		THEN
		ClearTag(_Cage, ACT3_WYR_CIRCUS_BEASTCAGE_c2e9f87c-ec66-4519-bbf6-fb8ce249e6dc);
		
		IF
		DestroyedBy(_Cage,_,_,_)
		AND
		DB_WYR_Circus_BeastCages(_Cage,_,_)
		AND
		IsTagged(_Cage, ACT3_WYR_CIRCUS_BEASTCAGE_c2e9f87c-ec66-4519-bbf6-fb8ce249e6dc,1)
		THEN
		ClearTag(_Cage, ACT3_WYR_CIRCUS_BEASTCAGE_c2e9f87c-ec66-4519-bbf6-fb8ce249e6dc);
		
		IF
		Opened(_Cage)
		AND
		DB_WYR_Circus_BeastCages(_Cage,_,_)
		AND
		IsLocked(_Cage, 0)
		AND
		IsTagged(_Cage, ACT3_WYR_CIRCUS_BEASTCAGE_c2e9f87c-ec66-4519-bbf6-fb8ce249e6dc,1)
		THEN
		ClearTag(_Cage, ACT3_WYR_CIRCUS_BEASTCAGE_c2e9f87c-ec66-4519-bbf6-fb8ce249e6dc);
		
		IF
		UseFinished(_, _Cage, 1)
		AND
		DB_WYR_Circus_BeastCages(_Cage,_,_)
		AND
		QRY_IsOpeneding(_Cage)
		AND
		IsLocked(_Cage, 0)
		AND
		IsTagged(_Cage, ACT3_WYR_CIRCUS_BEASTCAGE_c2e9f87c-ec66-4519-bbf6-fb8ce249e6dc,1)
		THEN
		ClearTag(_Cage, ACT3_WYR_CIRCUS_BEASTCAGE_c2e9f87c-ec66-4519-bbf6-fb8ce249e6dc);
		
		IF
		DB_PermaDefeatedOrOffstage(_Beast)
		AND
		DB_WYR_Circus_BeastCages(_Cage, (CHARACTER)_Beast,_)
		AND
		IsTagged(_Cage, ACT3_WYR_CIRCUS_BEASTCAGE_c2e9f87c-ec66-4519-bbf6-fb8ce249e6dc,1)
		THEN
		ClearTag(_Cage, ACT3_WYR_CIRCUS_BEASTCAGE_c2e9f87c-ec66-4519-bbf6-fb8ce249e6dc);
		
		// releasing beasts
		IF
		TagCleared((ITEM)_Cage, ACT3_WYR_CIRCUS_BEASTCAGE_c2e9f87c-ec66-4519-bbf6-fb8ce249e6dc)
		AND
		DB_WYR_Circus_BeastCages(_Cage, _,_)
		THEN
		PROC_WYR_Circus_CheckCageReleased(_Cage);
		
		IF
		Opened(_Cage)
		AND
		DB_WYR_Circus_BeastCages(_Cage, _,_)
		THEN
		PROC_WYR_Circus_CheckCageReleased(_Cage);
		
		IF
		Unlocked(_Cage, _, _)
		AND
		DB_WYR_Circus_BeastCages(_Cage,_,_)
		THEN
		PROC_WYR_Circus_CheckCageReleased(_Cage);
		
		IF
		DestroyedBy(_Cage,_,_,_)
		AND
		DB_WYR_Circus_BeastCages(_Cage,_,_)
		THEN
		PROC_WYR_Circus_CheckCageReleased(_Cage);
		
		// was unlocked and opened
		PROC
		PROC_WYR_Circus_CheckCageReleased((ITEM)_Cage)
		AND
		NOT DB_WYR_Circus_CageReleased(_Cage)
		AND
		DB_WYR_Circus_BeastCages(_Cage, _Beast, _InCageTrigger)
		AND
		DB_InRegion(_Beast, _InCageTrigger)
		AND
		IsOpened(_Cage, 1)
		AND
		IsLocked(_Cage, 0)
		AND
		IsTagged(_Cage, ACT3_WYR_CIRCUS_BEASTCAGE_c2e9f87c-ec66-4519-bbf6-fb8ce249e6dc, 0)
		THEN
		DB_WYR_Circus_CageReleased(_Cage);
		PROC_WYR_Circus_OnCageReleased(_Cage);
		
		// was destroyed
		PROC
		PROC_WYR_Circus_CheckCageReleased((ITEM)_Cage)
		AND
		NOT DB_WYR_Circus_CageReleased(_Cage)
		AND
		DB_WYR_Circus_BeastCages(_Cage, _Beast, _InCageTrigger)
		AND
		DB_InRegion(_Beast, _InCageTrigger)
		AND
		IsDestroyed(_Cage, 1)
		THEN
		TriggerUnregisterForCharacter(_InCageTrigger, _Beast);
		DB_WYR_Circus_CageReleased(_Cage);
		PROC_WYR_Circus_OnCageReleased(_Cage);
		
		// the beast is out of the cage for any other reason
		PROC
		PROC_WYR_Circus_CheckCageReleased((ITEM)_Cage)
		AND
		NOT DB_WYR_Circus_CageReleased(_Cage)
		AND
		DB_WYR_Circus_BeastCages(_Cage, _Beast, _InCageTrigger)
		AND
		NOT DB_InRegion(_Beast, _InCageTrigger)
		AND
		IsTagged(_Cage, ACT3_WYR_CIRCUS_BEASTCAGE_c2e9f87c-ec66-4519-bbf6-fb8ce249e6dc, 0)
		THEN
		DB_WYR_Circus_CageReleased(_Cage);
		PROC_WYR_Circus_OnCageReleased(_Cage);
		
		// making interesting 
		PROC
		PROC_WYR_Circus_OnCombatStarted()
		AND
		DB_WYR_Circus_BeastCages(_Cage, _Beast, _)
		AND
		NOT DB_PermaDefeated(_Beast)
		AND
		NOT QRY_WYR_Circus_BeastCalmed(_Beast)
		AND
		IsTagged((ITEM)_Cage, ACT3_WYR_CIRCUS_BEASTCAGE_c2e9f87c-ec66-4519-bbf6-fb8ce249e6dc, 1)
		THEN
		AiAddInterestingItem(_Beast, _Cage);
		
		IF
		TagCleared((ITEM)_Cage, ACT3_WYR_CIRCUS_BEASTCAGE_c2e9f87c-ec66-4519-bbf6-fb8ce249e6dc)
		AND
		DB_WYR_Circus_BeastCages(_Cage, _Beast, _)
		AND
		NOT DB_PermaDefeated(_Beast)
		AND
		NOT QRY_WYR_Circus_BeastCalmed(_Beast)
		THEN
		AiRemoveInterestingItem(_Beast, _Cage);
		
		// clearing cage opener tag if lost keys
		IF
		RemovedFrom(_Key, _Thug)
		AND
		DB_WYR_Circus_Absolutists((CHARACTER)_Thug)
		AND
		NOT DB_PermaDefeated(_Thug)
		AND
		IsTagged(_Thug, (TAG)ACT3_WYR_CIRCUS_CAGEOPENER_f3acc92a-eb22-4076-940b-e52988d0dbdf, 1)
		AND
		GetTemplate(_Key, UNI_WYR_Circus_BeastCageKey_5121d4a2-10c7-45e6-a46f-b279cd554bce)
		THEN
		ClearTag(_Thug, ACT3_WYR_CIRCUS_CAGEOPENER_f3acc92a-eb22-4076-940b-e52988d0dbdf);
		
		// Special AI fix for when thugs open the door but since it costs them nothing,
		// they are trying to use it over and over again while it's still opening (tag clearing may take some time)
		PROC
		PROC_BlockUseOfItem(_Thug, _Cage)
		AND
		DB_WYR_Circus_Absolutists(_Thug)
		AND
		DB_WYR_Circus_BeastCages(_Cage,_,_)
		AND
		NOT DB_WYR_Circus_BeastCage_AiBlockUsage(_Cage)
		THEN
		DB_WYR_Circus_BeastCage_AiBlockUsage(_Cage);
		DB_CustomUseItemResponse(_Thug, _Cage, 1);
		
		PROC
		PROC_BlockUseOfItem(_Thug, _Cage)
		AND
		DB_WYR_Circus_Absolutists(_Thug)
		AND
		DB_WYR_Circus_BeastCages(_Cage,_,_)
		AND
		DB_WYR_Circus_BeastCage_AiBlockUsage(_Cage)
		THEN
		DB_CustomUseItemResponse(_Thug, _Cage, 0);
		
		// we also don't want them to open the cages before the fight, but we don't have tools to do so
		PROC
		PROC_BlockUseOfItem(_Thug, _Cage)
		AND
		DB_WYR_Circus_Absolutists(_Thug)
		AND
		DB_WYR_Circus_BeastCages(_Cage,_,_)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_Clown_State_Hostile_59c1f674-0985-4d4d-9679-b8a1e4982f45)
		THEN
		DB_CustomUseItemResponse(_Thug, _Cage, 0);
		//END_REGION
		
		//REGION Beasts: Dialogs
		// Starting beast dialogs
		PROC
		PROC_BlockUseOfItem(_Player,_Cage)
		AND
		NOT DB_WYR_Circus_StartedBeastDialog(_Cage)
		AND
		DB_WYR_Circus_BeastCages(_Cage,_,_)
		AND
		QRY_WYR_Circus_TryStartBeastInCageDialog(_Player,_Cage)
		THEN
		DB_CustomUseItemResponse(_Player,_Cage,0);
		
		QRY
		QRY_WYR_Circus_TryStartBeastInCageDialog((CHARACTER)_Player, (ITEM)_Cage)
		AND
		DB_Players(_Player)
		AND
		DB_WYR_Circus_BeastCages(_Cage,_Beast,_Trigger)
		AND
		NOT DB_CantTalk(_Beast)
		AND
		IsTagged(_Cage, ACT3_WYR_CIRCUS_BEASTCAGE_c2e9f87c-ec66-4519-bbf6-fb8ce249e6dc, 1)
		AND
		IsLocked(_Cage, 1)
		AND
		DB_Dialogs(_Beast, _DefaultDialog)
		AND
		IsInTrigger(_Beast, _Trigger, 1)
		AND
		QRY_StartDialog_Fixed(_DefaultDialog, _Beast, _Player)
		THEN
		DB_WYR_Circus_StartedBeastDialog(_Cage);
		
		IF
		DialogStarted(_Dialog,_)
		AND
		DB_Dialogs(_Beast,_Dialog)
		AND
		DB_WYR_Circus_BeastCages(_Cage,(CHARACTER)_Beast,_)
		AND
		NOT DB_WYR_Circus_StartedBeastDialog(_Cage)
		THEN
		DB_WYR_Circus_StartedBeastDialog(_Cage);
		//END_REGION
		
		//REGION Beasts: Calming down
		PROC
		PROC_BlockLockpickItem(_Player, _Cage)
		AND
		DB_Players(_Player)
		AND
		DB_WYR_Circus_BeastCages(_Cage, _Beast, _)
		AND
		QRY_WYR_Circus_BeastCalmed(_Beast, "Blocked")
		THEN
		DB_CustomLockpickItemResponse(_Player, _Cage, 0);
		PROC_TryStartAD(GEN_AD_ItemBlocked_a4eb2e7b-809a-a9e4-94da-955a8ac9b8c6, _Player);
		
		PROC
		PROC_BlockUseOfItem(_Character, _Cage)
		AND
		NOT DB_Players(_Character)
		AND
		DB_WYR_Circus_BeastCages(_Cage, _Beast, _)
		AND
		QRY_WYR_Circus_BeastCalmed(_Beast, "Blocked")
		THEN
		DB_CustomUseItemResponse(_Character, (ITEM)_Cage, 0);
		
		IF
		FlagSet((FLAG)_Flag,_,_)
		AND
		DB_WYR_Circus_BeastCalmedFlags(_Beast, _Flag, "Pacified")
		AND
		DB_WYR_Circus_BeastCages(_Cage, _Beast, _)
		AND
		IsTagged(_Cage, ACT3_WYR_CIRCUS_BEASTCAGE_c2e9f87c-ec66-4519-bbf6-fb8ce249e6dc,1)
		THEN
		ClearTag(_Cage, ACT3_WYR_CIRCUS_BEASTCAGE_c2e9f87c-ec66-4519-bbf6-fb8ce249e6dc);
		
		IF
		FlagSet((FLAG)_Flag,_,_)
		AND
		DB_WYR_Circus_BeastCalmedFlags(_Beast, _Flag, "Blocked")
		AND
		DB_WYR_Circus_BeastCages(_Cage, _Beast, _)
		AND
		IsTagged(_Cage, ACT3_WYR_CIRCUS_BEASTCAGE_c2e9f87c-ec66-4519-bbf6-fb8ce249e6dc,1)
		THEN
		ClearTag(_Cage, ACT3_WYR_CIRCUS_BEASTCAGE_c2e9f87c-ec66-4519-bbf6-fb8ce249e6dc);
		Unlock(_Cage);
		Lock((ITEM)_Cage, "NO_KEY");
		
		IF
		FlagSet((FLAG)WYR_Circus_Beast_01_State_CageBlocked_a0fbd326-9087-9a8e-20a7-34b804d60ba5,_,_)
		AND
		DB_WYR_Circus_Absolutists(_Character)
		AND
		NOT DB_PermaDefeated(_Character)
		THEN
		AiAddInterestingItem(_Character, (ITEM)S_WYR_Circus_CageDoor_01_ebd4f99e-6d72-4eca-8efe-30905f83bb9e);
		
		// beast_02 (feeding meat)
		IF
		FlagSet(WYR_Circus_State_GiveMeat_1900792c-21d6-4b24-ae46-52afb43029ee, _Player, _)
		THEN
		MagicPocketsDestroyLocalItemsByTag((CHARACTER)_Player, "MEAT_fae436d4-da32-42a6-a2b2-9635da0b82eb", 1);
		
		// Calming down 
		IF
		FlagSet(_Flag, _, _)
		AND
		DB_WYR_Circus_BeastCalmedFlags(_Beast, _Flag, _)
		THEN
		SetFaction(_Beast, Act3_WYR_Circus_PacifiedBeast_379cb629-2a67-4844-9c77-d8f1bac8bd31);
		
		QRY
		QRY_WYR_Circus_BeastCalmed((CHARACTER)_Beast)
		AND
		DB_WYR_Circus_BeastCalmedFlags(_Beast, _Flag, _)
		AND
		DB_GlobalFlag(_Flag)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_WYR_Circus_BeastCalmed((CHARACTER)_Beast, (STRING)_CalmingType)
		AND
		DB_WYR_Circus_BeastCalmedFlags(_Beast, _Flag, _CalmingType)
		AND
		DB_GlobalFlag(_Flag)
		THEN
		DB_NOOP(1);
		
		// Peaceful resolution XP
		IF
		BaseFactionChanged(_Beast, _, Act3_WYR_Circus_PacifiedBeast_379cb629-2a67-4844-9c77-d8f1bac8bd31)
		THEN
		PROC_PeacefulResolve(_Beast);
		//END_REGION
		
		//REGION Beasts: Releasing
		PROC
		PROC_WYR_Circus_OnCageReleased((ITEM)_Cage)
		AND
		DB_GlobalFlag((FLAG)WYR_Circus_Clown_State_Hostile_59c1f674-0985-4d4d-9679-b8a1e4982f45)
		AND
		DB_WYR_Circus_BeastCages(_Cage, _Beast, _Trigger)
		AND
		NOT DB_PermaDefeatedOrOffstage(_Beast)
		AND
		QRY_WYR_Circus_BeastCalmed(_Beast, "Blocked")
		AND
		NOT QRY_WYR_Circus_BeastCalmed(_Beast, "Pacified")
		AND
		DB_InRegion(_Beast, _Trigger)
		THEN
		PROC_WYR_Circus_UnPacifyBeast(_Beast);
		
		PROC
		PROC_WYR_Circus_UnPacifyBeast((CHARACTER)_Beast)
		THEN
		SetFaction(_Beast, (FACTION)ACT3_WYR_Circus_Beasts_5afda7e4-e61a-4d23-af6d-86fdef9322a8);
		
		PROC
		PROC_WYR_Circus_UnPacifyBeast((CHARACTER)_Beast)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_State_PostCombat_ee4b2f6e-9d52-4bc5-bde6-bc0e1c015de4)
		AND
		GetCombatGroupID(S_WYR_Circus_DoppelClown_21f541c1-e1bc-49a8-888f-d8a330c47336, _GroupID)
		THEN
		DB_GLO_DefeatCounter(_Beast, "WYR_Circus_Absolutists");
		SetCombatGroupAndEnterCombat(_Beast, _GroupID, S_WYR_Circus_DoppelClown_21f541c1-e1bc-49a8-888f-d8a330c47336);
		
		PROC
		PROC_WYR_Circus_UnPacifyBeast((CHARACTER)_Beast)
		AND
		DB_GlobalFlag((FLAG)WYR_Circus_State_PostCombat_ee4b2f6e-9d52-4bc5-bde6-bc0e1c015de4)
		THEN
		PROC_SetRelationMutual(Act3_WYR_Circus_Beasts_5afda7e4-e61a-4d23-af6d-86fdef9322a8, ACT3_WYR_Circus_Ringmaster_c8ee67a5-f6c1-46ab-8957-b1e4018adbf8, 0);
		
		// Releasing the beasts from their cages before combat starts or them being calmed down
		PROC
		PROC_WYR_Circus_OnCageReleased((ITEM)_Cage)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_Clown_State_Hostile_59c1f674-0985-4d4d-9679-b8a1e4982f45)
		AND
		DB_WYR_Circus_BeastCages(_Cage, _Beast, _Trigger)
		AND
		NOT QRY_WYR_Circus_BeastCalmed(_Beast, "Pacified")
		AND
		DB_InRegion(_Beast, _Trigger)
		THEN
		PROC_WYR_Circus_OnBeastReleased(_Beast);
		
		PROC
		PROC_WYR_Circus_OnBeastReleased(_)
		THEN
		PROC_GlobalSetFlagAndCache(WYR_Circus_State_BeastReleased_5f59da8f-1d66-4f08-b07e-912dae9e2ebf);
		
		PROC
		PROC_WYR_Circus_OnBeastReleased((CHARACTER)_Beast)
		AND
		DB_WYR_Circus_BeastReleasedFlags(_Beast, _Flag)
		THEN
		SetFaction(_Beast, Act3_WYR_Circus_PacifiedBeast_379cb629-2a67-4844-9c77-d8f1bac8bd31);
		PROC_GlobalSetFlagAndCache(_Flag);
		
		PROC
		PROC_WYR_Circus_OnBeastReleased((CHARACTER)_Beast)
		AND
		CrimeGetNewID(_CrimeID)
		THEN
		PROC_CharacterRegisterCrime(_Beast, "DangerousMonsterReaction", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000, _CrimeID);
		DB_WYR_Circus_BeastReleasedCrimeID(_CrimeID);
		
		IF
		OnCrimeConfrontationDone(_CrimeID, _Investigator, _,_,_,_,_)
		AND
		DB_WYR_Circus_BeastReleasedCrimeID(_CrimeID)
		THEN
		SetEntityEvent(_Investigator, "ClearCrimeReturn", 1);
		
		PROC
		PROC_WYR_Circus_OnBeastReleased((CHARACTER)_Beast)
		AND
		NOT DB_WYR_Circus_BeastReleasedTimerOn(1)
		THEN
		DB_WYR_Circus_BeastReleasedTimerOn(1);
		TimerLaunch("WYR_Circus_BeastReleased_Timer", 1000);
		
		IF
		TimerFinished("WYR_Circus_BeastReleased_Timer")
		AND
		DB_WYR_Circus_ShowPatrons_DisappearGroup("WYR_Circus_ScaredFamily_SceneDialogOnly", _Character, _,_)
		THEN
		PROC_WYR_Circus_GroupScene_ForceEndForCharacter(_Character);
		
		PROC
		PROC_WYR_Circus_OnBeastReleased((CHARACTER)_Beast)
		AND
		NOT DB_PermaDefeated(_Beast)
		THEN
		PROC_RemoveDialog(_Beast);
		
		// beast disappearing
		// event is from Anubis
		IF
		EntityEvent(_Beast, "WYR_Circus_BeastReleasedDisappear")
		AND
		DB_WYR_Circus_BeastCages(_, (CHARACTER)_Beast, _)
		THEN
		SetEntityEvent(S_WYR_Circus_Thug_01_e11b95c9-0e4a-4777-b935-1ebaa5166a45, "WYR_Circus_Thug_01_Event_BeastRunAwayReaction", 1);
		PROC_NotifyWhenReadyToMoveOn(_Beast, "WYR_Circus_BeastReleasedDisappear_Notify");
		
		PROC
		PROC_ReadyToMoveOn(_Beast, "WYR_Circus_BeastReleasedDisappear_Notify")
		THEN
		PROC_DisappearOutOfSightTo((CHARACTER)_Beast, S_WYR_Circus_Beasts_DisappearPos_e90b2bbf-8fc8-4b23-bc10-f348cde23b3f, "Sprint", 1, "WYR_Circus_Event_BeastReleasedDisappeared");
		//END_REGION
		
		//REGION Booth: Djinni-s Wheel of Fortune
		IF
		DB_WYR_Circus_WheelPrizes(_Item)
		THEN
		PROC_SetOnStage(_Item, 0);
		
		// Winning prizes
		IF
		FlagSet((FLAG)WYR_Circus_Event_WheelGivePrize_7dfd6548-fd05-42d0-a46b-521fd5fbfdcb, _Player, _Instance)
		AND
		QRY_GetRandom("DB_WYR_Circus_WheelPrizes", 1, "DB_QRY_RTN_WYR_Circus_WheelPrizeWon")
		AND
		DB_QRY_RTN_WYR_Circus_WheelPrizeWon((ITEM)_Prize)
		AND
		DB_WYR_Circus_WheelPrizes(_Prize)
		THEN
		NOT DB_WYR_Circus_WheelPrizes(_Prize);
		PROC_ToInventoryAndOnStage(_Prize, _Player, 1, 1, 1);
		ClearFlag(WYR_Circus_Event_WheelGivePrize_7dfd6548-fd05-42d0-a46b-521fd5fbfdcb, _Player, _Instance);
		PROC_WYR_Circus_CheckHasPrizes();
		
		IF
		WentOnStage(S_WYR_Circus_WheelPrize_BagOfMolding_4e08dac7-f6b4-42ac-b4b1-e217387892d2, 1)
		THEN
		Transform(S_WYR_Circus_WheelPrize_BagOfMolding_4e08dac7-f6b4-42ac-b4b1-e217387892d2, UNI_WYR_Circus_BagOfMolding_Old_5c53c59a-37e7-4a9d-b157-1c84c71e3c0d, DisguiseKeepName_c7c3381e-b901-416e-a0c4-bc745e1ff54a);
		
		PROC
		PROC_WYR_Circus_CheckHasPrizes()
		AND
		DB_GlobalFlag((FLAG)WYR_Circus_State_WheelHasPrizes_dcea2493-c33f-7d42-d348-90530855995f)
		AND
		NOT DB_WYR_Circus_WheelPrizes(_)
		THEN
		PROC_GlobalClearFlagAndCache((FLAG)WYR_Circus_State_WheelHasPrizes_dcea2493-c33f-7d42-d348-90530855995f);
		
		// Cheese
		IF
		FlagSet(WYR_Circus_FortuneWheelWorker_Event_TransformPlayer_43cfbb38-02ef-1ef4-386d-a8bc6e67a761, _Player, _)
		THEN
		PROC_WYR_Circus_WheelWorkerTransform((CHARACTER)_Player);
		
		PROC
		PROC_WYR_Circus_WheelWorkerTransform((CHARACTER)_Player)
		AND
		NOT DB_Defeated(S_WYR_Circus_FortuneWheelWorker_21aa8a76-40ac-4d3a-881f-d6871487df6f)
		AND
		GetDistanceTo(S_WYR_Circus_FortuneWheelWorker_21aa8a76-40ac-4d3a-881f-d6871487df6f, _Player, _Distance)
		AND
		_Distance < 30.0
		THEN
		UseSpell(S_WYR_Circus_FortuneWheelWorker_21aa8a76-40ac-4d3a-881f-d6871487df6f, "Target_WYR_PolymorhphCheese_Djinni", _Player);
		
		// Fake items
		PROC
		PROC_BlockUseOfItem(_Player, _FakeItem)
		AND
		DB_WYR_Circus_FakePrizes(_FakeItem)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)WYR_Circus_PAD_ItemFake_ea77a9e2-0092-0be2-1b1f-22e9d9f1ac91, _Player);
		DB_CustomUseItemResponse(_Player, _FakeItem, 0);
		
		IF
		AttackedBy(_FakeItem, _AttackOwner,_,_,_,_,_)
		AND
		DB_WYR_Circus_FakePrizes((ITEM)_FakeItem)
		AND
		NOT DB_WYR_Circus_FakeItemPoofed(_FakeItem)
		AND
		GetPosition(_FakeItem, _X, _Y, _Z)
		THEN
		DB_WYR_Circus_FakeItemPoofed(_FakeItem);
		PlayEffectAtPosition(VFX_Script_CONT_GEN_SecretChest_01_a164a018-22f3-a538-5acb-4aedf67358de, _X, _Y, _Z);
		PROC_TryStartAD((DIALOGRESOURCE)WYR_Circus_PAD_ItemFake_ea77a9e2-0092-0be2-1b1f-22e9d9f1ac91, _AttackOwner);
		RealtimeObjectTimerLaunch(_FakeItem, "WYR_Circus_DestroyFakeItem_Timer", 100);
		
		IF
		ObjectTimerFinished(_FakeItem, "WYR_Circus_DestroyFakeItem_Timer")
		THEN
		PROC_SetOnStage(_FakeItem, 0);
		
		// treasure pile
		PROC
		PROC_BlockUseOfItem(_Player, S_WYR_Circus_FakeTreasurePile_000_8b340cd5-013d-49a0-888c-b1d3bb9495fb)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)WYR_Circus_PAD_FakeTreasurePile_d0179aca-d190-9f10-9efa-4eb4a5b66c61, _Player);
		DB_CustomUseItemResponse(_Player, S_WYR_Circus_FakeTreasurePile_000_8b340cd5-013d-49a0-888c-b1d3bb9495fb, 0);
		//END_REGION
		
		//REGION Booth: Love Dryad
		IF
		FlagSet((FLAG)WYR_Circus_Event_LoveQuestionWrong_48899fa7-dc51-6e3b-db88-bf0a150921a5,_Player,_)
		AND
		NOT DB_Avatars((CHARACTER)_Player)
		THEN
		ShowError(_Player, "WYR_Circus_LoveDryad dialog - only Avatars are supported");
		
		IF
		FlagSet((FLAG)WYR_Circus_Event_LoveQuestionWrong_48899fa7-dc51-6e3b-db88-bf0a150921a5,_Player,_InstanceId)
		AND
		DB_Avatars((CHARACTER)_Player)
		THEN
		ClearFlag(WYR_Circus_Event_LoveQuestionWrong_48899fa7-dc51-6e3b-db88-bf0a150921a5,_Player,_InstanceId);
		PROC_WYR_Circus_LoveQuestionWrong((CHARACTER)_Player);
		
		PROC
		PROC_WYR_Circus_LoveQuestionWrong((CHARACTER)_Player)
		AND
		DB_WYR_Circus_LoveGame_MistakesNow(_MistakesWas,_Player)
		AND
		IntegerSum(_MistakesWas,1,_MistakesNew)
		THEN
		NOT DB_WYR_Circus_LoveGame_MistakesNow(_MistakesWas,_Player);
		DB_WYR_Circus_LoveGame_MistakesNow(_MistakesNew,_Player);
		
		PROC
		PROC_WYR_Circus_LoveQuestionWrong((CHARACTER)_Player)
		AND
		NOT DB_WYR_Circus_LoveGame_MistakesNow(_,_Player)
		THEN
		DB_WYR_Circus_LoveGame_MistakesNow(1,_Player);
		
		IF
		DB_WYR_Circus_LoveGame_MistakesNow(_Mistakes,_Player)
		AND
		DB_WYR_Circus_LoveGame_MistakeFlags(_Mistakes,_Flag)
		THEN
		SetFlag(_Flag,_Player,0);
		
		IF
		DialogEnded((DIALOGRESOURCE)WYR_Circus_LoveDryad_d0c00951-4d09-d1a6-2ab3-6c6ba1932a25,_)
		AND
		DB_WYR_Circus_LoveGame_MistakesNow(_Mistakes, _Player)
		AND
		DB_WYR_Circus_LoveGame_MistakeFlags(_Mistakes, _Flag)
		THEN
		NOT DB_WYR_Circus_LoveGame_MistakesNow(_Mistakes, _Player);
		ClearFlag(_Flag, _Player, 0);
		
		IF
		DialogEnded((DIALOGRESOURCE)WYR_Circus_LoveDryad_d0c00951-4d09-d1a6-2ab3-6c6ba1932a25, _Instance)
		AND
		DB_DialogPlayers(_Instance, _Player, _)
		AND
		GetFlag(WYR_Circus_LoveDryad_Event_PassedLoveTest_10617f2f-11ff-1b2a-c694-d31b429e7735, _Player, _Instance)
		AND
		DB_DialogPlayers(_Instance, _Companion, _)
		AND
		_Companion != _Player
		AND
		GetFlag(WYR_Circus_LoveDryad_Event_PickedCompanion_bb8086a2-b96d-3722-72c6-2bbab502fe53, _Companion, 1)
		THEN
		ApplyStatus(_Player, "WYR_CIRCUS_LOVEDRYAD_BLESSING_AURA", -1.0, 1, S_WYR_Circus_LoveDryad_a8bce35d-17ee-46e3-8d56-1d0d29c4a01e);
		ApplyStatus(_Companion, "WYR_CIRCUS_LOVEDRYAD_BLESSING_AURA", -1.0, 1, S_WYR_Circus_LoveDryad_a8bce35d-17ee-46e3-8d56-1d0d29c4a01e);
		
		IF
		DialogEnded((DIALOGRESOURCE)WYR_Circus_LoveDryad_d0c00951-4d09-d1a6-2ab3-6c6ba1932a25, _Instance)
		AND
		DB_DialogPlayers(_Instance, _Companion, _)
		AND
		NOT DB_Avatars((CHARACTER)_Companion)
		AND
		GetFlag(WYR_Circus_LoveDryad_Event_PickedCompanion_bb8086a2-b96d-3722-72c6-2bbab502fe53, _Companion, 1)
		THEN
		ClearFlag(WYR_Circus_LoveDryad_Event_PickedCompanion_bb8086a2-b96d-3722-72c6-2bbab502fe53, _Companion, _Instance);
		//END_REGION
		
		//REGION Booth: Sculptor
		PROC
		PROC_FlagReactionAfterDialog((CHARACTER)_Player, WYR_Circus_Event_OrderedStatue_9bd9aa22-d90e-6928-91df-2591988ceb24)
		THEN
		PROC_WYR_Circus_CreateStatueCopy(_Player);
		
		PROC
		PROC_WYR_Circus_CreateStatueCopy((CHARACTER)_Player)
		THEN
		Transform(S_WYR_Circus_StatueDummy_c2ef6bde-3dbe-4ff5-99ca-8120445a8309, _Player, (SHAPESHIFTRULE)WYR_CircusStatue_502db098-3adb-4b82-afaa-60b042760de1);
		
		PROC
		PROC_WYR_Circus_CreateStatueCopy((CHARACTER)_Player)
		AND
		NOT DB_GlobalFlag(WYR_Circus_Sculptor_Event_RequestedNude_9e96d82d-44b6-4135-aac8-b3b29d7e3188)
		THEN
		CopyCharacterEquipment(S_WYR_Circus_StatueDummy_c2ef6bde-3dbe-4ff5-99ca-8120445a8309, _Player);
		
		PROC
		PROC_WYR_Circus_CreateStatueCopy((CHARACTER)_Player)
		AND
		DB_GlobalFlag((FLAG)WYR_Circus_Sculptor_Event_RequestedVanity_0333cb3a-07c2-4fa7-a40c-46d4353b5659)
		THEN
		PROC_SetArmourSet(S_WYR_Circus_StatueDummy_c2ef6bde-3dbe-4ff5-99ca-8120445a8309, ARMOURSET.Vanity);
		
		PROC
		PROC_WYR_Circus_CreateStatueCopy((CHARACTER)_Player)
		AND
		DB_GlobalFlag(WYR_Circus_Sculptor_Event_RequestedNude_9e96d82d-44b6-4135-aac8-b3b29d7e3188)
		AND
		DB_EquippedItemSlots(_Slot)
		AND
		GetEquippedItem(S_WYR_Circus_StatueDummy_c2ef6bde-3dbe-4ff5-99ca-8120445a8309, _Slot, _Item)
		THEN
		Unequip(S_WYR_Circus_StatueDummy_c2ef6bde-3dbe-4ff5-99ca-8120445a8309, _Item);
		
		PROC
		PROC_WYR_Circus_CreateStatueCopy((CHARACTER)_Player)
		THEN
		PROC_SetOnStage(S_WYR_Circus_StatueDummy_c2ef6bde-3dbe-4ff5-99ca-8120445a8309, 1);
		ApplyStatus(S_WYR_Circus_StatueDummy_c2ef6bde-3dbe-4ff5-99ca-8120445a8309, "WYR_CIRCUS_STATUE_PETRIFIED", -1.0);
		ApplyStatus(S_WYR_Circus_StatueDummy_c2ef6bde-3dbe-4ff5-99ca-8120445a8309, "WYR_CIRCUS_STATUEVISAGE", -1.0);
		
		PROC
		PROC_WYR_Circus_CreateStatueCopy((CHARACTER)_Player)
		THEN
		NOT DB_WYR_Circus_Statue_NameSet(1);
		
		PROC
		PROC_WYR_Circus_CreateStatueCopy((CHARACTER)_Player)
		AND
		DB_WYR_Circus_StateNames(_Tag, _Name)
		AND
		NOT DB_WYR_Circus_Statue_NameSet(1)
		AND
		IsTagged(_Player, _Tag, 1)
		THEN
		DB_WYR_Circus_Statue_NameSet(1);
		SetStoryDisplayName(S_WYR_Circus_StatueDummy_c2ef6bde-3dbe-4ff5-99ca-8120445a8309, _Name);
		
		PROC
		PROC_WYR_Circus_CreateStatueCopy((CHARACTER)_Player)
		AND
		NOT DB_WYR_Circus_Statue_NameSet(1)
		THEN
		DB_WYR_Circus_Statue_NameSet(1);
		SetStoryDisplayName(S_WYR_Circus_StatueDummy_c2ef6bde-3dbe-4ff5-99ca-8120445a8309, "WYR_Circus_StatueName_Generic");
		
		// Setting up statue for the camp
		PROC
		PROC_WYR_Circus_CreateStatueCopy((CHARACTER)_Player)
		THEN
		PROC_WYR_Circus_SendStatueToCamp((CHARACTER)_Player);
		
		PROC
		PROC_WYR_Circus_SendStatueToCamp((CHARACTER)_Player)
		THEN
		DB_WYR_Circus_StatueSentToCamp((CHARACTER)_Player);
		
		PROC
		PROC_WYR_Circus_SendStatueToCamp((CHARACTER)_Player)
		AND
		DB_WYR_Circus_Statue_CampPosTriggers(_Camp, _Trigger, _)
		THEN
		DB_ORI_OriginCampData(S_WYR_Circus_StatueDummy_c2ef6bde-3dbe-4ff5-99ca-8120445a8309, _Camp, _Trigger);
		
		PROC
		PROC_WYR_Circus_SendStatueToCamp((CHARACTER)_Player)
		THEN
		PROC_ORI_SetupCamp((CHARACTER)S_WYR_Circus_StatueDummy_c2ef6bde-3dbe-4ff5-99ca-8120445a8309, 1);
		DB_InCamp(S_WYR_Circus_StatueDummy_c2ef6bde-3dbe-4ff5-99ca-8120445a8309);
		// The rest is in Act3_GEN_Camp
		//END_REGION
		
		//REGION Dribbles Quest: Handling flags for bookkeeping Dribbles' body parts
		// Init
		IF
		DB_WYR_Circus_ClownPieces(_Item, _Flag, _,_)
		THEN
		DB_HasItemEvent(_Item, _Flag);
		
		IF
		FlagSet(_Flag, _Char, _)
		AND
		DB_WYR_Circus_ClownPieces((ITEM)_Item, _Flag,_,_)
		AND
		NOT DB_WYR_Circus_ClownPieces_PickedPieces(_Item)
		AND
		DB_PartyMembers((CHARACTER)_Char)
		AND
		_Item != S_WYR_Circus_DribblesBodyPart_Hand_dedf021f-478c-4a06-9150-f442e1cd2ecd
		THEN
		DB_WYR_Circus_ClownPieces_PickedPieces(_Item);
		
		// hand is special, because its ownership flag arrived too early if stolen (usually while the player are still negotiates with the kobold about buying it)
		IF
		FlagSet((FLAG)WYR_Circus_Merchant_State_AcquiredHand_90c6a782-e37d-4a9e-bd79-102636f749b2,_,_)
		THEN
		DB_WYR_Circus_ClownPieces_PickedPieces(S_WYR_Circus_DribblesBodyPart_Hand_dedf021f-478c-4a06-9150-f442e1cd2ecd);
		
		IF
		FlagSet((FLAG)WYR_Circus_Merchant_State_AcquiredHand_90c6a782-e37d-4a9e-bd79-102636f749b2,_,_)
		AND
		GetInventoryOwner(S_WYR_Circus_DribblesBodyPart_Hand_dedf021f-478c-4a06-9150-f442e1cd2ecd, _Char)
		AND
		DB_Players((CHARACTER)_Char)
		THEN
		PROC_WYR_Circus_StartFoundClownCorpseVB((CHARACTER)_Char, S_WYR_Circus_DribblesBodyPart_Hand_dedf021f-478c-4a06-9150-f442e1cd2ecd);
		
		// HasAny
		IF
		FlagSet(_Flag, _Char, _)
		AND
		DB_WYR_Circus_ClownPieces(_, _Flag, _,_)
		AND
		DB_PartyMembers((CHARACTER)_Char)
		AND
		GetFlag((FLAG)WYR_Circus_State_BodyPartsHasAny_4fec1a52-6650-a377-983c-04e2c01d84cf, _Char, 0)
		THEN
		SetFlag((FLAG)WYR_Circus_State_ClownPiecesHasAny_4fec1a52-6650-a377-983c-04e2c01d84cf, _Char, 0);
		
		IF
		FlagCleared(_Flag, _Char, _)
		AND
		DB_WYR_Circus_ClownPieces(_, _Flag, _,_)
		AND
		DB_PartyMembers((CHARACTER)_Char)
		AND
		GetFlag(WYR_Circus_State_BodyPartsHasAny_4fec1a52-6650-a377-983c-04e2c01d84cf, _Char, 1)
		AND
		NOT QRY_WYR_Circus_HasAnyPieces((CHARACTER)_Char)
		THEN
		ClearFlag((FLAG)WYR_Circus_State_BodyPartsHasAny_4fec1a52-6650-a377-983c-04e2c01d84cf, _Char, 0);
		
		QRY
		QRY_WYR_Circus_HasAnyPieces((CHARACTER)_Char)
		AND
		DB_WYR_Circus_ClownPieces(_, _Flag, _,_)
		AND
		GetFlag(_Flag, _Char, 1)
		THEN
		DB_NOOP(1);
		
		// HasAll
		IF
		FlagSet(_Flag, _Char, _)
		AND
		DB_WYR_Circus_ClownPieces(_, _Flag, _,_)
		AND
		DB_Players((CHARACTER)_Char)
		AND
		NOT QRY_WYR_Circus_HasPiecesToCollect((CHARACTER)_Char)
		THEN
		SetFlag((FLAG)WYR_Circus_State_BodyPartsHasAll_73f56db8-afa1-4b5f-a7a6-611afddcf435, _Char, 0);
		
		IF
		FlagCleared(_Flag, _Char, _)
		AND
		DB_WYR_Circus_ClownPieces(_, _Flag, _,_)
		AND
		DB_Players((CHARACTER)_Char)
		AND
		GetFlag(WYR_Circus_State_BodyPartsHasAll_73f56db8-afa1-4b5f-a7a6-611afddcf435, _Char, 1)
		THEN
		ClearFlag((FLAG)WYR_Circus_State_BodyPartsHasAll_73f56db8-afa1-4b5f-a7a6-611afddcf435, _Char, 0);
		
		QRY
		QRY_WYR_Circus_HasPiecesToCollect((CHARACTER)_Char)
		AND
		DB_WYR_Circus_ClownPieces(_,_Flag,_,_)
		AND
		GetFlag(_Flag, _Char, 0)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_WYR_Circus_HasPiecesToCollect((CHARACTER)_Char)
		AND
		GetFlag(WYR_Circus_State_ClownPiecesHasHand_025d9d68-2786-9bb3-eeed-a89bf0f2ecc4, _Char, 1)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_Merchant_State_AcquiredHand_90c6a782-e37d-4a9e-bd79-102636f749b2)
		THEN
		DB_NOOP(1);
		
		// special case for the hand
		IF
		FlagSet((FLAG)WYR_Circus_Merchant_State_AcquiredHand_90c6a782-e37d-4a9e-bd79-102636f749b2,_,_)
		AND
		DB_Players((CHARACTER)_Char)
		AND
		NOT QRY_WYR_Circus_HasPiecesToCollect((CHARACTER)_Char)
		THEN
		SetFlag((FLAG)WYR_Circus_State_BodyPartsHasAll_73f56db8-afa1-4b5f-a7a6-611afddcf435, _Char, 0);
		
		// Giving away all the pieces
		IF
		FlagSet((FLAG)WYR_Circus_Event_BodyPartsGiveAll_6f4b86e3-fe42-aba9-f492-406acedebb64, _Character, _)
		AND
		DB_WYR_Circus_ClownPieces(_Item, _,_,_)
		THEN
		ToInventory(_Item, _Character, 1);
		
		IF
		FlagSet((FLAG)WYR_Circus_Event_BodyPartsGiveAll_6f4b86e3-fe42-aba9-f492-406acedebb64, _Player, _DialogInstnace)
		THEN
		ClearFlag(WYR_Circus_Event_BodyPartsGiveAll_6f4b86e3-fe42-aba9-f492-406acedebb64, _Player, _DialogInstnace);
		
		// Helpers
		QRY
		QRY_WYR_Circus_ClownPieces_LeftFindLessThan((INTEGER)_Limit)
		AND
		SysCount("DB_WYR_Circus_ClownPieces_PickedPieces", 1, _Count)
		AND
		SysCount("DB_WYR_Circus_ClownPieces", 4, _CountTotal)
		AND
		IntegerSubtract(_CountTotal, _Count, _Left)
		AND
		_Left < _Limit
		THEN
		DB_NOOP(1);
		//END_REGION
		
		//REGION Dribbles Quest: Finding Dribbles bodyparts VB
		// Triggering a VB after picking up a bodypart
		IF
		AddedTo(_Item, _Char, _)
		AND
		DB_WYR_Circus_ClownPieces((ITEM)_Item, _,_,_)
		AND
		DB_PartyMembers((CHARACTER)_Char)
		AND
		_Item != S_WYR_Circus_DribblesBodyPart_Hand_dedf021f-478c-4a06-9150-f442e1cd2ecd
		AND
		NOT DB_WYR_Circus_FoundClownCorpseVB_Played(_Item)
		THEN
		PROC_WYR_Circus_StartFoundClownCorpseVB(_Char, _Item);
		
		// camp chest case (we dont want to check magick pockets because we dont know which character is closest to the player where the part was picked up)
		IF
		MovedFromTo(_Item, _OriginalOwner, _Container, _)
		AND
		DB_WYR_Circus_ClownPieces((ITEM)_Item, _,_,_)
		AND
		DB_Camp_UserCampChest(_, (ITEM)_Container)
		AND
		_Item != S_WYR_Circus_DribblesBodyPart_Hand_dedf021f-478c-4a06-9150-f442e1cd2ecd
		AND
		NOT DB_WYR_Circus_FoundClownCorpseVB_Played(_Item)
		AND
		QRY_GetClosestAvailableCharacterTo(_OriginalOwner, 0)
		AND
		DB_ClosestAvailableCharacterTo(_Char, _OriginalOwner, _Distance)
		AND
		DB_Players(_Char)
		AND
		_Distance < 15.0
		THEN
		PROC_WYR_Circus_StartFoundClownCorpseVB(_Char, _Item);
		
		PROC
		PROC_WYR_Circus_StartFoundClownCorpseVB((CHARACTER)_Character, (ITEM)_Item)
		AND
		NOT DB_WYR_Circus_FoundClownCorpseVB_Played(_Item)
		AND
		QRY_WYR_Circus_PrepareClownCorpseVBFlags(_Item)
		AND
		QRY_WYR_Circus_CanStartFoundClownCorpseVB()
		THEN
		DB_WYR_Circus_FoundClownCorpseVB_Played(_Item);
		StartVoiceBark(WYR_Circus_VB_FoundClownCorpse_77e43be7-4efc-e40e-5fd3-02cf42e48fc6, _Character);
		
		// on the quest part of the PAD
		QRY
		QRY_WYR_Circus_CanStartFoundClownCorpseVB()
		AND
		DB_GlobalFlag((FLAG)WYR_Circus_State_MetDoppelgangerClown_c1d1c6ec-374b-bae1-6ad7-8289a1dfb346)
		THEN
		DB_NOOP(1);
		
		// not on the quest part
		QRY
		QRY_WYR_Circus_CanStartFoundClownCorpseVB()
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_State_MetDoppelgangerClown_c1d1c6ec-374b-bae1-6ad7-8289a1dfb346)
		AND
		DB_GlobalFlag((FLAG)WYR_Circus_Event_ClownPiecesPickedHead_6f093bf5-5c08-d686-e7c3-2ede5a4f8a70)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_WYR_Circus_CanStartFoundClownCorpseVB()
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_State_MetDoppelgangerClown_c1d1c6ec-374b-bae1-6ad7-8289a1dfb346)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_Event_ClownPiecesPickedHead_6f093bf5-5c08-d686-e7c3-2ede5a4f8a70)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_Event_ClownPiecesPickedHand_90794df8-03cc-c0bc-f9cb-2284586fe2c2)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_State_FoundCorpseSaidNotOnQuest_81f5aa41-7370-648f-918e-54e651a41ce0)
		THEN
		DB_NOOP(1);
		
		// Picked specific part event flag
		QRY
		QRY_WYR_Circus_PrepareClownCorpseVBFlags((ITEM)_Item)
		AND
		DB_WYR_Circus_ClownPieces(_Item, _, _PickedPieceEventFlag, _)
		THEN
		DB_WYR_Circus_FoundClownCorpseVB_EventFlag(_PickedPieceEventFlag);
		
		// Just one left
		QRY
		QRY_WYR_Circus_PrepareClownCorpseVBFlags((ITEM)_Item)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_Event_ClownPiecesOneLeft_b058bb0e-e7f1-0c0f-8e69-7c7ace5cad4d)
		AND
		QRY_WYR_Circus_ClownPieces_LeftFindLessThan(2)
		THEN
		DB_WYR_Circus_FoundClownCorpseVB_EventFlag((FLAG)WYR_Circus_Event_ClownPiecesOneLeft_b058bb0e-e7f1-0c0f-8e69-7c7ace5cad4d);
		
		// Event flags set/clear
		IF
		DB_WYR_Circus_FoundClownCorpseVB_EventFlag(_Flag)
		THEN
		PROC_GlobalSetFlagAndCache(_Flag);
		
		IF
		VoiceBarkFailed(WYR_Circus_VB_FoundClownCorpse_77e43be7-4efc-e40e-5fd3-02cf42e48fc6)
		AND
		DB_WYR_Circus_FoundClownCorpseVB_EventFlag(_EventFlag)
		THEN
		NOT DB_WYR_Circus_FoundClownCorpseVB_EventFlag(_EventFlag);
		PROC_GlobalClearFlagAndCache(_EventFlag);
		
		IF
		VoiceBarkEnded(WYR_Circus_VB_FoundClownCorpse_77e43be7-4efc-e40e-5fd3-02cf42e48fc6,_)
		AND
		DB_WYR_Circus_FoundClownCorpseVB_EventFlag(_EventFlag)
		THEN
		NOT DB_WYR_Circus_FoundClownCorpseVB_EventFlag(_EventFlag);
		PROC_GlobalClearFlagAndCache(_EventFlag);
		
		IF
		FlagCleared(_EventFlag,_,_)
		AND
		DB_WYR_Circus_FoundClownCorpseVB_EventFlag(_EventFlag)
		THEN
		NOT DB_WYR_Circus_FoundClownCorpseVB_EventFlag(_EventFlag);
		//END_REGION
		
		//REGION Dribbles Quest: kobold merchant with Dribbles hand
		IF
		FlagSet((FLAG)WYR_Circus_State_GotDribblesQuest_780f6847-84a7-ff3e-f8bb-670d625c1a87,_,_)
		THEN
		DB_ItemInRegionFlag(
			(ITEM)S_WYR_Circus_DribblesBodyPart_Hand_dedf021f-478c-4a06-9150-f442e1cd2ecd, 
			(TRIGGER)S_WYR_Circus_MerchantHandArea_70df12a0-bb26-4d9d-9f74-a2b492b1187f, 
			(FLAG)WYR_Circus_State_BodyPartHandInPlace_e9f45d6c-2dac-46a8-8aee-9f457f546d04);
		
		// Buying the hand
		IF
		FlagSet((FLAG)WYR_Circus_Event_AcquireHand_376d9749-78cb-20de-817e-ed880990bea0, _Player, _)
		AND
		IsInInventory((ITEM)S_WYR_Circus_DribblesBodyPart_Hand_dedf021f-478c-4a06-9150-f442e1cd2ecd, 0)
		THEN
		ToInventory(S_WYR_Circus_DribblesBodyPart_Hand_dedf021f-478c-4a06-9150-f442e1cd2ecd, _Player, 1, 1, 1);
		
		IF
		FlagSet((FLAG)WYR_Circus_Event_AcquireHand_376d9749-78cb-20de-817e-ed880990bea0, _Player, _)
		AND
		IsInInventory((ITEM)S_WYR_Circus_DribblesBodyPart_Hand_dedf021f-478c-4a06-9150-f442e1cd2ecd, 1)
		AND
		GetInventoryOwner(S_WYR_Circus_DribblesBodyPart_Hand_dedf021f-478c-4a06-9150-f442e1cd2ecd, S_WYR_Circus_Merchant_60e4431d-dee5-4af4-a05e-65896ec64f2f)
		THEN
		ToInventory(S_WYR_Circus_DribblesBodyPart_Hand_dedf021f-478c-4a06-9150-f442e1cd2ecd, _Player, 1, 1, 1);
		
		IF
		FlagSet((FLAG)WYR_Circus_Event_AcquireHand_376d9749-78cb-20de-817e-ed880990bea0, _,_)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_Circus_State_AcquiredHand_90c6a782-e37d-4a9e-bd79-102636f749b2);
		
		// Custom crime reaction on stealing
		QRY
		QRY_CRIME_BlockRegisterCrime((CHARACTER)_Character, _CrimeType, (ITEM)S_WYR_Circus_DribblesBodyPart_Hand_dedf021f-478c-4a06-9150-f442e1cd2ecd, (CHARACTER)S_WYR_Circus_Merchant_60e4431d-dee5-4af4-a05e-65896ec64f2f, (INTEGER)_CrimeID)
		AND
		DB_PartyMembers(_Character)
		AND
		QRY_WYR_Circus_IsHandStealingCrime(_CrimeType)
		AND
		CrimeGetNewID(_CrimeNewID)
		THEN
		DB_WYR_Circus_HandStealCrime((CHARACTER)_Character, _CrimeNewID);
		PROC_CharacterRegisterCrime(_Character, "WYR_Circus_HandSteal", S_WYR_Circus_DribblesBodyPart_Hand_dedf021f-478c-4a06-9150-f442e1cd2ecd, S_WYR_Circus_Merchant_60e4431d-dee5-4af4-a05e-65896ec64f2f, _CrimeNewID);
		
		QRY
		QRY_WYR_Circus_IsHandStealingCrime((STRING)_CrimeType)
		AND
		DB_WYR_Circus_HandCrimesFamilies(_CrimeFamily)
		AND
		QRY_CRIME_IsCrimeFamilyMember(_CrimeType, _CrimeFamily)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_CrimeGetCustomInterrogationDialog(_, _CrimeID, S_WYR_Circus_Merchant_60e4431d-dee5-4af4-a05e-65896ec64f2f, _Player, _,_,_,_)
		AND
		NOT DB_WYR_Circus_RemoveWarningFlag(_Player, _CrimeID)
		AND
		CrimeGetType(_CrimeID, "WYR_Circus_HandSteal")
		THEN
		SetFlag(WYR_Circus_Event_StoleHand_1a13616d-911e-40e2-88fa-06f9b97d0cdf, _Player, 0);
		DB_WYR_Circus_RemoveWarningFlag(_Player, _CrimeID);
		
		QRY
		QRY_CrimeGetCustomWarning(S_WYR_Circus_Merchant_60e4431d-dee5-4af4-a05e-65896ec64f2f, "WYR_Circus_HandSteal", WYR_Circus_Merchant_808018b3-ccb7-6a1b-e561-f75a1db21839, _CrimeID)
		AND
		CrimeGetCriminals(_CrimeID, (CHARACTER)_Criminal1, _, _, _)
		AND
		NOT DB_WYR_Circus_RemoveWarningFlag(_Criminal1, _CrimeID)
		THEN
		SetFlag(WYR_Circus_Event_StoleHand_1a13616d-911e-40e2-88fa-06f9b97d0cdf, _Criminal1, 0);
		DB_WYR_Circus_RemoveWarningFlag(_Criminal1, _CrimeID);
		
		// Picking up the hand without purchasing - after stealing and dropping on the ground etc.
		IF
		FlagSet(WYR_Circus_State_ClownPiecesHasHand_025d9d68-2786-9bb3-eeed-a89bf0f2ecc4, _Player, _)
		AND
		DB_PartyMembers((CHARACTER)_Player)
		AND
		NOT DB_WYR_Circus_HandStealCrime(_,_)
		AND
		NOT DB_GlobalFlag(WYR_Circus_State_AcquiredHand_90c6a782-e37d-4a9e-bd79-102636f749b2)
		AND
		GetFlag((FLAG)WYR_Circus_Merchant_Event_AcquireHand_376d9749-78cb-20de-817e-ed880990bea0, _Player, 0)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_Circus_State_GotHandByStealHand_f6a0460e-881a-49c6-9107-2d39e9558ca4);
		PROC_GlobalSetFlagAndCache((FLAG)WYR_Circus_State_AcquiredHand_90c6a782-e37d-4a9e-bd79-102636f749b2);
		
		// Clearing and acquiring after the crime times out
		PROC
		PROC_CRIME_Finished(_CrimeID)
		AND
		DB_WYR_Circus_HandStealCrime(_Character, _CrimeID)
		AND
		DB_WYR_Circus_RemoveWarningFlag((CHARACTER)_Character, _CrimeID)
		THEN
		ClearFlag(WYR_Circus_Event_StoleHand_1a13616d-911e-40e2-88fa-06f9b97d0cdf, _Character, 0);
		NOT DB_WYR_Circus_RemoveWarningFlag(_Character, _CrimeID);
		
		PROC
		PROC_CRIME_Finished(_CrimeID)
		AND
		DB_WYR_Circus_HandStealCrime(_Character, _CrimeID)
		AND
		DB_Players(_Player)
		AND
		QRY_ItemInTeamMagicPocketsOrCampChest(S_WYR_Circus_DribblesBodyPart_Hand_dedf021f-478c-4a06-9150-f442e1cd2ecd)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_Circus_State_GotHandByStealHand_f6a0460e-881a-49c6-9107-2d39e9558ca4);
		PROC_GlobalSetFlagAndCache((FLAG)WYR_Circus_State_AcquiredHand_90c6a782-e37d-4a9e-bd79-102636f749b2);
		
		PROC
		PROC_CRIME_Finished(_CrimeID)
		AND
		DB_WYR_Circus_HandStealCrime(_Character, _CrimeID)
		THEN
		NOT DB_WYR_Circus_HandStealCrime(_Character, _CrimeID);
		
		IF
		FlagSet((FLAG)WYR_Circus_Merchant_State_AcquiredHand_90c6a782-e37d-4a9e-bd79-102636f749b2,_,_)
		AND
		DB_WYR_Circus_HandStealCrime(_Character, _CrimeID)
		AND
		DB_WYR_Circus_RemoveWarningFlag((CHARACTER)_Character, _CrimeID)
		THEN
		ClearFlag(WYR_Circus_Event_StoleHand_1a13616d-911e-40e2-88fa-06f9b97d0cdf, _Character, 0);
		NOT DB_WYR_Circus_RemoveWarningFlag(_Character, _CrimeID);
		
		// disabling keep an-eye-out if hand was acquired
		QRY
		QRY_CRIME_KeepingAnEyeOut_Block((CHARACTER)S_WYR_Circus_Merchant_60e4431d-dee5-4af4-a05e-65896ec64f2f, _ID)
		AND
		DB_GlobalFlag((FLAG)WYR_Circus_Merchant_State_AcquiredHand_90c6a782-e37d-4a9e-bd79-102636f749b2)
		AND
		CrimeGetType(_ID, "WYR_Circus_HandSteal")
		THEN
		DB_NOOP(1);
		
		IF
		FlagSet((FLAG)WYR_Circus_Merchant_State_AcquiredHand_90c6a782-e37d-4a9e-bd79-102636f749b2,_,_)
		THEN
		PROC_CRIME_KeepingAnEyeOut_Stop(S_WYR_Circus_Merchant_60e4431d-dee5-4af4-a05e-65896ec64f2f);
		//END_REGION
		
		//REGION Circus disappears
		IF
		DB_PermaDefeated(S_WYR_Circus_Ringmaster_c95af77b-6fc3-4c73-ac7c-087124f4b1e4)
		AND
		DB_GlobalFlag((FLAG)WYR_Circus_State_PostCombat_ee4b2f6e-9d52-4bc5-bde6-bc0e1c015de4)
		AND
		NOT DB_GlobalFlag(WYR_Circus_State_AboutToLeave_39876ea2-3a3a-441d-96be-f907b6226239)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_Circus_State_AboutToLeave_39876ea2-3a3a-441d-96be-f907b6226239);
		
		IF
		FlagSet((FLAG)WYR_Circus_Ringmaster_State_Rewarded_7a42ebcf-255e-853b-bad6-30cf36746c10,_,_)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_Circus_State_AboutToLeave_39876ea2-3a3a-441d-96be-f907b6226239);
		
		PROC
		PROC_LongRestOrLevelUnloading("BGO_Main_A")
		AND
		NOT DB_GlobalFlag(WYR_Circus_State_Gone_151fd307-4cb8-44ba-8998-40e1d748b707)
		AND
		DB_GlobalFlag(WYR_Circus_State_AboutToLeave_39876ea2-3a3a-441d-96be-f907b6226239)
		THEN
		PROC_WYR_Circus_MakeCircusDisappear();
		
		PROC
		PROC_WYR_Circus_MakeCircusDisappear()
		THEN
		PROC_GlobalSetFlagAndCache(WYR_Circus_State_Gone_151fd307-4cb8-44ba-8998-40e1d748b707);
		
		PROC
		PROC_WYR_Circus_MakeCircusDisappear()
		AND
		DB_WYR_Circus_Workers(_NPC)
		AND
		NOT DB_WYR_Circus_DoNotDisappearWithCircus(_NPC)
		AND
		NOT QRY_WYR_Circus_DeadOutsideCircus(_NPC)
		THEN
		SetOnStage(_NPC, 0);
		
		PROC
		PROC_WYR_Circus_MakeCircusDisappear()
		AND
		DB_WYR_Circus_ShowPatrons(_NPC,_,_)
		AND
		NOT DB_WYR_Circus_DoNotDisappearWithCircus(_NPC)
		AND
		NOT QRY_WYR_Circus_DeadOutsideCircus(_NPC)
		THEN
		PROC_CancelDisappearOutOfSight(_NPC);
		SetOnStage(_NPC, 0);
		
		PROC
		PROC_WYR_Circus_MakeCircusDisappear()
		AND
		DB_WYR_Circus_BeastCages(_, _Beast, _)
		AND
		NOT DB_WYR_Circus_DoNotDisappearWithCircus(_Beast)
		AND
		NOT QRY_WYR_Circus_DeadOutsideCircus(_Beast)
		THEN
		SetOnStage(_Beast, 0);
		
		// TODO: Inventory
		QRY
		QRY_WYR_Circus_DeadOutsideCircus((CHARACTER)_NPC)
		AND
		DB_PermaDefeated(_NPC)
		AND
		IsInTrigger(_NPC, S_WYR_Circus_SUB_22d3f3ff-3cbb-4240-a3ab-051889832375, 0)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_WYR_Circus_MakeCircusDisappear()
		AND
		DB_WYR_Circus_DisappearTarget(_Target)
		THEN
		SetOnStage(_Target, 0);
		
		PROC
		PROC_WYR_Circus_MakeCircusDisappear()
		AND
		DB_WYR_Circus_DisappearTarget_CheckTaken(_Item, _Trigger)
		AND
		IsInTrigger(_Item, _Trigger, 1)
		THEN
		SetOnStage(_Item, 0);
		
		PROC
		PROC_WYR_Circus_MakeCircusDisappear()
		AND
		DB_WYR_Circus_VignetteCharacters(_Character)
		AND
		NOT DB_PermaDefeatedOrOffstage(_Character)
		THEN
		SetOnStage(_Character, 0);
		
		PROC
		PROC_WYR_Circus_MakeCircusDisappear()
		THEN
		UnloadLevelTemplate((LEVELTEMPLATE)LT_PLT_BGO_Circus_A_000_35ea4c7d-20e3-4ece-8f66-0b91b92cae09);
		LoadLevelTemplate((LEVELTEMPLATE)LT_PLT_BGO_CircusAftermath_A_000_a9981a88-0781-4770-879d-73b888950564);
		MusicPlayGeneral("Circus_Music_empty");
		
		PROC
		PROC_WYR_Circus_MakeCircusDisappear()
		THEN
		DB_OneShot_VoiceBarkTrigger((TRIGGER)S_WYR_Circus_SUB_22d3f3ff-3cbb-4240-a3ab-051889832375, WYR_Circus_VB_CircusDisappeared_957b67af-c5ae-3bcc-ad76-0f5a16e87be6);
		DB_PartyProgress_Trigger(S_WYR_Circus_SUB_22d3f3ff-3cbb-4240-a3ab-051889832375, WYR_Circus_Knows_Disappeared_e664f3d2-8d76-4fb6-8761-6b145eede1ee);
		GoalCompleted;
		//END_REGION
		
		//REGION Dressing room
		PROC
		PROC_WYR_Circus_StartCombat()
		AND
		IsReposed(S_WYR_Circus_DressingRoomSleeper_29846481-7c1a-449d-8e66-0017cbcd484e, 1)
		THEN
		EndRepose(S_WYR_Circus_DressingRoomSleeper_29846481-7c1a-449d-8e66-0017cbcd484e);
		
		QRY
		QRY_SelectCustomDialog_AfterGenerics((CHARACTER)S_WYR_Circus_DressingRoomSleeper_29846481-7c1a-449d-8e66-0017cbcd484e, (CHARACTER)_Player)
		AND
		IsReposed(S_WYR_Circus_DressingRoomSleeper_29846481-7c1a-449d-8e66-0017cbcd484e, 1)
		THEN
		DB_WYR_Circus_Sleeper_TalkWhenWakeUp(_Player);
		SetEntityEvent(S_WYR_Circus_DressingRoomSleeper_29846481-7c1a-449d-8e66-0017cbcd484e, "GLO_Sit_ManualInterrupt", 1);
		EndRepose(S_WYR_Circus_DressingRoomSleeper_29846481-7c1a-449d-8e66-0017cbcd484e);
		
		IF
		ReposeRemoved(S_WYR_Circus_DressingRoomSleeper_29846481-7c1a-449d-8e66-0017cbcd484e, _)
		AND
		DB_WYR_Circus_Sleeper_TalkWhenWakeUp(_Player)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_WYR_Circus_DressingRoomSleeper_29846481-7c1a-449d-8e66-0017cbcd484e, _Player)
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)WYR_Circus_DressingRoomSleeper_212375f0-7d44-feb8-ba41-cfeb14fc136b, S_WYR_Circus_DressingRoomSleeper_29846481-7c1a-449d-8e66-0017cbcd484e, _Player)
		THEN
		DB_NOOP(1);
		
		IF
		ReposeRemoved(S_WYR_Circus_DressingRoomSleeper_29846481-7c1a-449d-8e66-0017cbcd484e, _)
		AND
		DB_WYR_Circus_Sleeper_TalkWhenWakeUp(_Player)
		THEN
		NOT DB_WYR_Circus_Sleeper_TalkWhenWakeUp(_Player);
		//END_REGION
		
		//REGION Ringmaster
		PROC
		PROC_StartDialog_AddExtraSpeakers(WYR_Circus_Ringmaster_fc57170e-3acf-541c-0879-ca7bf0303426, _Inst)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_Clown_State_Hostile_59c1f674-0985-4d4d-9679-b8a1e4982f45)
		AND
		DB_WYR_Circus_RingmasterSkeletons(_Skeleton)
		AND
		QRY_SpeakerIsInDialogRange(S_WYR_Circus_Ringmaster_c95af77b-6fc3-4c73-ac7c-087124f4b1e4, _Skeleton)
		THEN
		PROC_DialogAddSpeakingActor(_Inst, _Skeleton);
		
		IF
		FlagSet((FLAG)WYR_Circus_Clown_State_Hostile_59c1f674-0985-4d4d-9679-b8a1e4982f45,_,_)
		THEN
		PROC_SceneOver("WYR_Circus_RingmasterSkeletons_SceneDialogOnly");
		//END_REGION
		
		//REGION Crowd
		PROC
		PROC_WYR_Circus_OnCombatStarted()
		THEN
		PROC_WYR_Circus_RemoveCrowd();
		
		PROC
		PROC_WYR_Circus_RemoveCrowd()
		AND
		DB_WYR_Circus_Crowd(_Crowd)
		THEN
		TriggerSetCrowdSpawningEnable(_Crowd, 0);
		TriggerSetCrowdBehaviour(_Crowd, CROWDBEHAVIOUR.Flee);
		//END_REGION
		
		//REGION Jungle
		PROC
		PROC_FlagReactionAfterDialog(_Player, (FLAG)WYR_Circus_Event_WheelSendToJungle_c542b674-dde9-f9c3-b3e7-c3e17d3d5cca)
		THEN
		PROC_WYR_Circus_SendToJungle((CHARACTER)_Player);
		
		PROC
		PROC_WYR_Circus_SendToJungle((CHARACTER)_Player)
		THEN
		DB_WYR_Jungle_BlackScreenChar((CHARACTER)_Player);
		ScreenFadeTo((CHARACTER)_Player, 1.5, 0, "WYR_Jungle_FadeToBlack");
		PlayEffect(_Player, VFX_Script_Djinni_Teleport_7c79ada5-e179-5d0b-0557-29fca6201742, "");
		PROC_Helper_SafeTeleportTo((CHARACTER)_Player, S_WYR_Jungle_StartPoint_46183c94-820c-4f06-88c4-3e1726a581cb, "WYR_Curcus_Event_TeleportToJungle", 0, 0, 0);
		ApplyStatus(_Player, "SNEAKING", -1.0, 1); 
		
		IF
		ScreenFadeDone(_ID, "WYR_Jungle_FadeToBlack")
		AND
		DB_WYR_Jungle_BlackScreenChar((CHARACTER)_Player)
		THEN
		NOT DB_WYR_Jungle_BlackScreenChar((CHARACTER)_Player);
		ClearScreenFade((CHARACTER)_Player, 1.0, "WYR_Jungle_FadeToBlack");
		RealtimeObjectTimerLaunch(_Player, "WYR_Jungle_PAD_Timer", 2000);
		
		IF
		ObjectTimerFinished((CHARACTER)_Player, "WYR_Jungle_PAD_Timer")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)WYR_Circus_PAD_EnteredJungle_370ba0b1-ab79-0dc2-321e-7dac091286bc, _Player);
		
		IF
		Died(_Player)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		DB_InRegion((CHARACTER)_Player, S_WYR_Jungle_SUB_8bb03671-b130-4b2f-877b-bc7eb8cc4d49)
		THEN
		RealtimeObjectTimerLaunch(_Player, "WYR_Circus_DiedInJungle", 2000);
		
		IF
		ObjectTimerFinished(_Player, "WYR_Circus_DiedInJungle")
		THEN
		ApplyStatus(_Player, "DEAD_WILL_O_WISP" , -1.0, 1, NULL_00000000-0000-0000-0000-000000000000);
		PlayEffect(_Player, VFX_Script_FairyRing_Teleport_01_4af1c68d-79ee-ced0-4484-8e2b3b1fc95c, "");
		PROC_Helper_SafeTeleportTo((CHARACTER)_Player, S_WYR_Circus_FromJungleDeadTeleportPoint_f4860043-9640-4361-8dea-549de7aaef25, "", 0, 0, 0);
		
		// Dinos behaviours
		IF
		EntityEvent(_, "WYR_Jungle_Alioramus_01_LeftIntroArea")
		THEN
		NOT DB_TriggerEvents_AllPlayersLeft(S_WYR_Jungle_StartingArea_d1887a22-bb9d-4041-86ab-5249fec34cf4, "WYR_Jungle_Alioramus_01_LeftIntroArea");
		SetEntityEvent(S_WYR_Jungle_Alioramus_01_b2bdcb69-3a93-4200-b64e-154f44723b71, "WYR_Jungle_Alioramus_01_Event_FinishIntro", 1);
		
		IF
		EntityEvent(_, "WYR_Jungle_Alioramus_01_LeftRoutineAArea")
		THEN
		NOT DB_TriggerEvents_AllPlayersLeft(S_WYR_Jungle_Alioramus_01_RoutineAArea_98ea94ec-3951-4318-a3b9-79cb74516540, "WYR_Jungle_Alioramus_01_LeftRoutineAArea");
		SetEntityEvent(S_WYR_Jungle_Alioramus_01_b2bdcb69-3a93-4200-b64e-154f44723b71, "WYR_Jungle_Alioramus_01_Event_LeftRoutineAArea", 1);
		
		IF
		EntityEvent(_, "WYR_Jungle_Alioramus_04_LeftIntroArea")
		THEN
		NOT DB_TriggerEvents_AllPlayersLeft(S_WYR_Jungle_Alioramus_04_SkipIntroArea_a0e1ca0c-c23b-416b-80e1-b66d96ef5de7, "WYR_Jungle_Alioramus_04_LeftIntroArea");
		SetEntityEvent(S_WYR_Jungle_Alioramus_04_76f78311-aa65-4108-84b6-61f5f033ac0d, "WYR_Jungle_Alioramus_04_Event_FinishIntro", 1);
		
		IF
		EnteredTrigger(_Player, S_WYR_Jungle_Alioramus_StartFeedingIntroArea_af4c7263-125b-468c-8d43-1450990c9b7e)
		THEN
		PROC_TriggerUnregisterForPlayers(S_WYR_Jungle_Alioramus_StartFeedingIntroArea_af4c7263-125b-468c-8d43-1450990c9b7e);
		PROC_GlobalSetFlagAndCache(WYR_Jungle_Event_StartFeedingIntro_e409feaa-398a-4c3a-b76b-59de927fb547);
		
		IF
		TurnStarted(S_WYR_Jungle_Alioramus_Female_60a49df8-b266-40b4-bc44-2ac1ec36a7cc)
		AND
		NOT DB_WYR_Jungle_DinoWokeup(S_WYR_Jungle_Alioramus_05_c6df7a48-97c7-4138-9ec4-a1e2a9dbad87)
		AND
		NOT DB_Defeated(S_WYR_Jungle_Alioramus_05_c6df7a48-97c7-4138-9ec4-a1e2a9dbad87)
		AND
		DB_Is_InCombat(S_WYR_Jungle_Alioramus_Female_60a49df8-b266-40b4-bc44-2ac1ec36a7cc, _CombatID)
		AND
		IsInTrigger(S_WYR_Jungle_Alioramus_Female_60a49df8-b266-40b4-bc44-2ac1ec36a7cc, (TRIGGER)S_WYR_Jungle_CaveArea_9f238ec0-6b58-4192-88cb-3e6e907d80ea, 1)
		AND
		IsInTrigger(S_WYR_Jungle_Alioramus_05_c6df7a48-97c7-4138-9ec4-a1e2a9dbad87, (TRIGGER)S_WYR_Jungle_CaveArea_9f238ec0-6b58-4192-88cb-3e6e907d80ea, 1)
		AND
		HasAppliedStatus(S_WYR_Jungle_Alioramus_Female_60a49df8-b266-40b4-bc44-2ac1ec36a7cc, "SILENCED", 0)
		AND
		HasAppliedStatus(S_WYR_Jungle_Alioramus_05_c6df7a48-97c7-4138-9ec4-a1e2a9dbad87, "SILENCED", 0)
		AND
		HasAppliedStatus(S_WYR_Jungle_Alioramus_05_c6df7a48-97c7-4138-9ec4-a1e2a9dbad87, "SLEEPING", 1)
		THEN
		DB_WYR_Jungle_DinoWokeup(S_WYR_Jungle_Alioramus_05_c6df7a48-97c7-4138-9ec4-a1e2a9dbad87);
		RemoveStatus(S_WYR_Jungle_Alioramus_05_c6df7a48-97c7-4138-9ec4-a1e2a9dbad87, "SLEEPING");
		
		IF
		UseFinished(_Player, S_WYR_Jungle_Portal_21b6cd38-39b9-4369-9838-c0e4e5e7acce, 1)
		AND
		QRY_OnlyOncePerUser(_Player, "WYR_Circus_ReturnFromJungle_OnlyOnce")
		THEN
		RealtimeObjectTimerLaunch(_Player, "WYR_Circus_ReturnFromJungle_Timer", 1000);
		
		IF
		ObjectTimerFinished(_Player, "WYR_Circus_ReturnFromJungle_Timer")
		THEN
		PROC_TryStartAD(WYR_Circus_PAD_ReturnedFromJungle_ac5d699c-8e49-26b5-65ea-3f396c37730e, (CHARACTER)_Player);
		
		// Peaceful resolution
		IF
		DB_Is_InCombat(_Dino, _CombatID)
		AND
		DB_WYR_Jungle_Dinos((CHARACTER)_Dino)
		AND
		DB_Players(_Player)
		AND
		DB_Is_InCombat(_Player, _CombatID)
		THEN
		DB_WYR_Jungle_NoticedByDinos((CHARACTER)_Player);
		
		IF
		UseFinished(_Player, S_WYR_Jungle_Portal_21b6cd38-39b9-4369-9838-c0e4e5e7acce, 1)
		AND
		DB_Players(_Player)
		AND
		NOT DB_WYR_Jungle_NoticedByDinos(_Player)
		AND
		DB_WYR_Jungle_Dinos(_Dino)
		THEN
		PROC_PeacefulResolve(_Dino);
		//END_REGION
		
		//REGION Debug
		IF
		TextEvent("WYR_Circus_RemoveCrowd")
		THEN
		PROC_WYR_Circus_RemoveCrowd();
		
		IF
		TextEvent("WYR_Circus_TestStatue")
		AND
		GetHostCharacter(_Player)
		THEN
		RemoveTransforms(S_WYR_Circus_StatueDummy_c2ef6bde-3dbe-4ff5-99ca-8120445a8309);
		RealtimeObjectTimerLaunch(_Player, "WYR_Circus_TestStatue_Timer", 1000);
		
		IF
		ObjectTimerFinished(_Player, "WYR_Circus_TestStatue_Timer")
		THEN
		PROC_WYR_Circus_CreateStatueCopy((CHARACTER)_Player);
		TeleportTo(S_WYR_Circus_StatueDummy_c2ef6bde-3dbe-4ff5-99ca-8120445a8309, S_WYR_Circus_StatuePos_bb49d2b2-a8fa-4b75-9764-0f3823eb0dd7, "",0,0,0,1,1);
		
		IF
		TextEvent("WYR_Circus_GetQuest")
		THEN
		PROC_GlobalClearFlagAndCache(Debug_WYR_Circus_GetDribblesQuest_16042831-9eae-2ca4-7340-ac5d7f2a1e03);
		
		IF
		TextEvent("WYR_Circus_GetClownPieces")
		AND
		GetHostCharacter(_Player)
		THEN
		SetFlag(Debug_WYR_Circus_GetAllDribblesParts_4a29bfbc-a0d3-d2fb-4807-85d5623aab9c, _Player, 0);
		
		IF
		TextEvent("WYR_Circus_TestCheese")
		AND
		GetHostCharacter(_Player)
		THEN
		PROC_WYR_Circus_WheelWorkerTransform(_Player);
		
		IF
		TextEvent("WYR_Circus_TestJungle")
		AND
		GetHostCharacter(_Player)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_Circus_FortuneWheelWorker_State_WonGrandPrize_70949ccb-0be4-d4a0-86b3-421939e1b17e);
		SetFlag(WYR_Circus_Event_WheelSendToJungle_c542b674-dde9-f9c3-b3e7-c3e17d3d5cca, _Player, 0);
		PROC_WYR_Circus_SendToJungle(_Player);
		
		IF
		TextEvent("WYR_Circus_TestDisappear")
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_Circus_Clown_State_Hostile_59c1f674-0985-4d4d-9679-b8a1e4982f45);
		PROC_GlobalSetFlagAndCache((FLAG)WYR_Circus_State_GotDribblesQuest_780f6847-84a7-ff3e-f8bb-670d625c1a87);
		PROC_WYR_Circus_KillAllAbsolutists();
		PROC_WYR_Circus_BorrowClown();
		PROC_WYR_Circus_MakeCircusDisappear();
		
		IF
		TextEvent("WYR_Circus_TestFlamingFists")
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_Circus_Clown_State_Hostile_59c1f674-0985-4d4d-9679-b8a1e4982f45);
		PROC_GlobalSetFlagAndCache((FLAG)WYR_Circus_State_GotDribblesQuest_780f6847-84a7-ff3e-f8bb-670d625c1a87);
		PROC_WYR_Circus_LeftCombat_AbsolutistsWon();
		
		IF
		FlagSet((FLAG)Debug_WYR_Circus_GetDribblesQuest_16042831-9eae-2ca4-7340-ac5d7f2a1e03,_,_)
		THEN
		PROC_WYR_Circus_KillAllAbsolutists();
		PROC_GlobalSetFlagAndCache((FLAG)WYR_Circus_Clown_State_Hostile_59c1f674-0985-4d4d-9679-b8a1e4982f45);
		PROC_GlobalSetFlagAndCache((FLAG)WYR_Circus_State_GotDribblesQuest_780f6847-84a7-ff3e-f8bb-670d625c1a87);
		PROC_GlobalClearFlagAndCache((FLAG)Debug_WYR_Circus_GetDribblesQuest_16042831-9eae-2ca4-7340-ac5d7f2a1e03);
		
		IF
		FlagSet((FLAG)Debug_WYR_Circus_GetAllDribblesParts_4a29bfbc-a0d3-d2fb-4807-85d5623aab9c, _Player, _)
		THEN
		PROC_WYR_Circus_Debug_GetAllCTYParts();
		PROC_WYR_Circus_Debug_GetAllWYRParts();
		
		PROC
		PROC_WYR_Circus_Debug_GetAllCTYParts()
		AND
		DB_CurrentLevel("CTY_Main_A")
		AND
		GetHostCharacter(_Player)
		AND
		DB_WYR_Circus_ClownPieces(_Piece,_,_,_)
		AND
		_Piece != S_WYR_Circus_DribblesBodyPart_Hand_dedf021f-478c-4a06-9150-f442e1cd2ecd
		AND
		_Piece != S_WYR_Circus_DribblesBodyPart_Torso_ffb44db4-4573-4ddd-89f9-24b790e0c838
		THEN
		ToInventory(_Piece, _Player, 1,1,1);
		
		PROC
		PROC_WYR_Circus_Debug_GetAllWYRParts()
		AND
		DB_CurrentLevel("BGO_Main_A")
		AND
		GetHostCharacter(_Player)
		THEN
		ToInventory(S_WYR_Circus_DribblesBodyPart_Hand_dedf021f-478c-4a06-9150-f442e1cd2ecd, _Player, 1,1,1);
		ToInventory(S_WYR_Circus_DribblesBodyPart_Torso_ffb44db4-4573-4ddd-89f9-24b790e0c838, _Player, 1,1,1);
		PROC_GlobalSetFlagAndCache((FLAG)WYR_Circus_State_AcquiredHand_90c6a782-e37d-4a9e-bd79-102636f749b2);
		
		IF
		FlagSet((FLAG)Debug_WYR_Circus_GetAllDribblesParts_4a29bfbc-a0d3-d2fb-4807-85d5623aab9c, _Player, _Inst)
		THEN
		ClearFlag(Debug_WYR_Circus_GetAllDribblesParts_4a29bfbc-a0d3-d2fb-4807-85d5623aab9c, _Player, _Inst);
		
		// Dryad
		IF
		TextEvent("WYR_Circus_LoveDryadTestBlessing")
		AND
		DB_Players(_Player)
		THEN
		ApplyStatus(_Player, "WYR_CIRCUS_LOVEDRYAD_BLESSING_AURA", -1.0, 1, S_WYR_Circus_LoveDryad_a8bce35d-17ee-46e3-8d56-1d0d29c4a01e);
		//END_REGION
		
		//REGION Journal
		// FoundHand
		IF
		FlagSet((FLAG)WYR_Circus_State_ClownPiecesHasHand_025d9d68-2786-9bb3-eeed-a89bf0f2ecc4, _Player, _)
		AND
		DB_PartyMembers((CHARACTER)_Player)
		AND
		DB_GlobalFlag((FLAG)WYR_Circus_State_GotDribblesQuest_780f6847-84a7-ff3e-f8bb-670d625c1a87)
		AND
		NOT QRY_QuestUpdateIsUnlockedForAny("WYR_Clown", "GotHand")
		THEN
		QuestUpdate("WYR_Clown", "FoundHand");
		
		IF
		DB_GlobalFlag((FLAG)WYR_Circus_Knows_MerchantHasHand_ae4d6d60-9541-388b-7e32-4233567480f1)
		AND
		DB_GlobalFlag((FLAG)WYR_Circus_State_GotDribblesQuest_780f6847-84a7-ff3e-f8bb-670d625c1a87)
		AND
		NOT QRY_QuestUpdateIsUnlockedForAny("WYR_Clown", "GotHand")
		THEN
		QuestUpdate("WYR_Clown", "FoundHand");
		
		// GotQuest_DoesntKnow
		IF
		FlagSet((FLAG)WYR_Circus_State_GotDribblesQuest_780f6847-84a7-ff3e-f8bb-670d625c1a87,_,_)
		AND
		NOT DB_GlobalFlag(WYR_Circus_Knows_ClownDead_b0651ffa-2c1d-41b9-b4e8-1af9677db7e0)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_Knows_RingmasterDoesntCareClownDead_b11102de-d799-518f-aa4d-c3663074b3d1)
		THEN
		QuestUpdate("WYR_Clown", "GotQuest_DoesntKnow");
		
		//GotQuest_DoesntKnow_SuggestedDead
		IF
		FlagSet((FLAG)WYR_Circus_State_GotDribblesQuest_780f6847-84a7-ff3e-f8bb-670d625c1a87,_,_)
		AND
		NOT DB_GlobalFlag(WYR_Circus_Knows_ClownDead_b0651ffa-2c1d-41b9-b4e8-1af9677db7e0)
		AND
		DB_GlobalFlag((FLAG)WYR_Circus_Knows_RingmasterDoesntCareClownDead_b11102de-d799-518f-aa4d-c3663074b3d1)
		THEN
		QuestUpdate("WYR_Clown", "GotQuest_DoesntKnow_SuggestedDead");
		
		// LearnedDead_SwD
		IF
		FlagSet((FLAG)WYR_Circus_Knows_DoppelgangerKilledDribbles_a1c76c3e-b21e-7a81-c594-5a34a0f44473,_,_)
		AND
		DB_GlobalFlag((FLAG)WYR_Circus_State_GotDribblesQuest_780f6847-84a7-ff3e-f8bb-670d625c1a87)
		AND
		DB_Players(_Player)
		THEN
		QuestUpdate("WYR_Clown", "LearnedDead_SwD");
		
		// Body parts
		IF
		DB_WYR_Circus_ClownPieces_PickedPieces(_Item)
		AND
		DB_WYR_Circus_ClownPieces(_Item,_,_,_QuestUpdate)
		THEN
		QuestUpdate("WYR_Clown", _QuestUpdate);
		
		// LearnedSplit
		IF
		DB_WYR_Circus_ClownPieces_PickedPieces(_Item)
		AND
		_Item != S_WYR_Circus_DribblesBodyPart_Hand_dedf021f-478c-4a06-9150-f442e1cd2ecd
		THEN
		QuestUpdate("WYR_Clown", "LearnedSplit");
		
		// FoundHalf
		IF
		DB_WYR_Circus_ClownPieces_PickedPieces(_Item)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_Circus_Event_ClownPiecesOneLeft_b058bb0e-e7f1-0c0f-8e69-7c7ace5cad4d)
		AND
		QRY_WYR_Circus_ClownPieces_LeftFindLessThan(4)
		AND
		DB_Players(_Player)
		AND
		QuestUpdateIsUnlocked(_Player, "WYR_Clown", "FoundHalf", 0)
		AND
		GetFlag((FLAG)WYR_Circus_State_ClownPiecesHasAll_73f56db8-afa1-4b5f-a7a6-611afddcf435, _Player, 0)
		THEN
		QuestUpdate(_Player, "WYR_Clown", "FoundHalf");
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(532).Title("Act3_WYR_Danthelon");
Goal(532)
{
	INIT
	{
		DB_GLO_SetupForAct_Character("BGO_Main_A",(CHARACTER)S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a);
		
		
		DB_Dialogs(S_WYR_Danthelon_3570c049-effb-4839-aaae-c628b5d01456,WYR_Axe_Danthelon_2944db0f-3292-aee9-cc2f-ddc3e43c66ca);
		DB_Dialogs(S_WYR_Axe_Guard_01_607cce5c-c108-490b-bca9-281852e6f4cc,WYR_Axe_Guard_01_252e6ace-3c57-4acc-fdce-83633d2d951f);
		DB_Dialogs(S_WYR_Axe_Guard_02_1795ac19-6fe7-4382-a05c-aa854fab3832,WYR_Axe_Guard_02_c87d157e-a061-67ac-1590-615dc294147c);
		
		DB_HasItemEvent((ITEM)S_WYR_DoorToDoppelgangersKey_f678f361-79d5-4f12-8f49-4917b55786a1, (FLAG)WYR_Axe_HasKey_fad39b1f-fcac-4453-bafe-916f7e831cc7);
		DB_GiveItemToEvent((ITEM)S_WYR_DoorToDoppelgangersKey_f678f361-79d5-4f12-8f49-4917b55786a1, (FLAG)WYR_Axe_GiveKey_f8549fbf-cf67-4670-9a8e-e20961380e93);
		
		
		TriggerRegisterForCharacter(S_WYR_DanthelonShop_MainFloor_Zone_a61c9e4f-b541-4f87-81af-ca7558cc50e1,S_WYR_Danthelon_3570c049-effb-4839-aaae-c628b5d01456);
		
		DB_SpotPlayers(S_WYR_Axe_Guard_02_1795ac19-6fe7-4382-a05c-aa854fab3832,"WYR_Axe_Guard",NULL_00000000-0000-0000-0000-000000000000,NULL_00000000-0000-0000-0000-000000000000);
		DB_SpotPlayers_SpotTrigger(S_WYR_Axe_Guard_02_1795ac19-6fe7-4382-a05c-aa854fab3832,"WYR_Axe_Guard",S_WYR_Axe_GuardSpotZone_f753152d-064d-47c4-806b-57e3c52b0220);
		
		
		DB_GlobalFlagReactionAfterDialog(WYR_Axe_Event_TalkedToDanthelon_35490580-d4e8-44e1-a726-45ed781cb5a8,WYR_Axe_Danthelon_2944db0f-3292-aee9-cc2f-ddc3e43c66ca);
		
		DB_ItemOwnerShipTriggers("BGO_Main_A",S_WYR_DanthelonShop_OwnershipTrigger_316bd462-c105-4847-bf15-c8619c0bc5b9,S_WYR_Danthelon_3570c049-effb-4839-aaae-c628b5d01456);
		
		DB_WYR_Axe_Buttons((ITEM)S_WYR_Axe_Backdoor_Door_02_4f22b49d-b77f-47bf-b7ac-1025ac387a0a, (ITEM)S_WYR_Axe_OpenDoorButton_02_f3d37c6f-b925-4bf6-9a97-179322499992);
		DB_WYR_Axe_Buttons((ITEM)S_WYR_Axe_Backdoor_Door_01_e41570db-5b81-4536-a8ef-84cac5263802, (ITEM)S_WYR_Axe_OpenDoorButton_01_d52a3860-6236-4b3a-a425-488ad30d617b);
	}
	KB
	{
		//REGION Debug
		
		IF
		FlagSet(Debug_WYR_Axe_SetupWithoutJaheira_962990a7-d06a-4379-906a-9018b073776a,_,_)
		THEN
		PROC_SceneManager_RemoveFromScene(S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a,"WYR_Axe_Ambush"); // outdated
		TeleportTo(S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a,S_Debug_Teleport_WYR_Start_267cc194-a67a-4705-9459-3187e51487db);
		
		IF
		Teleported(S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a,_,_,_,_,_,_,_,_)
		AND
		DB_GlobalFlag(Debug_WYR_Axe_SetupWithoutJaheira_962990a7-d06a-4379-906a-9018b073776a)
		THEN
		NOT DB_PreventPermaDefeated(S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a);
		SetTag(S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a,BLOCK_RESURRECTION_22a75dbb-1588-407e-b559-5aa4e6d4e6a6);
		
		IF
		TagSet(S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a,BLOCK_RESURRECTION_22a75dbb-1588-407e-b559-5aa4e6d4e6a6)
		AND
		DB_GlobalFlag(Debug_WYR_Axe_SetupWithoutJaheira_962990a7-d06a-4379-906a-9018b073776a)
		THEN
		Die(S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a);
		
		IF
		DB_Defeated(S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a)
		AND
		DB_GlobalFlag(Debug_WYR_Axe_SetupWithoutJaheira_962990a7-d06a-4379-906a-9018b073776a)
		THEN
		ClearFlag(Debug_WYR_Axe_SetupWithoutJaheira_962990a7-d06a-4379-906a-9018b073776a);
		PROC_GLO_SetupForAct_DebugRerun();
		
		IF
		FlagSet(ORI_State_Recruited_e78c0aab-fb48-98e9-3ed9-773a0c39988d,S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a,_)
		THEN
		DB_WYR_Axe_DebugRerunJaheiraCompanon(1);
		
		IF
		EntityEvent(S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a,"Debug_CharacterAdd_Teleported")
		THEN
		DB_WYR_Axe_DebugRerunJaheiraCompanon(2);
		
		IF
		DB_WYR_Axe_DebugRerunJaheiraCompanon(1)
		AND
		DB_WYR_Axe_DebugRerunJaheiraCompanon(2)
		THEN
		NOT DB_WYR_Axe_DebugRerunJaheiraCompanon(1);
		NOT DB_WYR_Axe_DebugRerunJaheiraCompanon(2);
		PROC_GLO_SetupForAct_DebugRerun();
		
		//END_REGION Debug
		
		
		PROC
		PROC_SpotPlayers_Spotted(_Guard,"WYR_Axe_Guard",_Player)
		THEN
		PROC_TryStartAD(WYR_Axe_AD_GuardWelcome_096218c2-b541-35d9-1477-12f1b50afc63,_Guard);
		
		
		PROC
		PROC_GLO_SetupForAct("BGO_Main_A",S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a,0)
		THEN
		SysCompleteGoal("Act3_WYR_Danthelon_Jah");
		SysActivateGoal("Act3_WYR_Danthelon_NoJah");
		
		PROC
		PROC_GLO_SetupForAct("BGO_Main_A",S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a,1)
		THEN
		SysCompleteGoal("Act3_WYR_Danthelon_NoJah");
		SysActivateGoal("Act3_WYR_Danthelon_Jah");
		
		
		PROC
		PROC_GlobalFlagReactionAfterDialog(WYR_Axe_Event_TalkedToDanthelon_35490580-d4e8-44e1-a726-45ed781cb5a8,WYR_Axe_Danthelon_2944db0f-3292-aee9-cc2f-ddc3e43c66ca)
		AND
		NOT DB_Defeated(S_WYR_Axe_Guard_02_1795ac19-6fe7-4382-a05c-aa854fab3832)
		THEN
		PROC_TryStartAD(WYR_Axe_AD_HoldTheDoor_c2e8d03a-63c0-c1d2-11ae-807c0a9df5fc,S_WYR_Danthelon_3570c049-effb-4839-aaae-c628b5d01456);
		SetFlag(WYR_Axe_GuardAtDoor_516190a2-f223-4777-9019-24438e0c5688,NULL_00000000-0000-0000-0000-000000000000,0);
		
		PROC
		PROC_GLO_DefeatCounter_AllPermaDefeated("WYR_Axe_Assassins")
		THEN
		ClearFlag(WYR_Axe_GuardAtDoor_516190a2-f223-4777-9019-24438e0c5688,NULL_00000000-0000-0000-0000-000000000000,0);
		
		
		// Buttons - opening
		IF
		UseStarted(_,_Button)
		AND
		DB_WYR_Axe_Buttons(_Door, _Button)
		AND
		IsDestroyed(_Door, 0)
		AND
		IsOpened(_Door, 0)
		THEN
		PROC_ItemUnlockAndOpen(_Door);
		DB_WYR_Axe_UnlockedByButton(_Door);
		
		// closing
		IF
		UseStarted(_,_Button)
		AND
		DB_WYR_Axe_Buttons(_Door, _Button)
		AND
		DB_WYR_Axe_UnlockedByButton(_Door)
		AND
		IsDestroyed(_Door, 0)
		AND
		IsOpened(_Door, 1)
		AND
		IsLocked(_Door, 0)
		THEN
		Lock(_Door, "WYR_Axe_BackdoorKey");
		
		IF
		UseStarted(_,_Button)
		AND
		DB_WYR_Axe_Buttons(_Door, _Button)
		AND
		IsDestroyed(_Door, 0)
		AND
		IsOpened(_Door, 1)
		THEN
		Close(_Door);
		
		IF
		Unlocked(_Door, _Character, _)
		AND
		_Character != NULL_00000000-0000-0000-0000-000000000000
		AND
		DB_WYR_Axe_UnlockedByButton(_Door)
		THEN
		NOT DB_WYR_Axe_UnlockedByButton(_Door);
	}
	EXIT
	{
		NOT DB_WYR_Axe_DebugRerunJaheiraCompanon(1);
		NOT DB_WYR_Axe_DebugRerunJaheiraCompanon(2);
	}
}
Goal(533).Title("Act3_WYR_Danthelon_Jah");
Goal(533)
{
	INIT
	{
		SetOnStage(S_WYR_Axe_RealHarper_76b789cf-7d4f-431a-abba-90b12de21ec7,1);
		SetOnStage(S_WYR_Axe_DoppelgangerAssassin_001_7867564d-583d-4558-a927-1508ea61cf75,1);
