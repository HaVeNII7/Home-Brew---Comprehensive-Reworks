		DB_ItemDialog_NarratorAD((ITEM)S_SCL_MountainPassSignpost_7fd3482d-72a1-4f69-9cb1-1c40138513c6, (DIALOGRESOURCE)SCL_General_AD_MountainPassSignpost_5631e64e-d930-2305-be88-f6a4ade08e9b);
