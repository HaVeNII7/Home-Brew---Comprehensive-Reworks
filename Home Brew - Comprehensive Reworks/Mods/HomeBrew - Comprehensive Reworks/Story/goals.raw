		THEN
		DB_KnowledgeSkillCheck(_Player, _Identifier, _Reference, _Result);
		
		//END_REGION
		
		//REGION External wrappers
		
		QRY
		QRY_GLO_KnowledgeCheck_Succeeded((CHARACTER)_Player, (STRING)_Identifier, (GUIDSTRING)_Reference)
