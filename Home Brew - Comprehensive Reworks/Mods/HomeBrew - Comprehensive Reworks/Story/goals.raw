		AND
		NOT DB_ORI_Dating((CHARACTER)_DarkUrge, _OtherCharacter)
		THEN
		NOT DB_ORI_DarkUrge_FavouriteCharacter(_OtherCharacter);
		DB_ORI_DarkUrge_FavouriteCharacter(_Character);
		
		
