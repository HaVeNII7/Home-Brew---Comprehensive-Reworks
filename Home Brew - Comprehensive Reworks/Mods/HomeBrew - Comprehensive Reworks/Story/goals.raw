		AND
		NOT DB_GlobalFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_EventSkipped_a673a247-3884-42ce-b6f5-298340e5a092) // flagType: Global
		AND
		QuestUpdateIsUnlocked(_Player, "HAG_HagSpawn", "Start", 0)
		AND
		QuestUpdateIsUnlocked(_Player, "HAG_HagSpawn", "Start_KnowEthel", 0)
		AND
		NOT DB_HAG_HagAmbush_HagTraderMet(1)
		THEN
		QuestUpdate(_Player, "HAG_HagSpawn", "Start");
		
		IF
		DB_GlobalFlag(HAG_HagAmbush_Brother_001_Quest_FoundDead_0f120e4b-2f9b-4d19-b5a5-a0bbaaf8f4bd)
		AND
		DB_GlobalFlag(HAG_HagAmbush_Brother_002_Quest_FoundDead_443e8283-1ebd-41a7-8970-1a870d31c46e)
		AND
		DB_GlobalFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_KillBrothers_c69703b1-eb8f-a8c8-8f77-3ef90d267726)
		AND
		DB_Players(_Player)
		AND
		QuestUpdateIsUnlocked(_Player, "HAG_HagSpawn", "SpokeToBrothers", 1)
		AND
		QuestIsAccepted(_Player, "HAG_HagSpawn", 1)
		THEN
		QuestUpdate(_Player, "HAG_HagSpawn", "BrothersDied");
		
		IF
		DB_GlobalFlag(HAG_HagAmbush_Brother_001_Quest_FoundDead_0f120e4b-2f9b-4d19-b5a5-a0bbaaf8f4bd)
		AND
		DB_GlobalFlag(HAG_HagAmbush_Brother_002_Quest_FoundDead_443e8283-1ebd-41a7-8970-1a870d31c46e)
		AND
		DB_GlobalFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_KillBrothers_c69703b1-eb8f-a8c8-8f77-3ef90d267726)
		AND
		DB_Players(_Player)
		AND
		QuestUpdateIsUnlocked(_Player, "HAG_HagSpawn", "RefusedHelpBrothers1", 1)
		AND
		QuestIsAccepted(_Player, "HAG_HagSpawn", 1)
		THEN
		QuestUpdate(_Player, "HAG_HagSpawn", "BrothersDied");
		
		IF
		DB_Sees(_Player, _Brother)
		AND
		DB_Players(_Player)
		AND
		DB_HAG_HagAmbush_Brothers_DiedAfterLongRest(_Brother)
		AND
		CanSee(_Player, _Brother, 1)
		AND
		DB_GlobalFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_PlayerSidedBrothers_130b6712-6f14-8e62-df19-1b4f33ed07b0)
		AND
		QRY_OncePerUserAndNearbyPlayers(_Player, "HAG_HagAmush_VB_FoundBrothersAfterLongRest")
		THEN
		StartVoiceBark(HAG_HagAmush_VB_FoundBrothersAfterLongRest_552b52d4-9305-b603-ef6f-37c4b90847fd, _Player);
		
		IF
		DB_GlobalFlag(HAG_HagAmbush_Brother_002_Quest_FoundDead_443e8283-1ebd-41a7-8970-1a870d31c46e)
		THEN
		NOT DB_SeenDeadNPCGlobalFlag(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b, HAG_HagAmbush_Brother_002_Quest_FoundDead_443e8283-1ebd-41a7-8970-1a870d31c46e);
		
		IF
		DB_GlobalFlag(HAG_HagAmbush_Brother_001_Quest_FoundDead_0f120e4b-2f9b-4d19-b5a5-a0bbaaf8f4bd)
		THEN
		NOT DB_SeenDeadNPCGlobalFlag(S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e, HAG_HagAmbush_Brother_001_Quest_FoundDead_0f120e4b-2f9b-4d19-b5a5-a0bbaaf8f4bd);
		
		IF
		FlagSet(HAG_Hagspawn_Knows_SurrogateMotherHusbandDead_7ae89d99-c5b4-475c-86d4-88ad80265270, _Character, _)
		AND
		QuestUpdateIsUnlocked((CHARACTER)_Character, "HAG_HagSpawn", "DealInterrupted", 1)
		THEN
		QuestUpdate((CHARACTER)_Character, "HAG_HagSpawn", "KilledHusband");
		
		IF
		FlagSet((FLAG)HAG_Hagspawn_Knows_SurrogateMotherDefeated_8f4738c9-7877-86e4-316a-2447a949e136, _Player, _)
		AND
		QuestUpdateIsUnlocked((CHARACTER)_Player, "HAG_HagSpawn", "KilledMayrina", 0)
		THEN
		QuestUpdate((CHARACTER)_Player, "HAG_HagSpawn", "MayrinaDefeated");
		
		IF
		FlagSet((FLAG)HAG_Hagspawn_Knows_SurrogateMotherDead_84db6af7-3f52-4ae9-a3fc-7ce5a35fc16c, _Player, _)
		AND
		QuestUpdateIsUnlocked((CHARACTER)_Player, "HAG_HagSpawn", "KilledMayrina", 0)
		THEN
		QuestUpdate((CHARACTER)_Player, "HAG_HagSpawn", "MayrinaDead");
		
		IF
		FlagSet((FLAG)HAG_Hagspawn_Knows_SurrogateMotherDefeated_8f4738c9-7877-86e4-316a-2447a949e136, _Player, _)
		AND
		QuestUpdateIsUnlocked((CHARACTER)_Player, "HAG_HagSpawn", "KilledMayrina", 0)
		THEN
		QuestUpdate((CHARACTER)_Player, "HAG_HagSpawn", "MayrinaDead");
		
		IF
		StatusApplied(S_HAG_Hagspawn_SurrogateMother_08c970d7-3138-45e8-8965-68eadf4b07cd, "KNOCKED_OUT_PERMANENTLY", _Player, _)
		AND
		DB_PartyMembers((CHARACTER)_Player)
		THEN
		QuestUpdate((CHARACTER)_Player, "HAG_HagSpawn", "MayrinaKnockedOut");
		
		IF
		FlagSet(HAG_Hagspawn_Event_HasSummoningWand_ff5a4aae-85e1-4982-9f52-2947fd75e6e3, _Character, _)
		AND
		QuestUpdateIsUnlocked((CHARACTER)_Character, "HAG_HagSpawn", "SavedMayrina", 1)
		AND
		QuestIsClosed("HAG_HagSpawn", 0)
		THEN
		QuestUpdate(_Character, "HAG_HagSpawn", "FoundWand");
		
		IF
		QuestUpdateUnlocked(_Character, "HAG_HagSpawn", "SavedMayrina")
		AND
		GetFlag(HAG_Hagspawn_Event_HasSummoningWand_ff5a4aae-85e1-4982-9f52-2947fd75e6e3, _Character, 1)
		AND
		QuestIsClosed("HAG_HagSpawn", 0)
		THEN
		QuestUpdate(_Character, "HAG_HagSpawn", "FoundWand");
		
		//END_REGION
		
		
		//REGION End States
		
		IF
		FlagSet((FLAG)_EndStateFlag, _, _) // flagType: Global
		AND
		DB_HAG_HagAmbush_Confrontation_PlayerSidedNone_ClearFlags((FLAG)_EndStateFlag)
		THEN
		ClearFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_PlayerSidedNone_85a61d34-b0a6-c310-7042-8ebc3d478223, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		
		IF
		DialogEnded(DIALOGRESOURCEGUID_HAG_HagAmbush_Confrontation_c5156f64-68bd-9385-aa19-107d32955130,_Id)
		AND
		DB_GlobalFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_PlayerSidedNone_85a61d34-b0a6-c310-7042-8ebc3d478223) // flagType: Global
		THEN
		PROC_HAG_HagAmbush_HagDisappear(NULL_00000000-0000-0000-0000-000000000000,"LeaveViaPoof");
		SetFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_KillBrothers_c69703b1-eb8f-a8c8-8f77-3ef90d267726, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global 
		
		
		IF
		DialogEnded(DIALOGRESOURCEGUID_HAG_HagAmbush_Confrontation_c5156f64-68bd-9385-aa19-107d32955130,_Id)
		AND
		DB_GlobalFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_PlayerSidedHag_e2d74cb8-45e7-e7b6-638e-5d3d27060a78) // flagType: Global
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT1_HAG_Brothers_21a1003e-c806-e4ae-7f0e-b1e6422d39dc,0);
		
		
		IF
		DialogEnded(DIALOGRESOURCEGUID_HAG_HagAmbush_Confrontation_c5156f64-68bd-9385-aa19-107d32955130,_Id)
		AND
		DB_GlobalFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_PlayerSidedBrothers_130b6712-6f14-8e62-df19-1b4f33ed07b0) // flagType: Global
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT1_HAG_Brothers_21a1003e-c806-e4ae-7f0e-b1e6422d39dc,100);
		PROC_HAG_HagAmbush_HagDisappear(NULL_00000000-0000-0000-0000-000000000000,"LeaveViaPoof");
		PROC_SetRelationToPlayers((FACTION)ACT1_HAG_Ettercaps_2bb298f0-d9e4-4858-46ed-e6b018866d11,0);
		PROC_HAG_HagAmbush_BrothersState_WaitingForOrders();
		
		
		IF
		FlagSet(HAG_HagAmbush_Quest_Confrontation_EventSkipped_a673a247-3884-42ce-b6f5-298340e5a092, _, _) // flagType: Global
		AND
		NOT DB_GlobalFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_Activated_85f67c35-6bbf-8983-f670-6a0260edbe3e) // flagType: Global
		THEN
		SetFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_KillBrothers_c69703b1-eb8f-a8c8-8f77-3ef90d267726, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		PROC_HAG_HagAmbush_HagDisappear(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055,"LeaveViaPoof");
		
		IF
		DialogEnded(DIALOGRESOURCEGUID_HAG_HagAmbush_Confrontation_c5156f64-68bd-9385-aa19-107d32955130,_)
		THEN
		PROC_RemoveDialog(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055);
		
		//END_REGION
		
		//REGION Brothers dying in dialogue
		
		PROC
		PROC_StateSet_Defeated(_Brother)
		AND
		DB_HAG_HagAmbush_Brothers((CHARACTER)_Brother)
		AND
		DB_Players(_Player)
		AND
		DB_Is_InCombat(_Player, _ID)
		AND
		DB_Is_InCombat(_Brother, _ID)
		AND
		IsEnemy(_Player, _Brother, 1)
		AND
		NOT DB_GlobalFlag(HAG_HagAmbush_Quest_Confrontation_PlayerSidedBrothers_130b6712-6f14-8e62-df19-1b4f33ed07b0)
		AND
		NOT DB_GlobalFlag(HAG_HagAmbush_Quest_Confrontation_PlayerSidedNone_85a61d34-b0a6-c310-7042-8ebc3d478223)
		AND
		NOT DB_GlobalFlag(HAG_HagAmbush_Quest_Confrontation_PlayerSidedHag_e2d74cb8-45e7-e7b6-638e-5d3d27060a78)
		AND
		NOT DB_GlobalFlag(HAG_HagAmbush_Quest_Confrontation_EventSkipped_a673a247-3884-42ce-b6f5-298340e5a092)
		THEN
		SetFlag(HAG_HagAmbush_Quest_Confrontation_PlayerSidedHag_e2d74cb8-45e7-e7b6-638e-5d3d27060a78, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		DB_Defeated(_Brother)
		AND
		DB_HAG_HagAmbush_Brothers((CHARACTER)_Brother)
		AND
		DB_HAG_HagAmbush_Brothers(_OtherBrother)
		AND
		_Brother != _OtherBrother
		AND
		NOT DB_Defeated(_OtherBrother)
		AND
		NOT DB_Is_InCombat(_Brother, _)
		AND
		NOT DB_GlobalFlag(HAG_HagAmbush_Quest_Confrontation_PlayerSidedBrothers_130b6712-6f14-8e62-df19-1b4f33ed07b0)
		AND
		NOT DB_GlobalFlag(HAG_HagAmbush_Quest_Confrontation_PlayerSidedNone_85a61d34-b0a6-c310-7042-8ebc3d478223)
		AND
		NOT DB_GlobalFlag(HAG_HagAmbush_Quest_Confrontation_PlayerSidedHag_e2d74cb8-45e7-e7b6-638e-5d3d27060a78)
		AND
		NOT DB_GlobalFlag(HAG_HagAmbush_Quest_Confrontation_EventSkipped_a673a247-3884-42ce-b6f5-298340e5a092)
		AND
		NOT DB_GlobalFlag(HAG_HagAmbush_Quest_Confrontation_Activated_85f67c35-6bbf-8983-f670-6a0260edbe3e)
		THEN
		SetFlag(HAG_HagAmbush_Quest_Confrontation_KillBrothers_c69703b1-eb8f-a8c8-8f77-3ef90d267726, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		DB_Defeated(_Brother)
		AND
		DB_HAG_HagAmbush_Brothers((CHARACTER)_Brother)
		AND
		DB_HAG_HagAmbush_Brothers(_OtherBrother)
		AND
		_Brother != _OtherBrother
		AND
		NOT DB_Defeated(_OtherBrother)
		AND
		NOT DB_Is_InCombat(_Brother, _)
		AND
		NOT DB_GlobalFlag(HAG_HagAmbush_Quest_Confrontation_PlayerSidedBrothers_130b6712-6f14-8e62-df19-1b4f33ed07b0)
		AND
		NOT DB_GlobalFlag(HAG_HagAmbush_Quest_Confrontation_PlayerSidedNone_85a61d34-b0a6-c310-7042-8ebc3d478223)
		AND
		NOT DB_GlobalFlag(HAG_HagAmbush_Quest_Confrontation_PlayerSidedHag_e2d74cb8-45e7-e7b6-638e-5d3d27060a78)
		AND
		NOT DB_GlobalFlag(HAG_HagAmbush_Quest_Confrontation_EventSkipped_a673a247-3884-42ce-b6f5-298340e5a092)
		AND
		NOT DB_GlobalFlag(HAG_HagAmbush_Quest_Confrontation_Activated_85f67c35-6bbf-8983-f670-6a0260edbe3e)
		THEN
		PROC_HAG_HagAmbush_HagDisappear(NULL_00000000-0000-0000-0000-000000000000, "DoAD");
		
		IF
		DB_GlobalFlag(HAG_HagAmbush_Quest_Confrontation_KillBrothers_c69703b1-eb8f-a8c8-8f77-3ef90d267726)
		AND
		DB_HAG_HagAmbush_Brothers(_Brother)
		AND
		DB_DialogNPCs(_ID, _Brother, _)
		AND
		DB_AutomatedDialog(_ID)
		THEN
		PROC_ForceStopDialog(_Brother);
		
		IF
		DB_GlobalFlag(HAG_HagAmbush_Quest_Confrontation_KillBrothers_c69703b1-eb8f-a8c8-8f77-3ef90d267726)
		AND
		DB_HAG_HagAmbush_Brothers(_Brother)
		AND
		NOT DB_DialogNPCs(_,_Brother,_)
		AND
		NOT DB_PermaDefeated(_Brother)
		THEN
		PlayEffect(_Brother, VFX_Script_HAG_HagAmbush_Confrontation_BrothersDeath_01_4bc5550a-8878-b525-99cf-f4485acc32db, "", 1.0);
		Die(_Brother, DEATHTYPE.DoT, S_HAG_Hag_c457d064-83fb-4ec6-b74d-1f30dfafd12d, 0, 0);
		
		IF
		FlagSet(HAG_HagAmbush_Confrontation_Event_KillingBrother_21ece550-a0fa-406b-8128-d9a678d60c1a, _Brother, _Id)
		AND
		DialogRemoveActorFromDialog(_Id,_Brother,_)
		THEN
		DB_NOOP(1);
		
		//END_REGION
		
		//REGION Brothers Live
		
		PROC
		PROC_HAG_HagAmbush_BrothersState_WaitingForOrders()
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e);
		PROC_RemoveAllDialogEntriesForSpeaker(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b);
		SetHasDialog(S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e, 1);
		SetHasDialog(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b, 1);
		
		
		//REGION Brothers die
		
		IF
		FlagSet(HAG_Hag_Brother_001_State_IsDead_a1e1e9cc-4a79-fe57-2df9-0e0e7399350c, _, _) // flagType: Global
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b);
		SetHasDialog(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b, 1);
		PROC_HAG_Brother_CleanUp(S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e);
		
		IF
		FlagSet(HAG_Hag_Brother_002_State_IsDead_0aece58b-c166-1182-7d76-f6dbb44bac0a, _, _) // flagType: Global
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e);
		SetHasDialog(S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e, 1);
		PROC_HAG_Brother_CleanUp(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b);
		
		PROC
		PROC_HAG_Brother_CleanUp((CHARACTER)_Brother)
		AND
		DB_HAG_GreaterHagAreaTriggers(_Trigger)
		THEN
		TriggerUnregisterForCharacter(_Trigger, _Brother);
		
		PROC
		PROC_HAG_Brother_CleanUp((CHARACTER)_Brother)
		AND
		DB_HAG_InnerHagAreaTriggers(_Trigger)
		THEN
		TriggerUnregisterForCharacter(_Trigger, _Brother);
		
		PROC
		PROC_HAG_Brother_CleanUp((CHARACTER)_Brother)
		THEN
		TriggerUnregisterForCharacter(S_HAG_HagHouse_fae45ba1-2da5-4ab7-b24b-8bf7539a3c64, _Brother);
		TriggerUnregisterForCharacter(TRIGGERGUID_S_HAG_HagAmbush_BrothersUnjoinTrigger_9eca89e1-8508-4a5d-a890-ca72c6fcbc4b, _Brother);
		
		//END_REGION
		
		
		//Brothers make hostility permanent against players (no temp hostilities)
		IF
		CombatStarted(_Id)
		AND
		DB_HAG_HagAmbush_Brothers(_Brother)
		AND
		DB_Is_InCombat(_Brother,_Id)
		AND
		DB_Players(_Player)
		AND
		DB_Is_InCombat(_Player,_Id)
		AND
		IsEnemy(_Brother,_Player,1)
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT1_HAG_Brothers_21a1003e-c806-e4ae-7f0e-b1e6422d39dc,0);
		
		
		//END_REGION
		
		//REGION Dialog logic
		
		IF
		DB_GlobalFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_PlayerSidedBrothers_130b6712-6f14-8e62-df19-1b4f33ed07b0) // flagType: Global
		THEN
		DB_SpotPlayers((CHARACTER)S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e, "HAG_HagAmbush_Brothers_RecruitDialog", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		DB_SpotPlayers((CHARACTER)S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b, "HAG_HagAmbush_Brothers_RecruitDialog", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		
		PROC
		PROC_SpotPlayers_Spotted(_Brother, "HAG_HagAmbush_Brothers_RecruitDialog", _Player)
		AND
		QRY_SelectAndStartDialog((GUIDSTRING)_Brother, (GUIDSTRING)_Player)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_DialogFlagSetup(HAG_HagAmbush_Brothers_Recruitment_b2c0af20-18e7-956e-67f4-ce674d7c89f6, _, _, _)
		THEN
		PROC_SpotPlayers_StopSpotting((CHARACTER)S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e, "HAG_HagAmbush_Brothers_RecruitDialog");
		PROC_SpotPlayers_StopSpotting((CHARACTER)S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b, "HAG_HagAmbush_Brothers_RecruitDialog");
		
		QRY
		QRY_SelectCustomDialog((GUIDSTRING)_Brother, (GUIDSTRING)_Player)
		AND
		DB_HAG_HagAmbush_Brothers((CHARACTER)_Brother)
		AND
		DB_GlobalFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_PlayerSidedBrothers_130b6712-6f14-8e62-df19-1b4f33ed07b0) // flagType: Global
		THEN
		PROC_HAG_HagAmbush_SelectDialogForBrother(_Brother, _Player);
		
		PROC
		PROC_HAG_HagAmbush_SelectDialogForBrother(_Brother, (GUIDSTRING)_Player)
		AND
		DB_DialogName((DIALOGRESOURCE)HAG_HagAmbush_Brothers_Recruitment_b2c0af20-18e7-956e-67f4-ce674d7c89f6, _)
		AND
		DB_HAG_HagAmbush_Brothers_FallbackAD(_Brother, _Dialog)
		THEN
		PROC_TryStartAD(_Dialog, _Brother);
		
		//Brother 1
		
		PROC
		PROC_HAG_HagAmbush_SelectDialogForBrother(S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e, (GUIDSTRING)_Player)
		AND
		NOT DB_DialogName((DIALOGRESOURCE)HAG_HagAmbush_Brothers_Recruitment_b2c0af20-18e7-956e-67f4-ce674d7c89f6, _)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b, S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e)
		AND
		NOT QRY_StartDialog((DIALOGRESOURCE)HAG_HagAmbush_Brothers_Recruitment_b2c0af20-18e7-956e-67f4-ce674d7c89f6, S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e,S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b, _Player)
		THEN
		PROC_TryStartAD(DIALOGRESOURCEGUID_HAG_HagAmbush_Brother_001_AD_Fallback_829850f5-0733-d0c0-d823-c722c7662521, S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e);
		
		PROC
		PROC_HAG_HagAmbush_SelectDialogForBrother(S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e, (GUIDSTRING)_Player)
		AND
		NOT DB_DialogName((DIALOGRESOURCE)HAG_HagAmbush_Brothers_Recruitment_b2c0af20-18e7-956e-67f4-ce674d7c89f6, _)
		AND
		NOT QRY_SpeakerIsAvailableAndInDialogRange(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b, S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e)
		THEN
		PROC_TryStartAD(DIALOGRESOURCEGUID_HAG_HagAmbush_Brother_001_AD_Fallback_829850f5-0733-d0c0-d823-c722c7662521, S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e);
		
		// Brother 2
		
		PROC
		PROC_HAG_HagAmbush_SelectDialogForBrother(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b, (GUIDSTRING)_Player)
		AND
		NOT DB_DialogName((DIALOGRESOURCE)HAG_HagAmbush_Brothers_Recruitment_b2c0af20-18e7-956e-67f4-ce674d7c89f6, _)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e, S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b)
		AND
		NOT QRY_StartDialog(HAG_HagAmbush_Brothers_Recruitment_b2c0af20-18e7-956e-67f4-ce674d7c89f6, S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e,S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b, _Player)
		THEN
		PROC_TryStartAD(DIALOGRESOURCEGUID_HAG_HagAmbush_Brother_002_AD_Fallback_c848b0c6-a07c-c1cc-c542-e55d10ca4f44, S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b);
		
		PROC
		PROC_HAG_HagAmbush_SelectDialogForBrother(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b, (GUIDSTRING)_Player)
		AND
		NOT DB_DialogName((DIALOGRESOURCE)HAG_HagAmbush_Brothers_Recruitment_b2c0af20-18e7-956e-67f4-ce674d7c89f6, _)
		AND
		NOT QRY_SpeakerIsAvailableAndInDialogRange(S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e, S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b)
		THEN
		PROC_TryStartAD(DIALOGRESOURCEGUID_HAG_HagAmbush_Brother_002_AD_Fallback_c848b0c6-a07c-c1cc-c542-e55d10ca4f44, S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b);
		
		//END_REGION
		
		//REGION Hag Illusion Removed
		PROC
		PROC_SceneInterrupted(_, _Char, "HAG_HagAmbush_Confrontation", _Reason)
		AND
		DB_GLO_GenericSceneManager_ViolenceReason(_Reason)
		THEN
		PROC_HAG_HagAmbush_HagDisappear(_Char,"DoAD");
		
		
		PROC
		PROC_SceneInterrupted(_, _Char, "HAG_HagAmbush_Confrontation2", _Reason)
		AND
		DB_GLO_GenericSceneManager_ViolenceReason(_Reason)
		THEN
		PROC_HAG_HagAmbush_HagDisappear(_Char,"LeaveViaPoof");
		
		PROC
		PROC_HAG_HagAmbush_HagDisappear(_,_)
		THEN
		PROC_SceneOver("HAG_HagAmbush_Confrontation");
		
		//Clear dialogs once event is finished
		PROC
		PROC_HAG_HagAmbush_HagDisappear(_,_)
		THEN
		RemoveHarmfulStatuses(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055);
		SetDetached(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055, 1);
		PROC_SetInvulnerable(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055, 1);
		PROC_RemoveDialog(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055);
		PROC_RemoveDialog(S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e);
		PROC_RemoveDialog(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b);
		
		PROC
		PROC_HAG_HagAmbush_HagDisappear((CHARACTER)_Char,"DoAD")
		THEN
		PROC_ForceStopDialog(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055);
		
		PROC
		PROC_HAG_HagAmbush_HagDisappear((CHARACTER)_Char,"DoAD")
		AND
		DB_HAG_HagAmbush_Brothers(_Brother)
		AND
		DB_DialogNPCs(_ID, _Brother, _)
		AND
		DB_AutomatedDialog(_ID)
		THEN
		PROC_ForceStopDialog(_Brother);
		
		PROC
		PROC_HAG_HagAmbush_HagDisappear(_, _)
		THEN
		PROC_SceneOver("HAG_HagAmbush_Confrontation2");
		
		PROC
		PROC_HAG_HagAmbush_HagDisappear((CHARACTER)_Char,"DoAD")
		AND
		NOT QRY_StartDialog(DIALOGRESOURCEGUID_HAG_HagAmbush_AD_HagDisappear_62660820-8a16-d3cd-cee2-1625a5fda55a,S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055)
		THEN
		TimerLaunch("HAG_HagAmbush_HagDisappear_SpawnEttercaps",1200);
		PROC_HAG_HagAmbush_HagDisappear(NULL_00000000-0000-0000-0000-000000000000,"LeaveViaPoof");
		
		IF
		AutomatedDialogEnded(DIALOGRESOURCEGUID_HAG_HagAmbush_AD_HagDisappear_62660820-8a16-d3cd-cee2-1625a5fda55a, _)
		THEN
		TimerLaunch("HAG_HagAmbush_HagDisappear_SpawnEttercaps",1200);
		PROC_HAG_HagAmbush_HagDisappear(NULL_00000000-0000-0000-0000-000000000000,"LeaveViaPoof");
		
		IF
		TimerFinished("HAG_HagAmbush_HagDisappear_SpawnEttercaps")
		AND
		NOT DB_GlobalFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_PlayerSidedHag_e2d74cb8-45e7-e7b6-638e-5d3d27060a78)
		THEN
		SetFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_KillBrothers_c69703b1-eb8f-a8c8-8f77-3ef90d267726, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global 
		
		IF
		AutomatedDialogEnded(DIALOGRESOURCEGUID_HAG_HagAmbush_AD_HagDisappear_62660820-8a16-d3cd-cee2-1625a5fda55a,_)
		THEN
		PROC_HAG_HagAmbush_HagDisappear(NULL_00000000-0000-0000-0000-000000000000,"LeaveViaPoof");
		
		PROC
		PROC_HAG_HagAmbush_HagDisappear((CHARACTER)_Char,"LeaveViaPoof")
		AND
		QRY_OnlyOnce("HAG_HagAmbush_HagDisappear")
		THEN
		SetEntityEvent(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055,"HAG_RemoveDouble");
		
		IF
		EntityEvent(_Char,"HAG_HagAmbush_PoofEvent")
		THEN
		PROC_Poof(_Char);
		
		//END_REGION
		
		//REGION Hag Thanks the Player
		
		IF
		DB_Defeated(S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e)
		AND
		DB_Defeated(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b)
		AND
		NOT DB_OnlyOnce("HAG_HagAmbush_HagDisappear")
		AND
		DB_GlobalFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_PlayerSidedHag_e2d74cb8-45e7-e7b6-638e-5d3d27060a78) // flagType: Global
		THEN
		DB_SpotPlayers(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055, "HAG_HagAmbush_HagThankPlayer", NULL_00000000-0000-0000-0000-000000000000, HAG_HagAmbush_Event_Confrontation_Cancelled_08699840-957d-48da-8f59-c3c4ae4225a4);
		DB_SpotPlayers_CustomRadius(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055, "HAG_HagAmbush_HagThankPlayer", 10.0);
		DB_SpotPlayers_TargetIgnoreCantTalk(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055, "HAG_HagAmbush_HagThankPlayer");
		DB_SpotPlayers_IncludeWildshapedPlayers(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055, "HAG_HagAmbush_HagThankPlayer");
		DB_SpotPlayers_IncludeFollowers(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055, "HAG_HagAmbush_HagThankPlayer");
		DB_SpotPlayers_IncludeSummons(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055, "HAG_HagAmbush_HagThankPlayer");
		
		PROC
		PROC_SpotPlayers_Spotted(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055, "HAG_HagAmbush_HagThankPlayer", _Player)
		AND
		NOT DB_OnlyOnce("HAG_HagAmbush_HagDisappear")
		AND
		DB_GlobalFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_PlayerSidedHag_e2d74cb8-45e7-e7b6-638e-5d3d27060a78) // flagType: Global
		AND
		QRY_StartDialogCustomWithAvailableSpeakerInRange((DIALOGRESOURCE)HAG_HagAmbush_ThankPlayer_2801dab9-3fbf-906a-e62b-add4654a5368,S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055,_Player,10.0,0,1,1,0)
		THEN
		DB_HAG_HagAmbush_HagThanksDialogStartedOnce(1);
		
		PROC
		PROC_SpotPlayers_Spotted(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055, "HAG_HagAmbush_HagThankPlayer", _Player)
		AND
		NOT DB_OnlyOnce("HAG_HagAmbush_HagDisappear")
		AND
		DB_GlobalFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_PlayerSidedHag_e2d74cb8-45e7-e7b6-638e-5d3d27060a78) // flagType: Global
		AND
		NOT DB_HAG_HagAmbush_HagThanksDialogStartedOnce(1)
		AND
		QRY_OnlyOnce("HAG_HagAmbush_AD_HagThankPlayer")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)HAG_HagAmbush_AD_HagThankPlayer_28f6ec9f-9e2f-2aa8-a74c-ee2aa7c55134, (CHARACTER)S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055);
		NOT DB_SpotPlayers_TargetIgnoreCantTalk(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055, "HAG_HagAmbush_HagThankPlayer");
		NOT DB_SpotPlayers_IncludeFollowers(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055, "HAG_HagAmbush_HagThankPlayer");
		NOT DB_SpotPlayers_IncludeWildshapedPlayers(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055, "HAG_HagAmbush_HagThankPlayer");
		NOT DB_SpotPlayers_IncludeSummons(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055, "HAG_HagAmbush_HagThankPlayer");
		PROC_SpotPlayers_RestartSpotting(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055, "HAG_HagAmbush_HagThankPlayer");
		
		IF
		DialogRequestFailed(DIALOGRESOURCEGUID_HAG_HagAmbush_ThankPlayer_2801dab9-3fbf-906a-e62b-add4654a5368,_)
		AND
		NOT DB_HAG_HagAmbush_HagThanksDialogStartedOnce(1)
		THEN
		PROC_SpotPlayers_RestartSpotting(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055, "HAG_HagAmbush_HagThankPlayer");
		
		IF
		DialogEnded(DIALOGRESOURCEGUID_HAG_HagAmbush_ThankPlayer_2801dab9-3fbf-906a-e62b-add4654a5368,_)
		AND
		NOT DB_DialogRequestFailed(DIALOGRESOURCEGUID_HAG_HagAmbush_ThankPlayer_2801dab9-3fbf-906a-e62b-add4654a5368,_)
		THEN
		PROC_HAG_HagAmbush_HagDisappear(NULL_00000000-0000-0000-0000-000000000000,"LeaveViaPoof");
		
		
		IF
		DialogEnded(DIALOGRESOURCEGUID_HAG_HagAmbush_ThankPlayer_2801dab9-3fbf-906a-e62b-add4654a5368,_Id)
		AND
		DB_DialogPlayers(_Id,_Player,1)
		THEN
		StartVoiceBark(HAG_HagAmbush_VB_SidedHag_40b8e336-9ee5-3ceb-7a1e-6d8facd6e4a4, (CHARACTER)_Player);
		
		IF
		DB_Defeated(S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e)
		AND
		DB_Defeated(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b)
		AND
		NOT DB_OnlyOnce("HAG_HagAmbush_HagDisappear")
		AND
		NOT DB_GlobalFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_PlayerSidedHag_e2d74cb8-45e7-e7b6-638e-5d3d27060a78) // flagType: Global
		AND
		NOT DB_InteractiveDialogSpeaker(_, S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055)
		THEN
		PROC_HAG_HagAmbush_HagDisappear(NULL_00000000-0000-0000-0000-000000000000,"LeaveViaPoof");
		
		//END_REGION
		
		//REGION Stop trying to trigger this event if the main hag dies.
		IF
		FlagSet(HAG_Hag_State_HagDefeated_7a1acad0-589f-ae02-f712-f0d24080d720, _, _) // flagType: Global
		THEN
		SetFlag((FLAG)HAG_HagAmbush_Event_Confrontation_Cancelled_08699840-957d-48da-8f59-c3c4ae4225a4, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		//END_REGION
		
		
		//REGION Brothers run off on their own on approach to the Hag house
		IF
		DialogEnded(HAG_HagAmbush_Brothers_Recruitment_b2c0af20-18e7-956e-67f4-ce674d7c89f6, _)
		AND
		DB_HAG_HagAmbush_Brothers(_Brother)
		THEN
		SetHasDialog(_Brother, 0);
		DB_HagAmbush_Brothers_ReadyToLeave(1);
		
		
		IF
		DB_HagAmbush_Brothers_ReadyToLeave(1)
		AND
		NOT DB_CantMove((CHARACTER)S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e)
		AND
		NOT DB_HAG_HagAmbush_BrotherDisappearedAfterRefuse((CHARACTER)S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e)
		THEN
		PROC_DisappearOutOfSightTo(S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e, S_HAG_HagAmbush_LeaveTrigger_07aecf6f-e842-466f-92ab-90f179384e7c, "Run", 0, "HAG_HagAmbush_BrotherDisappearedAfterRefuse");
		
		IF
		DB_HagAmbush_Brothers_ReadyToLeave(1)
		AND
		NOT DB_CantMove((CHARACTER)S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e)
		AND
		NOT DB_CantMove((CHARACTER)S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b)
		AND
		NOT DB_HAG_HagAmbush_BrotherDisappearedAfterRefuse((CHARACTER)S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e)
		AND
		NOT DB_HAG_HagAmbush_BrotherDisappearedAfterRefuse((CHARACTER)S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b)
		THEN
		Follow(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b, S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e);
		
		IF
		DB_HagAmbush_Brothers_ReadyToLeave(1)
		AND
		DB_CantMove((CHARACTER)S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e)
		AND
		NOT DB_CantMove((CHARACTER)S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b)
		AND
		NOT DB_HAG_HagAmbush_BrotherDisappearedAfterRefuse((CHARACTER)S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b)
		THEN
		PROC_DisappearOutOfSightTo(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b, S_HAG_HagAmbush_LeaveTrigger_07aecf6f-e842-466f-92ab-90f179384e7c, "Run", 0, "HAG_HagAmbush_BrotherDisappearedAfterRefuse");
		
		IF
		DB_HagAmbush_Brothers_ReadyToLeave(1)
		AND
		NOT DB_CantMove((CHARACTER)S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e)
		AND
		NOT DB_CantMove((CHARACTER)S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b)
		AND
		DB_HAG_HagAmbush_BrotherDisappearedAfterRefuse((CHARACTER)S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e)
		AND
		NOT DB_HAG_HagAmbush_BrotherDisappearedAfterRefuse((CHARACTER)S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b)
		THEN
		PROC_DisappearOutOfSightTo(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b, S_HAG_HagAmbush_LeaveTrigger_07aecf6f-e842-466f-92ab-90f179384e7c, "Run", 0, "HAG_HagAmbush_BrotherDisappearedAfterRefuse");
		
		IF
		EntityEvent(S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e, "HAG_HagAmbush_BrotherDisappearedAfterRefuse")
		AND
		NOT DB_CantMove((CHARACTER)S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b)
		AND
		NOT DB_HAG_HagAmbush_BrotherDisappearedAfterRefuse((CHARACTER)S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b)
		AND
		GetDistanceTo(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b, S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e, _Dist)
		AND
		_Dist <= 5.0
		THEN
		StopFollow(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b);
		SetOnStage(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b, 0);
		SetEntityEvent(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b, "HAG_HagAmbush_BrotherDisappearedAfterRefuse");
		
		IF
		EntityEvent(S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e, "HAG_HagAmbush_BrotherDisappearedAfterRefuse")
		AND
		NOT DB_CantMove((CHARACTER)S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b)
		AND
		NOT DB_HAG_HagAmbush_BrotherDisappearedAfterRefuse((CHARACTER)S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b)
		AND
		GetDistanceTo(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b, S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e, _Dist)
		AND
		_Dist > 5.0
		THEN
		StopFollow(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b);
		PROC_DisappearOutOfSightTo(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b, S_HAG_HagHouse_fae45ba1-2da5-4ab7-b24b-8bf7539a3c64, "Run", 0, "HAG_HagAmbush_BrotherDisappearedAfterRefuse");
		
		IF
		EntityEvent(_Brother, "HAG_HagAmbush_BrotherDisappearedAfterRefuse")
		THEN
		DB_HAG_HagAmbush_BrotherDisappearedAfterRefuse((CHARACTER)_Brother);
		
		IF
		DB_HAG_HagAmbush_BrotherDisappearedAfterRefuse(S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e)
		AND
		DB_HAG_HagAmbush_BrotherDisappearedAfterRefuse(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b)
		THEN
		PROC_Hag_BrothersDieAfterLongRest();
		
		
		//END_REGION
		
		
		//REGION Brothers die after long rest
		
		QRY
		QRY_HAG_HagAmbush_NotBothBrothersGone()
		AND
		NOT DB_PermaDefeated(S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e)
		AND
		IsOnStage(S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e, 1)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_HAG_HagAmbush_NotBothBrothersGone()
		AND
		NOT DB_PermaDefeated(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b)
		AND
		IsOnStage(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b, 1)
		THEN
		DB_NOOP(1);
		
		
		//If the players sided with the hag, and the brothers are alive (i.e. the players fled)
		PROC
		PROC_LongRest()
		AND
		DB_GlobalFlag(HAG_HagAmbush_Quest_Confrontation_PlayerSidedHag_e2d74cb8-45e7-e7b6-638e-5d3d27060a78) // flagType: Global
		AND
		NOT DB_GlobalFlag((FLAG)HAG_Hag_State_IsDead_781391e2-7d33-642d-28c0-e9b06cde32bb) // flagType: Global
		AND
		NOT DB_GlobalFlag(HAG_Hag_State_HagGivenMercy_a3c0a36a-ccce-4f35-7b54-9ab22d6ac534)
		THEN
		DB_ExecuteInLevel("HAG_HagAmbush_BrothersDieAfterLongRest","WLD_Main_A");
		
		// If the players sided with the brothers, but decided to take a long rest.
		PROC
		PROC_LongRest()
		AND
		DB_GlobalFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_PlayerSidedBrothers_130b6712-6f14-8e62-df19-1b4f33ed07b0) // flagType: Global
		AND
		NOT DB_GlobalFlag((FLAG)HAG_Hag_State_IsDead_781391e2-7d33-642d-28c0-e9b06cde32bb) // flagType: Global
		AND
		NOT DB_GlobalFlag(HAG_Hag_State_HagGivenMercy_a3c0a36a-ccce-4f35-7b54-9ab22d6ac534)
		AND
		QRY_HAG_HagAmbush_NotBothBrothersGone()
		THEN
		DB_ExecuteInLevel("HAG_HagAmbush_BrothersDieAfterLongRest","WLD_Main_A");
		
		PROC
		PROC_ExecuteInLevel("HAG_HagAmbush_BrothersDieAfterLongRest","WLD_Main_A")
		AND
		QRY_HAG_HagAmbush_NotBothBrothersGone()
		THEN
		PROC_Hag_BrothersDieAfterLongRest();
		
		QRY
		QRY_HAG_HagAmbush_RefusedHelpBrothers()
		AND
		DB_Players(_Player)
		AND
		QuestUpdateIsUnlocked(_Player, "HAG_HagSpawn", "RefusedHelpBrothers1", 1)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_HAG_HagAmbush_RefusedHelpBrothers()
		AND
		DB_Players(_Player)
		AND
		QuestUpdateIsUnlocked(_Player, "HAG_HagSpawn", "RefusedHelpBrothers2", 1)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_Hag_BrothersDieAfterLongRest()
		AND
		QRY_HAG_HagAmbush_RefusedHelpBrothers()
		AND
		DB_HAG_HagAmbush_Brothers(_Brother)
		THEN
		SetOnStage(_Brother, 1);
		
		//hag in her lair
		PROC
		PROC_Hag_BrothersDieAfterLongRest()
		AND
		DB_HAG_HagAmbush_Brothers(_Brother)
		AND
		NOT DB_PermaDefeated((CHARACTER)_Brother)
		AND
		IsOnStage(_Brother, 1)
		AND
		QRY_HAG_HagAmbush_GetBrothersDeathTrigger(_Brother)
		AND
		DB_QRYRTN_HagAmbush_GetBrothersDeathTrigger(_Trigger)
		AND
		NOT DB_HAG_HagAmbush_Brothers_DiedAfterLongRest(_Brother)
		THEN
		TeleportTo(_Brother,_Trigger, "HAG_HagAmbush_Brothers_TeleportToDeathSpot");
		PlayEffect(_Brother, VFX_Script_HAG_HagAmbush_Confrontation_BrothersDeath_01_4bc5550a-8878-b525-99cf-f4485acc32db, "", 1.0);
		Die(_Brother,DEATHTYPE.DoT,NULL_00000000-0000-0000-0000-000000000000,1,1);
		
		IF
		EntityEvent(_Brother, "HAG_HagAmbush_Brothers_TeleportToDeathSpot")
		THEN
		DB_HAG_HagAmbush_Brothers_DiedAfterLongRest((CHARACTER)_Brother);
		
		QRY
		QRY_HAG_HagAmbush_GetBrothersDeathTrigger((CHARACTER)_Brother)
		AND
		DB_QRYRTN_HagAmbush_GetBrothersDeathTrigger(_Trigger)
		THEN
		NOT DB_QRYRTN_HagAmbush_GetBrothersDeathTrigger(_Trigger);
		
		QRY
		QRY_HAG_HagAmbush_GetBrothersDeathTrigger((CHARACTER)_Brother)
		AND
		DB_HAG_HagAmbush_BrothersDeathTrigger(_Flag, _Brother, _Trigger)
		AND
		NOT DB_QRYRTN_HagAmbush_GetBrothersDeathTrigger(_)
		AND
		DB_GlobalFlag(_Flag)
		THEN
		DB_QRYRTN_HagAmbush_GetBrothersDeathTrigger(_Trigger);
		
		QRY
		QRY_HAG_HagAmbush_GetBrothersDeathTrigger((CHARACTER)_Brother)
		AND
		NOT DB_QRYRTN_HagAmbush_GetBrothersDeathTrigger(_)
		AND
		DB_HAG_HagAmbush_BrothersDeathTrigger(NULL_00000000-0000-0000-0000-000000000000, _Brother, _Trigger)
		THEN
		DB_QRYRTN_HagAmbush_GetBrothersDeathTrigger(_Trigger);
		
		IF
		DB_HAG_HagAmbush_Brothers_DiedAfterLongRest(S_HAG_HagAmbush_Brother_001_767e2e80-b340-4e0f-9a6c-fd7df92d6e9e)
		AND
		DB_HAG_HagAmbush_Brothers_DiedAfterLongRest(S_HAG_HagAmbush_Brother_002_24c7e849-2ad6-414e-bc38-6ea3f358a80b)
		THEN
		SetFlag(HAG_HagAmbush_State_BothBrothersDiedAfterLongRest_b018c5bf-2810-449e-914a-a92808d20813, NULL_00000000-0000-0000-0000-000000000000, 0);
		//END_REGION
		
		//REGION Detect dead brothers
		
		IF
		DB_Sees(_Player, _Brother)
		AND
		DB_PartyMembers(_Player)
		AND
		DB_HAG_HagAmbush_Brothers(_Brother)
		AND
		DB_Dead(_Brother)
		THEN
		SetFlag(HAG_HagAmbush_State_FoundDeadBrother_b716ecca-3bdd-4192-9b62-b6a93890aada, NULL_00000000-0000-0000-0000-000000000000, 0); //Dialogue refers explicitly to them being dead.
		
		IF
		DB_Is_InCombat(_Player, _Combat)
		AND
		DB_Is_InCombat(_Brother, _Combat)
		AND
		DB_PartyMembers((CHARACTER)_Player)
		AND
		DB_HAG_HagAmbush_Brothers((CHARACTER)_Brother)
		AND
		DB_Dead(_Brother)
		THEN
		SetFlag(HAG_HagAmbush_State_FoundDeadBrother_b716ecca-3bdd-4192-9b62-b6a93890aada, NULL_00000000-0000-0000-0000-000000000000, 0); //Dialogue refers explicitly to them being dead.
		
		IF
		KilledBy(_Brother, _Player, _, _)
		AND
		DB_PartyMembers((CHARACTER)_Player)
		AND
		DB_HAG_HagAmbush_Brothers((CHARACTER)_Brother)
		AND
		DB_Dead(_Brother)
		THEN
		SetFlag(HAG_HagAmbush_State_FoundDeadBrother_b716ecca-3bdd-4192-9b62-b6a93890aada, NULL_00000000-0000-0000-0000-000000000000, 0); //Dialogue refers explicitly to them being dead.
		
		
		
		IF
		DB_Sees(_Player, _Brother)
		AND
		DB_PartyMembers(_Player)
		AND
		DB_HAG_HagAmbush_Brothers((CHARACTER)_Brother)
		AND
		DB_KnockedOut(_Brother)
		AND
		NOT DB_GlobalFlag(HAG_HagAmbush_State_FoundUnconsciousBrother_dbb6c79d-f56b-47c8-86fb-cddcb6df3016)
		THEN
		SetFlag((FLAG)HAG_HagAmbush_State_FoundUnconsciousBrother_dbb6c79d-f56b-47c8-86fb-cddcb6df3016, NULL_00000000-0000-0000-0000-000000000000, 0); //Dialogue refers explicitly to them being dead.
		
		IF
		DB_Is_InCombat(_Player, _Combat)
		AND
		DB_Is_InCombat(_Brother, _Combat)
		AND
		DB_PartyMembers((CHARACTER)_Player)
		AND
		DB_HAG_HagAmbush_Brothers((CHARACTER)_Brother)
		AND
		DB_KnockedOut(_Brother)
		AND
		NOT DB_GlobalFlag(HAG_HagAmbush_State_FoundUnconsciousBrother_dbb6c79d-f56b-47c8-86fb-cddcb6df3016)
		THEN
		SetFlag((FLAG)HAG_HagAmbush_State_FoundUnconsciousBrother_dbb6c79d-f56b-47c8-86fb-cddcb6df3016, NULL_00000000-0000-0000-0000-000000000000, 0); //Dialogue refers explicitly to them being dead.
		
		IF
		StatusApplied(_Brother, "KNOCKED_OUT", _Player, _)
		AND
		DB_PartyMembers((CHARACTER)_Player)
		AND
		DB_HAG_HagAmbush_Brothers((CHARACTER)_Brother)
		AND
		DB_Dead(_Brother)
		AND
		NOT DB_GlobalFlag(HAG_HagAmbush_State_FoundUnconsciousBrother_dbb6c79d-f56b-47c8-86fb-cddcb6df3016)
		THEN
		SetFlag((FLAG)HAG_HagAmbush_State_FoundUnconsciousBrother_dbb6c79d-f56b-47c8-86fb-cddcb6df3016, NULL_00000000-0000-0000-0000-000000000000, 0); //Dialogue refers explicitly to them being dead.
		
		//END_REGION
		
		
		//REGION Debug
		
		IF
		TextEvent("HagAmbush_SidedNone")
		AND
		QRY_StartDialog(DIALOGRESOURCEGUID_HAG_HagAmbush_Confrontation_c5156f64-68bd-9385-aa19-107d32955130,S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055)
		THEN
		SetFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_PlayerSidedNone_85a61d34-b0a6-c310-7042-8ebc3d478223, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		SetFlag((FLAG)HAG_HagAmbush_Event_Confrontation_Cancelled_08699840-957d-48da-8f59-c3c4ae4225a4, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		PROC_ForceStopDialog(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055);
		
		
		IF
		TextEvent("HagAmbush_SidedHag")
		AND
		QRY_StartDialog(DIALOGRESOURCEGUID_HAG_HagAmbush_Confrontation_c5156f64-68bd-9385-aa19-107d32955130,S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055)
		THEN
		SetFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_PlayerSidedHag_e2d74cb8-45e7-e7b6-638e-5d3d27060a78, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		SetFlag((FLAG)HAG_HagAmbush_Event_Confrontation_Cancelled_08699840-957d-48da-8f59-c3c4ae4225a4, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		PROC_ForceStopDialog(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055);
		
		IF
		TextEvent("HagAmbush_SidedBrothers")
		AND
		QRY_StartDialog(DIALOGRESOURCEGUID_HAG_HagAmbush_Confrontation_c5156f64-68bd-9385-aa19-107d32955130,S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055)
		THEN
		SetFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_PlayerSidedBrothers_130b6712-6f14-8e62-df19-1b4f33ed07b0, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		SetFlag((FLAG)HAG_HagAmbush_Event_Confrontation_Cancelled_08699840-957d-48da-8f59-c3c4ae4225a4, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		PROC_ForceStopDialog(S_HAG_HagAmbush_Hag_fb9cc235-398e-418d-a4a2-5da058fe7055);
		
		
		IF
		TextEvent("HagAmbush_Skip")
		THEN
		SetFlag((FLAG)HAG_HagAmbush_Event_Confrontation_Cancelled_08699840-957d-48da-8f59-c3c4ae4225a4, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		SetFlag((FLAG)HAG_HagAmbush_Quest_Confrontation_EventSkipped_a673a247-3884-42ce-b6f5-298340e5a092, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		
		//END_REGION
		
		IF
		DB_CurrentLevel("CTY_Main_A")
		THEN
		GoalCompleted;
	}
	EXIT
	{
	}
}
Goal(203).Title("Act1_HAG_HagLair_Combat");
Goal(203)
{
	INIT
	{
		DB_Subregion(S_HAG_HagLair_f84e3319-4a1d-483c-a718-dee3bff70d07,"HAG_HagLair_SUB",0, 1);
