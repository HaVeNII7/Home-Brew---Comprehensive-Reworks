		// LOW_Guildhall_FoundNoteZhentCoup
		DB_QuestDef_BookReadState("LOW_Guildhall", "FoundNoteZhentCoup", (ITEM)S_LOW_MinscHideout_LetterFromOrin_671d972d-2461-4fc6-8860-a952b6bdec8c);
		// LOW_Guildhall_SawZhentLeaderBribe
