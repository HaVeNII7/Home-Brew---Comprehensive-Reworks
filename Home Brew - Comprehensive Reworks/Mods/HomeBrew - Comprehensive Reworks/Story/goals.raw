		PROC_SetOnStage((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, 0);
		
		PROC
		PROC_ApplySavegamePatch_GUS_307143_CheckRemoveLaezel()
		AND
