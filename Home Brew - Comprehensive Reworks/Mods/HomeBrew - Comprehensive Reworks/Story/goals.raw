		DB_Dialogs((CHARACTER)S_HAV_FlamingFist_005_0e691c0a-562b-43bb-8554-cde1194decd5, (DIALOGRESOURCE)HAV_SavingPrisoners_FlamingFist_005_a33b2a75-f847-12a4-d9c6-1659701b712d);
		DB_Dialogs((CHARACTER)S_HAV_FlamingFist_006_9629c27e-8e50-4258-8bda-6639af768ba6, (DIALOGRESOURCE)HAV_SavingPrisoners_FlamingFist_006_19f7ee37-b79f-cd25-e330-295a6cfe0086);
		
		DB_HAV_SavingPrisoners_FlamingFistLeads((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9);
		DB_HAV_SavingPrisoners_FlamingFistLeads((CHARACTER)S_HAV_Manip_0b8fdd17-7ce6-4038-9d9d-49f5ddbc20be);
		
		
		DB_HAV_SavingPrisoners_FlamingFist((CHARACTER)S_HAV_Manip_0b8fdd17-7ce6-4038-9d9d-49f5ddbc20be);
		DB_HAV_SavingPrisoners_FlamingFist((CHARACTER)S_HAV_FlamingFist_001_47058367-9c0c-4756-a467-07b87b28e0d6);
		DB_HAV_SavingPrisoners_FlamingFist((CHARACTER)S_HAV_FlamingFist_002_39ace2b4-699d-468c-a664-8a06492d997a);
