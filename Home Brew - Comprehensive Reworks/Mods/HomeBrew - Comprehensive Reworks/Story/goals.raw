		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)WYR_CouragePuzzle_Rules_9e329103-ccac-ac45-46e0-f523d1166828, S_WYR_CourageTest_Instructor_f6b033f9-db05-44b9-bdcc-7e50e4736b12, _Character)
		THEN
