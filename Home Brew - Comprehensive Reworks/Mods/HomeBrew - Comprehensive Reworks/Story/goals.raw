		PROC_RemoveNPCADs(S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb);
		DB_Dialogs((CHARACTER)S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb, (DIALOGRESOURCE)PLA_StuckHalfElf_Freed_f8ad3437-e419-38c5-8237-d81c1a83de77);
		
		IF
		RemovedFrom(_, S_PLA_TavernInvestigation_DukesRiches_003cce23-b6ac-4442-a968-cd3430cb150c)
		AND
		NOT DB_OnlyOnce("PLA_TryBurnDownTavern")
		THEN
		SetFlag(PLA_Tavern_State_LootedDukeRiches_9bda8056-49e2-4e85-9125-a551ce00c32b, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		ItemLeftTrigger(S_PLA_TavernInvestigation_DukesRiches_003cce23-b6ac-4442-a968-cd3430cb150c, S_PLA_TavernInvestigation_DukeRoom_dd5b0510-6067-490f-8bb8-392a1a430a59, _)
		AND
		NOT DB_OnlyOnce("PLA_TryBurnDownTavern")
		THEN
		SetFlag(PLA_Tavern_State_LootedDukeRiches_9bda8056-49e2-4e85-9125-a551ce00c32b, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		Saw(S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb, S_PLA_Tavern_DeadCiv1_1ed658d0-e88a-4b7b-ab9e-1e520ae7d0c7, _)
		THEN
		PROC_SetCorpseOwner(S_PLA_Tavern_DeadCiv1_1ed658d0-e88a-4b7b-ab9e-1e520ae7d0c7, S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb);
		SetFlag(PLA_TavernInvestigation_State_HalfElfFoundWife_6cd9377b-e300-4396-94d0-c537fd193a48, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		PROC
		PROC_StateSet_PermaDefeated(S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb)
		THEN
		PROC_RemovePartyFollower(S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb);
		
		IF
		CharacterLootedCharacter(_Player, S_PLA_Tavern_DeadCiv1_1ed658d0-e88a-4b7b-ab9e-1e520ae7d0c7)
		AND
		NOT DB_OnlyOnce("PLA_StuckHalfElf_PAD_FoundWife")
		AND
		DB_Players(_Player)
		AND
		GetFlag(PLA_DeadCiv1_Knows_Seen_114d5031-e195-4575-9197-8d3cda728a3f, _Player, 0)
		AND
		QuestUpdateIsUnlocked(_Player, "PLA_StuckHalfElf", "LearnedWife", 1)
		AND
		QRY_StartDialog_Fixed(PLA_StuckHalfElf_PAD_FoundWife_28f0cce2-136e-266f-6fcd-aa32a288283f, _Player)
		THEN
		DB_OnlyOnce("PLA_StuckHalfElf_PAD_FoundWife");
		
		IF
		CharacterLootedCharacter(_Player, S_PLA_Tavern_DeadCiv1_1ed658d0-e88a-4b7b-ab9e-1e520ae7d0c7)
		AND
		IsPartyMember(_Player, 1, 1)
		THEN
		SetFlag(PLA_DeadCiv1_Knows_Seen_114d5031-e195-4575-9197-8d3cda728a3f, _Player, 0);
		
		IF
		FlagSet(PLA_DeadCiv1_Knows_Seen_114d5031-e195-4575-9197-8d3cda728a3f, (CHARACTER)_Player, _)
		AND
		QuestUpdateIsUnlocked(_Player, "PLA_StuckHalfElf", "LearnedWife", 1)
		THEN
		QuestUpdate(_Player, "PLA_StuckHalfElf", "FoundWife");
		
		
		IF
		QuestUpdateUnlocked(_Player, "PLA_StuckHalfElf", "LearnedWife")
		AND
		GetFlag(PLA_DeadCiv1_Knows_Seen_114d5031-e195-4575-9197-8d3cda728a3f, _Player, 1)
		THEN
		QuestUpdate(_Player, "PLA_StuckHalfElf", "FoundWife");
		
		IF
		FlagSet(PLA_StuckHalfElf_State_HeadingToWife_3eb6d0dd-cb93-cc29-f6e5-bbb7a9b27aea, S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb, _)
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker((CHARACTER)S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb);
		DB_AD_Dialog((CHARACTER)S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb, PLA_StuckHalfElf_AD_ToWife_8ce5ce8e-1a1d-ee8e-9505-7129ae6eaa0a);
		TriggerRegisterForCharacter(S_PLA_StuckHalfElf_NearWifeCorpse_cd059bea-aaef-48a5-94c7-2ba01ed91bc9, S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb);
		
		IF
		EnteredTrigger(S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb, S_PLA_StuckHalfElf_NearWifeCorpse_cd059bea-aaef-48a5-94c7-2ba01ed91bc9)
		THEN
		TriggerUnregisterForCharacter(S_PLA_StuckHalfElf_NearWifeCorpse_cd059bea-aaef-48a5-94c7-2ba01ed91bc9, S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb);
		SetFlag(PLA_StuckHalfElf_State_ReachedWifeBox_985da4c2-f0fa-e104-bced-c6371c25d4a9, S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb, 0);
		
		IF
		FlagSet(PLA_TavernInvestigation_State_HalfElfFoundWife_6cd9377b-e300-4396-94d0-c537fd193a48, _, _)
		AND
		GetFlag(PLA_StuckHalfElf_State_HeadingToWife_3eb6d0dd-cb93-cc29-f6e5-bbb7a9b27aea, S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb, 1)
		THEN
		PROC_RemoveNPCADs((CHARACTER)S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb);
		DB_Dialogs((CHARACTER)S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb, (DIALOGRESOURCE)PLA_StuckHalfElf_Freed_f8ad3437-e419-38c5-8237-d81c1a83de77);
		
		IF
		StatusApplied(_Character, "BURNING", _, _)
		AND
		DB_InteractiveDialogSpeaker(_ID, _Character)
		AND
		DB_DialogName((DIALOGRESOURCE)PLA_StuckHalfElf_88c9f41a-cce8-fc12-8a36-1e9574be588d, _ID)
		THEN
		PROC_ForceStopDialog((CHARACTER)S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb);
		
		//REGION The Dowry
		PROC
		PROC_GLO_KnowledgeCheckSuccess(_, "PLA_StuckHalfElf_HayStack", _)
		THEN
		SetOnStage(S_PLA_StuckHalfElf_Dowry_Chest_d7368244-74f3-46f6-9198-d0dd81d72a78, 1);
		ItemDragTo(S_PLA_StuckHalfElf_Dowry_Chest_d7368244-74f3-46f6-9198-d0dd81d72a78, S_PLA_StuckHalfElf_Dowry_Trigger_7569fdd6-0eae-4e03-8b74-1cdf38292c69);
		SetCanInteract(S_PLA_StuckHalfElf_Dowry_HayStack_6852a1ef-7e0e-463c-832d-647561700528, 0);
		
		QRY
		QRY_GLO_SkillCheck_CheckAdvantage(_Player, S_PLA_StuckHalfElf_Dowry_HayStack_6852a1ef-7e0e-463c-832d-647561700528, _)
		AND
		QuestUpdateIsUnlocked(_Player, "PLA_StuckHalfElf", "KnowDowry", 1)
		THEN
		DB_QRYRTN_GLO_Skillcheck_CheckAdvantage(2);
		//END_REGION
		
		//REGION Quest updates
		
		IF
		EnteredTrigger(_Char, S_PLA_Tavern_StartCollapse_9243881a-3da1-449e-9834-bd8113290897)
		AND
		NOT DB_OnlyOnce("PLA_StuckHalfElf_Start")
		AND
		NOT DB_GlobalFlag(PLA_TavernInvestigation_State_BurntDown_ad34c392-4499-402c-ae51-8c3d40985f8b)
		AND
		HasActiveStatus(S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb, "PLA_PINNEDUNDERBEAM", 1)
		AND
		IsPartyMember(_Char, 1, 1)
		THEN
		DB_OnlyOnce("PLA_StuckHalfElf_Start");
		QuestUpdate(_Char, "PLA_StuckHalfElf", "Start");
		
		IF
		DB_PermaDefeated((CHARACTER)S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb)
		AND
		NOT DB_Dead((CHARACTER)S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb)
		AND
		DB_Sees(_Character, (CHARACTER)S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb)
		AND
		DB_PartyMembers(_Character)
		AND
		QRY_OnlyOnce("PLA_StuckHalfElf_Dead")
		THEN
		QuestUpdate(_Character, "PLA_StuckHalfElf", "Defeated");
		
		IF
		DB_Dead((CHARACTER)S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb)
		AND
		DB_Sees(_Character, (CHARACTER)S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb)
		AND
		DB_PartyMembers(_Character)
		AND
		QRY_OnlyOnce("PLA_StuckHalfElf_Dead")
		THEN
		QuestUpdate(_Character, "PLA_StuckHalfElf", "Dead");
		
		IF
		DB_InRegion(S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb, S_PLA_StuckHalfElf_FreedTrigger_37541d1f-d461-4411-8704-af2e767908f5)
		AND
		DB_Sees(_Character, (CHARACTER)S_PLA_StuckHalfElf_5fcc3167-5a0c-41e7-b44c-d629d34370cb)
		AND
		DB_PartyMembers(_Character)
		AND
		QRY_OnlyOnce("PLA_StuckHalfElf_Safe")
		THEN
		QuestUpdate(_Character, "PLA_StuckHalfElf", "Safe");
		
		IF
		QuestUpdateUnlocked(_Character, "PLA_StuckHalfElf", "KnowDowry")
		AND
		GetFlag(PLA_StuckHalfElf_State_HasDowry_464445ee-74e3-4838-98dc-435074439303, _Character, 1)
		THEN
		QuestUpdate(_Character, "PLA_StuckHalfElf", "DowryGold");
		
		
		IF
		QuestUpdateUnlocked(_Character, "PLA_StuckHalfElf", "KnowDowry_Benryn")
		AND
		GetFlag(PLA_StuckHalfElf_State_HasDowry_464445ee-74e3-4838-98dc-435074439303, _Character, 1)
		THEN
		QuestUpdate(_Character, "PLA_StuckHalfElf", "DowryGold");
		
		IF
		FlagSet(PLA_StuckHalfElf_State_HasDowry_464445ee-74e3-4838-98dc-435074439303, _Player, _)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		QuestUpdateIsUnlocked(_Player, "PLA_StuckHalfElf", "KnowDowry", 1)
		THEN
		QuestUpdate((CHARACTER)_Player, "PLA_StuckHalfElf", "DowryGold");
		
		IF
		FlagSet(PLA_StuckHalfElf_State_HasDowry_464445ee-74e3-4838-98dc-435074439303, _Player, _)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		QuestUpdateIsUnlocked(_Player, "PLA_StuckHalfElf", "KnowDowry_Benryn", 1)
		THEN
		QuestUpdate((CHARACTER)_Player, "PLA_StuckHalfElf", "DowryGold");
		
		IF
		FlagSet(GLO_SpeakWithDead_State_QuestionsLimitReached_01c40268-4a8d-4787-8566-77e01ff04762, S_PLA_Tavern_DeadCiv1_1ed658d0-e88a-4b7b-ab9e-1e520ae7d0c7, _)
		AND
		QuestUpdateIsUnlocked(NULL_00000000-0000-0000-0000-000000000000, "PLA_StuckHalfElf", "KnowDowry", 0)
		THEN
		SetFlag(PLA_StuckHalfElf_State_WifeCantAnswer_c0f175fd-724b-4207-af19-4727f3784ad5, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		DialogEnded(PLA_Tavern_DeadCiv1_Dead_4840f358-407f-0fdb-352d-c1db600ed975, _)
		AND
		QuestUpdateIsUnlocked(NULL_00000000-0000-0000-0000-000000000000, "PLA_StuckHalfElf", "KnowDowry", 0)
		THEN
		SetFlag(PLA_StuckHalfElf_State_WifeCantAnswer_c0f175fd-724b-4207-af19-4727f3784ad5, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		FlagSet(PLA_StuckHalfElf_Knows_ExplainedDowry_964ce6a1-bc82-0892-5e94-9dbd27054a38, _, _)
		AND
		DB_Players(_Player)
		THEN
		QuestUpdate(_Player, "PLA_StuckHalfElf", "KnowDowry_Benryn");
		//END_REGION
		
		//END_REGION
		
		
		//REGION Area burns down
		
		IF
		DB_InRegion(_Character, S_PLA_TavernInvestigation_BurnDownTrigger_Inner_df11a25c-e374-499b-9993-47c44b9b84b0)
		THEN
		DB_PLA_TavernInvestigation_PrimeForFire(1);
		PROC_TriggerUnregisterForParty(S_PLA_TavernInvestigation_BurnDownTrigger_Inner_df11a25c-e374-499b-9993-47c44b9b84b0);
		PROC_GlobalSetFlagAndCache(PLA_Tavern_Knows_Burning_f1d6e5cf-e8d4-4095-a6ef-17dfcd4521b0);
		
		IF
		DB_PLA_TavernInvestigation_PrimeForFire(1)
		AND
		NOT DB_InRegion(_, S_PLA_TavernInvestigation_BurnDownTrigger_Inner_df11a25c-e374-499b-9993-47c44b9b84b0) //It's possible the character gets the enter event for this first.
		AND
		NOT DB_InRegion(_, S_PLA_TavernInvestigation_BurnDownTrigger_Outer_9886da68-ca75-490c-a9ea-8198fbdeac1a)
		THEN
		PROC_PLA_TryBurnDownTavern();
		
		PROC
		PROC_LongRest()
		AND
		DB_PLA_TavernInvestigation_PrimeForFire(1)
		THEN
		PROC_PLA_TryBurnDownTavern();
		
		PROC
		PROC_LevelUnloading("WLD_Main_A")
		THEN
		PROC_PLA_TryBurnDownTavern();
		
		//END_REGION
		
		//REGION VB after the player realises the Flaming Fists could not care less about the Zhentarim.
		IF
		DB_PLA_FlamingFistsOutsideDialog(_Dialog)
		THEN
		DB_FlagReactionAfterDialog(PLA_FlamingFists_Knows_ZhentDungeon_6226a6b7-2d34-99c3-c81c-bcd7795c228a, _Dialog);
		
		PROC
		PROC_FlagReactionAfterDialog(_Player, (FLAG)PLA_FlamingFists_Knows_ZhentDungeon_6226a6b7-2d34-99c3-c81c-bcd7795c228a)
		AND
		QRY_OncePerUserAndNearbyPlayers((CHARACTER)_Player, "PLA_FlamingFists_VB_ToldOfZhentDungeon")
		THEN
		StartVoiceBark(PLA_FlamingFists_VB_ToldOfZhentDungeon_a6c8a2bd-1b2f-675a-8c05-8644ad95f07c, _Player);
		
		//END_REGION
		
		//REGION Frightened Ox
		
		PROC
		PROC_DialogFlagSetup(PLA_Tavern_OxAlive_5a920f74-a41f-cb9f-b4ac-fac7e452703b, _, _)
		THEN
		DB_PLA_Ox_BlockSpotReaction(1);
		
		IF
		DialogEnded(PLA_Tavern_OxAlive_5a920f74-a41f-cb9f-b4ac-fac7e452703b, _)
		THEN
		NOT DB_PLA_Ox_BlockSpotReaction(1);
		
		PROC
		PROC_SpotPlayers_Spotted((CHARACTER)S_PLA_Tavern_OxAlive_c69aa4c1-bac2-401f-b4ec-cce8d545ba7c, "PLA_Tavern_Ox", _Character)
		AND
		NOT DB_PLA_Ox_BlockSpotReaction(1)
		AND
		IsInCombat(S_PLA_Tavern_OxAlive_c69aa4c1-bac2-401f-b4ec-cce8d545ba7c, 0)
		AND
		NOT QRY_StartDialog((DIALOGRESOURCE)PLA_Tavern_OxAlive_5a920f74-a41f-cb9f-b4ac-fac7e452703b, (CHARACTER)S_PLA_Tavern_OxAlive_c69aa4c1-bac2-401f-b4ec-cce8d545ba7c, _Character)
		AND
		NOT QRY_StartDialog(PLA_Tavern_OxAlive_AD_5f15ffec-ab1f-2288-547c-9071d5a0d092, (CHARACTER)S_PLA_Tavern_OxAlive_c69aa4c1-bac2-401f-b4ec-cce8d545ba7c, _Character)
		THEN
		PROC_TryStartAD(PLA_Tavern_OxAlive_AD_5f15ffec-ab1f-2288-547c-9071d5a0d092, (CHARACTER)S_PLA_Tavern_OxAlive_c69aa4c1-bac2-401f-b4ec-cce8d545ba7c);
		DB_HostileToPlayerGroup((FACTION)Act1_PLA_Tavern_Ox_9312f73a-0272-43e3-a23f-b1e98c400d1c, _Character);
		
		IF
		AutomatedDialogStarted(PLA_Tavern_OxAlive_AD_5f15ffec-ab1f-2288-547c-9071d5a0d092, _ID)
		AND
		DB_DialogPlayers(_ID, _Player, 1)
		THEN
		DB_HostileToPlayerGroup((FACTION)Act1_PLA_Tavern_Ox_9312f73a-0272-43e3-a23f-b1e98c400d1c, (CHARACTER)_Player);
		
		IF
		FlagSet((FLAG)PLA_Tavern_State_OxPacified_cc948928-15b4-2dd1-5fe4-11b5fa79d78f, _, _) //SpotPlayers system expects an Event flag and clears it.s
		THEN
		PROC_SpotPlayers_StopSpotting((CHARACTER)S_PLA_Tavern_OxAlive_c69aa4c1-bac2-401f-b4ec-cce8d545ba7c, "PLA_Tavern_Ox");
		
		//END_REGION
		
		
		//REGION Flaming Fist 8
		
		IF
		DB_GlobalFlag((FLAG)PLA_TavernInvestigation_State_BurntDown_ad34c392-4499-402c-ae51-8c3d40985f8b)
		AND
