		AND
		QRY_BG3_SavegameIsOlderThan("Release Patch 6 Hotfix 9")
		AND
		DB_PartyFollowers(S_TUT_Lab_TrappedDevourer_6ca92237-eb1e-4ed8-a1ee-18b3bef21558)
