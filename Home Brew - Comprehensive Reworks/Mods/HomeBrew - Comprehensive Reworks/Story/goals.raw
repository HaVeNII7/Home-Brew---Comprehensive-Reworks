		DB_TopicalGreeting((FLAG)TG_DarkUrge_AlfiraMurder_1a1b66f8-68f7-403b-8939-2feae6819e95);
		DB_TopicalGreetingEndCondition_LongRest((FLAG)TG_DarkUrge_AlfiraMurder_1a1b66f8-68f7-403b-8939-2feae6819e95);
		
		DB_GiveItemToEventWithClear(S_ORI_DarkUrge_CloakReward_88ddc51d-2f1c-4871-9c5b-550ff0437cfc, ORI_DarkUrge_Event_GiveReward_d6b19afd-c589-4946-842f-aab99d905333);
		
		DB_ORI_GoblincampSubregion((TRIGGER)S_GOB_Festivities_SUB_217424e5-f9b7-4441-ab09-715076696a12);
		DB_ORI_GoblincampSubregion(S_GOB_ThroneRoom_SUB_bb81678b-641c-43fc-bd41-53295d59be03);
		DB_ORI_GoblincampSubregion(S_GOB_PriestDungeon_SUB_d693268c-84c9-44c2-ac7d-11ebc5524764);
		DB_ORI_GoblincampSubregion(S_GOB_WolfPens_SUB_a9a4a7c2-87c6-4031-9859-7eddb0528ff6);
		DB_ORI_GoblincampSubregion(S_GOB_PainPenance_SUB_3189cec7-0f63-468c-a147-6a5fe426f518);
		
		DB_Dialogs(S_DEN_Bard_Backup_8ef4c8ea-317d-4539-aa5b-c5e899cf0f31, DEN_BardBackup_c7ee92dc-6826-ef71-9367-b0934ac771f3);
		
		DB_ORI_DarkUrge_AlfiraIVBs((VOICEBARKRESOURCE)CAMP_DarkUrge_MurderOfAlfira_GD_IVB_MorningAfter_bfabc085-fb40-4147-e0e3-ef13229f5382, (CHARACTER)S_DEN_Bard_4a405fba-3000-4c63-97e5-a8001ebb883c);
		DB_ORI_DarkUrge_AlfiraIVBs((VOICEBARKRESOURCE)CAMP_DarkUrge_MurderOfAlfira_GD_IVB_MorningAfter_Backup_f28df493-b622-b1a2-6c91-feeb040e2db8, (CHARACTER)S_DEN_Bard_Backup_8ef4c8ea-317d-4539-aa5b-c5e899cf0f31);
		
		DB_GLO_CompoundFlag((FLAG)CAMP_DarkUrge_Event_AlfiraJoined_3a8bfe66-3b29-97af-c941-9ba4bfd1d0d2, (FLAG)CAMP_DarkUrge_Event_RecruitAlfira_a61d6b2a-73a1-3f12-60b0-a5e3025cbeac); //They are always set togther in dialog. Extra security
	}
	KB
	{
		IF
		DB_ORI_DarkUrge_AlfiraPos(_Camp, _Trigger)
		THEN
		DB_ORI_OriginCampData((CHARACTER)S_DEN_Bard_4a405fba-3000-4c63-97e5-a8001ebb883c, _Camp, _Trigger);
		DB_ORI_OriginCampData((CHARACTER)S_DEN_Bard_Backup_8ef4c8ea-317d-4539-aa5b-c5e899cf0f31, _Camp, _Trigger);
		
		IF
		CharacterLootedCharacter((CHARACTER)_DarkUrge, _Character)
		AND
		DB_ORI_DarkUrge((CHARACTER)_DarkUrge)
		AND
		IsTagged(_Character, (TAG)HUMANOID_7fbed0d4-cabc-4a9d-804e-12ca6088a0a8, 1)
		AND
		NOT DB_OnlyOnce("CRA_DarkUrge_WakeUp")
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)ORI_DarkUrge_LootCorpse_1c7baa93-4189-bfef-5e45-5d6d05698820, _DarkUrge)
		THEN
		DB_OnlyOnce("CRA_DarkUrge_WakeUp");
		
		IF
		DB_DialogSpeakers(_Id, S_DEN_Bard_4a405fba-3000-4c63-97e5-a8001ebb883c, _)
		AND
		DB_DialogPlayers(_Id, _Player, _)
		AND
		NOT DB_DialogName((DIALOGRESOURCE)CAMP_DarkUrge_MurderOfAlfira_CFM_AlfiraArrives_dcb97457-a697-83a3-91e8-abd0eccfbc1d, _ID)
		THEN
		SetFlag((FLAG)DEN_Bard_HasMet_User_981dfdf9-82f6-bca6-881c-4548793becd5, _Player, _Id);
		
		//REGION Murder of Alfira
		
		PROC
		PROC_DialogFlagSetup(DEN_BardBackup_c7ee92dc-6826-ef71-9367-b0934ac771f3, _, _)
		THEN
		SetFlag((FLAG)DEN_Bard_Backup_State_Arrived_c1e8b434-ffde-d0ab-5dd4-7ffb54eff3dd, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		PROC
		PROC_CampNight_PreSelection_Hook()
		AND
		NOT DB_GlobalFlag((FLAG)NIGHT_DarkUrge_MurderOfAlfira_b0e97b06-b2f8-4376-829f-23d4b4bcf78d)
		AND
		DB_ORI_DarkUrge(_)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_DarkUrge_KilledIsobel_Requirement_b19523f2-d4bf-42f7-9834-2d19e04b2119)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_DarkUrge_SparedIsobel_Requirement_7b24b6bb-f9ef-414e-92e8-a662ce41fced)
		THEN
		PROC_ORI_DarkUrge_SetupMurderOfAlfira();
		
		PROC
		PROC_ORI_DarkUrge_SetupMurderOfAlfira()
		AND
		NOT QRY_ORI_DarkUrge_ReplaceAlfira()
		THEN
		NOT DB_ORI_DarkUrge_AlfiraMurderVictim((CHARACTER)S_DEN_Bard_Backup_8ef4c8ea-317d-4539-aa5b-c5e899cf0f31);
		DB_ORI_DarkUrge_AlfiraMurderVictim((CHARACTER)S_DEN_Bard_4a405fba-3000-4c63-97e5-a8001ebb883c);
		
		PROC
		PROC_ORI_DarkUrge_SetupMurderOfAlfira()
		AND
		QRY_ORI_DarkUrge_ReplaceAlfira()
		THEN
		DB_ORI_DarkUrge_AlfiraMurderVictim((CHARACTER)S_DEN_Bard_Backup_8ef4c8ea-317d-4539-aa5b-c5e899cf0f31);
		NOT DB_ORI_DarkUrge_AlfiraMurderVictim((CHARACTER)S_DEN_Bard_4a405fba-3000-4c63-97e5-a8001ebb883c);
		
		PROC
		PROC_ORI_DarkUrge_SetupMurderOfAlfira()
		AND
		NOT QRY_ORI_DarkUrge_ReturnPositionInGoblinCamp()
		THEN
		ClearFlag((FLAG)ORI_DarkUrge_MurderOfAlfira_State_InGoblinCamp_e402fcb5-ad72-4c1e-eae2-5c8ac20914c0, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		QRY
		QRY_ORI_DarkUrge_ReturnPositionInGoblinCamp()
		AND
		DB_ORI_DarkUrge(_DarkUrge)
		AND
		DB_LeaveCamp_ReturnPos(_DarkUrge,_X, _Y, _Z)
		AND
		DB_ORI_GoblincampSubregion(_Trigger)
		AND
		PositionIsInTrigger(_X, _Y, _Z, _Trigger, 1)
		THEN
		SetFlag((FLAG)ORI_DarkUrge_MurderOfAlfira_State_InGoblinCamp_e402fcb5-ad72-4c1e-eae2-5c8ac20914c0, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		PROC
		PROC_ORI_DarkUrge_SetupMurderOfAlfira()
		AND
		DB_ORI_DarkUrge_MurderOfAlfiraRandom((CHARACTER)_Random)
		THEN
		NOT DB_ORI_DarkUrge_MurderOfAlfiraRandom(_Random);
		
		PROC
		PROC_ORI_DarkUrge_SetupMurderOfAlfira()
		AND
		DB_InCamp(_Character)
		AND
		DB_Origins(_Character)
		AND
		NOT DB_Avatars(_Character)
		AND
		NOT DB_CantTalk(_Character)
		AND
		DB_ORI_DarkUrge(_DU)
		AND
		NOT QRY_PreventMPDialogue(_Character, _DU)
		THEN
		DB_ORI_DarkUrge_MurderOfAlfiraRandom(_Character);
		
		PROC
		PROC_ORI_DarkUrge_SetupMurderOfAlfira()
		AND
		QRY_GetRandom("DB_ORI_DarkUrge_MurderOfAlfiraRandom", 1, "DB_ORI_DarkUrge_MurderOfAlfiraRandom_Chosen")
		THEN
		DB_NOOP(1);
		
		
		//Having gathered all the speakers, construct the CFM & Speaker list.
		PROC
		PROC_ORI_DarkUrge_SetupMurderOfAlfira()
		AND
		DB_CampNight_CFM((FLAG)NIGHT_DarkUrge_MurderOfAlfira_b0e97b06-b2f8-4376-829f-23d4b4bcf78d,(DIALOGRESOURCE)_CFM)
		AND
		DB_CampfireMoment_FixedSpeakers(_CFM, _Victim)
		THEN
		NOT DB_CampfireMoment_FixedSpeakers(_CFM, _Victim);
		
		PROC
		PROC_ORI_DarkUrge_SetupMurderOfAlfira()
		AND
		DB_CampNight_CFM((FLAG)NIGHT_DarkUrge_MurderOfAlfira_b0e97b06-b2f8-4376-829f-23d4b4bcf78d,(DIALOGRESOURCE)_CFM)
		AND
		DB_CampfireMoment_OptionalSpeakers((DIALOGRESOURCE)_CFM, _Random)
		THEN
		NOT DB_CampfireMoment_OptionalSpeakers(_CFM, _Random);
		
		PROC
		PROC_ORI_DarkUrge_SetupMurderOfAlfira()
		AND
		DB_CampNight_CFM((FLAG)NIGHT_DarkUrge_MurderOfAlfira_b0e97b06-b2f8-4376-829f-23d4b4bcf78d,(DIALOGRESOURCE)_CFM)
		THEN
		NOT DB_CampNight_CFM((FLAG)NIGHT_DarkUrge_MurderOfAlfira_b0e97b06-b2f8-4376-829f-23d4b4bcf78d,(DIALOGRESOURCE)_CFM);
		
		
		PROC
		PROC_ORI_DarkUrge_SetupMurderOfAlfira()
		AND
		DB_ORI_DarkUrge_AlfiraMurderVictim((CHARACTER)S_DEN_Bard_4a405fba-3000-4c63-97e5-a8001ebb883c)
		THEN
		DB_CampNight_CFM((FLAG)NIGHT_DarkUrge_MurderOfAlfira_b0e97b06-b2f8-4376-829f-23d4b4bcf78d,(DIALOGRESOURCE)CAMP_DarkUrge_MurderOfAlfira_CFM_AlfiraArrives_dcb97457-a697-83a3-91e8-abd0eccfbc1d);
		DB_CampfireMoment_FixedSpeakers((DIALOGRESOURCE)CAMP_DarkUrge_MurderOfAlfira_CFM_AlfiraArrives_dcb97457-a697-83a3-91e8-abd0eccfbc1d, (GUIDSTRING)S_DEN_Bard_4a405fba-3000-4c63-97e5-a8001ebb883c);
		
		PROC
		PROC_ORI_DarkUrge_SetupMurderOfAlfira()
		AND
		DB_ORI_DarkUrge_AlfiraMurderVictim((CHARACTER)S_DEN_Bard_Backup_8ef4c8ea-317d-4539-aa5b-c5e899cf0f31)
		THEN
		DB_CampNight_CFM((FLAG)NIGHT_DarkUrge_MurderOfAlfira_b0e97b06-b2f8-4376-829f-23d4b4bcf78d,(DIALOGRESOURCE)CAMP_DarkUrge_MurderOfAlfira_CFM_BardBackupArrives_ad8f4355-b46b-136b-4e55-7ee1d256b001);
		DB_CampfireMoment_FixedSpeakers((DIALOGRESOURCE)CAMP_DarkUrge_MurderOfAlfira_CFM_BardBackupArrives_ad8f4355-b46b-136b-4e55-7ee1d256b001, (GUIDSTRING)S_DEN_Bard_Backup_8ef4c8ea-317d-4539-aa5b-c5e899cf0f31);
		
		PROC
		PROC_ORI_DarkUrge_SetupMurderOfAlfira()
		AND
		DB_ORI_DarkUrge_AlfiraMurderVictim((CHARACTER)S_DEN_Bard_4a405fba-3000-4c63-97e5-a8001ebb883c)
		AND
		DB_ORI_DarkUrge_MurderOfAlfiraRandom_Chosen(_Random)
		THEN
		DB_CampfireMoment_OptionalSpeakers((DIALOGRESOURCE)CAMP_DarkUrge_MurderOfAlfira_CFM_AlfiraArrives_dcb97457-a697-83a3-91e8-abd0eccfbc1d, (GUIDSTRING)_Random);
		NOT DB_ORI_DarkUrge_MurderOfAlfiraRandom_Chosen(_Random);
		
		PROC
		PROC_ORI_DarkUrge_SetupMurderOfAlfira()
		AND
		DB_CampNight_MorningIVB((FLAG)NIGHT_DarkUrge_MurderOfAlfira_b0e97b06-b2f8-4376-829f-23d4b4bcf78d, _IVB, _DarkUrge)
		THEN
		NOT DB_CampNight_MorningIVB((FLAG)NIGHT_DarkUrge_MurderOfAlfira_b0e97b06-b2f8-4376-829f-23d4b4bcf78d, _IVB, _DarkUrge);
		
		PROC
		PROC_ORI_DarkUrge_SetupMurderOfAlfira()
		AND
		DB_ORI_DarkUrge_AlfiraMurderVictim(_Victim)
		AND
		DB_ORI_DarkUrge_AlfiraIVBs(_IVB, _Victim)
		AND
		DB_ORI_DarkUrge(_DarkUrge)
		THEN
		DB_CampNight_MorningIVB((FLAG)NIGHT_DarkUrge_MurderOfAlfira_b0e97b06-b2f8-4376-829f-23d4b4bcf78d, _IVB, _DarkUrge);
		
		PROC
		PROC_ORI_DarkUrge_SetupMurderOfAlfira()
		AND
		DB_ORI_DarkUrge_AlfiraMurderVictim((CHARACTER)S_DEN_Bard_Backup_8ef4c8ea-317d-4539-aa5b-c5e899cf0f31)
		AND
		DB_ORI_DarkUrge_MurderOfAlfiraRandom_Chosen(_Random)
		THEN
		DB_CampfireMoment_OptionalSpeakers((DIALOGRESOURCE)CAMP_DarkUrge_MurderOfAlfira_CFM_BardBackupArrives_ad8f4355-b46b-136b-4e55-7ee1d256b001, _Random);
		NOT DB_ORI_DarkUrge_MurderOfAlfiraRandom_Chosen(_Random);
		
		QRY
		QRY_ORI_DarkUrge_ReplaceAlfira()
		AND
		DB_CantTalk((CHARACTER)S_DEN_Bard_4a405fba-3000-4c63-97e5-a8001ebb883c)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_ORI_DarkUrge_ReplaceAlfira()
		AND
		DB_CurrentLevel("SCL_Main_A")
		AND
		NOT DB_GlobalFlag((FLAG)DEN_General_State_Entered_26b2dc6a-e5eb-4d99-a4bd-3ecaa3b86a9e)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_GLO_PartyMembers_MakeNPCHook(S_DEN_Bard_4a405fba-3000-4c63-97e5-a8001ebb883c)
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_DEN_Bard_4a405fba-3000-4c63-97e5-a8001ebb883c);
		DB_Dialogs((CHARACTER)S_DEN_Bard_4a405fba-3000-4c63-97e5-a8001ebb883c, (DIALOGRESOURCE)DEN_Bard_InParty_3c71c397-b378-340b-0da9-ef3d17d14423);
		
		IF
		DB_Camp_QueuedNight((FLAG)NIGHT_DarkUrge_MurderOfAlfira_b0e97b06-b2f8-4376-829f-23d4b4bcf78d)
		AND
		DB_ORI_DarkUrge_AlfiraMurderVictim((CHARACTER)S_DEN_Bard_4a405fba-3000-4c63-97e5-a8001ebb883c)
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_DEN_Bard_4a405fba-3000-4c63-97e5-a8001ebb883c);
		DB_Dialogs((CHARACTER)S_DEN_Bard_4a405fba-3000-4c63-97e5-a8001ebb883c, (DIALOGRESOURCE)DEN_Bard_InParty_3c71c397-b378-340b-0da9-ef3d17d14423);
		
		IF
		DB_Camp_QueuedNight((FLAG)NIGHT_DarkUrge_MurderOfAlfira_b0e97b06-b2f8-4376-829f-23d4b4bcf78d)
		AND
		DB_ORI_DarkUrge_AlfiraMurderVictim(_Victim)
		THEN
		DB_DontCreateMurder((CHARACTER)_Victim);
		
		IF
		DB_Camp_QueuedNight((FLAG)NIGHT_DarkUrge_MurderOfAlfira_b0e97b06-b2f8-4376-829f-23d4b4bcf78d)
		THEN
		PROC_ORI_DarkUrge_TeleportAlfiraVictim();
		
		PROC
		PROC_CampNight_StartMorningMoments()
		AND
		DB_ORI_DarkUrge_AlfiraMurderVictim(_Victim)
		AND
		DB_CorpseCleanup_Ignore(_Victim)
		THEN
		NOT DB_CorpseCleanup_Ignore(_Victim);
		DB_CorpseCleanup_ReadyToBeRemoved(_Victim);
		
		PROC
		PROC_Camp_DropAllPolymorphs()
		AND
		DB_Camp_QueuedNight((FLAG)NIGHT_DarkUrge_MurderOfAlfira_b0e97b06-b2f8-4376-829f-23d4b4bcf78d)
		AND
		DB_ORI_DarkUrge_AlfiraMurderVictim(_Victim)
		THEN
		PROC_RemoveMutingStatusses(_Victim);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)CAMP_DarkUrge_MurderOfAlfira_SD_BloodOnHands_06b3f254-a0ba-d0fb-d8f4-6e2541cb5a2c, (INTEGER)_ID)
		AND
		DB_ORI_DarkUrge_AlfiraMurderVictim(_Victim)
		AND
		DB_ORI_DarkUrge((CHARACTER)_DarkUrge)
		AND
		DB_ActiveCamp(_Camp)
		AND
		DB_ORI_DarkUrge_AlfiraPos(_Camp, _Trigger)
		THEN
		DB_Camp_StayInCampAfterLongRest(1);
		TeleportTo(_Victim, _Trigger, "", 0, 0, 0, 0, 1);
		SetOnStage(_Victim, 0);
		PROC_ClearStoryMove(_Victim);
		DB_DialogDeath(_Victim);
		DB_ORI_DarkUrge_AlfiraForceAvailable(_Victim);
		PROC_DialogAddSpeakingActor(_ID, (CHARACTER)_Victim);
		NOT DB_ORI_DarkUrge_AlfiraForceAvailable(_Victim);
		PROC_GlobalSetFlagAndCache(ORI_DarkUrge_State_MurderedAlfiraOrAlternativeInSleep_1b2a9aa5-7cc1-42d3-98d1-a254d612c37a);
		PROC_ORI_DarkUrge_DarkUrgeKilled(_DarkUrge,_Victim);
		
		QRY
		QRY_SpeakerIsAvailable(_Victim,1,1,1) 
		AND
		DB_ORI_DarkUrge_AlfiraForceAvailable((CHARACTER)_Victim)
		THEN
		DB_NOOP(1);
		
		IF
		DialogStarted(CAMP_SleepCutscene_69f925cf-1afd-4680-9532-8e80221aa93a, _ID)
		AND
		DB_Camp_QueuedNight((FLAG)NIGHT_DarkUrge_MurderOfAlfira_b0e97b06-b2f8-4376-829f-23d4b4bcf78d)
		AND
		DB_ORI_DarkUrge_AlfiraMurderVictim(_Victim)
		AND
		NOT DB_GlobalFlag(ORI_DarkUrge_Event_HideAlfiraCorpse_c5e208f3-862b-bf96-1814-552b983149a1)
		THEN
		SetOnStage(_Victim, 1);
		
		IF
		DialogEnded(CAMP_SleepCutscene_69f925cf-1afd-4680-9532-8e80221aa93a, _ID)
		AND
		DB_Camp_QueuedNight((FLAG)NIGHT_DarkUrge_MurderOfAlfira_b0e97b06-b2f8-4376-829f-23d4b4bcf78d)
		AND
		DB_ORI_DarkUrge_AlfiraMurderVictim(_Victim)
		AND
		DB_GlobalFlag(ORI_DarkUrge_Event_HideAlfiraCorpse_c5e208f3-862b-bf96-1814-552b983149a1)
		AND
		GetPosition(_Victim, _X, _Y, _Z)
		THEN
		CreateSurfaceAtPosition(_X, _Y, _Z, "SurfaceNone", 2.0, -1.0, NULL_00000000-0000-0000-0000-000000000000); //Remove blood
		
		IF
		DialogStarted(CAMP_SleepCutscene_69f925cf-1afd-4680-9532-8e80221aa93a, _ID)
		AND
		DB_Camp_QueuedNight((FLAG)NIGHT_DarkUrge_MurderOfAlfira_b0e97b06-b2f8-4376-829f-23d4b4bcf78d)
		AND
