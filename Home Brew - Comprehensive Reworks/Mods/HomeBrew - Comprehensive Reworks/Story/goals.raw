Goal(523).Title("Act3_OriginMoments_Shadowheart");
Goal(523)
{
	INIT
	{
		//REGION OM_SharranInformer
		
		DB_SpotPlayers((CHARACTER)S_GLO_SharranInformer_b2cf2efe-ec06-48cd-8fb7-ad596d61164f, "WYR_RefugeeCamp_HandlerSpot", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		DB_SpotPlayers_TargetIgnoreCantTalk((CHARACTER)S_GLO_SharranInformer_b2cf2efe-ec06-48cd-8fb7-ad596d61164f, "WYR_RefugeeCamp_HandlerSpot");
		DB_SpotPlayers_HasTag((CHARACTER)S_GLO_SharranInformer_b2cf2efe-ec06-48cd-8fb7-ad596d61164f, "WYR_RefugeeCamp_HandlerSpot", (TAG)SHADOWHEART_8b4cf0fa-f712-4839-9439-f86a519078fa, 1);
		DB_SpotPlayers_CustomRadius((CHARACTER)S_GLO_SharranInformer_b2cf2efe-ec06-48cd-8fb7-ad596d61164f, "WYR_RefugeeCamp_HandlerSpot", 10.0);
		
		DB_Dialogs(S_GLO_SharranInformer_b2cf2efe-ec06-48cd-8fb7-ad596d61164f, (DIALOGRESOURCE)WYR_RefugeeCamp_SharranInformer_f114c457-76fc-0b4a-28b6-4052a59cb948);
		
		PROC_DefineSingleOriginMoment(
			(DIALOGRESOURCE)WYR_RefugeeCamp_SharranInformer_f114c457-76fc-0b4a-28b6-4052a59cb948,
			(TAG)SHADOWHEART_8b4cf0fa-f712-4839-9439-f86a519078fa,
			(DIALOGRESOURCE)WYR_RefugeeCamp_OM_Shadowheart_AOM_OOM_ab6223f9-eeca-ef54-8c63-92b9f1a6eba9,
			(DIALOGRESOURCE)WYR_RefugeeCamp_OM_Shadowheart_COM_64277eb5-3c13-6da6-9184-0cfe7805c5c3,
			(DIALOGRESOURCE)WYR_RefugeeCamp_OM_Shadowheart_AOM_OOM_ab6223f9-eeca-ef54-8c63-92b9f1a6eba9);
		
		DB_GlobalFlagReactionAfterDialog((FLAG)ORI_Shadowheart_Event_InformerLeaves_dff4a662-897b-486d-aa5c-221f1f2217d5, (DIALOGRESOURCE)WYR_RefugeeCamp_OM_Shadowheart_AOM_OOM_ab6223f9-eeca-ef54-8c63-92b9f1a6eba9);
		DB_GlobalFlagReactionAfterDialog((FLAG)ORI_Shadowheart_Event_InformerLeaves_dff4a662-897b-486d-aa5c-221f1f2217d5, (DIALOGRESOURCE)WYR_RefugeeCamp_OM_Shadowheart_COM_64277eb5-3c13-6da6-9184-0cfe7805c5c3);
		
		DB_GLO_CharacterCorpseDialog((CHARACTER)S_WYR_MurderVictim_3d23b55b-b1da-4075-a695-ecdd19f7d335, (DIALOGRESOURCE)WYR_RefugeeCamp_Dead_MurderVictim_4e620f11-5f9e-a236-fb35-afcdb181f17c);
		
		DB_WYR_RefugeeCamp_RingPart((ITEM)S_WYR_RinglessGem_d2a8a798-dd91-441a-b7ee-dbe4edede40c);
		DB_WYR_RefugeeCamp_RingPart((ITEM)S_WYR_GemlessRing_7b57acf6-6a27-4a84-b533-69e10f8dbbd3);
		
		DB_OneShot_ADTrigger((TRIGGER)S_WYR_RefugeeCamp_CampArea_a63c8d3c-02ec-4a74-94d5-4d1718b2af66, (DIALOGRESOURCE)WYR_RefugeeCamp_PAD_NearHandler_031716ad-b9f2-95bf-6ec6-a149247bdbe1, S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679);
		
		//END_REGION
		
		//REGION Act 3 romance
		DB_CampNight((FLAG)NIGHT_Shadowheart_Skinnydipping_9f583304-0a1a-498c-acf9-3c8dcc30ee3d, 4110);
