	KB
	{
		//REGION Teleport To Camp - Isobel
		IF
		EntityEvent(S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211, "DebugTeleportedToCamp")
		THEN
		PROC_SCE_NightsongIsobelReunion_MoveIsobelToCamp();
		
		PROC
		PROC_SCE_NightsongIsobelReunion_MoveIsobelToCamp()
		AND
		NOT DB_PermaDefeated(S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211)
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211);
		DB_Dialogs(S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211, (DIALOGRESOURCE)CAMP_Isobel_811d4693-e7a2-ab59-4afd-1701756b755f);
		PROC_ORI_SetupCamp((CHARACTER)S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211, 1);
		//END_REGION
		
		//REGION Teleport To Camp - Nightsong
		IF
		EntityEvent(S_GLO_Nightsong_6c55edb0-901b-4ba4-b9e8-3475a8392d9b, "DebugTeleportedToCamp")
		THEN
		PROC_SCE_NightsongIsobelReunion_MoveNightsongToCamp();
		
		PROC
		PROC_SCE_NightsongIsobelReunion_MoveNightsongToCamp()
		AND
		NOT DB_PermaDefeated(S_GLO_Nightsong_6c55edb0-901b-4ba4-b9e8-3475a8392d9b)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)CAMP_SharTempleEpilogue_State_NightsongInCamp_1e3475b8-ab7b-4a53-a079-0ac3f86899ed);
		PROC_RemoveAllDialogEntriesForSpeaker(S_GLO_Nightsong_6c55edb0-901b-4ba4-b9e8-3475a8392d9b);
		DB_Dialogs(S_GLO_Nightsong_6c55edb0-901b-4ba4-b9e8-3475a8392d9b, (DIALOGRESOURCE)CAMP_Nightsong_60070e0f-0ab6-f653-7962-c2fff93b5a2d);
		PROC_ORI_SetupCamp((CHARACTER)S_GLO_Nightsong_6c55edb0-901b-4ba4-b9e8-3475a8392d9b, 1);
		//END_REGION
		
		//REGION Teleport To Camp - Tara, Gale's Tressym
		IF
		EntityEvent(S_GLO_Gale_Tressym_ada7ee81-829d-48c7-ba73-9c9ec191d236, "DebugTeleportedToCamp")
		THEN
		PROC_CampNight_GaleTressym_ToCamp(1);
		//END_REGION
		
		
		//REGION Teleport To Camp - Dark Urge's Butler
		IF
		EntityEvent((CHARACTER)S_GLO_DarkUrge_Butler_f3486165-268f-4e41-9e0c-51485dfdff10, "DebugTeleportedToCamp")
		THEN
		DB_ORI_DarkUrge_Debug_ButlerToCamp(1);
		DB_Dialogs(S_GLO_DarkUrge_Butler_f3486165-268f-4e41-9e0c-51485dfdff10, (DIALOGRESOURCE)GLO_DarkUrge_Butler_6dedd871-ae5b-a47d-bd93-a6f7f21578ea);
		PROC_ORI_SetupCamp((CHARACTER)S_GLO_DarkUrge_Butler_f3486165-268f-4e41-9e0c-51485dfdff10, 1);
		
		//END_REGION
		
		
		//REGION Teleport To Camp - Ravengard
		IF
		EntityEvent((CHARACTER)S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, "DebugTeleportedToCamp")
		THEN
		PROC_ORI_SetupCamp((CHARACTER)S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, 1);
		//END_REGION
		
		
		//REGION Teleport To Camp - Shadowheart's Parents
		IF
		EntityEvent((CHARACTER)S_LOW_ShadowheartFather_c12d561f-beae-4ef6-917e-0bec2f829449, "DebugTeleportedToCamp")
		THEN
		PROC_ORI_SetupCamp((CHARACTER)S_LOW_ShadowheartFather_c12d561f-beae-4ef6-917e-0bec2f829449, 1);
		
		IF
		EntityEvent((CHARACTER)S_LOW_ShadowheartMother_d085272a-f1d0-4ff8-a498-80728030f83e, "DebugTeleportedToCamp")
		THEN
		PROC_ORI_SetupCamp((CHARACTER)S_LOW_ShadowheartMother_d085272a-f1d0-4ff8-a498-80728030f83e, 1);
		//END_REGION
		
		//REGION Teleport To Camp - Mizora
		IF
		EntityEvent((CHARACTER)S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a, "DebugTeleportedToCamp")
		THEN
		PROC_ORI_SetupCamp((CHARACTER)S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a, 1);
		//END_REGION
		
		//REGION Teleport To Camp - Minthara
		IF
		EntityEvent((CHARACTER)S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, "DebugTeleportedToCamp")
		THEN
		PROC_ORI_SetupCamp((CHARACTER)S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, 1);
		//END_REGION
		
		//REGION Teleport To Camp - Ravengard
		IF
		EntityEvent((CHARACTER)S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, "DebugTeleportedToCamp")
		THEN
		PROC_LOW_IronThrone_MoveRavengardToCamp();
		
		PROC
		PROC_LOW_IronThrone_MoveRavengardToCamp()
		THEN
		PROC_CAMP_Ravengard_RestoreRavengard();
		SetFlag((FLAG)CAMP_Ravengard_State_RavengardInCamp_37309008-04cf-493c-8ca6-43034d331a8a);
		PROC_RemoveAllDialogEntriesForSpeaker(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03);
		SetHasDialog(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, 1);
		PROC_ORI_SetupCamp((CHARACTER)S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, 1);
		PROC_CampRelationshipDialog((CHARACTER)S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03,(DIALOGRESOURCE)CAMP_Ravengard_c9e72a15-7691-102d-4f00-f20b7ab8ff95,(FLAG)FCRD_Ravengard_FirstTimeInCamp_45b556aa-f39d-45b9-889e-0bdaffaa30dc,0);
		PROC_Try_CampRelationshipDialog((CHARACTER)S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03,1);
		
		PROC
		PROC_LOW_IronThrone_MoveRavengardToCamp()
		AND
		DB_Players(_Player)
		AND
		ItemIsInPartyInventory((ITEM)S_GLO_AnsurGhost_LegendOfAnsurBook_b0ecc3d5-85ad-48fa-bc47-988107507e6c, _Player, 0, 0)
		THEN
		ToInventory((ITEM)S_GLO_AnsurGhost_LegendOfAnsurBook_b0ecc3d5-85ad-48fa-bc47-988107507e6c, S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, 1, 0, 1);
		
		//END_REGION
		
		//REGION Ravengard Camp Dialog trigger logic
		//Try start as COM - Ravengard, Wyll, Avatar - If interacted with Wyll
		QRY
		QRY_SelectCustomDialog(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		AND
		DB_GlobalFlag((FLAG)CAMP_Ravengard_State_RavengardInCamp_37309008-04cf-493c-8ca6-43034d331a8a)
		AND
		NOT DB_GlobalFlag((FLAG)END_General_State_Started_a0fd5f91-e4b3-4d01-84d3-9ff484139e99)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		AND
		QRY_GetBestAvatarForCompanion((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, 0, 1)
		AND
		DB_QRYRTN_GetBestAvatarForCompanion((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, _Avatar)
		AND
		QRY_SpeakerIsAvailable(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		AND
		QRY_SpeakerIsAvailable(_Avatar)
		THEN
		DB_SelectedDialog((DIALOGRESOURCE)CAMP_Ravengard_c9e72a15-7691-102d-4f00-f20b7ab8ff95, S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, _Avatar);
		DB_CAMP_Ravengard_DialogOngoing(1);
		
		//Try start as COM - Ravengard, Wyll, Avatar - If interacted with avatar
		QRY
		QRY_SelectCustomDialog(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, (CHARACTER)_Avatar)
		AND
		NOT DB_CAMP_Ravengard_DialogOngoing(1)
		AND
		DB_GlobalFlag((FLAG)CAMP_Ravengard_State_RavengardInCamp_37309008-04cf-493c-8ca6-43034d331a8a)
		AND
		NOT DB_GlobalFlag((FLAG)END_General_State_Started_a0fd5f91-e4b3-4d01-84d3-9ff484139e99)
		AND
		DB_Avatars(_Avatar)
		AND
		DB_InCamp((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		AND
		QRY_SpeakerIsAvailable(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		AND
		QRY_SpeakerIsAvailable(_Avatar)
		THEN
		DB_SelectedDialog((DIALOGRESOURCE)CAMP_Ravengard_c9e72a15-7691-102d-4f00-f20b7ab8ff95, S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, _Avatar);
		DB_CAMP_Ravengard_DialogOngoing(1);
		
		//Fallback to whoever initiated - Ravengard, NULL, Player
		QRY
		QRY_SelectCustomDialog(S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, _Player)
		AND
		NOT DB_CAMP_Ravengard_DialogOngoing(1)
		AND
		DB_GlobalFlag((FLAG)CAMP_Ravengard_State_RavengardInCamp_37309008-04cf-493c-8ca6-43034d331a8a)
		AND
		NOT DB_GlobalFlag((FLAG)END_General_State_Started_a0fd5f91-e4b3-4d01-84d3-9ff484139e99)
		AND
		QRY_SpeakerIsAvailable(_Player)
		THEN
		DB_SelectedDialog((DIALOGRESOURCE)CAMP_Ravengard_c9e72a15-7691-102d-4f00-f20b7ab8ff95, S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, NULL_00000000-0000-0000-0000-000000000000, _Player);
		DB_CAMP_Ravengard_DialogOngoing(1);
		
		//Clear up DB
		QRY
		QRY_SelectCustomDialog((CHARACTER)S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03, _)
		AND
		DB_CAMP_Ravengard_DialogOngoing(1)
		THEN
		NOT DB_CAMP_Ravengard_DialogOngoing(1);
		//END_REGION
		
		//REGION Teleport To Camp - Yenna
		IF
		EntityEvent((CHARACTER)S_GLO_Yenna_d496d903-d3d6-4314-a324-18542de77b0f, "DebugTeleportedToCamp")
		THEN
		PROC_ORI_SetupCamp((CHARACTER)S_GLO_Yenna_d496d903-d3d6-4314-a324-18542de77b0f, 1);
		PROC_ORI_SetupCamp((CHARACTER)S_GLO_YennasCat_6583b752-ac47-4ae9-ab9d-d75cebaf9b71, 1);
		//END_REGION
		
		//REGION Volo's trader tag
		IF
		FlagSet(_Flag,_,_)
		AND
		DB_GLO_SetTraderTagOnVolo_Flags(_Flag)
		THEN
		SetTag(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,(TAG)TRADER_91d5ebc6-91ea-44db-8a51-216860d69b5b);
		
		IF
		FlagSet(_Flag,_,_)
		AND
		DB_GLO_ClearTraderTagOnVolo_Flags(_Flag)
		THEN
		ClearTag(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,(TAG)TRADER_91d5ebc6-91ea-44db-8a51-216860d69b5b);
		//END_REGION
		
	}
	EXIT
	{
	}
}
Goal(77).Title("_Gustav_Init");
Goal(77)
{
	INIT
	{
	}
	KB
	{
		IF
		CharacterJoinedParty(_Avatar)
		AND
		IsTagged(_Avatar, AVATAR_306b9b05-1057-4770-aa17-01af21acd650, 1)
		AND
		TemplateIsInInventory((ITEMROOT)LOOT_Camp_Pack_398e7328-ce90-4c02-94a2-93341fac499a,_Avatar, 0)
		AND
		QRY_OnlyOnce("OneFreePackPerParty")
		THEN
		TemplateAddTo((ITEMROOT)LOOT_Camp_Pack_398e7328-ce90-4c02-94a2-93341fac499a, _Avatar, 1, 0);
		
		PROC
		PROC_CAMP_GiveFreeSupplies()
		AND
		GetHostCharacter(_Player)
		THEN
		TemplateAddTo((ITEMROOT)LOOT_Camp_Pack_398e7328-ce90-4c02-94a2-93341fac499a, _Player, 1, 0);
		
		IF
		TextEvent("camppack")
		THEN
		PROC_CAMP_GiveFreeSupplies();
	}
	EXIT
	{
	}
}
