		PROC
		PROC_END_GameFinale_RomanceFatesDialogues((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		DB_Avatars(S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
