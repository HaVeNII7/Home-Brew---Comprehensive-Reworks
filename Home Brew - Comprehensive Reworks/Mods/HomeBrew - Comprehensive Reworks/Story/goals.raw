		DB_PLA_TavernInvestigation_FirePuddle((TRIGGER)S_PLA_TavernInvestigation_FirePuddle_001_3f291ad3-a117-48b7-8bca-f4a01494fd82, 3, 70, 4, 7, 2.0, 0);
