		THEN
		PROC_SavegamePatch_ClearStuckWaitingForDroppedMutingStatus(_Char,"SG_DropForNonMutingDialog_Dummy",NULL_00000000-0000-0000-0000-000000000000,"GUS-303108");
		
		PROC
