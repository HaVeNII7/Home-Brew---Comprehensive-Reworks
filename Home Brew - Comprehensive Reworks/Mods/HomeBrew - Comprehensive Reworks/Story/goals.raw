		DB_QuestDef_State((FLAG)LOW_CountingHouse_Knows_StoneLordLairLocationSWDCultist_6cf33895-c356-af3c-7deb-5f2eafc0ebb5, "LOW_Guildhall", "FindTheStoneLordSWD");
		// LOW_Guildhall_DealtWithStoneLord
