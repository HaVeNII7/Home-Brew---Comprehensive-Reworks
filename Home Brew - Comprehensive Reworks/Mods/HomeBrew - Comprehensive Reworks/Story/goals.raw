	KB
	{
		IF
		LevelLoaded("BGO_Main_A")
		THEN
		SetFlag((FLAG)CURRENTREGION_BGO_Main_A_11239767-48ad-4879-8312-b9164b6e4978,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_GlobalSetFlagAndCache((FLAG)VISITEDREGION_BGO_Main_A_40f06537-814f-4796-b012-5ffaa648a8d9);
		
		IF
		LevelUnloading("BGO_Main_A")
		THEN
		ClearFlag((FLAG)CURRENTREGION_BGO_Main_A_11239767-48ad-4879-8312-b9164b6e4978,NULL_00000000-0000-0000-0000-000000000000,0);
		
		
		//REGION Debug Check camps
		
		IF
		TextEvent("CheckActiveCamp")
		AND
		DB_ActiveCamp(_Camp)
		AND
		GetHostCharacter(_Player)
		THEN
		DebugText(_Player, _Camp);
		
		IF
		TextEvent("CheckMainCamp")
		AND
		DB_MainCamp(_Level, _Camp)
		AND
		Concatenate(_Level, _Camp, _Out)
		AND
		GetHostCharacter(_Player)
		THEN
		DebugText(_Player, _Out);
		
		//END_REGION
		
		//REGION In case Volo left a note in Intermezzo and players don't have it in their inventory on entering BGO, it will appear in the camp
		IF
		DB_CurrentLevel("BGO_Main_A")
		AND
		QRY_OnlyOnce("BGO_VolosCampNoteMovedToFarmCamp_OnlyOnce")
		AND
		DB_GlobalFlag((FLAG)GLO_Volo_State_VoloLeftCampWithNote_12ff6177-2744-4040-a4a5-6e50d3801e01)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_Volo_State_PlayersFoundCampNote_5be59d18-926a-4629-ac9f-ee484ce36e73)
		THEN
		TeleportTo(S_GLO_VolosNote_LeftIntermezzo_93fd46f0-aab5-48d2-88ef-9b841b36fa1a,S_WYR_VolosNote_Camp_PointTrigger_8cade13e-3abd-4df6-900b-61e1a9b3ad38);
		//REGION
	}
	EXIT
	{
	}
}
Goal(490).Title("Act3_CAMP_ArabellaPowers");
Goal(490)
{
	INIT
	{
		PROC_CAMP_ArabellaPowers_SetUp();
		TriggerRegisterForItems(S_CAMP_ArabellaPowers_LetterBox_c58b5935-cc34-449b-9cfa-f1a1c97f0207);
		
	}
	KB
	{
		//REGION Init
		
		PROC
		PROC_CAMP_ArabellaPowers_SetUp()
		AND
		DB_CAMP_ArabellaPowers_Letter(_Letter)
		THEN
		NOT DB_CAMP_ArabellaPowers_Letter(_Letter);
		
		PROC
		PROC_CAMP_ArabellaPowers_SetUp()
		THEN
		SetOnStage((ITEM)S_CAMP_ArabellaPowers_LeaveLetter_NoQuest_cc63cd80-c6bd-472a-a51d-fdc2c11f4b82,0);
		SetOnStage((ITEM)S_CAMP_ArabellaPowers_LeaveLetter_FinishedQuest_ff17d96a-350f-4bff-a906-d5558b4bfb39,0);
		NOT DB_CAMP_ArabellaPowers_Letter((ITEM)S_CAMP_ArabellaPowers_LeaveLetter_FinishedQuest_ff17d96a-350f-4bff-a906-d5558b4bfb39);
		NOT DB_CAMP_ArabellaPowers_Letter((ITEM)S_CAMP_ArabellaPowers_LeaveLetter_NoQuest_cc63cd80-c6bd-472a-a51d-fdc2c11f4b82);
		PROC_GlobalSetFlagAndCache(CAMP_ArabellaPowers_State_LetterNear_6eb3194b-f410-4175-b64b-e4568624fc14);
		
		
		PROC
		PROC_CAMP_ArabellaPowers_SetUp()
		AND
		DB_GlobalFlag((FLAG)TWN_ArabellaPowers_State_MovedToCamp_b5f880bc-272e-e8a3-8ca1-b3dca3bce191)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)CAMP_ArabellaPowers_State_Left_f94c38bf-a76d-4236-8b66-bc1e3501ea0a);
		TriggerRegisterForPlayers(S_CAMP_ArabellaPowers_LetterBox_c58b5935-cc34-449b-9cfa-f1a1c97f0207);
		
		IF
		DB_GlobalFlag(CAMP_ArabellaPowers_State_Left_f94c38bf-a76d-4236-8b66-bc1e3501ea0a)
		AND
		DB_GlobalFlag((FLAG)TWN_ArabellasPowers_State_ToldParentsDead_cc1a3765-9334-cb88-602f-49ca052de39c)
		THEN
		SetOnStage((ITEM)S_CAMP_ArabellaPowers_LeaveLetter_FinishedQuest_ff17d96a-350f-4bff-a906-d5558b4bfb39,1);
		DB_CAMP_ArabellaPowers_Letter((ITEM)S_CAMP_ArabellaPowers_LeaveLetter_FinishedQuest_ff17d96a-350f-4bff-a906-d5558b4bfb39);
		
		IF
		DB_GlobalFlag(CAMP_ArabellaPowers_State_Left_f94c38bf-a76d-4236-8b66-bc1e3501ea0a)
		AND
		NOT DB_GlobalFlag((FLAG)TWN_ArabellasPowers_State_ToldParentsDead_cc1a3765-9334-cb88-602f-49ca052de39c)
		THEN
		SetOnStage((ITEM)S_CAMP_ArabellaPowers_LeaveLetter_NoQuest_cc63cd80-c6bd-472a-a51d-fdc2c11f4b82,1);
		DB_CAMP_ArabellaPowers_Letter((ITEM)S_CAMP_ArabellaPowers_LeaveLetter_NoQuest_cc63cd80-c6bd-472a-a51d-fdc2c11f4b82);
		QuestUpdate("TWN_FindArabellasParents", "NeverBotheredToHelp");
		
		
		//First time players get near the letter in camp, plays a perception shimmer
		IF
		EnteredTrigger(_Player, S_CAMP_ArabellaPowers_LetterBox_c58b5935-cc34-449b-9cfa-f1a1c97f0207)
		AND
		DB_CAMP_ArabellaPowers_Letter(_Letter)
		AND
		DB_Players(_Player)
		AND
		IsOnStage(_Letter, 1)
		AND
		QRY_OnlyOnce("CAMP_Arabella_LetterRevealed")
		THEN
		PROC_PlayPerceptionRevealEffect(_Letter, "CAMP_Arabella_LetterRevealed");
		
		//First time players finish reading the letter, tries to play a VB commenting on it
		IF
		GameBookInterfaceClosed(_Letter, _Player)
		AND
		DB_CAMP_ArabellaPowers_Letter(_Letter)
		AND
		DB_Players(_Player)
		AND
		QRY_OnlyOnce("CAMP_Arabella_LetterRevealedComment")
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)CAMP_ArabellasPowers_VB_ArabellaLeftLetter_16244318-c7ca-b622-8713-07b860cf3589, _Player);
		//END_REGION Init
		
		//REGION Debug
		
		IF
		TextEvent("WYR_ArabellaPowers_Reset")
		THEN
		ClearFlag(CAMP_ArabellaPowers_State_Left_f94c38bf-a76d-4236-8b66-bc1e3501ea0a,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_CAMP_ArabellaPowers_SetUp();
		
		IF
		TextEvent("WYR_ArabellaPowers_Reset")
		AND
		DB_CAMP_ArabellaPowers_Letter(_Letter)
		AND
		IsInTrigger(_Letter,S_CAMP_ArabellaPowers_LetterBox_c58b5935-cc34-449b-9cfa-f1a1c97f0207,0)
		THEN
		TeleportTo(S_CAMP_ArabellaPowers_LeaveLetter_NoQuest_cc63cd80-c6bd-472a-a51d-fdc2c11f4b82, S_CAMP_ArabellaPowers_LetterPoint_073c2329-efcd-4caf-b633-b9b6f41a0a00);
		TeleportTo(S_CAMP_ArabellaPowers_LeaveLetter_FinishedQuest_ff17d96a-350f-4bff-a906-d5558b4bfb39, S_CAMP_ArabellaPowers_LetterPoint_073c2329-efcd-4caf-b633-b9b6f41a0a00);
		
		IF
		TextEvent("WYR_ArabellaPowers_Reset_NoQuest")
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)TWN_ArabellaPowers_State_MovedToCamp_b5f880bc-272e-e8a3-8ca1-b3dca3bce191);
		ClearFlag(CAMP_ArabellaPowers_State_Left_f94c38bf-a76d-4236-8b66-bc1e3501ea0a,NULL_00000000-0000-0000-0000-000000000000,0);
		ClearFlag(CAMP_ArabellaPowers_State_JergalToldToLeave_3d22614e-8762-8aec-4537-9d50abb97b23,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_CAMP_ArabellaPowers_SetUp();
		
		IF
		TextEvent("WYR_ArabellaPowers_Reset_NoQuest")
		AND
		DB_CAMP_ArabellaPowers_Letter(_Letter)
		AND
		IsInTrigger(_Letter,S_CAMP_ArabellaPowers_LetterBox_c58b5935-cc34-449b-9cfa-f1a1c97f0207,0)
		THEN
		TeleportTo(S_CAMP_ArabellaPowers_LeaveLetter_NoQuest_cc63cd80-c6bd-472a-a51d-fdc2c11f4b82, S_CAMP_ArabellaPowers_LetterPoint_073c2329-efcd-4caf-b633-b9b6f41a0a00);
		TeleportTo(S_CAMP_ArabellaPowers_LeaveLetter_FinishedQuest_ff17d96a-350f-4bff-a906-d5558b4bfb39, S_CAMP_ArabellaPowers_LetterPoint_073c2329-efcd-4caf-b633-b9b6f41a0a00);
		
		IF
		TextEvent("WYR_ArabellaPowers_Reset_FinishedQuest")
		THEN
		ClearFlag(CAMP_ArabellaPowers_State_Left_f94c38bf-a76d-4236-8b66-bc1e3501ea0a,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_GlobalSetFlagAndCache((FLAG)CAMP_ArabellaPowers_State_JergalToldToLeave_3d22614e-8762-8aec-4537-9d50abb97b23);
		PROC_GlobalSetFlagAndCache((FLAG)TWN_ArabellaPowers_State_MovedToCamp_b5f880bc-272e-e8a3-8ca1-b3dca3bce191);
		PROC_CAMP_ArabellaPowers_SetUp();
		
		IF
		TextEvent("WYR_ArabellaPowers_Reset_FinishedQuest")
		AND
		DB_CAMP_ArabellaPowers_Letter(_Letter)
		AND
		IsInTrigger(_Letter,S_CAMP_ArabellaPowers_LetterBox_c58b5935-cc34-449b-9cfa-f1a1c97f0207,0)
		THEN
		TeleportTo(S_CAMP_ArabellaPowers_LeaveLetter_NoQuest_cc63cd80-c6bd-472a-a51d-fdc2c11f4b82, S_CAMP_ArabellaPowers_LetterPoint_073c2329-efcd-4caf-b633-b9b6f41a0a00);
		TeleportTo(S_CAMP_ArabellaPowers_LeaveLetter_FinishedQuest_ff17d96a-350f-4bff-a906-d5558b4bfb39, S_CAMP_ArabellaPowers_LetterPoint_073c2329-efcd-4caf-b633-b9b6f41a0a00);
		
		PROC
		PROC_CAMP_ArabellaPowers_SetUp()
		AND
		DB_Players(_Player)
		AND
		GetFlag(CAMP_Jergal_Event_AskedArabella_0d9ad81b-4209-6275-e2fa-1d430c456491,_Player,1)
		THEN
		ClearFlag(CAMP_Jergal_Event_AskedArabella_0d9ad81b-4209-6275-e2fa-1d430c456491,_Player,0);
		
		IF
		FlagSet((FLAG)LOW_ArabellasPowers_Act3_DebugSetup_58ce4b16-5e93-44b0-ab9d-60436d75b19c, _, _)
		THEN
		PROC_CAMP_ArabellaPowers_SetUp();
		PROC_GlobalClearFlagAndCache((FLAG)LOW_ArabellasPowers_Act3_DebugSetup_58ce4b16-5e93-44b0-ab9d-60436d75b19c);
		
		
		//END_REGION Debug
		
		//REGION Letter flag handling
		
		IF
		FlagSet((FLAG)CAMP_ArabellaPowers_Event_CheckLetter_e1f9904f-6703-46fc-b61c-3efdea312bcb,_,_)
		THEN
		ClearFlag(CAMP_ArabellaPowers_Event_CheckLetter_e1f9904f-6703-46fc-b61c-3efdea312bcb,NULL_00000000-0000-0000-0000-000000000000,0);
		ClearFlag(CAMP_ArabellaPowers_State_LetterNear_6eb3194b-f410-4175-b64b-e4568624fc14,NULL_00000000-0000-0000-0000-000000000000,0);
		
		IF
		FlagSet((FLAG)CAMP_ArabellaPowers_Event_CheckLetter_e1f9904f-6703-46fc-b61c-3efdea312bcb,_,_)
		AND
		DB_CAMP_ArabellaPowers_Letter(_Letter)
		AND
		IsInTrigger(_Letter,S_CAMP_ArabellaPowers_LetterBox_c58b5935-cc34-449b-9cfa-f1a1c97f0207,1)
		THEN
		DebugText(_Letter,"In box");
		SetFlag((FLAG)CAMP_ArabellaPowers_State_LetterNear_6eb3194b-f410-4175-b64b-e4568624fc14,NULL_00000000-0000-0000-0000-000000000000,0);
		
		IF
		TextEvent("CAMP_ArabellaPowers_CheckLetter")
		THEN
		SetFlag((FLAG)CAMP_ArabellaPowers_Event_CheckLetter_e1f9904f-6703-46fc-b61c-3efdea312bcb,NULL_00000000-0000-0000-0000-000000000000,0);
		
		IF
		FlagSet((FLAG)CAMP_ArabellaPowers_Event_GiveLetter_196c08cf-a89c-5a62-de9b-c9fd25cf0e19, _Player, _)
		AND
		DB_CAMP_ArabellaPowers_Letter((ITEM)_Letter)
		THEN
		ToInventory(_Letter,_Player,1,1,1);
		
		//END_REGION Letter flag handling
	}
	EXIT
	{
	}
}
