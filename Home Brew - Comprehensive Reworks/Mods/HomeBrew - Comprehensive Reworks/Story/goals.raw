		DB_ItemOwnerShipTriggers("WLD_Main_A",S_GOB_Quartermaster_OwnershipTrigger_d7721e24-de44-4ec8-b388-522bfd5e8d79,S_GOB_Quartermaster_646936f3-8d8d-484e-9361-cd1ed484c615);
		DB_TrespassTrigger((TRIGGER)S_GOB_Quartermaster_ForbiddenArea_bb26fde1-2c83-4ecd-8d7c-305e52666bbc,S_GOB_Quartermaster_OutStorageTrigger_e5462b9f-9c27-4cda-91ab-6117693cc156);
		
		DB_GOB_GoblinLeadersDeadVB((CHARACTER)S_GOB_GoblinPriest_b983c336-9a14-4e9b-adb9-4689e7e0afa9, (VOICEBARKRESOURCE)GOB_GoblinHunt_VB_KilledPriestess_083b8527-4c82-15e8-4903-227c92745c10);
		DB_GOB_GoblinLeadersDeadVB(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, GOB_GoblinHunt_VB_KilledDrow_8a6f62bf-413f-6ac9-fdd6-af782150ec65);
		//DB_GOB_GoblinLeadersDeadVB_Played((CHARACTER)_Leader, (GUIDSTRING)_CombatID)
	}
	KB
	{
		IF
		DB_GlobalFlag((FLAG)GOB_GoblinThroneGeneral_State_Swept_02190656-f3c7-4ef9-beb2-5a8033a84a2e)
		AND
		DB_GlobalFlag((FLAG)GOB_WarMapArea_State_Swept_73aa9614-8c08-4b17-add8-216f71a90eec) // flagType: Global
		AND
		DB_GlobalFlag((FLAG)GOB_BrandingParty_State_Swept_a1a3ee9e-1379-4e51-9c2f-74f316ffff10) // flagType: Global
		AND
		DB_GlobalFlag((FLAG)GOB_ScryingRoom_State_Swept_d73219ec-1bf2-46d8-8d55-33a0643324c9) // flagType: Global
		AND
		DB_GlobalFlag((FLAG)GOB_WolfPens_Backup_State_Swept_92fcadbe-e200-8686-a334-1fd1829eaea9) // flagType: Global
		THEN
		SetFlag((FLAG)GOB_GoblinThroneArea_State_Swept_fd04a298-0efd-48c5-99a1-d3ded1b6fb66,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_CorpseLooting_ClearRedOutlinesForDefeatCounter("GOB_GoblinThroneGeneral");
		PROC_CorpseLooting_ClearRedOutlinesForDefeatCounter("GOB_WarMapArea");
		PROC_CorpseLooting_ClearRedOutlinesForDefeatCounter("GOB_BrandingParty");
		PROC_CorpseLooting_ClearRedOutlinesForDefeatCounter("GOB_GoblinKing_ScryingRoom");
		PROC_CorpseLooting_ClearRedOutlinesForDefeatCounter("GOB_WolfPens_Backup");
		PROC_CorpseLooting_NoRedOutline("WLD_Main_A",(CHARACTER)S_GOB_GoblinHeretic_3af8a55b-903a-43cd-84d3-9cb7ca8f69de);
		
		QRY
		QRY_SelectCustomDialog_AfterGenerics(_Goblin,_Player)
		AND
		DB_GLO_DefeatCounter((CHARACTER)_Goblin, "GOB_BrandingParty")
		AND
		NOT DB_PermaDefeated(_Goblin)
		AND
		GetFlag((FLAG)GOB_GoblinBranding_GettingBrand_ad1413b8-71bb-4542-b863-e13fd4fc8e85,_Goblin,1)
		THEN
		DB_SelectedDialog((DIALOGRESOURCE)GOB_BrandingGoblins_AD_Busy_2db5deb3-0636-b7e9-b720-519c8654e3e5,_Goblin);
		
		IF
		EnteredTrigger(_Player,S_GOB_ThroneRoom_SUB_bb81678b-641c-43fc-bd41-53295d59be03)
		AND
		DB_Players(_Player)
		AND
		NOT DB_GlobalFlag(GOB_GoblinThrone_Event_Entered_88523974-c85f-4be5-8317-4bc62b3e3cf9)
		THEN
		SetFlag(GOB_GoblinThrone_Event_Entered_88523974-c85f-4be5-8317-4bc62b3e3cf9,NULL_00000000-0000-0000-0000-000000000000,0);
		
		IF
		DB_GlobalFlag(GOB_GoblinThrone_Event_Entered_88523974-c85f-4be5-8317-4bc62b3e3cf9)
		AND
		NOT DB_GlobalFlag(GLO_GoblinCamp_EverEnteredBefore_7a0172dd-df95-448a-aa2e-a04acdf7eabe)
		THEN
		PROC_GlobalSetFlagAndCache(GLO_GoblinCamp_EverEnteredBefore_7a0172dd-df95-448a-aa2e-a04acdf7eabe);
		
		IF
		DestroyedBy(_Wall, _, _, _)
		AND
		DB_GOB_FestivSleepers_Wall(_Wall)
		THEN
		SetFlag((FLAG)GOB_Festivities_Event_SecretWallDestroyed_9659d067-f867-4352-977d-b63ffba6ff44, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		PROC
		PROC_BlockUseOfItem(_Character, (ITEM)S_GOB_GoblinThrone_SecretEntrance_LadderFrom_1e4c968c-370c-4c8d-a074-ab227d85b28d)
		AND
		NOT DB_GlobalFlag((FLAG)GOB_Festivities_Event_SecretWallDestroyed_9659d067-f867-4352-977d-b63ffba6ff44)
		THEN
		DB_CustomUseItemResponse(_Character, (ITEM)S_GOB_GoblinThrone_SecretEntrance_LadderFrom_1e4c968c-370c-4c8d-a074-ab227d85b28d, 0);
		
		PROC
		PROC_BlockUseOfItem(_Character, (ITEM)S_GOB_GoblinThrone_SecretEntrance_LadderFrom_1e4c968c-370c-4c8d-a074-ab227d85b28d)
		AND
		NOT DB_GlobalFlag((FLAG)GOB_Festivities_Event_SecretWallDestroyed_9659d067-f867-4352-977d-b63ffba6ff44)
		AND
		DB_Players(_Character)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)GOB_GoblinThrone_PAD_SecretHatchBlocked_eff1764d-3b63-f8ec-c523-d544fd9f76aa, _Character);
		
		//REGION Voice Barks on leaders kill
		IF
		CombatEnded(_CombatGUID)
		AND
		DB_GOB_GoblinLeadersDeadVB((CHARACTER)_Leader, (VOICEBARKRESOURCE)_VoiceBark)
		AND
		DB_Was_InCombat(_Leader, _CombatGUID)
		AND
		DB_PermaDefeated(_Leader)
		AND
		NOT DB_GOB_GoblinLeadersDeadVB_Played(_, _CombatGUID)
		AND
		NOT DB_GOB_GoblinLeadersDeadVB_Played(_Leader, _)
		AND
		NOT DB_PartOfTheTeam(_Leader)
		AND
		GetClosestAlivePlayer(_Leader, (CHARACTER)_Player, _)
		AND
		NOT DB_CantTalk(_Player)
		THEN
		DB_GOB_GoblinLeadersDeadVB_Played(_Leader, _CombatGUID);
		StartVoiceBark(_VoiceBark, _Player);
		
		IF
		Dying(_Leader)
		AND
		DB_GOB_GoblinLeadersDeadVB((CHARACTER)_Leader, (VOICEBARKRESOURCE)_VoiceBark)
		AND
		NOT DB_Is_InCombat((CHARACTER)_Leader, _)
		AND
		NOT DB_GOB_GoblinLeadersDeadVB_Played(_Leader, _)
		AND
		NOT DB_PartOfTheTeam(_Leader)
		AND
		GetClosestAlivePlayer(_Leader, (CHARACTER)_Player, _)
		AND
		NOT DB_CantTalk(_Player)
		THEN
		DB_GOB_GoblinLeadersDeadVB_Played(_Leader, NULL_00000000-0000-0000-0000-000000000000);
		StartVoiceBark(_VoiceBark, _Player);
		//END_REGION Voice Barks on leaders kill
		
		//REGION Party Banter for the Throne Room
		PROC
		PROC_LongRest()
		AND
		DB_GlobalFlag(GOB_GoblinThroneArea_State_Swept_fd04a298-0efd-48c5-99a1-d3ded1b6fb66)
		AND
		DB_GlobalFlag(GOB_State_LeadersAreDead_a1c5b01f-4b7f-47ab-82b0-d24d9c6d8bc6)
		AND
		QRY_OnlyOnce("GOB_ThroneRoom_RegisterPartyBanter")
		THEN
		PROC_RegisterWorldGossipTrigger((TRIGGER)S_PartyBanterTrigger_GOB_TempleCleared_f4edd556-60f8-444d-ae39-e67a5b4e01c6);
		//END_REGION Party Banter for the Throne Room
	}
	EXIT
	{
	}
}
