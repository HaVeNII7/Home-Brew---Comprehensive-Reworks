		THEN
		SetFlag((FLAG)HAG_Hagspawn_State_SurrogateKnowsHusbandDead_f85f6f81-d1bd-f70b-a447-cee4478c302f, S_HAG_Hagspawn_SurrogateMother_08c970d7-3138-45e8-8965-68eadf4b07cd); // flagType: Object
		
		IF
