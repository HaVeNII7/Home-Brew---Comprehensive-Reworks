		AND
		IsForceUpdate(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,1)
		THEN
		SetForceUpdate(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,0);
		DB_BUGFIX_Marker("GUS-310761_VoloForceUpdate");
		
