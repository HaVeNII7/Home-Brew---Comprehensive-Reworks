		DB_Debug_ORI_Gale_GiveMagicItem((ITEM)S_GOB_SeluneGaleItem_453a4bff-7780-432c-a9cd-4b1a43424ccf, (FLAG)Debug_ORI_Gale_Event_GiveAmulet_e12dbd5b-246d-14a6-8aa3-b83c59f3ca91);
		
		DB_Debug_TeleportFlags((FLAG)Debug_ORI_Gale_Event_GoToElminsterSCL_1e295ff5-e7dc-c649-eafc-383fd6be734e, (TRIGGER)S_ORI_Gale_ElminsterPoint_SCL_975ef355-b68e-4061-bda8-b774e8ff552f);
		DB_Debug_TeleportFlags((FLAG)Debug_ORI_Gale_Event_GoToElminsterCRE_6253c3ec-d18b-b858-4bfa-22e7ee4a3236, (TRIGGER)S_ORI_Gale_ElminsterPoint_CRE_f5a225ef-d123-449f-98e2-53309a21979b);
		
		DB_Debug_TeleportFlags((FLAG)Debug_Teleport_ZhentDungeonEntrance_2f3406a9-c17c-7f1b-6c97-96e17db65cb6, S_Debug_ZhentarimDungeon_Entrance_5ccb993e-7194-4b52-bae1-52cbd2554c11);
