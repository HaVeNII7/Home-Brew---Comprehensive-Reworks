		IF
		DB_GlobalFlag((FLAG)SHA_LastJusticiar_State_PlayerTruce_1d54b03b-926a-c36d-7480-e29659f6c506)
		AND
		NOT DB_DialogName((DIALOGRESOURCE)SHA_LastJusticiar_RatsNegotiate_592f63db-b2b3-9383-9160-1643321f02ce, _)
		AND
		DB_GlobalFlag((FLAG)SHA_LastJusticiar_State_SharedTreasure_bbd04557-5cae-4802-aa7e-9cb86af7b698)
		AND
		DB_SHA_LastJusticiar_KnowledgeFlag(_KnowledgeFlag)
		AND
		DB_GlobalFlag(_KnowledgeFlag)
		THEN
		QuestUpdate("SHA_OldEnemy", "RatDeal");
		
		IF
		DB_GlobalFlag((FLAG)SHA_LastJusticiar_State_PlayerTruce_1d54b03b-926a-c36d-7480-e29659f6c506)
		AND
		NOT DB_DialogName((DIALOGRESOURCE)SHA_LastJusticiar_RatsNegotiate_592f63db-b2b3-9383-9160-1643321f02ce, _)
		AND
		NOT DB_GlobalFlag((FLAG)SHA_LastJusticiar_State_SharedTreasure_bbd04557-5cae-4802-aa7e-9cb86af7b698)
		AND
		DB_SHA_LastJusticiar_KnowledgeFlag(_KnowledgeFlag)
		AND
		DB_GlobalFlag(_KnowledgeFlag)
		THEN
		QuestUpdate("SHA_OldEnemy", "RatPacifism");
		
		//END_REGION
		
		//REGION SHA_Nightsong
		IF
		DialogStarted(SHA_NightsongPrison_NightsongsFate_309684a3-b0e7-9a5b-68fb-63c802c2240c, _)
		THEN
		QuestUpdate("SHA_Nightsong", "NightsongIsAPersonPrison");
		
		IF
		DialogStarted(SHA_NightsongPrison_NecroAndNightsong_500474d5-3855-9b12-29d1-b6e7645d7385, _)
		THEN
		QuestUpdate("SHA_Nightsong", "NightsongIsAPersonPrison");
		
		IF
		DialogEnded(SHA_NightsongPrison_NecroAndNightsong_500474d5-3855-9b12-29d1-b6e7645d7385, _)
		AND
		DB_GlobalFlag(SHA_NightsongPrison_Event_NightsongSentToMoonrise_685b9761-43b6-9004-8655-073096c62731)
		THEN
		QuestUpdate("SHA_Nightsong", "NightsongWithBalthazar");
		QuestSetCategory("SHA_Nightsong", "BaldursGate");
		
		IF
		DialogStarted(SHA_NightsongsFate_OM_Shadowheart_AOM_OOM_COM_7c1dc5a3-0410-ebf4-3b3b-b2ee753562db, _)
		THEN
		QuestUpdate("SHA_Nightsong", "NightsongIsAPersonPrison");
		
		IF
		FlagSet(SHA_NightsongPrison_Event_StartNightsongFreedDialog_737d8c1e-7970-2c6c-06ec-8ccb3a9bf25e, _, _)
		THEN
		QuestUpdate("SHA_Nightsong", "NightsongFreed");
		QuestSetCategory("SHA_Nightsong", "BaldursGate");
		
		IF
		FlagSet(SHA_NightsongPrison_State_ShadowheartKilledNightsong_3cac3cd6-4c16-44a6-8246-a91922821169, _, _)
		THEN
		QuestUpdate("SHA_Nightsong","NightsongDead");
		
		//END_REGION
	}
	EXIT
	{
	}
}
