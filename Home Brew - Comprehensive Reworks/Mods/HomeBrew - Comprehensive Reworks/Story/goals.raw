	}
	KB
	{
		//REGION RegionFlag
		
		IF
		LevelLoaded("SCL_Main_A")
		THEN
		SetFlag((FLAG)CURRENTREGION_SCL_Main_A_f76b85b5-b557-4409-98fd-cc7b22f8292b,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_GlobalSetFlagAndCache((FLAG)VISITEDREGION_SCL_Main_A_f6e72539-9bc6-42e1-a20f-390f3a17ad8d);
		
		IF
		LevelUnloading("SCL_Main_A")
		THEN
		ClearFlag((FLAG)CURRENTREGION_SCL_Main_A_f76b85b5-b557-4409-98fd-cc7b22f8292b,NULL_00000000-0000-0000-0000-000000000000,0);
		
		//END_REGION
		
		//REGION Specific Night Logic
		
		//NIGHT_SchoolOgreDebtCollection
		PROC
		PROC_CampNight_StartSleepMoments_PreHook()
		AND
		DB_Camp_QueuedNight((FLAG)NIGHT_SchoolOgreDebtCollection_d68c6cc5-22f8-41de-ab0c-5edd6c3df4a2)
		AND
		QRY_OnlyOnce("NIGHT_SchoolOgreDebtCollection_SummonOgresToCamp")
		THEN
		PROC_SchoolOgreDebtCollection_SpawnOgres();
		
		PROC
		PROC_SchoolOgreDebtCollection_SpawnOgres()
		AND
		DB_FOR_SchoolOgres(_Ogre)
		AND
		DB_CurrentLevel(_Level)
		AND
		DB_Daisy_IdleTeleport(_Level, _TeleportPosition)
		THEN
		DB_FOR_SchoolOgres_SpawnNext(_Ogre);
		TeleportTo(_Ogre, _TeleportPosition); // Teleport to level so cinematic can start
		
		PROC
		PROC_SchoolOgreDebtCollection_SpawnOgres()
		THEN
		PROC_SchoolOgreDebtCollection_SpawnNextOgre();
		
		// Iterate over DB_FOR_SchoolOgres_SpawnNext
		PROC
		PROC_SchoolOgreDebtCollection_SpawnNextOgre()
		AND
		QRY_OnlyOnce_Reset("CAMP_SchoolOgreDebtCollection_SpawnOgres")
		AND
		DB_FOR_SchoolOgres_SpawnNext(_Ogre)
		AND
		QRY_OnlyOnce("CAMP_SchoolOgreDebtCollection_SpawnOgres")
		AND
		DB_ActiveCamp(_ActiveCamp)
		AND
		DB_Camp(_ActiveCamp,_CampFire,_,_Entrypoint)
		AND
		GetPosition(_Entrypoint, _EntryX, _EntryY, _EntryZ)
		AND
		FindValidPosition(_EntryX, _EntryY, _EntryZ, 5.0, _Ogre, 1, _X, _Y, _Z)
		THEN
		TeleportToPosition(_Ogre, _X, _Y, _Z, "CAMP_SchoolOgreDebtCollection_OgreTeleported", 0, 0, 0, 0, 1);
		
		IF
		EntityEvent(_Ogre, "CAMP_SchoolOgreDebtCollection_OgreTeleported")
		THEN
		PROC_Foop(_Ogre);
		ObjectTimerLaunch(_Ogre, "CAMP_SchoolOgreDebtCollection_SpawnNextOgre", 100, 1);
		
		IF
		ObjectTimerFinished(_Ogre, "CAMP_SchoolOgreDebtCollection_SpawnNextOgre")
		THEN
		NOT DB_FOR_SchoolOgres_SpawnNext((CHARACTER)_Ogre);
		PROC_SchoolOgreDebtCollection_SpawnNextOgre();
		
		// Make ogres look at player after they are all spawned
		PROC
		PROC_SchoolOgreDebtCollection_SpawnNextOgre()
		AND
		NOT DB_FOR_SchoolOgres_SpawnNext(_)
		THEN
		PROC_SchoolOgreDebtCollection_LookAtPlayers();
		
		PROC
		PROC_SchoolOgreDebtCollection_LookAtPlayers()
		AND
		QRY_SchoolOgreDebtCollection_GetNearestPlayer()
		AND
		DB_QRTN_SchoolOgreDebtCollection_GetNearestPlayer(_Player, _)
		AND
		DB_FOR_SchoolOgres(_Ogre)
		THEN
		LookAtEntity(_Ogre, _Player, 1.0);
		
		QRY
		QRY_SchoolOgreDebtCollection_GetNearestPlayer()
		AND
		QRY_OnlyOnce_Reset("SchoolOgreDebtCollection_GetNearestPlayer")
		AND
		DB_FOR_SchoolOgres(_Ogre)
		AND
		QRY_OnlyOnce("SchoolOgreDebtCollection_GetNearestPlayer")
		AND
		DB_Players((CHARACTER)_Player)
		AND
		NOT DB_Defeated(_Player)
		AND
		GetDistanceTo(_Ogre, _Player, _Dist)
		THEN
		DB_QRTN_SchoolOgreDebtCollection_GetNearestPlayer(_Player, _Dist);
		
		IF
		DB_QRTN_SchoolOgreDebtCollection_GetNearestPlayer(_Player1, _Distance1)
		AND
		DB_QRTN_SchoolOgreDebtCollection_GetNearestPlayer(_Player2, _Distance2)
		AND
		_Distance1 < _Distance2
		THEN
		NOT DB_QRTN_SchoolOgreDebtCollection_GetNearestPlayer(_Player2, _Distance2);
		
		PROC
		PROC_CampNight_StartSleepMoments_PreHook()
		AND
		DB_Camp_QueuedNight((FLAG)NIGHT_SchoolOgreDebtCollection_d68c6cc5-22f8-41de-ab0c-5edd6c3df4a2)
		AND
		DB_DialogMoneyTransfer(_Index,(DIALOGRESOURCE)FOR_SchoolOgres_AfterSummon_5b0c1ee3-697c-7eeb-9370-5a70479bcc48,_Amount)
		THEN
		DB_DialogMoneyTransfer(_Index,(DIALOGRESOURCE)CAMP_SchoolOgres_CFM_DebtCollection_540ada29-3bb9-3566-301a-bce583ad0eb5,_Amount);
		
		QRY
		QRY_Camp_SleepCutsceneOverride_CustomDialogStart((DIALOGRESOURCE)CAMP_SchoolOgres_CFM_DebtCollection_540ada29-3bb9-3566-301a-bce583ad0eb5,_Player,_Player2,_Player3,_Player4)
		AND
		GetOwner((ITEM)S_FOR_SchoolOgres_Horn_9d83c0b2-a14d-4f46-af49-67938cff4c8b,_HornOwner)
		AND
		_HornOwner != NULL_00000000-0000-0000-0000-000000000000
		THEN
		PROC_SchoolOgres_CFM_DebtCollection_Dialog(_HornOwner,_Player,_Player2,_Player3,_Player4);
		
		QRY
		QRY_Camp_SleepCutsceneOverride_CustomDialogStart((DIALOGRESOURCE)CAMP_SchoolOgres_CFM_DebtCollection_540ada29-3bb9-3566-301a-bce583ad0eb5,_Player,_Player2,_Player3,_Player4)
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)CAMP_SchoolOgres_CFM_DebtCollection_540ada29-3bb9-3566-301a-bce583ad0eb5,S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f, _Player,_Player2,_Player3,_Player4)
		THEN
		DB_Camp_PreventEndOfNight(1);
		
		QRY
		QRY_Camp_SleepCutsceneOverride_CustomDialogStart((DIALOGRESOURCE)CAMP_SchoolOgres_CFM_DebtCollection_540ada29-3bb9-3566-301a-bce583ad0eb5,_Player,_Player2,_Player3,_Player4)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_SchoolOgres_CFM_DebtCollection_Dialog((CHARACTER)_HornOwner,(CHARACTER)_Player,(CHARACTER)_HornOwner,(CHARACTER)_Player3,(CHARACTER)_Player4)
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)CAMP_SchoolOgres_CFM_DebtCollection_540ada29-3bb9-3566-301a-bce583ad0eb5,S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f, _HornOwner,_Player,_Player3,_Player4)
		THEN
		DB_Camp_PreventEndOfNight(1);
		
		PROC
		PROC_SchoolOgres_CFM_DebtCollection_Dialog((CHARACTER)_HornOwner,(CHARACTER)_Player,(CHARACTER)_Player2,(CHARACTER)_HornOwner,(CHARACTER)_Player4)
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)CAMP_SchoolOgres_CFM_DebtCollection_540ada29-3bb9-3566-301a-bce583ad0eb5,S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f, _HornOwner,_Player,_Player2,_Player4)
		THEN
		DB_Camp_PreventEndOfNight(1);
		
		PROC
		PROC_SchoolOgres_CFM_DebtCollection_Dialog((CHARACTER)_HornOwner,(CHARACTER)_Player,(CHARACTER)_Player2,(CHARACTER)_Player3,(CHARACTER)_HornOwner)
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)CAMP_SchoolOgres_CFM_DebtCollection_540ada29-3bb9-3566-301a-bce583ad0eb5,S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f, _HornOwner,_Player,_Player2,_Player3)
		THEN
		DB_Camp_PreventEndOfNight(1);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)CAMP_SchoolOgres_CFM_DebtCollection_540ada29-3bb9-3566-301a-bce583ad0eb5,_Inst)
		AND
		DB_FOR_SchoolOgres(_Ogre)
		AND
		_Ogre != S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f
		AND
		QRY_SpeakerIsAvailable(_Ogre)
		THEN
		PROC_DialogAddSpeakingActor(_Inst,_Ogre);
		
		IF
		DialogEnded((DIALOGRESOURCE)CAMP_SchoolOgres_CFM_DebtCollection_540ada29-3bb9-3566-301a-bce583ad0eb5,_)
		AND
		DB_GlobalFlag((FLAG)FOR_SchoolOgres_Event_AggroOnPlayer_e87b2a42-1470-d04a-621b-7c6e5f54b000)
		AND
		GetFaction((CHARACTER)S_FOR_SchoolOgre1_848b6f10-3ae5-41f6-b1a1-98c34a19ba3f,_Faction)
		THEN
		PROC_SetRelationToPlayers(_Faction,0);
		
		IF
		DialogEnded((DIALOGRESOURCE)CAMP_SchoolOgres_CFM_DebtCollection_540ada29-3bb9-3566-301a-bce583ad0eb5,_)
		AND
		NOT DB_GlobalFlag((FLAG)FOR_SchoolOgres_Event_AggroOnPlayer_e87b2a42-1470-d04a-621b-7c6e5f54b000)
		AND
		DB_FOR_SchoolOgres(_Ogre)
		THEN
		PROC_DisappearOutOfSight(_Ogre,"Run",1,"GEN_GoOffStage");
		
		PROC
		PROC_Camp_DebugQNight_ForceRequirements((FLAG)NIGHT_SchoolOgreDebtCollection_d68c6cc5-22f8-41de-ab0c-5edd6c3df4a2)
		THEN
		SetFlag((FLAG)FOR_SchoolOgres_State_AfterSummoning_2xDeal_b2514b10-63d3-8107-2348-904948d682c3,NULL_00000000-0000-0000-0000-000000000000,0);
		
		//NIGHT_ShadowheartEpilogue
		PROC
		PROC_CampNight_StartSleepMoments_PreHook()
		AND
		DB_Camp_QueuedNight((FLAG)NIGHT_NightsongShadowheartVisit_5cf06d9e-44ce-4431-a1c6-839bfdad5f79)
		AND
		DB_ActiveCamp(_ActiveCamp)
		AND
