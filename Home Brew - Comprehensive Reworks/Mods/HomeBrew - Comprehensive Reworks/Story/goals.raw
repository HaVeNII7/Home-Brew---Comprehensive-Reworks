		DB_InCamp((CHARACTER)S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211)
		THEN
		PROC_DisappearOutOfSight((CHARACTER)S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211, "Walk", 1, "GEN_GoOffStage");
		
		IF
		DialogEnded((DIALOGRESOURCE)CAMP_NightsongShadowheartVisit_CFM_3327ccbc-a1c6-47ee-05ac-e735523036a5, _)
		AND
		DB_GlobalFlag((FLAG)ORI_Shadowheart_State_WolfDreamReveal_b3600a36-8b9f-46b0-86f7-f7780b51bc93)
		AND
		NOT DB_GlobalFlag((FLAG)SCE_IsobelNightsongReunion_JoiningCamp_cea17782-fc15-19d3-e658-7f2f955ebd9f)
		AND
		DB_InCamp((CHARACTER)S_GLO_Nightsong_6c55edb0-901b-4ba4-b9e8-3475a8392d9b)
		THEN
		PROC_DisappearOutOfSight((CHARACTER)S_GLO_Nightsong_6c55edb0-901b-4ba4-b9e8-3475a8392d9b, "Walk", 1, "GEN_GoOffStage");
		
		PROC
		PROC_CampNight_StartMorningMoments()
		AND
		DB_GlobalFlag((FLAG)CAMP_Shadowheart_State_HadNightsongMeeting_10b74e80-a963-420f-8c2a-d518b6aae143)
		AND
		QRY_OnlyOnce("ORI_Shadowheart_CRD_NightsongVisitHappened")
		THEN
		PROC_CampRelationshipDialog((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679, (DIALOGRESOURCE)ShadowHeart_InParty_95ca3833-09d0-5772-b16a-c7a5e9208fe5, 0);
		PROC_Try_CampRelationshipDialog((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679, 1); 
		
		
		//REGION Karlach romance Act 2
		PROC
		PROC_CampNight_StartSelected()
		AND
		DB_Camp_QueuedNight(NIGHT_Karlach_TheForgingOfTheHeart_0d3a46b9-074c-4d71-aa11-ff078e8017b5)
		AND
		DB_ORI_Dating(_, (CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		SetFlag((FLAG)ORI_Karlach_State_RomanceSceneInProgress_cbce4176-b581-4fd8-8abb-1d2421a79741, NULL_00000000-0000-0000-0000-000000000000);
		
		PROC
		PROC_Camp_EveryoneWakeupEndHook()
		AND
		DB_GlobalFlag((FLAG)ORI_Karlach_State_RomanceSceneInProgress_cbce4176-b581-4fd8-8abb-1d2421a79741)
		THEN
		ClearFlag((FLAG)ORI_Karlach_State_RomanceSceneInProgress_cbce4176-b581-4fd8-8abb-1d2421a79741, NULL_00000000-0000-0000-0000-000000000000);
		
		// Rejected during CRD.
		IF
		FlagCleared((FLAG)ORI_State_DatingKarlach_f24c3f3e-7287-4908-84bf-ba314921f5ee, _, _DialogID)
		AND
		DB_DialogName(CAMP_Karlach_CRD_ForgingOfTheHeart_57604b76-d93e-053c-2b9c-e53c747b684f, _DialogID)
		THEN
		ClearFlag((FLAG)ORI_Karlach_State_RomanceSceneInProgress_cbce4176-b581-4fd8-8abb-1d2421a79741, NULL_00000000-0000-0000-0000-000000000000);
		
		//Morning after CRD
		PROC
		PROC_CampNight_LastDialogPlayed()
		AND
		DB_Camp_QueuedNight((FLAG)NIGHT_Karlach_TheForgingOfTheHeart_0d3a46b9-074c-4d71-aa11-ff078e8017b5)
		AND
		DB_CampNight_Completed((FLAG)NIGHT_Karlach_TheForgingOfTheHeart_0d3a46b9-074c-4d71-aa11-ff078e8017b5)
		AND
		DB_ORI_Partnered(_, (CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		QRY_OnlyOnce("ORI_Karlach_MorningAfterAct2Romance")
		THEN
		PROC_RelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)CAMP_Karlach_CRD_MorningAfterRomance_7358a107-7d24-830b-8735-9235a57e1eb2, (FLAG)NULL_00000000-0000-0000-0000-000000000000, S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 1);
		//END_REGION Karlach romance Act 2
		
		//END_REGION
		
		//REGION Dark Urge camp definitions
		
		IF
		DB_ORI_DarkUrge((CHARACTER)_DarkUrge)
		AND
		DB_ORI_DarkUrge_SetupNights("Act2")
		THEN
		//NIGHT_DarkUrge_IsobelKillOrder
		DB_CampNight((FLAG)NIGHT_DarkUrge_IsobelKillOrder_52916fa3-a23e-43b3-af5e-a41875ce7f47,6170);
		DB_CampNight_Camp((FLAG)NIGHT_DarkUrge_IsobelKillOrder_52916fa3-a23e-43b3-af5e-a41875ce7f47,"SCLMAIN");
		DB_CampNight_Camp((FLAG)NIGHT_DarkUrge_IsobelKillOrder_52916fa3-a23e-43b3-af5e-a41875ce7f47,"SHARTEMPLE");
		DB_CampNight_Camp((FLAG)NIGHT_DarkUrge_IsobelKillOrder_52916fa3-a23e-43b3-af5e-a41875ce7f47,"MOONRISE");
		DB_CampNight_Camp((FLAG)NIGHT_DarkUrge_IsobelKillOrder_52916fa3-a23e-43b3-af5e-a41875ce7f47,"HAVEN");
		DB_CampNight_Requirement((FLAG)NIGHT_DarkUrge_IsobelKillOrder_52916fa3-a23e-43b3-af5e-a41875ce7f47, (FLAG)NIGHT_DarkUrge_ButlerIntro_e3dc106b-02f0-41ef-9642-ed7ccf971248, (FLAG)DARKURGE_68888003-acaa-49d5-b4f2-0c6293797e59);
		DB_CampNight_SoloDream((FLAG)NIGHT_DarkUrge_IsobelKillOrder_52916fa3-a23e-43b3-af5e-a41875ce7f47,(CHARACTER)_DarkUrge,(DIALOGRESOURCE)CAMP_DarkUrge_IsobelKillOrder_SD_1ef2be30-aa20-4883-f5f0-da671f215af9);
		DB_CampNight_CancelledBy(NIGHT_DarkUrge_IsobelKillOrder_52916fa3-a23e-43b3-af5e-a41875ce7f47, (FLAG)SHA_NightsongPrison_State_NightsongFateDecided_4a61bbda-83ef-2738-e366-d3d3a4fa75e3);
		DB_CampNight_CancelledBy(NIGHT_DarkUrge_IsobelKillOrder_52916fa3-a23e-43b3-af5e-a41875ce7f47, (FLAG)MOO_Isobel_State_AtMoonrise_a95b7f8f-1454-433f-a496-71c9306683ce);
		DB_CampNight_CancelledBy(NIGHT_DarkUrge_IsobelKillOrder_52916fa3-a23e-43b3-af5e-a41875ce7f47, (FLAG)ORI_DarkUrge_KilledIsobel_Requirement_b19523f2-d4bf-42f7-9834-2d19e04b2119);
		DB_CampNight_CancelledBy(NIGHT_DarkUrge_IsobelKillOrder_52916fa3-a23e-43b3-af5e-a41875ce7f47, (FLAG)HAV_Isobel_State_IsDead_af8b23d8-d04d-4e42-8a56-be909226e706);
		DB_Camp_DarkUrge_ButlerDream((DIALOGRESOURCE)CAMP_DarkUrge_IsobelKillOrder_SD_1ef2be30-aa20-4883-f5f0-da671f215af9);
		
		DB_CampNight((FLAG)NIGHT_DarkUrge_KilledIsobel_c46aba07-a156-4bcd-a2da-3411651f28c2,6160);
		DB_CampNight_Camp((FLAG)NIGHT_DarkUrge_KilledIsobel_c46aba07-a156-4bcd-a2da-3411651f28c2,"SCLMAIN");
		DB_CampNight_Camp((FLAG)NIGHT_DarkUrge_KilledIsobel_c46aba07-a156-4bcd-a2da-3411651f28c2,"SHARTEMPLE");
		DB_CampNight_Camp((FLAG)NIGHT_DarkUrge_KilledIsobel_c46aba07-a156-4bcd-a2da-3411651f28c2,"MOONRISE");
		DB_CampNight_Camp((FLAG)NIGHT_DarkUrge_KilledIsobel_c46aba07-a156-4bcd-a2da-3411651f28c2,"HAVEN");
		DB_CampNight_Requirement((FLAG)NIGHT_DarkUrge_KilledIsobel_c46aba07-a156-4bcd-a2da-3411651f28c2,(FLAG)ORI_DarkUrge_KilledIsobel_Requirement_b19523f2-d4bf-42f7-9834-2d19e04b2119, (FLAG)DARKURGE_68888003-acaa-49d5-b4f2-0c6293797e59);
		DB_CampNight_Requirement((FLAG)NIGHT_DarkUrge_KilledIsobel_c46aba07-a156-4bcd-a2da-3411651f28c2,(FLAG)ORI_DarkUrge_Event_KillFavouriteCharacter_65863750-e926-1f14-a3da-cda0b6ad1863, (FLAG)DARKURGE_68888003-acaa-49d5-b4f2-0c6293797e59);
		DB_CampNight_SoloDream((FLAG)NIGHT_DarkUrge_KilledIsobel_c46aba07-a156-4bcd-a2da-3411651f28c2,(CHARACTER)_DarkUrge,(DIALOGRESOURCE)CAMP_DarkUrge_KilledIsobel_SD_cf9ed4a0-7e1d-a0d5-eea7-3ea5aced83a1);
		DB_Camp_DarkUrge_ButlerDream((DIALOGRESOURCE)CAMP_DarkUrge_KilledIsobel_SD_cf9ed4a0-7e1d-a0d5-eea7-3ea5aced83a1);
		
		DB_CampNight((FLAG)NIGHT_DarkUrge_SparedIsobel_bc8b660e-33e9-44f7-9bc2-b869db5ac1f8,6150);
