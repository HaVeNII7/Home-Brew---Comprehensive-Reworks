		DB_END_AllyAbilities_SummonedAllyAD((CHARACTER)S_END_VerteranBattleMaster_70f53c3d-6463-41b5-b13e-a13f467b4889, (DIALOGRESOURCE)END_GatherYourAllies_AD_VeteranSummonResponse_a2e9a5df-ad88-d689-872b-9da606f6465c);
		DB_END_AllyAbilities_SummonedAllyAD((CHARACTER)S_END_VampireSpawn003_c8e421cf-e234-46aa-9b33-c72b72f0ad54, (DIALOGRESOURCE)END_GatherYourAllies_AD_AstarionSummonResponse_2739c15b-0457-8277-89ad-b567a762f336);
		DB_END_AllyAbilities_SummonedAllyAD((CHARACTER)S_END_ZhentarimSummon002_3bc06b07-d11f-4fd4-a351-d5bbbe8313ad, (DIALOGRESOURCE)END_GatherYourAllies_AD_ZhentSummonResponse_aa051d88-3383-01be-cdcf-15c7e3d247ff);
		DB_END_AllyAbilities_SummonedAllyAD((CHARACTER)S_END_SteelWatcherAlly_cb20c38a-38f7-46f7-840d-b64b4d363674, (DIALOGRESOURCE)END_GatherYourAllies_AD_SteelWatcherSummonResponse_02f97410-861b-842e-3039-29d71c7a87e5);
		DB_END_AllyAbilities_SummonedAllyAD((CHARACTER)S_GLO_Orthon_1dc8091d-2af6-4d33-9268-998ef266d19c, (DIALOGRESOURCE)END_GatherYourAllies_AD_OrthonSummonResponse_cf5564e9-b85c-25eb-7394-4973154cbf0b);
		DB_END_AllyAbilities_SummonedAllyAD((CHARACTER)S_GLO_Nightsong_6c55edb0-901b-4ba4-b9e8-3475a8392d9b, (DIALOGRESOURCE)END_GatherYourAllies_AD_NightsongSummonResponse_c45a80c8-1751-c01d-917f-f1ca83f4a495);
		DB_END_AllyAbilities_SummonedAllyAD((CHARACTER)S_FOR_OwlBear_Cub_001_c66b2865-6613-4372-b97a-e330c1d75d09, (DIALOGRESOURCE)END_GatherYourAllies_AD_OwlbearSummonResponse_3e215e8b-9cea-6be7-19ba-c25ca592cd78);
		DB_END_AllyAbilities_SummonedAllyAD((CHARACTER)S_END_IronhandGnome001_817f7eb9-44af-48d5-903a-087f0e20d507, (DIALOGRESOURCE)END_GatherYourAllies_AD_GrenadierSummonResponse_ffdbf16b-fe65-2e31-17f5-e9f1c01a38ae);
		DB_END_AllyAbilities_SummonedAllyAD((CHARACTER)S_GLO_Prodigy_b6a3a9e9-b6eb-4c19-ab3f-4c431178fe1b, (DIALOGRESOURCE)END_GatherYourAllies_RolanArtilleryCine_c47febec-d171-bc18-d398-837b19601eba);
		DB_END_AllyAbilities_SummonedAllyAD((CHARACTER)S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211, (DIALOGRESOURCE)END_GatherYourAllies_AD_IsobelSummonResponse_e92dc481-0bdc-05c7-83a5-6904b38c292c);
		DB_END_AllyAbilities_SummonedAllyAD((CHARACTER)S_LOW_Viconia_b1ea974d-96fb-47ca-b6d9-9c85fcb69313, (DIALOGRESOURCE)END_GatherYourAllies_AD_ViconiaSummonResponse_d55c87d9-aa49-9a3b-b7ec-d099f01a269b);
		DB_END_AllyAbilities_SummonedAllyAD((CHARACTER)S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a, (DIALOGRESOURCE)END_GatherYourAllies_AD_MizoraSummonResponse_74a8604a-6940-e6f4-4218-c93b18cc738c);
		DB_END_AllyAbilities_SummonedAllyAD((CHARACTER)S_WYR_GurCamp_GurLeader_5e52cf9c-b673-45b7-888c-2c105eb4d890, (DIALOGRESOURCE)END_GatherYourAllies_AD_VampireSpawnSummonResponse_095f593f-b39f-9f7d-dec4-09ed468b8a17);
		DB_END_AllyAbilities_SummonedAllyAD((CHARACTER)S_END_FlamingFistDefender_001_e7842c87-021c-4c6b-910b-1c4a28f11bcc, (DIALOGRESOURCE)END_GatherYourAllies_AD_FlamingFistSummonResponse_73e9e7a0-91c3-6f8c-6b2b-d16e514d0e51);
		DB_END_AllyAbilities_SummonedAllyAD((CHARACTER)S_HAG_Hag_c457d064-83fb-4ec6-b74d-1f30dfafd12d, (DIALOGRESOURCE)END_GatherYourAllies_AD_HagSummonResponse_a3950763-19ca-2d7a-54a5-04362f13d485);
		DB_END_AllyAbilities_SummonedAllyAD((CHARACTER)S_LOW_Guildhall_NineFingers_ef1b7a12-6439-470a-885c-fa47851728cd, (DIALOGRESOURCE)END_GatherYourAllies_AD_KeeneSummonResponse_f14b1efb-b9d5-6afb-f355-20eba9526d00);
		DB_END_AllyAbilities_SummonedAllyAD((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679, (DIALOGRESOURCE)END_GatherYourAllies_AD_ShadowheartSummonResponse_2d406f61-3750-f0f7-fac8-f0606721befa);
		DB_END_AllyAbilities_SummonedAllyAD((CHARACTER)S_GLO_GithKnight_2adce2df-0799-49dc-b867-ba7ca21e9aea, (DIALOGRESOURCE)END_GatherYourAllies_AD_VossSummonResponse_af641fbc-1a7e-eb05-7d5d-2b853304bbdd);
		DB_END_AllyAbilities_SummonedAllyAD((CHARACTER)S_END_KuotoaPointOfContact_265239be-2489-496d-936d-e78240ce2165, (DIALOGRESOURCE)END_GatherYourAllies_AD_KuoToaSummonResponse_f136e5c2-3b5f-9293-59ee-3bd02a952597);
	}
	KB
	{
		//REGION Debug
		IF
		TextEvent("END_AveragePathAllies")
		THEN
		SetFlag((FLAG)END_GatherYourAllies_Event_IronhandReinforcementsAwarded_13c4957c-2f76-28fc-5a25-fd625613a68b);
		SetFlag((FLAG)END_GatherYourAllies_Event_JaheiraReinforcementsAwarded_5f47c942-ac2c-b16d-5273-5653d9bbf5c0);
		SetFlag((FLAG)END_GatherYourAllies_Event_HellriderReinforcementsAwarded_7aa84a11-88db-c5ea-1058-12d927ca1fdf);
		SetFlag((FLAG)END_GatherYourAllies_Event_RolanReinforcementsAwarded_7f36c620-10ee-681e-0a13-33fcbfea04ab);
		SetFlag((FLAG)END_GatherYourAllies_Event_KeeneReinforcementAwarded_d6bae4db-96f2-2440-a61f-9157272443a2);
		SetFlag((FLAG)END_GatherYourAllies_Event_OwlbearCubReinforcementsAwarded_e091bec3-e904-ad68-a2ee-d135bc37fa4a);
		SetFlag((FLAG)END_GatherYourAllies_Event_IsobelReinforcementsAwarded_e514a07c-81fe-6c48-6f90-2333b475d201);
		SetFlag((FLAG)END_GatherYourAllies_Event_ValeriaReinforcementsAwarded_e5c0b5c4-749f-c90a-5aa6-8ed6769fd808);
		SetFlag((FLAG)END_GatherYourAllies_Event_NightsongReinforcementsAwarded_e6d46345-982d-4450-8a35-0b958746f119);
		
		IF
		TextEvent("END_RemoveAbilities")
		AND
		DB_Players((CHARACTER)_Player)
		THEN
		RemoveSpell(_Player, "Shout_END_AllyAbilities_MultipleSummon", 1);
		//END_REGION
		
		//REGION Give Ally Abilities to Mind Flayer players
		IF
		TagSet(_Char,FULL_CEREMORPH_3797bfc4-8004-4a19-9578-61ce0714cc0b)
		AND
		QRY_END_AllyAbilities_AbilityFlagSet()
		AND
		DB_Players((CHARACTER)_Char)
		AND
		HasAppliedStatus(_Char, "END_ALLYABILITIES_MULTIPLESUMMONS", 0)
		THEN
		ApplyStatus(_Char, "END_ALLYABILITIES_MULTIPLESUMMONS", -1.0);
		
		QRY
		QRY_END_AllyAbilities_AbilityFlagSet()
		AND
		DB_END_AllyAbilities_Abilities(_Flag, _, _, _)
		AND
		NOT DB_END_AllyAbility_AbilityFlagSet(1)
		AND
		DB_GlobalFlag((FLAG)_Flag)
		THEN
		DB_END_AllyAbility_AbilityFlagSet(1);
		
		IF
		DB_GlobalFlag((FLAG)_Flag)
		AND
		DB_END_AllyAbilities_Abilities(_Flag, _, _, _)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		HasAppliedStatus(_Player, "END_ALLYABILITIES_MULTIPLESUMMONS", 0)
		AND
		IsTagged(_Player, (TAG)FULL_CEREMORPH_3797bfc4-8004-4a19-9578-61ce0714cc0b, 1)
		THEN
		ApplyStatus(_Player, "END_ALLYABILITIES_MULTIPLESUMMONS", -1.0);
		
		IF
		DB_GlobalFlag((FLAG)_Flag)
		AND
		DB_END_AllyAbilities_Abilities(_Flag, _, _, (STRING)_AbilityStatus)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		HasAppliedStatus(_Player, _AbilityStatus, 0)
		AND
		IsTagged(_Player, (TAG)FULL_CEREMORPH_3797bfc4-8004-4a19-9578-61ce0714cc0b, 1)
		THEN
		ApplyStatus(_Player, _AbilityStatus, -1.0);
		//END_REGION
		
		//REGION Build the Summons DB
		IF
		EnteredTrigger(_, (TRIGGER)S_END_GatherYourAllies_SUB_6651c6b2-90b2-4380-90f1-7cfd4f5f5c47)
		THEN
		PROC_END_AllyAbilities_CleanPotentialSummonsDB();
		
		PROC
		PROC_END_AllyAbilities_CleanPotentialSummonsDB()
		AND
		DB_END_AllyAbilities_PotentialSummons((STRING)_CastedSpell, (STRING)_InterdictingStatus, (CHARACTER)_Summon, (ANIMATION)_SummonAnim)
		AND
		DB_PermaDefeated(_Summon)
		THEN
		NOT DB_END_AllyAbilities_PotentialSummons(_CastedSpell, _InterdictingStatus, _Summon, _SummonAnim);
		
		PROC
		PROC_END_AllyAbilities_PlayerHaveAllyContainer((STRING)_CastedSpell)
		AND
		DB_END_AllyAbilities_Abilities(_, _CastedSpell, (INTEGER)_NumSummons, _)
		AND
		NOT DB_AllyAbilities_LearnedSpell(_CastedSpell)
		THEN
		DB_AllyAbilities_LearnedSpell(_CastedSpell);
		PROC_AllyAbilities_BuildSummonsDB(_CastedSpell, _NumSummons);
		
		PROC
		PROC_AllyAbilities_BuildSummonsDB((STRING)_CastedSpell, (INTEGER)_NumSummons)
		AND
		IntegerSubtract(_NumSummons, 1, _Diff)
		AND
		NOT _Diff < 0
		THEN
		PROC_AllyAbilities_SummonsDBIteration(_CastedSpell, _Diff);
		
		PROC
		PROC_AllyAbilities_SummonsDBIteration((STRING)_CastedSpell, (INTEGER)_Diff)
		AND
		DB_OnlyOnce("END_SummonSelected")
		THEN
		NOT DB_OnlyOnce("END_SummonSelected");
		
		PROC
		PROC_AllyAbilities_SummonsDBIteration((STRING)_CastedSpell, (INTEGER)_Diff)
		AND
		DB_END_AllyAbilities_PotentialSummons(_CastedSpell, (STRING)_InterdictingStatus, (CHARACTER)_Summon, (ANIMATION)_SummonAnim)
		AND
		NOT DB_OnlyOnce("END_SummonSelected")
		THEN
		ApplyStatus(_Summon, "END_RESTORATION", 6.0, 1, _Summon);
		SetFaction(_Summon, (FACTION)ACT3_END_AllyAbilities_Summon_ab4018cf-9f02-48aa-9c52-469b279c651a);
		DB_END_AllyAbilities_Summons(_CastedSpell, _InterdictingStatus, _Summon, _SummonAnim);
		SetTag(_Summon, (TAG)ACT3_END_MINDPORTALDISABLED_6f7d24c4-ffdf-4258-bf74-bb7f155ef83e);
		NOT DB_END_AllyAbilities_PotentialSummons(_CastedSpell, _InterdictingStatus, _Summon, _SummonAnim);
		DB_OnlyOnce("END_SummonSelected");
		PROC_AllyAbilities_BuildSummonsDB(_CastedSpell, _Diff);
		//END_REGION
		
		//REGION Setup for Act
		PROC
		PROC_GLO_SetupForAct((STRING)_Level, (CHARACTER)_Character, 1)
		AND
		DB_END_AllyAbilities_OutOfLevelSummons(_Character)
		THEN
		SetFaction(_Character, (FACTION)ACT3_END_AllyAbilities_Summon_ab4018cf-9f02-48aa-9c52-469b279c651a);
		PROC_GLO_SetupForAct_Place(_Character, (TRIGGER)S_GLO_PixieAsylumPos_Act3c_9f22d897-b3df-49cb-82e9-3db74617dd26);
		
		PROC
		PROC_GLO_SetupForAct("END_Main", (CHARACTER)S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a, 1)
		THEN
		RemoveTransforms(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a);
		RemoveStatus(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a, "GLO_MIZORA_INVULNERABLE", NULL_00000000-0000-0000-0000-000000000000);
		//END_REGION
		
		//REGION Grant Ally Abilities
		IF
		DB_GlobalFlag((FLAG)END_VossEncounter_Event_GithReinforcementsAwarded_b5147ee9-ec6e-461e-8849-7d9af26c3d54)
		AND
		DB_END_AllyAbilities_Abilities(END_VossEncounter_Event_GithReinforcementsAwarded_b5147ee9-ec6e-461e-8849-7d9af26c3d54, (STRING)_GrantedSpell, _, _)
		THEN
		PROC_END_AllyAbilities_PlayerHaveAllyContainer(_GrantedSpell);
		
		IF
		DB_END_GatherYourAllies_GrantedAwards((FLAG)_AllyAbility)
		AND
		DB_END_AllyAbilities_AbilitiesBuffs(_AllyAbility, (STRING)_Buff)
		AND
		DB_Players((CHARACTER)_Player)
		THEN
		ApplyStatus(_Player, _Buff, -1.0, 0, _Player);
		
		IF
		DB_END_GatherYourAllies_GrantedAwards((FLAG)_AllyAbility)
		AND
		DB_END_AllyAbilities_Abilities(_AllyAbility, (STRING)_GrantedSpell, _, _)
		THEN
		PROC_END_AllyAbilities_PlayerHaveAllyContainer(_GrantedSpell);
		
		PROC
		PROC_END_AllyAbilities_PlayerHaveAllyContainer((STRING)_GrantedSpell)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		HasSpell(_Player, "Shout_END_AllyAbilities_MultipleSummon", 1)
		THEN
		AddSpell(_Player, _GrantedSpell, 1, 0);
		
		//spell container doesn't add automatically to is has to be added first
		PROC
		PROC_END_AllyAbilities_PlayerHaveAllyContainer((STRING)_GrantedSpell)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		HasSpell(_Player, "Shout_END_AllyAbilities_MultipleSummon", 0)
		THEN
		AddSpell(_Player, "Shout_END_AllyAbilities_MultipleSummon", 1, 0);
		PROC_Tutorials_EndGameAlliesSpellAdded((CHARACTER)_Player);
		AddSpell(_Player, _GrantedSpell, 1, 0);
		//END_REGION
		
		//REGION Determine Ally Ability Cast
		IF
		UsingSpellAtPosition(_, _, _, _, (STRING)_AllySummon, _, _, _)
		AND
		DB_END_AllyAbilities_Summons(_AllySummon, _, _, _)
		AND
		DB_END_AllyAbilities_Caster(_Caster)
		THEN
		NOT DB_END_AllyAbilities_Caster(_Caster);
		
		IF
		UsingSpellAtPosition((CHARACTER)_Character, (REAL)_CastX, (REAL)_CastY, (REAL)_CastZ, (STRING)_AllySummon, "target", _, _)
		AND
		DB_END_AllyAbilities_Summons(_AllySummon, (STRING)_InterdictingStatus, _, _)
		THEN
		DB_END_AllyAbilities_SummonedPosition(_AllySummon, _CastX, _CastY, _CastZ);
		
		IF
		UsingSpellAtPosition((CHARACTER)_Character, (REAL)_CastX, (REAL)_CastY, (REAL)_CastZ, "Wall_END_AllyAbility_VossDragonFire", "wall", _, _)
		AND
		DB_END_AllyAbilities_Abilities(_, "Wall_END_AllyAbility_VossDragonFire", _, _)
		AND
		CombatGetGuidFor(_Character, (GUIDSTRING)_CombatID)
		AND
		QRY_OnlyOnce("END_AllyAbility_AllySpellCast")
		THEN
		DB_END_AllyAbilities_VossAbilityCombat(_CombatID);
		PROC_END_AllyAbilities_VossDragonFire(_Character);
		SetEntityEvent(_Character, "END_AllyAbility_CastAllySpell", 0);
		
		IF
		CastedSpell((CHARACTER)_Character, (STRING)_AllySummon, "target", _, _)
		AND
		DB_END_AllyAbilities_Summons(_AllySummon, (STRING)_InterdictingStatus, _, _)
		AND
		DB_END_AllyAbilities_PlayerSummonAllyAD(_AllySummon, (DIALOGRESOURCE)_Dialogue)
		AND
		DB_END_AllyAbilities_SummonedPosition(_AllySummon, (REAL)_CastX, (REAL)_CastY, (REAL)_CastZ)
		AND
		QRY_OnlyOnce("END_AllyAbility_AllySpellCast")
		THEN
		PROC_END_AllyAbilities_CheckSpellAD(_AllySummon, _Dialogue, _Character);
		PROC_END_AllyAbilities_SpawnAllyAtPosition(_Character, _AllySummon, _CastX, _CastY, _CastZ);
		NOT DB_END_AllyAbilities_SummonedPosition(_AllySummon, _CastX, _CastY, _CastZ);
		SetEntityEvent(_Character, "END_AllyAbility_CastAllySpell", 0);
		ApplyStatus(_Character, _InterdictingStatus, -1.0, 1, _Character);
		
		PROC
		PROC_END_AllyAbilities_CheckSpellAD("Target_END_AllyAbilties_ShadowAdepts", (DIALOGRESOURCE)_Dialogue, (CHARACTER)_Character)
		AND
		DB_GlobalFlag(ORI_Shadowheart_State_Shar_KilledParents_3a3b0ecf-a1ed-4733-8548-0348befc6bac)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)END_GatherYourAllies_AD_PlayerSummonShadowheartAlly_39a674c0-4708-4874-1f9b-af2d8292a5a5, _Character);
		DB_END_AllyAbilities_FiredAD(1);
		
		PROC
		PROC_END_AllyAbilities_CheckSpellAD(_, (DIALOGRESOURCE)_Dialogue, (CHARACTER)_Character)
		AND
		NOT DB_END_AllyAbilities_FiredAD(1)
		THEN
		PROC_TryStartAD(_Dialogue, _Character);
		DB_END_AllyAbilities_FiredAD(1);
		
		//reset the only once so abilities can be recast each combat but not per party member
		IF
		EntityEvent((CHARACTER)_Character, "END_AllyAbility_CastAllySpell")
		THEN
		NOT DB_OnlyOnce("END_AllyAbility_AllySpellCast");
		NOT DB_END_AllyAbilities_FiredAD(1);
		//END_REGION
		
		//REGION Spawn Allies
		PROC
		PROC_END_AllyAbilities_SpawnAllyAtPosition((CHARACTER)_Caster, (STRING)_CastedSpell, (REAL)_SpawnX, (REAL)_SpawnY, (REAL)_SpawnZ)
		AND
		DB_END_AllyAbilities_Summons(_CastedSpell, _, (CHARACTER)_Summon, (ANIMATION)_Animation)
		THEN
		SetCanFight(_Summon, 1);
		SetCanJoinCombat(_Summon, 1);
		
		PROC
		PROC_END_AllyAbilities_SpawnAllyAtPosition((CHARACTER)_Caster, (STRING)_CastedSpell, (REAL)_SpawnX, (REAL)_SpawnY, (REAL)_SpawnZ)
		AND
		DB_END_AllyAbilities_Abilities(_, _CastedSpell, 1, _)
		AND
		DB_END_AllyAbilities_Summons(_CastedSpell, _, (CHARACTER)_Summon, (ANIMATION)_Animation)
		AND
		FindValidPosition(_SpawnX, _SpawnY, _SpawnZ, 30.0, _Caster, 1, _ValidX, _ValidY, _ValidZ)
		THEN
		AddPartyFollower(_Summon, _Caster);
		DB_END_AllyAbilities_QueuedSummonOwner(_Caster, _Summon);
		SetCombatGroupID(_Summon, "");
		AppearAtPosition(_Summon, _ValidX, _ValidY, _ValidZ, 1, _Animation, "END_AllyAbility_TeleportedTargetSummon", 0);
		PROC_END_AllyAbilities_TryStartSummonsAD(_Summon);
		
		//Spawn the allies
		PROC
		PROC_END_AllyAbilities_SpawnAllyAtPosition((CHARACTER)_Caster, (STRING)_CastedSpell, (REAL)_SpawnX, (REAL)_SpawnY, (REAL)_SpawnZ)
		AND
		DB_END_AllyAbilities_Abilities(_, _CastedSpell, _NumUnits, _)
		AND
		_NumUnits > 1
		AND
		DB_END_AllyAbilities_Summons(_CastedSpell, _, (CHARACTER)_Character, (ANIMATION)_Animation)
		AND
		FindValidPosition(_SpawnX, _SpawnY, _SpawnZ, 30.0, _Caster, 1, _ValidX, _ValidY, _ValidZ)
		THEN
		DB_END_AllyAbilities_Caster(_Caster);
		SetCombatGroupID(_Character, "");
		AppearAtPosition(_Character, _ValidX, _ValidY, _ValidZ, 1, _Animation, "END_AllyAbility_TeleportedMultipleSummons", 0);
		PlayEffect(_Character, (EFFECTRESOURCE)VFX_Spells_Cast_Intent_Utility_TargetJump_MistyStep_Root_Textkey_02_3725b5c2-8274-a2fe-3148-d071c77ffcaa);
		PROC_END_AllyAbilities_TryStartSummonsAD(_Character);
		
		PROC
		PROC_GLO_PostReassignFollowerHook((CHARACTER)_Summon, (CHARACTER)_OldLeader, (CHARACTER)_NewLeader)
		AND
		DB_END_AllyAbilities_QueuedSummonOwner(_OldLeader, _Summon)
		THEN
		NOT DB_END_AllyAbilities_QueuedSummonOwner(_OldLeader, _Summon);
		DB_END_AllyAbilities_QueuedSummonOwner(_NewLeader, _Summon);
		
		IF
		AppearTeleportFailed((CHARACTER)_Character, "END_AllyAbility_TeleportedMultipleSummons")
		AND
		DB_END_AllyAbilities_Summons(_, _, _Character, _Animation)
		AND
		DB_END_AllyAbilities_Caster(_Caster)
		AND
		GetPosition(_Caster, _CasterX, _CasterY, _CasterZ)
		AND
		FindValidPosition(_CasterX, _CasterY, _CasterZ, 30.0, _Caster, 1, _ValidX, _ValidY, _ValidZ)
		THEN
		AppearAtPosition(_Character, _ValidX, _ValidY, _ValidZ, 1, _Animation, "END_AllyAbility_TeleportedMultipleSummons", 0);
		PlayEffect(_Character, (EFFECTRESOURCE)VFX_Spells_Cast_Intent_Utility_TargetJump_MistyStep_Root_Textkey_02_3725b5c2-8274-a2fe-3148-d071c77ffcaa);
		SetFaction(_Character, (FACTION)ACT3_END_AllyAbilities_Summon_ab4018cf-9f02-48aa-9c52-469b279c651a);
		
		IF
		BaseFactionChanged((CHARACTER)_Summon, _, (FACTION)ACT3_END_AllyAbilities_Summon_ab4018cf-9f02-48aa-9c52-469b279c651a)
		AND
		DB_END_AllyAbilities_Caster(_Caster)
		AND
		DB_Is_InCombat(_Caster, _CombatGUID)
		AND
		DB_Is_InCombat(_Enemy, _CombatGUID)
		AND
		QRY_IsEnemy(_Enemy, _Summon)
		AND
		GetCombatGroupID(_Enemy, _CombatGroup)
		AND
		_CombatGroup != ""
		AND
		NOT DB_END_AllyAbilities_ForceEnterCombat(1)
		THEN
		SetCombatGroupAndEnterCombat(_Summon, _CombatGroup, _Enemy);
		DB_END_AllyAbilities_ForceEnterCombat(1);
		
		IF
		EntityEvent((CHARACTER)_EndGameAlly, _)
		AND
		DB_END_AllyAbilities_Summons(_, _, _EndGameAlly, _)
		AND
		DB_END_AllyAbilities_ForceEnterCombat(1)
		THEN
		NOT DB_END_AllyAbilities_ForceEnterCombat(1);
		
		IF
		EntityEvent((CHARACTER)_EndGameAlly, "END_AllyAbility_TeleportedTargetSummon")
		AND
		DB_END_AllyAbilities_QueuedSummonOwner(_Caster, _EndGameAlly)
		AND
		DB_Is_InCombat(_Caster, _CasterCombat)
		AND
		DB_Is_InCombat(_EndGameAlly, _AllyCombat)
		AND
		_CasterCombat != _AllyCombat
		THEN
		LeaveCombat(_EndGameAlly);
		
		IF
		EntityEvent((CHARACTER)_EndGameAlly, "END_AllyAbility_TeleportedTargetSummon")
		AND
		DB_END_AllyAbilities_QueuedSummonOwner(_Caster, _EndGameAlly)
		AND
		DB_Is_InCombat(_Caster, _CombatGUID)
		AND
		DB_Is_InCombat(_Enemy, _CombatGUID)
		AND
		QRY_IsEnemy(_Enemy, _EndGameAlly)
		AND
		GetCombatGroupID(_Enemy, _CombatGroup)
		AND
		_CombatGroup != ""
		AND
		NOT DB_END_AllyAbilities_ForceEnterCombat(1)
		THEN
		SetCombatGroupAndEnterCombat(_EndGameAlly, _CombatGroup, _Enemy);
		NOT DB_END_AllyAbilities_QueuedSummonOwner(_Caster, _EndGameAlly);
		DB_END_AllyAbilities_ForceEnterCombat(1);
		
		IF
		EntityEvent((CHARACTER)_EndGameAlly, "END_AllyAbility_TeleportedMultipleSummons")
		AND
		DB_END_AllyAbilities_Caster(_Caster)
		AND
		DB_Is_InCombat(_Caster, _CombatGUID)
		AND
		DB_Is_InCombat(_Enemy, _CombatGUID)
		AND
		NOT DB_END_AllyAbilities_ForceEnterCombat(1)
		AND
		QRY_IsEnemy(_Enemy, _EndGameAlly)
		AND
		GetCombatGroupID(_Enemy, _CombatGroup)
		AND
		_CombatGroup != ""
		THEN
		SetCombatGroupAndEnterCombat(_EndGameAlly, _CombatGroup, _Enemy);
		DB_END_AllyAbilities_ForceEnterCombat(1);
		
		PROC
		PROC_END_AllyAbilities_TryStartSummonsAD((CHARACTER)_Summon)
		AND
		DB_END_AllyAbilities_SummonedAllyAD(_Summon, (DIALOGRESOURCE)_SummonAD)
		THEN
		PROC_TryStartAD(_SummonAD, _Summon);
		//END_REGION
		
		//REGION Clean Summons DB on deaths
		IF
		Died((CHARACTER)_Summon)
		AND
		DB_END_AllyAbilities_Summons((STRING)_AllyAbility, (STRING)_InterdictingStatus, _Summon, (ANIMATION)_Animation)
		THEN
		NOT DB_END_AllyAbilities_Summons(_AllyAbility, _InterdictingStatus, _Summon, _Animation);
		PROC_END_AllyAbilities_SummonsRemaining(_AllyAbility);
		SetCombatGroupID(_Summon, "");
		
		IF
		DB_Downed((CHARACTER)S_GLO_Nightsong_6c55edb0-901b-4ba4-b9e8-3475a8392d9b)
		AND
		DB_END_AllyAbilities_Summons((STRING)_AllyAbility, (STRING)_InterdictingStatus, S_GLO_Nightsong_6c55edb0-901b-4ba4-b9e8-3475a8392d9b, (ANIMATION)_Animation)
		AND
		DB_Players((CHARACTER)_Player)
		THEN
		ApplyStatus(_Player, "END_ALLYABILITIES_NIGHTSONGALLYCONSUMED", -1.0, 1, _Player);
		
		IF
		HitpointsChanged((CHARACTER)S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a, 0.0)
		AND
		DB_END_AllyAbilities_Summons((STRING)_AllyAbility, (STRING)_InterdictingStatus, S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a, (ANIMATION)_Animation)
		AND
		DB_Players((CHARACTER)_Player)
		THEN
		SetImmortal(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a, 1);
		SetHitpoints(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a, 1);
		PROC_GLO_Monitor_EntityPoof(S_GLO_Wyll_Cambion_491a7686-3081-405b-983c-289ec8781e0a);
		ApplyStatus(_Player, "END_ALLYABILITIES_MIZORAALLYCONSUMED", -1.0, 1, _Player);
		//END_REGION
		
		//REGION Clear Ally Ability If All Summons died
		//Permanently greyed out
		PROC
		PROC_END_AllyAbilities_SummonsRemaining((STRING)_AllyAbility)
		AND
		NOT DB_END_AllyAbilities_Summons(_AllyAbility, _, _, _)
		AND
		DB_PartyMembers((CHARACTER)_Character)
		AND
		DB_END_AllyAbility_PermanentAbilityRemoval(_AllyAbility, (STRING)_PermanentBlockingStatus)
		THEN
		ApplyStatus(_Character, _PermanentBlockingStatus, -1.0, 1, _Character);
		
		IF
		StatusApplied(_, (STRING)_PermanentBlockingStatus, _, _ID)
		AND
		DB_END_AllyAbility_PermanentAbilityRemoval(_, _PermanentBlockingStatus)
		AND
		DB_PartyMembers((CHARACTER)_Party)
		AND
		HasAppliedStatus(_Party, _PermanentBlockingStatus, 0)
		THEN
		ApplyStatus(_Party, _PermanentBlockingStatus, -1.0, 1, _Party);
		
		//Greyed out for the combat spread to each party member
		IF
		StatusApplied(_, (STRING)_InterdictingStatus, _, _ID)
		AND
		DB_END_AllyAbilities_Summons(_, _InterdictingStatus, _, _)
		AND
		DB_PartyMembers((CHARACTER)_Character)
		AND
		HasAppliedStatus(_Character, _InterdictingStatus, 0)
		THEN
		ApplyStatus(_Character, _InterdictingStatus, -1.0, 1, _Character);
		
		//Gather current combat GUID
		IF
		CombatStarted(_CombatGUID)
		AND
		DB_END_AllyAbilities_CurrentCombat(_PreviousCombat)
		THEN
		NOT DB_END_AllyAbilities_CurrentCombat(_PreviousCombat);
		DB_END_AllyAbilities_CurrentCombat(_CombatGUID);
		NOT DB_END_GatherYourAllies_CharacterExodus(1);
		
		//clear interdicting status on leave
		IF
		LeftCombat((CHARACTER)_Character, _CombatID)
		AND
		DB_END_AllyAbilities_CurrentCombat(_CombatID)
		AND
		DB_PartyMembers(_Character)
		AND
		DB_END_AllyAbilities_Summons(_, (STRING)_InterdictingStatus, _, _)
		AND
		HasActiveStatus(_Character, _InterdictingStatus, 1)
		THEN
		RemoveStatus(_Character, _InterdictingStatus, _Character);
		
		//make the allies run off stage
		IF
		LeftCombat((CHARACTER)_Summon, _CombatID)
		AND
		DB_END_AllyAbilities_CurrentCombat(_CombatID)
		AND
		DB_END_AllyAbilities_Summons(_, _, _Summon, _)
		AND
		IsPartyFollower(_Summon, 0)
		THEN
		SetCanFight(_Summon, 0);
		SetCanJoinCombat(_Summon, 0);
		SetCombatGroupID(_Summon, "");
		PROC_DisappearOutOfSightTo(_Summon, (TRIGGER)S_END_CharacterExitPoint_8a5cd47d-1e17-42ed-bb8e-26a70680c36a, "Sprint", 1, "");
		
		IF
		LeftCombat((CHARACTER)_Summon, _CombatID)
		AND
		DB_END_AllyAbilities_CurrentCombat(_CombatID)
		AND
		DB_END_AllyAbilities_Summons(_, _, _Summon, _)
		AND
		IsPartyFollower(_Summon, 1)
		AND
		CharacterGetOwner((CHARACTER)_Summon,_Character)
		AND
		IsInCombat(_Character, 0)
		THEN
		RemovePartyFollower(_Summon, _Character);
		SetCanFight(_Summon, 0);
		SetCanJoinCombat(_Summon, 0);
		SetCombatGroupID(_Summon, "");
		PROC_DisappearOutOfSight(_Summon, "Sprint", 1, "");
		
		
		IF
		LeftCombat((CHARACTER)_Summon, _CombatID)
		AND
		DB_END_AllyAbilities_CurrentCombat(_CombatID)
		AND
		DB_END_AllyAbilities_Summons(_, _, _Summon, _)
		AND
		DB_GLO_Follower_Reassigning(_Summon, _OldChar, _Character)
		AND
		IsInCombat(_Character, 0)
		THEN
		NOT DB_GLO_Follower_Reassigning(_Summon, _OldChar, _Character);
		SetCanFight(_Summon, 0);
		SetCanJoinCombat(_Summon, 0);
		SetCombatGroupID(_Summon, "");
		PROC_DisappearOutOfSight(_Summon, "Sprint", 1, "");
		//END_REGION
		
		//REGION Voss Dragon Strike
		
		PROC
		PROC_END_AllyAbilities_VossDragonFire((CHARACTER)_Player)
		AND
		DB_END_AllyAbilities_VossAbilityCombat(_CombatID)
		THEN
		DB_END_AllyAbilities_HoldIgnite(1);
		RealtimeObjectTimerLaunch(_Player, "END_AllyAbility_VossDragonFireCastTimer", 2000); //A small delay so it syncs better with the cast anim
		
		IF
		ObjectTimerFinished(_Player, "END_AllyAbility_VossDragonFireCastTimer")
		AND
		NOT DB_InRegion((CHARACTER)_Player, S_END_Underground_SUB_07f16e8a-fc85-4130-a908-1ae0972c3502)
		THEN
		PROC_END_AllyAbilities_StartVossArenaCamera((CHARACTER)_Player);
		
		IF
		ObjectTimerFinished(_Player, "END_AllyAbility_VossDragonFireCastTimer")
		AND
		DB_InRegion((CHARACTER)_Player, S_END_Underground_SUB_07f16e8a-fc85-4130-a908-1ae0972c3502)
		THEN
		NOT DB_END_AllyAbilities_HoldIgnite(1);
		DB_END_AllyAbilities_ReadyIgniteWall(1);
		
		PROC
		PROC_END_AllyAbilities_StartVossArenaCamera((CHARACTER)_)
		AND
		DB_END_AllyAbilities_VossAbilityCombat(_CombatID)
		AND
		DB_Players(_Player)
		AND
		DB_Is_InCombat(_Player, _CombatID)
		AND
		NOT DB_InRegion(_Player, S_END_Underground_SUB_07f16e8a-fc85-4130-a908-1ae0972c3502)
		THEN
		SendArenaCameraEvent(_Player, NULL_00000000-0000-0000-0000-000000000000, "END_AllyAbility_VossDragonFireArenaCamera");
		
		PROC
		PROC_END_AllyAbilities_StartVossArenaCamera((CHARACTER)_Player)
		THEN
		RealtimeObjectTimerLaunch(_Player, "END_VossAllyAbilityCameraTimer", 4700);
		
		IF
		ObjectTimerFinished(_Player, "END_VossAllyAbilityCameraTimer")
		THEN
		NOT DB_END_AllyAbilities_HoldIgnite(1);
		DB_END_AllyAbilities_ReadyIgniteWall(1);
		
		IF
		DB_END_AllyAbilities_ReadyIgniteWall(1)
		AND
		NOT DB_END_AllyAbilities_HoldIgnite(1)
		AND
		DB_END_AllyAbility_VossDragonFire_Walls(_Wall)
		THEN
		ApplyStatus(_Wall,"END_DRAGONFIRE_WALL",60.0,1,NULL_00000000-0000-0000-0000-000000000000);
		CreateSurface(_Wall, "SurfaceFire", 1.0, 60.0);
		
		IF
		StatusApplied((GUIDSTRING)_Walls,"END_DRAGONFIRE_TECHNICAL",_,_)
		THEN
		DB_END_AllyAbility_VossDragonFire_Walls(_Walls);
		
		IF
		StatusApplied((GUIDSTRING)_StartWall,"END_DRAGONFIRE_TECHNICAL",_,_)
		AND
		QRY_OnlyOnce("END_AllyAbility_VossDragonStrike_FirstWall")
		THEN
		DB_END_AllyAbility_VossDragonFire_StartWall(_StartWall);
		
		IF
		StatusApplied((GUIDSTRING)_Wall,"END_DRAGONFIRE_TECHNICAL",_,_)
		AND
		NOT DB_END_AllyAbility_VossDragonFire_StartWall(_Wall)
		AND
		GetTemplate(_Wall, _WallTemplate)
		AND
		_WallTemplate != VFX_Static_Wall_VossDragonSpell_Fire_A_HighMiddle_A_a8b1d820-81dd-47e5-b3be-80967529ddee
		AND
		_WallTemplate != VFX_Static_Wall_VossDragonSpell_Fire_A_LowMiddle_A_b2674894-309a-4429-910a-aac73e9eef7b
		THEN
		DB_END_AllyAbility_VossDragonFire_EndWall(_Wall);
		
		IF
		DB_END_AllyAbility_VossDragonFire_StartWall(_StartWall)
		AND
		DB_END_AllyAbility_VossDragonFire_EndWall(_EndWall)
		AND
		NOT DB_END_AllyAbilities_HoldIgnite(1)
		THEN
		PlayBeamEffect(_StartWall, _EndWall, (EFFECTRESOURCE)VFX_Script_END_AllyAbility_VossDragonFire_Beam_01_0f3fbe67-3b71-d5c2-6ed4-b844db977d0e, "", "");
		//END_REGION
		
		//REGION Additional Logic for group summons
		
		IF
		DB_END_AllyAbilities_Summons(_ , "END_ALLYABILITIES_HARPERABILITYINTERDICTED", _Summon, _)
		THEN
		RequestSetSwarmGroup(_Summon, "END_HarperRanger_Swarm");
		AddSpell(_Summon, "Projectile_END_LightningArrow_Harper", 0, 0);
		
		//Register allies for the Tentacle triggers
		IF
		DB_END_AllyAbilities_Summons(_ , _, _Summon, _)
		AND
		DB_END_BrainBattle_BrainTentacles(_, _Trigger)
		THEN
		TriggerRegisterForCharacter(_Trigger, _Summon);
		
		//END_REGION
		
		//REGION Spell Glow on Abilties spell containter
		
		IF
		EnteredCombat((CHARACTER)_Character,_)
		AND
		DB_PartyMembers(_Character)
		AND
		HasSpell(_Character,"Shout_END_AllyAbilities_MultipleSummon",1)
		THEN
		ApplyStatus(_Character,"END_ALLYABILITIES_SPELLGLOW",-1.0,1);
		
		//END_REGION
		
		//REGION Failsafe if Summons have no Anubis on their turn
		IF
		DB_END_AllyAbilities_Summons(_, _, _Summon, _)
		AND
		NOT GetAnubisConfig(_Summon, "")
		THEN
		DB_END_AllyAbility_ConfiggedSummons(_Summon);
		
		IF
		TurnStarted((CHARACTER)_Summon)
		AND
		NOT DB_END_AllyAbility_ConfiggedSummons(_Summon)
		AND
		DB_END_AllyAbilities_Summons(_, _, _Summon, _)
		AND
		GetAnubisConfig(_Summon, "")
		THEN
		DB_END_AllyAbility_ConfiggedSummons(_Summon);
		PROC_SetAnubisConfig(_Summon, "DefaultCharacter");
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(666).Title("Act3c_END_Armoury");
Goal(666)
{
	INIT
	{
		Lock(S_END_ArmouryDoor_311c45f0-4c10-4762-919a-c89f6d5cd3f5, "STORY_LOCK");
		Lock(S_END_ArmouryBackDoor_9203b8e4-7851-4f76-87e2-aad3f05d9a23, "STORY_LOCK");
		
		DB_END_Armoury_Civilian((CHARACTER)S_END_ArmouryCivilian_001_8e88e13a-093a-47a5-9031-12055f1dff0b);
		DB_END_Armoury_Civilian(S_END_ArmouryCivilian_002_b4818ef0-a5a8-44c4-9603-35a8d11869fe);
		DB_END_Armoury_Civilian(S_END_ArmouryCivilian_003_bace1e81-671d-4120-bc0c-c46d26bcbbb7);
		
		DB_Dialogs(S_END_ArmouryCivilian_001_8e88e13a-093a-47a5-9031-12055f1dff0b, S_END_ArmouryCivilian_002_b4818ef0-a5a8-44c4-9603-35a8d11869fe, S_END_ArmouryCivilian_003_bace1e81-671d-4120-bc0c-c46d26bcbbb7, END_Armoury_Door_7a02faca-ba91-d8da-f747-7dd765dbfacc);
		DB_DialogBlockAttackButton(END_Armoury_Door_7a02faca-ba91-d8da-f747-7dd765dbfacc);
		DB_DialogBlockTradeButton(END_Armoury_Door_7a02faca-ba91-d8da-f747-7dd765dbfacc);
		DB_IgnoreMutingStatussesDialog(END_Armoury_Door_7a02faca-ba91-d8da-f747-7dd765dbfacc);
		
		PROC_TriggerRegisterForParty(S_END_ArmouryArea_46fc22cd-e7f3-4605-be2d-82bd3ce020fc);
		PROC_TriggerRegisterForParty(S_END_ArmouryDialogArea_c0e00073-f7ff-4e10-a470-81ea034fdf39);
		
		DB_SpotPlayers(S_END_ArmouryCivilian_001_8e88e13a-093a-47a5-9031-12055f1dff0b, "END_Armoury_Infiltrated", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
	}
	KB
	{
		//REGION Locked entrance
		//Failed to lockpick the door
		PROC
		PROC_RollResult("GAMEPLAY_LockPicking", _Player, S_END_ArmouryDoor_311c45f0-4c10-4762-919a-c89f6d5cd3f5, 0)
		AND
		DB_Players(_Player)
		THEN
		SetFlag(END_Armoury_Event_BlockedInteraction_3a388774-3b6e-52af-740c-a2e4499add83, _Player, 0);
		PROC_END_Armoury_StartDoorDialog(_Player);
		
		PROC
		PROC_BlockUseOfItem(_Player, S_END_ArmouryDoor_311c45f0-4c10-4762-919a-c89f6d5cd3f5)
		AND
		NOT DB_GlobalFlag(END_Armoury_Event_DoorOpens_0126d5ae-6e00-6952-886d-b6a2709aee8b)
		AND
		IsLocked(S_END_ArmouryDoor_311c45f0-4c10-4762-919a-c89f6d5cd3f5, 1)
		THEN
		PROC_END_Armoury_StartDoorDialog(_Player);
		DB_CustomUseItemResponse(_Player, S_END_ArmouryDoor_311c45f0-4c10-4762-919a-c89f6d5cd3f5, 0);
		
		IF
		Opened(S_END_ArmouryDoor_311c45f0-4c10-4762-919a-c89f6d5cd3f5)
		THEN
		SetCanInteract(S_END_ArmouryDoor_311c45f0-4c10-4762-919a-c89f6d5cd3f5, 0);
		
		IF
		Opened(S_END_ArmouryDoor_311c45f0-4c10-4762-919a-c89f6d5cd3f5)
		AND
		NOT DB_GlobalFlag(END_Armoury_Event_DoorOpens_0126d5ae-6e00-6952-886d-b6a2709aee8b)
		THEN
		SetFlag(END_Armoury_Event_DoorOpens_0126d5ae-6e00-6952-886d-b6a2709aee8b, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		Opened(S_END_ArmouryBackDoor_9203b8e4-7851-4f76-87e2-aad3f05d9a23)
		AND
		NOT DB_GlobalFlag(END_Armoury_Event_DoorOpens_0126d5ae-6e00-6952-886d-b6a2709aee8b)
		THEN
		SetFlag(END_Armoury_Event_DoorOpens_0126d5ae-6e00-6952-886d-b6a2709aee8b, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		DestroyedBy(S_END_ArmouryDoor_311c45f0-4c10-4762-919a-c89f6d5cd3f5, _, _, _)
		THEN
		SetFlag(END_Armoury_Event_DoorOpens_0126d5ae-6e00-6952-886d-b6a2709aee8b, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		FlagSet(END_Armoury_Event_DoorOpens_0126d5ae-6e00-6952-886d-b6a2709aee8b, _, _)
		AND
		IsDestroyed(S_END_ArmouryDoor_311c45f0-4c10-4762-919a-c89f6d5cd3f5, 0)
		AND
		IsOpened(S_END_ArmouryDoor_311c45f0-4c10-4762-919a-c89f6d5cd3f5, 0)
		THEN
		PROC_ItemUnlockAndOpen(S_END_ArmouryDoor_311c45f0-4c10-4762-919a-c89f6d5cd3f5);
		
		//END_REGION
		
		//REGION Civilians spotting
		
		//If door is opened while the civilians are in dialog, stop spotting.
		IF
		FlagSet(END_Armoury_Event_DoorOpens_0126d5ae-6e00-6952-886d-b6a2709aee8b, _, _)
		AND
		DB_END_Armoury_Civilian(_Character)
		AND
		DB_DialogNPCs(_, _Character, _)
		THEN
		PROC_SpotPlayers_StopSpotting("END_Armoury_Infiltrated");
		
		PROC
		PROC_SpotPlayers_Spotted(_, "END_Armoury_Infiltrated", _Player)
		THEN
		SetFlag(END_Armoury_Event_Spotted_1996c2f9-fe02-4757-34b6-dbb0da34b5c3, NULL_00000000-0000-0000-0000-000000000000, 0);
		PROC_END_Armoury_StartDoorDialog(_Player);
		
		//END_REGION
		
		//REGION Civilians leave
		
		IF
		DialogEnded((DIALOGRESOURCE)END_Armoury_Door_7a02faca-ba91-d8da-f747-7dd765dbfacc, _)
		AND
		DB_GlobalFlag(END_Armoury_Event_CiviliansLeave_82003bc9-3180-e309-71df-1d06f2583b85)
		AND
		DB_END_Armoury_Civilian(_Character)
		THEN
		PROC_CharacterMoveTo(_Character, S_END_ArmouryDisappearPos_60817405-fea0-4bc5-9767-2094c64f7a9a, "Run", "END_Armoury_Disappear");
		
		IF
		EntityEvent(_Character, "END_Armoury_Disappear")
		THEN
		PROC_DisappearOutOfSightTo((CHARACTER)_Character, S_END_ArmouryDisappearDirection_24737e1f-48b2-404d-81a4-32137b60e87a, "Run", 1, "");
		
		//END_REGION
		
		//REGION Dialogue with civilians
		
		IF
		FlagSet(END_ArmouryDoor_Event_CheckMindflayer_05cfdb21-66ba-49a9-3316-1d855a50ee40, _, _)
		AND
		DB_InRegion(_Character, S_END_ArmouryDialogArea_c0e00073-f7ff-4e10-a470-81ea034fdf39)
		AND
		IsTagged(_Character, MINDFLAYER_8ee4d870-3f6b-466c-968f-ab0ba2be6229, 1)
		THEN
		SetFlag(END_ArmouryDoor_State_MindflayerClose_c206e88e-6f41-4892-ac6f-7d21d4642f53, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		DialogEnded(END_Armoury_Door_7a02faca-ba91-d8da-f747-7dd765dbfacc, _)
		AND
		DB_GlobalFlag((FLAG)END_Armoury_Event_DoorOpens_0126d5ae-6e00-6952-886d-b6a2709aee8b)
		THEN
		PROC_TriggerUnregisterForParty(S_END_ArmouryArea_46fc22cd-e7f3-4605-be2d-82bd3ce020fc);
		PROC_TriggerUnregisterForParty(S_END_ArmouryDialogArea_c0e00073-f7ff-4e10-a470-81ea034fdf39);
		
		PROC
		PROC_END_Armoury_StartDoorDialog((CHARACTER)_Player)
		AND
		DB_Players(_Player)
		AND
		NOT QRY_StartDialog_Fixed(END_Armoury_Door_7a02faca-ba91-d8da-f747-7dd765dbfacc, S_END_ArmouryCivilian_001_8e88e13a-093a-47a5-9031-12055f1dff0b, NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000, _Player)
		AND
		DB_GlobalFlag(END_Armoury_Event_DoorOpens_0126d5ae-6e00-6952-886d-b6a2709aee8b)
		THEN
		PROC_SetRelationToPlayers(ACT3_END_ArmouryCivilians_3777498a-441d-443e-a87f-844b7b3c3868, 0); //This is likely becaues the dialog failed because the spotting failed to start it. If the spotting was activated, the civilians are nervous, so start combat.
		PROC_TriggerUnregisterForParty(S_END_ArmouryArea_46fc22cd-e7f3-4605-be2d-82bd3ce020fc);
		PROC_TriggerUnregisterForParty(S_END_ArmouryDialogArea_c0e00073-f7ff-4e10-a470-81ea034fdf39);
		
		PROC
		PROC_END_Armoury_StartDoorDialog((CHARACTER)_Player)
		AND
		NOT DB_Players(_Player)
		AND
		DB_GlobalFlag(END_Armoury_Event_DoorOpens_0126d5ae-6e00-6952-886d-b6a2709aee8b)
		THEN
		PROC_SetRelationToPlayers(ACT3_END_ArmouryCivilians_3777498a-441d-443e-a87f-844b7b3c3868, 0);
		PROC_TriggerUnregisterForParty(S_END_ArmouryArea_46fc22cd-e7f3-4605-be2d-82bd3ce020fc);
		PROC_TriggerUnregisterForParty(S_END_ArmouryDialogArea_c0e00073-f7ff-4e10-a470-81ea034fdf39);
		
		IF
		EnteredTrigger(_PartyMember, S_END_ArmouryDialogArea_c0e00073-f7ff-4e10-a470-81ea034fdf39)
		AND
		NOT DB_Players(_PartyMember)
		AND
		NOT QRY_END_Armoury_InDialog()
		AND
		DB_GlobalFlag(END_Armoury_Event_DoorOpens_0126d5ae-6e00-6952-886d-b6a2709aee8b)
		THEN
		PROC_SetRelationToPlayers(ACT3_END_ArmouryCivilians_3777498a-441d-443e-a87f-844b7b3c3868, 0);
		PROC_TriggerUnregisterForParty(S_END_ArmouryArea_46fc22cd-e7f3-4605-be2d-82bd3ce020fc);
		PROC_TriggerUnregisterForParty(S_END_ArmouryDialogArea_c0e00073-f7ff-4e10-a470-81ea034fdf39);
		
		QRY
		QRY_END_Armoury_InDialog()
		AND
		DB_END_Armoury_Civilian(_Character)
		AND
		DB_DialogNPCs(_ID, _Character, _)
		AND
		DB_DialogName(END_Armoury_Door_7a02faca-ba91-d8da-f747-7dd765dbfacc, _ID)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)END_Armoury_Door_7a02faca-ba91-d8da-f747-7dd765dbfacc, _ID)
		AND
		DB_END_Armoury_Civilian(_Character)
		AND
		_Character != S_END_ArmouryCivilian_001_8e88e13a-093a-47a5-9031-12055f1dff0b //Instigator
		THEN
		PROC_DialogAddSpeakingActor(_ID, _Character);
		
		IF
		FlagSet((FLAG)END_Armoury_Event_Reward_d35f3a6a-dc18-a677-5690-ba0ee5802327, _, _)
		THEN
		PROC_END_Armoury_ApplyDeathWard();
		
		PROC
		PROC_END_Armoury_ApplyDeathWard()
		AND
		DB_Players(_Player)
		AND
		DB_InRegion(_Player, S_END_ArmouryDialogArea_c0e00073-f7ff-4e10-a470-81ea034fdf39)
		AND
		IsTagged(S_GLO_Orpheus_47c90728-af68-4cbc-baaa-6497eebd8d7e, FULL_CEREMORPH_3797bfc4-8004-4a19-9578-61ce0714cc0b, 0)
		THEN
		ApplyStatus(_Player, "DEATH_WARD", -1.0);
		
		PROC
		PROC_END_Armoury_ApplyDeathWard()
		AND
		DB_InRegion(S_GLO_Orpheus_47c90728-af68-4cbc-baaa-6497eebd8d7e, S_END_ArmouryDialogArea_c0e00073-f7ff-4e10-a470-81ea034fdf39)
		AND
		IsTagged(S_GLO_Orpheus_47c90728-af68-4cbc-baaa-6497eebd8d7e, FULL_CEREMORPH_3797bfc4-8004-4a19-9578-61ce0714cc0b, 0)
		THEN
		ApplyStatus(S_GLO_Orpheus_47c90728-af68-4cbc-baaa-6497eebd8d7e, "DEATH_WARD", -1.0);
		
		//END_REGION
	}
	EXIT
	{
	}
}
