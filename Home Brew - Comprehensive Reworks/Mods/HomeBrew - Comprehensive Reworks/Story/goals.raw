		PROC_CapturedGoblin_SelectGrieflingDialog((CHARACTER)_Player)
		AND
		DB_Dialogs(S_DEN_Griefling_7ce0afc2-e8f2-4f2e-82d8-27df98acc3d8, _Dialog)
		AND
