		DB_LOW_MindflayerOutburst_Bystanders(S_LOW_BaldursMouth_PaperBoy_SteepsStrake_5ab6a835-3ba8-430b-a1b0-01df2bdc8204,S_LOW_MindflayerOutburst_Harbour_Trigger_1f3c8794-115a-4db6-bedd-d2709b12a7bb);
		
		// Basilisk Gate
		DB_LOW_MindflayerOutburst_Bystanders(S_LOW_EastwayFoodCrisis_Fist_af5e9de3-2f45-41bc-8406-fac8cb87b5f1,S_LOW_MindflayerOutburst_BasiliskGate_Trigger_e503ee98-c2de-4a19-a41a-c50207adc4d9);
		DB_LOW_MindflayerOutburst_Bystanders(S_LOW_EastwayFoodCrisis_Farmer1_f0d860ed-5845-4253-b556-7be19f895ab8,S_LOW_MindflayerOutburst_BasiliskGate_Trigger_e503ee98-c2de-4a19-a41a-c50207adc4d9);
		DB_LOW_MindflayerOutburst_Bystanders(S_LOW_EastwayFoodCrisis_Farmer4_2ce3c7e0-af4a-4cba-af0b-8dec1fe05131,S_LOW_MindflayerOutburst_BasiliskGate_Trigger_e503ee98-c2de-4a19-a41a-c50207adc4d9);
		DB_LOW_MindflayerOutburst_Bystanders(S_LOW_EastwayFoodCrisis_Farmer2_13e47a4f-5485-4cd5-b879-c29c2e3d3137,S_LOW_MindflayerOutburst_BasiliskGate_Trigger_e503ee98-c2de-4a19-a41a-c50207adc4d9);
		DB_LOW_MindflayerOutburst_Bystanders(S_LOW_EastwayFoodCrisis_Farmer3_2388f62a-768c-41d8-a15f-37d55ff4cefe,S_LOW_MindflayerOutburst_BasiliskGate_Trigger_e503ee98-c2de-4a19-a41a-c50207adc4d9);
		DB_LOW_MindflayerOutburst_Bystanders(S_LOW_BasiliskGate_LeaningMan_001_e2a56ba0-212b-48ee-8b79-c6a7f93f7f3e,S_LOW_MindflayerOutburst_BasiliskGate_Trigger_e503ee98-c2de-4a19-a41a-c50207adc4d9);
		DB_LOW_MindflayerOutburst_Bystanders(S_LOW_EastwayRelief_TravelerA_02f73074-a8e7-40a4-9afc-910cd0d4433f,S_LOW_MindflayerOutburst_BasiliskGate_Trigger_e503ee98-c2de-4a19-a41a-c50207adc4d9);
