		DB_GLO_TutorialEvents_ShortRestReplenishables((TUTORIALEVENT)ShortRest_Replenishable_Depleted_TidesOfChaos_7b0bc238-b79b-48ac-ab2c-25dcac4b5ecb);
		DB_GLO_TutorialEvents_ShortRestReplenishables((TUTORIALEVENT)ShortRest_Replenishable_Depleted_ChannelOath_a3bbfbf9-ecd1-46d9-b4a9-806499906516);
		DB_GLO_TutorialEvents_LongRestReplenishables((TUTORIALEVENT)LongRest_Replenishable_Depleted_SpellSlot_1a3badec-559e-48aa-b7ec-9c0fbe5d7db2);
		DB_GLO_TutorialEvents_LongRestReplenishables((TUTORIALEVENT)LongRest_Replenishable_Depleted_Rage_683fa75d-0bd6-4689-9f20-0bbfd576003d);
		DB_GLO_TutorialEvents_LongRestReplenishables((TUTORIALEVENT)LongRest_Replenishable_Depleted_BardicInspiration_0fa1c8b8-3af9-4170-9f96-ee101374c5c1);
		DB_GLO_TutorialEvents_LongRestReplenishables((TUTORIALEVENT)LongRest_Replenishable_Depleted_SorceryPoints_b2f00188-8c55-4bbe-808a-85b9c6a80df8);
		DB_GLO_TutorialEvents_LongRestReplenishables((TUTORIALEVENT)LongRest_Replenishable_Depleted_ArcaneRecoveryPoint_13cab713-ec3c-4dd2-b22c-768d91b732f3);
		DB_GLO_TutorialEvents_LongRestReplenishables((TUTORIALEVENT)LongRest_Replenishable_Depleted_NaturalRecoveryPoint_28013c51-9790-4393-8309-e7dbf88dfc15);
		DB_GLO_TutorialEvents_LongRestReplenishables((TUTORIALEVENT)LongRest_Replenishable_Depleted_RitualPoint_c88773bb-c9a0-475b-bf4c-0dcbc5a6e87f);
		DB_GLO_TutorialEvents_LongRestReplenishables((TUTORIALEVENT)LongRest_Replenishable_Depleted_LayOnHandsCharge_b47e970a-2bbf-45af-b197-b7aee34438d5);
		DB_GLO_TutorialEvents_LongRestReplenishables((TUTORIALEVENT)LongRest_Replenishable_Depleted_WarPriestActionPoint_f93527f2-b09e-4d5a-b78c-0dbf5ef58141);
		DB_GLO_TutorialEvents_LongRestReplenishables((TUTORIALEVENT)LongRest_Replenishable_Depleted_LuckPoint_b3e26425-abf9-4392-a9bd-fdab94a1dfda);
	}
	KB
	{
		//REGION Init
		IF 
		DB_GLO_Tutorials_UnusedEvents(_Event)
		THEN
		PROC_GLO_Tutorials_DisableTutorialEventsForUsers(_Event);
		
		//Some of these might cause trouble in CC
		IF 
		DB_GLO_Tutorials_TutorialEvents_AnyLevel(_Event)
		THEN
		PROC_GLO_Tutorials_DisableTutorialEventsForUsers(_Event);
		
		//Re-nable after CC
		IF
		LevelLoaded(_Level)
		AND
		IsGameLevel(_Level, 1)
		AND
		DB_GLO_Tutorials_TutorialEvents_AnyLevel(_Event)
		THEN
		PROC_GLO_Tutorials_EnableTutorialEventsForUsers(_Event);
		//END_REGION Init
		
		
		//REGION Individual event observers
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)AttackHit_Immunity_66906aed-8915-4f03-88a7-c4fc8d506a77)
		AND
		QRY_GLO_Tutorials_IsAfterHelmFightStart()
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)AttackHit_Immunity_66906aed-8915-4f03-88a7-c4fc8d506a77);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)AttackHit_Vulnerable_8d5b5b23-814d-4f3a-92f7-73c868dc20f4)
		AND
		QRY_GLO_Tutorials_IsAfterHelmFightStart()
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)AttackHit_Vulnerable_8d5b5b23-814d-4f3a-92f7-73c868dc20f4);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)AttackHit_Resistance_4a219633-8b74-41b5-9aa3-237b75fcbd49)
		AND
		QRY_GLO_Tutorials_IsAfterHelmFightStart()
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)AttackHit_Resistance_4a219633-8b74-41b5-9aa3-237b75fcbd49);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)AttackOfOpportunity_f658a860-7e3e-44fd-807b-88d3c0c31217)
		AND
		QRY_GLO_Tutorials_IsAfterHelmFightStart()
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)AttackOfOpportunity_f658a860-7e3e-44fd-807b-88d3c0c31217);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)Inspiration_Gained_f033b6a0-9298-4f86-b17f-c8683892be8a)
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)Inspiration_Gained_f033b6a0-9298-4f86-b17f-c8683892be8a);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)Multiclass_Opened_903e0cfe-5bf3-42c3-95ad-869318c638b5)
		AND
		DB_ActiveLevel(_LevelName)
		AND
		IsGameLevel(_LevelName, 1)
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)Multiclass_Opened_903e0cfe-5bf3-42c3-95ad-869318c638b5);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)CombatLog_Expanded_158714b2-749d-4b92-96b8-3590922dcc2c)
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)CombatLog_Expanded_158714b2-749d-4b92-96b8-3590922dcc2c);
		
		IF
		TutorialEvent((CHARACTER)_Player, (TUTORIALEVENT)TadpolePowersTree_Opened_cc289292-2ed5-4d60-bb37-386726323b8c)
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)TadpolePowersTree_Opened_cc289292-2ed5-4d60-bb37-386726323b8c);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)Dialogue_Listen_c01b74a1-7ff2-41da-885a-3fe0152d7775)
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)Dialogue_Listen_c01b74a1-7ff2-41da-885a-3fe0152d7775);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)HotbarSlot_Item_Removed_860a80b4-48eb-4ea2-8037-eb8fee3ad6dd)
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)HotbarSlot_Item_Removed_860a80b4-48eb-4ea2-8037-eb8fee3ad6dd);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)HotbarSlot_Spell_Removed_1fc4a8f3-5db1-4704-9d8b-323562fc279c)
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)HotbarSlot_Spell_Removed_1fc4a8f3-5db1-4704-9d8b-323562fc279c);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)DualWielding_Active_630445cb-2845-4dc0-b7cc-36eb615e470a)
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)DualWielding_Active_630445cb-2845-4dc0-b7cc-36eb615e470a);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)UserAction_ActiveSearch_Activated_7af4bc1f-0eed-44d5-88d4-f856b20aaecb)
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)UserAction_ActiveSearch_Activated_7af4bc1f-0eed-44d5-88d4-f856b20aaecb);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)UserAction_CameraTargetMode_Activated_f4d715ca-7b0f-4598-acf2-81d7aa0744f0)
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)UserAction_CameraTargetMode_Activated_f4d715ca-7b0f-4598-acf2-81d7aa0744f0);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)UserAction_TargetCycleCombat_Activated_7a0c0344-8bfd-410a-8664-247ba4b2e012)
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)UserAction_TargetCycleCombat_Activated_7a0c0344-8bfd-410a-8664-247ba4b2e012);
		SetTutorialShown(_Player, (UNIFIEDTUTORIAL)Target_Cycling__Enemies__2707a1ee-a1a4-412e-9192-48309dfe7345);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)UserAction_TargetCycleWorld_Activated_505a36f9-e9a3-45e2-a1b9-778fd9589118)
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)UserAction_TargetCycleWorld_Activated_505a36f9-e9a3-45e2-a1b9-778fd9589118);
		SetTutorialShown(_Player, (UNIFIEDTUTORIAL)Target_Cycling__Items__384d29df-237b-4b0d-af51-bcfd5571be33);
		
		//Camera Movement Tutorial + Center View on Character Tutorial
		//Used by multiple tutorials -> disabled elsewhere
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)UserAction_CameraMove_33b6c863-0575-470b-b7aa-d91cc82132f8)
		THEN
		SetTutorialShown(_Player, (UNIFIEDTUTORIAL)Camera_Movement_211b326e-4f31-4622-bfdb-07d6d5491ce7);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)UserAction_CameraRotate_af1cba9d-9bfe-440f-971d-d6e0213c428d)
		THEN
		SetTutorialShown(_Player, (UNIFIEDTUTORIAL)Camera_Rotation_27b3873b-0353-4284-b901-32edbcfa9fe1);
		DisableTutorialEvent(_Player, (TUTORIALEVENT)UserAction_CameraRotate_af1cba9d-9bfe-440f-971d-d6e0213c428d);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)UserAction_CameraAtLeashLimit_ff54d87c-c574-45af-abf3-9b76e16b9ee2)
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)UserAction_CameraAtLeashLimit_ff54d87c-c574-45af-abf3-9b76e16b9ee2);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)PartyPanel_Opened_b3c925a4-6317-45f8-99c0-4ca42e3ef36b)
		THEN
		SetTutorialShown(_Player, (UNIFIEDTUTORIAL)Party_Inventory_bb14da73-4205-41b8-b911-8a3adc8b1850);
		DisableTutorialEvent(_Player, (TUTORIALEVENT)PartyPanel_Opened_b3c925a4-6317-45f8-99c0-4ca42e3ef36b);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)SendToCamp_0204e362-7cbe-4d8b-b2d6-1884e5ff00e0)
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)SendToCamp_0204e362-7cbe-4d8b-b2d6-1884e5ff00e0);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)TradeMode_Changed_4eff1cb5-03b4-4aec-9774-bf416f43d331)
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)TradeMode_Changed_4eff1cb5-03b4-4aec-9774-bf416f43d331);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)ActiveRoll_Advantage_8ba90ebb-cf5c-4c18-bd50-9657e11d0b2d)
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)ActiveRoll_Advantage_8ba90ebb-cf5c-4c18-bd50-9657e11d0b2d);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)ActiveRoll_Disadvantage_32516c6a-a8e1-44e9-b053-5ba29ab36792)
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)ActiveRoll_Disadvantage_32516c6a-a8e1-44e9-b053-5ba29ab36792);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)UserAction_DisplayWorldTooltips_26c70aed-2b7b-4562-baeb-c48d45f4879e)
		AND
		DB_ActiveLevel(_LevelName)
		AND
		_LevelName != "WLD_Main_A"
		AND
		_LevelName != "TUT_Avernus_C"
		AND
		IsGameLevel(_LevelName, 1)
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)UserAction_DisplayWorldTooltips_26c70aed-2b7b-4562-baeb-c48d45f4879e);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)ActiveRoll_Dialog_b8f0af40-db07-4d52-a4a7-b66ce8ec5325)
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)ActiveRoll_Dialog_b8f0af40-db07-4d52-a4a7-b66ce8ec5325);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)ReactionDecision_Opened_1a3c4bbd-4db8-4c58-9620-f1f78d57c964)
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)ReactionDecision_Opened_1a3c4bbd-4db8-4c58-9620-f1f78d57c964);
		
		IF
		TutorialEvent(_Player, (TUTORIALEVENT)UserAction_CameraTrackPlayer_f195e6ce-e327-4d32-9749-0b88458fd849)
		THEN
		DisableTutorialEvent(_Player, (TUTORIALEVENT)UserAction_CameraTrackPlayer_f195e6ce-e327-4d32-9749-0b88458fd849);
		//END_REGION Individual event observers
		
		//REGION Mass disablers
		IF //they get re-activated after tutorials reset
		TutorialEvent(_Player, _UnusedEvent)
		AND
		DB_GLO_Tutorials_UnusedEvents(_UnusedEvent)
		AND
		DB_GLO_Tutorials_UnusedEvents(_AllUnusedEvents)
		THEN
		PROC_GLO_Tutorials_DisableTutorialEventsForUsers(_AllUnusedEvents);
		
		IF
		TutorialEvent(_Player, _TUT_Event)
		AND
		DB_GLO_Tutorials_TutorialEvents_TUTOnly(_TUT_Event)
		AND
		DB_ActiveLevel(_Level)
		AND
		_Level != "TUT_Avernus_C"
		AND
		IsGameLevel(_Level, 1)
		AND
		DB_GLO_Tutorials_TutorialEvents_TUTOnly(_TUT_Events_All)
		THEN
		PROC_GLO_Tutorials_DisableTutorialEventsForUsers(_TUT_Events_All);
		//END_REGION Mass disablers
		
		
		//REGION Helpers
		PROC
		PROC_GLO_Tutorials_DisableTutorialEventsForUsers((TUTORIALEVENT)_Event)
		AND
		DB_Players(_Player)
		THEN
		DisableTutorialEvent(_Player, _Event);
		
		PROC
		PROC_GLO_Tutorials_EnableTutorialEventsForUsers((TUTORIALEVENT)_Event)
		AND
		DB_Players(_Player)
		THEN
		EnableTutorialEvent(_Player, _Event);
		//END_REGION
	}
	EXIT
	{
	}
}
