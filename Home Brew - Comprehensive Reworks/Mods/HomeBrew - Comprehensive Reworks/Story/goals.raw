		DB_ShadowStoneShadows((CHARACTER)S_TWN_ArabellaPower_DeadShadow_1_be1d10fc-d50d-472c-ac1f-afba5d558b97,(DIALOGRESOURCE)SCL_AD_ShadowMemory23_8eb7724f-1cfb-f569-8832-da0dc8fbb128, "TWN_ArabellaPowers");
		DB_ShadowStoneShadows((CHARACTER)S_TWN_ArabellaPower_DeadShadow_2_c94576db-572f-481f-a75b-f8c719b50600,(DIALOGRESOURCE)SCL_AD_ShadowMemory24_178b263b-a8ba-1d4f-2d57-f91b7600970d, "TWN_ArabellaPowers");
		
		DB_ShadowStoneShadows((CHARACTER)S_TWN_CentralSquare_Shadows_Shadow_01_810ebf58-3b08-4664-9a52-3915f0801a8a,(DIALOGRESOURCE)SCL_AD_ShadowMemory31_40a7c95f-6d8f-e012-c0c3-e9367243a36d, "TWN_CentralSquare");
		DB_ShadowStoneShadows((CHARACTER)S_TWN_CentralSquare_Shadows_Shadow_02_b33cd839-9bbf-441e-bbba-a21b9ff2a33c,(DIALOGRESOURCE)SCL_AD_ShadowMemory32_75327e3f-6bd7-9a2a-c683-f1f6a94f43db, "TWN_CentralSquare");
		DB_ShadowStoneShadows((CHARACTER)S_TWN_CentralSquare_Shadows_Shadow_03_1caca0a2-f41d-4699-a10b-4b961f39d529,(DIALOGRESOURCE)SCL_AD_ShadowMemory33_474dcbee-4e6e-fdcb-4ce1-72eb2c3c0dcb, "TWN_CentralSquare");
		
		DB_GLO_DefeatCounter_AllPermaDefeatedGlobalFlag("TWN_MasonsGuild_RebelHideout", TWN_MasonsGuild_RebelHideout_State_Cleared_e67e4bf3-ba34-4411-8745-ea00c5d040a4);
	}
	KB
	{
		IF
		Dying(_Shadow)
		AND
		DB_ShadowStoneShadows(_Shadow,_Dialogue,_)
		AND
		CreateAtObject(UNI_Quest_ShadowStone_5c6904cc-5bb0-4ed9-a97c-b2df9aa2a9b6,_Shadow,0,0,"",0,_Shadowstone)
		AND
		GetPosition(_Shadow,_X,_Y,_Z)
		AND
		FindValidPosition(_X,_Y,_Z,3.0,_Shadowstone,0,_StoneX,_StoneY,_StoneZ)
		THEN
		TeleportToPosition(_Shadowstone,_StoneX,_StoneY,_StoneZ);
		DB_ItemDialog_NarratorAD((ITEM)_Shadowstone, (DIALOGRESOURCE)_Dialogue);
		
		IF
		Died(_Shadow)
		AND
		DB_ShadowStoneShadows(_Shadow,_,_)
		THEN
		SetOnStage(_Shadow,0);
		
		PROC
		PROC_CleanupShadowStones()
		AND
		DB_ShadowStoneShadows(_Stone,_Dialogue,_)
		AND
		DB_ItemDialog_NarratorAD(_Item,_Dialogue)
		THEN
		NOT DB_ItemDialog_NarratorAD(_Item,_Dialogue);
		
		PROC
		PROC_CleanupShadowStones()
		AND
		DB_ShadowStoneShadows(_Stone,_Dialogue,_ID)
		THEN
		NOT DB_ShadowStoneShadows(_Stone,_Dialogue,_ID);
		
		IF
		DB_ShadowStoneShadows(_Char, _, "TWN_MasonsGuild_RebelHideout")
		THEN
		DB_GLO_DefeatCounter(_Char, "TWN_MasonsGuild_RebelHideout");
		SetAmbushing(_Char, 1);
		
		IF
		EnteredCombat((CHARACTER)_Char, _)
		AND
		DB_ShadowStoneShadows(_Char, _, "TWN_MasonsGuild_RebelHideout")
		THEN
		SetAmbushing(_Char, 0);
	}
	EXIT
	{
		PROC_CleanupShadowStones();
	}
}
