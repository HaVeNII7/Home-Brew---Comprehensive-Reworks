		DB_ORI_OriginCampData((CHARACTER)S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679,"INTMAIN",(TRIGGER)S_CAMP_Shadowheart_A_ca065702-0ddc-8047-55c2-c9c179feade6);
		DB_ORI_OriginCampData((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, "INTMAIN", (TRIGGER)S_CAMP_Wyll_A_8f0f4ef3-d312-8883-2460-8b1b8e178aa1);
		DB_ORI_OriginCampData((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, "INTMAIN", (TRIGGER)S_CAMP_Laezel_A_b053993b-0ba0-83d7-1835-8dc448beff7d);
		DB_ORI_OriginCampData((CHARACTER)S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a, "INTMAIN", (TRIGGER)S_CAMP_Jaheira_A_9efc08a6-5e27-8b78-25f0-90148ea16991); 
		DB_ORI_OriginCampData((CHARACTER)S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, "INTMAIN", (TRIGGER)S_CAMP_Minthara_A_76a2a125-07bd-8a90-1c49-52808393889b);
		//END_REGION
		
		//REGION In Party dialog fix DB for Jaheira/Halsin
		//DB_INT_RestoreInPartyDialog(S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a, Jaheira_InParty_e97481ba-961c-50a7-c54f-d34d6b75044d);
		//DB_INT_RestoreInPartyDialog(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, Halsin_InParty_890c2586-6b71-ca01-5bd6-19d533181c71);
		//END_REGION
		
		// Volo's note for when he leaves on entering Intermezzo in case he's a camper and the operation hasn't been resolved yet
		PROC_SetOnStage(S_GLO_VolosNote_LeftIntermezzo_93fd46f0-aab5-48d2-88ef-9b841b36fa1a,0);
		
		DB_IgnoreMutingStatussesDialog((DIALOGRESOURCE)INT_GithyankiAmbush_ArriveIntermezzo_4ee4a046-14f5-db6e-0cf1-23e9b6af8bfa);
		DB_DialogStarted_IgnoreStopConditions((DIALOGRESOURCE)INT_GithyankiAmbush_ArriveIntermezzo_4ee4a046-14f5-db6e-0cf1-23e9b6af8bfa);
	}
	KB
	{
		IF
		TextEvent("ArriveInt")
		AND
		DB_Players(_Player)
		AND
		QRY_StartDialog((DIALOGRESOURCE)INT_MeanwhileInTheCity_2717ea84-47b7-d97d-d335-639a1013a876, S_GLO_Orin_bf24e0ec-a3a6-4905-bd2d-45dc8edf8101, S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, S_INT_FlamingFist_01_a60fe1c1-033f-4b04-83c1-1e04aee949cd, _Player)
		THEN
		DB_NOOP(1);
		
		IF
		LevelLoaded("INT_Main_A")
		THEN
		SetFlag((FLAG)CURRENTREGION_INT_Main_A_7f78a1d7-3e5e-4cd2-8fcd-f751b01c0ee0,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_GlobalSetFlagAndCache((FLAG)VISITEDREGION_INT_Main_A_a2e1a618-d211-484e-9389-6b37308b8da1);
		
		IF
		LevelUnloading("INT_Main_A")
		THEN
		NOT DB_Camp_NightMode(1);
		ClearFlag((FLAG)CURRENTREGION_INT_Main_A_7f78a1d7-3e5e-4cd2-8fcd-f751b01c0ee0,NULL_00000000-0000-0000-0000-000000000000,0);
		
		//Teleporting out of camp (Astral Plane) in the middle of the night should be supported in Intermezzo
		QRY
		QRY_Camp_PreventEmptyCampAtNightSafetyCheck()
		AND
		DB_CurrentLevel("INT_Main_A")
		THEN
		DB_NOOP(1);
		
		//Custom Inclusion Implementation
		
		QRY
		QRY_Inclusion_SpeakerIsAvailableForInclusion((DIALOGRESOURCE)INT_GithyankiAmbush_ArriveIntermezzo_4ee4a046-14f5-db6e-0cf1-23e9b6af8bfa, (INTEGER)_Instance, (CHARACTER)_NPC, (CHARACTER)_Player)
		AND
		QRY_SpeakerIsAvailable(_NPC, 1)
		AND
		DB_PartyMembers(_NPC)
		AND
		NOT DB_Avatars(_NPC)
		AND
		NOT DB_DismissedAvatar(_NPC)
		AND
		DB_Avatars(_Player)
		THEN
		DB_NOOP(1);
		
		//REGION Debug Setup
		PROC
		PROC_Debug_INT_PopulateCampnightDBs()
		AND
		DB_GlobalFlag((FLAG)INT_EmperorRevealed_State_AfterOrpheus_96b5ce4b-fbff-400d-9894-13f0b2e8b268) //This set in the debugbook.
		THEN
		DB_OnlyOnce("OrbExplodes");
		DB_INT_DebugSkip(1);
		
		PROC
		PROC_Debug_INT_PopulateCampnightDBs()
		AND
		DB_INT_DebugSkip(1)
		THEN
		DB_INT_ReadyToLeave(1);
		//END_REGION
		
		//REGION Specific Night Logic - ArriveIntermezzo
		IF
		DialogEnded((DIALOGRESOURCE)INT_MeanwhileInTheCity_2717ea84-47b7-d97d-d335-639a1013a876, _ID)
		AND
		DB_Players(_MainPlayer)
		AND
		QRY_OnlyOnce("INT_InitialForcedCamp")
		THEN
		PROC_Camp_ForceEndTheDay((CHARACTER)_MainPlayer,"INTMAIN");
		
		PROC
		PROC_CampNight_StartSelected()
		AND
		DB_Camp_QueuedNight((FLAG)NIGHT_ArriveIntermezzo_d569aaf3-79f2-4313-98c3-6b50283b7db7)
		AND
		DB_Avatars(_Avatar)
		AND
		QRY_StartDialog((DIALOGRESOURCE)INT_GithyankiAmbush_ArriveIntermezzo_4ee4a046-14f5-db6e-0cf1-23e9b6af8bfa, _Avatar)
		THEN
		DB_Camp_PreventEndOfNight(1);
		DB_Camp_StayInCampAfterLongRest(1);
		
		IF
		DialogStarted((DIALOGRESOURCE)INT_GithyankiAmbush_ArriveIntermezzo_4ee4a046-14f5-db6e-0cf1-23e9b6af8bfa, _ID)
		AND
		DB_Players(_Players)
		THEN
		BlockFlee(_Players);
		
		IF
		DialogEnded((DIALOGRESOURCE)INT_EmperorRevealed_WokenUpAtNight_SCO_2dd56c1b-66b0-5c6e-00d3-e6fdd5cab379, _ID)
		AND
		DB_Players((CHARACTER)_Player)
		THEN
		RestoreParty((CHARACTER)_Player);
		RemoveHarmfulStatuses(_Player);
		
		IF
		DialogEnded((DIALOGRESOURCE)INT_GithyankiAmbush_ArriveIntermezzo_4ee4a046-14f5-db6e-0cf1-23e9b6af8bfa, _ID)
		THEN
		PROC_Debug_INT_PopulateCampnightDBs();
		
		IF
		DialogEnded((DIALOGRESOURCE)INT_GithyankiAmbush_ArriveIntermezzo_4ee4a046-14f5-db6e-0cf1-23e9b6af8bfa, _ID)
		THEN
		TimerLaunch("INT_Arrival_AutoSave", 1000);
		
		IF
		TimerFinished("INT_Arrival_AutoSave")
		THEN
		PROC_GLO_TryAutosave();
		
		QRY
		QRY_Camp_SleepCutsceneOverride_CustomDialogStart((DIALOGRESOURCE)INT_EmperorRevealed_WokenUpAtNight_SCO_2dd56c1b-66b0-5c6e-00d3-e6fdd5cab379,(CHARACTER)_Player,(CHARACTER)_Player2,(CHARACTER)_Player3,(CHARACTER)_Player4)
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)INT_EmperorRevealed_WokenUpAtNight_SCO_2dd56c1b-66b0-5c6e-00d3-e6fdd5cab379,(CHARACTER)_Player,(CHARACTER)_Player2,(CHARACTER)_Player3,(CHARACTER)_Player4,S_GLO_ThrallOfTheAbsolute_AbsoluteHelper_15d4bd12-855b-4483-a2e5-661bfeb96d1f)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_Debug_INT_PopulateCRDs()
		AND
		NOT DB_INT_DebugSkip(1)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Gale_State_ReactedElderBrain_be06e142-c83f-387b-b6e3-da74517f786c)
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604)
		THEN
		DB_CampNight_CRD((FLAG)NIGHT_ArriveIntermezzo_d569aaf3-79f2-4313-98c3-6b50283b7db7, (CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, (DIALOGRESOURCE)INT_ORI_Gale_CRD_CrownOfKarsus_d61e7a6c-adde-2f37-447b-c096acc045e5,(FLAG)ORI_Gale_IPRD_Act2End_05706143-82c3-616d-6850-9281f08c9b9f);
		PROC_CampRelationshipDialog((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, (DIALOGRESOURCE)INT_ORI_Gale_CRD_CrownOfKarsus_d61e7a6c-adde-2f37-447b-c096acc045e5, (FLAG)ORI_Gale_IPRD_Act2End_05706143-82c3-616d-6850-9281f08c9b9f, 0);
		PROC_Try_CampRelationshipDialog((CHARACTER)S_Player_Gale_ad9af97d-75da-406a-ae13-7071c563f604, 1);
		
		PROC
		PROC_Debug_INT_PopulateCRDs()
		AND
		NOT DB_INT_DebugSkip(1)
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		THEN
		DB_CampNight_CRD((FLAG)NIGHT_ArriveIntermezzo_d569aaf3-79f2-4313-98c3-6b50283b7db7, (CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, (DIALOGRESOURCE)Astarion_InParty_53aba16e-55bb-a0fc-a444-522e237dbe46, (FLAG)ORI_Astarion_State_NeedsToDiscussCazadorAfterSCL_3c1b76cd-6d29-4780-b1b0-cfb5ffbb7bf6);
		PROC_CampRelationshipDialog((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, (DIALOGRESOURCE)Astarion_InParty_53aba16e-55bb-a0fc-a444-522e237dbe46, (FLAG)ORI_Astarion_State_NeedsToDiscussCazadorAfterSCL_3c1b76cd-6d29-4780-b1b0-cfb5ffbb7bf6, 0);
		PROC_Try_CampRelationshipDialog((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, 1);
		
		PROC
		PROC_Debug_INT_PopulateCRDs()
		AND
		NOT DB_INT_DebugSkip(1)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Karlach_State_BlockFacingDeath_2c251f2e-93fc-a5ac-e90f-f489b7847813)
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		THEN
		DB_CampNight_CRD((FLAG)NIGHT_ArriveIntermezzo_d569aaf3-79f2-4313-98c3-6b50283b7db7, (CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)CAMP_Karlach_CRD_FacingDeath_ac41b9da-c61c-aefc-d82f-91744f88b3e6,(FLAG)NULL_00000000-0000-0000-0000-000000000000);
		PROC_CampRelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, (DIALOGRESOURCE)CAMP_Karlach_CRD_FacingDeath_ac41b9da-c61c-aefc-d82f-91744f88b3e6, (FLAG)NULL_00000000-0000-0000-0000-000000000000, 0);
		PROC_Try_CampRelationshipDialog((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, 1);
		
		PROC
		PROC_Debug_INT_PopulateCampnightDBs()
		AND
		NOT DB_INT_DebugSkip(1)
		THEN
		DB_CampNight((FLAG)NIGHT_ArriveIntermezzo_d569aaf3-79f2-4313-98c3-6b50283b7db7,7150);
		DB_CampNight_Camp((FLAG)NIGHT_ArriveIntermezzo_d569aaf3-79f2-4313-98c3-6b50283b7db7,"INTMAIN");
		DB_CampNight_SCO((FLAG)NIGHT_ArriveIntermezzo_d569aaf3-79f2-4313-98c3-6b50283b7db7, (DIALOGRESOURCE)INT_EmperorRevealed_WokenUpAtNight_SCO_2dd56c1b-66b0-5c6e-00d3-e6fdd5cab379);
		PROC_Debug_INT_PopulateCRDs();
		//END_REGION
		
		//REGION Fixes Jaheira and Halsin's Dialogs if they were in the Party before SCE/INT
		IF
		LevelGameplayStarted("INT_Main_A", _)
		AND
		DB_SCE_Debrief_RemovedPartyMembers(_Player)
		THEN
		PROC_ORI_SetupCamp(_Player);
		NOT DB_SCE_Debrief_RemovedPartyMembers(_Player);
		
		IF
		DB_PartOfTheTeam(_Character)
		AND
		DB_SCE_Debrief_RemovedPartyMembers(_Character)
		THEN
		NOT DB_SCE_Debrief_RemovedPartyMembers(_Character);
		//END_REGION
		
		//REGION Volo leaves camp if the operation hasn't been resolved until Intermezzo
		IF
		DB_CurrentLevel("INT_Main_A")
		AND
		DB_GlobalFlag((FLAG)GLO_Volo_State_AtCamp_de1cadca-2eca-4cee-a3dc-e262bbb92277)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_Volo_State_LeftAfterOperation_fec19c09-93c5-40f3-a6e9-b242076e68bf)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_Volo_State_VoloLeftCampWithNote_12ff6177-2744-4040-a4a5-6e50d3801e01)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)GLO_Volo_State_VoloLeftCampWithNote_12ff6177-2744-4040-a4a5-6e50d3801e01);
		
		IF
		FlagSet((FLAG)GLO_Volo_State_VoloLeftCampWithNote_12ff6177-2744-4040-a4a5-6e50d3801e01,_,_)
		THEN
		// Check as he has no map spot in INT_main
		PROC_NotifyWhenReadyToMoveOn(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"CAMP_VoloLeaving");
		PROC_SetOnStage(S_GLO_VolosNote_LeftIntermezzo_93fd46f0-aab5-48d2-88ef-9b841b36fa1a,1);
		
		IF
		MovedBy(S_GLO_VolosNote_LeftIntermezzo_93fd46f0-aab5-48d2-88ef-9b841b36fa1a,_Player)
		AND
		DB_Players((CHARACTER)_Player)
		THEN
		SetFlag((FLAG)GLO_Volo_State_PlayersFoundCampNote_5be59d18-926a-4629-ac9f-ee484ce36e73);
		
		IF
		UseFinished(_Player,(ITEM)S_GLO_VolosNote_LeftIntermezzo_93fd46f0-aab5-48d2-88ef-9b841b36fa1a,_)
		AND
		DB_Players(_Player)
		THEN
		SetFlag((FLAG)GLO_Volo_State_PlayersFoundCampNote_5be59d18-926a-4629-ac9f-ee484ce36e73);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)INT_GithyankiAmbush_ArriveIntermezzo_4ee4a046-14f5-db6e-0cf1-23e9b6af8bfa, _ID)
		AND
		DB_Players(_Player)
		THEN
		DialogAddActorAtReservedSlot(_ID, _Player, 1, 1, 1);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)INT_GithyankiAmbush_ArriveIntermezzo_4ee4a046-14f5-db6e-0cf1-23e9b6af8bfa, _ID)
		AND
		DB_Players(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b)
		AND
		QRY_SpeakerIsAvailable(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b)
		THEN
		PROC_DialogAddListeningActor(_ID, S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)INT_GithyankiAmbush_ArriveIntermezzo_4ee4a046-14f5-db6e-0cf1-23e9b6af8bfa, _ID)
		AND
		QRY_SpeakerIsAvailable(S_GLO_Nightsong_6c55edb0-901b-4ba4-b9e8-3475a8392d9b)
		THEN
		PROC_DialogAddSpeakingActor(_ID, S_GLO_Nightsong_6c55edb0-901b-4ba4-b9e8-3475a8392d9b);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)INT_GithyankiAmbush_ArriveIntermezzo_4ee4a046-14f5-db6e-0cf1-23e9b6af8bfa, _ID)
		AND
		QRY_SpeakerIsAvailable(S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211)
		THEN
		PROC_DialogAddSpeakingActor(_ID, S_GLO_Isobel_263bfbfc-6160-46f4-a9e1-1089cdb5c211);
		//END_REGION
	}
	EXIT
	{
	}
}
