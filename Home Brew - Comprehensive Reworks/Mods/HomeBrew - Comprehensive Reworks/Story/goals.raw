		PROC
		PROC_GlobalFlagReactionAfterDialog(ORI_WyllConfrontation_State_WyllLeftHostile_823f4d26-f3e7-44b3-aea6-4b953c071601, _Dialog)
		THEN
		PROC_Origins_CompanionLeavePermanently((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, "CompanionHostile");
		SetFaction(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, (FACTION)Origin_Wyll_Hostile_952a1295-1e0d-40c4-890f-bd9f398fc2b8);
		
		PROC
		PROC_ORI_WyllConfrontation_SetUpCampFight()
		THEN
		DB_Camp_Combatants((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		DB_Camp_Combatants((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d);
		PROC_Camp_HideCampFollowers();
		
		IF
		DialogStarted(PLA_WyllConfrontation_OM_Wyll_AOM_OOM_d52e58c1-6130-bf0e-6a11-e631c2864947, _)
		THEN
		PROC_CampNight_ClearCampNight(NIGHT_WyllConfrontation_2576ba4e-90a9-4da0-bb40-6f012ed4a888);
		
		IF
		DialogStarted(PLA_WyllConfrontation_OM_Wyll_COM_dfc8919e-e6a5-d01d-e048-3853196629be, _)
		THEN
		PROC_CampNight_ClearCampNight(NIGHT_WyllConfrontation_2576ba4e-90a9-4da0-bb40-6f012ed4a888);
		
		QRY
		QRY_OriginMoment_PreventRelaunchDialog(PLA_WyllConfrontation_OM_Wyll_AOM_OOM_d52e58c1-6130-bf0e-6a11-e631c2864947,_,_)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_OriginMoment_PreventRelaunchDialog(PLA_WyllConfrontation_OM_Wyll_COM_dfc8919e-e6a5-d01d-e048-3853196629be,_,_)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_DialogStarted((DIALOGRESOURCE)PLA_WyllConfrontation_OM_Wyll_AOM_OOM_d52e58c1-6130-bf0e-6a11-e631c2864947, _)
		THEN
		PROC_SpotPlayers_StopSpotting((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "PLA_Karlach_SpotAtRecruitment");
		SetFlag((FLAG)ORI_Karlach_Event_StopBurning_eb256a3f-aaa4-46e3-bbc6-28a71d3268ac, NULL_00000000-0000-0000-0000-000000000000);
		
		PROC
		PROC_DialogStarted((DIALOGRESOURCE)PLA_WyllConfrontation_OM_Wyll_COM_dfc8919e-e6a5-d01d-e048-3853196629be, _)
		THEN
		PROC_SpotPlayers_StopSpotting((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c, "PLA_Karlach_SpotAtRecruitment");
		SetFlag((FLAG)ORI_Karlach_Event_StopBurning_eb256a3f-aaa4-46e3-bbc6-28a71d3268ac, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		DialogEnded(_Dialog, _)
		AND
		DB_ORI_WyllConfrontation_CampDialogues(_Dialog)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_WyllConfrontation_State_WyllLeft_9d982de1-c1dd-d766-8626-9c7a598f4c90)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_WyllConfrontation_State_WyllLeftHostile_823f4d26-f3e7-44b3-aea6-4b953c071601)
		THEN
		PROC_ORI_Karlach_SetAfterWyllConfrontationDialog((FLAG)ORI_Karlach_IPRD_WyllJoinsAfterConfrontation_bb7552fe-d4d6-03f6-3f50-f20c9baad39f);
		
		IF
		DialogEnded(_Dialog, _)
		AND
		DB_ORI_WyllConfrontation_CampDialogues(_Dialog)
		AND
		DB_GlobalFlag((FLAG)ORI_WyllConfrontation_State_WyllLeft_9d982de1-c1dd-d766-8626-9c7a598f4c90)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_WyllConfrontation_State_WyllLeftHostile_823f4d26-f3e7-44b3-aea6-4b953c071601)
		THEN
		PROC_ORI_Karlach_SetAfterWyllConfrontationDialog((FLAG)ORI_Karlach_IPRD_WyllLeavesAfterConfrontation_2b87dd09-013f-63de-2e9d-7c3a4fedf900);
		
		IF
		DialogEnded(_Dialog, _)
		AND
		DB_ORI_WyllConfrontation_CampDialogues(_Dialog)
		AND
		DB_GlobalFlag((FLAG)ORI_WyllConfrontation_State_WyllLeftHostile_823f4d26-f3e7-44b3-aea6-4b953c071601)
		THEN
