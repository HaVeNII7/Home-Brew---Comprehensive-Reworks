	}
	KB
	{
		//REGION Halsin Wildshape
		PROC
		PROC_GLO_Halsin_ApplyWildshape()
		AND
		DB_GLO_Halsin_WildshapeSpells(_Spell, _Status)
		THEN
		DB_GLO_Halsin_WildShapeFallback(_Status);
		UseSpell(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, _Spell, S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, NULL_00000000-0000-0000-0000-000000000000);
		
		//fallback
		IF
		CastSpellFailed(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, _Spell, _, _, _)
		AND
		DB_GLO_Halsin_WildshapeSpells(_Spell, _Status)
		AND
		DB_GLO_Halsin_WildShapeFallback(_Status)
		THEN
		ApplyStatus(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, _Status, -1.0, 1, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		StatusApplied(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, _Status, _, _)
		AND
		DB_GLO_Halsin_WildShapeFallback(_Status)
		THEN
		NOT DB_GLO_Halsin_WildShapeFallback(_Status);
		
		PROC
		PROC_GLO_Halsin_RemoveWildshape()
		AND
		DB_GLO_Halsin_WildshapeSpells(_Spell, _Status)
		AND
		HasActiveStatus(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, _Status, 1)
		THEN
		UseSpell(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, "Shout_WildShape_Dismiss", S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		CastedSpell(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, "Shout_WildShape_Dismiss", _, _, _)
		THEN
		PROC_GLO_Halsin_WildshapeRemoved();
		
		PROC
		PROC_GLO_Halsin_RemoveWildshape()
		AND
		DB_GLO_Halsin_WildshapeSpells(_Spell, _Status)
		AND
		HasActiveStatus(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, _Status, 1)
		THEN
		PROC_GLO_Halsin_WildshapeRemoved();
		RemoveStatus(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, _Status);
		
		PROC
		PROC_GLO_Halsin_WildshapeRemoved()
		THEN
		DB_NOOP(1);
		
		IF
		TextEvent("hdis")
		THEN
		UseSpell(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, "Shout_WildShape_Dismiss", S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		TextEvent("hbear")
		THEN
		UseSpell(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, "Shout_DEN_Halsin_WildShape_Bear", S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, NULL_00000000-0000-0000-0000-000000000000);
		//END_REGION Halsin Wildshape
		
		//REGION Information tracking
		
		IF
		QuestUpdateUnlocked(_, _, _Update)
		AND
		DB_GLO_Halsin_FirstHalsinInteraction(_, _, _Update)
		AND
		NOT DB_GlobalFlag((FLAG)GOB_WolfPens_State_HalsinIntroHappened_7d0751b9-1055-4a54-9ccd-f5e95e2a1f69)
		THEN
		SetFlag(GOB_WolfPens_State_HalsinIntroHappened_7d0751b9-1055-4a54-9ccd-f5e95e2a1f69, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		QuestUpdateUnlocked(_, _, _Update)
		AND
		DB_GLO_TadpoleQuest_Druid_HalsinLeaderEntries(_, "HalsinAtGrove", _, _Update)
		AND
		NOT DB_GlobalFlag((FLAG)GOB_WolfPens_State_HalsinIntroHappened_7d0751b9-1055-4a54-9ccd-f5e95e2a1f69)
		THEN
		SetFlag(GOB_WolfPens_State_HalsinIntroHappened_7d0751b9-1055-4a54-9ccd-f5e95e2a1f69, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		QuestUpdateUnlocked(_, _, _Update)
		AND
		DB_GLO_TadpoleQuest_Druid_HalsinLeftNoHelp(_, _Update)
		AND
		NOT DB_GlobalFlag((FLAG)GOB_WolfPens_State_HalsinIntroHappened_7d0751b9-1055-4a54-9ccd-f5e95e2a1f69)
		THEN
		SetFlag(GOB_WolfPens_State_HalsinIntroHappened_7d0751b9-1055-4a54-9ccd-f5e95e2a1f69, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		
		IF
		QuestUpdateUnlocked(_, _, "HalsinToldPath")
		AND
		NOT DB_GlobalFlag((FLAG)GLO_Halsin_Knows_MoonriseBriefing_9f8afde2-9dcf-3a5e-5e85-128913b820b7)
		THEN
		SetFlag(GLO_Halsin_Knows_MoonriseBriefing_9f8afde2-9dcf-3a5e-5e85-128913b820b7, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		//END_REGION
		
		//REGION Removing Halsin from Goblin Camp
		IF
		EntityEvent(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, "GLO_Halsin_LeftGoblinCamp")
		THEN
		PROC_GLO_Halsin_RemoveWildshape();
		RemoveStatus(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, "WILDSHAPE_RAT");
		SetHasDialog(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1);
		SetCanJoinCombat(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1);
		SetFaction(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, (FACTION)GLO_Halsin_01ebccd1-8a58-4ca6-9726-c4bb484b85f2);
		SetCombatGroupID(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, "");
		PROC_GLO_Halsin_LeftGoblinCamp();
		PROC_CharacterEnableAllCrimes(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		
		PROC
		PROC_GLO_Halsin_LeftGoblinCamp()
		THEN
		DebugBreak("Halsin ready to go to the Grove");
		DB_GLO_Halsin_ReadyForDen(1);
		
		IF
		DB_GLO_Halsin_ReadyForDen(1)
		AND
		DB_CampNight_Completed((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121)
		THEN
		NOT DB_GLO_Halsin_ReadyForDen(1);
		PROC_GLO_Halsin_TeleportToDen();
		
		//END_REGION Removing Halsin from Goblin Camp
		
		//REGION Halsin returns to the Den
		
		//TODO: Make him appear out of sight rather than teleport
		PROC
		PROC_GLO_Halsin_TeleportToDen()
		THEN
		NOT DB_GLO_Halsin_ReadyForDen(1);
		SetOnStage(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1);
		TeleportTo(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, S_DEN_VictoryHalsinPos_8a64c311-e43a-4e2f-81d5-401728fd07bb, "GLO_Halsin_ArrivedAtGrove");
		LookFromTrigger(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, S_DEN_VictoryHalsinPos_8a64c311-e43a-4e2f-81d5-401728fd07bb, 0);
		SetFlag(GLO_Halsin_State_Returned_5af86099-47f9-ba69-199a-fe91292a41bd, NULL_00000000-0000-0000-0000-000000000000, 0);
		PROC_RemoveAllDialogEntriesForSpeaker((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		DB_Dialogs((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, (DIALOGRESOURCE)DEN_AttackOnDen_HalsinReturns_d9c2a89e-13fa-57f7-0fcf-4dfada32d693);
		
		IF
		EntityEvent(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, "GLO_Halsin_ArrivedAtGrove")
		AND
		DB_State_Current(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_GoblinHuntVictory")
		AND
		NOT DB_PermaDefeated(S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156)
		THEN
		PROC_GLO_Halsin_GoSeeDruidLeader();
		
		IF
		DB_Sees(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, _Player)
		AND
		DB_GlobalFlag(GLO_Halsin_State_Returned_5af86099-47f9-ba69-199a-fe91292a41bd)
		AND
		DB_GLO_Halsin_MoveToPlayerAtDen(1)
		AND
		DB_Players(_Player)
		AND
		QRY_OnlyOnce("GLO_Halsin_SeeksPlayerAtDen")
		THEN
		PROC_CharacterMoveToAndTalk(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, _Player, DEN_AttackOnDen_HalsinReturns_d9c2a89e-13fa-57f7-0fcf-4dfada32d693, "GLO_Halsin_HalsinReturns", "Run", 20.0);
		
		IF
		DB_InCamp((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		AND
		QRY_OnlyOnce("CAMP_HalsinJoinsCamp")
		THEN
		PROC_SetRelationToPlayers(GLO_Halsin_01ebccd1-8a58-4ca6-9726-c4bb484b85f2, 100);
		
		IF
		DialogActorLeft(_VictoryDialog, _, S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, _)
		AND
		DB_State_Current(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_AttackOnDenVictory")
		AND
		DB_DEN_AttackOnDen_VictoryDialogs(_, _VictoryDialog)
		AND
		NOT DB_PermaDefeated(S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156)
		AND
		QRY_OnlyOnce("DEN_AttackOnDen_HalsinToDruidLeader")
		THEN
		PROC_GLO_Halsin_GoSeeDruidLeader();
		
		PROC
		PROC_GLO_Halsin_GoSeeDruidLeader()
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		DB_Dialogs((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, DEN_AttackOnDen_HalsinReturns_d9c2a89e-13fa-57f7-0fcf-4dfada32d693);
		
		PROC
		PROC_GLO_Halsin_GoSeeDruidLeader()
		THEN
		PROC_CharacterMoveTo(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, S_DEN_GateToPondMidwayPoint_57367d5b-621a-4904-ba6d-e92d6f95f062, "Run", "GLO_Halsin_OnTheWayToLair");
		
		IF
		EntityEvent(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, "GLO_Halsin_OnTheWayToLair")
		THEN
		PROC_CharacterMoveTo(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, S_DEN_HalsinPondPos_75fa3857-8084-49a8-8578-7af14cee59f8, "Run", "GLO_Halsin_WithDruidLeader");
		
		IF
		EntityEvent(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, "GLO_Halsin_WithDruidLeader")
		THEN
		DB_GLO_Halsin_AtDruidLeaderMeeting((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		
		IF
		EntityEvent(S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156, "DEN_AttackOnDen_VictoryMoveComplete")
		THEN
		DB_GLO_Halsin_AtDruidLeaderMeeting((CHARACTER)S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156);
		
		IF
		EntityEvent(S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156, "DEN_Victory_TeleportToPosition")
		THEN
		DB_GLO_Halsin_AtDruidLeaderMeeting((CHARACTER)S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156);
		
		IF
		EntityEvent(S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156, "DEN_AttackOnDen_TeleportToVictoryPos")
		THEN
		DB_GLO_Halsin_AtDruidLeaderMeeting((CHARACTER)S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156);
		
		IF
		DB_GLO_Halsin_AtDruidLeaderMeeting((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		AND
		DB_GLO_Halsin_AtDruidLeaderMeeting((CHARACTER)S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156)
		THEN
		DB_GLO_Halsin_DruidLeaderMeetingReady(1);
		
		QRY
		QRY_SelectCustomDialog_AfterGenerics(_NPC, _Player)
		AND
		DB_GLO_Halsin_DruidLeaderMeetingReady(1)
		AND
		DB_GLO_Halsin_DruidLeaderMeetingNPCs((CHARACTER)_NPC)
		AND
		DB_Dialogs((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, DEN_AttackOnDen_HalsinReturns_d9c2a89e-13fa-57f7-0fcf-4dfada32d693)
		THEN
		DB_SelectedDialog((DIALOGRESOURCE)DEN_AttackOnDen_HalsinAndDruidLeader_790030b5-e20e-ff34-30e4-740e904fa6c7, (CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, (CHARACTER)S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156, _Player);
		NOT DB_GLO_Halsin_DruidLeaderMeetingReady(1);
		NOT DB_GLO_Halsin_AtDruidLeaderMeeting((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		NOT DB_GLO_Halsin_AtDruidLeaderMeeting((CHARACTER)S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156);
		
		IF
		DialogActorLeft(DEN_AttackOnDen_HalsinAndDruidLeader_790030b5-e20e-ff34-30e4-740e904fa6c7, _, S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156, _)
		AND
		DB_GlobalFlag(GLO_Halsin_Event_BanishedKagha_63afc3d3-a4f7-03fb-c528-18b9e0bfbc30)
		THEN
		PROC_DEN_LeaveDen((CHARACTER)S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156);
		
		IF
		DialogStarted((DIALOGRESOURCE)DEN_AttackOnDen_HalsinAndDruidLeader_790030b5-e20e-ff34-30e4-740e904fa6c7, _)
		AND
		NOT DB_GlobalFlag(GLO_Halsin_Event_MetAtGrove_e87fc81d-778a-b89c-890e-e3275073c677)
		THEN
		SetFlag(GLO_Halsin_Event_MetAtGrove_e87fc81d-778a-b89c-890e-e3275073c677, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		DialogStarted((DIALOGRESOURCE)DEN_AttackOnDen_HalsinReturns_d9c2a89e-13fa-57f7-0fcf-4dfada32d693, _)
		AND
		NOT DB_GlobalFlag(GLO_Halsin_Event_MetAtGrove_e87fc81d-778a-b89c-890e-e3275073c677)
		THEN
		SetFlag(GLO_Halsin_Event_MetAtGrove_e87fc81d-778a-b89c-890e-e3275073c677, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		
		//Stuff to move Halsin to inside the 
		IF
		DialogEnded(_Dialog, _)
		AND
		DB_DEN_Halsin_AttackFollowUpDialogs(_Dialog)
		AND
		DB_GlobalFlag(GLO_Halsin_Event_MetAtGrove_e87fc81d-778a-b89c-890e-e3275073c677)
		THEN
		ObjectTimerLaunch(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, "DEN_Halsin_PostFollowUpTimer", 2000, 1);
		
		IF
		ObjectTimerFinished(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, "DEN_Halsin_PostFollowUpTimer")
		THEN
		PROC_GlobalSetFlagAndCache(DEN_AttackOnDen_State_HalsinPostFollowUp_5de87bc4-5780-4e53-852f-a235eeb182d6);
		
		//END_REGION
		
		//REGION Halsin returns to the Grove in AoD
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)_VictoryDialog, (INTEGER)_ID)
		AND
		DB_DEN_AttackOnDen_VictoryDialogs(_, _VictoryDialog)
		AND
		DB_GLO_Halsin_ReadyForDen(1)
		THEN
		PROC_GLO_Halsin_TeleportToDen();
		PROC_DialogAddSpeakingActor(_ID,S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		
		IF
		DialogEnded(_VictoryDialog, _)
		AND
		DB_DEN_AttackOnDen_VictoryDialogs(_, _VictoryDialog)
		AND
		NOT DB_GlobalFlag(DEN_Refugees_State_LeadersAreDead_1e6a42ed-8313-4f46-57e2-20dbdb2df923)
		AND
		DB_GlobalFlag(GLO_Halsin_State_Returned_5af86099-47f9-ba69-199a-fe91292a41bd)
		AND
		DB_PermaDefeated(S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156)
		THEN
		DB_GLO_Halsin_MoveToPlayerAtDen(1);
		
		//END_REGION
		
		//REGION Halsin returns to the Grove in Goblin Hunt Victory
		
		IF
		DB_GLO_Halsin_ReadyForDen(1)
		AND
		DB_State_Current(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_GoblinHuntVictory")
		THEN
		NOT DB_GLO_Halsin_ReadyForDen(1);
		PROC_GLO_Halsin_TeleportToDen();
		
		//END_REGION
		
		//REGION Halsin returns fallback
		
		PROC
		PROC_DEN_Misc_TryChangeTooLowTieflingsState()
		THEN
		NOT DB_QuestDef_ChainedState("GLO_Tadpole", "FoundHalsin_Unknown_KillLeaders", "DEN_Conflict", "FoundHalsin_Unknown_KillLeaders");
		NOT DB_QuestDef_ChainedState("GLO_Tadpole", "FoundHalsin_Unknown_LeadershipDead", "DEN_Conflict", "FoundHalsin_Unknown_LeadershipDead");
		NOT DB_QuestDef_ChainedState("GLO_Tadpole", "FoundHalsin_Unknown_AoD", "DEN_Conflict", "FoundHalsin_Unknown_AoD");
		SetFlag(GLO_Halsin_State_WillSkipGrove_5c0de857-1de5-3098-5064-e6afaedb4eb4, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		DB_GLO_Halsin_ReadyForDen(1)
		AND
		DB_GlobalFlag(GLO_Halsin_State_WillSkipGrove_5c0de857-1de5-3098-5064-e6afaedb4eb4)
		AND
		NOT DB_GlobalFlag(DEN_AttackOnDen_State_DruidsAreDefeated_3c6d8a2c-dd85-48d1-b48d-f0c6d37959e4)
		THEN
		NOT DB_GLO_Halsin_ReadyForDen(1);
		SetFlag(GLO_Halsin_State_FallbackToCamp_d5ba0fa2-f43e-41ab-a828-960a95c978a7, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		//If Halsin hasn't returned to the grove by the time the camp party happens, setup the fallback.
		PROC
		PROC_CAMP_GoblinHuntCelebration_SetupHalsin()
		AND
		DB_GLO_Halsin_ReadyForDen(1)
		AND
		NOT DB_GlobalFlag(DEN_AttackOnDen_State_DruidsAreDefeated_3c6d8a2c-dd85-48d1-b48d-f0c6d37959e4)
		THEN
		NOT DB_GLO_Halsin_ReadyForDen(1);
		SetFlag(GLO_Halsin_State_FallbackToCamp_d5ba0fa2-f43e-41ab-a828-960a95c978a7, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		DB_GLO_Halsin_ReadyForDen(1)
		AND
		DB_Defeated(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		THEN
		NOT DB_GLO_Halsin_ReadyForDen(1);
		
		//If Halsin is ready to return to the grove and the lockdown is activated, setup the fallback.
		IF
		DB_GLO_Halsin_ReadyForDen(1)
		AND
		DB_GlobalFlag(DEN_Lockdown_State_Active_0b54c7d2-b7b1-4d0f-b8e4-0cf1ee32b1eb)
		THEN
		NOT DB_GLO_Halsin_ReadyForDen(1);
		SetFlag(GLO_Halsin_State_FallbackToCamp_d5ba0fa2-f43e-41ab-a828-960a95c978a7, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		//If Halsin is ready to return to the grove and the raiders win in Attack on Den, setup the fallback.
		IF
		DB_GLO_Halsin_ReadyForDen(1)
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_RaiderVictory_abe1bce8-c234-4afe-a490-76210d98a078)
		AND
		DB_GlobalFlag(GOB_General_State_Hostile_9816a6fb-54d7-4b9c-a5c7-bc6cda6bb276)
		THEN
		NOT DB_GLO_Halsin_ReadyForDen(1);
		SetFlag(GLO_Halsin_State_RevengeAtCamp_c5350174-c6da-45c7-b2c2-e9957002e44d, NULL_00000000-0000-0000-0000-000000000000, 0);
		DB_CAMP_BlockCampFaction((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		
		PROC
		PROC_CampfireMoment_PreDialog((DIALOGRESOURCE)CAMP_HalsinsReturn_CFM_720f387b-ca6e-b3be-4176-bceb7512d172)
		THEN
		PROC_GLO_Halsin_RemoveWildshape();
		PROC_SetOnStage(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1);
		PROC_Camp_TeleportToCamp(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, S_CAMP_WLDMAIN_Halsin_2c10b7b1-eb61-444f-bf1d-aa327902770f);
		PROC_RemoveAllDialogEntriesForSpeaker((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		DB_Dialogs(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, (DIALOGRESOURCE)CAMP_Halsin2_c0ab0f6f-3ffc-d06d-0d6d-d1aaef70dfe4);
		LookFromTrigger(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, S_CAMP_WLDMAIN_Halsin_2c10b7b1-eb61-444f-bf1d-aa327902770f, 0);
		
		//Halsin went to checked out Grove on his own before going to camp.
		PROC
		PROC_CampfireMoment_PreDialog((DIALOGRESOURCE)CAMP_HalsinsReturn_CFM_720f387b-ca6e-b3be-4176-bceb7512d172)
		AND
		DB_GlobalFlag(GLO_Halsin_State_WillSkipGrove_5c0de857-1de5-3098-5064-e6afaedb4eb4)
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker((CHARACTER)S_DEN_DruidOpposed_322cf8d2-32ee-453f-987e-f12b32652b5d);
		DB_Dialogs(S_DEN_DruidOpposed_322cf8d2-32ee-453f-987e-f12b32652b5d, (DIALOGRESOURCE)DEN_AttackOnDen_DruidOpposed_944ed88d-50e2-80ec-a7ba-fee24a63e6fc);
		SetFlag(GLO_Halsin_State_Returned_5af86099-47f9-ba69-199a-fe91292a41bd);
		
		//Tieflings left Act 1 before players had the Tiefling Celebration, so we need to queue up the SCO/Halsins Return scene for the next long rest
		PROC
		PROC_DEN_TieflingRefugees_Leave()
		AND
		NOT DB_GlobalFlag(GLO_Halsin_Knows_MoonriseBriefing_9f8afde2-9dcf-3a5e-5e85-128913b820b7)
		AND
		NOT DB_CAMP_HalsinMorningAfterScene(1)
		AND
		NOT DB_GLO_Halsin_GotMorningAfterScene(1)
		THEN
		DB_CAMP_HalsinMorningAfterScene(1);
		
		//END_REGION
		
		//REGION Halsin revenge
		
		IF
		DB_CAMP_HalsinsRevenge_Adversaries(_Adversary)
		THEN
		DB_GLO_DefeatCounter(_Adversary, "CAMP_HalsinsRevenge");
		SetCombatGroupID(_Adversary, "CAMP_HalsinsRevenge");
		SetOnStage(_Adversary, 0);
		
		PROC
		PROC_CampNight_StartSelected()
		AND
		DB_Camp_QueuedNight((FLAG)NIGHT_HalsinsRevenge_55e86575-6b8c-45ab-b582-e5ed048e6a83)
		THEN
		DB_CAMP_HalsinsRevenge_Started(1);
		
		PROC
		PROC_CampfireMoment_PreDialog(CAMP_HalsinsRevenge_CFM_bc6f1f39-26f9-d06b-6784-0bbf970fc0ef)
		AND
		DB_ActiveCamp(_Camp)
		AND
		DB_CAMP_HalsinsRevenge_TeleportPoints(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, _Trigger, _Camp)
		THEN
		PROC_GLO_Halsin_RemoveWildshape();
		PROC_CAMP_BlockCampFaction((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		SetCombatGroupID(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, "CAMP_HalsinsRevenge");
		PROC_SetRelationToPlayers((FACTION)GLO_Halsin_01ebccd1-8a58-4ca6-9726-c4bb484b85f2, 50);
		PROC_SetOnStage(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1);
		TeleportTo(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, _Trigger, "");
		PROC_RemoveAllDialogEntriesForSpeaker((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		LookFromTrigger(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, (TRIGGER)_Trigger, 0);
		Transform(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, ArchDruid_Boss_Revenge_64663337-90aa-4944-89b9-3973e4738cc0, (SHAPESHIFTRULE)PHYSICAL_4acc6277-6dcd-4110-9450-b9379beaedac);
		
		
		PROC
		PROC_CampfireMoment_PreDialog(CAMP_HalsinsRevenge_CFM_bc6f1f39-26f9-d06b-6784-0bbf970fc0ef)
		AND
		DB_CAMP_HalsinsRevenge_Adversaries(_Adversary)
		AND
		DB_ActiveCamp(_Camp)
		AND
		DB_CAMP_HalsinsRevenge_TeleportPoints(_Adversary, _Trigger, _Camp)
		THEN
		SetOnStage(_Adversary, 1);
		TeleportTo(_Adversary, _Trigger, "");
		
		IF
		DialogEnded(CAMP_HalsinsRevenge_CFM_bc6f1f39-26f9-d06b-6784-0bbf970fc0ef, _)
		THEN
		PROC_SetRelationToPlayers((FACTION)GLO_Halsin_01ebccd1-8a58-4ca6-9726-c4bb484b85f2, 0);
		
		
		PROC
		PROC_GLO_DefeatCounter_AllPermaDefeated("CAMP_HalsinsRevenge")
		AND
		GetClosestAlivePlayer(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, (CHARACTER)_Player, _)
		AND
		NOT DB_CantTalk(_Player)
		THEN
		StartVoiceBark(CAMP_HalsinsRevenge_VB_1c28794b-2c77-c32c-4b89-3dc8e7674030, _Player);
		
		PROC
		PROC_CampNight_ClearCampNight((FLAG)NIGHT_HalsinsRevenge_55e86575-6b8c-45ab-b582-e5ed048e6a83)
		AND
		DB_CAMP_HalsinsRevenge_Started(1)
		THEN
		SetOnStage(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 0);
		
		PROC
		PROC_CampNight_ClearCampNight((FLAG)NIGHT_HalsinsRevenge_55e86575-6b8c-45ab-b582-e5ed048e6a83)
		AND
		DB_CAMP_HalsinsRevenge_Started(1)
		AND
		DB_CAMP_HalsinsRevenge_Adversaries(_Adversary)
		THEN
		SetOnStage(_Adversary, 0);
		
		IF
		TextEvent("halsinrevenge")
		THEN
		DebugBreak("Halsin leaves Wolf Pens!");
		PROC_GOB_WolfPens_HalsinForceBreakoutAndLeaving();
		SetFlag(GLO_Halsin_State_RevengeAtCamp_c5350174-c6da-45c7-b2c2-e9957002e44d, NULL_00000000-0000-0000-0000-000000000000, 0);
		DB_CAMP_BlockCampFaction((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		
		//END_REGION
		
		//REGION Setting IsMissing Knowledge flag
		
		//edge-case: it's really easy to get this flag in the Grove, but if the player misses it, set it when meeting Halsin
		IF
		DialogStarted(_Dialog,_Inst)
		AND
		DB_DialogNPCs(_Inst, S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, _)
		AND
		DB_DialogPlayers(_Inst,_,_)
		AND
		NOT DB_GlobalFlag(GLO_Halsin_Knows_IsMissing_c1645d76-f086-5011-e553-cc573c51478e)
		AND
		NOT DB_GLO_Halsin_HearingAboutHalsinForFirstTime(_)
		AND
		DialogIsAutomated(_Dialog, 0)
		AND
		DialogIsCrimeDialog(_Inst, 0)
		AND
		GetFlag(GOB_WolfPens_State_PrisonerLeftCage_4cd17a8b-7605-47c7-a13c-93821e68f177, S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1)
		AND
		NOT QRY_GLO_Halsin_HasActiveWolfPensWildShapeStatus()
		THEN
		DB_GLO_Halsin_HearingAboutHalsinForFirstTime(_Dialog);
		
		QRY
		QRY_GLO_Halsin_HasActiveWolfPensWildShapeStatus()
		AND
		DB_GLO_Halsin_WildshapeSpells(_, _Status)
		AND
		HasActiveStatus(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, _Status, 1)
		THEN
		DB_NOOP(1);
		
		//set the flag only after dialog, so it can be checked during
		IF
		DialogEnded(_Dialog,_)
		AND
		DB_GLO_Halsin_HearingAboutHalsinForFirstTime(_Dialog)
		THEN
		PROC_GlobalSetFlagAndCache(GLO_Halsin_Knows_IsMissing_c1645d76-f086-5011-e553-cc573c51478e);
		NOT DB_GLO_Halsin_HearingAboutHalsinForFirstTime(_Dialog);
		
		//END_REGION
		
		//REGION Magical teleporting death journal
		
		PROC
		PROC_StateSet_PermaDefeated((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		AND
		DB_Defeated(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b)
		AND
		QRY_OnlyOnce("GLO_Halsin_GiveMagicJournal")
		THEN
		ToInventory(S_GLO_HalsinDiary_5e4aafd4-f56c-4b05-ad5a-00eccdb87d9d, S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1);
		
		PROC
		PROC_StateSet_PermaDefeated((CHARACTER)S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b)
		AND
		DB_Defeated(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		AND
		QRY_OnlyOnce("GLO_Halsin_GiveMagicJournal")
		THEN
		ToInventory(S_GLO_HalsinDiary_5e4aafd4-f56c-4b05-ad5a-00eccdb87d9d, S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, 1);
		
		IF
		DialogStarted(CAMP_GoblinHuntCelebration_SCO_DrowBetrayal_af3b7395-444d-2d60-29ad-a31c892de91b, _)
		AND
		QRY_OnlyOnce("GLO_Halsin_GiveMagicJournal")
		THEN
		ToInventory(S_GLO_HalsinDiary_5e4aafd4-f56c-4b05-ad5a-00eccdb87d9d, S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, 1);
		
		//END_REGION
		
		//REGION Debugs
		IF
		FlagSet((FLAG)GLO_Halsin_Debug_WorgPens_f84fd4f2-8bc7-4a9e-9156-46d719044655, _, _)
		THEN
		DB_OnlyOnce("GOB_WolfPens_RestoreHpAfterFight");
		PROC_GOB_WolfPens_HalsinForceBreakout();
		TimerLaunch("GOB_WolfPens_FreeHalsinTeleport", 1000);
		
		IF
		FlagSet(GLO_Halsin_Debug_KillKagha_4ce8cf64-a300-47f2-8d47-40e883a72d12, _, _)
		THEN
		Die(S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156, DEATHTYPE.DoT, 1);
		
		IF
		FlagSet(GLO_Halsin_Debug_KillKagha_4ce8cf64-a300-47f2-8d47-40e883a72d12, _, _)
		THEN
		Die(S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156, DEATHTYPE.DoT, 1);
		
		IF
		FlagSet(GLO_Halsin_Debug_AttackOnDen_17189797-e6a3-4c66-aa26-2a3d4b3dfe4a, _, _)
		THEN
		PROC_GLO_Halsin_DebugReturnAoD();
		
		PROC
		PROC_GLO_Halsin_DebugReturnAoD()
		THEN
		DB_OnlyOnce("GOB_WolfPens_HalsinForceLeaving");
		DB_GOB_WolfPens_HalsinLeftOnHisOwn(1);
		PROC_GlobalSetFlagAndCache(GOB_WolfPens_State_Swept_fc032064-28cf-17cb-51bb-14ae6d8a85b6);
		PROC_GOB_WolfPens_ClearWolfPens();
		PROC_GOB_WolfPens_DestroyDoors();
		PROC_GOB_WolfPens_TeleportHalsin();
		PROC_GLO_Halsin_RemoveWildshape();
		RemoveStatus(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, "WILDSHAPE_RAT");
		SetHasDialog(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1);
		SetCanJoinCombat(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1);
		SetFaction(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, (FACTION)GLO_Halsin_01ebccd1-8a58-4ca6-9726-c4bb484b85f2);
		SetCombatGroupID(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, "");
		PROC_GLO_Halsin_LeftGoblinCamp();
		PROC_CharacterEnableAllCrimes(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		SetFlag(GOB_WolfPens_State_PrisonerLeftCage_4cd17a8b-7605-47c7-a13c-93821e68f177, S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		DB_GLO_Halsin_DebugAttackOnDenMeet(1);
		PROC_DEN_RaidingParty_DebugResolveConfrontation();
		SetFlag(DEN_AttackOnDen_Debug_Start_10b6026f-b246-7f88-aa40-a653fe08d861, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		FlagSet(GLO_Halsin_Debug_LeadersDead_4037ac74-9e75-4339-abbb-9b7e83c70bc9, _, _)
		THEN
		PROC_GLO_Halsin_DebugReturnVictory();
		
		PROC
		PROC_GLO_Halsin_DebugReturnVictory()
		THEN
		DB_GLO_Halsin_DebugVictoryMeet(1);
		PROC_DEN_RaidingParty_DebugResolveConfrontation();
		
		PROC
		PROC_GLO_Halsin_DebugReturnVictory()
		AND
		DB_GLO_DefeatCounter(_Leader,"GOB_GoblinHunt_Leaders")
		AND
		NOT DB_PermaDefeated((CHARACTER)_Leader)
		THEN
		PROC_ForceStopDialog(_Leader);
		Die(_Leader, DEATHTYPE.DoT, NULL_00000000-0000-0000-0000-000000000000, 1, 1);
		
		PROC
		PROC_DEN_Victory_SetupOver()
		AND
		DB_GLO_Halsin_DebugVictoryMeet(1)
		THEN
		SetFlag(DEN_AttackOnDen_Event_TieflingPartyInvitation_545593fd-42e6-15c1-1e96-18e0e0be0443, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetFlag(DEN_AttackOnDen_Event_HalsinSpotted_40e35270-1762-2c46-ca80-c449802b755f, NULL_00000000-0000-0000-0000-000000000000, 0);
		PROC_GLO_Halsin_TeleportToDen();
		PROC_GLO_Halsin_DebugGoToKagha();
		PROC_TeleportPartiesTo(S_DEN_VictoryBoredKidWanderArea_f734a50f-c6fc-45c6-9ac6-b7bde12ecb3f, "");
		
		PROC
		PROC_DEN_AttackOnDen_SetupOver()
		AND
		DB_GLO_Halsin_DebugAttackOnDenMeet(1)
		THEN
		PROC_DEN_AttackOnDen_DebugDenVictory();
		
		PROC
		PROC_DEN_AttackOnDen_DebugDenVictory()
		AND
		DB_GLO_Halsin_DebugAttackOnDenMeet(1)
		THEN
		SetFlag(DEN_AttackOnDen_Event_TieflingPartyInvitation_545593fd-42e6-15c1-1e96-18e0e0be0443, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetFlag(DEN_AttackOnDen_Event_VictorySpeech_8d24f0ca-a22d-f4fa-5bc5-931dd02bfb56, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetFlag(DEN_AttackOnDen_Event_HalsinSpotted_40e35270-1762-2c46-ca80-c449802b755f, NULL_00000000-0000-0000-0000-000000000000, 0);
		PROC_GLO_Halsin_TeleportToDen();
		PROC_GLO_Halsin_DebugGoToKagha();
		PROC_TeleportPartiesTo(S_DEN_VictoryBoredKidWanderArea_f734a50f-c6fc-45c6-9ac6-b7bde12ecb3f, "");
		
		PROC
		PROC_GLO_Halsin_DebugGoToKagha()
		AND
		NOT DB_Defeated(S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156)
		THEN
		PROC_GLO_Halsin_GoSeeDruidLeader();
		
		IF
		FlagSet(GLO_Halsin_Debug_FallbackCamp_ea15c83c-777d-4d1d-a8df-3b2f25e3b4d6, _, _)
		THEN
		SetFlag(GLO_Halsin_State_WillSkipGrove_5c0de857-1de5-3098-5064-e6afaedb4eb4, NULL_00000000-0000-0000-0000-000000000000, 0);
		DB_OnlyOnce("GOB_WolfPens_HalsinForceLeaving");
		DB_GOB_WolfPens_HalsinLeftOnHisOwn(1);
		PROC_GlobalSetFlagAndCache(GOB_WolfPens_State_Swept_fc032064-28cf-17cb-51bb-14ae6d8a85b6);
		PROC_GOB_WolfPens_ClearWolfPens();
		PROC_GOB_WolfPens_DestroyDoors();
		PROC_GOB_WolfPens_TeleportHalsin();
		PROC_GLO_Halsin_RemoveWildshape();
		RemoveStatus(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, "WILDSHAPE_RAT");
		SetHasDialog(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1);
		SetCanJoinCombat(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1);
		SetFaction(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, (FACTION)GLO_Halsin_01ebccd1-8a58-4ca6-9726-c4bb484b85f2);
		SetCombatGroupID(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, "");
		PROC_GLO_Halsin_LeftGoblinCamp();
		PROC_CharacterEnableAllCrimes(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		SetFlag(GOB_WolfPens_State_PrisonerLeftCage_4cd17a8b-7605-47c7-a13c-93821e68f177, S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		DB_GLO_Halsin_ReadyForDen(1);
		
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(163).Title("Act1_GLO_KnockSpell");
Goal(163)
{
	INIT
	{
		SetTag(S_FOR_DangerousBook_Tome_73ea8888-ed82-4ca5-b9f9-0c9119873507, KNOCK_TARGET_b0cf1015-6367-4f54-82ef-92cd9df72590);
		SetTag(S_CHA_Crypt_BookOfRestoredGods_a480a240-b8ea-4e6a-b4b9-a8edc8fd4a3d, KNOCK_TARGET_b0cf1015-6367-4f54-82ef-92cd9df72590);
		SetTag(S_FOR_SeluneStash_Chest_3121a64d-b19f-43eb-aade-b641429366c4, KNOCK_TARGET_b0cf1015-6367-4f54-82ef-92cd9df72590); 
	}
	KB
	{
		//REGION Act1_For_DangerousBook_Dev
		IF
		UsingSpellOnTarget(_Player,S_FOR_DangerousBook_Tome_73ea8888-ed82-4ca5-b9f9-0c9119873507,"Target_Knock",_,_,_)
		AND
		DB_PartyMembers(_Players)
		AND
		NOT DB_GlobalFlag(FOR_DangerousBook_State_BookUnlocked_fd215551-a14c-8cfa-ba34-7ac32d1ada28)
		AND
		QRY_OnlyOnce("FOR_DangerousBook_Knock_SummonShades")
		THEN
		TimerLaunch("FOR_DangerousBook_Knock_SummonShades_Timer", 1500);
		
		IF
		TimerFinished("FOR_DangerousBook_Knock_SummonShades_Timer")
		AND
		GetPosition(S_FOR_DangerousBook_Tome_73ea8888-ed82-4ca5-b9f9-0c9119873507, _BookX, _BookY, _BookZ)
		THEN
		CreateSurface(S_FOR_DangerousBook_Tome_73ea8888-ed82-4ca5-b9f9-0c9119873507, "SurfaceDarknessCloud", 2.0, 3.0, S_FOR_DangerousBook_Tome_73ea8888-ed82-4ca5-b9f9-0c9119873507);
		PROC_FOR_DangerousBook_SummonShades(1, _BookX, _BookY, _BookZ);
		
		IF
		FlagSet(FOR_DangerousBook_State_BookUnlocked_fd215551-a14c-8cfa-ba34-7ac32d1ada28, _, _)
		AND
		IsTagged(S_FOR_DangerousBook_Tome_73ea8888-ed82-4ca5-b9f9-0c9119873507, KNOCK_TARGET_b0cf1015-6367-4f54-82ef-92cd9df72590, 1)
		THEN
		ClearTag(S_FOR_DangerousBook_Tome_73ea8888-ed82-4ca5-b9f9-0c9119873507, KNOCK_TARGET_b0cf1015-6367-4f54-82ef-92cd9df72590);
		//END_REGION Act1_For_DangerousBook_Dev
		
		//REGION GLO_BookOfRestoredGods
		IF
		UsingSpellOnTarget(_Player,S_CHA_Crypt_BookOfRestoredGods_a480a240-b8ea-4e6a-b4b9-a8edc8fd4a3d,"Target_Knock",_,_,_)
		AND
		DB_PartyMembers(_Players)
		AND
		NOT DB_GlobalFlag(GLO_BookOfRestoredGods_State_BookOpened_4f33a346-8ae4-47a9-8787-79126046827f)
		AND
		NOT DB_GlobalFlag(GLO_BookOfRestoredGods_Event_NonDialogOpen_a6fe026e-8335-9258-6268-503469a0b5fd)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)GLO_BookOfRestoredGods_Event_NonDialogOpen_a6fe026e-8335-9258-6268-503469a0b5fd);
		
		IF
		FlagSet(GLO_BookOfRestoredGods_State_BookOpened_4f33a346-8ae4-47a9-8787-79126046827f, _, _)
		AND
		IsTagged(S_CHA_Crypt_BookOfRestoredGods_a480a240-b8ea-4e6a-b4b9-a8edc8fd4a3d, KNOCK_TARGET_b0cf1015-6367-4f54-82ef-92cd9df72590, 1)
		THEN
		ClearTag(S_CHA_Crypt_BookOfRestoredGods_a480a240-b8ea-4e6a-b4b9-a8edc8fd4a3d, KNOCK_TARGET_b0cf1015-6367-4f54-82ef-92cd9df72590);
		
		IF
		FlagSet(GLO_BookOfRestoredGods_Event_NonDialogOpen_a6fe026e-8335-9258-6268-503469a0b5fd, _, _)
		AND
		IsTagged(S_CHA_Crypt_BookOfRestoredGods_a480a240-b8ea-4e6a-b4b9-a8edc8fd4a3d, KNOCK_TARGET_b0cf1015-6367-4f54-82ef-92cd9df72590, 1)
		THEN
		ClearTag(S_CHA_Crypt_BookOfRestoredGods_a480a240-b8ea-4e6a-b4b9-a8edc8fd4a3d, KNOCK_TARGET_b0cf1015-6367-4f54-82ef-92cd9df72590);
		//END_REGION GLO_BookOfRestoredGods
		
		//REGION Act1_FOR_Boosters - SeluneStash
		IF
		UsingSpellOnTarget(_Player,S_FOR_SeluneStash_Chest_3121a64d-b19f-43eb-aade-b641429366c4,"Target_Knock",_,_,_)
		AND
		HasActiveStatus(S_FOR_SeluneStash_Chest_3121a64d-b19f-43eb-aade-b641429366c4, "FOR_SELUNESTASH_CHESTSEAL", 1)
		THEN
		RemoveStatus(S_FOR_SeluneStash_Chest_3121a64d-b19f-43eb-aade-b641429366c4, "FOR_SELUNESTASH_CHESTSEAL");
		
		IF
		StatusRemoved(S_FOR_SeluneStash_Chest_3121a64d-b19f-43eb-aade-b641429366c4, "FOR_SELUNESTASH_CHESTSEAL", _, _)
		AND
		IsTagged(S_FOR_SeluneStash_Chest_3121a64d-b19f-43eb-aade-b641429366c4, KNOCK_TARGET_b0cf1015-6367-4f54-82ef-92cd9df72590, 1)
		THEN
		ClearTag(S_FOR_SeluneStash_Chest_3121a64d-b19f-43eb-aade-b641429366c4, KNOCK_TARGET_b0cf1015-6367-4f54-82ef-92cd9df72590);
		//END_REGION Act1_FOR_Boosters - SeluneStash
	}
	EXIT
	{
	}
}
