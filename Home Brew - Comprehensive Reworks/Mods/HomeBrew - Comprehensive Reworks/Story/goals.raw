		AND
		QRY_SpeakerIsAvailable(_Player)
		AND
		QRY_IsInRange(S_HAV_Siege_W3_Boss_37223ef4-2293-4a2a-a1e2-88367d241fcf, _Player, 30.0)
		AND
		QRY_OnlyOnce("HAV_Siege_TentacleAppearedPAD")
		THEN
