		PROC
		PROC_StartDialog_AddExtraSpeakers(CAMP_Laezel_VossCampConfrontation_SCO_LaezelAvatar_e43d9a2a-7ea7-41a7-78cb-a62ccdc582b4, _ID)
		AND
