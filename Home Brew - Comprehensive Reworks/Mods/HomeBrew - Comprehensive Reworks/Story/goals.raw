		DB_CampNight((FLAG)NIGHT_Laezel_VossCampConfrontation_d6828c76-0e03-4aa1-b980-886fcf49f8a9, 8050,(CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
