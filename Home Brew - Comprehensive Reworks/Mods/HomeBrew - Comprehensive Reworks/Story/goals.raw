		PROC_TryStartAD(DEN_CapturedGoblin_AD_Guards_cfa86226-091b-06e1-dbeb-61af5caacc53,S_DEN_Griefling_7ce0afc2-e8f2-4f2e-82d8-27df98acc3d8);
		
