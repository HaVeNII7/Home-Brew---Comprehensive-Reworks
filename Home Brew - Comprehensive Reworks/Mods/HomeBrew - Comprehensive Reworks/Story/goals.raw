	KB
	{
		//REGION Door opening logic
		
		PROC
		PROC_GOB_TempleAccess_InitialEffects()
		AND
		DB_GOB_TempleAccess_CurrentState(_Disk, _Pos, _State)
		AND
		DB_GOB_TempleAccess_Neighbours(_Disk, _Pos, _Neighbour)
		AND
		DB_GOB_TempleAccess_Neighbours(_Neighbour, _Pos2, _Disk)
		AND
		DB_GOB_TempleAccess_DiskBones(_Pos2, _, _EffectID2)
		AND
		NOT DB_LoopEffect(_Neighbour, _, _EffectID2, _, _, _, _)
		AND
		DB_GOB_TempleAccess_DiskBones(_Pos, _Bone1, _EffectID1)
		AND
		DB_GOB_TempleAccess_MoonState(_State, _EffectName)
		THEN
		PROC_LoopEffect(_EffectName, _Disk, _EffectID1,  "WLD_Main_A", _Bone1, 1.0);
		
		PROC
		PROC_GOB_TempleAccess_InitialEffects()
		AND
		DB_GOB_TempleAccess_CurrentState(_Disk, _Pos, _State)
		AND
		NOT DB_GOB_TempleAccess_Neighbours(_Disk, _Pos, _)
		AND
		DB_GOB_TempleAccess_DiskBones(_Pos, _Bone1, _EffectID1)
		AND
		DB_GOB_TempleAccess_MoonState(_State, _EffectName)
		THEN
		PROC_LoopEffect(_EffectName, _Disk, _EffectID1,  "WLD_Main_A", _Bone1, 1.0);
		
		IF
		UseStarted(_, _Disk)
		AND
		DB_GOB_TempleAccess_Disk(_Disk)
		THEN
		PROC_GOB_TempleAccess_DisksCanUse(0);
		PROC_GOB_TempleAccess_SwitchEffectsTo(_Disk);
		PROC_GOB_TempleAccess_Rotate(_Disk);
		
		PROC
		PROC_GOB_TempleAccess_DisksCanUse((INTEGER)_CanUse)
		AND
		DB_GOB_TempleAccess_Disk(_Disk)
		THEN
		SetCanInteract(_Disk, _CanUse);
		
		PROC
		PROC_GOB_TempleAccess_SwitchEffectsTo((ITEM)_Disk)
		AND
		DB_GOB_TempleAccess_Rotation(_Disk, _MyRot)
		AND
		DB_GOB_TempleAccess_DiskBones(_PosBone, _, _)
		AND
		IntegerModulo(_PosBone, 4, _BasePositionBone)
		AND
		IntegerSubtract(_PosBone, _BasePositionBone, _OrientationBone)
		AND
		IntegerSubtract(_PosBone, _MyRot, _RawPos)
		AND
		IntegerSum(_RawPos, 8, _AssuredPositivePos)
		AND
		IntegerModulo(_AssuredPositivePos, 4, _NeighbourPos)
		AND
		DB_GOB_TempleAccess_Neighbours(_Disk, _NeighbourPos, _Neighbour)
		AND
		DB_GOB_TempleAccess_Rotation(_Neighbour, _NeighbourRot)
		AND
		IntegerSum(_NeighbourPos, 2, _RawFlippedBone)
		AND
		IntegerModulo(_RawFlippedBone, 4, _UnalignedNeighbourBone)
		AND
		IntegerSum(_UnalignedNeighbourBone, _NeighbourRot, _RawRotationAdjustedUnalignedNeighbourBone)
		AND
		IntegerModulo(_RawRotationAdjustedUnalignedNeighbourBone, 4, _RotationAdjustedUnalignedNeighbourBone)
		AND
		IntegerSum(4, _OrientationBone, _MaxInvertedOrientationBone)
		AND
		IntegerModulo(_MaxInvertedOrientationBone, 8, _InvertedOrientationBone)
		AND
		IntegerSum(_InvertedOrientationBone, _RotationAdjustedUnalignedNeighbourBone, _AlignedNeighbourBone)
		AND
		DB_GOB_TempleAccess_DiskBones(_AlignedNeighbourBone, _Bone2, _EffectID2)
		AND
		DB_LoopEffect(_Neighbour, _, _EffectID2, _, _, _, _)
		AND
		DB_GOB_TempleAccess_DiskBones(_PosBone, _Bone1, _EffectID1)
		AND
		DB_GOB_TempleAccess_CurrentState(_Disk, _NeighbourPos, _Value)
		AND
		DB_GOB_TempleAccess_MoonState(_Value, _EffectName)
		THEN
		PROC_GOB_TempleAccess_DebugText("Removing ", _Neighbour, _Bone2, _AlignedNeighbourBone);
		PROC_GOB_TempleAccess_DebugText("Adding ", _Disk, _Bone1, _PosBone);
		PROC_StopLoopEffect(_Neighbour, _EffectID2);
		PROC_LoopEffect(_EffectName, _Disk, _EffectID1,  "WLD_Main_A", _Bone1, 0.2);
		
		PROC
		PROC_GOB_TempleAccess_DebugText((STRING)_Change, (GUIDSTRING)_Object, (STRING)_BoneName, (INTEGER)_BoneID)
		AND
		Concatenate(_Change, _BoneName, _Str1)
		AND
		Concatenate(_Str1, ", at ID ", _Str2)
		AND
		ConcatenateInteger(_Str2, _BoneID, _DebugText)
		THEN
		DebugText(_Object, _DebugText);
		
		IF
		TextEvent("GOB_TempleAccess_DebugDiskEffect")
		AND
		GetTextEventParamInteger(1, _Int)
		AND
		DB_GOB_TempleAccess_Disk(_Disk)
		AND
		DB_GOB_TempleAccess_DiskBones(_Int, _Bone, _)
		THEN
		PlayEffect(_Disk, VFX_Script_Stub_Poof_01_f0cf792a-0f74-d17e-ad0d-6052a6131416, _Bone, 1.0);
		
		PROC
		PROC_GOB_TempleAccess_Rotate((ITEM)_Disk)
		AND
		DB_GOB_TempleAccess_Rotation(_Disk, _Rotation)
		THEN
		DB_GOB_TempleAccess_RotatingDisks(_Disk);
		ObjectTimerLaunch(_Disk, "GOB_TempleAccess_Rotating", 2300);
		SetAnimationEventInt(_Disk, "TempleDiscState", _Rotation);
		
		IF
		//EntityEvent(_Disk, "GOB_TempleAccess_DoneRotating")
		ObjectTimerFinished(_Disk, "GOB_TempleAccess_Rotating")
		THEN
		NOT DB_GOB_TempleAccess_RotatingDisks((ITEM)_Disk);
		
		IF
		ObjectTimerFinished(_Disk, "GOB_TempleAccess_Rotating")
		AND
		NOT DB_GOB_TempleAccess_RotatingDisks(_)
		THEN
		PROC_GOB_TempleAccess_FinishedRotation((ITEM)_Disk);
		
		PROC
		PROC_GOB_TempleAccess_FinishedRotation((ITEM)_Disk)
		AND
		DB_GOB_TempleAccess_Rotation(_Disk, _OldState)
		AND
		IntegerSum(_OldState, 1, _I)
		AND
		IntegerModulo(_I, 4, _NewState)
		THEN
		NOT DB_GOB_TempleAccess_Rotation(_Disk, _OldState);
		DB_GOB_TempleAccess_Rotation(_Disk, _NewState);
		
		PROC
		PROC_GOB_TempleAccess_FinishedRotation((ITEM)_Disk)
		AND
		DB_GOB_TempleAccess_CurrentState(_Disk, _Index, _OldMoon)
		AND
		IntegerSubtract(_Index, 1, _NewIndex)
		AND
		IntegerSum(_NewIndex, 4, _NewIndex2)
		AND
		IntegerModulo(_NewIndex2, 4, _ModIndex)
		THEN
		DB_GOB_TempleAccess_TempState(_Disk, _ModIndex, _OldMoon);
		NOT DB_GOB_TempleAccess_CurrentState(_Disk, _Index, _OldMoon);
		
		PROC
		PROC_GOB_TempleAccess_FinishedRotation((ITEM)_Disk)
		AND
		DB_GOB_TempleAccess_TempState(_Disk, _Index, _NewMoon)
		THEN
		NOT DB_GOB_TempleAccess_TempState(_Disk, _Index, _NewMoon);
		DB_GOB_TempleAccess_CurrentState(_Disk, _Index, _NewMoon);
		
		
		PROC
		PROC_GOB_TempleAccess_FinishedRotation((ITEM)_Disk)
		AND
		DB_GOB_TempleAccess_CurrentState(_Disk, _Index, _NewMoon)
		AND
		DB_GOB_TempleAccess_Neighbours(_Disk, _Index, _OtherDisk)
		AND
		IntegerSum(_Index, 2, _NewIndex)
		AND
		IntegerModulo(_NewIndex, 4, _ModIndex)
		AND
		DB_GOB_TempleAccess_CurrentState(_OtherDisk, _ModIndex, _OldMoon)
		THEN
		NOT DB_GOB_TempleAccess_CurrentState(_OtherDisk, _ModIndex, _OldMoon);
		DB_GOB_TempleAccess_CurrentState(_OtherDisk, _ModIndex, _NewMoon);
		
		PROC
		PROC_GOB_TempleAccess_FinishedRotation((ITEM)_Disk)
		THEN
		PROC_GOB_TempleAccess_DisksCanUse(1);
		
		QRY
		QRY_GOB_TempleAccess_AllDisksCorrect()
		AND
		NOT QRY_GOB_TempleAccess_AnyDiskWrong()
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_GOB_TempleAccess_AnyDiskWrong()
		AND
		DB_GOB_TempleAccess_GoalState(_Disk, _TargetState)
		AND
		DB_GOB_TempleAccess_CurrentState(_Disk, _, _CurrentState)
		AND
		_TargetState != _CurrentState
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_GOB_TempleAccess_FinishedRotation(_Disk)
		AND
		QRY_GOB_TempleAccess_AllDisksCorrect()
		AND
		DB_Players(_Player)
		AND
		IsInTrigger(_Player, S_GOB_TempleAccess_PuzzleApproach_AD_04cc41aa-0675-4c25-b5a7-5360f33a85a1, 1)
		AND
		QRY_SpeakerIsAvailable(_Player, 1)
		AND
		QRY_OnlyOnce("GOB_TempleAccess_DoorWasOpened")
		THEN
		StartVoiceBark(GOB_TempleAccess_VB_SolvedPuzzle_d01f181a-617e-bc4b-2fd0-b1b8e7a9b986, _Player);
		
		IF
		DB_GOB_TempleAccess_DesiredPosition(1)
		THEN
		DB_OnlyOnce("GOB_TempleAccess_DoorWasOpened");
		NOT DB_KnowledgeCheckTrigger_AD("GOB_TempleAccess_PuzzleApproach", TRIGGERGUID_S_GOB_TempleAccess_PuzzleApproach_AD_04cc41aa-0675-4c25-b5a7-5360f33a85a1, "Investigation", (DIFFICULTYCLASS)DC_Legacy_15_bddbb9b8-a242-4c3e-a2eb-3fd274c0c539, DIALOGRESOURCEGUID_GOB_TempleAccess_PuzzleApproach_AD_b1cf463a-da1c-c6fd-00c6-b15387da8a98, GOB_TempleAccess_State_Puzzle_CheckMade_b5774b21-5d68-1480-7fc0-bd4bd28cb1fa);
		
		PROC
		PROC_GOB_TempleAccess_FinishedRotation(_Disk)
		AND
		QRY_GOB_TempleAccess_AllDisksCorrect()
		THEN
		PROC_GOB_TempleAccess_OpenDoor();
		PROC_GOB_TempleAccess_SolvedPuzzleSound();
		
		PROC
		PROC_GOB_TempleAccess_SolvedPuzzleSound()
		AND
		IsLocked(ITEMGUID_S_GOB_TempleAccess_Door_7241f91d-e34f-4615-b484-3b338c109d55, 1)
		AND
		IsClosed(ITEMGUID_S_GOB_TempleAccess_Door_7241f91d-e34f-4615-b484-3b338c109d55, 1)
		THEN
		PlaySound(ITEMGUID_S_GOB_TempleAccess_Door_7241f91d-e34f-4615-b484-3b338c109d55, "SE_PUZ_GoblinTemple_Complete");
		
		PROC
		PROC_GOB_TempleAccess_OpenDoor()
		AND
		QRY_OnlyOnce("GOB_TempleAccess_DoorOpenReward")
		AND
		DB_Players(_Player)
		THEN
		QuestUpdate(_Player, "HIDDEN_WLD_Boosters", "GOB_TempleAccess_Solved");
		
		PROC
		PROC_GOB_TempleAccess_OpenDoor()
		THEN
		SetFlag(GOB_TempleAccess_Event_PuzzleSolved_e48a7760-a5b2-4f2e-9e9c-52645d772bd3, NULL_00000000-0000-0000-0000-000000000000, 0);
		Open(ITEMGUID_S_GOB_TempleAccess_Door_7241f91d-e34f-4615-b484-3b338c109d55);
		SetPortalIsOpen(S_TempleAccess_RoomTrigger_30655ce6-8b68-442f-9f16-ee253fb49f55,1);
		SetEntityEvent(ITEMGUID_S_GOB_TempleAccess_SconceHolder_c9efc370-7ed3-4c2e-a9b3-f2b5fc159b70, "StoryReveal");
		TriggerUnregisterForPlayers(TRIGGERGUID_S_GOB_TempleAccess_PuzzleApproach_AD_04cc41aa-0675-4c25-b5a7-5360f33a85a1);
		
		PROC
		PROC_GOB_TempleAccess_OpenDoor()
		AND
		IsLocked(S_GOB_TempleAccess_SconceHolder_c9efc370-7ed3-4c2e-a9b3-f2b5fc159b70, 1)
		THEN
		Unlock(ITEMGUID_S_GOB_TempleAccess_SconceHolder_c9efc370-7ed3-4c2e-a9b3-f2b5fc159b70);
		
		PROC
		PROC_GOB_TempleAccess_FinishedRotation(_Disk)
		AND
		DB_GOB_TempleAccess_Disk(_Disk)
		AND
		NOT QRY_GOB_TempleAccess_AllDisksCorrect()
		THEN
		Close(ITEMGUID_S_GOB_TempleAccess_Door_7241f91d-e34f-4615-b484-3b338c109d55);
		
		IF
		UseStarted(_, _Disk)
		AND
		DB_GOB_TempleAccess_Disk(_Disk)
		AND
		NOT DB_GlobalFlag((FLAG)GOB_TempleAccess_SconceHolderLockpicked_fce36e1c-ca39-48fc-b276-bfacde3663ed) // flagType: Global
		AND
		QRY_GOB_TempleAccess_DiskHasDifferentSymbols(_Disk) //Don't need to lock this if the disk has all the same symbols, as this is a null operation.
		THEN
		Lock(ITEMGUID_S_GOB_TempleAccess_SconceHolder_c9efc370-7ed3-4c2e-a9b3-f2b5fc159b70, "Act1_TempleAccess_PuzzleLock");
		
		QRY
		QRY_GOB_TempleAccess_DiskHasDifferentSymbols((ITEM)_Disk)
		AND
		DB_GOB_TempleAccess_CurrentState(_Disk, _, _State1)
		AND
		DB_GOB_TempleAccess_CurrentState(_Disk, _, _State2)
		AND
		_State1 != _State2
		THEN
		DB_NOOP(1);
		
		IF
		DualEntityEvent(_, _, "SHA_TempleAccess_Lever")
		AND
		NOT QRY_GOB_OpenTempleAccessDoor()
		THEN
		Close(ITEMGUID_S_GOB_TempleAccess_Door_7241f91d-e34f-4615-b484-3b338c109d55);
		
		QRY
		QRY_GOB_OpenTempleAccessDoor()
		AND
		IsOpened(IITEMGUID_S_GOB_TempleAccess_Door_7241f91d-e34f-4615-b484-3b338c109d55, 0)
		THEN
		SetFlag(GOB_TempleAccess_Event_PuzzleSolved_e48a7760-a5b2-4f2e-9e9c-52645d772bd3, NULL_00000000-0000-0000-0000-000000000000, 0);
		Open(ITEMGUID_S_GOB_TempleAccess_Door_7241f91d-e34f-4615-b484-3b338c109d55);
		SetPortalIsOpen(S_TempleAccess_RoomTrigger_30655ce6-8b68-442f-9f16-ee253fb49f55,1);
		TriggerUnregisterForPlayers(TRIGGERGUID_S_GOB_TempleAccess_PuzzleApproach_AD_04cc41aa-0675-4c25-b5a7-5360f33a85a1);
		
		IF
		UseStarted(_, S_SHA_TempleAccess_StairsDownstairs_3780fa8f-9257-4998-81c4-1b28c293b26e)
		THEN
		SetPortalIsOpen(S_TempleAccess_RoomTrigger_30655ce6-8b68-442f-9f16-ee253fb49f55, 1);
		TriggerUnregisterForPlayers(TRIGGERGUID_S_GOB_TempleAccess_PuzzleApproach_AD_04cc41aa-0675-4c25-b5a7-5360f33a85a1);
		
		
		PROC
		PROC_UND_TransitionCinematic_PassingTo(S_GOB_TempleAccess_TriggerUpstairs_67b88035-5a5c-4303-bf67-daa9b04497e5)
		THEN
		SetPortalIsOpen(S_TempleAccess_RoomTrigger_30655ce6-8b68-442f-9f16-ee253fb49f55, 1);
		TriggerUnregisterForPlayers(TRIGGERGUID_S_GOB_TempleAccess_PuzzleApproach_AD_04cc41aa-0675-4c25-b5a7-5360f33a85a1);
		
		//END_REGION
		
		//REGION Closing and opening the secret lever
		IF
		Unlocked(S_GOB_TempleAccess_SconceHolder_c9efc370-7ed3-4c2e-a9b3-f2b5fc159b70, _Character, _)
		AND
		_Character != NULL_00000000-0000-0000-0000-000000000000
		THEN
		SetFlag((FLAG)GOB_TempleAccess_SconceHolderLockpicked_fce36e1c-ca39-48fc-b276-bfacde3663ed, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		
		IF
		DB_GOB_TempleAccess_DesiredPosition(_Desired)
		AND
		DB_GOB_TempleAccess_DesiredPosition(_OldDesired)
		AND
		_Desired != _OldDesired
		THEN
		NOT DB_GOB_TempleAccess_DesiredPosition(_OldDesired);
		
		//END_REGION
		
		
		//REGION Debug
		
		PROC
		PROC_GOB_TempleAccess_DebugSolve()
		THEN
		SysClear("DB_GOB_TempleAccess_CurrentState", 3);
		
		PROC
		PROC_GOB_TempleAccess_DebugSolve()
		AND
		DB_GOB_TempleAccess_Disk(_Disk)
		AND
		DB_GOB_TempleAccess_DiskBones(_, _, _EffectID)
		THEN
		PROC_StopLoopEffect(_Disk, _EffectID);
		
		PROC
		PROC_GOB_TempleAccess_DebugSolve()
		THEN
		DB_GOB_TempleAccess_CurrentState(ITEMGUID_S_GOB_TempleAccess_Disk11_a8bd8016-7cc5-4a5a-92de-15613aebc266, 0, 2);
		DB_GOB_TempleAccess_CurrentState(ITEMGUID_S_GOB_TempleAccess_Disk11_a8bd8016-7cc5-4a5a-92de-15613aebc266, 1, 2);
		DB_GOB_TempleAccess_CurrentState(ITEMGUID_S_GOB_TempleAccess_Disk11_a8bd8016-7cc5-4a5a-92de-15613aebc266, 2, 2);
		DB_GOB_TempleAccess_CurrentState(ITEMGUID_S_GOB_TempleAccess_Disk11_a8bd8016-7cc5-4a5a-92de-15613aebc266, 3, 2);
		
		DB_GOB_TempleAccess_CurrentState(ITEMGUID_S_GOB_TempleAccess_Disk22_fca07efd-bd0c-4936-9e9d-2df2532864f7, 0, 0);
		DB_GOB_TempleAccess_CurrentState(ITEMGUID_S_GOB_TempleAccess_Disk22_fca07efd-bd0c-4936-9e9d-2df2532864f7, 1, 0);
		DB_GOB_TempleAccess_CurrentState(ITEMGUID_S_GOB_TempleAccess_Disk22_fca07efd-bd0c-4936-9e9d-2df2532864f7, 2, 0);
		DB_GOB_TempleAccess_CurrentState(ITEMGUID_S_GOB_TempleAccess_Disk22_fca07efd-bd0c-4936-9e9d-2df2532864f7, 3, 0);
		
		DB_GOB_TempleAccess_CurrentState(ITEMGUID_S_GOB_TempleAccess_Disk12_75ae740b-0cf0-411f-b49d-9d339711493c, 0, 1);
		DB_GOB_TempleAccess_CurrentState(ITEMGUID_S_GOB_TempleAccess_Disk12_75ae740b-0cf0-411f-b49d-9d339711493c, 1, 1);
		DB_GOB_TempleAccess_CurrentState(ITEMGUID_S_GOB_TempleAccess_Disk12_75ae740b-0cf0-411f-b49d-9d339711493c, 2, 0);
		DB_GOB_TempleAccess_CurrentState(ITEMGUID_S_GOB_TempleAccess_Disk12_75ae740b-0cf0-411f-b49d-9d339711493c, 3, 2);
		
		DB_GOB_TempleAccess_CurrentState(ITEMGUID_S_GOB_TempleAccess_Disk21_242d119d-cb79-45d4-a394-b190f488fa22, 0, 2);
		DB_GOB_TempleAccess_CurrentState(ITEMGUID_S_GOB_TempleAccess_Disk21_242d119d-cb79-45d4-a394-b190f488fa22, 1, 0);
		DB_GOB_TempleAccess_CurrentState(ITEMGUID_S_GOB_TempleAccess_Disk21_242d119d-cb79-45d4-a394-b190f488fa22, 2, 1);
		DB_GOB_TempleAccess_CurrentState(ITEMGUID_S_GOB_TempleAccess_Disk21_242d119d-cb79-45d4-a394-b190f488fa22, 3, 1);
		
		PROC
		PROC_GOB_TempleAccess_DebugSolve()
		THEN
		PROC_GOB_TempleAccess_InitialEffects();
		Open(ITEMGUID_S_GOB_TempleAccess_Door_7241f91d-e34f-4615-b484-3b338c109d55);
		SetPortalIsOpen(S_TempleAccess_RoomTrigger_30655ce6-8b68-442f-9f16-ee253fb49f55,1);
		TriggerUnregisterForPlayers(TRIGGERGUID_S_GOB_TempleAccess_PuzzleApproach_AD_04cc41aa-0675-4c25-b5a7-5360f33a85a1);
		
		//END_REGION
		
		//REGION Once the players have read the more detailed lorebook, they no longer need pesky skill checks.
		
		IF
		FlagSet(SHA_TempleOfShar_Quest_ReadInstructionPaper_c52a5b36-9a3b-4c68-843b-bc5242436019, _, _)
		THEN
		NOT DB_KnowledgeCheckTrigger_AD("GOB_TempleAccess_PuzzleApproach", TRIGGERGUID_S_GOB_TempleAccess_PuzzleApproach_AD_04cc41aa-0675-4c25-b5a7-5360f33a85a1, "Investigation", (DIFFICULTYCLASS)DC_Legacy_15_bddbb9b8-a242-4c3e-a2eb-3fd274c0c539, DIALOGRESOURCEGUID_GOB_TempleAccess_PuzzleApproach_AD_b1cf463a-da1c-c6fd-00c6-b15387da8a98, GOB_TempleAccess_State_Puzzle_CheckMade_b5774b21-5d68-1480-7fc0-bd4bd28cb1fa);
		
		IF
		DB_InRegion(_Player, TRIGGERGUID_S_GOB_TempleAccess_PuzzleApproach_AD_04cc41aa-0675-4c25-b5a7-5360f33a85a1)
		AND
		DB_GlobalFlag((FLAG)SHA_TempleOfShar_Quest_ReadInstructionPaper_c52a5b36-9a3b-4c68-843b-bc5242436019) // flagType: Global
		AND
		QRY_OncePerUserAndNearbyPlayers(_Player,"GOB_TempleAccess_InformedVB")
		THEN
		StartVoiceBark(VOICEBARKRESOURCEGUID_GOB_TempleAccess_PuzzleApproach_ReadInstructions_VB_e1f8165c-2e3c-08b3-bbfa-7c476c3a816a, _Player);
		
		//END_REGION
		
		
		//REGION Journal Logic
		IF
		GameBookInterfaceClosed(S_GOB_TempleAccess_Lorebook_283d7eff-f6e5-401f-852e-7ad7fb728b88, _Player)
		AND
		NOT DB_GOB_TempleAccess_ReadLorebook(1)
		AND
		QuestUpdateIsUnlocked(_Player, "SHA_Nightsong", "ReadHalsinDiary", 1)
		THEN
		QuestUpdate(_Player, "SHA_Nightsong", "ReadAgedJournal");
		
		IF
		GameBookInterfaceClosed(S_GOB_TempleAccess_Lorebook_283d7eff-f6e5-401f-852e-7ad7fb728b88, _Player)
		AND
		NOT DB_GOB_TempleAccess_ReadLorebook(1)
		AND
		QuestUpdateIsUnlocked(_Player, "SHA_Nightsong", "SawBook", 1)
		THEN
		QuestUpdate(_Player, "SHA_Nightsong", "ReadAgedJournal");
		
		IF
		GameBookInterfaceClosed(S_GOB_TempleAccess_Lorebook_283d7eff-f6e5-401f-852e-7ad7fb728b88, _Player)
		AND
		NOT DB_GOB_TempleAccess_ReadLorebook(1)
		THEN
		DB_GOB_TempleAccess_ReadLorebook(1);
		
		IF
		QuestUpdateUnlocked(_Player, "SHA_Nightsong", "ReadHalsinDiary")
		AND
		DB_GOB_TempleAccess_ReadLorebook(1)
		THEN
		QuestUpdate(_Player, "SHA_Nightsong", "ReadAgedJournal");
		
		IF
		QuestUpdateUnlocked(_Player, "SHA_Nightsong", "SawBook")
		AND
		DB_GOB_TempleAccess_ReadLorebook(1)
		THEN
		QuestUpdate(_Player, "SHA_Nightsong", "ReadAgedJournal");
		
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(193).Title("Act1_GOB_VoloBallad");
Goal(193)
{
	INIT
	{
		PROC_TriggerRegisterForPlayers(TRIGGERGUID_S_GOB_VoloBallad_SceneBox_9237b20a-8227-41fb-9de7-dc26729d77cf);
		PROC_TriggerRegisterForPlayers(TRIGGERGUID_S_GOB_VoloBallad_FirstHeardArea_7d714a14-2d80-44d4-ba90-479e8510c024);
		
		DB_Dialogs(S_GOB_VoloGuard_000_c25f0e79-b9f7-453c-8138-964bca267d93, DIALOGRESOURCEGUID_GOB_VoloBallad_Guard_17bcffb4-b779-f7ff-547c-dbd4f989f99d);
		
		DB_GOB_VoloBallad_CanTeleportToGoblinCamp(1);
		
		DB_HasItemEvent(S_GOB_VoloCage_Key_82df88e8-f42f-4dd7-bb11-34b8bed5e622, (FLAG)GOB_VoloBallad_GuardHasKey_2a96a079-d869-4cf0-8194-a17b39f7e6b9);
		DB_GiveItemToEvent(S_GOB_VoloCage_Key_82df88e8-f42f-4dd7-bb11-34b8bed5e622,(FLAG)GOB_VoloBallad_GuardGivesKey_ade25d8a-e00d-40cb-8c66-357cd5ed921e);
		
		DB_DialogMoneyTransfer(1,GOB_VoloBallad_Guard_AtCage_85b7cd39-6bcf-fbd2-da72-57020d75280e,20);
		DB_DialogMoneyTransfer(2,GOB_VoloBallad_Guard_AtCage_85b7cd39-6bcf-fbd2-da72-57020d75280e,100);
		DB_DialogMoneyTransfer(3,GOB_VoloBallad_Guard_AtCage_85b7cd39-6bcf-fbd2-da72-57020d75280e,250);
		DB_DialogMoneyTransfer(4,GOB_VoloBallad_Guard_AtCage_85b7cd39-6bcf-fbd2-da72-57020d75280e,500);
		
		DB_PermaDefeatedFlag(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, GLO_Volo_State_PermaDefeated_90bacc1d-9755-4e24-adc3-9016698a7be6);
		
		DB_HasItemTemplateScriptFlag(1,(DIALOGRESOURCE)GOB_VoloBallad_Volo_InCage_95702065-64ac-65ea-27fd-69a5a003db91,CONS_Potion_Invisible_A_809d5026-4896-4b3a-986e-95da58da77e2,1);
		TriggerRegisterForCharacter(S_GOB_VoloBallad_InCage_17b0e3c4-d1b1-4080-b64f-a0ca67f07b2c,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		
		Open((ITEM)S_GOB_VoloBallad_CageDoor_e370ae71-e10a-4a6c-9635-94783ae772cd);
		SetCanInteract((ITEM)S_GOB_VoloBallad_CageDoor_e370ae71-e10a-4a6c-9635-94783ae772cd,0);
	}
	KB
	{
		//REGION DEBUG
		IF
		FlagSet((FLAG)Debug_GOB_VoloBallad_ToPrison_ba34da35-845d-4471-bb97-7fe7af8a14ea,_,_)
		THEN
		PROC_GOB_VoloBallad_SetupOnSceneFlags();
		ClearFlag((FLAG)GOB_VoloBallad_State_OnStage_0bc1d7d7-9129-4c6e-188d-054640cea3b9, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		PROC_RemoveDialog(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		PROC_RemoveDialog(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93);
		DB_Dialogs(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,GOB_VoloBallad_Volo_InCage_95702065-64ac-65ea-27fd-69a5a003db91);
		DB_Dialogs(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93,GOB_VoloBallad_Guard_AtCage_85b7cd39-6bcf-fbd2-da72-57020d75280e);
		DB_GOB_VoloBallad_InterruptDialog(1);
		TeleportTo(S_GOB_VoloGuard_000_c25f0e79-b9f7-453c-8138-964bca267d93, TRIGGERGUID_S_GOB_VoloGuard_CagePoint_d3f2c1c1-fcc5-4a7d-85de-63fc7d1132c6,"");
		TeleportTo(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, TRIGGERGUID_S_GOB_Volo_CagePoint_696dcbd7-ef54-42ad-915d-665f44fb9fb3,"GOB_VoloBallad_VoloMovedToCage");
		ClearFlag((FLAG)Debug_GOB_VoloBallad_ToPrison_ba34da35-845d-4471-bb97-7fe7af8a14ea, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		PROC_SetCustomTradeTreasure(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"GOB_Volo_Imprisoned_Trade");
		SetCanTrade(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,0);
		SetFlag(GOB_VoloBallad_Event_StartedEscorting_a434b9cc-ac7d-42a3-9bb5-097da1a6fe96,S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93);
		
		//END_REGION
		
		//REGION Moving Volo to Goblin Camp
		IF
		FlagSet(Debug_Quest_VoloToCamp_fd40e1a2-b595-23f8-9147-e6842e12bd01, _, _) // flagType: Object
		THEN
		AppearAt(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, TRIGGERGUID_S_GOB_Volo_ScenePoint_bcb4ce23-d204-4d67-b96f-51ba34037cb0, 0, NULL_00000000-0000-0000-0000-000000000000, "");
		PROC_DEN_RemoveFromDenNPCs(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		PROC_GOB_VoloBallad_SetupOnSceneFlags();
		
		IF
		EntityEvent(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"DEN_VoloLeft")
		AND
		DB_GOB_VoloBallad_CanTeleportToGoblinCamp(1)
		THEN
		PROC_GOB_Festivities_TeleportNPCToFestivities(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "GOB_VoloBallad_Event_VoloTeleported",  TRIGGERGUID_S_GOB_Volo_ScenePoint_bcb4ce23-d204-4d67-b96f-51ba34037cb0);
		
		IF
		EnteredTrigger(_Player, S_GOB_CampFirstHalfArea_d98ba3fa-743e-4d0e-98d8-2b3f79c17647)
		AND
		DB_Players(_Player)
		AND
		DB_GOB_VoloBallad_CanTeleportToGoblinCamp(1)
		THEN
		PROC_GOB_Festivities_TeleportNPCToFestivities(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "GOB_VoloBallad_Event_VoloTeleported",  TRIGGERGUID_S_GOB_Volo_ScenePoint_bcb4ce23-d204-4d67-b96f-51ba34037cb0);
		
		IF
		EntityEvent(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "GOB_VoloBallad_Event_VoloTeleported")
		THEN
		NOT DB_GOB_VoloBallad_CanTeleportToGoblinCamp(1);
		PROC_DEN_RemoveFromDenNPCs(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		SetFlag((FLAG)GLO_Volo_State_AtGoblinCamp_fc815506-028d-582d-a953-4182d682aa07, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		
		IF
		EntityEvent(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "GOB_VoloBallad_Event_VoloTeleported")
		AND
		NOT DB_Defeated(S_GOB_VoloGuard_000_c25f0e79-b9f7-453c-8138-964bca267d93)
		THEN
		PROC_GOB_VoloBallad_SetupOnSceneFlags();
		PROC_NotifyWhenReadyToMoveOn((CHARACTER)S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93,"VoloGuard_ToVoloStage");
		
		PROC
		PROC_GOB_VoloBallad_SetupOnSceneFlags()
		THEN
		PROC_SceneDialogOnly("GOB_VoloScene", (CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, (TRIGGER)S_GOB_VoloBaladTrigger_91d3dd42-57ad-4d6f-a165-619176d79552);
		ClearFlag((FLAG)GLO_Volo_State_AtDen_c1bb44ab-c358-46d1-a261-34356bf1d071, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		SetFlag((FLAG)GOB_VoloBallad_State_OnStage_0bc1d7d7-9129-4c6e-188d-054640cea3b9, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		PROC_CRIME_MusicalPerformance_DisableAllReactions((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		
		IF
		FlagSet((FLAG)GOB_VoloBallad_State_OnStage_0bc1d7d7-9129-4c6e-188d-054640cea3b9,_,_)
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		DB_Dialogs(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, NULL_00000000-0000-0000-0000-000000000000, GOB_VoloBallad_Volo_FestivitiesArea_30ce4472-a341-1b45-48ef-1913293b80ed);
		PROC_SetCustomTradeTreasure(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"GOB_Volo_Imprisoned_Trade");
		SetCanTrade(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,0);
		SetRelation(ACT1_GOB_VoloGuard_5e50ffef-d250-4a18-a3d4-b3fe4f574a4b,GLO_Volo_6c49b752-0dc2-4f85-86cf-0c2bd418305c,100);
		PROC_CharacterDisableAllCrimes((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		
		PROC
		PROC_ReadyToMoveOn((CHARACTER)S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93,"VoloGuard_ToVoloStage")
		THEN
		TeleportTo(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93,S_GOB_VoloGuard_StagePoint_fe60b517-d8bf-4d8a-980e-bea1e0d71879);
		
		//END_REGION 
		
		//REGION Moving Volo to Goblin Camp - Edge Cases
		IF
		EntityEvent(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "GOB_VoloBallad_Event_VoloTeleported")
		AND
		DB_GlobalFlag((FLAG)GOB_FestivitiesArea_State_Swept_01863b85-a514-473a-9fa9-2869612480a2)
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		DB_Dialogs(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,GOB_VoloBallad_Volo_Massacre_828e7fea-2790-c7dc-0d2a-307387abe9c3);
		
		IF
		DialogEnded(GOB_VoloBallad_Volo_Massacre_828e7fea-2790-c7dc-0d2a-307387abe9c3, _)
		AND
		DB_GlobalFlag((FLAG)GOB_VoloBallad_State_SentToPartyCamp_f873df3f-0618-5859-1701-1cdab77ab126)
		THEN
		PROC_DisappearOutOfSight((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"Run",0,"GOB_VoloBallad_InvitedToCamp_GoblinMassacre");
		
		IF
		EntityEvent(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"GOB_VoloBallad_InvitedToCamp_GoblinMassacre")
		THEN
		PROC_GOB_VoloBallad_MoveVoloToCamp(CAMP_VoloOperation_ba7c506d-c743-5dc9-7d98-eeea7b4ef2a2);
		
		IF
		EntityEvent(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "GOB_VoloBallad_Event_VoloTeleported")
		AND
		NOT DB_GlobalFlag((FLAG)GOB_FestivitiesArea_State_Swept_01863b85-a514-473a-9fa9-2869612480a2)
		AND
		DB_Defeated(S_GOB_VoloGuard_000_c25f0e79-b9f7-453c-8138-964bca267d93)
		THEN
		PROC_GOB_VoloBallad_MoveVoloToCamp(CAMP_VoloOperation_ba7c506d-c743-5dc9-7d98-eeea7b4ef2a2);
		
		//END_REGION
		
		
		//REGION Play VB when heard
		IF
		EnteredTrigger(_Player, TRIGGERGUID_S_GOB_VoloBallad_FirstHeardArea_7d714a14-2d80-44d4-ba90-479e8510c024)
		AND
		DB_GlobalFlag((FLAG)GOB_VoloBallad_State_OnStage_0bc1d7d7-9129-4c6e-188d-054640cea3b9) // flagType: Global
		AND
		DB_Players(_Player)
		THEN
		StartVoiceBark(VOICEBARKRESOURCEGUID_GOB_VoloBallad_VB_HeardSinging_fa672712-28f2-6171-7a53-07167577cf62, _Player);
		
		IF
		EnteredTrigger(_Player, TRIGGERGUID_S_GOB_VoloBallad_FirstHeardArea_7d714a14-2d80-44d4-ba90-479e8510c024)
		THEN
		PROC_TriggerUnregisterForPlayers(TRIGGERGUID_S_GOB_VoloBallad_FirstHeardArea_7d714a14-2d80-44d4-ba90-479e8510c024);
		
		IF
		EnteredTrigger(_Player, TRIGGERGUID_S_GOB_VoloBallad_SceneBox_9237b20a-8227-41fb-9de7-dc26729d77cf)
		THEN
		PROC_TriggerUnregisterForPlayers(TRIGGERGUID_S_GOB_VoloBallad_FirstHeardArea_7d714a14-2d80-44d4-ba90-479e8510c024);
		
		//END_REGION
		
		
		//REGION Add guard to dialogue when on scene
		QRY
		QRY_SelectCustomDialog(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, _Player)
		AND
		NOT DB_AD_Dialog((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,(DIALOGRESOURCE)GOB_VoloBallad_AD_Cower_5a6e8796-c03c-8c2c-a1e9-5ca415e097d2)
		AND
		DB_GlobalFlag((FLAG)GOB_VoloBallad_State_OnStage_0bc1d7d7-9129-4c6e-188d-054640cea3b9)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_GOB_VoloGuard_000_c25f0e79-b9f7-453c-8138-964bca267d93, _Player)
		THEN
		DB_SelectedDialog((DIALOGRESOURCE)GOB_VoloBallad_Volo_FestivitiesArea_30ce4472-a341-1b45-48ef-1913293b80ed, S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, S_GOB_VoloGuard_000_c25f0e79-b9f7-453c-8138-964bca267d93, _Player);
		
		QRY
		QRY_SelectCustomDialog(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, _Player)
		AND
		NOT DB_AD_Dialog((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,(DIALOGRESOURCE)GOB_VoloBallad_AD_Cower_5a6e8796-c03c-8c2c-a1e9-5ca415e097d2)
		AND
		DB_GlobalFlag((FLAG)GOB_VoloBallad_State_OnStage_0bc1d7d7-9129-4c6e-188d-054640cea3b9)
		AND
		NOT QRY_SpeakerIsAvailableAndInDialogRange(S_GOB_VoloGuard_000_c25f0e79-b9f7-453c-8138-964bca267d93, _Player)
		THEN
		DB_SelectedDialog((DIALOGRESOURCE)GOB_VoloBallad_AD_PleaForHelp_1ce1361d-ee62-af9a-df20-9cb3530800f5, S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		
		//END_REGION
		
		
		//REGION Running away while not in the temple due to guard defeated; Battle Stations state
		PROC
		PROC_StateSet_Defeated(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93)
		AND
		QRY_GOB_VoloOnStageOrBeingKickedFromIt()
		AND
		NOT DB_GlobalFlag((FLAG)GOB_VoloBallad_State_VoloIsCowering_f2fdd7e7-b5a5-4211-bbf6-89cee980c980)
		THEN
		PROC_DisappearOutOfSight(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "Run", 0, "GOB_VoloBallad_VoloFled");
		
		IF
		FlagCleared((FLAG)GOB_VoloBallad_State_VoloIsCowering_f2fdd7e7-b5a5-4211-bbf6-89cee980c980,_,_)
		AND
		QRY_GOB_VoloOnStageOrBeingKickedFromIt()
		AND
		DB_Defeated(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93)
		THEN
		PROC_DisappearOutOfSight(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "Run", 0, "GOB_VoloBallad_VoloFled");
		
		QRY
		QRY_GOB_VoloOnStageOrBeingKickedFromIt()
		AND
		DB_GlobalFlag((FLAG)GOB_VoloBallad_State_OnStage_0bc1d7d7-9129-4c6e-188d-054640cea3b9)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_GOB_VoloOnStageOrBeingKickedFromIt()
		AND
		DB_GOB_VoloBallad_EscortInProcess(1)
		AND
		NOT DB_GlobalFLag((FLAG)GOB_Volo_State_BeingEscorted_d5a9c68f-bf66-4462-b2bd-066b4547cd19)
		THEN
		DB_NOOP(1);
		
		IF
		DB_GlobalFlag((FLAG)GOB_GoblinToast_State_RealizedPoison_0e867c08-b2b9-4f43-8260-168026663e2c)
		AND
		DB_GlobalFlag((FLAG)GOB_GoblinToast_Event_ToStations_0b555ee8-2b8e-3881-b35e-9811f6baf77a)
		AND
		DB_GlobalFlag((FLAG)GOB_VoloBallad_State_OnStage_0bc1d7d7-9129-4c6e-188d-054640cea3b9)
		AND
		QRY_OnlyOnce("GOB_SetADsOnVoloDueToBattleStations_OnlyOnce")
		THEN
		PROC_SceneOver("GOB_VoloScene");
		PROC_RemoveAllDialogEntriesForSpeaker(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		DB_AD_Dialog((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,(DIALOGRESOURCE)GOB_VoloBallad_AD_Cower_5a6e8796-c03c-8c2c-a1e9-5ca415e097d2);
		//END_REGION 
		
		
		//REGION Approaching Volo
		IF
		EnteredTrigger(_Player, TRIGGERGUID_S_GOB_VoloBallad_SceneBox_9237b20a-8227-41fb-9de7-dc26729d77cf)
		AND
		DB_Players(_Player)
		AND
		NOT DB_GlobalFlag(GOB_FestivitiesArea_State_Hostile_d5ee4e10-d88b-4226-9607-41b7399a837f)
		AND
		NOT DB_GOB_VoloBallad_VoloPledForHelp(_Player)
		AND
		NOT DB_GOB_VoloBallad_VoloIsPleadingForHelp(1)
		THEN
		DialogRequestStopForDialog(DIALOGRESOURCEGUID_GOB_VoloBallad_AD_Song_623358f2-4477-b6b4-841f-df2c54a14820, S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		DB_GOB_VoloBallad_VoloIsPleadingForHelp(1);
		DB_GOB_VoloBallad_VoloPledForHelp(_Player);
		PROC_TryStartAD(DIALOGRESOURCEGUID_GOB_VoloBallad_AD_PleaForHelp_1ce1361d-ee62-af9a-df20-9cb3530800f5, S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		
		PROC
		PROC_DialogFlagSetup(DIALOGRESOURCEGUID_GOB_VoloBallad_AD_PleaForHelp_1ce1361d-ee62-af9a-df20-9cb3530800f5, S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa)
		AND
		DB_Players(_Player)
		AND
		DB_Sees(_Player, S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa)
		AND
		CanSee(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, _Player, 1)
		AND
		DB_GlobalFlag((FLAG)GLO_Volo_HasMet_07ff1071-2535-f215-72d3-224e360af5f2)
		THEN
		SetFlag((FLAG)GOB_VoloBallad_State_SeenFamiliarPlayer_b08852ad-7864-4537-ac5c-64a44f3a8188, S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa); // flagType: Object
		
		IF
		AutomatedDialogEnded(DIALOGRESOURCEGUID_GOB_VoloBallad_AD_PleaForHelp_1ce1361d-ee62-af9a-df20-9cb3530800f5, _)
		AND
		DB_GOB_VoloBallad_VoloIsPleadingForHelp(1)
		THEN
		NOT DB_GOB_VoloBallad_VoloIsPleadingForHelp(1);
		PROC_TriggerUnregisterForPlayers(TRIGGERGUID_S_GOB_VoloBallad_SceneBox_9237b20a-8227-41fb-9de7-dc26729d77cf);
		
		//END_REGION Approaching Volo
		
		
		//REGION Escorting Volo to the cage
		IF
		DialogEnded(GOB_VoloBallad_Volo_FestivitiesArea_30ce4472-a341-1b45-48ef-1913293b80ed, _)
		AND
		GetFlag((FLAG)GOB_VoloBallad_Event_Leave_ae4173bc-b88a-3845-e5ca-498a9be1ad3e, S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, 1) // flagType: Object
		THEN
		PROC_GOB_VoloBallad_LeaveEvent();
		PROC_GOB_VoloBallad_StartEscort();
		
		PROC
		PROC_GOB_VoloBallad_LeaveEvent()
		THEN
		PROC_SceneOver("GOB_VoloScene");
		SetFlag(GOB_VoloBallad_Event_StartedEscorting_a434b9cc-ac7d-42a3-9bb5-097da1a6fe96,S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93);
		ClearFlag((FLAG)GOB_VoloBallad_State_OnStage_0bc1d7d7-9129-4c6e-188d-054640cea3b9);
		PROC_RemoveDialog(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		PROC_RemoveDialog(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93);
		DB_GOB_VoloBallad_InterruptDialog(1);
		DB_GOB_VoloBallad_EscortInProcess(1);
		
		IF
		DB_GOB_VoloBallad_EscortInProcess(1)
		THEN
		SetForceUpdate(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, 1);
		SetForceUpdate(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93, 1);
		
		PROC
		PROC_GOB_VoloBallad_StartEscort()
		THEN
		PROC_TryStartAD(DIALOGRESOURCEGUID_GOB_VoloBallad_AD_MovingToCage_8a9c2e6f-8d91-c8af-a06e-5fd77785ac60, S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93, S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		ClearFlag((FLAG)GOB_VoloBallad_Event_Leave_ae4173bc-b88a-3845-e5ca-498a9be1ad3e, S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa); // flagType: Object
		
		IF
		AutomatedDialogRequestFailed(DIALOGRESOURCEGUID_GOB_VoloBallad_AD_MovingToCage_8a9c2e6f-8d91-c8af-a06e-5fd77785ac60, _)
		THEN
		PROC_GOB_VoloBallad_StartMovingToCages();
		
		IF
		AutomatedDialogEnded(DIALOGRESOURCEGUID_GOB_VoloBallad_AD_MovingToCage_8a9c2e6f-8d91-c8af-a06e-5fd77785ac60, _)
		THEN
		PROC_GOB_VoloBallad_StartMovingToCages();
		
		PROC
		PROC_GOB_VoloBallad_StartMovingToCages()
		THEN
		SetWeaponUnsheathed(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93,1,1);
		PROC_CharacterMoveTo(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"Walk","GOB_VoloBallad_GuardClimbedToVolo");
		
		IF
		EntityEvent(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93,"GOB_VoloBallad_GuardClimbedToVolo")
		THEN
		UseSpell(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93,"Target_GOB_VoloGuard_Shove",S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		TimerLaunch("GOB_VoloBallad_GuardKickedVolo",1500);
		
		IF
		TimerFinished("GOB_VoloBallad_GuardKickedVolo")
		THEN
		Follow(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		SetCombatGroupID(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93,"");
		SetFlag(GOB_Volo_State_BeingEscorted_d5a9c68f-bf66-4462-b2bd-066b4547cd19, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		EntityEvent(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "GOB_VoloBallad_VoloArrivedAtDoor")
		AND
		NOT DB_CantMove(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93)
		AND
		NOT DB_CantMove(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa)
		THEN
		TeleportTo(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, S_GOB_ThroneRoom_EntranceTarget_79fe7e37-8d9c-4e4e-bcbf-36783b6393b2, "", 0, 0, 0, 1, 1);
		TeleportTo(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93, S_GOB_ThroneRoom_EntranceTarget_79fe7e37-8d9c-4e4e-bcbf-36783b6393b2, "", 0, 0, 0, 1, 1);
		Follow(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93, S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		DB_CorpseLooting_ClearRedOutlineOnFactionGroupTagged("WLD_Main_A","Act1_GOB_UpperLevel",(FACTION)ACT1_GOB_VoloGuard_5e50ffef-d250-4a18-a3d4-b3fe4f574a4b,(TAG)PERMA_DEFEATED_867f3a1e-1e4b-48c2-869e-343415231727);
		NOT DB_CorpseLooting_ClearRedOutlineOnFactionGroupTagged("WLD_Main_A","Act1_GOB_Outside",(FACTION)ACT1_GOB_VoloGuard_5e50ffef-d250-4a18-a3d4-b3fe4f574a4b,(TAG)PERMA_DEFEATED_867f3a1e-1e4b-48c2-869e-343415231727);
		DB_GOB_BattleStations_CombatGroupCharacters(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93, "BattleStations_Priestess", NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		EnteredTrigger((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,S_GOB_VoloBallad_InCage_17b0e3c4-d1b1-4080-b64f-a0ca67f07b2c)
		AND
		DB_GOB_VoloBallad_EscortInProcess(1)
		THEN
		PROC_CharacterMoveTo(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, TRIGGERGUID_S_GOB_Volo_CagePoint_696dcbd7-ef54-42ad-915d-665f44fb9fb3, "Run", "GOB_VoloBallad_VoloMovedToCage");
		
		IF
		EnteredTrigger((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,S_GOB_VoloBallad_InCage_17b0e3c4-d1b1-4080-b64f-a0ca67f07b2c)
		THEN
		SetFlag((FLAG)GOB_VoloBallad_State_InCage_a48a226c-9789-4d13-2771-0daa94f112b7);
		
		IF
		LeftTrigger((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,S_GOB_VoloBallad_InCage_17b0e3c4-d1b1-4080-b64f-a0ca67f07b2c)
		THEN
		ClearFlag((FLAG)GOB_VoloBallad_State_InCage_a48a226c-9789-4d13-2771-0daa94f112b7);
		
		IF
		EntityEvent(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "GOB_VoloBallad_VoloMovedToCage")
		THEN
		NOT DB_GOB_VoloBallad_EscortInProcess(1);
		DB_Dialogs(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,GOB_VoloBallad_Volo_InCage_95702065-64ac-65ea-27fd-69a5a003db91);
		SetForceUpdate(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, 0);
		SetForceUpdate(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93, 0);
		ClearFlag(GOB_Volo_State_BeingEscorted_d5a9c68f-bf66-4462-b2bd-066b4547cd19, NULL_00000000-0000-0000-0000-000000000000, 0);
		PROC_TriggerRegisterForPlayers(S_GOB_VoloBallad_PleaInCage_ADtrigger_701d181d-cba2-4e97-a2c9-46dd5e486a20);
		
		IF
		EntityEvent(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "GOB_VoloBallad_VoloMovedToCage")
		THEN
		SetCanInteract((ITEM)S_GOB_VoloBallad_CageDoor_e370ae71-e10a-4a6c-9635-94783ae772cd,1);
		SetOwner(S_GOB_VoloBallad_CageDoor_e370ae71-e10a-4a6c-9635-94783ae772cd, S_GOB_VoloGuard_000_c25f0e79-b9f7-453c-8138-964bca267d93);
		StopFollow(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93);
		DB_Dialogs(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93,GOB_VoloBallad_Guard_AtCage_85b7cd39-6bcf-fbd2-da72-57020d75280e);
		
		IF
		EntityEvent(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "GOB_VoloBallad_VoloMovedToCage")
		THEN
		TriggerRegisterForCharacter(S_GOB_VoloBallad_CageBox_d8f061e4-747e-48c9-a8e2-2b7521bda473,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		TriggerRegisterForCharacter(S_GOB_VoloBallad_CageBox_d8f061e4-747e-48c9-a8e2-2b7521bda473,S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93);
		
		IF
		DB_InRegion(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,S_GOB_VoloBallad_InCage_17b0e3c4-d1b1-4080-b64f-a0ca67f07b2c)
		AND
		NOT QRY_QuestUpdateIsUnlockedForAny("DEN_VoloAdventure","VoloPrison")
		AND
		DB_PartyMembers(_PartyMember)
		AND
		DB_Sees(_PartyMember,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa)
		AND
		IsLocked((ITEM)S_GOB_VoloBallad_CageDoor_e370ae71-e10a-4a6c-9635-94783ae772cd,1)
		THEN
		QuestUpdate("DEN_VoloAdventure","VoloPrison");
		
		// Edge case for when volo guard sees Halsin but can't react to continuous GOB_WolfPens_EscapedPrisoner disturbance due to executing osiris Follow
		IF
		DB_Sees(S_GOB_VoloGuard_000_c25f0e79-b9f7-453c-8138-964bca267d93,S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		AND
		DB_GOB_VoloBallad_EscortInProcess(1)
		AND
		DB_GlobalFlag((FLAG)GLO_Halsin_Knows_IsFound_a0d83476-e2d0-4972-a76b-b23c39078cd7)
		THEN
		PROC_MakeNPCHostile(S_GOB_VoloGuard_000_c25f0e79-b9f7-453c-8138-964bca267d93,S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		//END_REGION Escorting Volo to the cage
		
		
		//REGION Volo stop following
		IF
		EnteredCombat(S_GOB_VoloGuard_000_c25f0e79-b9f7-453c-8138-964bca267d93, _)
		AND
		DB_GOB_VoloBallad_EscortInProcess(1)
		AND
		IsInTrigger(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, TRIGGERGUID_S_GOB_Festivities_BingeArea_f4a4031d-7e0c-45b8-970b-47c62d4908d8, 0)
		THEN
		NOT DB_GOB_VoloBallad_EscortInProcess(1);
		SetForceUpdate(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, 0);
		SetForceUpdate(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93, 0);
		ClearFlag(GOB_Volo_State_BeingEscorted_d5a9c68f-bf66-4462-b2bd-066b4547cd19, NULL_00000000-0000-0000-0000-000000000000, 0);
		StopFollow(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93);
		PROC_DisappearOutOfSight(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "Run", 0, "GOB_VoloBallad_VoloFled");
		
		IF
		EntityEvent(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "GOB_VoloBallad_VoloFled")
		AND
		DB_QuestIsOpened("DEN_VoloAdventure")
		AND
		NOT QRY_QuestUpdateIsUnlockedForAny("DEN_VoloAdventure", "VoloFree")
		THEN
		QuestUpdate("DEN_VoloAdventure", "VoloEscaped");
		
		IF
		EntityEvent(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "GOB_VoloBallad_VoloFled")
		THEN
		TriggerUnregisterForCharacter(S_GOB_VoloBallad_CageBox_d8f061e4-747e-48c9-a8e2-2b7521bda473,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		TriggerUnregisterForCharacter(S_GOB_VoloBallad_InCage_17b0e3c4-d1b1-4080-b64f-a0ca67f07b2c,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		ClearFlag((FLAG)GOB_VoloBallad_State_InCage_a48a226c-9789-4d13-2771-0daa94f112b7);
		PROC_GOB_VoloBallad_MoveVoloToCamp(CAMP_VoloOperation_ba7c506d-c743-5dc9-7d98-eeea7b4ef2a2);
		
		IF
		DB_PermaDefeated(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa)
		THEN
		NOT DB_GOB_VoloBallad_EscortInProcess(1);
		SetForceUpdate(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, 0);
		SetForceUpdate(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93, 0);
		ClearFlag(GOB_Volo_State_BeingEscorted_d5a9c68f-bf66-4462-b2bd-066b4547cd19, NULL_00000000-0000-0000-0000-000000000000, 0);
		StopFollow(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93);
		PROC_RemoveAllDialogEntriesForSpeaker(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93);
		DB_Dialogs(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93,(DIALOGRESOURCE)GOB_VoloBallad_Guard_17bcffb4-b779-f7ff-547c-dbd4f989f99d);
		
		IF
		KilledBy(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,_PartyMember,_,_)
		AND
		DB_PartyMembers((CHARACTER)_PartyMember)
		AND
		DB_Sees(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa)
		AND
		NOT DB_GlobalFlag((FLAG)GOB_VoloBallad_State_GuardGaveVoloToPlayers_e1041faa-5c24-bb66-92e9-4826f46d7e90)
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT1_GOB_VoloGuard_5e50ffef-d250-4a18-a3d4-b3fe4f574a4b,0);
		
		IF
		DB_Defeated(S_GOB_VoloGuard_000_c25f0e79-b9f7-453c-8138-964bca267d93)
		AND
		DB_GlobalFlag(GOB_Volo_State_BeingEscorted_d5a9c68f-bf66-4462-b2bd-066b4547cd19)
		THEN
		NOT DB_GOB_VoloBallad_EscortInProcess(1);
		SetForceUpdate(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, 0);
		SetForceUpdate(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93, 0);
		ClearFlag(GOB_Volo_State_BeingEscorted_d5a9c68f-bf66-4462-b2bd-066b4547cd19, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetFlag((FLAG)GOB_VoloBallad_State_VoloPrepsEscape_fef2b414-aa62-1b1d-4279-ae2a8ea4a2de);
		PROC_GOB_VoloBallad_Escape();
		
		//END_REGION Volo stop following
		
		
		//REGION Guard forbids speaking to Volo
		QRY
		QRY_SelectCustomDialog(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, _Player)
		AND
		NOT DB_GlobalFlag((FLAG)GOB_VoloBallad_State_OnStage_0bc1d7d7-9129-4c6e-188d-054640cea3b9)
		AND
		NOT DB_GlobalFlag((FLAG)GOB_VoloBallad_State_GuardGaveVoloToPlayers_e1041faa-5c24-bb66-92e9-4826f46d7e90)
		AND
		DB_GOB_VoloBallad_InterruptDialog(1)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_GOB_VoloGuard_000_c25f0e79-b9f7-453c-8138-964bca267d93, _Player)
		AND
		CanSee(S_GOB_VoloGuard_000_c25f0e79-b9f7-453c-8138-964bca267d93, _Player, 1)
		THEN
		DB_GOB_VoloBallad_SetInterruptedFlag(1);
		DB_SelectedDialog((DIALOGRESOURCE)GOB_VoloBallad_Guard_AtCage_85b7cd39-6bcf-fbd2-da72-57020d75280e, S_GOB_VoloGuard_000_c25f0e79-b9f7-453c-8138-964bca267d93, _Player);
		
		PROC
		PROC_DialogFlagSetup(DIALOGGUID_GOB_VoloBallad_Guard_17bcffb4-b779-f7ff-547c-dbd4f989f99d, S_GOB_VoloGuard_000_c25f0e79-b9f7-453c-8138-964bca267d93, _Player)
		AND
		DB_GOB_VoloBallad_SetInterruptedFlag(1)
		THEN
		SetFlag((FLAG)GOB_VoloBallad_State_InterruptedVoloDialogue_d1bd1dd9-9011-e4f9-624a-51cd06917e4c, S_GOB_VoloGuard_000_c25f0e79-b9f7-453c-8138-964bca267d93); // flagType: Object
		NOT DB_GOB_VoloBallad_SetInterruptedFlag(1);
		
		IF
		DB_GlobalFlag((FLAG)GOB_VoloBallad_State_GuardGaveVoloToPlayers_e1041faa-5c24-bb66-92e9-4826f46d7e90)
		THEN
		ClearOwnership(S_GOB_VoloBallad_CageDoor_e370ae71-e10a-4a6c-9635-94783ae772cd);
		TriggerUnregisterForCharacter(S_GOB_VoloBallad_CageBox_d8f061e4-747e-48c9-a8e2-2b7521bda473,S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93);
		
		IF
		LeftTrigger(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93,S_GOB_VoloBallad_CageBox_d8f061e4-747e-48c9-a8e2-2b7521bda473)
		THEN
		PROC_GlobalClearFlagAndCache((FLAG)GOB_VoloBallad_State_GuardPresent_f84e156b-5de5-4ac1-a1b7-f54b8586793c);
		
		IF
		EnteredTrigger(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93,S_GOB_VoloBallad_CageBox_d8f061e4-747e-48c9-a8e2-2b7521bda473)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)GOB_VoloBallad_State_GuardPresent_f84e156b-5de5-4ac1-a1b7-f54b8586793c);
		
		//END_REGION Guard forbids speaking to Volo
		
		
		//REGION Volo AD in cage
		
		IF
		Unlocked(S_GOB_VoloBallad_CageDoor_e370ae71-e10a-4a6c-9635-94783ae772cd,_,_)
		THEN
		Open(S_GOB_VoloBallad_CageDoor_e370ae71-e10a-4a6c-9635-94783ae772cd);
		PROC_TriggerUnregisterForPlayers(S_GOB_VoloBallad_PleaInCage_ADtrigger_701d181d-cba2-4e97-a2c9-46dd5e486a20);
		
		IF
		DB_InRegion(_Player,S_GOB_VoloBallad_PleaInCage_ADtrigger_701d181d-cba2-4e97-a2c9-46dd5e486a20)
		AND
		NOT DB_InRegion(S_GOB_VoloGuard_000_c25f0e79-b9f7-453c-8138-964bca267d93,S_GOB_VoloBallad_CageBox_d8f061e4-747e-48c9-a8e2-2b7521bda473)
		AND
		DB_InRegion(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,S_GOB_VoloBallad_InCage_17b0e3c4-d1b1-4080-b64f-a0ca67f07b2c)
		AND
		NOT DB_CantTalk(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa)
		AND
		IsLocked(S_GOB_VoloBallad_CageDoor_e370ae71-e10a-4a6c-9635-94783ae772cd, 1)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)GOB_VoloBallad_PleaInCage_fa541323-f4c6-9f40-b16e-4495e94a112b,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		
		PROC
		PROC_StateSet_Defeated(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93)
		AND
		IsInTrigger(S_GOB_VoloGuard_000_c25f0e79-b9f7-453c-8138-964bca267d93,S_GOB_VoloBallad_CageBox_d8f061e4-747e-48c9-a8e2-2b7521bda473,1)
		AND
		DB_InRegion(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,S_GOB_VoloBallad_InCage_17b0e3c4-d1b1-4080-b64f-a0ca67f07b2c)
		AND
		QRY_OnlyOnce("GOB_CagedVoloCommentedOnGuardDefeated_OnlyOnce")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)GOB_VoloBallad_AD_AtCage_GuardsDeath_4286ea4e-51c1-e5c4-bac7-5217b4d7c07f,(CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		
		//END_REGION
		
		
		//REGION Volo Invisibility
		// If Volo leaves cage without being given to players, goblins turn hostile to it
		IF
		LeftTrigger(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,S_GOB_VoloBallad_InCage_17b0e3c4-d1b1-4080-b64f-a0ca67f07b2c)
		AND
		NOT DB_GOB_VoloBallad_EscortInProcess(1)
		AND
		NOT DB_GlobalFlag((FLAG)GOB_VoloBallad_State_GuardGaveVoloToPlayers_e1041faa-5c24-bb66-92e9-4826f46d7e90)
		THEN
		PROC_GOB_GoblinsTurnHostileToVolo();
		
		// Only goblins who care about Volo turn hostile
		PROC
		PROC_GOB_GoblinsTurnHostileToVolo()
		THEN
		PROC_SetRelationMutual((FACTION)ACT1_GOB_VoloGuard_5e50ffef-d250-4a18-a3d4-b3fe4f574a4b,(FACTION)GLO_Volo_6c49b752-0dc2-4f85-86cf-0c2bd418305c,0);
		PROC_SetRelationMutual((FACTION)ACT1_GOB_GoblinWily_e7a1f0f7-5f59-438f-91c8-96d6b620495c,(FACTION)GLO_Volo_6c49b752-0dc2-4f85-86cf-0c2bd418305c,0);
		PROC_SetRelationToPlayers((FACTION)GLO_Volo_6c49b752-0dc2-4f85-86cf-0c2bd418305c,100);
		
		// Volo may get such status either by drinking the invis potion in his pocket or through systemics with players help
		IF
		StatusApplied(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,_Status,_,_)
		AND
		DB_GlobalFlag(GLO_Volo_State_AtGoblinCamp_fc815506-028d-582d-a953-4182d682aa07)
		AND
		NOT DB_Dialogs(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,GOB_VoloBallad_Volo_Massacre_828e7fea-2790-c7dc-0d2a-307387abe9c3)
		AND
		IsStatusFromGroup(_Status,"SG_Invisible",1)
		AND
		QRY_GOB_VoloInDialogOrCanMove()
		AND
		NOT QRY_GOB_VoloIsCaged()
		THEN
		PROC_ForceStopDialog(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		PROC_DisappearOutOfSight(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "Run", 0, "GOB_VoloBallad_VoloFled");
		
		IF
		StatusApplied(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,_Status,_PartyMember,_)
		AND
		DB_PartyMembers((CHARACTER)_PartyMember)
		AND
		IsStatusFromGroup(_Status,"SG_Invisible",1)
		AND
		DB_Sees(S_GOB_VoloGuard_000_c25f0e79-b9f7-453c-8138-964bca267d93,_PartyMember)
		AND
		NOT DB_GOB_VoloGuardSawPlayersApplyingInvisToPlayers(1)
		THEN
		DB_GOB_VoloGuardSawPlayersApplyingInvisToPlayers(1);
		PROC_SetRelationToPlayers((FACTION)ACT1_GOB_VoloGuard_5e50ffef-d250-4a18-a3d4-b3fe4f574a4b,0);
		
		// Edge case if Volo can't run away on becoming invisible: goblins turns hostile to it + he will try to escape if survives
		IF
		StatusApplied(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,_Status,_,_)
		AND
		IsStatusFromGroup(_Status,"SG_Invisible",1)
		AND
		NOT QRY_GOB_VoloInDialogOrCanMove()
		AND
		NOT QRY_GOB_VoloIsCaged()
		THEN
		PROC_GOB_GoblinsTurnHostileToVolo();
		PROC_GOB_VoloBallad_Escape();
		
		QRY
		QRY_GOB_VoloInDialogOrCanMove()
		AND
		DB_DialogNPCs(_,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,_)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_GOB_VoloInDialogOrCanMove()
		AND
		NOT DB_CantMove(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_GOB_VoloIsCaged()
		AND
		DB_InRegion((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,(TRIGGER)S_GOB_VoloBallad_InCage_17b0e3c4-d1b1-4080-b64f-a0ca67f07b2c)
		AND
		IsLocked((ITEM)S_GOB_VoloBallad_CageDoor_e370ae71-e10a-4a6c-9635-94783ae772cd,1)
		THEN
		DB_NOOP(1);
		
		IF
		RelationChanged((FACTION)ACT1_GOB_VoloGuard_5e50ffef-d250-4a18-a3d4-b3fe4f574a4b,(FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360,0,1)
		THEN
		PROC_ForceStopDialog(S_GOB_VoloGuard_000_c25f0e79-b9f7-453c-8138-964bca267d93);
		//END_REGION
		
		
		//REGION Escape
		IF
		Unlocked(S_GOB_VoloBallad_CageDoor_e370ae71-e10a-4a6c-9635-94783ae772cd,_Player,_)
		THEN
		PROC_GOB_VoloBallad_CageUnlocked(_Player);
		
		PROC
		PROC_GOB_VoloBallad_CageUnlocked((CHARACTER)_Player)
		AND
		NOT DB_GlobalFlag((FLAG)GOB_VoloBallad_State_GuardGaveVoloToPlayers_e1041faa-5c24-bb66-92e9-4826f46d7e90)
		THEN
		PROC_CharacterRegisterCrime(_Player,"GOB_VoloBallad_UnlockedCage",S_GOB_VoloBallad_CageDoor_e370ae71-e10a-4a6c-9635-94783ae772cd,NULL_00000000-0000-0000-0000-000000000000,0);
		DB_GOB_VoloBallad_VoloLibirator(_Player);
		
		PROC
		PROC_GOB_VoloBallad_MoveVoloToCamp(_)
		AND
		DB_GOB_VoloBallad_VoloLibirator(_Player)
		THEN
		CharacterStopCrime(_Player,"GOB_VoloBallad_UnlockedCage",S_GOB_VoloBallad_CageDoor_e370ae71-e10a-4a6c-9635-94783ae772cd);
		NOT DB_GOB_VoloBallad_VoloLibirator(_Player);
		
		PROC
		PROC_GOB_VoloBallad_CageUnlocked((CHARACTER)_Player)
		AND
		DB_InRegion((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,(TRIGGER)S_GOB_VoloBallad_CageBox_d8f061e4-747e-48c9-a8e2-2b7521bda473)
		THEN
		SetFlag((FLAG)GOB_VoloBallad_State_VoloPrepsEscape_fef2b414-aa62-1b1d-4279-ae2a8ea4a2de);
		DB_DropMutingStatussesDialog(GOB_VoloBallad_Volo_InCage_95702065-64ac-65ea-27fd-69a5a003db91);
		
		IF
		FlagSet((FLAG)GOB_VoloBallad_State_VoloPrepsEscape_fef2b414-aa62-1b1d-4279-ae2a8ea4a2de,_,_)
		THEN
		PROC_CharacterEnableAllCrimes((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		
		PROC
		PROC_GOB_VoloBallad_CageUnlocked((CHARACTER)_Player)
		AND
		DB_Players(_Player)
		AND
		QRY_SpeakerIsInDialogRange(_Player, S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa)
		AND
		DB_InRegion((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,(TRIGGER)S_GOB_VoloBallad_CageBox_d8f061e4-747e-48c9-a8e2-2b7521bda473)
		AND
		NOT QRY_StartDialog(GOB_VoloBallad_Volo_InCage_95702065-64ac-65ea-27fd-69a5a003db91, S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, _Player)
		THEN
		NOT DB_DropMutingStatussesDialog(GOB_VoloBallad_Volo_InCage_95702065-64ac-65ea-27fd-69a5a003db91);
		PROC_GOB_VoloBallad_Escape();
		
		IF
		DialogEnded(GOB_VoloBallad_Volo_InCage_95702065-64ac-65ea-27fd-69a5a003db91, _)
		AND
		IsLocked(S_GOB_VoloBallad_CageDoor_e370ae71-e10a-4a6c-9635-94783ae772cd,0)
		THEN
		PROC_GOB_TalkedWithUncagedVolo();
		PROC_GOB_VoloBallad_Escape();
		
		PROC
		PROC_GOB_TalkedWithUncagedVolo()
		AND
		NOT QRY_QuestUpdateIsUnlockedForAny("DEN_VoloAdventure","VoloFree")
		THEN
		QuestUpdate("DEN_VoloAdventure","VoloEscaped");
		
		PROC
		PROC_GOB_VoloBallad_Escape()
		AND
		NOT DB_Dialogs(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,GOB_VoloBallad_Volo_Massacre_828e7fea-2790-c7dc-0d2a-307387abe9c3)
		AND
		NOT DB_GOB_VoloBallad_VoloIsFleeing(1)
		AND
		QRY_OnlyOnce("GOB_VoloBallad_Escape_OnlyOnce")
		THEN
		PROC_GOB_VoloBallad_Escape_Internal();
		
		PROC
		PROC_GOB_VoloBallad_Escape_Internal()
		AND
		NOT QRY_QuestUpdateIsUnlockedForAny("DEN_VoloAdventure", "VoloFree")
		THEN
		QuestUpdate("DEN_VoloAdventure", "VoloEscaped");
		
		PROC
		PROC_GOB_VoloBallad_Escape_Internal()
		AND
		GetItemByTemplateInInventory((ITEMROOT)CONS_Potion_Invisible_A_809d5026-4896-4b3a-986e-95da58da77e2,(CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,_InvisPotion)
		THEN
		Use(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,_InvisPotion,"GOB_VoloBallad_VoloUsedInvisPotion");
		
		PROC
		PROC_GOB_VoloBallad_Escape_Internal()
		THEN
		PROC_SceneOver("GOB_VoloScene");
		DB_GOB_VoloBallad_VoloEscape(1);
		
		// Removing cached Volo escape in case disappear out of sight is called on him, ensures code for these separate flows not interfering with each other
		PROC
		PROC_DisappearOutOfSight(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, _, _, "GOB_VoloBallad_VoloFled")
		AND
		DB_GOB_VoloBallad_VoloEscape(1)
		THEN
		NOT DB_GOB_VoloBallad_VoloEscape(1);
		
		PROC
		PROC_DisappearOutOfSight(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, _, _, "GOB_VoloBallad_VoloFled")
		THEN
		DB_GOB_VoloBallad_VoloIsFleeing(1);
		
		IF
		LeftTrigger(_Player,S_GOB_ThroneRoom_SUB_bb81678b-641c-43fc-bd41-53295d59be03)
		AND
		DB_Players(_Player)
		AND
		NOT QRY_CheckOtherPlayersInTrigger(_Player,S_GOB_ThroneRoom_SUB_bb81678b-641c-43fc-bd41-53295d59be03)
		AND
		DB_GOB_VoloBallad_VoloEscape(_)
		THEN
		NOT DB_GOB_VoloBallad_VoloEscape(1);
		PROC_GOB_VoloBallad_MoveVoloToCamp(CAMP_VoloOperation_ba7c506d-c743-5dc9-7d98-eeea7b4ef2a2);
		
		IF
		FlagSet((FLAG)GOB_BattleStations_Event_ToStation_03a8bd66-c23f-4989-9a7b-775cf475104b,NULL_00000000-0000-0000-0000-000000000000,_)
		AND
		DB_GOB_VoloBallad_VoloEscape(_)
		AND
		IsInCombat(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,0)
		THEN
		NOT DB_GOB_VoloBallad_VoloEscape(1);
		PROC_DisappearOutOfSight(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, "Run", 0, "GOB_VoloBallad_VoloFled");
		
		PROC
		PROC_LongRest()
		AND
		DB_GOB_VoloBallad_VoloEscape(_)
		THEN
		NOT DB_GOB_VoloBallad_VoloEscape(1);
		PROC_GOB_VoloBallad_MoveVoloToCamp(CAMP_VoloOperation_ba7c506d-c743-5dc9-7d98-eeea7b4ef2a2);
		
		PROC
		PROC_GOB_VoloBallad_MoveVoloToCamp(_)
		AND
		HasActiveStatusWithGroup(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"SG_Invisible",1)
		THEN
		RemoveStatusesWithGroup(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"SG_Invisible");
		
		PROC
		PROC_GOB_VoloBallad_MoveVoloToCamp(_)
		THEN
		SetFlag((FLAG)GOB_VoloBallad_State_VoloEscaped_13ae819f-b0b7-434d-9ebb-cee412b1a407);
		SetRelation(ACT1_GOB_VoloGuard_5e50ffef-d250-4a18-a3d4-b3fe4f574a4b,GLO_Volo_6c49b752-0dc2-4f85-86cf-0c2bd418305c,50);
		PROC_CRIME_MusicalPerformance_EnableAllReactions((CHARACTER)S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		PROC_RemoveAllDialogEntriesForSpeaker(S_GOB_VoloGuard_000_c25f0e79-b9f7-453c-8138-964bca267d93);
		DB_Dialogs(S_GOB_VoloGuard_000_c25f0e79-b9f7-453c-8138-964bca267d93,(DIALOGRESOURCE)GOB_VoloBallad_Guard_17bcffb4-b779-f7ff-547c-dbd4f989f99d);
		NOT DB_GOB_VoloBallad_VoloIsFleeing(1);
		NOT DB_GOB_VoloBallad_VoloEscape(1);
		GoalCompleted;
		
		//END_REGION Escape
		
		IF
		DB_PermaDefeated(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa)
		THEN
		GoalCompleted;
		
		IF
		FlagSet(LOW_VoloFate_State_VoloArrivedInBG_5faacb8c-836d-4626-bb7d-418c643e494d,_,_)
		THEN
		GoalCompleted;
		
		IF
		FlagSet((FLAG)GOB_VoloBallad_HasMet_4629b154-d149-b0d3-d56b-7831f49088d2,_,_)
		THEN
		SetFlag((FLAG)GOB_VoloBallad_State_PlayersMetVolo_0c341094-ae74-4a72-b2b6-3cd98a43ae11);
		
		//REGION Misc
		PROC
		PROC_GOB_GoblinHuntAftermath_Pacified()
		THEN
		PROC_TriggerUnregisterForPlayers(TRIGGERGUID_S_GOB_VoloBallad_SceneBox_9237b20a-8227-41fb-9de7-dc26729d77cf);
		PROC_TriggerUnregisterForPlayers(TRIGGERGUID_S_GOB_VoloBallad_FirstHeardArea_7d714a14-2d80-44d4-ba90-479e8510c024);
		//END_REGION Misc
	}
	EXIT
	{
		PROC_TriggerUnregisterForPlayers(TRIGGERGUID_S_GOB_VoloBallad_SceneBox_9237b20a-8227-41fb-9de7-dc26729d77cf);
		PROC_TriggerUnregisterForPlayers(TRIGGERGUID_S_GOB_VoloBallad_FirstHeardArea_7d714a14-2d80-44d4-ba90-479e8510c024);
		TriggerUnregisterForCharacter(S_GOB_VoloBallad_CageBox_d8f061e4-747e-48c9-a8e2-2b7521bda473,S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93);
		TriggerUnregisterForCharacter(S_GOB_VoloBallad_CageBox_d8f061e4-747e-48c9-a8e2-2b7521bda473,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		TriggerUnregisterForCharacter(S_GOB_VoloBallad_InCage_17b0e3c4-d1b1-4080-b64f-a0ca67f07b2c,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		ClearFlag(GOB_VoloBallad_State_OnStage_0bc1d7d7-9129-4c6e-188d-054640cea3b9);
		SetForceUpdate(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa, 0);
		SetForceUpdate(S_GOB_VoloGuard_c25f0e79-b9f7-453c-8138-964bca267d93, 0);
	}
}
Goal(194).Title("Act1_GOB_WarlockProposal");
Goal(194)
{
	INIT
	{
		PROC_TriggerRegisterForPlayers(S_GOB_WarlockProposal_ChainRoom_2224bd82-041a-4332-8fc3-b09473feeafa);
		
		DB_DropMutingStatussesDialog((DIALOGRESOURCE)GOB_WarlockProposal_Warlock_0fdb76e3-2737-2ba3-4971-681bda07a9a0);
	}
	KB
	{
		 //REGION Warlock
		IF
		NestedDialogPlayed((DIALOGRESOURCE)GOB_GoblinPriest_Chains_fbe594c5-21e7-c9b1-3350-dd7f8242aea3, _)
		AND
		DB_Players(_Player)
		AND
		GetFlag((FLAG)GOB_WarlockProposal_State_CheckParty_380e9846-34a3-4c2b-bd8c-378dc14aaac7, _Player, 1)
		THEN
		DB_GOB_WarlockProposal_WarlockEvent(1);
		
		IF
		DB_GOB_WarlockProposal_WarlockEvent(_)
		AND
		DB_GOB_GoblinPriest_Chains_ChainedCharacter((CHARACTER)_Player)
		THEN
		PROC_ForceStopDialog(_Player);
		PROC_SpotPlayers_StopSpotting((CHARACTER)S_GOB_GoblinPriest_b983c336-9a14-4e9b-adb9-4689e7e0afa9,"GOB_GoblinPriest_SpotPlayerInDungeon");
		NOT DB_SpotPlayers(S_GOB_GoblinPriest_b983c336-9a14-4e9b-adb9-4689e7e0afa9,"GOB_GoblinPriest_SpotPlayerInDungeon",NULL_00000000-0000-0000-0000-000000000000,NULL_00000000-0000-0000-0000-000000000000);
		ScreenFadeTo(_Player, 2.0, 0, "GOB_WarlockProposal_ChainSleep");
		
		IF
		ScreenFadeDone(_, "GOB_WarlockProposal_ChainSleep")
		THEN
		Open((ITEM)S_GOB_GoblinPriestess_PrisonDoor_01_21ce3387-11dd-44f9-92c2-1949228ed813);
		TeleportTo(S_GOB_GoblinPriest_b983c336-9a14-4e9b-adb9-4689e7e0afa9, S_GOB_PriestReturnPoint_5d2ca547-4bf6-41a5-a6b2-0ab5fdf8d40b, "GOB_WarlockProposal_PriestTeleported", 0, 0, 0);
		
		IF
		EntityEvent(S_GOB_GoblinPriest_b983c336-9a14-4e9b-adb9-4689e7e0afa9, "GOB_WarlockProposal_PriestTeleported")
		AND
		DB_GOB_GoblinPriest_Chains_ChainedCharacter((CHARACTER)_Player)
		THEN
		ClearScreenFade(_Player, 2.0, "GOB_WarlockProposal_ChainSleep");
		
		IF
		EntityEvent(S_GOB_GoblinPriest_b983c336-9a14-4e9b-adb9-4689e7e0afa9, "GOB_WarlockProposal_PriestTeleported")
		THEN
		DB_AddCharactersInTriggerToDialog((DIALOGRESOURCE)GOB_WarlockProposal_Warlock_0fdb76e3-2737-2ba3-4971-681bda07a9a0, S_GOB_WarlockProposal_ChainRoom_2224bd82-041a-4332-8fc3-b09473feeafa, 0, 0);
		
		IF
		EntityEvent(S_GOB_GoblinPriest_b983c336-9a14-4e9b-adb9-4689e7e0afa9, "GOB_WarlockProposal_PriestTeleported")
		THEN
		PROC_CharacterMoveTo(S_GOB_GoblinPriest_b983c336-9a14-4e9b-adb9-4689e7e0afa9, S_GOB_GoblinPriest_ChainRoom_Point_71c4764c-fed3-467f-87d0-9493a07847fc, "Walk", "GOB_WarlockProposal_PriestReturned");
		
		IF
		EntityEvent(S_GOB_GoblinPriest_b983c336-9a14-4e9b-adb9-4689e7e0afa9, "GOB_WarlockProposal_PriestReturned")
		THEN
		PROC_State_Progress(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297,"GLO_Warlock", "GLO_Warlock_Proposal");
		SetVisible(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, 0);
		SetOnStage(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, 1);
		PROC_GLO_Warlock_ApplyAllStatuses();
		
		IF
		WentOnStage(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, 1)
		AND
		DB_GOB_GoblinPriest_Chains_ChainedCharacter((CHARACTER)_Player)
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)GOB_WarlockProposal_Warlock_0fdb76e3-2737-2ba3-4971-681bda07a9a0, S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, S_GOB_GoblinPriest_b983c336-9a14-4e9b-adb9-4689e7e0afa9, _Player)
		THEN
		DB_NOOP(1);
		
		IF
		DialogRequestFailed(GOB_WarlockProposal_Warlock_0fdb76e3-2737-2ba3-4971-681bda07a9a0,_DialogID)
		AND
		DB_GOB_GoblinPriest_Chains_ChainedCharacter((CHARACTER)_Player)
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)GOB_WarlockProposal_Warlock_0fdb76e3-2737-2ba3-4971-681bda07a9a0, S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, S_GOB_GoblinPriest_b983c336-9a14-4e9b-adb9-4689e7e0afa9, _Player)
		THEN
		DB_NOOP(1);
		
		IF
		DialogStarted(GOB_WarlockProposal_Warlock_0fdb76e3-2737-2ba3-4971-681bda07a9a0, _ID)
		THEN
		SetVisible(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, 1);
		
		IF
		DB_Sees(_Player, S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297)
		AND
		DB_Players(_Player)
		AND
		DB_DialogNPCs(_, S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, _)
		THEN
		SetFlag((FLAG)GOB_WarlockProposal_State_SeenWarlockPrisonBreak_75994703-663e-4f1b-b8e1-e77c467d4be1, _Player);
		
		IF
		FlagSet((FLAG)GOB_WarlockProposal_Event_PriestDeath_b9e8c596-55dc-4edc-8fbd-e52d601839d2, _, _ID) 
		AND
		DialogRemoveActorFromDialog(_ID, S_GOB_GoblinPriest_b983c336-9a14-4e9b-adb9-4689e7e0afa9, _)
		THEN
		Die(S_GOB_GoblinPriest_b983c336-9a14-4e9b-adb9-4689e7e0afa9, DEATHTYPE.Physical, S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, 0, 0);
		TeleportTo(S_GOB_GoblinPriest_b983c336-9a14-4e9b-adb9-4689e7e0afa9, S_GOB_GoblinPriest_ChainRoom_Point_71c4764c-fed3-467f-87d0-9493a07847fc, "", 0, 0, 0, 0, 1);
		
		IF
		FlagSet(GLO_WarlockProposal_ReleasePlayer_987d0493-1427-8677-ffcb-b181ce9c4274, _, _) 
		AND
		DB_GOB_GoblinPriest_Chains_ChainedCharacter((CHARACTER)_Player)
		THEN
		PROC_GOB_GoblinPriest_FreeCharacter((CHARACTER)_Player);
		SetFlag(GOB_GoblinPriest_Event_FreedFromChains_38ee56fc-1ee7-7ce7-a247-39913c3335ed,_Player,0);
		
		IF
		DialogEnded((DIALOGRESOURCE)GOB_WarlockProposal_Warlock_0fdb76e3-2737-2ba3-4971-681bda07a9a0, _)
		THEN
		PROC_GLO_Warlock_TeleportOut();
		
		// Edge case handling for interrupting the dialog before the priestess is dead
		IF
		DialogEnded((DIALOGRESOURCE)GOB_WarlockProposal_Warlock_0fdb76e3-2737-2ba3-4971-681bda07a9a0, _)
		AND
		NOT DB_PermaDefeated(S_GOB_GoblinPriest_b983c336-9a14-4e9b-adb9-4689e7e0afa9)
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT1_GOB_GoblinPriest_2d0b3c0e-279c-29c5-5e14-57de02a5dce9,0);
		GoalCompleted;
		
		//END_REGION
	}
	EXIT
	{
		PROC_AddCharactersInTriggerToDialog_Clear((DIALOGRESOURCE)GOB_WarlockProposal_Warlock_0fdb76e3-2737-2ba3-4971-681bda07a9a0, S_GOB_WarlockProposal_ChainRoom_2224bd82-041a-4332-8fc3-b09473feeafa);
		
		PROC_TriggerUnregisterForPlayers(S_GOB_WarlockProposal_ChainRoom_2224bd82-041a-4332-8fc3-b09473feeafa);
	}
}
Goal(195).Title("Act1_GOB_WarMap");
Goal(195)
{
	INIT
	{
		DB_ItemOwnerShipTriggers("WLD_Main_A",S_GOB_WarMap_OwnershipTrigger_d14b0e1e-6a75-4cc1-ae68-ff348438f852,S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b);
		
		DB_ShovelArea(S_FOR_WarMap_StashMound_9fbb4960-8530-4600-89a9-dbcf4e812034,S_FOR_WarMap_Stash_876e5a0b-80ed-4f29-a177-e60dbb54e3c5);
		
	}
	KB
	{
		IF
		UseStarted(_Player,S_GOB_WarMap_78c48e45-30f6-47ea-8a53-a3dd960521ac)
		AND
		DB_Players(_Player)
		AND
		DB_ShovelArea(S_FOR_WarMap_StashMound_9fbb4960-8530-4600-89a9-dbcf4e812034,_)
		THEN
		PROC_ShowMarker(_Player,"FOR_WarMap_StashMarker");
		DB_GOB_WarMap_RevealMound(1);
		
		IF
		DB_GOB_WarMap_RevealMound(1)
		AND
		DB_ActiveLevel("WLD_Main_A")
		THEN
		NOT DB_GOB_WarMap_RevealMound(1);
		SetEntityEvent(S_FOR_WarMap_Helper_EntityEventIn_726fb49c-037d-4db7-90cb-4de7f75d7ec5,"FOR_WarMap_RevealFromStory",1);
		
		IF
		DB_ActivePlayerMarker(_Player,"FOR_WarMap_StashMarker")
		AND
		NOT DB_ShovelArea(S_FOR_WarMap_StashMound_9fbb4960-8530-4600-89a9-dbcf4e812034,_)
		THEN
		PROC_HideMarker((CHARACTER)_Player,"FOR_WarMap_StashMarker");
	}
	EXIT
	{
	}
}
