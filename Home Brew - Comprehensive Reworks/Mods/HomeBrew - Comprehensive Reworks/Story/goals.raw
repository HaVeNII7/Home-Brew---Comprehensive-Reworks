}
Goal(307).Title("Act1b_CRE_StatuePuzzle");
Goal(307)
{
	INIT
	{
		//Plaques
		DB_ItemDialog_NarratorAD((ITEM)S_CRE_LathanderStatue_Plaque_East_cda583e5-0e23-4020-bae1-f968538123bf, (DIALOGRESOURCE)CRE_StatuePuzzle_AD_East_a12a92ad-36be-e66e-8606-138fee2c65a7);
		DB_ItemDialog_NarratorAD((ITEM)S_CRE_LathanderStatue_Plaque_West_adb6746f-4bbd-407a-8cfa-f4ce3f098488, (DIALOGRESOURCE)CRE_StatuePuzzle_AD_West_6a87587e-dc0e-3048-2a80-ebf77fdf4699);
		
		//Storing the correct rotations for the statues to solve the puzzle
		DB_CRE_LathanderStatues(S_CRE_LathanderStatue_Sunrise_9bd2faa5-426c-4250-8f8f-3e60618fe2d5, -95.0 ,-85.0);
		DB_CRE_LathanderStatues(S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba, 85.0, 95.0);
		
		DB_CRE_LathanderStatueBases((ITEM)S_CRE_LathanderStatue_Sunrise_9bd2faa5-426c-4250-8f8f-3e60618fe2d5,(ITEM)S_CRE_LathanderStatue_Base_Sunrise_88c358f8-1a74-40ed-b050-bfd6b13fa9b6);
		DB_CRE_LathanderStatueBases((ITEM)S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba,(ITEM)S_CRE_LathanderStatue_Base_Sunset_aaa3809c-fdb2-4cc3-af99-89488ae544e7);
		
		//The sunrise statue is rotatable
		DB_CRE_StatuePuzzle_Rotatable(S_CRE_LathanderStatue_Sunrise_9bd2faa5-426c-4250-8f8f-3e60618fe2d5);
		
		//The Statues aren't interactable until Spotted
		SetCanInteract(S_CRE_LathanderStatue_Sunrise_9bd2faa5-426c-4250-8f8f-3e60618fe2d5, 0);
		SetCanInteract(S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba, 0);
		SetCanInteract(S_CRE_LathanderStatue_Base_Sunset_aaa3809c-fdb2-4cc3-af99-89488ae544e7, 0);
		SetCanInteract(S_CRE_LathanderStatue_Base_Sunrise_88c358f8-1a74-40ed-b050-bfd6b13fa9b6, 0);
		
		DB_CRE_SurfacesThatEndRust("SurfaceGrease");
		DB_CRE_SurfacesThatEndRust("SurfaceAlienOil");
		DB_CRE_SurfacesThatEndRust("SurfaceOil");
		
		PROC_TriggerRegisterForPlayers((TRIGGER)S_CRE_StatuePuzzle_RevealTrigger_4b6aa9aa-e1d1-45a8-a3a1-99bd2cee908d);
		
		Transform(S_CRE_LathanderStatue_Base_Sunrise_88c358f8-1a74-40ed-b050-bfd6b13fa9b6, DEC_GEN_Statue_Base_Pedestal_D_Indicator_A_Interactable_9835d72c-c57b-4c1d-a713-c5ff250fc2fa, (SHAPESHIFTRULE)DisguiseKeepName_c7c3381e-b901-416e-a0c4-bc745e1ff54a);
		Transform(S_CRE_LathanderStatue_Base_Sunset_aaa3809c-fdb2-4cc3-af99-89488ae544e7, DEC_GEN_Statue_Base_Pedestal_D_Indicator_A_Interactable_9835d72c-c57b-4c1d-a713-c5ff250fc2fa, (SHAPESHIFTRULE)DisguiseKeepName_c7c3381e-b901-416e-a0c4-bc745e1ff54a);
	}
	KB
	{
		//REGION Spotting the Puzzle
		IF
		UseStarted(_Player, CRE_StatuePuzzle_Book_23112010-0a1c-4a54-93f7-a70c8f532cfb)
		AND
		DB_Players(_Player)
		THEN
		SetFlag(CRE_StatuePuzzle_ReadBook_d0206fe7-5163-4833-89df-9560cc3c3f83, _Player);
		
		//Setting the statues interactable when using the book.
		IF
		UseStarted(_Player, CRE_StatuePuzzle_Book_23112010-0a1c-4a54-93f7-a70c8f532cfb)
		AND
		DB_Players(_Player)
		THEN
		SetCanInteract(S_CRE_LathanderStatue_Sunrise_9bd2faa5-426c-4250-8f8f-3e60618fe2d5, 1);
		SetCanInteract(S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba, 1);
		
		//The perception effect will always play when the player is close
		IF
		DB_InRegion(_Player, S_CRE_StatuePuzzle_RevealTrigger_4b6aa9aa-e1d1-45a8-a3a1-99bd2cee908d)
		AND
		DB_Players(_Player)
		AND
		QRY_OnlyOnce("CRE_StatuePuzzle_Reveal")
		THEN
		PROC_PlayPerceptionRevealEffect(S_CRE_LathanderStatue_Sunrise_9bd2faa5-426c-4250-8f8f-3e60618fe2d5,"CRE_StatuePuzzleSpottinWStatue");
		PROC_PlayPerceptionRevealEffect(S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba,"CRE_StatuePuzzleSpottinEStatue");
		SetCanInteract(S_CRE_LathanderStatue_Sunrise_9bd2faa5-426c-4250-8f8f-3e60618fe2d5, 1);
		SetCanInteract(S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba, 1);
		SetCanInteract(S_CRE_LathanderStatue_Base_Sunrise_88c358f8-1a74-40ed-b050-bfd6b13fa9b6, 1);
		SetCanInteract(S_CRE_LathanderStatue_Base_Sunset_aaa3809c-fdb2-4cc3-af99-89488ae544e7, 1);
		ClearOwnership(S_CRE_LathanderStatue_Base_Sunrise_88c358f8-1a74-40ed-b050-bfd6b13fa9b6);
		ClearOwnership(S_CRE_LathanderStatue_Base_Sunset_aaa3809c-fdb2-4cc3-af99-89488ae544e7);
		//END_REGION
		
		//REGION Moving the rusted statue
		IF
		UseStarted(_Player ,S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba)
		THEN
		PROC_CRE_LathanderStatues_AttemptRotate(_Player, S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba);
		
		IF
		UseStarted(_Player,S_CRE_LathanderStatue_Base_Sunset_aaa3809c-fdb2-4cc3-af99-89488ae544e7)
		THEN
		PROC_CRE_LathanderStatues_AttemptRotate(_Player, S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba);
		
		//Using an appropriate surface to remove the rust
		
		
		PROC
		PROC_CRE_LathanderStatues_AttemptRotate(_, (ITEM)S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba)
		AND
		DB_CRE_LathanderStatues(S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba, _, _)
		AND
		NOT DB_CRE_StatuePuzzle_Rotatable(S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba)
		AND
		GetSurfaceGroundAt(S_CRE_LathanderStatue_Base_Sunset_aaa3809c-fdb2-4cc3-af99-89488ae544e7, _Surface) 
		AND
		DB_CRE_SurfacesThatEndRust(_Surface)
		THEN
		DB_CRE_StatuePuzzle_Rotatable(S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba);
		
		//TODO: implement the rotating bases when dynamic bases become available
		
		//Bashing it really hard
		IF
		AttackedBy(S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba, _,_Player,_,_DamageAmount, _,_)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		NOT DB_CRE_StatuePuzzle_Rotatable(S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba)
		AND
		_DamageAmount>=10
		THEN
		DB_CRE_StatuePuzzle_Rotatable(S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba);
		Use((CHARACTER)_Player, S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba, "");
		
		//Bashing it not hard enough
		IF
		AttackedBy(S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba, _,_Player,_,_DamageAmount, _,_)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		NOT DB_CRE_StatuePuzzle_Rotatable(S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba)
		AND
		_DamageAmount<10
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)CRE_StatuePuzzle_PAD_HitWeakly_bd3b6920-0e8c-227a-5538-fe6e58f796dd, _Player);
		
		//Athletics to force it
		PROC
		PROC_CRE_LathanderStatues_AttemptRotate((CHARACTER)_Player, (ITEM)S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba)
		AND
		DB_CRE_LathanderStatues(S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba, _, _)
		AND
		NOT DB_CRE_StatuePuzzle_Rotatable(S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba)
		THEN
		PROC_KnowledgeCheck(_Player, "CRE_StatuePuzzle_StuckStatue_AthleticsCheck", S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba, "Athletics", (DIFFICULTYCLASS)DC_Legacy_25_306ba0ce-1a69-4a46-9ca0-7d3e8f5be954);
		
		PROC
		PROC_GLO_KnowledgeCheckSuccess(_Player, "CRE_StatuePuzzle_StuckStatue_AthleticsCheck", S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba)
		THEN
		DB_CRE_StatuePuzzle_Rotatable(S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba);
		Use(_Player, S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba, "");
		
		PROC
		PROC_GLO_KnowledgeCheckFailure(_Player, "CRE_StatuePuzzle_StuckStatue_AthleticsCheck", S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)CRE_StatuePuzzle_AD_StuckStatue_18b02d30-5216-6136-39aa-7d5cf86478e1, S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba);
		PROC_TryStartAD((DIALOGRESOURCE)CRE_StatuePuzzle_PAD_AthleticsCheckFailed_9a5e9b4a-96cd-c930-acff-b3bed749d8b2, _Player);
		DB_CRE_StatuePuzzle_AtheticsCheckFailed(_Player);
		
		//Trying to turn it after failing the Athletics check
		PROC
		PROC_CRE_LathanderStatues_AttemptRotate((CHARACTER)_Player, (ITEM)S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba)
		AND
		DB_CRE_LathanderStatues(S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba, _, _)
		AND
		NOT DB_CRE_StatuePuzzle_Rotatable(S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba)
		AND
		DB_CRE_StatuePuzzle_AtheticsCheckFailed(_Player)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)CRE_StatuePuzzle_AD_StuckStatue_18b02d30-5216-6136-39aa-7d5cf86478e1, S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba);
		//END_REGION
		
		//REGION Rotating Statues
		IF
		UseStarted(_Player,_Statue)
		AND
		DB_CRE_LathanderStatues(_Statue, _, _)
		THEN
		PROC_CRE_RotateLathanderStatue(_Statue, _Player);
		
		IF
		UseStarted(_Player, _Base)
		AND
		DB_CRE_LathanderStatueBases(_Statue, _Base)
		THEN
		PROC_CRE_RotateLathanderStatue(_Statue, _Player);
		
		PROC
		PROC_CRE_RotateLathanderStatue((ITEM)_Statue, (GUIDSTRING)_Player)
		AND
		DB_CRE_LathanderStatues(_Statue, _, _)
		AND
		NOT DB_CRE_StatuePuzzle_StatueRotationInProgress(_Statue)
		AND
		DB_CRE_StatuePuzzle_Rotatable(_Statue)
		AND
		DB_CRE_LathanderStatueBases(_Statue, _Base)
		THEN
		ItemRotateY(_Statue, 90.0, 45.0);
		ItemRotateY(_Base, 90.0, 45.0);
		DB_CRE_StatuePuzzle_StatueRotationInProgress(_Statue);
		ObjectTimerLaunch(_Statue, "CRE_StatuePuzzle_RotationTimer", 2000);
		PlaySound(_Statue, "SE_CRE_PUZ_Statue_StartMoving");
		
		PROC
		PROC_CRE_RotateLathanderStatue((ITEM)_Statue, (GUIDSTRING)_NewPlayer)
		AND
		DB_CRE_LathanderStatues(_Statue, _, _)
		AND
		DB_CRE_StatuePuzzle_RecordLastPlayer(_OldPlayer)
		THEN
		NOT DB_CRE_StatuePuzzle_RecordLastPlayer(_OldPlayer);
		DB_CRE_StatuePuzzle_RecordLastPlayer(_NewPlayer);
		
		PROC
		PROC_CRE_RotateLathanderStatue((ITEM)_Statue, (GUIDSTRING)_NewPlayer)
		AND
		DB_CRE_LathanderStatues(_Statue, _, _)
		AND
		NOT DB_CRE_StatuePuzzle_RecordLastPlayer(_)
		THEN
		DB_CRE_StatuePuzzle_RecordLastPlayer(_NewPlayer);
		
		IF
		ObjectTimerFinished(_Statue, "CRE_StatuePuzzle_RotationTimer")
		AND
		DB_CRE_LathanderStatues(_Statue, _, _)
		THEN
		PROC_CRE_StatuePuzzle_EvaluateRotations();
		NOT DB_CRE_StatuePuzzle_StatueRotationInProgress((ITEM)_Statue);
		PlaySound(_Statue, "SE_CRE_PUZ_Statue_StopsMoving");
		//END_REGION
		
		//REGION Solving the Puzzle
		PROC
		PROC_CRE_StatuePuzzle_EvaluateRotations()
		AND
		GetRotation(S_CRE_LathanderStatue_Sunrise_9bd2faa5-426c-4250-8f8f-3e60618fe2d5, _, _SunriseY, _)
		AND
		GetRotation(S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba, _, _SunsetY, _)
		AND
		DB_CRE_LathanderStatues(S_CRE_LathanderStatue_Sunrise_9bd2faa5-426c-4250-8f8f-3e60618fe2d5, _SunriseMinY, _SunriseMaxY)
		AND
		DB_CRE_LathanderStatues(S_CRE_LathanderStatue_Sunset_4bb6dfc7-c5ad-474b-b4b6-a265d82c4cba, _SunsetMinY, _SunsetMaxY)
		AND
		_SunriseY>=_SunriseMinY
		AND
		_SunriseY<=_SunriseMaxY
		AND
		_SunsetY>=_SunsetMinY
		AND
		_SunsetY<=_SunsetMaxY
		THEN
		PROC_CRE_StatuePuzzle_OpenSecretDoor();
		
		PROC
		PROC_CRE_StatuePuzzle_OpenSecretDoor()
		THEN
		ItemMoveTo(S_CRE_StatuePuzzle_HiddenDoor_8c79df99-d883-4e16-b23b-e25342496562, S_CRE_StatuePuzzle_HiddenDoor_MoveToTrigger_079613bf-9d57-4caf-8fac-6a69dd1fa9ad, 0.5, 1.0, 0, "CRE_StatuePuzzle_SecretDoorOpened");
		SetPortalIsOpen(S_CRE_StatuePuzzle_HiddenDoor_8c79df99-d883-4e16-b23b-e25342496562, 1);
		
		PROC
		PROC_CRE_StatuePuzzle_OpenSecretDoor()
		AND
		DB_CRE_StatuePuzzle_RecordLastPlayer(_Player)
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)CRE_StatuePuzzle_DoorOpened_970a112f-0e2f-81cd-5020-0e8b8816abdd, (CHARACTER)_Player);
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(308).Title("Act1b_CRE_UpperGuards");
Goal(308)
{
	INIT
	{
		DB_CRE_UpperGuards_LockedDoors((ITEM)S_CRE_MainCheckPointRightDoor1_5a64e966-df7a-49cb-9afc-960ffd77fd19);
		DB_CRE_UpperGuards_LockedDoors(S_CRE_MainCheckPointRightDoor2_09c338db-2d30-4d8a-a924-61ec603d8c9a);
		DB_CRE_UpperGuards_LockedDoors(S_CRE_MainCheckPointLeftDoor1_37d19dac-98e8-41bc-a6f9-649d789bdab7);
		DB_CRE_UpperGuards_LockedDoors(S_CRE_MainCheckPointLeftDoor2_a8407f32-fc6d-4bfa-a093-4f4e951476bc);
		
		DB_CustomDialogRange((CHARACTER)S_CRE_MainCheckpointMainGuard_161701af-17b7-4def-b378-5f24e95d667f, 20);
		DB_CustomDialogRange((CHARACTER)S_CRE_HiddenCheckpointMainGuard_3bcbf8fb-5a90-4439-bd81-d9113d74f27e, 20);
		
		DB_Dialogs((CHARACTER)S_CRE_MainCheckpointMainGuard_161701af-17b7-4def-b378-5f24e95d667f, (DIALOGRESOURCE)CRE_UpperGuards_MainCheckpointTrespassing_11a44b75-14a3-cca7-5c4d-f3a11eb279c1);
		DB_Dialogs((CHARACTER)S_CRE_MainCheckpointWarningGuard_a6c0d21e-ce59-4dbb-9f64-1ec80b95c838, (DIALOGRESOURCE)CRE_UpperGuards_MainCheckpointWarning_33c13028-b3af-e22c-b30d-65fb0ad9059a);
		DB_Dialogs((CHARACTER)S_CRE_HiddenCheckpointMainGuard_3bcbf8fb-5a90-4439-bd81-d9113d74f27e, (DIALOGRESOURCE)CRE_UpperGuards_HiddenCheckpointTrespassing_85f9aee8-7002-4806-92da-65a90a36a303);
		DB_Dialogs((CHARACTER)S_CRE_HiddenCheckpointWarningGuard_970d10ed-8092-463b-8446-223fe4cf2d68, (DIALOGRESOURCE)CRE_UpperGuards_HiddenCheckpointWarning_6603da13-ea21-4491-b60a-0c0e5d68e215);
		
		DB_CustomDialogRange(S_CRE_MainCheckpointWarningGuard_a6c0d21e-ce59-4dbb-9f64-1ec80b95c838, 15);
		
		DB_GlobalFlagReactionAfterDialog((FLAG)CRE_UpperGuards_Event_MainCheckpointHostile_8d001430-ca7b-4f65-b44e-1fe8eabb27fa, (DIALOGRESOURCE)CRE_UpperGuards_MainCheckpointTrespassing_11a44b75-14a3-cca7-5c4d-f3a11eb279c1);
		DB_GlobalFlagReactionAfterDialog((FLAG)CRE_UpperGuards_Event_MainCheckpointHostile_8d001430-ca7b-4f65-b44e-1fe8eabb27fa, (DIALOGRESOURCE)CRE_UpperGuards_MainCheckpointWarning_33c13028-b3af-e22c-b30d-65fb0ad9059a);
		DB_GlobalFlagReactionAfterDialog((FLAG)CRE_UpperGuards_Event_HiddenCheckpointHostile_b3f528af-c1fc-4501-94f9-e3c0ce9246d9, (DIALOGRESOURCE)CRE_UpperGuards_HiddenCheckpointTrespassing_85f9aee8-7002-4806-92da-65a90a36a303);
		DB_GlobalFlagReactionAfterDialog((FLAG)CRE_UpperGuards_Event_HiddenCheckpointHostile_b3f528af-c1fc-4501-94f9-e3c0ce9246d9, (DIALOGRESOURCE)CRE_UpperGuards_HiddenCheckpointWarning_6603da13-ea21-4491-b60a-0c0e5d68e215);
		
		DB_CheckPoint((CHARACTER)S_CRE_MainCheckpointMainGuard_161701af-17b7-4def-b378-5f24e95d667f, (CHARACTER)S_CRE_MainCheckpointWarningGuard_a6c0d21e-ce59-4dbb-9f64-1ec80b95c838,
						(TRIGGER)S_CRE_MainCheckpointPrimaryArea_a2b8ea90-32d4-45a1-9685-814ee6a44792, (TRIGGER)S_CRE_MainCheckpointWarningArea_d302a664-8967-4a5e-a47e-13d7d0381f7b,
						(TRIGGER)S_CRE_MainCheckpointTrespassingArea_14c6bc39-9832-43fc-b29d-009e4c93a190,
						"CRE_UpperGuards_MainCheckpoint", (FLAG)CRE_UpperGuards_State_GainedAccess_764df691-d1f0-4bde-ba36-73c4abe6a4e7,
						"Trespassing", (TRIGGER)S_CRE_MainCheckpointTrespassingTeleport_9a06a7e6-c02f-4b75-9998-e01aa7b1c571);
		DB_CheckPointPassTrigger("CRE_UpperGuards_MainCheckpoint", "CRE_UpperGuards_PassTrigger", (TRIGGER)S_CRE_CheckpointsPassArea_559fdadd-15ef-4953-8adb-7fb5ffe72d42);
		DB_CheckPointPassTrigger("CRE_UpperGuards_MainCheckpoint", "CRE_UpperGuards_PassTrigger", (TRIGGER)S_CRE_MainDoorPassArea_9edb8b4e-4f2d-4255-b4a2-fb4fa3b609fd);
		
		DB_CheckPoint((CHARACTER)S_CRE_HiddenCheckpointMainGuard_3bcbf8fb-5a90-4439-bd81-d9113d74f27e, (CHARACTER)S_CRE_HiddenCheckpointWarningGuard_970d10ed-8092-463b-8446-223fe4cf2d68,
						(TRIGGER)S_CRE_HiddenCheckpointPrimaryArea_e1dc957b-13c0-4fd6-9ec4-cdf76951e11d, (TRIGGER)S_CRE_HiddenCheckpointWarningArea_6285c661-f4a3-474e-9c2f-fc34bff3a6a6,
						(TRIGGER)S_CRE_HiddenCheckpointTrespassingArea_28e68e21-784f-47b8-9e99-b698368a56c7,
						"CRE_UpperGuards_HiddenCheckpoint", (FLAG)CRE_UpperGuards_State_GainedAccess_764df691-d1f0-4bde-ba36-73c4abe6a4e7,
						"Trespassing", (TRIGGER)S_CRE_HiddenCheckpointTrespassingTeleport_a0a74141-9729-4cad-9c21-9d3a9f261aa9);
		DB_CheckPointPassTrigger("CRE_UpperGuards_HiddenCheckpoint", "CRE_UpperGuards_PassTrigger", (TRIGGER)S_CRE_CheckpointsPassArea_559fdadd-15ef-4953-8adb-7fb5ffe72d42);
		
		DB_DefeatedStateFlag((CHARACTER)S_CRE_MainCheckpointMainGuard_161701af-17b7-4def-b378-5f24e95d667f, (FLAG)CRE_UpperGuards_State_MainPrimaryGuardDefeated_82345f32-d1a3-4edb-b092-1e1c1fc7314f);
		DB_DefeatedStateFlag((CHARACTER)S_CRE_HiddenCheckpointMainGuard_3bcbf8fb-5a90-4439-bd81-d9113d74f27e, (FLAG)CRE_UpperGuards_State_HiddenPrimaryGuardDefeated_5a839660-5dc0-4002-93c1-c3a4b4c211b3);
		
		DB_CRE_UpperGuards_MainCheckpointGuards((CHARACTER)S_CRE_MainCheckpointMainGuard_161701af-17b7-4def-b378-5f24e95d667f);
		DB_CRE_UpperGuards_MainCheckpointGuards((CHARACTER)S_CRE_CrecheGuard01_5a5c5878-fd9f-41c0-9c8c-b74cea0e3fd9);
		DB_CRE_UpperGuards_MainCheckpointGuards((CHARACTER)S_CRE_CrecheGuard02_99439816-fcaa-4167-a20a-8f3dfff4e345);
		DB_CRE_UpperGuards_MainCheckpointGuards((CHARACTER)S_CRE_MainCheckpointWarningGuard_a6c0d21e-ce59-4dbb-9f64-1ec80b95c838);
		
		DB_CRE_UpperGuards_HiddenCheckpointGuards((CHARACTER)S_CRE_HiddenCheckpointWarningGuard_970d10ed-8092-463b-8446-223fe4cf2d68);
		DB_CRE_UpperGuards_HiddenCheckpointGuards((CHARACTER)S_CRE_HiddenCheckpointMainGuard_3bcbf8fb-5a90-4439-bd81-d9113d74f27e);
		
		DB_CRE_UpperGuards_CheckpointWarningDialogPairs("CRE_UpperGuards_MainCheckpoint", (CHARACTER)S_CRE_MainCheckpointMainGuard_161701af-17b7-4def-b378-5f24e95d667f, CRE_UpperGuards_MainCheckpointTrespassing_11a44b75-14a3-cca7-5c4d-f3a11eb279c1);
		DB_CRE_UpperGuards_CheckpointWarningDialogPairs("CRE_UpperGuards_MainCheckpoint", (CHARACTER)S_CRE_MainCheckpointWarningGuard_a6c0d21e-ce59-4dbb-9f64-1ec80b95c838, CRE_UpperGuards_MainCheckpointWarning_33c13028-b3af-e22c-b30d-65fb0ad9059a);
		DB_CRE_UpperGuards_CheckpointWarningDialogPairs("CRE_UpperGuards_HiddenCheckpoint", (CHARACTER)S_CRE_HiddenCheckpointMainGuard_3bcbf8fb-5a90-4439-bd81-d9113d74f27e, CRE_UpperGuards_HiddenCheckpointTrespassing_85f9aee8-7002-4806-92da-65a90a36a303);
		DB_CRE_UpperGuards_CheckpointWarningDialogPairs("CRE_UpperGuards_HiddenCheckpoint", (CHARACTER)S_CRE_HiddenCheckpointWarningGuard_970d10ed-8092-463b-8446-223fe4cf2d68, CRE_UpperGuards_HiddenCheckpointWarning_6603da13-ea21-4491-b60a-0c0e5d68e215);
	}
	KB
	{
		//REGION Main Checkpoint
		///////////////Checkpoint///////////////
		PROC
		PROC_CheckPointDialogue(_Player, (CHARACTER)_Guard)
		AND
		DB_CRE_UpperGuards_CheckpointWarningDialogPairs("CRE_UpperGuards_MainCheckpoint", _Guard, _)
		AND
		QRY_CRE_UpperGuards_SelectMostSuitablePlayer(_Player, _Guard)
		AND
		DB_QRYRTN_CRE_UpperGuards_SelectMostSuitablePlayer(_Guard, _MostSuitablePlayer)
		THEN
		TeleportTo(_Player, _Player, "", 0, 0, 0, 0, 1); //Used to stop queued movement to prevent the player from walking through as the dialog might start on a different character
		PROC_CRE_UpperGuards_StartCheckpointWarningDialog(_Guard, (CHARACTER)_MostSuitablePlayer);
		NOT DB_QRYRTN_CRE_UpperGuards_SelectMostSuitablePlayer(_Guard, _MostSuitablePlayer);
		
		//Companion Laezel and a suitable avatar are nearby and available
		QRY
		QRY_CRE_UpperGuards_SelectMostSuitablePlayer((CHARACTER)_,(CHARACTER)_Guard)
		AND
		DB_Players((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _Guard)
		AND
		QRY_GetBestAvatarForCompanion(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, 1, 1)
		AND
		DB_QRYRTN_GetBestAvatarForCompanion((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _BestAvatar)
		AND
		NOT DB_QRYRTN_CRE_UpperGuards_SelectMostSuitablePlayer(_Guard, _)
		THEN
		DB_QRYRTN_CRE_UpperGuards_SelectMostSuitablePlayer(_Guard, _BestAvatar);
		
		//Companion Laezel and another avatar are nearby and available
		QRY
		QRY_CRE_UpperGuards_SelectMostSuitablePlayer((CHARACTER)_,(CHARACTER)_Guard)
		AND
		DB_Players((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _Guard)
		AND
		DB_Avatars(_OtherAvatar)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(_OtherAvatar, _Guard)
		AND
		NOT DB_QRYRTN_CRE_UpperGuards_SelectMostSuitablePlayer(_Guard, _)
		THEN
		DB_QRYRTN_CRE_UpperGuards_SelectMostSuitablePlayer(_Guard, _OtherAvatar);
		
		//Companion Laezel is nearby and available without any avatars
		QRY
		QRY_CRE_UpperGuards_SelectMostSuitablePlayer((CHARACTER)_,(CHARACTER)_Guard)
		AND
		DB_Players((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		NOT DB_Avatars((CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _Guard)
		AND
		NOT DB_QRYRTN_CRE_UpperGuards_SelectMostSuitablePlayer(_Guard, _)
		THEN
		DB_QRYRTN_CRE_UpperGuards_SelectMostSuitablePlayer(_Guard, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		
		//Companion Laezel is not nearby or isn't available - play on whoever walked in (fallback)
		QRY
		QRY_CRE_UpperGuards_SelectMostSuitablePlayer((CHARACTER)_Player,(CHARACTER)_Guard)
		AND
		NOT DB_QRYRTN_CRE_UpperGuards_SelectMostSuitablePlayer(_Guard, _)
		THEN
		DB_QRYRTN_CRE_UpperGuards_SelectMostSuitablePlayer(_Guard, _Player);
		
		PROC
		PROC_CRE_UpperGuards_StartCheckpointWarningDialog((CHARACTER)_Guard, (CHARACTER)_MostSuitablePlayer)
		AND
		DB_CRE_UpperGuards_CheckpointWarningDialogPairs(_CheckpointId, _Guard, _WarningDialog)
		AND
		QRY_StartCheckpointWarningDialog(_CheckpointId, (DIALOGRESOURCE)_WarningDialog, (CHARACTER)_Guard, _MostSuitablePlayer)
		THEN
		DB_NOOP(1);
		
		//Try to add Laezel to all checkpoint dialogs
		PROC
		PROC_StartDialog_AddExtraSpeakers(_Dialog, _Id)
		AND
		DB_CRE_UpperGuards_CheckpointWarningDialogPairs(_, _Guard, _Dialog)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12, _Guard)
		THEN
		PROC_DialogAddSpeakingActor(_Id, S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		
		///////////////Guards turn hostile///////////////
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)CRE_UpperGuards_Event_MainCheckpointHostile_8d001430-ca7b-4f65-b44e-1fe8eabb27fa)
		THEN
		PROC_SetRelationToPlayers((FACTION)Act1B_CRE_Gith_MainCheckpoint_a51f68a3-e53a-4784-ba02-8d465b781646, 0);
		
		//Handling special greeting node for secondary guard referencing ongoing dialog with Primary guard
		IF
		DB_InteractiveDialogSpeaker(_ID, S_CRE_MainCheckpointMainGuard_161701af-17b7-4def-b378-5f24e95d667f)
		THEN
		SetFlag(CRE_UpperGuards_State_MainPrimaryGuardInDialog_c284610e-a4e7-4c60-b4f4-e195efee30dc);
		DB_CRE_UpperGuards_MainGuardOngoingDialog(_ID);
		
		IF
		DialogEnded(_, _ID)
		AND
		DB_CRE_UpperGuards_MainGuardOngoingDialog(_ID)
		THEN
		ClearFlag(CRE_UpperGuards_State_MainPrimaryGuardInDialog_c284610e-a4e7-4c60-b4f4-e195efee30dc);
		//END_REGION
		
		//REGION Hidden entrance Checkpoint
		///////////////Checkpoint///////////////
		PROC
		PROC_CheckPointDialogue(_Player, (CHARACTER)_Guard)
		AND
		DB_CRE_UpperGuards_CheckpointWarningDialogPairs("CRE_UpperGuards_HiddenCheckpoint", _Guard, _)
		THEN
		TeleportTo(_Player, _Player, "", 0, 0, 0, 0, 1); //Used to stop queued movement to prevent the player from walking through as the dialog might start on a different character
		PROC_CRE_UpperGuards_StartCheckpointWarningDialog(_Guard, (CHARACTER)_Player);
		NOT DB_QRYRTN_CRE_UpperGuards_SelectMostSuitablePlayer(_Guard, _Player);
		
		///////////////Guards turn hostile///////////////
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)CRE_UpperGuards_Event_HiddenCheckpointHostile_b3f528af-c1fc-4501-94f9-e3c0ce9246d9)
		THEN
		PROC_SetRelationToPlayers((FACTION)Act1B_CRE_Gith_HiddenCheckpoint_5a532d4a-4eb5-4969-8fc8-9c12bf956c06, 0);
		
		///////////////Back to patrolling///////////////
		
		//If the player leaves through the hidden door, the outside counterpart of the door should unlock
		IF
		UseStarted(_, DOOR_Double_Small_Dungeon_Abbey_A_Teleporter_000_b45b688b-c3d3-4620-a518-0396ea88f2be)
		AND
		IsLocked(DOOR_Single_Dungeon_Abbey_A_005_5ef5ae07-a39b-4d7f-b913-7c7d2df595cc, 1)
		THEN
		Unlock(DOOR_Single_Dungeon_Abbey_A_005_5ef5ae07-a39b-4d7f-b913-7c7d2df595cc);
		//END_REGION
		
		//REGION Misc
		///////////////Locked door ownership///////////////
		//Transfer door ownership if main guard is perma-defeated
		PROC
		PROC_StateSet_PermaDefeated((CHARACTER)S_CRE_MainCheckpointMainGuard_161701af-17b7-4def-b378-5f24e95d667f)
		AND
		NOT DB_PermaDefeated((CHARACTER)S_CRE_MainCheckpointWarningGuard_a6c0d21e-ce59-4dbb-9f64-1ec80b95c838)
		AND
		DB_CRE_UpperGuards_LockedDoors(_Door)
		THEN
		SetOwner(_Door, S_CRE_MainCheckpointWarningGuard_a6c0d21e-ce59-4dbb-9f64-1ec80b95c838);
		
		//END_REGION
		
		//REGION Peaceful Resolution
		//Main checkpoint peaceful resolution
		IF
		FlagSet((FLAG)CRE_UpperGuards_State_GainedAccess_764df691-d1f0-4bde-ba36-73c4abe6a4e7, _, _DialogID)
		AND
		DB_DialogName(CRE_UpperGuards_MainCheckpointTrespassing_11a44b75-14a3-cca7-5c4d-f3a11eb279c1, _DialogID)
		THEN
		PROC_CRE_UpperGuards_MainCheckpoint_PeacefulResolve();
		
		IF
		FlagSet((FLAG)CRE_UpperGuards_State_GainedAccess_764df691-d1f0-4bde-ba36-73c4abe6a4e7, _, _DialogID)
		AND
		DB_DialogName(CRE_UpperGuards_MainCheckpointWarning_33c13028-b3af-e22c-b30d-65fb0ad9059a, _DialogID)
		THEN
		PROC_CRE_UpperGuards_MainCheckpoint_PeacefulResolve();
		
		//Hidden checkpoint peaceful resolution
		IF
		FlagSet((FLAG)CRE_UpperGuards_State_GainedAccess_764df691-d1f0-4bde-ba36-73c4abe6a4e7, _, _DialogID)
		AND
		DB_DialogName(CRE_UpperGuards_HiddenCheckpointTrespassing_85f9aee8-7002-4806-92da-65a90a36a303, _DialogID)
		THEN
		PROC_CRE_UpperGuards_HiddenCheckpoint_PeacefulResolve();
		
		IF
		FlagSet((FLAG)CRE_UpperGuards_State_GainedAccess_764df691-d1f0-4bde-ba36-73c4abe6a4e7, _, _DialogID)
		AND
		DB_DialogName(CRE_UpperGuards_HiddenCheckpointWarning_6603da13-ea21-4491-b60a-0c0e5d68e215, _DialogID)
		THEN
		PROC_CRE_UpperGuards_HiddenCheckpoint_PeacefulResolve();
		
		//Sneaking in will count as if you resolved the main checkpoint
		IF
		FlagSet((FLAG)CRE_UpperGuards_State_GainedAccess_764df691-d1f0-4bde-ba36-73c4abe6a4e7, _, _DialogID)
		AND
		NOT DB_DialogName(CRE_UpperGuards_MainCheckpointTrespassing_11a44b75-14a3-cca7-5c4d-f3a11eb279c1, _DialogID)
		AND
		NOT DB_DialogName(CRE_UpperGuards_MainCheckpointWarning_33c13028-b3af-e22c-b30d-65fb0ad9059a, _DialogID)
		AND
		NOT DB_DialogName(CRE_UpperGuards_HiddenCheckpointTrespassing_85f9aee8-7002-4806-92da-65a90a36a303, _DialogID)
		AND
		NOT DB_DialogName(CRE_UpperGuards_HiddenCheckpointWarning_6603da13-ea21-4491-b60a-0c0e5d68e215, _DialogID)
		AND
		NOT QRY_AnyCREEntranceGuardsDefeated()
		THEN
		PROC_CRE_UpperGuards_MainCheckpoint_PeacefulResolve();
		
		PROC
		PROC_CRE_UpperGuards_MainCheckpoint_PeacefulResolve()
		AND
		DB_CRE_UpperGuards_MainCheckpointGuards(_Guard)
		THEN
		PROC_PeacefulResolve(_Guard);
		
		PROC
		PROC_CRE_UpperGuards_HiddenCheckpoint_PeacefulResolve()
		AND
		DB_CRE_UpperGuards_HiddenCheckpointGuards(_Guard)
		THEN
		PROC_PeacefulResolve(_Guard);
		
		//Detecting if the player defeats any guard
		QRY
		QRY_AnyCREEntranceGuardsDefeated()
		AND
		DB_CRE_UpperGuards_HiddenCheckpointGuards(_Guard)
		AND
		DB_Defeated(_Guard)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_AnyCREEntranceGuardsDefeated()
		AND
		DB_CRE_UpperGuards_MainCheckpointGuards(_Guard)
		AND
		DB_Defeated(_Guard)
		THEN
		DB_NOOP(1);
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(309).Title("Act1b_CRE_WeaponsPuzzle");
Goal(309)
{
	INIT
	{
		//DB to organise the elements of the puzzle by Abbot
		DB_CRE_WeaponPuzzle_ContainersAndWeapons(S_CRE_WeaponsPuzzle_Abbot1_Trigger_e6f01db1-6d5f-4c12-a194-4f4c821940ee, "Maces", CRE_WeaponsPuzzle_HasSpear_d9c14531-51c5-4796-b29b-f44b1ab384c7);
		DB_CRE_WeaponPuzzle_ContainersAndWeapons(S_CRE_WeaponsPuzzle_Abbot2_Trigger_1ece034d-d85d-46c6-9116-5770b0d86372, "Longswords", CRE_WeaponsPuzzle_HasLongsword_3cc7a940-0ecd-44dd-b04c-ebfe4562e56e);
		DB_CRE_WeaponPuzzle_ContainersAndWeapons(S_CRE_WeaponsPuzzle_Abbot3_Trigger_88fbe285-708f-49fd-8da5-16bcdd64fcba, "Warhammers", CRE_WeaponsPuzzle_HasWarhammer_e813343c-bd7e-41c9-b0d8-db5b9ea57dbf);
		DB_CRE_WeaponPuzzle_ContainersAndWeapons(S_CRE_WeaponsPuzzle_Abbot4_Trigger_54605b62-84d6-4ba0-be77-d984627bdc6e, "Battleaxes", CRE_WeaponsPuzzle_HasBattleaxe_3049751e-9841-4b34-b8ee-8950d80bf8a9);
		
		
		DB_CRE_WeaponPuzzle_CeremonialWeapons(S_CRE_Abbot1_Weapon_fce42526-f518-4727-91f6-c41c234fa053);
		DB_CRE_WeaponPuzzle_CeremonialWeapons(S_CRE_Abbot2_Weapon_1edc931d-6471-49c2-b2f4-d3ab0308ac09);
		DB_CRE_WeaponPuzzle_CeremonialWeapons(S_CRE_Abbot3_Weapon_4dffb833-a590-47ea-8c80-71a430b5e099);
		DB_CRE_WeaponPuzzle_CeremonialWeapons(S_CRE_Abbot4_Weapon_0698b266-b7f8-4593-9063-f1189082c6e1);
		
		
		DB_CRE_WeaponPuzzle_Lights(S_CRE_WeaponsPuzzle_Abbot1_Trigger_e6f01db1-6d5f-4c12-a194-4f4c821940ee, S_CRE_Abbot1_Crystal1_On_0689090b-3d74-4575-bfc1-f887b7599d71, S_CRE_Abbot1_Crystal2_On_3d6c7688-4e4a-4924-9bf3-6519cc04f4ce, S_CRE_Abbot1_Crystal1_Off_daaa88d6-4cbc-4829-beb6-afe62b322dda, S_CRE_Abbot1_Crystal2_Off_7d1d0405-7f50-4a53-9538-d62e97554e67);
		DB_CRE_WeaponPuzzle_Lights(S_CRE_WeaponsPuzzle_Abbot2_Trigger_1ece034d-d85d-46c6-9116-5770b0d86372, S_CRE_Abbot2_Crystal1_On_34b048f8-3214-46ac-8da5-48c12c73789b, S_CRE_Abbot2_Crystal2_On_043bad0c-b5d3-4541-abdb-883c5dfb7c3f, S_CRE_Abbot2_Crystal1_Off_9be44bdc-28c2-4a76-82fc-5cff367e430f, S_CRE_Abbot2_Crystal2_Off_0a6c6534-71c7-413d-a6db-4356edc9600f);
		DB_CRE_WeaponPuzzle_Lights(S_CRE_WeaponsPuzzle_Abbot3_Trigger_88fbe285-708f-49fd-8da5-16bcdd64fcba, S_CRE_Abbot3_Crystal1_On_ad12c4cb-464e-454a-a116-e0e17f378b68, S_CRE_Abbot3_Crystal2_On_6984a16f-0489-4dcf-a37b-65365a9fff57, S_CRE_Abbot3_Crystal1_Off_37f1bbca-a639-401d-8bdd-c7d57af783ad, S_CRE_Abbot3_Crystal2_Off_01aae0ef-5cc7-4cc2-b018-139feaf07be6);
		DB_CRE_WeaponPuzzle_Lights(S_CRE_WeaponsPuzzle_Abbot4_Trigger_54605b62-84d6-4ba0-be77-d984627bdc6e, S_CRE_Abbot4_Crystal1_On_0f6c9708-154d-4452-9d4b-345a049f3190, S_CRE_Abbot4_Crystal2_On_0ca3266a-2938-46c2-9636-7b3d61e6db83, S_CRE_Abbot4_Crystal1_Off_8749336c-10b8-48b9-9cc7-22d8be0511a9, S_CRE_Abbot4_Crystal2_Off_255ea95c-153f-4808-8238-da3c225fc581);
		
		//Turn on the crystals (the ones that are pre-solved)
		PROC_SetOnStage(S_CRE_Abbot2_Crystal1_On_34b048f8-3214-46ac-8da5-48c12c73789b, 1);
		PROC_SetOnStage(S_CRE_Abbot2_Crystal2_On_043bad0c-b5d3-4541-abdb-883c5dfb7c3f, 1);
		PROC_SetOnStage(S_CRE_Abbot2_Crystal1_Off_9be44bdc-28c2-4a76-82fc-5cff367e430f, 0);
		PROC_SetOnStage(S_CRE_Abbot2_Crystal2_Off_0a6c6534-71c7-413d-a6db-4356edc9600f, 0);
		
		//Turn off the crystals (the ones that are not pre-solved)
		PROC_SetOnStage(S_CRE_Abbot1_Crystal1_On_0689090b-3d74-4575-bfc1-f887b7599d71, 0);
		PROC_SetOnStage(S_CRE_Abbot1_Crystal2_On_3d6c7688-4e4a-4924-9bf3-6519cc04f4ce, 0);
		PROC_SetOnStage(S_CRE_Abbot3_Crystal1_On_ad12c4cb-464e-454a-a116-e0e17f378b68, 0);
		PROC_SetOnStage(S_CRE_Abbot3_Crystal2_On_6984a16f-0489-4dcf-a37b-65365a9fff57, 0);
		PROC_SetOnStage(S_CRE_Abbot4_Crystal1_On_0f6c9708-154d-4452-9d4b-345a049f3190, 0);
		PROC_SetOnStage(S_CRE_Abbot4_Crystal2_On_0ca3266a-2938-46c2-9636-7b3d61e6db83, 0);
		
		//Triggers
		TriggerRegisterForItems(S_CRE_WeaponsPuzzle_Abbot1_Trigger_e6f01db1-6d5f-4c12-a194-4f4c821940ee);
		TriggerRegisterForItems(S_CRE_WeaponsPuzzle_Abbot2_Trigger_1ece034d-d85d-46c6-9116-5770b0d86372);
		TriggerRegisterForItems(S_CRE_WeaponsPuzzle_Abbot3_Trigger_88fbe285-708f-49fd-8da5-16bcdd64fcba);
		TriggerRegisterForItems(S_CRE_WeaponsPuzzle_Abbot4_Trigger_54605b62-84d6-4ba0-be77-d984627bdc6e);
		
		//Hiding the reward
		PROC_SetOnStage(S_CRE_WeaponsPuzzle_Bag_fe520e48-2caa-421d-948c-30fa84c690ce, 0);
		
		//Sword has been pre-placed into the right container
		SetFlag((FLAG)CRE_WeaponsPuzzle_HasLongsword_3cc7a940-0ecd-44dd-b04c-ebfe4562e56e, NULL_00000000-0000-0000-0000-000000000000);
		ApplyStatus(S_CRE_Abbot2_Weapon_1edc931d-6471-49c2-b2f4-d3ab0308ac09, "LIGHT", -1.0, 0, NULL_00000000-0000-0000-0000-000000000000);
		
		//Dialogs
		DB_Dialogs(S_CRE_PuzzleGlassWindow_40aac2f6-3936-401d-a0c3-329d704088d7, (DIALOGRESOURCE)CRE_WeaponsPuzzle_GlassWindow_82cff210-2ce2-5692-07a6-7556c60f9341);
		
		//Plaques
		DB_ItemDialog_NarratorAD(S_CRE_Abbot1_Plaque_8a99444a-2168-4183-8e14-67e340da7d4f, (DIALOGRESOURCE)CRE_WeaponsPuzzle_AD_Abbot1Plaque_21fbd278-a189-bd33-4961-c4654047b823);
		DB_ItemDialog_NarratorAD(S_CRE_Abbot2_Plaque_7bdb282d-9bb5-4cdc-a134-0bd6892cf41c, (DIALOGRESOURCE)CRE_WeaponsPuzzle_AD_Abbot2Plaque_00de5d66-d352-d92a-d580-379ce8e0b1a7);
		DB_ItemDialog_NarratorAD(S_CRE_Abbot3_Plaque_8088ece6-6069-4c00-a972-a8c0e5d5a473, (DIALOGRESOURCE)CRE_WeaponsPuzzle_AD_Abbot3Plaque_a29fb01b-7078-a06b-b73c-a9e027a37aab);
		DB_ItemDialog_NarratorAD(S_CRE_Abbot4_Plaque_abf40ddb-27e1-4d5e-acfc-726dee84f440, (DIALOGRESOURCE)CRE_WeaponsPuzzle_AD_Abbot4Plaque_da329836-d3e5-443b-9819-6667e8162f8e);
	}
	KB
	{
		//Accept the weapon of the correct type
		IF
		ItemEnteredTrigger(_Weapon, _Trigger, _)
		AND
		DB_CRE_WeaponPuzzle_ContainersAndWeapons(_Trigger, _WeaponType, _Flag)
		AND
		Exists(_Weapon,1)
		AND
		IsEquipmentWithProficiency(_Weapon, _WeaponType, 1)
		THEN
		SetFlag((FLAG)_Flag, NULL_00000000-0000-0000-0000-000000000000);
		ApplyStatus(_Weapon, "LIGHT", -1.0, 0, NULL_00000000-0000-0000-0000-000000000000);
		PROC_CRE_WeaponsPuzzle_TurnOnLight((TRIGGER)_Trigger);
		
		//If the weapon was also non-ceremonial, fire an AD
		IF
		ItemEnteredTrigger(_Weapon, _Trigger, _Player)
		AND
		DB_CRE_WeaponPuzzle_ContainersAndWeapons(_Trigger, _WeaponType, _)
		AND
		Exists(_Weapon,1)
		AND
		IsEquipmentWithProficiency(_Weapon, _WeaponType, 1)
		AND
		NOT DB_CRE_WeaponPuzzle_CeremonialWeapons(_Weapon)
		AND
		QRY_OncePerUserAndNearbyPlayers((CHARACTER)_Player,"CRE_WeaponsPuzzle_FireGenericWeaponsPAD")
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)CRE_WeaponsPuzzle_PAD_GenericWeaponReaction_484e3320-1269-a802-029c-59774bcf68ea, _Player);
		
		//Throw the incorrect weapon back at the player, dealing them damage (once we can cast spells from objects this can use a throw spell
		IF
		ItemEnteredTrigger(_Weapon, _Trigger, _Player)
		AND
		DB_CRE_WeaponPuzzle_ContainersAndWeapons(_Trigger, _WeaponType, _)
		AND
		_Player != NULL_00000000-0000-0000-0000-000000000000
		AND
		Exists(_Weapon,1)
		AND
		NOT IsEquipmentWithProficiency(_Weapon, _WeaponType, 1)
		AND
		GetPosition(_Player, _x, _yTemp, _z)
		AND
		RealSum(_yTemp, 1.0, _y)
		THEN
		ItemMoveToPosition(_Weapon, _x, _y, _z, 10.0, 5.0, "",1);
		ApplyDamage(_Player, 5, "Piercing", _Weapon);
		ApplyStatus(_Player, "KNOCKED_DOWN", 2.0, 2,_Weapon);
		
		//Removing the correct item will end the effect
		IF
		ItemLeftTrigger(_Weapon, _Trigger, _Player)
		AND
		DB_CRE_WeaponPuzzle_ContainersAndWeapons(_Trigger, _WeaponType, _Flag)
		AND
		Exists(_Weapon,1)
		AND
		IsEquipmentWithProficiency(_Weapon, _WeaponType, 1)
		THEN
		ClearFlag((FLAG)_Flag, NULL_00000000-0000-0000-0000-000000000000);
		RemoveStatus(_Weapon, "LIGHT", NULL_00000000-0000-0000-0000-000000000000);
		PROC_CRE_WeaponsPuzzle_RemovedWeaponReaction((CHARACTER)_Player);
		PROC_CRE_WeaponsPuzzle_TurnOffLight((TRIGGER)_Trigger);
		
		PROC
		PROC_CRE_WeaponsPuzzle_RemovedWeaponReaction((CHARACTER)_Player)
		AND
		_Player != NULL_00000000-0000-0000-0000-000000000000
		AND
		QRY_OncePerUserAndNearbyPlayers((CHARACTER)_Player,"CRE_WeaponsPuzzle_RemovedWeaponReaction")
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)CRE_WeaponsPuzzle_VB_RemovedWeaponReaction_d3e5a193-f1d6-79c8-e560-466744b2da18, _Player);
		
		//Turn on light
		PROC
		PROC_CRE_WeaponsPuzzle_TurnOnLight((TRIGGER)_Trigger)
		AND
		DB_CRE_WeaponPuzzle_Lights(_Trigger, _On1, _On2, _Off1, _Off2)
		THEN
		PROC_SetOnStage(_On1, 1);
		PROC_SetOnStage(_On2, 1);
		PROC_SetOnStage(_Off1, 0);
		PROC_SetOnStage(_Off2, 0);
		PROC_LoopEffect(VFX_Script_CRE_Lathander_Platform_A_Crystal_B_01_8677ebf4-fc2c-17e0-bfad-624406962341, _On1, "CRE_BloodOfLathander_Lance_GlowingCrystals", "CRE_Main_A", "", 1.0);
		PROC_LoopEffect(VFX_Script_CRE_Lathander_Platform_A_Crystal_B_01_8677ebf4-fc2c-17e0-bfad-624406962341, _On2, "CRE_BloodOfLathander_Lance_GlowingCrystals", "CRE_Main_A", "", 1.0);
		
		//Turn off light
		PROC
		PROC_CRE_WeaponsPuzzle_TurnOffLight((TRIGGER)_Trigger)
		AND
		DB_CRE_WeaponPuzzle_Lights(_Trigger, _On1, _On2, _Off1, _Off2)
		THEN
		PROC_SetOnStage(_On1, 0);
		PROC_SetOnStage(_On2, 0);
		PROC_SetOnStage(_Off1, 1);
		PROC_SetOnStage(_Off2, 1);
		
		
		//TODO: Edge-case: If there are multiple weapons of the correct type on the pedestal removing one shouldn't end the success condition
		
		//Checking if all the weapons are in the correct location and revealing the reward.
		IF
		DB_GlobalFlag(CRE_WeaponsPuzzle_HasSpear_d9c14531-51c5-4796-b29b-f44b1ab384c7)
		AND
		DB_GlobalFlag(CRE_WeaponsPuzzle_HasWarhammer_e813343c-bd7e-41c9-b0d8-db5b9ea57dbf)
		AND
		DB_GlobalFlag(CRE_WeaponsPuzzle_HasBattleaxe_3049751e-9841-4b34-b8ee-8950d80bf8a9)
		AND
		DB_GlobalFlag(CRE_WeaponsPuzzle_HasLongsword_3cc7a940-0ecd-44dd-b04c-ebfe4562e56e)
		AND
		QRY_OnlyOnce("CRE_WeaponsPuzzle_GiveReward")
		THEN
		PROC_CRE_WeaponsPuzzle_GiveReward();
		
		PROC
		PROC_CRE_WeaponsPuzzle_GiveReward()
		AND
		DB_Players(_Player)
		THEN
		PROC_CRE_WeaponsPuzzle_OpenHiddenCompartment();
		ApplyStatus(_Player, "CRE_MAG_LATHANDER_PUZZLE_BOON", -1.0, 1, NULL_00000000-0000-0000-0000-000000000000);
		QuestUpdate(_Player, "HIDDEN_CRE_Boosters", "CRE_WeaponsPuzzle_SolvedPuzzle");
		
		PROC
		PROC_CRE_WeaponsPuzzle_OpenHiddenCompartment()
		AND
		QRY_OnlyOnce("CRE_WeaponsPuzzle_OpenedHiddenDoor")
		THEN
		ItemMoveTo(S_CRE_WeaponsPuzzle_HiddenDoor_5e2d9891-0dfb-4d00-9691-6ed69a50c58a, S_CRE_WeaponsPuzzle_HiddenDoor_MoveToPoint_ee34da09-14bb-426d-9417-2012f818ec1d, 0.5, 1.0, 0, "CRE_WeaponsPuzzle_SecretDoorOpened");
		PROC_SetOnStage(S_CRE_WeaponsPuzzle_Bag_fe520e48-2caa-421d-948c-30fa84c690ce, 1);
		
		IF
		Unlocked(S_CRE_WeaponsPuzzle_HiddenDoor_5e2d9891-0dfb-4d00-9691-6ed69a50c58a, _, _)
		THEN
		PROC_CRE_WeaponsPuzzle_OpenHiddenCompartment();
		
		//REGION Reaction VB after reading the lat Dawnmaster's note left with the key 
		IF
		UseFinished(_Player, S_CRE_WeaponsPuzzle_Note_4c5bbc63-61f4-43f1-b2a1-de29071fd87c, 1)
		AND
		QRY_OncePerUserAndNearbyPlayers((CHARACTER)_Player,"CRE_Monastery_HiddenNoteReaction")
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)CRE_WeaponsPuzzle_VB_HiddenNoteReaction_18caef9b-1aaa-2112-50db-1d3e2aceda7a, _Player);
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(310).Title("Act1b_CRE_YouthTraining");
Goal(310)
{
	INIT
	{
		PROC_CRE_YouthTraining_SceneSetup();
		
		DB_CRE_YouthTraining_Students((CHARACTER)S_CRE_Student01_82f7512c-3b1d-4af7-92cc-3fbe4e4d9c33);
		DB_CRE_YouthTraining_Students((CHARACTER)S_CRE_Student02_0d17add0-9e8d-4e6f-82e0-cd14645707d5);
		DB_CRE_YouthTraining_Students((CHARACTER)S_CRE_Student03_91223ba2-41d5-4cde-85b2-6b076e462e3b);
		DB_CRE_YouthTraining_Students((CHARACTER)S_CRE_Student04_d3eb2b9a-ac8e-40dc-8596-70b05d08496b);
		
		DB_CRE_YouthTraining_Characters((CHARACTER)S_CRE_Student01_82f7512c-3b1d-4af7-92cc-3fbe4e4d9c33);
		DB_CRE_YouthTraining_Characters((CHARACTER)S_CRE_Student02_0d17add0-9e8d-4e6f-82e0-cd14645707d5);
		DB_CRE_YouthTraining_Characters((CHARACTER)S_CRE_Student03_91223ba2-41d5-4cde-85b2-6b076e462e3b);
		DB_CRE_YouthTraining_Characters((CHARACTER)S_CRE_Student04_d3eb2b9a-ac8e-40dc-8596-70b05d08496b);
		DB_CRE_YouthTraining_Characters((CHARACTER)S_CRE_Teacher_60933e69-c642-46e0-92ee-0e4353fc2adf);
		DB_CRE_YouthTraining_Characters((CHARACTER)S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187);
		DB_CRE_YouthTraining_Characters((CHARACTER)S_CRE_CrecheKid01_81845208-9721-4c58-8546-84f958a85d57);
		DB_CRE_YouthTraining_Characters((CHARACTER)S_CRE_CrecheKid02_5d33ac06-faa7-48c3-8794-6cff79515ce5);
		DB_CRE_YouthTraining_Characters((CHARACTER)S_CRE_CrecheKid03_ba10db62-da84-4c7e-8867-0a98be775aa9);
		DB_CRE_YouthTraining_Characters((CHARACTER)S_CRE_CrecheKid04_139392d5-d068-4445-b5a4-42ef9340b1b7);
		DB_CRE_YouthTraining_Characters((CHARACTER)S_CRE_IntelligenceOfficer02_a17c356a-6e0c-4d2f-bcf6-58195d6c9edf);
		
		DB_SceneManager((CHARACTER)S_CRE_Teacher_60933e69-c642-46e0-92ee-0e4353fc2adf, "CRE_TrainingRoom");
		DB_SceneManager((CHARACTER)S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, "CRE_TrainingRoom");
		DB_SceneAllowAllDisturbances("CRE_TrainingRoom");
		//Students also added
		DB_SceneTriggerManager("CRE_TrainingRoom", (TRIGGER)S_CRE_TrainingSpottingArea_5f20a9d0-5d9f-4248-8711-2a784770c6aa);
		
		DB_GLO_DefeatCounter((CHARACTER)S_CRE_Teacher_60933e69-c642-46e0-92ee-0e4353fc2adf, "CRE_YouthTraining");
		//Students also added
		
		DB_Dialogs((CHARACTER)S_CRE_Teacher_60933e69-c642-46e0-92ee-0e4353fc2adf, (CHARACTER)S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, (CHARACTER)S_CRE_Student02_0d17add0-9e8d-4e6f-82e0-cd14645707d5, (DIALOGRESOURCE)CRE_YouthTraining_Teacher_2c57553c-9473-fd1e-8614-6a49b71dcf1c);
		DB_Dialogs((CHARACTER)S_CRE_Student01_82f7512c-3b1d-4af7-92cc-3fbe4e4d9c33, (DIALOGRESOURCE)CRE_YouthTraining_Student01_d91bf1f9-858a-0283-751c-345ec885ef87);
		DB_Dialogs((CHARACTER)S_CRE_Student02_0d17add0-9e8d-4e6f-82e0-cd14645707d5, (DIALOGRESOURCE)CRE_YouthTraining_Student02_79ab47df-c3fc-3c14-82d8-fe70908603a2);
		DB_Dialogs((CHARACTER)S_CRE_Student03_91223ba2-41d5-4cde-85b2-6b076e462e3b, (DIALOGRESOURCE)CRE_YouthTraining_Student03_28d59fda-1144-756e-54b4-6b7bdeecd3f5);
		DB_Dialogs((CHARACTER)S_CRE_Student04_d3eb2b9a-ac8e-40dc-8596-70b05d08496b, (DIALOGRESOURCE)CRE_YouthTraining_Student04_098d8069-0397-82df-2204-3d1a2c85e189);
		
		DB_GLO_CharacterCorpseDialog((CHARACTER)S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, (DIALOGRESOURCE)CRE_YouthTraining_GithBoy_Dead_d2a7b1b8-249a-e409-396b-60421c1fd4b0);
		
		DB_GlobalFlagReactionAfterDialog((FLAG)CRE_YouthTraining_Event_StudentPicksUpBoy_71670609-309b-4011-b480-e882f0bfd343, (DIALOGRESOURCE)CRE_YouthTraining_Teacher_2c57553c-9473-fd1e-8614-6a49b71dcf1c);
		DB_GlobalFlagReactionAfterDialog((FLAG)CRE_YouthTraining_State_BoySpared_4396d45f-8ef0-4be1-87b4-798ef58f2cbb, (DIALOGRESOURCE)CRE_YouthTraining_Teacher_2c57553c-9473-fd1e-8614-6a49b71dcf1c);
		DB_GlobalFlagReactionAfterDialog((FLAG)CRE_YouthTraining_State_BoyDead_8170ef3e-f42c-488d-b619-128083e0832c, (DIALOGRESOURCE)CRE_YouthTraining_Teacher_2c57553c-9473-fd1e-8614-6a49b71dcf1c);
		DB_GlobalFlagReactionAfterDialog((FLAG)CRE_YouthTraining_State_BoyNonFatal_bf54e5b4-91bd-4f0e-9323-f4d32cdd76ef, (DIALOGRESOURCE)CRE_YouthTraining_Teacher_2c57553c-9473-fd1e-8614-6a49b71dcf1c);
		
		DB_TriggerEvents_AllPartyMembersLeft((TRIGGER)S_CRE_YouthTrainingLeaveArea_b492a439-4c9e-4cdc-8f8b-b89876e74eb6, "CRE_YouthTraining_LeaveArea"); //Changes a dialog node in the Teacher dialog
		
		//giving the boy low starting HP
		SetHitpoints(S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, 3);
		PROC_SelfHealing_Disable(S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187);
		DB_PreventKnockedOutPermaDefeated((CHARACTER)S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187);
		DB_DeadOnceFlag(S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, CRE_YouthTraining_State_BoyDead_8170ef3e-f42c-488d-b619-128083e0832c);
		
		DB_QuestDef_State((FLAG)CRE_YouthTraining_State_BoySpared_4396d45f-8ef0-4be1-87b4-798ef58f2cbb, "HIDDEN_CRE_Boosters", "CRE_YouthTraining_BoySpared");
		//REGION Combat ADs
		DB_CombatReact_AD_OnTurn(S_CRE_Student03_91223ba2-41d5-4cde-85b2-6b076e462e3b, (DIALOGRESOURCE)CRE_YouthTraining_AD_Student03Combat_159a5573-a2c8-b8a1-be33-465f1cdfa046, 1);
		//END_REGION
		
		
		//REGION One-handed students
		DB_CRE_YouthTraining_OneHandedStudents(S_CRE_Student01_82f7512c-3b1d-4af7-92cc-3fbe4e4d9c33);
		DB_CRE_YouthTraining_OneHandedStudents(S_CRE_Student02_0d17add0-9e8d-4e6f-82e0-cd14645707d5);
		PROC_CRE_YouthTraining_UnequipOffHandSword();
		//END_REGION
	}
	KB
	{
		//REGION Debug commands
		IF
		TextEvent("cre_gototeacher")
		AND
		GetHostCharacter(_Player)
		THEN
		TeleportTo(_Player, S_CRE_DebugPos_TrainingRoom_ff0f5aa8-1ef8-49c0-b6c7-52b5526cd0f4, "", 1, 1, 1, 1, 1);
		
		//END_REGION
		
		//REGION Setup
		IF
		DB_CRE_YouthTraining_Students(_Student)
		THEN
		DB_GLO_DefeatCounter(_Student, "CRE_YouthTraining");
		DB_GLO_DefeatCounter(_Student, "CRE_YouthTraining_Students");
		
		PROC
		PROC_CRE_YouthTraining_SceneSetup()
		THEN
		DB_DoNotFaceDialog((CHARACTER)S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, (DIALOGRESOURCE)CRE_YouthTraining_AD_TeacherBeatingBoy_54a13362-dfe9-17c8-c393-cfa5fa844011);
		SetFlag(CRE_YouthTraining_State_TeacherBeatingBoy_ccaa2ee8-654b-491f-9623-c8a9376d3c61); //Used in Anubis to play rate limited ADs
		
		//Changes a line in the Teacher dialog if the players saw the scene happen, then left the region. Added because it's a weird scene to go on for days, a small dialog variation fixes this.
		IF
		EntityEvent(_, "CRE_YouthTraining_LeaveArea")
		THEN
		SetFlag((FLAG)CRE_YouthTraining_State_LeftAfterSeeingScene_ad6cb8c1-ad05-4fc0-8117-a0e209a54e0c);
		
		
		IF
		LevelLoaded("CRE_Main_A")
		AND
		QRY_OnlyOnce("CRE_YouthTrainingDoorOpened")
		THEN
		Open(S_CRE_ClassRoomDoor_e3da8dbc-3fc7-4506-ae14-b37e92855f63);
		//END_REGION
		
		//REGION Orpheus Chapters
		IF
		FlagSet((FLAG)CRE_YouthTraining_Event_DestroyedChapter2_fc37c481-0f81-4433-8352-210bc8aeec13, NULL_00000000-0000-0000-0000-000000000000, _Id)
		AND
		DialogGetInvolvedPlayer(_Id, 1, _Player)
		THEN
		MagicPocketsDrop((CHARACTER)_Player, (ITEM)S_CRE_OprheusStoryChapter2_4dbaf850-49ff-4e41-adc2-7054e416c960);
		//END_REGION
		
		//REGION Stop animations
		IF
		DialogStarted((DIALOGRESOURCE)CRE_YouthTraining_Teacher_2c57553c-9473-fd1e-8614-6a49b71dcf1c, _)
		THEN
		ClearFlag(CRE_YouthTraining_State_TeacherBeatingBoy_ccaa2ee8-654b-491f-9623-c8a9376d3c61);
		//END_REGION
		
		//REGION Scene interruption
		PROC
		PROC_SceneInterrupted(_, _Player, "CRE_TrainingRoom", _Interruption)
		AND
		DB_GLO_GenericSceneManager_ViolenceReason(_Interruption)
		THEN
		PROC_ForceStopDialog((CHARACTER)S_CRE_Teacher_60933e69-c642-46e0-92ee-0e4353fc2adf);
		PROC_ForceStopDialog((CHARACTER)S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187);
		
		PROC
		PROC_SceneInterrupted(_NPC, _Player, "CRE_TrainingRoom", "LeftTrigger")
		AND
		DB_SceneManager((CHARACTER)_NPC, "CRE_TrainingRoom")
		THEN
		PROC_CRE_YouthTraining_TeacherKillsBoy_Gameplay();
		PROC_SceneOver("CRE_TrainingRoom");
		
		IF
		DialogEnded((DIALOGRESOURCE)CRE_YouthTraining_Teacher_2c57553c-9473-fd1e-8614-6a49b71dcf1c, _)
		AND
		NOT DB_GlobalFlag(CRE_YouthTraining_State_BoySpared_4396d45f-8ef0-4be1-87b4-798ef58f2cbb)
		AND 
		NOT DB_GlobalFlag(CRE_YouthTraining_State_BoyDead_8170ef3e-f42c-488d-b619-128083e0832c)
		AND 
		NOT DB_GlobalFlag(CRE_YouthTraining_State_BoyNonFatal_bf54e5b4-91bd-4f0e-9323-f4d32cdd76ef)
		THEN
		PROC_CRE_YouthTraining_TeacherKillsBoy_Gameplay();
		
		PROC
		PROC_CRE_YouthTraining_TeacherKillsBoy_Gameplay()
		THEN
		NOT DB_PreventKnockedOutPermaDefeated((CHARACTER)S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187);
		Attack((CHARACTER)S_CRE_Teacher_60933e69-c642-46e0-92ee-0e4353fc2adf, S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, 1);
		ClearFlag(CRE_YouthTraining_State_TeacherBeatingBoy_ccaa2ee8-654b-491f-9623-c8a9376d3c61);
		DB_CRE_YouthTraining_TeacherKillingBoy(1);
		
		IF
		AttackedBy(S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, _, S_CRE_Teacher_60933e69-c642-46e0-92ee-0e4353fc2adf, _, _, _, _)
		AND
		DB_CRE_YouthTraining_TeacherKillingBoy(1)
		AND
		NOT DB_Dead(S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187)
		THEN
		Attack((CHARACTER)S_CRE_Teacher_60933e69-c642-46e0-92ee-0e4353fc2adf, S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, 1);
		
		IF
		KilledBy(S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, S_CRE_Teacher_60933e69-c642-46e0-92ee-0e4353fc2adf, _, _)
		THEN
		SetFlag((FLAG)CRE_YouthTraining_State_BoyKilledByTeacher_0fc4fcd2-4d2a-4bf9-aed2-67970912a87c);
		PROC_CharacterMoveTo(S_CRE_Student01_82f7512c-3b1d-4af7-92cc-3fbe4e4d9c33, S_CRE_StudentBringToCornerPos_8b05634f-8de6-4ade-b36b-3a1c94fd4a3c, "Run", "CRE_YouthTraining_StudentReachBoy");
		//END_REGION
		
		//REGION Outcomes
		IF
		DialogEnded((DIALOGRESOURCE)CRE_YouthTraining_Teacher_2c57553c-9473-fd1e-8614-6a49b71dcf1c, _)
		THEN
		PROC_SceneOver("CRE_TrainingRoom");
		
		PROC
		PROC_SceneOver("CRE_TrainingRoom")
		THEN
		PROC_RemoveDialog((CHARACTER)S_CRE_Teacher_60933e69-c642-46e0-92ee-0e4353fc2adf);
		PROC_RemoveDialog((CHARACTER)S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187);
		DB_Dialogs(S_CRE_Teacher_60933e69-c642-46e0-92ee-0e4353fc2adf, (DIALOGRESOURCE)CRE_YouthTraining_TeacherAfterBoyScene_eea69a84-2b01-2883-9765-7173be26ce69);
		DB_Dialogs((CHARACTER)S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, (DIALOGRESOURCE)CRE_YouthTraining_GithBoy_d626f26f-b534-6c8f-b87a-3e8d600e8dd0);
		NOT DB_TriggerEvents_AllPartyMembersLeft((TRIGGER)S_CRE_YouthTrainingLeaveArea_b492a439-4c9e-4cdc-8f8b-b89876e74eb6, "CRE_YouthTraining_LeaveArea");
		SetFlag((FLAG)CRE_YouthTraining_State_BackToClass_dad66da6-c0e9-41a9-93ee-5f106d69f92d, NULL_00000000-0000-0000-0000-000000000000, 0 );
		
		///////////////Boy after killing everyone else///////////////
		PROC
		PROC_GLO_DefeatCounter_AllPermaDefeated("CRE_YouthTraining")
		THEN
		PROC_CRE_YouthTraining_BoyGoesToCorner();
		
		PROC
		PROC_GLO_DefeatCounter_AllDefeated("CRE_YouthTraining")
		THEN
		PROC_CRE_YouthTraining_BoyGoesToCorner();
		
		PROC
		PROC_CRE_YouthTraining_BoyGoesToCorner()
		AND
		NOT DB_CantMove((CHARACTER)S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187)
		AND
		QRY_OnlyOnce("CRE_YouthTrainingFight")
		THEN
		DB_Dialogs((CHARACTER)S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, (DIALOGRESOURCE)CRE_YouthTraining_GithBoy_d626f26f-b534-6c8f-b87a-3e8d600e8dd0);
		PROC_CharacterMoveTo(S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, S_CRE_GithBoyTrainingRoomPos_68418a7e-3de4-42af-a7d8-f32935be36bd, "Walk", "");
		SetFlag((FLAG)CRE_YouthTraining_State_BackToClass_dad66da6-c0e9-41a9-93ee-5f106d69f92d, NULL_00000000-0000-0000-0000-000000000000, 0 );
		
		IF
		DB_Is_InCombat(_YTGith, _ID)
		AND
		DB_CRE_YouthTraining_Characters((CHARACTER)_YTGith)
		AND
		DB_Is_InCombat(_Player, _ID)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		NOT DB_GlobalFlag(CRE_YouthTraining_Event_AttackedTeacher_41d9d554-9761-47ce-b2d2-d1085f5f3345)
		THEN
		SetFlag(CRE_YouthTraining_Event_AttackedTeacher_41d9d554-9761-47ce-b2d2-d1085f5f3345);
		
		///////////////Boy is spared///////////////
		//ToDo: Add Anubis states to the boy instead of the CharacterMoveTo logic in the whole script
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)CRE_YouthTraining_State_BoySpared_4396d45f-8ef0-4be1-87b4-798ef58f2cbb)
		THEN
		PROC_CharacterMoveTo((CHARACTER)S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, (TRIGGER)S_CRE_GithBoyTrainingRoomPos_68418a7e-3de4-42af-a7d8-f32935be36bd, "Walk", "CRE_YouthTraining_GithBoyTrainingRoomPosReached");
		//TODO Move behaviour to anubis
		
		IF
		EntityEvent(_GithBoy, "CRE_YouthTraining_GithBoyTrainingRoomPosReached")
		THEN
		LookFromTrigger((CHARACTER)_GithBoy,(TRIGGER)S_CRE_GithBoyTrainingRoomPos_68418a7e-3de4-42af-a7d8-f32935be36bd, 0);
		
		///////////////Boy is carried away///////////////
		//If the boy is killed by the player in the dialog, he would remember in the SwD dialog
		IF
		FlagSet((FLAG)CRE_YouthTraining_State_BoyKilledIntentionallyByPlayer_1e390a10-560b-40c6-b87a-1b3e4de2f9f6, (CHARACTER)_Player, _)
		THEN
		PROC_SpeakWithDead_SetCustomKiller((CHARACTER)S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187,_Player);
		
		IF
		FlagSet((FLAG)CRE_YouthTraining_State_BoyKilledAccidentallyByPlayer_364f94cb-5b43-42c5-9e88-1922310f9ea3, (CHARACTER)_Player, _)
		THEN
		PROC_SpeakWithDead_SetCustomKiller((CHARACTER)S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187,_Player);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)CRE_YouthTraining_State_BoyDead_8170ef3e-f42c-488d-b619-128083e0832c)
		THEN
		Die(S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, DEATHTYPE.Physical, NULL_00000000-0000-0000-0000-000000000000, 0, 1, 0.0);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)CRE_YouthTraining_State_BoyNonFatal_bf54e5b4-91bd-4f0e-9323-f4d32cdd76ef)
		THEN
		SetHitpoints(S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187,1);
		ApplyStatus(S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, "KNOCKED_OUT", -1.0, 1, NULL_00000000-0000-0000-0000-000000000000);
		PROC_SelfHealing_Disable(S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187);
		
		//Moving dead boy to corner
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)CRE_YouthTraining_Event_StudentPicksUpBoy_71670609-309b-4011-b480-e882f0bfd343)
		THEN
		SetFlag((FLAG)CRE_YouthTraining_State_BoyNonFatal_bf54e5b4-91bd-4f0e-9323-f4d32cdd76ef);
		PROC_CharacterMoveTo(S_CRE_Student01_82f7512c-3b1d-4af7-92cc-3fbe4e4d9c33, S_CRE_StudentBringToCornerPos_8b05634f-8de6-4ade-b36b-3a1c94fd4a3c, "Run", "CRE_YouthTraining_StudentReachBoy");
		
		IF
		EntityEvent(_Student, "CRE_YouthTraining_StudentReachBoy")
		AND
		GetPosition(_Student, _X, _Y, _Z)
		AND
		RealSum(_Y, 1.3, _NewY)
		AND
		RealSum(_X, 0.5, _NewX)
		AND
		RealSum(_Z, 0.2, _NewZ)
		THEN
		PlatformMoveOnSpline(PLT_CRE_FloatingBed_000_dd5d3c7a-e624-4701-8fb7-afbffd716b87, S_CRE_FloatingBed_PathToBoy_4770cc3d-c35b-49a1-b9a3-3268dab0e4df, 0, 5, 3.0, "CRE_YouthtTaining_FloatingBed_ArrivedNearBoy", 0);
		PlayLoopingAnimation(_Student, CUST_PsionicControl_01_Start_99f99e89-e2fa-4bba-a451-a1ccf180a34b, CUST_PsionicControl_01_Loop_ba806fef-e4ec-42a5-9367-c9b09d1b8410, CUST_PsionicControl_01_End_dc0adcc8-44f6-4175-9858-f036cf5e726d, NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000,NULL_00000000-0000-0000-0000-000000000000);
		PROC_LoopEffectAtPosition(VFX_Script_CRE_FloatingBed_Cast_01_694e12dc-50ed-790b-debf-ad0107d94f54, _Student, "CRE_FloatingBed_StudentPart", _NewX, _NewY, _NewZ, "CRE_Main_A");
		PROC_LoopEffect(VFX_Script_CRE_FloatingBed_01_46c9231f-e203-04b9-8c86-520e3e0c1e67, DEC_GEN_Stretcher_Bed_A_000_bdf2c4c9-deb9-410c-b2c5-1c9f6d146600, "CRE_FloatingBed_BedPart", "CRE_Main_A", "");
		DB_SceneManager(S_CRE_Student01_82f7512c-3b1d-4af7-92cc-3fbe4e4d9c33, "CRE_BedMovingScene");
		DB_SceneAllowAllDisturbances("CRE_BedMovingScene");
		
		//If the student is bothered, cancel the animation and VFX on her
		PROC
		PROC_SceneInterrupted(_, _, "CRE_BedMovingScene", _)
		THEN
		StopAnimation(S_CRE_Student01_82f7512c-3b1d-4af7-92cc-3fbe4e4d9c33, 0);
		PROC_StopLoopEffect(S_CRE_Student01_82f7512c-3b1d-4af7-92cc-3fbe4e4d9c33, "CRE_FloatingBed_StudentPart");
		
		IF
		PlatformMovementFinished(PLT_CRE_FloatingBed_dd5d3c7a-e624-4701-8fb7-afbffd716b87,"CRE_YouthtTaining_FloatingBed_ArrivedNearBoy")
		THEN
		DB_CRE_FloatingBedIsNearBoy(1);
		
		IF
		EntityEvent(_Student, "CRE_YouthTraining_StudentReachBoy")
		THEN
		DB_CRE_StudentIsNearBoy(1);
		
		IF
		DB_CRE_FloatingBedIsNearBoy(1)
		AND
		DB_CRE_StudentIsNearBoy(1)
		THEN
		TeleportTo(S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, S_CRE_TeleportOnBedPoint_8e2cd52b-dde1-8b34-0edb-90c82e629c2a, "", 0,0,0,0,1);
		PROC_CRE_FloatingBed_ReturnToStartingPos();
		
		PROC
		PROC_CRE_FloatingBed_ReturnToStartingPos()
		AND
		QRY_OnlyOnce("CRE_FloatingBed_ReturnToStartingPos")
		THEN
		PlatformMoveOnSpline(PLT_CRE_FloatingBed_000_dd5d3c7a-e624-4701-8fb7-afbffd716b87, S_CRE_FloatingBed_PathToBoy_4770cc3d-c35b-49a1-b9a3-3268dab0e4df, 5, 0, 3.0, "CRE_YouthtTaining_FloatingBed_ArrivedBackWithBoy", 0);
		
		IF
		PlatformMovementFinished(PLT_CRE_FloatingBed_dd5d3c7a-e624-4701-8fb7-afbffd716b87,"CRE_YouthtTaining_FloatingBed_ArrivedBackWithBoy")
		THEN
		SetFlag((FLAG)CRE_YouthTraining_State_BoySatInInfirmary_fcf04858-9cc6-440f-bffe-55b7b6b4fdf1, NULL_00000000-0000-0000-0000-000000000000);
		StopAnimation(S_CRE_Student01_82f7512c-3b1d-4af7-92cc-3fbe4e4d9c33, 0);
		PROC_StopLoopEffect(S_CRE_Student01_82f7512c-3b1d-4af7-92cc-3fbe4e4d9c33, "CRE_FloatingBed_StudentPart");
		PROC_StopLoopEffect(DEC_GEN_Stretcher_Bed_A_000_bdf2c4c9-deb9-410c-b2c5-1c9f6d146600, "CRE_FloatingBed_BedPart");
		
		
		//If the Boy has been hospitalised and then healed by the player
		IF 
		HitpointsChanged(GithBoy_3e97baba-812b-4589-a7aa-454543aa3187,_healthPercentage)
		AND 
		GetFlag((FLAG)CRE_YouthTraining_State_BoySatInInfirmary_fcf04858-9cc6-440f-bffe-55b7b6b4fdf1,NULL_00000000-0000-0000-0000-000000000000,1)
		AND
		_healthPercentage > 1
		THEN
		PROC_SelfHealing_Enable(S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187);
		SetFlag((FLAG)CRE_YouthTraining_State_PlayerHealedBoy_3da2c5a5-5837-41eb-a83b-4404978d544a);
		SetFlag((FLAG)CRE_YouthTraining_State_BoySpared_4396d45f-8ef0-4be1-87b4-798ef58f2cbb);
		ClearFlag((FLAG)CRE_YouthTraining_State_BoySatInInfirmary_fcf04858-9cc6-440f-bffe-55b7b6b4fdf1);
		RemoveStatus(S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, "KNOCKED_OUT", NULL_00000000-0000-0000-0000-000000000000);
		DB_Dialogs((CHARACTER)S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, (DIALOGRESOURCE)CRE_YouthTraining_GithBoy_d626f26f-b534-6c8f-b87a-3e8d600e8dd0);
		
		
		IF
		StatusRemoved(S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, "KNOCKED_OUT", NULL_00000000-0000-0000-0000-000000000000, _)
		THEN
		NOT DB_PreventKnockedOutPermaDefeated((CHARACTER)S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187);
		
		IF
		StatusApplied(S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, _Status, _Player, _)
		AND
		QRY_IsHealingStatus(_Status)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		DB_GlobalFlag((FLAG)CRE_YouthTraining_State_TeacherBeatingBoy_ccaa2ee8-654b-491f-9623-c8a9376d3c61)
		AND
		QRY_OnlyOnce("CRE_YouthTraining_HealedBoyDuringGameplay")
		THEN
		SetFlag((FLAG)CRE_YouthTraining_Event_BoyHealedDuringBeating_7c151265-5513-490a-aaf6-06a702f92dd6, _Player);
		
		IF
		FlagSet((FLAG)CRE_YouthTraining_Event_BoyHealedDuringBeating_7c151265-5513-490a-aaf6-06a702f92dd6, _Player, _)
		THEN
		PROC_CRE_StartTeacherDialog((CHARACTER)_Player);
		
		PROC
		PROC_CRE_StartTeacherDialog((CHARACTER)_Player)
		AND 
		QRY_StartDialog_Fixed((DIALOGRESOURCE)CRE_YouthTraining_Teacher_2c57553c-9473-fd1e-8614-6a49b71dcf1c, S_CRE_Teacher_60933e69-c642-46e0-92ee-0e4353fc2adf, S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, S_CRE_Student02_0d17add0-9e8d-4e6f-82e0-cd14645707d5, _Player)
		THEN
		DB_NOOP(1);
		
		//END_REGION
		
		
		//REGION Custom crime for attacking the kid
		QRY
		QRY_CRIME_BlockRegisterCrime(_Player, _Type, _Evidence, (CHARACTER)S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, _ID)
		AND
		QRY_CRIME_IsCrimeFamilyMember(_Type, "Assault")
		THEN
		PROC_CharacterRegisterCrime(_Player, "CRE_GithKid_Assault", _Evidence, (CHARACTER)S_CRE_GithBoy_3e97baba-812b-4589-a7aa-454543aa3187, 0);
		//END_REGION
		
		//REGION Combat ADs
		PROC
		PROC_StateSet_Defeated(_Youth) //doesn't mention death explicitly ("Pathetic weakling.")
		AND
		DB_CRE_YouthTraining_Students((CHARACTER)_Youth)
		AND
		QRY_OnlyOnce("CRE_YouthTraining_StudentDefeatedCombatReact")
		THEN
		DB_CombatReact_AD_OnNextTurn((CHARACTER)S_CRE_Teacher_60933e69-c642-46e0-92ee-0e4353fc2adf, (DIALOGRESOURCE)CRE_YouthTraining_AD_TeacherCombat_YouthDies_32eff058-9c35-1853-43d7-dd62226e74fe);
		
		PROC
		PROC_GLO_DefeatCounter_AllPermaDefeated("CRE_YouthTraining_Students")
		AND
		NOT DB_PermaDefeated(S_CRE_Teacher_60933e69-c642-46e0-92ee-0e4353fc2adf)
		THEN
		DB_CombatReact_AD_OnNextTurn((CHARACTER)S_CRE_Teacher_60933e69-c642-46e0-92ee-0e4353fc2adf, (DIALOGRESOURCE)CRE_YouthTraining_AD_TeacherCombat_AllYouthDead_c4b1b49a-abe7-6485-2632-eb81be20e270);
		
		IF
		CastedSpell(S_CRE_Teacher_60933e69-c642-46e0-92ee-0e4353fc2adf, "Target_CRE_Savarsh_CombatInstruction", _, _, _)
		AND
		DB_Is_InCombat(S_CRE_Teacher_60933e69-c642-46e0-92ee-0e4353fc2adf, _ID)
		AND
		DB_Is_InCombat(_Player, _ID)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		QRY_OnlyOnce("CRE_YouthTraining_TeacherAbilityCombatReact")
		THEN
		DB_CombatReact_AD_OnNextTurn((GUIDSTRING)_Player, (DIALOGRESOURCE)CRE_YouthTraining_PAD_Combat_TeacherAbilityReaction_c8bf8ad2-e545-3148-b01e-c2a48b030e9b);
		//END_REGION
		
		//REGION One-handed students
		PROC
		PROC_CRE_YouthTraining_UnequipOffHandSword()
		AND
		DB_CRE_YouthTraining_OneHandedStudents(_Student)
		AND
		GetEquippedItem((CHARACTER)_Student,"Melee Offhand Weapon",_OffHandSword)
		THEN
		DB_CRE_YouthTraining_OneHandedStudents_OffhandWeapon(_Student, _OffHandSword);
		Unequip(_Student, _OffHandSword);
		
		IF
		EnteredCombat(_Student, _)
		AND
		DB_CRE_YouthTraining_OneHandedStudents_OffhandWeapon((CHARACTER)_Student, _OffHandSword)
		THEN
		Equip(_Student, _OffHandSword, 1, 0, 0);
		NOT DB_CRE_YouthTraining_OneHandedStudents_OffhandWeapon(_Student, _OffHandSword);
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(311).Title("Act1b_FireBowls");
Goal(311)
{
	INIT
	{
		DB_GLO_FireBowls(LTS_DUN_Chandelier_A_016_575d850b-546b-433a-a40d-a4caacdec7a9, LTS_DUN_Chandelier_Hinge_A_028_25452be9-884e-4542-ab9f-7c08d8067f9b);
		DB_GLO_FireBowls(LTS_DUN_Chandelier_A_015_2fb891c9-29e4-4f8b-8cab-ef51ff5cb91f, LTS_DUN_Chandelier_Hinge_A_027_dcb41ac8-a6c6-4d7b-8656-f5e5fa4dc0cb);
		DB_GLO_FireBowls(LTS_DUN_Chandelier_C_016_73e8940a-b4ab-472e-a1f1-d4d2125bbe6b, LTS_DUN_Chandelier_Hinge_A_021_cc8d9f36-099d-4f3c-8c5c-adcb7f432d2c);
		DB_GLO_FireBowls(LTS_DUN_Chandelier_C_Gold_000_ab82482a-f8e6-45d4-85b4-07971e57a3b0, LTS_DUN_Chandelier_Hinge_A_Gold_001_355e940d-3e16-41c0-8738-3432f40ce001);
		DB_GLO_FireBowls(LTS_DUN_Chandelier_C_017_b08c11be-b798-486d-953e-7392fb8bac62, LTS_DUN_Chandelier_Hinge_A_022_916c12ae-4e7b-4f9c-b525-d40cc3202ae5);
		DB_GLO_FireBowls(LTS_DUN_Chandelier_C_015_0e86d63d-a285-4949-800f-ce87eec2dc4c, LTS_DUN_Chandelier_Hinge_A_020_af5c324b-67e7-4778-ad3f-a791fc1fb5b1);
		DB_GLO_FireBowls(LTS_DUN_Chandelier_C_016_73e8940a-b4ab-472e-a1f1-d4d2125bbe6b, LTS_DUN_Chandelier_Hinge_A_021_cc8d9f36-099d-4f3c-8c5c-adcb7f432d2c);
		DB_GLO_FireBowls(LTS_DUN_Chandelier_C_018_0e974fd4-8f9b-4b16-8127-dd1ee8fd2e80, LTS_DUN_Chandelier_Hinge_A_023_dd53b605-9734-49c2-86cd-6a3be57f736f);
		DB_GLO_FireBowls(LTS_DUN_Chandelier_C_019_4aecc15b-2313-43cb-b210-456e1343108d, LTS_DUN_Chandelier_Hinge_A_024_a98dba6b-9194-489f-9d8f-b25934e21864);
		DB_GLO_FireBowls(LTS_DUN_Hanging_Bowls_B_Gold_Purple_1aaba91c-c303-49e7-ade7-6b47152ceec8, LTS_DUN_Hanging_Bowls_Hinge_A_Gold_33c995a0-8bee-4dec-824f-f159a5fd4a22);
		
	}
	KB
	{
	}
	EXIT
	{
	}
}
Goal(312).Title("Act1b_OriginMoments_Laezel");
Goal(312)
{
	INIT
	{
		//REGION Chain of Command OM
		DB_Origins_BlockTransferReasons("SpokeToVlaakith_LaezelAtPlanecaster");
		DB_Origins_BlockTransferReasons("TurnedHostileDuringInquisitor");
		
		TriggerRegisterForCharacter((TRIGGER)S_CRE_GithMarkingsArea_c80368e0-8165-4738-837c-30ea37d62c11, (CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		TriggerRegisterForCharacter((TRIGGER)S_CRE_GithMarkingsAreaSCLSide_67e9624c-91ea-40fb-9f62-f1f5136f14fd, (CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		TriggerRegisterForCharacter((TRIGGER)S_CRE_SecurityOfficeLaezelLeaveArea_7b8493ab-9413-4330-9aa8-24b752a79980, (CHARACTER)S_Player_Laezel_58a69333-40bf-8358-1d17-fff240d7fb12);
		
