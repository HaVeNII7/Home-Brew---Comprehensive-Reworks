		AND
		NOT DB_GlobalFlag((FLAG)ORI_Gale_Knows_ReadKarsusNotes_2b0e541f-f49e-7e82-27d6-15fccd6ff1ff)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Gale_State_KarsusNotesResolved_db5a6b70-d9b0-4470-8b7d-b08a52c1f905)
		AND
