		AND
		HasAppliedStatusWithGroup(_Speaker, "SG_DropForNonMutingDialog", 1)
		THEN
		DB_BUGFIX_Marker("GUS-303232");
		PROC_DialogStart_WaitingForDroppedMutingStatus_FallbackTimer(_Dialog, _Speaker);
		
		//END_REGION
		
