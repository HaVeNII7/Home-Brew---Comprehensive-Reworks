		AND
		NOT DB_GlobalFlag((FLAG)GLO_Volo_Knows_Lobotomy_6f016a74-c28b-4a6a-919e-b58223cc14cb)
		THEN
		TemplateAddTo((ITEMROOT)DEN_VoloOperation_ErsatzEye_000cfc9f-b973-48e7-a5c8-f2992a47a943,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,1);
		
		//REGION Volo ersatz eye material override debug
		IF
		TextEvent("CAMP_VOLO_ERSATZEYE_Test")
		AND
		GetTextEventParamUUID(1,_UUID)
		THEN
		AddCustomMaterialOverride(_UUID, "dc46662a-d909-4df5-ad12-50a524150aff");
		//END_REGION
	}
	EXIT
	{
	}
}
