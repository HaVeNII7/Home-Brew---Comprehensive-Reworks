Goal(475)
{
	INIT
	{
		DB_ItemDialog_NarratorAD((ITEM)S_TWN_Tollhouse_ConfiscatedItemsPlaque_4b6bc019-30ba-4c1b-9d16-78f52af5ff77, (DIALOGRESOURCE)TWN_Tollhouse_AD_ConfiscatedItemsPlaque_431ec44c-52d6-a5bb-0eeb-647a927bbed9);
