		DB_IgnoreMutingStatussesDialog((DIALOGRESOURCE)DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea);
	}
	KB
	{
		//REGION Teleport places
		IF
		FlagSet((FLAG)_Flag, _Player, _) // flagType: Object
		AND
		DB_Debug_TeleportFlags((FLAG)_Flag, (TRIGGER)_Trigger)
		THEN
		ClearFlag((FLAG)_Flag, _Player, 0); // flagType: Object
		PROC_TeleportPartiesTo(_Trigger, "");
		
		//END_REGION Teleport places
		
		//REGION Block tags
		IF
		FlagSet(_Flag,_Entity,_)
		AND
		DB_Debug_BlockTagFlag(_Tag,_Flag)
		THEN
		Debug_BlockTag(_Entity,_Tag,1);
		
		IF
		FlagCleared(_Flag,_Entity,_)
		AND
		DB_Debug_BlockTagFlag(_Tag,_Flag)
		THEN
		Debug_BlockTag(_Entity,_Tag,0);
		//END_REGION Block tags
		
		//REGION Debugbook
		PROC
		PROC_Debug_GiveDebugBook()
		AND
		GetHostCharacter(_Character)
		AND
		NOT GetItemByTemplateInPartyInventory(S_DebugBook_31ee023c-d151-40f6-917e-84066772783b, _Character,_)
		THEN
		TemplateAddTo(S_DebugBook_31ee023c-d151-40f6-917e-84066772783b, _Character, 1, 0);
		
		IF
		TemplateUseFinished(_Player, S_DebugBook_31ee023c-d151-40f6-917e-84066772783b, _, 1)
		AND
		QRY_StartDialogCustom_Fixed((DIALOGRESOURCE)DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea, _Player,0,0,0,0)
		THEN
		DB_NOOP(1);
		
		IF
		TemplateAddedTo((ITEMROOT)S_DebugBook_31ee023c-d151-40f6-917e-84066772783b,(ITEM)_DebugBook,_Player, _)
		AND
		DB_Players((CHARACTER)_Player)
		THEN
		SetHotbarItem(_Player,_DebugBook);
		
		IF
		TextEvent("debugbook")
		AND
		GetHostCharacter(_Player)
		AND
		DB_Players(_Player)
		AND
		QRY_StartDialogCustom_Fixed((DIALOGRESOURCE)DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea, _Player,0,0,0,0)
		THEN
		DB_NOOP(1);
		
		//END_REGION
		
		//REGION Long Rests
		IF
		FlagSet(Debug_LongRest_3fc599d8-c8c7-1fa6-c832-4802573720e4, _Player, _) // flagType: Object
		THEN
		PROC_ForceStopDialog((CHARACTER)_Player);
		ClearFlag(Debug_LongRest_3fc599d8-c8c7-1fa6-c832-4802573720e4, _Player, 0);
		PROC_Camp_InstantLongRest();
		
		IF
		FlagSet(Debug_10LongRest_2d0e6b61-dd6d-187b-df86-93d7953958b2, _Player, _) // flagType: Object
		THEN
		PROC_ForceStopDialog((CHARACTER)_Player);
		ClearFlag(Debug_10LongRest_2d0e6b61-dd6d-187b-df86-93d7953958b2, _Player, 0);
		PROC_Camp_InstantLongRest();
		
		IF
		FlagSet(Debug_10LongRest_2d0e6b61-dd6d-187b-df86-93d7953958b2, _Player, _) // flagType: Object
		AND
		QRY_DoNTimes(9)
		AND
		DB_QRY_RTN_DoNTimes(_I)
		THEN
		PROC_LongRest();
		//END_REGION
		
		//REGION General functions 
		IF
		FlagSet(Debug_Add1000Gold_7627d386-2bd6-7ea0-b718-ca93249e6194, (CHARACTER)_Player, _) // flagType: Object
		THEN
		ClearFlag((FLAG)Debug_Add1000Gold_7627d386-2bd6-7ea0-b718-ca93249e6194, _Player); // flagType: Object
		AddGold(_Player, 1000);
		
		IF
		FlagSet(Debug_GodMode_On_0f27d940-9daf-0627-aee0-8887660acd1b, _, _) // flagType: Object
		AND
		DB_Players(_Player)
		THEN
		ClearFlag((FLAG)Debug_GodMode_On_0f27d940-9daf-0627-aee0-8887660acd1b, _Player); // flagType: Object
		SetImmortal(_Player, 1);
		PROC_SetInvulnerable(_Player, 1);
		
		IF
		FlagSet(Debug_GodMode_Off_b3796d17-1fe7-5b61-4b07-16bebe064857, _, _) // flagType: Object
		AND
		DB_Players(_Player)
		THEN
		ClearFlag((FLAG)Debug_GodMode_Off_b3796d17-1fe7-5b61-4b07-16bebe064857, _Player); // flagType: Object
		SetImmortal(_Player, 0);
		PROC_SetInvulnerable(_Player, 0);
		
		IF
		FlagSet(Debug_AddThievesTools_0c8206a7-4720-6c1d-24df-60d46363b9ef, (CHARACTER)_Player, _)
		THEN
		ClearFlag(Debug_AddThievesTools_0c8206a7-4720-6c1d-24df-60d46363b9ef, _Player);
		TemplateAddTo((ITEMROOT)TOOL_GEN_ThievesTools_A_Closed_A_08851ac0-3bfa-44f3-80c6-6ab0536f0e10, _Player, 1, 1);
		
		
		//END_REGION
		
		//REGION Party members
		IF
		DialogStarted(DIALOGRESOURCEGUID_DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea, _)
		AND
		DB_Debug_CharacterAddFlags((FLAG)_, _,(FLAG)_GlobalFlag)
		THEN
		ClearFlag((FLAG)_GlobalFlag, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		
		IF
		DialogStarted(DIALOGRESOURCEGUID_DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea, _)
		AND
		DB_Debug_CharacterAddFlags((FLAG)_, _Origin,(FLAG)_GlobalFlag)
		AND
		DB_Players(_Origin)
		THEN
		SetFlag((FLAG)_GlobalFlag, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		
		IF
		FlagSet((FLAG)_Flag, (CHARACTER)_Character, _) // flagType: Object
		AND
		DB_Debug_CharacterAddFlags((FLAG)_Flag, _Origin,(FLAG)_)
		AND
		NOT DB_Players(_Origin)
		THEN
		SetOnStage(_Origin,1);
		TeleportTo(_Origin, _Character,"Debug_CharacterAdd_Teleported",1,0,1,0,1);
		PROC_GLO_PartyMembers_Add(_Origin, _Character);
		SetFlag((FLAG)SetPreset_Default_7eabc516-c15c-46ff-a99d-60d4a9f7037e, _Origin, 0); // flagType: Object
		
		IF
		FlagSet((FLAG)_Flag, _Character, _) // flagType: Object
		AND
		DB_Debug_CharacterAddFlags((FLAG)_Flag, _,(FLAG)_)
		THEN
		ClearFlag((FLAG)_Flag, _Character); // flagType: Object
		
		IF
		FlagSet(Debug_AddGith_39ecbda9-cb44-becf-57b9-c3b631a5517b, _Player, _) // flagType: Object
		THEN
		PROC_CHA_LaezelRecruit_InitPlayer(0); 
		
		IF
		FlagSet((FLAG)_Flag, (CHARACTER)_Character, _) // flagType: Object
		AND
		DB_Debug_CharacterRemoveHideFlags((FLAG)_Flag, _Origin)
		AND
		DB_Debug_CharacterAddFlags(_AddFlag, _Origin, _OriginIsPlayerFlag)
		AND
		DB_Players(_Origin)
		AND
		NOT DB_Avatars(_Origin)
		THEN
		PROC_GLO_PartyMembers_Remove(_Origin, 1);
		ClearFlag(_OriginIsPlayerFlag, NULL_00000000-0000-0000-0000-000000000000);
		SetOnStage(_Origin,0);
		
		IF
		FlagSet((FLAG)_Flag, _Character, _) // flagType: Object
		AND
		DB_Debug_CharacterRemoveHideFlags((FLAG)_Flag, _)
		THEN
		ClearFlag((FLAG)_Flag, _Character); // flagType: Object
		
		//Sound
		IF
		DialogStarted(DIALOGRESOURCEGUID_DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea, _Inst)
		AND
		DB_DialogPlayers(_Inst,_Player,_)
		THEN
		PlayHUDSound((CHARACTER)_Player,"Engine_DebugBook_Open");
		
		IF
		DialogEnded(DIALOGRESOURCEGUID_DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea, _Inst)
		AND
		DB_DialogPlayers(_Inst,_Player,_)
		THEN
		PlayHUDSound((CHARACTER)_Player,"Engine_DebugBook_Close");
		//END_REGION
		
		//REGION Flag through console
		IF
		TextEvent("charflag")
		AND
		GetTextEventParamUUID(1,_Flag)
		AND
		GetHostCharacter(_Player)
		THEN
		SetFlag((FLAG)_Flag, _Player); // flagType: Object
		
		IF
		TextEvent("userflag")
		AND
		GetTextEventParamUUID(1,_Flag)
		AND
		GetHostCharacter(_Player)
		THEN
		SetFlag((FLAG)_Flag, _Player); // flagType: User
		
		IF
		TextEvent("partyflag")
		AND
		GetTextEventParamUUID(1,_Flag)
		AND
		GetHostCharacter(_Player)
		THEN
		SetFlag((FLAG)_Flag, _Player); // flagType: Party
		
		IF
		TextEvent("globalflag")
		AND
		GetTextEventParamUUID(1,_Flag)
		THEN
		SetFlag((FLAG)_Flag, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		
		IF
		TextEvent("ccharflag")
		AND
		GetTextEventParamUUID(1,_Flag)
		AND
		GetHostCharacter(_Player)
		THEN
		ClearFlag((FLAG)_Flag, _Player); // flagType: Object
		
		IF
		TextEvent("cuserflag")
		AND
		GetTextEventParamUUID(1,_Flag)
		AND
		GetHostCharacter(_Player)
		THEN
		ClearFlag((FLAG)_Flag, _Player, 0); // flagType: User
		
		IF
		TextEvent("cpartyflag")
		AND
		GetTextEventParamUUID(1,_Flag)
		AND
		GetHostCharacter(_Player)
		THEN
		ClearFlag((FLAG)_Flag, _Player, 0); // flagType: Party
		
		IF
		TextEvent("cglobalflag")
		AND
		GetTextEventParamUUID(1,_Flag)
		THEN
		ClearFlag((FLAG)_Flag, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		//END_REGION
		
		//REGION Skillcheck Cheats
		IF
		FlagSet(Debug_SkillWin_9369ef31-cb50-1888-6f8e-bc247f73307c, _, _) // flagType: Global
		THEN
		ClearFlag((FLAG)Debug_SkillWin_9369ef31-cb50-1888-6f8e-bc247f73307c, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		DebugDialogSkillCheck(1);
		
		IF
		FlagSet(Debug_SkillLose_91660706-f0d8-4073-6aa0-f1603614fa86, _, _) // flagType: Global
		THEN
		ClearFlag((FLAG)Debug_SkillLose_91660706-f0d8-4073-6aa0-f1603614fa86, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		DebugDialogSkillCheck(-1);
		
		IF
		FlagSet(Debug_SkillNormal_b4ae105d-c752-642c-7064-c1b8931c71b6, _, _) // flagType: Global
		THEN
		ClearFlag((FLAG)Debug_SkillNormal_b4ae105d-c752-642c-7064-c1b8931c71b6, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		DebugDialogSkillCheck(0);
		//END_REGION
		
		//REGION Adding spells
		IF
		FlagSet((FLAG)_Flag, _Player, _ID) // flagType: Object
		AND
		DB_Debug_SpellAddFlags((FLAG)_Flag, _Spell)
		THEN
		ClearFlag((FLAG)_Flag, _Player, _ID); // flagType: Object
		AddSpell((CHARACTER)_Player, _Spell, 1);
		//END_REGION
		
		//REGION Applying statuses
		IF
		FlagSet((FLAG)_Flag, _Player, _ID) // flagType: Object
		AND
		DB_Debug_ApplyStatus((FLAG)_Flag, _Status)
		THEN
		ClearFlag((FLAG)_Flag, _Player, _ID); // flagType: Object
		ApplyStatus((CHARACTER)_Player, _Status, -1.0, 1, NULL_00000000-0000-0000-0000-000000000000);
		//END_REGION Applying statuses
		
		//REGION Companion Avatar Cheatery
		IF
		FlagSet(Debug_BecomeAvatar_34371b8e-a34b-3354-54e7-fcda800d703a, (CHARACTER)_Companion, _) // flagType: Object
		AND
		NOT DB_Avatars(_Companion)
		AND
		GetFaction(_Companion,_PlayerFaction)
		THEN
		DB_GLO_PartyMembers_DefaultFaction(_Companion,_PlayerFaction);
		ClearFlag((FLAG)ORI_State_Recruited_e78c0aab-fb48-98e9-3ed9-773a0c39988d, _Companion);
		PROC_RemoveDialog(_Companion);
		SetTag(_Companion,(TAG)AVATAR_306b9b05-1057-4770-aa17-01af21acd650);
		
		IF
		FlagSet(Debug_BecomeAvatar_34371b8e-a34b-3354-54e7-fcda800d703a, (CHARACTER)_Companion, _) // flagType: Object
		THEN
		ClearFlag(Debug_BecomeAvatar_34371b8e-a34b-3354-54e7-fcda800d703a,(CHARACTER)_Companion,0);
		
		IF
		FlagSet(Debug_BecomeCompanion_4670c626-a52f-aeed-c18a-dc8d9c78b7cb, (CHARACTER)_Avatar, _) // flagType: Object
		AND
		SysCount("DB_Avatars",1,_Count)
		AND
		_Count < 2
		THEN
		DebugText(_Avatar,"NEED AT LEAST ONE OTHER AVATAR TO BECOME A COMPANION");
		
		IF
		FlagSet(Debug_BecomeCompanion_4670c626-a52f-aeed-c18a-dc8d9c78b7cb, (CHARACTER)_Avatar, _) // flagType: Object
		AND
		DB_OriginNPCAlignment(_Avatar,_Faction)
		THEN
		DB_GLO_PartyMembers_DefaultFaction(_Avatar,_Faction);
		ClearTag(_Avatar,(TAG)AVATAR_306b9b05-1057-4770-aa17-01af21acd650);
		PROC_GLO_PartyMembers_Add(_Avatar,_Avatar);
		
		IF
		FlagSet(Debug_BecomeCompanion_4670c626-a52f-aeed-c18a-dc8d9c78b7cb, (CHARACTER)_Avatar, _) // flagType: Object
		THEN
		ClearFlag(Debug_BecomeCompanion_4670c626-a52f-aeed-c18a-dc8d9c78b7cb,_Avatar,0);
		
		//END_REGION
		
		//REGION Tags - Origin
		
		//--- Origins
		//Setting
		IF
		FlagSet(Debug_SetAllTags_Origins_3cde4737-618d-07ae-b846-3d020593fb60, _Char, _) // flagType: Object
		AND
		DB_OriginTagsAppearance(_, _Tag)
		AND
		IsTagged(_Char, _Tag, 0)
		THEN
		SetTag(_Char, _Tag);
		
		
		IF
		FlagSet((FLAG)Debug_SetAllTags_ReallyOrigins_227ba3e7-70b5-3de4-5b1d-add6a3f47101, _Char, _) // flagType: Object
		AND
		DB_OriginReallyTags(_, _ReallyTag)
		AND
		IsTagged(_Char, _ReallyTag, 0)
		THEN
		SetTag(_Char, _ReallyTag);
		
		
		IF
		FlagSet(Debug_SetAllTags_Origins_3cde4737-618d-07ae-b846-3d020593fb60, _Char, _) // flagType: Object
		THEN
		ClearFlag((FLAG)Debug_SetAllTags_Origins_3cde4737-618d-07ae-b846-3d020593fb60, _Char); // flagType: Object
		
		IF
		FlagSet(Debug_SetAllTags_ReallyOrigins_227ba3e7-70b5-3de4-5b1d-add6a3f47101, _Char, _) // flagType: Object
		THEN
		ClearFlag(Debug_SetAllTags_ReallyOrigins_227ba3e7-70b5-3de4-5b1d-add6a3f47101, _Char); // flagType: Object
		
		
		// Keeping TAG and REALLY_TAG in sync
		IF
		TagSet(_Char, _Tag)
		AND
		DB_OriginTagsAppearance(_Origin, _Tag)
		AND
		DB_OriginReallyTags(_Origin, _ReallyTag)
		AND
		DB_DialogPlayers(_Inst, _Char, _)
		AND
		DB_DialogName(DIALOGRESOURCEGUID_DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea, _Inst)
		AND
		GetFlag(Debug_SetReallyTagsToo_9d5e2c9d-a88c-227a-169b-48cc8f410bbc, _Char, 1)
		THEN
		SetTag(_Char, _ReallyTag);
		
		IF
		TagSet(_Char, (TAG)GENERIC_730e82f3-c067-44a4-985b-0dfe079d4fea)
		AND
		DB_DialogPlayers(_Inst, _Char, _)
		AND
		DB_DialogName(DIALOGRESOURCEGUID_DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea, _Inst)
		AND
		GetFlag(Debug_SetReallyTagsToo_9d5e2c9d-a88c-227a-169b-48cc8f410bbc, _Char, 1)
		THEN
		SetTag(_Char, (TAG)REALLY_GENERIC_264a6880-9a51-429c-a9fc-97f8952baf90);
		
		
		//Clearing
		IF
		FlagSet(Debug_ClearAllTags_Origins_aece0b35-4276-5e8d-3ec3-2f0eae8048b7, _Char, _) // flagType: Object
		AND
		DB_OriginTagsAppearance(_, _Tag)
		THEN
		ClearTag(_Char, _Tag);
		
		IF
		FlagSet(Debug_ClearAllTags_Origins_aece0b35-4276-5e8d-3ec3-2f0eae8048b7, _Char, _) // flagType: Object
		AND
		DB_OriginReallyTags(_, _ReallyTag)
		THEN
		ClearTag(_Char, _ReallyTag);
		
		IF
		FlagSet(Debug_ClearAllTags_Origins_aece0b35-4276-5e8d-3ec3-2f0eae8048b7, _Char, _) // flagType: Object
		THEN
		ClearFlag((FLAG)Debug_ClearAllTags_Origins_aece0b35-4276-5e8d-3ec3-2f0eae8048b7, _Char); // flagType: Object
		
		//END_REGION
		//REGION Tags - Background
		
		//Clearing
		IF
		FlagSet(Debug_ClearAllTags_Background_d84d4e7a-b838-c611-4a8d-016140d3aa44, _Char, _) // flagType: Object
		AND
		DB_BackgroundTags(_Tag)
		AND
		IsTagged(_Char, _Tag, 1)
		THEN
		ClearTag(_Char, _Tag);
		
		IF
		FlagSet(Debug_ClearAllTags_Background_d84d4e7a-b838-c611-4a8d-016140d3aa44, _Char, _) // flagType: Object
		THEN
		ClearFlag((FLAG)Debug_ClearAllTags_Background_d84d4e7a-b838-c611-4a8d-016140d3aa44, _Char); // flagType: Object
		
		//END_REGION
		//REGION Tags - Race
		
		//Setting all
		IF
		FlagSet(Debug_SetAllTags_Race_1cb166bb-918d-8c30-e33d-f93d43ab8963, _Char, _) // flagType: Object
		AND
		DB_RaceTags(_Tag, _)
		AND
		IsTagged(_Char, _Tag, 0)
		THEN
		SetTag(_Char, _Tag);
		
		IF
		FlagSet(Debug_SetAllTags_Race_1cb166bb-918d-8c30-e33d-f93d43ab8963, _Char, _) // flagType: Object
		THEN
		ClearFlag((FLAG)Debug_SetAllTags_Race_1cb166bb-918d-8c30-e33d-f93d43ab8963, _Char); // flagType: Object
		
		
		//Setting all REALLY_
		IF
		FlagSet(Debug_SetAllTags_ReallyRace_79785ace-7cba-069a-4839-e9ff171b7af6, _Char, _) // flagType: Object
		AND
		DB_RaceTags(_, _ReallyTag)
		AND
		IsTagged(_Char, _ReallyTag, 0)
		THEN
		SetTag(_Char, _ReallyTag);
		
		IF
		FlagSet(Debug_SetAllTags_ReallyRace_79785ace-7cba-069a-4839-e9ff171b7af6, _Char, _) // flagType: Object
		THEN
		ClearFlag(Debug_SetAllTags_ReallyRace_79785ace-7cba-069a-4839-e9ff171b7af6, _Char); // flagType: Object
		
		
		// Keeping TAG and REALLY_TAG in sync
		IF
		TagSet(_Char, _Tag)
		AND
		DB_OriginTagsAppearance(_Origin, _Tag)
		AND
		DB_OriginReallyTags(_Origin, _ReallyTag)
		AND
		DB_DialogPlayers(_Inst, _Char, _)
		AND
		DB_DialogName(DIALOGRESOURCEGUID_DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea, _Inst)
		AND
		GetFlag(Debug_SetReallyTagsToo_9d5e2c9d-a88c-227a-169b-48cc8f410bbc, _Char, 1)
		AND
		IsTagged(_Char, _ReallyTag, 0)
		THEN
		SetTag(_Char, _ReallyTag);
		
		IF
		TagSet(_Char, _Tag)
		AND
		DB_RaceTags(_Tag, _ReallyTag)
		AND
		DB_DialogPlayers(_Inst, _Char, _)
		AND
		DB_DialogName(DIALOGRESOURCEGUID_DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea, _Inst)
		AND
		GetFlag(Debug_SetReallyTagsToo_9d5e2c9d-a88c-227a-169b-48cc8f410bbc, _Char, 1)
		AND
		IsTagged(_Char, _ReallyTag, 0)
		THEN
		SetTag(_Char, _ReallyTag);
		
		
		//Clearing
		IF
		FlagSet(Debug_ClearAllTags_Race_0b3f5dec-ef77-66de-828c-2b6f9f1b38b9, _Char, _) // flagType: Object
		AND
		DB_RaceTags(_Tag, _ReallyTag)
		THEN
		ClearTag(_Char, _Tag);
		ClearTag(_Char, _ReallyTag);
		
		IF
		FlagSet(Debug_ClearAllTags_Race_0b3f5dec-ef77-66de-828c-2b6f9f1b38b9, _Char, _) // flagType: Object
		THEN
		ClearFlag((FLAG)Debug_ClearAllTags_Race_0b3f5dec-ef77-66de-828c-2b6f9f1b38b9, _Char); // flagType: Object
		
		//END_REGION
		//REGION Tags - Classe
		//nothing yet.
		//END_REGION
		
		//REGION Raiding Party DEBUG End Fast Forward
		
		IF
		FlagSet(DEN_RaidingParty_Debug_ResolveConfrontation_FF_7409f4f0-19b1-4a84-f793-e32266bcce9d, _Player, _) // flagType: Object
		THEN
		SetFlag((FLAG)DEN_RaidingParty_State_PeacefulResolution_f4529d52-b459-6545-b4bf-8b2fb2cd6f2f, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		SetFlag((FLAG)DEN_RaidingParty_Debug_ResolveConfrontation_cd991e7d-f05f-ddfe-d159-b4d80bf8075d, _Player, 0); // flagType: Object
		TimerLaunch("DEN_General_AfterRaidingPartyDebugTeleport", 7500);
		
		IF
		TimerFinished("DEN_General_AfterRaidingPartyDebugTeleport")
		THEN
		TeleportTo(S_DEN_AdventurerLeader_82d1b843-9e8c-48a5-9d87-caddea5c193c, S_DEN_AdventurerArea_001_902982c7-079a-4c5d-be65-2ce3fb8e725d, "", 0,0,0);
		TeleportTo(S_DEN_RobbedAdventurer_534bceaf-678c-40a0-8ca9-e1134f95ba0d, S_DEN_AdventurerArea_003_5fdf3e6c-bb21-48e2-8768-00767edc89da, "", 0,0,0);
		TeleportTo(S_DEN_Trainer_02025646-347a-4235-aef7-e46b7c94b435, S_DEN_TrainerPoint_8b56581e-8e85-41ac-a32e-dcecffaa7fa5, "", 0,0,0);
		TeleportTo(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d, (TRIGGER)S_DEN_WyllRecruitPoint_3a3551e1-f5eb-49d7-b46c-c29b60ee470d, "", 0,0,0);
		TeleportTo(S_DEN_GrieflingFriend_c3334ee5-38dc-4197-aacc-4aa55803ff52, S_DEN_AvengeFriendPoint_c9016542-c6ce-484c-a837-23241555589d, "", 0,0,0);
		TeleportTo(S_DEN_Griefling_7ce0afc2-e8f2-4f2e-82d8-27df98acc3d8, S_DEN_AvengePoint_3ac11305-c3f9-4653-8308-5c02d38a9b1d, "", 0,0,0);
		TeleportTo(S_DEN_Tiefling_010_23129d6c-8d39-4a4c-a4f6-cfc6637b597c, S_DEN_BadWizardGuardFriendPos_a36ad802-aaf5-4249-b12a-9e2b42a6e85d, "", 0,0,0);
		
		//END_REGION
		
		//REGION Shar puzzle
		IF
		FlagSet(Debug_GOB_TempleAccess_DebugSolve_1ded7447-57ac-545d-c4c2-0ea3d2c56790, _, _) // flagType: Global
		THEN
		ClearFlag((FLAG)Debug_GOB_TempleAccess_DebugSolve_1ded7447-57ac-545d-c4c2-0ea3d2c56790, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		PROC_GOB_TempleAccess_DebugSolve();
		
		//END_REGION
		
		//REGION Speak with Dead Clear
		
		IF
		TextEvent("Debug_SWD_LimitReached")
		THEN
		DB_Debug_SWD_LimitEnabled(1);
		
		IF
		TextEvent("Debug_SWD_LimitClear")
		THEN
		NOT DB_Debug_SWD_LimitEnabled(1);
		
		IF
		UsingSpellOnTarget(_, _Corpse, "Target_SpeakWithDead_Test", _, _, _)
		AND
		DB_Debug_SWD_LimitEnabled(1)
		THEN
		SetFlag((FLAG)GLO_SpeakWithDead_State_QuestionsLimitReached_01c40268-4a8d-4787-8566-77e01ff04762, _Corpse);
		
		IF
		UsingSpellOnTarget(_, _Corpse, "Target_SpeakWithDead_Test", _, _, _)
		AND
		NOT DB_Debug_SWD_LimitEnabled(1)
		THEN
		ClearFlag((FLAG)GLO_SpeakWithDead_State_QuestionsLimitReached_01c40268-4a8d-4787-8566-77e01ff04762, _Corpse);
		
		//END_REGION
		
		//REGION Camp Debug
		IF
		FlagSet((FLAG)Debug_CAMP_GotoNight1_4a20172a-0ff4-b6bd-a19b-364f40d7b6b6,NULL_00000000-0000-0000-0000-000000000000,_)
		THEN
		ClearFlag((FLAG)Debug_CAMP_GotoNight1_4a20172a-0ff4-b6bd-a19b-364f40d7b6b6,NULL_00000000-0000-0000-0000-000000000000,0);
		
		IF
		FlagSet((FLAG)Debug_CAMP_GotoNight2_f51a143a-c692-236c-631c-10e82b8ca723,NULL_00000000-0000-0000-0000-000000000000,_)
		THEN
		ClearFlag((FLAG)Debug_CAMP_GotoNight2_f51a143a-c692-236c-631c-10e82b8ca723,NULL_00000000-0000-0000-0000-000000000000,0);
		
		IF
		FlagSet((FLAG)Debug_CAMP_GotoNight3_bd19d762-19a5-ce3c-4995-345f97468723,NULL_00000000-0000-0000-0000-000000000000,_)
		THEN
		ClearFlag((FLAG)Debug_CAMP_GotoNight3_bd19d762-19a5-ce3c-4995-345f97468723,NULL_00000000-0000-0000-0000-000000000000,0);
		
		IF
		FlagSet((FLAG)Debug_CAMP_GotoNight4_01da48ec-a173-a600-3b11-283fd80a8cbb,NULL_00000000-0000-0000-0000-000000000000,_)
		THEN
		ClearFlag((FLAG)Debug_CAMP_GotoNight4_01da48ec-a173-a600-3b11-283fd80a8cbb,NULL_00000000-0000-0000-0000-000000000000,0);
		
		IF
		FlagSet((FLAG)Debug_CAMP_GotoNight4b_ff3ecb0c-3482-eaaa-7cf6-76def3bc6919,NULL_00000000-0000-0000-0000-000000000000,_)
		THEN
		ClearFlag((FLAG)Debug_CAMP_GotoNight4b_ff3ecb0c-3482-eaaa-7cf6-76def3bc6919,NULL_00000000-0000-0000-0000-000000000000,0);
		
		IF
		FlagSet((FLAG)Debug_CAMP_GotoNight5_469d499f-e29e-8e64-e43d-0131cf977214,NULL_00000000-0000-0000-0000-000000000000,_)
		THEN
		ClearFlag((FLAG)Debug_CAMP_GotoNight5_469d499f-e29e-8e64-e43d-0131cf977214,NULL_00000000-0000-0000-0000-000000000000,0);
		//END_REGION
		
		//REGION Kick generic
		IF
		TextEvent("KickGeneric")
		THEN
		PROC_KickGenericPlayer();
		PROC
		PROC_KickGenericPlayer()
		AND
		DB_Players(_Player)
		AND
		IsTagged(_Player,GENERIC_730e82f3-c067-44a4-985b-0dfe079d4fea,1)
		THEN
		NOT DB_Avatars(_Player);
		MakeNPC(_Player);
		SetOnStage(_Player,0);
		
		//END_REGION Kick generic
		
		//REGION UND_TeaserTrailer
		PROC
		PROC_UND_TeaserTrailer_AddPlayer((CHARACTER)_Char,(CHARACTER)_Player)
		AND
		NOT DB_Players(_Char)
		THEN
		DB_Players(_Char);
		MakePlayer(_Char,_Player);
		PROC_AssignCharacterToPlayer(_Char,_Player);
		AttachToPartyGroup(_Char,_Player);
		
		IF
		TextEvent("und_teasertrailer")
		AND
		GetHostCharacter(_Player)
		AND
		_Player != S_UND_TeaserTrailer_Drow_ebc4cc51-6140-4ff7-9a12-af5b3c75a407
		THEN
		PROC_UND_TeaserTrailer_AddPlayer(S_UND_TeaserTrailer_Drow_ebc4cc51-6140-4ff7-9a12-af5b3c75a407,_Player);
		SetTag(S_UND_TeaserTrailer_Drow_ebc4cc51-6140-4ff7-9a12-af5b3c75a407,AVATAR_306b9b05-1057-4770-aa17-01af21acd650);
		PROC_UND_TeaserTrailer_AddPlayer(S_UND_TeaserTrailer_Halfling_63949406-0bc5-4efe-a023-19a0a485901b,S_UND_TeaserTrailer_Drow_ebc4cc51-6140-4ff7-9a12-af5b3c75a407);
		PROC_UND_TeaserTrailer_AddPlayer(S_UND_TeaserTrailer_Human_82f20a8e-3120-4098-b119-0c1324876796,S_UND_TeaserTrailer_Drow_ebc4cc51-6140-4ff7-9a12-af5b3c75a407);
		DB_UndTeaserHostChar(_Player);
		TimerLaunch("UND_Teaser_DelayParty",50);
		
		IF
		TimerFinished("UND_Teaser_DelayParty")
		AND
		DB_UndTeaserHostChar(_Player)
		THEN
		MakePlayerActive(S_UND_TeaserTrailer_Drow_ebc4cc51-6140-4ff7-9a12-af5b3c75a407);
		NOT DB_UndTeaserHostChar(_Player);
		PROC_GLO_PartyMembers_Remove(_Player,1);
		SetOnStage(_Player,0);
		PROC_KickGenericPlayer();
		
		IF
		TextEvent("und_teasertrailer")
		AND
		QRY_StartDialog_Fixed(UND_TeaserTrailer_d34c3212-a23b-be7b-9551-0ad984af0b08,S_UND_TeaserTrailer_Drow_ebc4cc51-6140-4ff7-9a12-af5b3c75a407,S_UND_TeaserTrailer_Halfling_63949406-0bc5-4efe-a023-19a0a485901b,S_UND_TeaserTrailer_Human_82f20a8e-3120-4098-b119-0c1324876796)
		THEN
		PROC_TeleportPartiesTo(S_UND_TeaserTrailer_Pos_e0b10777-3505-4f93-a98a-b4af0b1388a2,"");
		
		//END_REGION
		
		//REGION Dialog
		
		IF
		TextEvent("blockdialog")
		AND
		DB_Players(_Player)
		THEN
		DB_CantTalk(_Player);
		
		IF
		TextEvent("unblockdialog")
		AND
		DB_Players(_Player)
		THEN
		NOT DB_CantTalk(_Player);
		
		IF
		FlagSet((FLAG)DBG_DisableLowAttitudeDialogs_ac4bbd5f-fb8d-4a8b-8f7f-6875744e93a2,NULL_00000000-0000-0000-0000-000000000000,_)
		THEN
		DB_DBG_NoLowAttitudeDialogs(1);
		
		IF
		FlagCleared((FLAG)DBG_DisableLowAttitudeDialogs_ac4bbd5f-fb8d-4a8b-8f7f-6875744e93a2,NULL_00000000-0000-0000-0000-000000000000,_)
		THEN
		NOT DB_DBG_NoLowAttitudeDialogs(1);
		
		// If QRY_GetLowAttitudeDialog() doesn't return a result, no low attitude dialog will start.IF
		IF
		DB_QRY_RTN_GetLowAttitudeDialog(_Dialog)
		AND
		DB_DBG_NoLowAttitudeDialogs(1)
		THEN
		NOT DB_QRY_RTN_GetLowAttitudeDialog(_Dialog);
		//END_REGION
		
		//REGION IMPOSSIBLE tag and flag
		
		IF
		TextEvent("impossibleon")
		THEN
		SetFlag(Debug_Impossible_On_f8b5e77b-de41-4d36-b32e-83db5473615a, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		FlagSet(Debug_Impossible_On_f8b5e77b-de41-4d36-b32e-83db5473615a, _, _)
		THEN
		PROC_Debug_TurnImpossibleOn();
		
		IF
		TextEvent("impossibleoff")
		THEN
		ClearFlag(Debug_Impossible_On_f8b5e77b-de41-4d36-b32e-83db5473615a, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		FlagCleared(Debug_Impossible_On_f8b5e77b-de41-4d36-b32e-83db5473615a, _, _)
		THEN
		PROC_Debug_TurnImpossibleOff();
		
		PROC
		PROC_Debug_TurnImpossibleOn()
		THEN
		SetFlag((FLAG)IMPOSSIBLE_6e4b66e9-0f72-5171-04ba-441108b45b0e, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		PROC
		PROC_Debug_TurnImpossibleOn()
		AND
		DB_Players(_Player)
		THEN
		SetTag(_Player, (TAG)IMPOSSIBLE_699460d4-8196-4963-80ee-d80c4bf474d0);
		
		PROC
		PROC_Debug_TurnImpossibleOff()
		THEN
		ClearFlag((FLAG)IMPOSSIBLE_6e4b66e9-0f72-5171-04ba-441108b45b0e, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		PROC
		PROC_Debug_TurnImpossibleOff()
		AND
		DB_Players(_Player)
		THEN
		ClearTag(_Player, (TAG)IMPOSSIBLE_699460d4-8196-4963-80ee-d80c4bf474d0);
		
		
		//END_REGION
		
		//REGION Inspiration points
		IF
		FlagSet(Debug_AddInspiration_1_1b3926fd-7e50-4d48-9713-5984f33e5a7d,_Char,_)
		THEN
		GiveInspirationPoints((CHARACTER)_Char, 1.0, "", "");
		ClearFlag(Debug_AddInspiration_1_1b3926fd-7e50-4d48-9713-5984f33e5a7d,_Char);
		
		IF
		FlagSet(Debug_AddInspiration_2_182a8ec0-a440-4d0c-ae78-a1b801abb843,_Char,_)
		THEN
		GiveInspirationPoints((CHARACTER)_Char, 2.0, "", "");
		ClearFlag(Debug_AddInspiration_2_182a8ec0-a440-4d0c-ae78-a1b801abb843,_Char);
		
		IF
		FlagSet(Debug_AddInspiration_3_1ceffb8e-3f6e-43e5-99c6-635e01820235,_Char,_)
		THEN
		GiveInspirationPoints((CHARACTER)_Char, 3.0, "", "");
		ClearFlag(Debug_AddInspiration_3_1ceffb8e-3f6e-43e5-99c6-635e01820235,_Char);
		
		IF
		FlagSet(Debug_AddInspiration_4_2c09bd43-74e8-4396-aa23-593dc2bfd9ef,_Char,_)
		THEN
		GiveInspirationPoints((CHARACTER)_Char, 4.0, "", "");
		ClearFlag(Debug_AddInspiration_4_2c09bd43-74e8-4396-aa23-593dc2bfd9ef,_Char);
		//END_REGION Inspiration points
	}
	EXIT
	{
	}
}
