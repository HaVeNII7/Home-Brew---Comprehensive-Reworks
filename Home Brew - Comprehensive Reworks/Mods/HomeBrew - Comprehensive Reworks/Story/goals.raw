		DB_HAV_Misc_Meenlock((CHARACTER)S_HAV_Meenlock_02_cc6d55bb-f736-47ac-b3c7-65481b5ddef6);
		DB_HAV_Misc_Meenlock((CHARACTER)S_HAV_Meenlock_03_d4ab777e-9309-4a63-8599-79c7099ae8ad);
		DB_HAV_Misc_Meenlock((CHARACTER)S_HAV_Meenlock_04_4b0cd20d-4370-4792-9ffb-7ab7f8aaa9f1);
		DB_HAV_Misc_Meenlock((CHARACTER)S_HAV_Meenlock_05_ea62447e-0e36-4dc8-8942-52fc872de144);
		DB_HAV_Misc_Meenlock((CHARACTER)S_HAV_Meenlock_06_2ff33018-260a-4e06-8799-95449e005ffc);
		DB_HAV_Misc_Meenlock((CHARACTER)S_HAV_Meenlock_07_46dce4d3-50bd-4d45-893b-da628bbf19fd);
		
		DB_OneShot_VoiceBarkTrigger((TRIGGER)S_HAV_SeluneShrineBounds_acefbcff-295d-493f-bc32-64de526067f7, (VOICEBARKRESOURCE)HAV_Misc_VB_SeluneShrine_3402136a-0a08-812d-f761-770065f9a998);
		//END_REGION
		
		DB_TopicalGreeting((FLAG)TG_HAV_Misc_IsInHaven_f6e3f5a0-d553-41f2-9d6e-78cea503c992);
		DB_TopicalGreetingEndCondition_FlagSet((FLAG)TG_HAV_Misc_IsInHaven_f6e3f5a0-d553-41f2-9d6e-78cea503c992, (FLAG)HAV_Mood_State_Siege_b509af8b-a331-47ac-8230-3b8c5ef9956b);
		DB_TopicalGreetingEndCondition_FlagSet((FLAG)TG_HAV_Misc_IsInHaven_f6e3f5a0-d553-41f2-9d6e-78cea503c992, (FLAG)HAV_Mood_State_Unprotected_7ac5d939-2c81-4871-81a5-fd5c6a0adba1);
		DB_TopicalGreetingEndCondition_LeaveTrigger((FLAG)TG_HAV_Misc_IsInHaven_f6e3f5a0-d553-41f2-9d6e-78cea503c992, (TRIGGER)S_HAV_Haven_SUB_6ac001f4-9c56-4a1b-963d-a509e158ffab);
		
		DB_OneShotPlayerTrigger((TRIGGER)S_HAV_DaisyAD_Haven_cfd53d07-fd41-41e1-9313-20387cb9b1c2);
		
		DB_ItemDialog_NarratorAD((ITEM)S_HAV_Isobel_KethericBust_a0c16d51-8aa6-4b04-ab0b-617c428e6262,HAV_Isobel_AD_KethericBust_17d554e9-f90e-47bd-eca0-54524428d5fd);
		
		DB_GLO_DefeatCounter_AllPermaDefeatedGlobalFlag("HAV_Meelock_DefeatCounter",HAV_Misc_State_MeenlocksPermaDefeated_056f0eff-93f2-468a-94e6-fd8aacb54ce7);
	}
	KB
	{
		//REGION Flaming Fists
		
		IF
		DB_HAV_SavingPrisoners_FlamingFist(_NPC)
		THEN
		SetOnStage(_NPC, 0);
		
		PROC
		PROC_HAV_FlamingFists_Init()
		AND
		NOT DB_PermaDefeated((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9)
		AND
		DB_GlobalFlag((FLAG)PLA_Desire_State_Freed2_46dbc8ef-61fa-42c4-bc89-4a8f53d53e5b)
		THEN
		DB_HAV_FlorrickInHAV(1);
		RemoveStatus(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, "DIRT_COVERED_FULL", NULL_00000000-0000-0000-0000-000000000000);
		RemoveStatus(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, "SWEATY_LIGHT", NULL_00000000-0000-0000-0000-000000000000);
		TeleportTo(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, S_HAV_FlorrickPos_ab39d643-3ba1-41db-aafe-aca064be0e0c, "HAV_SavingPrisoners_FlorrickToHaven");
		PROC_GlobalSetFlagAndCache(HAV_HavenOutcasts_State_FlamingFistsInHaven_f8e5cd60-867a-4584-8c50-1ff917357acc);
		TeleportTo(S_HAV_HavenOutcasts_EntranceGuards_Caster_HighElf_825714dd-7df9-4cd1-aecb-edf577baa487, S_HAV_HavenOutcasts_Pos_EntranceGuards_Caster_HighElf_9570b9bb-43bd-4852-86aa-3b5c31fcd8dd, "");	//Move backup FF guard away from FF room.
		SetOnStage(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, 1);
		
		PROC
		PROC_HAV_FlamingFists_Init()
		AND
		NOT DB_PermaDefeated((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9)
		AND
		DB_GlobalFlag((FLAG)PLA_Desire_State_Freed2_46dbc8ef-61fa-42c4-bc89-4a8f53d53e5b)
		AND
		DB_HAV_SavingPrisoners_FlamingFist(_FlamingFist)
		THEN
		SetOnStage(_FlamingFist, 1);
		PROC_GlobalSetFlagAndCache((FLAG)HAV_CursedFist_State_CursedFistNotAlone_4d268b7e-76cd-4a54-9878-f86135b24ab8);
		
		IF
		EntityEvent(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, "HAV_SavingPrisoners_FlorrickToHaven")
		THEN
		ToInventory(S_HAV_DukeSupplies_edc4b3a4-f5a1-45ef-b254-c559548452af, S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, 1, 0, 1);
		DB_Dialogs((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, (DIALOGRESOURCE)HAV_Florrick_97692dad-7127-170b-00ce-9ee3a08b1df4);
		DB_HAV_SavingPrisoners_FlorrickAndManipScene(1);
		LookFromTrigger(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, S_HAV_FlorrickPos_ab39d643-3ba1-41db-aafe-aca064be0e0c, 1);
		
		PROC
		PROC_StateSet_PermaDefeated(S_HAV_AncientFist_MartCullagh_378938e2-2193-49a3-a06e-8e26cc128055)
		THEN
		NOT DB_HAV_SavingPrisoners_FlorrickAndManipScene(1);
		
		QRY
		QRY_SelectCustomDialog_AfterGenerics(_NPC, _Player)
		AND
		DB_HAV_SavingPrisoners_FlorrickAndManipScene(1)
		AND
		DB_HAV_SavingPrisoners_FlamingFistLeads((CHARACTER)_NPC)
		AND
		NOT DB_GlobalFlag(HAV_Mood_State_Siege_b509af8b-a331-47ac-8230-3b8c5ef9956b)
		AND
		DB_Dialogs((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, HAV_Florrick_97692dad-7127-170b-00ce-9ee3a08b1df4)
		THEN
		DB_SelectedDialog((DIALOGRESOURCE)HAV_Florrick_97692dad-7127-170b-00ce-9ee3a08b1df4, (CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _Player, (CHARACTER)S_HAV_Manip_0b8fdd17-7ce6-4038-9d9d-49f5ddbc20be);
		NOT DB_HAV_SavingPrisoners_FlorrickAndManipScene(1);
		
		IF
		DialogEnded((DIALOGRESOURCE)HAV_Florrick_97692dad-7127-170b-00ce-9ee3a08b1df4,_)
		THEN
		SetFlag(SCL_AncientFist_InitialDialogComplete_fac9d20d-2f55-425d-bdfb-2ad9e23a9b06,NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		FlagSet(HAV_SavingPrisoners_Event_ManipLeavesFlorrick_fb8f1924-d622-f0b8-1467-b1e879165141, _, _ID)
		AND
		DB_DialogNPCs(_ID, S_HAV_Manip_0b8fdd17-7ce6-4038-9d9d-49f5ddbc20be, _)
		AND
		DialogRemoveActorFromDialog(_ID, S_HAV_Manip_0b8fdd17-7ce6-4038-9d9d-49f5ddbc20be, _)
		THEN
		DB_NOOP(1);
		
		IF
		DB_GlobalFlag(HAV_SavingPrisoners_Event_ManipLeavesFlorrick_fb8f1924-d622-f0b8-1467-b1e879165141)
		AND
		NOT DB_DialogNPCs(_, S_HAV_Manip_0b8fdd17-7ce6-4038-9d9d-49f5ddbc20be, _)
		THEN
		NOT DB_HAV_SavingPrisoners_FlorrickAndManipScene(1);
		PROC_CharacterMoveTo(S_HAV_Manip_0b8fdd17-7ce6-4038-9d9d-49f5ddbc20be, S_HAV_VidorBarPos_738c4466-9e91-4b16-93f0-c22eac526c1c, "Stroll", "HAV_SavingPrisoners_VidorAtBar");
		
		//REGION Florrick leaves HAV to act 3
		
		IF
		FlagSet((FLAG)HAV_SavingPrisoners_HasMet_Florrick_890d4f79-e94f-a90a-c656-5c9ed49d0ec6,_,_)
		AND
		DB_HAV_FlorrickInHAV(1)
		AND
		NOT DB_GlobalFlag(HAV_Florrick_State_LeaveForCity_28f9ed3b-83e0-da1c-595d-2dcb8ffdafc4)
		THEN
		PROC_GlobalSetFlagAndCache(HAV_Florrick_State_LeaveForCity_28f9ed3b-83e0-da1c-595d-2dcb8ffdafc4);
		
		IF
		DB_GlobalFlag((FLAG)GLO_MoonriseTower_EverEnteredBefore_26aeabb0-7644-4897-9bbd-7a95e3e8930f)
		AND
		DB_HAV_FlorrickInHAV(1)
		AND
		NOT DB_GlobalFlag(HAV_Florrick_State_LeaveForCity_28f9ed3b-83e0-da1c-595d-2dcb8ffdafc4)
		THEN
		PROC_GlobalSetFlagAndCache(HAV_Florrick_State_LeaveForCity_28f9ed3b-83e0-da1c-595d-2dcb8ffdafc4);
		
		IF
		DB_GlobalFlag((FLAG)Act2_PointOfNoReturnReached_a3155f30-b8f3-4db5-ac21-d3036f4426e3)
		AND
		DB_HAV_FlorrickInHAV(1)
		AND
		NOT DB_GlobalFlag(HAV_Florrick_State_LeaveForCity_28f9ed3b-83e0-da1c-595d-2dcb8ffdafc4)
		THEN
		PROC_GlobalSetFlagAndCache(HAV_Florrick_State_LeaveForCity_28f9ed3b-83e0-da1c-595d-2dcb8ffdafc4);
		
		IF
		FlagSet(HAV_HavenOutcasts_State_FlamingFistsInHaven_f8e5cd60-867a-4584-8c50-1ff917357acc,_,_)
		AND
		IsActive(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9,0)
		THEN
		DB_HAV_FlorrickDeactivated(1);
		
		IF
		Activated(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9)
		AND
		DB_HAV_FlorrickDeactivated(1)
		THEN
		NOT DB_HAV_FlorrickDeactivated(1);
		
		IF
		Deactivated(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9)
		AND
		DB_GlobalFlag(HAV_HavenOutcasts_State_FlamingFistsInHaven_f8e5cd60-867a-4584-8c50-1ff917357acc)
		THEN
		DB_HAV_FlorrickDeactivated(1);
		
		IF
		DB_GlobalFlag(HAV_Florrick_State_LeaveForCity_28f9ed3b-83e0-da1c-595d-2dcb8ffdafc4)
		AND
		DB_HAV_FlorrickDeactivated(1)
		AND
		DB_HAV_FlorrickInHAV(1)
		AND
		NOT DB_HAV_AnyPartyMemberInHaven(1)
		AND
		NOT DB_Defeated(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9)
		THEN
		PROC_HAV_FlamingFistLeave();
		
		PROC
		PROC_HAV_FlamingFistLeave()
		THEN
		NOT DB_HAV_FlorrickInHAV(1); //needs to happen first or infinite loops will happen
		NOT DB_HAV_FlorrickDeactivated(1);
		DB_HAV_FlamingFistLeaveHaven((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9);
		DB_HAV_FlamingFistLeaveHaven((CHARACTER)S_HAV_FlamingFist_006_9629c27e-8e50-4258-8bda-6639af768ba6);
		DB_HAV_FlamingFistLeaveHaven((CHARACTER)S_HAV_Manip_0b8fdd17-7ce6-4038-9d9d-49f5ddbc20be);
		DB_HAV_FlamingFistLeaveHaven((CHARACTER)S_HAV_FlamingFist_001_47058367-9c0c-4756-a467-07b87b28e0d6);
		
		IF
		DB_HAV_FlamingFistLeaveHaven((CHARACTER)_Character)
		THEN
		PROC_Poof((CHARACTER)_Character);
		
		IF
		WentOnStage(_Character,0)
		AND
		DB_HAV_FlamingFistLeaveHaven((CHARACTER)_Character)
		THEN
		SetEntityEvent(_Character,"HAV_FlamingFist_LeftHaven",1);
		NOT DB_HAV_FlamingFistLeaveHaven((CHARACTER)_Character);
		
		IF
		EntityEvent((CHARACTER)_Character,"HAV_FlamingFist_LeftHaven")
		AND
		DB_HAV_Siege_NPCs(_Character)
		THEN
		NOT DB_HAV_Siege_NPCs(_Character);
		
		IF
		EntityEvent((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9,"HAV_FlamingFist_LeftHaven")
		THEN
		SetOnStage(S_HAV_Florrick_Note_43785054-670c-42c5-bc43-38ab269ed40f,1);
		
		IF
		EntityEvent((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9,"HAV_FlamingFist_LeftHaven")
		AND
		GetHostCharacter(_Player)
		THEN
		DebugText(_Player,"Florrick left HAV");
		
		IF
		LeftLevel(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9,"SCL_Main_A")
		AND
		DB_HAV_FlorrickInHAV(1)
		THEN
		NOT DB_HAV_FlorrickInHAV(1);
		
		//END_REGION
		
		//END_REGION
		
		//REGION Meenlock
		IF
		DB_HAV_Misc_Meenlock(_Meenlock)
		THEN
		DB_GLO_DefeatCounter(_Meenlock, "HAV_Meelock_DefeatCounter");
		
		IF
		TurnStarted(_Player)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		QRY_SpeakerIsAvailable(_Player, 1)
		AND
		DB_HAV_Misc_Meenlock(_Meenlock)
		AND
		DB_Is_InCombat(_Meenlock, _ID)
		AND
		DB_Is_InCombat(_Player, _ID)
		AND
		QRY_OnlyOnce("HAV_Misc_MeenlockAD")
		THEN
		PROC_TrySkillCheck(_Player, _Meenlock, "Arcana", (DIFFICULTYCLASS)Legacy_10_625be976-7a67-4394-97c8-14c69715ae4b, "HAV_Misc_Arcana_Meenlock");
		
		PROC
		PROC_RollResult("HAV_Misc_Arcana_Meenlock", _Player, _, 1)
		AND
		NOT DB_GlobalFlag((FLAG)HAV_Misc_State_PassedMeenlockArcanaCheck_e5cd5885-bd08-4ebd-b068-1ae70cae3222)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)HAV_Misc_State_PassedMeenlockArcanaCheck_e5cd5885-bd08-4ebd-b068-1ae70cae3222);
		
		PROC
		PROC_RollResult("HAV_Misc_Arcana_Meenlock", _Player, _, _)
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)HAV_Misc_VB_MeenlockReaction_cd668afd-c45c-d58c-871b-e830adb7fdfc, _Player);
		
		PROC
		PROC_LongRest()
		AND
		DB_GlobalFlag(HAV_Misc_State_MeenlocksPermaDefeated_056f0eff-93f2-468a-94e6-fd8aacb54ce7)
		AND
		QRY_OnlyOnce("HAV_Misc_MeenlockBasementPartyBanter")
		AND
		NOT DB_WorldGossipTrigger((TRIGGER)S_PartyBanterTrigger_HAV_CellarCleared_c736c59f-d015-49b7-a680-9220524d4498, _, _)
		THEN
		PROC_RegisterWorldGossipTrigger(S_PartyBanterTrigger_HAV_CellarCleared_c736c59f-d015-49b7-a680-9220524d4498);
		
		//END_REGION
		
		//REGION Reading Jaheira's Map
		IF
		TemplateUseStarted(_Player, PUZ_GEN_Map_SCL_Region_A_e8b3a769-151d-4224-829e-36748bb18890, _)
		AND
		DB_Players(_Player)
		AND
		QRY_OnlyOnce("SCL_UsedJaheirasMap")
		THEN
		ShowMapMarker(_Player, "TWN_Distillery_SUB", 1);
		ShowMapMarker(_Player, "SCL_MoonriseTowerMarker", 1);
		ShowMapMarker(_Player, "SCL_OliversHouse", 1);
		ShowMapMarker(_Player, "TWN_Tollhouse_SUB", 1);
		//END_REGION
		
		//REGION Debug
		
		IF
		TextEvent("havenflorrick")
		THEN
		SetFlag(Debug_Act2Setup_State_DesireSaved_9ab00499-75ee-2b2f-74f9-fed1957e3f26, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		FlagSet(Debug_Act2Setup_State_DesireSaved_9ab00499-75ee-2b2f-74f9-fed1957e3f26, _, _)
		THEN
		PROC_GlobalSetFlagAndCache(PLA_Desire_State_Freed2_46dbc8ef-61fa-42c4-bc89-4a8f53d53e5b);
		PROC_HAV_FlamingFists_Init();
		ClearFlag(Debug_Act2Setup_State_DesireSaved_9ab00499-75ee-2b2f-74f9-fed1957e3f26, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		
		//END_REGION
		
		//TG - 35 - Is in Haven
		IF
		DB_InRegion(_Player, (TRIGGER)S_HAV_Haven_SUB_6ac001f4-9c56-4a1b-963d-a509e158ffab)
		AND
		DB_Players(_Player)
		AND
		QRY_OnlyOnce("TG_HAV_MISC_InInHaven")
		AND
		DB_Avatars(_Avatar)
		THEN
		SetFlag((FLAG)TG_HAV_Misc_IsInHaven_f6e3f5a0-d553-41f2-9d6e-78cea503c992, _Avatar);
		
		PROC
		PROC_State_Changed(S_HAV_Haven_SUB_6ac001f4-9c56-4a1b-963d-a509e158ffab, "HAV_Area", "HAV_Area_State_BarrierIsOff")
		THEN
		PROC_RemoveOneShotTrigger(S_HAV_DaisyAD_Haven_cfd53d07-fd41-41e1-9313-20387cb9b1c2);
		
		PROC
		PROC_OneShotTriggerEntered(_Player,S_HAV_DaisyAD_Haven_cfd53d07-fd41-41e1-9313-20387cb9b1c2)
		THEN
		PROC_DaisyAD(_Player,HAV_DaisyAD_DiscoveredHaven_1089c14b-9f22-be0c-6a4c-bf6aef1df583);
	}
	EXIT
	{
	}
}
Goal(356).Title("Act2_HAV_MolsDeal");
Goal(356)
{
	INIT
	{
		SetOnStage((ITEM)S_HAV_MolLetter_28b38a22-3f34-487d-a5e1-3e961405a282, 0);
		
		//Mostly so that peeps can test situation multiple times without reloading
		DB_HAV_MolsDeal_Debug_FlagList((FLAG)HAV_MolsDeal_Event_FinishedGame_eadeec6e-e1ea-3aaf-6800-c92f904a9abe);
		DB_HAV_MolsDeal_Debug_FlagList(HAV_MolsDeal_State_WonGame_cd117dc3-5e6e-4100-edc2-369c63479302);
		DB_HAV_MolsDeal_Debug_FlagList(HAV_MolsDeal_State_LostGame_dfd02afb-71e7-1e01-7630-ce08f11cb40a);
		DB_HAV_MolsDeal_Debug_FlagList((FLAG)HAV_MolsDeal_Mol_HasMet_78e3bb28-e9f5-7ea3-9fdc-9f82daed03b6);
		DB_HAV_MolsDeal_Debug_FlagList((FLAG)HAV_MolsDeal_Raphael_HasMet_797d0da5-7e0a-4a8c-d2b3-10daa662eba7);
		
		DB_BookFlags(S_HAV_MolLetter_28b38a22-3f34-487d-a5e1-3e961405a282,HAV_MolsDeal_Knows_ReadMolLetter_11384240-983e-40c5-b3d8-fdc41514428e);
		
		DB_DialogBlockTradeButton(HAV_MolsDeal_Lanceboard_ThreeWay_3fc20a5a-83a6-e4a9-d9c2-536b0558ec2c);
		DB_DialogBlockAttackButton(HAV_MolsDeal_Lanceboard_ThreeWay_3fc20a5a-83a6-e4a9-d9c2-536b0558ec2c);
		
		// Mol-s states
		DB_State_Priority((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "NeedsInit", 0);
		DB_State_Priority((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "Checkpoint", 50);
		
		DB_State_Priority((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "MovingToBoard", 100);
		DB_State_Flags((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "MovingToBoard", (FLAG)HAV_MolsDeal_Mol_State_MovingToBoard_4dd8c25a-e8b3-4e31-be55-973fc52d10c4);
		
		DB_State_Priority((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "LanceboardPlay", 200);
		DB_State_Flags((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "LanceboardPlay", (FLAG)HAV_MolsDeal_Mol_State_PlayingGame_175c745c-036b-4211-85c9-351b8c0936d0);
		
		DB_State_Priority((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "PostMatch", 300);
		DB_State_Flags((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "PostMatch", (FLAG)HAV_MolsDeal_Mol_State_PostGame_aabe4bf0-5496-4e0b-b35e-ea396a9559c1);
		
		DB_State_Priority((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "Siege", 400);
		DB_State_Priority((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "Left", 500);
		DB_State_Priority((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "PermaDefeated", 600);
		
		DB_State_Current((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "NeedsInit");
		
		TemplateAddTo((ITEMROOT)BOOK_UNI_SCL_RaphaelsDiary2_f7d041fc-224a-43f3-8137-97eef0b2da45,S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8,1,0);
		
		SetOnStage(S_HAV_MolsDeal_LanceboardChair_1_OLD_8cca0090-625b-4453-82f7-52b938e3f421,0);
	}
	KB
	{
		//REGION debug
		IF
		FlagSet(_Flag,_Speaker,_)
		AND
		DB_HAV_MolsDeal_Debug_FlagList(_Flag)
		THEN
		DB_HAV_MolsDeal_Debug_FlagsToClear(_Flag,_Speaker);
		
		IF
		TextEvent("HAV_MolsDeal_Reset")
		THEN
		PROC_GlobalClearFlagAndCache((FLAG)HAV_EnteringHaven_State_MolVouched_ff4181d3-63ff-49ea-b26e-bc96c919119e);
		PROC_Debug_HAV_MolsDeal_Reset();
		
		IF
		TextEvent("Test_Interrupt")
		THEN
		SetEntityEvent(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925,"Test_Interrupt");
		
		PROC
		PROC_Debug_HAV_MolsDeal_Reset()
		AND
		DB_HAV_MolsDeal_Debug_FlagsToClear(_Flag,_Speaker)
		THEN
		ClearFlag(_Flag,_Speaker,0);
		NOT DB_HAV_MolsDeal_Debug_FlagsToClear(_Flag,_Speaker);
		
		PROC
		PROC_Debug_HAV_MolsDeal_Reset()
		THEN
		PROC_GLO_Monitor_DebugStateReset();
		PROC_HAV_DebugResetMolStateTo("NeedsInit");
		PROC_HAV_MolsDeal_Init();
		PROC_HAV_TieflingSurvivors_Setup("Mol");
		
		IF // shouldn't normally be possible, but just in case of unlucky ctrl+shift+k
		FlagSet(Debug_HAV_MolsDeal_RaphaelAlone_c0b97115-d43a-b7c4-6914-1ccc2eb5f287,_,_)
		AND
		IsDead(S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8,1)
		THEN
		Resurrect(S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8);
		
		IF
		FlagSet(Debug_HAV_MolsDeal_RaphaelAlone_c0b97115-d43a-b7c4-6914-1ccc2eb5f287,_,_)
		THEN
		SetOnStage(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925,0);
		PROC_GlobalSetFlagAndCache((FLAG)HAV_MolsDeal_RaphaelSolo_62228f75-2a30-485d-98d9-13b95f3677cf);
		ClearFlag(Debug_HAV_MolsDeal_RaphaelAlone_c0b97115-d43a-b7c4-6914-1ccc2eb5f287,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_Debug_HAV_MolsDeal_Reset();
		
		
		IF
		FlagSet(Debug_HAV_MolsDeal_ThreeWaySetup_2b492e4d-bc82-0619-cdec-321cd55a7f41,_,_)
		THEN
		SetOnStage(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925,1);
		PROC_GlobalClearFlagAndCache((FLAG)HAV_MolsDeal_RaphaelSolo_62228f75-2a30-485d-98d9-13b95f3677cf);
		
		IF
		FlagSet(Debug_HAV_MolsDeal_ThreeWaySetup_2b492e4d-bc82-0619-cdec-321cd55a7f41,_,_)
		THEN
		ClearFlag(Debug_HAV_MolsDeal_ThreeWaySetup_2b492e4d-bc82-0619-cdec-321cd55a7f41,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_Debug_HAV_MolsDeal_Reset();
		
		IF
		FlagSet(Debug_HAV_MolsDeal_ResetDialogs_1cb19622-d991-24f6-0f25-0cf069f38e92,_,_)
		THEN
		ClearFlag(Debug_HAV_MolsDeal_ResetDialogs_1cb19622-d991-24f6-0f25-0cf069f38e92,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_Debug_HAV_MolsDeal_Reset();
		
		IF
		TextEvent("HAV_MolsDeal_Teleport_Snap")
		THEN
		TeleportTo(S_HAV_MolsDeal_Lanceboard_f85b214b-9669-4e6b-99c8-588b5d82cd19, S_HAV_MolsDeal_LanceboardPoint_68191804-c0af-4127-8fe7-f59fcc6061c2,"",1,1,1,1,1);
		
		IF
		TextEvent("HAV_MolsDeal_Teleport_NoSnap")
		THEN
		TeleportTo(S_HAV_MolsDeal_Lanceboard_f85b214b-9669-4e6b-99c8-588b5d82cd19, S_HAV_MolsDeal_LanceboardPoint_68191804-c0af-4127-8fe7-f59fcc6061c2,"",1,1,1,1,0);
		
		IF
		FlagSet((FLAG)GLO_Debug_MolDead_74068455-501c-0022-d2ec-105c8c8fd527,_,_)
		THEN
		PROC_GlobalSetFlagAndCache(HAV_MolsDeal_RaphaelSolo_62228f75-2a30-485d-98d9-13b95f3677cf);
		PROC_Children_RemoveNPC((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925);
		Die((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, DEATHTYPE.DoT, 1);
		DB_Dead(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925);
		SetOnStage(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925,0);
		PROC_Debug_HAV_MolsDeal_Reset();
		
		IF
		FlagSet((FLAG)GLO_Debug_ResurrectMol_4f6ae999-5893-90e8-7226-85d05a6e7b0c,_,_)
		THEN
		PROC_GlobalClearFlagAndCache(HAV_MolsDeal_RaphaelSolo_62228f75-2a30-485d-98d9-13b95f3677cf);
		DB_Children((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925);
		Resurrect(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925);
		SetOnStage(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925,1);
		PROC_Debug_HAV_MolsDeal_Reset();
		
		PROC
		PROC_HAV_DebugResetMolStateTo((STRING)_NewSate)
		AND
		DB_State_Current(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", _CurrentState)
		THEN
		PROC_State_Changed(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", _CurrentState, _NewSate);
		
		//END_REGION debug
		
		//REGION init
		
		PROC
		PROC_HAV_TieflingSurvivors_OnSetupDone("Mol")
		THEN
		PROC_HAV_MolsDeal_Init();
		
		PROC
		PROC_HAV_MolsDeal_Init()
		AND
		NOT DB_PermaDefeated(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925)
		THEN
		PROC_State_Progress(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "Checkpoint");
		
		PROC
		PROC_HAV_MolsDeal_Init()
		AND
		NOT DB_PermaDefeated(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925)
		AND
		NOT DB_GlobalFlag(HAV_MolsDeal_RaphaelSolo_62228f75-2a30-485d-98d9-13b95f3677cf)
		THEN
		SetOwner((ITEM)S_HAV_MolsDeal_Lanceboard_f85b214b-9669-4e6b-99c8-588b5d82cd19, S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925);
		
		PROC
		PROC_HAV_MolsDeal_Init()
		AND
		DB_PermaDefeated(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925)
		THEN
		PROC_GlobalSetFlagAndCache(HAV_MolsDeal_RaphaelSolo_62228f75-2a30-485d-98d9-13b95f3677cf);
		PROC_State_Progress(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "PermaDefeated");
		
		PROC
		PROC_StateSet_PermaDefeated(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925)
		THEN
		PROC_State_Progress(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "PermaDefeated");
		
		//END_REGION init
		
		//REGION Moving from vouch point to gamepoint
		
		// Mol alive
		IF
		FlagSet(HAV_EnteringHaven_State_GainedAccess_07c776da-353a-9050-e9be-c42d51a99412, _,_)
		AND
		NOT DB_GlobalFlag(HAV_MolsDeal_RaphaelSolo_62228f75-2a30-485d-98d9-13b95f3677cf)
		THEN
		PROC_State_Progress(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "MovingToBoard");
		
		PROC
		PROC_State_Changed((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", _, "MovingToBoard")
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925);
		DB_Dialogs(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, HAV_MolsDeal_MolMoving_996d1993-6363-d43d-d5af-0d940fae09ac);
		
		// Event comes from Anubis when she reaches the table
		IF
		EntityEvent(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_MolsDeal_ReachedLanceboard")
		AND
		DB_State_Current(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "MovingToBoard")
		THEN
		PROC_State_Progress(S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, "GLO_Monitor", "GLO_Monitor_PlayingLanceboard");
		PROC_State_Progress(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "LanceboardPlay");
		
		PROC
		PROC_State_Changed((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", _, "LanceboardPlay")
		THEN
		DB_SceneManager(S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, "HAV_MolDeal_MatchPlayed");
		DB_SceneManager(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_MolDeal_MatchPlayed");
		PROC_RemoveAllDialogEntriesForSpeaker(S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8);
		PROC_RemoveAllDialogEntriesForSpeaker(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925);
		DB_Dialogs(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, HAV_MolsDeal_Lanceboard_ThreeWay_3fc20a5a-83a6-e4a9-d9c2-536b0558ec2c);
		Use(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, (ITEM)S_HAV_MolsDeal_LanceboardChair_1_ca0d8ecf-29ad-4351-9a15-6b5ef5ed0ca2, 1, 1, "HAV_MolsDeal_SitsAtTable");
		
		// Mol, no Raphael
		IF
		FlagSet(HAV_EnteringHaven_State_GainedAccess_07c776da-353a-9050-e9be-c42d51a99412, _,_)
		AND
		NOT DB_GlobalFlag(HAV_MolsDeal_RaphaelSolo_62228f75-2a30-485d-98d9-13b95f3677cf)
		AND
		NOT QRY_State_IsBeforeState((CHARACTER)S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, "GLO_Monitor", "GLO_Monitor_LeavingHaven")
		THEN
		PROC_CharacterMoveTo(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, S_HAV_MolsDeal_MolSpot_Lanceboard_e4516c3a-4649-4d8c-b46c-820ad96808f1, "Walk", "HAV_MolsDeal_ReachedAloneSpot");
		
		IF
		EntityEvent(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_MolsDeal_ReachedAloneSpot")
		THEN
		PROC_State_Progress(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "PostMatch");
		
		PROC
		PROC_State_Changed((CHARACTER)S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, "GLO_Monitor", "GLO_Monitor_WaitingMolAtLanceboard", _NewState)
		AND
		_NewState != "GLO_Monitor_PlayingLanceboard"
		AND
		DB_State_Current(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "MovingToBoard")
		THEN
		PROC_State_Progress(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "PostMatch");
		
		// Raphael, no Mol
		IF
		FlagSet(HAV_EnteringHaven_State_GainedAccess_07c776da-353a-9050-e9be-c42d51a99412, _,_)
		AND
		DB_GlobalFlag(HAV_MolsDeal_RaphaelSolo_62228f75-2a30-485d-98d9-13b95f3677cf)
		AND
		QRY_State_IsBeforeState((CHARACTER)S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, "GLO_Monitor", "GLO_Monitor_LeavingHaven")
		THEN
		PROC_State_Progress((CHARACTER)S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, "GLO_Monitor", "GLO_Monitor_HavenSolo");
		
		//END_REGION Moving from vouch point to gamepoint
		
		//REGION Lanceboard scene handling
		
		PROC
		PROC_State_Changed(S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, "GLO_Monitor", _, "GLO_Monitor_WaitingMolAtLanceboard")
		THEN
		DB_SceneTriggerManager("HAV_MolDeal_MatchPlayed", (TRIGGER)S_HAV_LanceBoard_SceneManager_4379b45b-8820-4a55-a33b-089a5c6e5d3a, 0);
		
		PROC
		PROC_SceneInterrupted(_Object, _, "HAV_MolDeal_MatchPlayed", _Interrupt)
		AND
		_Interrupt != "StartedDialog"
		AND
		_Object != S_HAV_MolLetter_28b38a22-3f34-487d-a5e1-3e961405a282
		AND
		_Object != S_HAV_MolsDeal_LanceboardChair_1_OLD_8cca0090-625b-4453-82f7-52b938e3f421
		THEN
		PROC_SceneOver("HAV_MolDeal_MatchPlayed");
		
		PROC
		PROC_SceneOver("HAV_MolDeal_MatchPlayed")
		AND
		DB_State_Current((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "LanceboardPlay")
		THEN
		PROC_HAV_MolsDeal_MonitorAbort();
		PROC_State_Progress((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "PostMatch");
		
		PROC
		PROC_SceneOver("HAV_MolDeal_MatchPlayed")
		AND
		DB_State_Current(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "MovingToBoard")
		THEN
		PROC_State_Progress((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "PostMatch");
		
		PROC
		PROC_SceneOver("HAV_MolDeal_MatchPlayed")
		AND
		DB_State_Current((CHARACTER)S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, "GLO_Monitor", "GLO_Monitor_WaitingMolAtLanceboard")
		THEN
		PROC_State_Progress((CHARACTER)S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, "GLO_Monitor", "GLO_Monitor_HavenSolo");
		
		PROC
		PROC_SceneInterrupted(_, _, "HAV_MolDeal_MatchPlayed", _Interruption)
		AND
		DB_GLO_GenericSceneManager_ViolenceReason(_Interruption)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)GLO_Monitor_State_AttackedMonitor_355730d6-4035-4918-888e-dbbefea1b6c3);
		
		PROC
		PROC_State_Changed(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "LanceboardPlay", _)
		THEN
		PROC_SceneOver("HAV_MolDeal_MatchPlayed");
		
		IF
		EntityEvent(_, "HAV_MolsDeal_Event_FailedToUseSeat")
		AND
		DB_State_Current(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "LanceboardPlay")
		THEN
		PROC_SceneOver("HAV_MolDeal_MatchPlayed");
		
		//END_REGION Lanceboard scene handling
		
		//REGION Mol leaves during the lanceboard dialog
		
		IF
		FlagSet(HAV_MolsDeal_Event_FinishedGame_eadeec6e-e1ea-3aaf-6800-c92f904a9abe, _, _ID)
		AND
		DB_DialogNPCs(_ID, S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, _)
		AND
		DialogRemoveActorFromDialog(_ID, S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, _)
		THEN
		DB_NOOP(1); //Rest is handled in anubis
		
		IF
		FlagSet(HAV_MolsDeal_Event_FinishedGame_eadeec6e-e1ea-3aaf-6800-c92f904a9abe, _, _)
		AND
		DB_State_Current(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "LanceboardPlay")
		THEN
		PROC_State_Progress(S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, "GLO_Monitor", "GLO_Monitor_LanceboardFinished");
		PROC_State_Progress(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "PostMatch");
		
		PROC
		PROC_State_Changed(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", _, "PostMatch")
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925);
		DB_Dialogs(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, HAV_MolsDeal_Mol_d47c649a-06cd-e554-8705-2d38a3214110);
		
		//END_REGION Mol leaves during dialog
		
		//REGION Raphael states
		
		// Init
		PROC
		PROC_HAV_MolsDeal_Init()
		THEN
		PROC_GLO_Monitor_Foop();
		TeleportTo(S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, S_HAV_MolsDeal_MonitorSpot_Lanceboard_cab24502-8e98-4b99-9d3e-edfa8ba964b3);
		
		// alone, Mol is gone
		PROC
		PROC_HAV_MolsDeal_Init()
		AND
		DB_GlobalFlag(HAV_MolsDeal_RaphaelSolo_62228f75-2a30-485d-98d9-13b95f3677cf)
		THEN
		PROC_State_Progress(S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, "GLO_Monitor", "GLO_Monitor_HavenSolo");
		
		PROC
		PROC_State_Changed(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", _, "Left")
		AND
		QRY_State_IsBeforeState((CHARACTER)S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, "GLO_Monitor", "GLO_Monitor_LeavingHaven")
		THEN
		PROC_State_Progress(S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, "GLO_Monitor", "GLO_Monitor_HavenSolo");
		
		PROC
		PROC_State_Changed(S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, "GLO_Monitor", _, "GLO_Monitor_HavenSolo")
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8);
		DB_Dialogs(S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, HAV_MolsDeal_Raphael_f7a2c41b-2b2c-c91e-faf2-b8f6ccdede44);
		
		// waits for Mol (by default she-s on the checkpoint)
		PROC
		PROC_HAV_MolsDeal_Init()
		AND
		NOT DB_GlobalFlag(HAV_MolsDeal_RaphaelSolo_62228f75-2a30-485d-98d9-13b95f3677cf)
		THEN
		PROC_State_Progress(S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, "GLO_Monitor", "GLO_Monitor_WaitingMolAtLanceboard");
		
		PROC
		PROC_State_Changed(S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, "GLO_Monitor", _, "GLO_Monitor_WaitingMolAtLanceboard")
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8);
		DB_Dialogs(S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, HAV_MolsDeal_RaphaelWaiting_a1266693-df11-9a21-fb66-f5316e2a52a8);
		
		PROC
		PROC_State_Changed(S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, "GLO_Monitor", _, "GLO_Monitor_WaitingMolAtLanceboard")
		AND
		NOT IsReposedOnEntity(S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, S_HAV_MolsDeal_LanceboardChair_2_940559d0-8c46-428a-bcd1-eba27565d3d1, 1) // check for 0 is bugged
		THEN
		Use(S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, (ITEM)S_HAV_MolsDeal_LanceboardChair_2_940559d0-8c46-428a-bcd1-eba27565d3d1, 1, 1, "HAV_MolsDeal_MonitorSits");
		
		// Leaving Haven
		// Poof at end of Lanceboard scene
		IF
		DialogEnded(HAV_MolsDeal_Lanceboard_ThreeWay_3fc20a5a-83a6-e4a9-d9c2-536b0558ec2c, _ID)
		AND
		NOT DB_DialogRequestFailed(HAV_MolsDeal_Lanceboard_ThreeWay_3fc20a5a-83a6-e4a9-d9c2-536b0558ec2c, _ID)
		THEN
		PROC_HAV_MolsDeal_MonitorPoof();
		
		//Taunt and then poof if solo Raphael
		IF
		DialogEnded(HAV_MolsDeal_Raphael_f7a2c41b-2b2c-c91e-faf2-b8f6ccdede44, _ID)
		AND
		NOT DB_DialogRequestFailed(HAV_MolsDeal_Raphael_f7a2c41b-2b2c-c91e-faf2-b8f6ccdede44, _ID)
		THEN
		PROC_HAV_MolsDeal_MonitorPoof();
		
		//No Taunt if poofed in Dialog
		IF
		FlagSet(HAV_MolsDeal_Event_RaphaelPoof_af56edf4-13f6-4700-bf74-549aaa107f1c, S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, _)
		THEN
		PROC_HAV_MolsDeal_MonitorStagedOff();
		
		PROC
		PROC_HAV_MolsDeal_MonitorAbort()
		AND
		QRY_State_IsBeforeState((CHARACTER)S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, "GLO_Monitor", "GLO_Monitor_LeavingHaven")
		THEN
		PROC_State_Progress((CHARACTER)S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, "GLO_Monitor", "GLO_Monitor_LeavingHaven");
		PROC_ForceStopDialog(S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8);
		PROC_HAV_MolsDeal_MonitorLeaves();
		
		PROC
		PROC_HAV_MolsDeal_MonitorLeaves()
		AND
		NOT QRY_StartDialogCustom((DIALOGRESOURCE)HAV_MolsDeal_AD_MonitorLeave_251077f6-dbb7-871a-de69-06a69f0d7ca2, (CHARACTER)S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, 0, 0, 0, 0)
		THEN
		PROC_HAV_MolsDeal_MonitorPoof();
		
		IF
		AutomatedDialogEnded((DIALOGRESOURCE)HAV_MolsDeal_AD_MonitorLeave_251077f6-dbb7-871a-de69-06a69f0d7ca2, _)
		THEN
		PROC_HAV_MolsDeal_MonitorPoof();
		
		PROC
		PROC_HAV_MolsDeal_MonitorPoof()
		THEN
		PROC_State_Progress((CHARACTER)S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, "GLO_Monitor", "GLO_Monitor_LeftHaven");
		PROC_GLO_Monitor_Poof();
		PROC_HAV_MolsDeal_OnMonitorPoofed();
		
		PROC
		PROC_HAV_MolsDeal_MonitorStagedOff()
		THEN
		PROC_State_Progress((CHARACTER)S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, "GLO_Monitor", "GLO_Monitor_LeftHaven");
		PROC_SetOnStage((CHARACTER)S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, 0);
		PROC_HAV_MolsDeal_OnMonitorPoofed();
		
		//END_REGION Raphael states
		
		//REGION HAV states
		
		PROC
		PROC_State_Changed(S_HAV_Haven_SUB_6ac001f4-9c56-4a1b-963d-a509e158ffab, "HAV_Mood", "HAV_Mood_State_Siege")
		THEN
		PROC_HAV_MolsDeal_MonitorAbort();
		PROC_State_Progress(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "Siege");
		
		PROC
		PROC_State_Changed(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", _PreviousState, "Siege")
		AND
		_PreviousState != "PostMatch"
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925);
		DB_Dialogs(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, HAV_MolsDeal_Mol_d47c649a-06cd-e554-8705-2d38a3214110);
		
		PROC
		PROC_State_Changed(S_HAV_Haven_SUB_6ac001f4-9c56-4a1b-963d-a509e158ffab, "HAV_Mood", "HAV_Mood_State_NightsongFreed")
		AND
		NOT DB_GlobalFlag((FLAG)HAV_TakingIsobel_Event_MolKidnapped_1a87fee7-163a-477c-b84d-cc0fbb74dbe2)
		THEN
		PurgeOsirisQueue(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925);
		SetOnStage((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, 0);
		PROC_GlobalSetFlagAndCache((FLAG)HAV_MolsDeal_State_MolLeftWithHarpers_149b5a39-392c-4c0a-bb64-796f0123ddcf);
		PROC_State_Progress(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "Left");
		PROC_HAV_MolsDeal_MonitorAbort();
		
		IF
		FlagSet(HAV_General_State_IsHostileToPlayers_3cd1e3a7-6a9a-6558-a9f2-8db69824869b, _, _)
		AND
		QRY_State_IsBeforeState((CHARACTER)S_GLO_Monitor_f65becd6-5cd7-4c88-b85e-6dd06b60f7b8, "GLO_Monitor", "GLO_Monitor_LeavingHaven")
		THEN
		PROC_HAV_MolsDeal_MonitorPoof();
		
		IF
		FlagSet(HAV_General_State_IsHostileToPlayers_3cd1e3a7-6a9a-6558-a9f2-8db69824869b, _, _)
		AND
		QRY_State_IsBeforeState((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "Left")
		THEN
		PROC_DisappearOutOfSight(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "Run", 0, "");
		PROC_State_Progress(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "HAV_Mol", "Left");
		//END_REGION HAV states
		
		//REGION Mol Letter
		
		IF
		FlagSet((FLAG)HAV_MolsDeal_State_MolLeftWithHarpers_149b5a39-392c-4c0a-bb64-796f0123ddcf, _, _)
		THEN
		SetOnStage((ITEM)S_HAV_MolLetter_28b38a22-3f34-487d-a5e1-3e961405a282, 1);
		
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(357).Title("Act2_HAV_SavingPrisoners");
Goal(357)
{
	INIT
	{
		//Returned Prisoners
		DB_HAV_SavingPrisoners_Returner((CHARACTER)S_GLO_ProdigySister_44d09b0b-0568-456c-b18d-559a0a3f981d, "Tiefling", (TRIGGER)S_HAV_ReunionSisterPos_4405f53c-83dd-40f0-8d6e-07a81b44220b, (DIALOGRESOURCE)HAV_ProdigyLament_Sister_40cc4552-2c6b-8ae3-a989-10b2919f11d2, (FLAG)HAV_SavingPrisoners_State_SisterReturned_54cbf85c-163b-d0f7-2519-93ff58c843aa, "HAV_ProdigySister");
		DB_HAV_SavingPrisoners_Returner((CHARACTER)S_GLO_ProdigyBrother_d0187724-c0e2-4019-a01d-a03ee8153f1b, "Tiefling", S_HAV_ReunionBrotherPos_15db6e37-d07d-48c1-8fa6-11e65661df51, (DIALOGRESOURCE)HAV_ProdigyLament_Brother_a1778458-a7c8-c51d-2136-051ba860bc43, HAV_SavingPrisoners_State_BrotherReturned_2b696962-1d09-4cb6-b034-34d86d73dba0, "HAV_ProdigyBrother");
		DB_HAV_SavingPrisoners_Returner((CHARACTER)S_DEN_Tiefling_010_23129d6c-8d39-4a4c-a4f6-cfc6637b597c, "Tiefling", S_HAV_FlirtyTieflingPos_e310f982-5765-49a2-afc9-32dddcb2018d, (DIALOGRESOURCE)HAV_SavingPrisoners_FlirtyTiefling_b6e8c50e-b3e0-0951-cb59-3c464cc97b59, HAV_SavingPrisoners_State_FlirtyReturned_67cf2fcc-e872-40c7-bcb5-7e4ccc915fa6, "HAV_FlirtyTiefling");
		DB_HAV_SavingPrisoners_Returner((CHARACTER)S_GLO_YoungLover_01_dd9178e7-1e3f-43bc-8a38-666dfcac7d0c, "Tiefling", S_HAV_LoverPos_001_42ef3169-e468-43b2-b467-6fb55184e5f0, (DIALOGRESOURCE)HAV_LoneLover_Danis_58c1dcd0-0ec4-1fa4-324f-d20e32adaf45, HAV_SavingPrisoners_State_LoverReturned_b143075b-cc85-4d85-ba72-b24bb981b5e4, "HAV_YoungLover_001");
		
