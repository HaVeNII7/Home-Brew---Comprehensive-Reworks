		AND
		NOT DB_Dead((CHARACTER)S_HAG_Hagspawn_HusbandJake_133bf997-7c0d-4c64-88c9-9b9cd439dbb5)
		AND
		IsInTrigger(_Player, (TRIGGER)S_HAG_HagSwamp_Outer_9bdef32b-ddf2-44e8-adfe-75e39639bb75, 1)
