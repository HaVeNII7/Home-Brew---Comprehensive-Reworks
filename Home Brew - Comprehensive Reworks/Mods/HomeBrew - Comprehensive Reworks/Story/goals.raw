		DB_PermaDefeatedFlag(S_GLO_GnomePrisoner_002_c9a7d921-bef0-4829-8792-d48c529daee5,(FLAG)MOO_GnomePrisoner002_State_PermaDefeated_fc079d0c-2c74-437c-aa00-fb358d4658a2);
		
