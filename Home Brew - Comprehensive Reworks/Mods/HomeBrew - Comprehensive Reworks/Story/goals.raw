		SetDetached(S_UND_KethericCity_AdamantineGolem_2a5997fc-5f2a-4a13-b309-bed16da3b255, 1);
		DB_UND_AdamantineForge_AdamantineForgeDialogOngoing(1);
		
		
		IF
