		DB_CampNight_Requirement((FLAG)NIGHT_Wyll_HavenRomance_6e5b7ca7-b4d0-498b-86cc-64ba4ee5ba51,(FLAG)MOO_PartyProgress_EnteredMoonrise_278dff38-c7e5-4699-9cb9-6d66ef3c9030);
