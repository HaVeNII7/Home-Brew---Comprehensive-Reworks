		SetEntityEvent(_Replacement, "CAMP_GoblinHuntCelebration_Teleported");
		DB_CAMP_GoblinHuntCelebration_SceneActors(_Replacement);
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_SetupTieflings()
