		DB_CampNight_Requirement_Dating((FLAG)NIGHT_Astarion_SecondNight_2c52aa2f-d729-4ac5-9416-eecafa630615, (CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255);
		DB_CampNight_Requirement((FLAG)NIGHT_Astarion_SecondNight_2c52aa2f-d729-4ac5-9416-eecafa630615, (FLAG)ORI_Astarion_State_SecondNightUnlocked_6fffb264-eac2-49d8-b398-84d6065821d7);
		DB_CampNight_CancelledBy((FLAG)NIGHT_Astarion_SecondNight_2c52aa2f-d729-4ac5-9416-eecafa630615, (FLAG)ORI_Astarion_State_SecondNightHappened_217604f8-c2e0-46db-b2d2-6a6256632483);
		DB_CampNight_CancelledBy((FLAG)NIGHT_Astarion_SecondNight_2c52aa2f-d729-4ac5-9416-eecafa630615, (FLAG)ORI_Astarion_State_SecondNightCancelled_eb851137-4b2c-4724-bbb1-ebd24651e818);
		DB_CampNight_CancelledBy((FLAG)NIGHT_Astarion_SecondNight_2c52aa2f-d729-4ac5-9416-eecafa630615, (FLAG)MOO_BloodMerchant_State_BloodMerchantOMHappened_450f215e-ab01-4583-b62a-87542873abb3);
		
		//END_REGION
	}
	KB
	{
		//REGION Bloodless Boars
		IF
		DB_ORI_AstarionHunger_Boars(_Boar, _)
		THEN
		PROC_SetOnStage(_Boar, 0);
		
		// Getting Ceremorphosis 2 night OR entering the forest area (which cancels Ceremorphosis 2 night) does the following:
		// a) reveals the boars
		// b) unlocks the bite scene
		// if the night is cancelled due to us entering the forest, then we only reveal the boars
		// if Astarion took at least one long rest with us (he couldn't hunt an animal if we never had a long rest after recruiting him)
		IF
		FlagSet((FLAG)NIGHT_Ceremorphosis2_485f589f-0da1-4eea-9a28-210f91837a69, _, _)
		AND
		NOT DB_Avatars(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		THEN
		PROC_GlobalSetFlagAndCache(ORI_Astarion_State_BiteSceneUnlocked_3cfdb2af-c0b1-4820-a635-cf1e5afbf0ee);
		PROC_ORI_Astarion_ShowBoars();
		
		PROC
		PROC_LongRest()
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		AND
		NOT DB_ORI_Astarion_TookAtLeastOneLongRest(1)
		THEN
		DB_ORI_Astarion_TookAtLeastOneLongRest(1);
		
		IF
		FlagSet(FOR_PartyProgress_EnteredForest_96c8ee70-eba5-4007-855f-59bef6c9f051, _, _)
		AND
		NOT DB_Avatars(S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		AND
		NOT DB_GlobalFlag((FLAG)ORI_Astarion_State_BiteSceneUnlocked_3cfdb2af-c0b1-4820-a635-cf1e5afbf0ee)
		THEN
		PROC_GlobalSetFlagAndCache(ORI_Astarion_State_BiteSceneUnlocked_3cfdb2af-c0b1-4820-a635-cf1e5afbf0ee);
		PROC_ORI_Astarion_CheckShowBoars();
		
		PROC
		PROC_ORI_Astarion_CheckShowBoars()
		AND
		DB_ORI_Astarion_TookAtLeastOneLongRest(1)
		THEN
		PROC_ORI_Astarion_ShowBoars();
		
		// For Astarion Avatar we need to show the boars if we had a Bite Scene
		// but instead of biting a companion decided to go and hunt an animal
		IF
		FlagSet((FLAG)CAMP_Astarion_TheHungerA_HuntAnimal_ef9c902d-0940-4a39-a926-5717795b89fe, _, _)
		THEN
		PROC_ORI_Astarion_ShowBoars();
		
		// if we reveal the boars in the real time, let's make sure
		// that there are at least no players around
		PROC
		PROC_ORI_Astarion_ShowBoars()
		AND
		QRY_OnlyOnce("ORI_Astarion_ShowBoars")
		AND
		DB_ORI_AstarionHunger_Boars(_Boar, _BoarTrigger)
		AND
		GetClosestPlayer(_Boar, _, _Dist)
		AND
		_Dist > 30.0
		THEN
		PROC_SetOnStage(_Boar, 1);
		PROC_TriggerRegisterForPlayers(_BoarTrigger);
		TriggerRegisterForCharacter(_BoarTrigger, _Boar);
		
		// When one of the boars is discovered we disable the rest of them:
		// if there is no player nearby then we hide them immediately
		// otherwise we will hide them after a long rest
		IF
		EnteredTrigger(_Player, _BoarTrigger)
		AND
		DB_Players(_Player)
		AND
		DB_ORI_AstarionHunger_Boars(_Boar, _BoarTrigger)
		AND
		NOT DB_GlobalFlag(ORI_AstarionHunger_State_BoarDiscovered_a275c3d9-7ffc-4f33-85ea-e15227534dc3)
		THEN
		DB_ORI_AstarionHunger_Boars_DiscoveredBoar(_Boar);
		PROC_ORI_Astarion_Boars_HideUndiscoveredBoars();
		PROC_GlobalSetFlagAndCache(ORI_AstarionHunger_State_BoarDiscovered_a275c3d9-7ffc-4f33-85ea-e15227534dc3);
		
		// When a non-Astarion player enters the trigger we also play a voicebark
		IF
		EnteredTrigger(_Player, _BoarTrigger)
		AND
		DB_Players(_Player)
		AND
		DB_ORI_AstarionHunger_Boars(_Boar, _BoarTrigger)
		AND
		_Player != S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255
		AND
		QRY_OnlyOnce("OR_Astarion_Boars_DiscoveredBoarVB")
		THEN
		StartVoiceBark((VOICEBARKRESOURCE)ORI_AstarionHunger_VB_BoarFound_a8dc0448-c51e-f3d6-6f44-74767f1a7c32, _Player);
		
		PROC
		PROC_ORI_Astarion_Boars_HideUndiscoveredBoars()
		AND
		DB_ORI_AstarionHunger_Boars(_Boar, _BoarTrigger)
		AND
		NOT DB_ORI_AstarionHunger_Boars_DiscoveredBoar(_Boar)
		THEN
		PROC_TriggerUnregisterForPlayers(_BoarTrigger);
		
		// if no Player near the boar, we simply remove the boar
		// otherwise it will be removed after a long rest
		PROC
		PROC_ORI_Astarion_Boars_HideUndiscoveredBoars()
		AND
		DB_ORI_AstarionHunger_Boars(_Boar, _BoarTrigger)
		AND
		NOT DB_ORI_AstarionHunger_Boars_DiscoveredBoar(_Boar)
		AND
		GetClosestPlayer(_Boar, _Player, _Dist)
		AND
		_Dist >= 30.0
		THEN
		PROC_SetOnStage(_Boar, 0);
		
		PROC
		PROC_ORI_Astarion_Boars_HideUndiscoveredBoars()
		AND
		DB_ORI_AstarionHunger_Boars(_Boar, _BoarTrigger)
		AND
		NOT DB_ORI_AstarionHunger_Boars_DiscoveredBoar(_Boar)
		AND
		GetClosestPlayer(_Boar, _Player, _Dist)
		AND
		_Dist < 30.0
		THEN
		DB_ORI_AstarionHunger_Boars_RemoveAfterLongRest(_Boar);
		
		// if non-Astarion loots the boar and Astarion is nearby
		// we start ORI_AstarionHunger_BoarExamine_POM_Astarion dialog with the character that looted the body and Astarion (only once)
		// unless the character failed to examine the boar before
		// however, if Astarion is Avatar, then we don't trigger an interactive dialog. It's just a corpse.
		IF
		CharacterLootedCharacter(_Player, _Boar)
		AND
		DB_ORI_AstarionHunger_Boars(_Boar, _BoarTrigger)
		AND
		DB_ORI_AstarionHunger_Boars_DiscoveredBoar(_Boar)
		AND
		NOT DB_GlobalFlag((FLAG)CAMP_Astarion_TheHungerA_HuntAnimal_ef9c902d-0940-4a39-a926-5717795b89fe) 
		AND
		NOT DB_OnlyOnce("ORI_AstarionHunger_Boars_DiscussedWithAstarion")
		AND
		DB_Players(_Player)
		AND
		_Player != S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255
		AND
		GetFlag((FLAG)ORI_Astarion_BoarInvestigation_State_Failure_afff5e2d-da09-4cab-84d6-16fc99fd8f72, _Player, 0) // failed to examine before - no OM!
		AND
		GetDistanceTo(_Player, S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, _Dist)
		AND
		_Dist < 10.0
		AND
		IsInInventory(_Boar, 0)
		AND
		QRY_StartDialog_Fixed(ORI_AstarionHunger_BoarExamine_POM_Astarion_9b32382e-53a9-d78d-4e16-ce30daf584fc, S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, _Player, _Boar)
		THEN
		DB_OnlyOnce("ORI_AstarionHunger_Boars_DiscussedWithAstarion");
		
		// if non-Astarion loots the boar and Astarion is NOT nearby
		// then we start ORI_AstarionHunger_BoarExamine dialog, but only if the player hasn't actually tried to examine the boar yet
		IF
		CharacterLootedCharacter(_Player, _Boar)
		AND
		DB_ORI_AstarionHunger_Boars(_Boar, _BoarTrigger)
		AND
		DB_ORI_AstarionHunger_Boars_DiscoveredBoar(_Boar)
		AND
		NOT DB_GlobalFlag((FLAG)CAMP_Astarion_TheHungerA_HuntAnimal_ef9c902d-0940-4a39-a926-5717795b89fe) 
		AND
		NOT DB_OnlyOnce("ORI_AstarionHunger_Boars_DiscussedWithAstarion")
		AND
		DB_Players(_Player)
		AND
		_Player != S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255
		AND
		GetFlag((FLAG)ORI_Astarion_BoarInvestigation_State_Attempted_f73bce2c-f898-4f93-860a-f1ea8c1d1cbd, _Player, 0)
		AND
		IsInInventory(_Boar, 0)
		AND
		QRY_StartDialog_Fixed((DIALOGRESOURCE)ORI_AstarionHunger_BoarExamine_2fa501df-bef4-31ed-9ff0-07b08a4474f5, _Player, _Boar)
		THEN
		DB_NOOP(1);
		
		// if the player moves a boar outside the initial trigger (that includes picking up the corpse)
		// we don't remove it after a long rest
		IF
		LeftTrigger(_Boar, _BoarTrigger)
		AND
		DB_ORI_AstarionHunger_Boars_RemoveAfterLongRest(_Boar)
		THEN
		NOT DB_ORI_AstarionHunger_Boars_RemoveAfterLongRest(_Boar);
		
		PROC
		PROC_LongRest()
		AND
		DB_ORI_AstarionHunger_Boars_RemoveAfterLongRest(_Boar)
		THEN
		DB_ExecuteWhenObjectInCurrentLevel("GLO_OffStage",_Boar);
		
		// When the Bite scene happens we disable Boar interaction
		IF
		FlagSet((FLAG)NIGHT_AstarionHungerC_Bite_fe3fd3a0-70d1-4bc4-8a7f-4614f89ac23d, _, _)
		AND
		NOT DB_OnlyOnce("ORI_AstarionHunger_Boars_DiscussedWithAstarion")
		THEN
		DB_OnlyOnce("ORI_AstarionHunger_Boars_DiscussedWithAstarion");
		//END_REGION
		
		//REGION Gur Hunter disappears with / without Astarion
		PROC
		PROC_FlagReactionAfterDialog((CHARACTER)_Avatar, (FLAG)HAG_GurHunter_Event_HandedAstarionOver_03c98055-5bad-4d6f-bc8d-4700755227ec)
		THEN
		PROC_HAG_GurHunter_RemoveBackpack();
		SetOnStage(S_GLO_GurHunter_0e47fcb9-c0c4-4b0c-902b-2d13d209e760, 0);
		QuestUpdate(_Avatar, "ORI_COM_Astarion", "MetGur_AstarionCapture");
		SetFlag((FLAG)ORI_Astarion_State_GurGotAstarion_cd1687b8-3282-4121-aaa1-6de5eda6a9a4, NULL_00000000-0000-0000-0000-000000000000);
		
		PROC
		PROC_HAG_GurHunter_RemoveBackpack()
		AND
		QRY_HAG_GurHunter_BackpackIsPresent()
		THEN
		SetOnStage(S_HAG_GurHunter_Backpack_b9032389-78c9-4e11-93f4-c89e3559f7f5, 0);
		
		PROC
		PROC_FlagReactionAfterDialog((CHARACTER)_Character, (FLAG)HAG_GurHunter_DisappearOutOfSight_4f8326fa-2636-43f8-b62e-4c086b0d6efe)
		AND
		QRY_HAG_GurHunter_BackpackIsPresent()
		THEN
		Pickup(S_GLO_GurHunter_0e47fcb9-c0c4-4b0c-902b-2d13d209e760, S_HAG_GurHunter_Backpack_b9032389-78c9-4e11-93f4-c89e3559f7f5, "");
		
		PROC
		PROC_FlagReactionAfterDialog((CHARACTER)_Character, (FLAG)HAG_GurHunter_DisappearOutOfSight_4f8326fa-2636-43f8-b62e-4c086b0d6efe)
		THEN
		SetFlag(HAG_GurHunter_BackpackHandled_69e772f5-ed4c-4565-9697-47c1c9eb1bba, NULL_00000000-0000-0000-0000-000000000000);
		PROC_RemoveAllDialogEntriesForSpeaker(S_GLO_GurHunter_0e47fcb9-c0c4-4b0c-902b-2d13d209e760); // Act2 will have a new DB_Dialogs entry for the Gur Hunter
		
		QRY
		QRY_HAG_GurHunter_BackpackIsPresent()
		AND
		IsInTrigger(S_HAG_GurHunter_Backpack_b9032389-78c9-4e11-93f4-c89e3559f7f5, S_GurHunter_OwnershipTrigger_5b882911-1ec0-4d96-b6af-25786f4d298a, 1)
		AND
		IsInInventory(S_HAG_GurHunter_Backpack_b9032389-78c9-4e11-93f4-c89e3559f7f5, 0)
		THEN
		DB_NOOP(1);
		//END_REGION Gur Hunter disappears with / without Astarion
		
		//REGION Cleanup after Gur Hunter dies
		IF
		DB_PermaDefeated(S_GLO_GurHunter_0e47fcb9-c0c4-4b0c-902b-2d13d209e760)
		AND
		DB_GlobalFlag(HAG_GurHunter_Knows_CampLocation_016ce61c-ddc1-4c81-9ded-263d2fa808e0)
		THEN
		ClearFlag(HAG_GurHunter_Knows_CampLocation_016ce61c-ddc1-4c81-9ded-263d2fa808e0);
		//END_REGION Cleanup after Gur Hunter dies
		
		//REGION VB after handling Gur Hunter situation
		PROC
		PROC_FlagReactionAfterDialog((CHARACTER)_Player, HAG_GurHunter_Event_HandedAstarionOver_03c98055-5bad-4d6f-bc8d-4700755227ec)
		THEN
		StartVoiceBark(HAG_GurHunter_VB_BetrayedAstarion_168ebba5-3cfb-e7e5-3bf3-4379f396a524, _Player);
		
		PROC
		PROC_FlagReactionAfterDialog((CHARACTER)_Player, HAG_GurHunter_Event_DidNotRevealCampLocation_f67bd62a-169e-e5c0-9eb3-e2349bffabf6)
		AND
		DB_GlobalFlag((FLAG)ORI_Astarion_Knows_Vampireness_43c71ab0-1aca-484a-950d-54106ae46da5)
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		THEN
		StartVoiceBark(HAG_GurHunter_VB_ProtectedAstarion_e92b4539-197f-8a42-32c2-2732eb024994, _Player);
		
		PROC
		PROC_FlagReactionAfterDialog((CHARACTER)_Player, HAG_GurHunter_Event_RevealedCampLocation_e38aaf71-ac53-25ec-9b47-48e7d0d7b2fa)
		AND
		DB_GlobalFlag((FLAG)ORI_Astarion_Knows_Vampireness_43c71ab0-1aca-484a-950d-54106ae46da5)
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255)
		THEN
		StartVoiceBark(HAG_GurHunter_VB_BetrayedAstarion_168ebba5-3cfb-e7e5-3bf3-4379f396a524, _Player);
		
		IF
		VoiceBarkEnded(HAG_GurHunter_VB_BetrayedAstarion_168ebba5-3cfb-e7e5-3bf3-4379f396a524, _)
		THEN
		SetFlag(HAG_GurHunter_State_DiscussedBetrayal_34b578f3-5b99-4562-8237-4f00f11ec06f, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		PROC
		PROC_FlagReactionAfterDialog((CHARACTER)_Player, HAG_GurHunter_Event_AttackedGurHunter_415b7818-431d-a870-2df2-240e678404b3)
		AND
		DB_GlobalFlag((FLAG)ORI_Astarion_Knows_Vampireness_43c71ab0-1aca-484a-950d-54106ae46da5)
		THEN
		DB_HAG_GurHunter_VBAfterCombat((CHARACTER)_Player);
		
		IF
		CombatEnded(_CombatID)
		AND
		DB_Was_InCombat(S_GLO_GurHunter_0e47fcb9-c0c4-4b0c-902b-2d13d209e760, _CombatID)
		AND
		DB_HAG_GurHunter_VBAfterCombat(_Player)
		THEN
		StartVoiceBark(HAG_GurHunter_VB_ProtectedAstarion_e92b4539-197f-8a42-32c2-2732eb024994, _Player);
		NOT DB_HAG_GurHunter_VBAfterCombat(_Player);
		//END_REGION RD after handling Gur Hunter situation
		
		//REGION Gur Hunter becomes hostile
		PROC
		PROC_GlobalFlagReactionAfterDialog(HAG_GurHunter_State_Hostile_a6f13f9a-26ff-455e-9fdb-adc90777b0bd)
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT1_HAG_GurHunter_3d9379ae-92cc-4786-bb28-c5f886e0be2a, 0);
		
		IF
		RelationChanged(ACT1_HAG_GurHunter_3d9379ae-92cc-4786-bb28-c5f886e0be2a, Hero_a1542c81-6895-929e-4522-10ce218bb360, 0, _)
		AND
		DB_Players(_Player)
		AND
		GetFlag(HAG_GurHunter_HasMet_50a41bc8-ab94-463f-e403-0d10b8969087, _Player, 1)
		THEN
		QuestUpdate(_Player, "ORI_COM_Astarion", "MetGur_Combat");
		
		IF
		FlagSet((FLAG)HAG_GurHunter_State_HunterMetAstarion_33097fd8-2c6a-4e97-b54f-04a4f613f21b, _, _)
		THEN
		AddPreferredAiTargetTag((CHARACTER)S_GLO_GurHunter_0e47fcb9-c0c4-4b0c-902b-2d13d209e760, (TAG)ASTARION_23a46e79-e73c-4043-940f-cb0aace9ab2e);
		//END_REGION Gur Hunter becomes hostile
		
		//REGION Gur Hunter relaunch block
		QRY
		QRY_OriginMoment_PreventRelaunchDialog((DIALOGRESOURCE)HAG_GurHunter_OM_Astarion_AOM_OOM_607d464a-3738-9dd2-c716-6cf3bf507761, _, _)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_OriginMoment_PreventRelaunchDialog((DIALOGRESOURCE)HAG_GurHunter_OM_Astarion_COM_26fdabd4-7604-cebe-11b0-4e7bbf08858d, _, _)
		THEN
		DB_NOOP(1);
		//END_REGION Gur Hunter relaunch block
		
		//REGION Astarion Second Night
		// Despite the name, the main romance night CAMP_GoblinHuntCelebration_SD_ROM_NightWithAstarion can happen either during the Goblin Hunt celebration or outside it
		
		// if the main romance night happens during the goblin hunt celebration, then we unlock Second Night 1 day later
		IF
		FlagSet((FLAG)CAMP_GoblinHuntCelebratrion_SD_ROM_NightWithAstarion_State_Happened_3d7ec52b-fc71-a510-770e-3e27f2235f0d, _, _)
		AND
		QRY_ORI_Astarion_GoblinHuntInProgress()
		THEN
		DB_LongRestCountDown(2, (FLAG)ORI_Astarion_State_SecondNightUnlocked_6fffb264-eac2-49d8-b398-84d6065821d7);
		
		// If the main romance night happened outside the Goblin Hunt Celebration, then we want to trigger SecondNight CRD & ROM during the Goblin Hunt Celebration 
		// instead of the standard Astarion's CRD
		IF
		FlagSet((FLAG)CAMP_GoblinHuntCelebratrion_SD_ROM_NightWithAstarion_State_Happened_3d7ec52b-fc71-a510-770e-3e27f2235f0d, _, _)
		AND
		NOT QRY_ORI_Astarion_GoblinHuntInProgress()
		THEN
		NOT DB_CampNight_CRD((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121, (CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, (DIALOGRESOURCE)CAMP_GoblinHuntTieflingCelebration_CRD_Astarion_bda95b3c-f689-a440-bd81-c333b15c3fc2,(FLAG)NULL_00000000-0000-0000-0000-000000000000);
		NOT DB_CampNight_CRD((FLAG)NIGHT_GoblinHunt_RaiderCelebration_86fee25f-1069-4f17-89fa-4c5b69f82e0b, (CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, (DIALOGRESOURCE)CAMP_GoblinHuntRaiderCelebration_CRD_Astarion_c6a21528-f351-31bd-15ae-115c66be9471,(FLAG)NULL_00000000-0000-0000-0000-000000000000);
		NOT DB_CAMP_GoblinHuntCelebration_SexScenes((FLAG)CAMP_GoblinHunt_State_AstarionPartnerChosen_b7d63377-4329-4199-3140-7f09875cf5b2, (DIALOGRESOURCE)CAMP_GoblinHuntCelebration_SD_ROM_NightWithAstarion_f1f9ad82-3973-9307-7a9d-35c014ee2d68, (CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255);
		DB_CampNight_CRD((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121, (CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, (DIALOGRESOURCE)CAMP_Astarion_CRD_SecondNight_c2048c42-cf09-b49c-4798-dea28ee7abf0,(FLAG)NULL_00000000-0000-0000-0000-000000000000);
		DB_CampNight_CRD((FLAG)NIGHT_GoblinHunt_RaiderCelebration_86fee25f-1069-4f17-89fa-4c5b69f82e0b, (CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255, (DIALOGRESOURCE)CAMP_Astarion_CRD_SecondNight_c2048c42-cf09-b49c-4798-dea28ee7abf0,(FLAG)NULL_00000000-0000-0000-0000-000000000000);
		DB_CAMP_GoblinHuntCelebration_SexScenes((FLAG)CAMP_GoblinHunt_State_AstarionPartnerChosen_b7d63377-4329-4199-3140-7f09875cf5b2, (DIALOGRESOURCE)CAMP_Astarion_SD_ROM_SecondNight_693a16c6-9b9d-fee9-db37-7207ab63c913, (CHARACTER)S_Player_Astarion_c7c13742-bacd-460a-8f65-f864fe41f255);
		
		QRY
		QRY_ORI_Astarion_GoblinHuntInProgress()
		AND
		DB_GlobalFlag((FLAG)NIGHT_GoblinHunt_RaiderCelebration_86fee25f-1069-4f17-89fa-4c5b69f82e0b)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_ORI_Astarion_GoblinHuntInProgress()
		AND
		DB_GlobalFlag((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_ORI_Astarion_GoblinHuntInProgress()
		AND
		DB_Camp_QueuedNight((FLAG)NIGHT_GoblinHunt_RaiderCelebration_86fee25f-1069-4f17-89fa-4c5b69f82e0b)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_ORI_Astarion_GoblinHuntInProgress()
		AND
		DB_Camp_QueuedNight((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121)
		THEN
		DB_NOOP(1);
		
		// If we got a romance scene before Goblin Hunt celebration
		// then in the Second Night dialog we want some reactivity if it's triggered during
		// Goblin Hunt celebration, so we set AnyCelebration flag while a celebration is on
		IF
		DB_CAMP_Astarion_CelebrationFlags(_, _CelebrationHelperFlag)
		THEN
		DB_GLO_CompoundFlag(_CelebrationHelperFlag, (FLAG)CAMP_Astarion_SecondNight_AnyCelebration_a7bbbb0d-a3f4-4e8c-afcf-c6bc366bf2a5);
		
		PROC
		PROC_CampNight_StartSelected()
		AND
		DB_Camp_QueuedNight(_CelebrationFlag)
		AND
		DB_CAMP_Astarion_CelebrationFlags(_CelebrationFlag, _CelebrationHelperFlag)
		THEN
		PROC_GlobalSetFlagAndCache(_CelebrationHelperFlag);
		
		IF
		DB_CAMP_Astarion_CelebrationFlags(_CelebrationFlag, _CelebrationHelperFlag)
		AND
		DB_GlobalFlag(_CelebrationHelperFlag)
		AND 
		NOT DB_Camp_QueuedNight(_CelebrationFlag)
		THEN
		PROC_GlobalClearFlagAndCache(_CelebrationHelperFlag);
		
		IF
		FlagSet((FLAG)ORI_State_PartneredWithAstarion_30819c8d-b39d-42e7-acd1-2a8c2c309994, _, _)
		THEN
		SetFlag(ORI_Astarion_State_SecondNightCancelled_eb851137-4b2c-4724-bbb1-ebd24651e818);
		
		// visiting SCL unlocks the night, unless we are already waiting for it to be unlocked
		IF
		FlagSet(VISITEDREGION_SCL_Main_A_f6e72539-9bc6-42e1-a20f-390f3a17ad8d, _, _)
		AND
		NOT DB_LongRestCountDown(_, ORI_Astarion_State_SecondNightUnlocked_6fffb264-eac2-49d8-b398-84d6065821d7)
		THEN
		SetFlag((FLAG)ORI_Astarion_State_SecondNightUnlocked_6fffb264-eac2-49d8-b398-84d6065821d7);
		//END_REGION
		
		//REGION Killing Gur Hunter in dialog
		IF
		FlagSet((FLAG)HAG_GurHunter_Event_KillAfterDialog_bfa0791f-097f-4a3a-83d5-df0ff9fbb880, _Speaker, _ID)
		THEN
		SetFlag((FLAG)HAG_GurHunter_Event_KillAfterDialogWithClear_5e252d21-09c9-433f-985d-e344cd25532b, _Speaker, _ID);
		//END_REGION
	}
	EXIT
	{
	}
}
