		SetOnStage(_Kid,0);
		
		IF
		DB_LOW_SWS_AtWall_Guards(_Guard)
		THEN
		PROC_CharacterDisableCrime(_Guard,"DangerousMonsterReaction");
		PROC_CharacterDisableCrime(_Guard,"DangerousMonsterReactionFallback");
		
		
		PROC
		PROC_LOW_SWS_Disabled()
		AND
		IsInTrigger(S_LOW_SWS_AtWall_SW_04fd807f-ca2c-401e-9972-ecce7ba14b42,S_LOW_SWS_AtWall_Zone_SW_0f0fcf95-9c72-48be-851e-928f9e6170be,1)
		AND
		DB_LOW_SWS_AtWall_Kids(_Kid)
		THEN
		PROC_AppearOutOfSightTo(_Kid,S_LOW_SWS_AtWall_SW_04fd807f-ca2c-401e-9972-ecce7ba14b42,_Kid,"LOW_SWS_AtWall_KidAppears");
		
		IF
		EntityEvent(_Kid,"LOW_SWS_AtWall_KidAppears")
		AND
		DB_LOW_SWS_AtWall_Kids((CHARACTER)_Kid)
		THEN
		PROC_CharacterMoveTo(_Kid,S_LOW_SWS_AtWall_SW_04fd807f-ca2c-401e-9972-ecce7ba14b42,"Run","");
		
		
		
		PROC
		PROC_LOW_SWS_Disabled()
		AND
