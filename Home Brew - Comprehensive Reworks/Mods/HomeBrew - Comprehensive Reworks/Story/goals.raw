		DB_PermaDefeatedFlag(S_GLO_GithKnight_2adce2df-0799-49dc-b867-ba7ca21e9aea, (FLAG)GLO_GithKnight_State_PermaDefeated_c354b407-b88d-4920-96a2-80555d6fc0b0);
