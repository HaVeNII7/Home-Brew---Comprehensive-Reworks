		SetFlag((FLAG)IRN_IronThrone_State_IndividualPrisonerEscaped_a09945e7-6436-40e7-908e-22a699ef296e, S_GLO_IronThrone_EscapingHostage_614ceeec-24a5-4491-98b3-a83ab235f158);
		SetFlag((FLAG)IRN_IronThrone_State_IndividualPrisonerEscaped_a09945e7-6436-40e7-908e-22a699ef296e, S_GLO_Ravengard_f6620372-ebd0-4511-a39d-8c2d4ad03f03);
		SetFlag((FLAG)IRN_IronThrone_State_IndividualPrisonerEscaped_a09945e7-6436-40e7-908e-22a699ef296e, S_GLO_SocietyOfBrilliance_MindFlayer_1f9937ef-9207-4db6-a833-e4083d571f53);
		SetFlag((FLAG)LOW_Allandra_State_EulogyFinished_e05a20ae-7793-5919-e119-e9e29cddce64);
		SetFlag((FLAG)LOW_BellyOfTheBeast_State_PlayersWentToIronThroneWithBeastmaster_61dd108a-9a51-4edc-b070-3da42574d0d9);
		PROC_TeleportPartiesTo((TRIGGER)S_LOW_DockWarehouse_ReturnFromIronThronePos_d1a59a82-8b4b-4f0a-a382-14a997888333, "");
		PROC_State_Progress((ITEM)S_GLO_IronThrone_StateProgressHelper_954459bd-8fc3-4c16-8224-0343cacb1a01, "IRN_IronThrone", "BackAtDocks");
		PROC_State_Progress((ITEM)S_GLO_IronThrone_StateProgressHelper_954459bd-8fc3-4c16-8224-0343cacb1a01, "IRN_IronThrone", "WaveservantsAttack");
		
		//END_REGION
		
		//REGION Beastmaster
		
		PROC
		PROC_SpotPlayers_Spotted((CHARACTER)S_GLO_Beastmaster_d999308c-8a20-4c31-b9e2-f89ff3ee1cd1, "LOW_Beastmaster_Spotted", _Player)
		AND
		QRY_StartDialog((DIALOGRESOURCE)LOW_BellyOfTheBeast_Beastmaster_a952200e-814d-ca21-8c05-1971b5ee86b0, S_GLO_Beastmaster_d999308c-8a20-4c31-b9e2-f89ff3ee1cd1, _Player)
		THEN
		DB_NOOP(1);
		
		IF
		DialogStarted((DIALOGRESOURCE)LOW_BellyOfTheBeast_Beastmaster_a952200e-814d-ca21-8c05-1971b5ee86b0, _)
		THEN
		PROC_SpotPlayers_StopSpotting("LOW_Beastmaster_Spotted");
		
		//END_REGION
		
		//REGION Misc
		//Black Blood VB
		IF
		FlagSet((FLAG)LOW_BellyOfTheBeast_Knows_WaveservantsWantBeastmasterDead_2bed3d0c-d9b1-471b-ac24-ec1a6d24819e, _, _)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_BellyOfTheBeast_State_TalkedToBeastmaster_6081a34a-dd2e-7830-fe29-acc57a233c71)
		THEN
		DB_KnowledgeCheckTrigger_AD("LOW_BellyOfTheBeast_OilCommentCheck", 
									S_LOW_WarehouseBlackBloodPerceptionArea_f91f7bbe-8ec7-494e-aefb-05194951338b, 
									"Perception", 
									(DIFFICULTYCLASS)Act3_Easy_5028066b-6ea0-4a6a-9e3e-53bee62559a7, 
									LOW_BellyOfTheBeast_PAD_OilComment_be471333-c1c8-8906-6097-e09ae45b9cd9, 
									NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		FlagSet((FLAG)LOW_BellyOfTheBeast_State_TalkedToBeastmaster_6081a34a-dd2e-7830-fe29-acc57a233c71, _, _)
		THEN
		PROC_KnowledgeCheck_Clear(S_LOW_WarehouseBlackBloodPerceptionArea_f91f7bbe-8ec7-494e-aefb-05194951338b);
		
		//END_REGION
		
		//REGION Going to Iron Throne
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)LOW_BellyOfTheBeast_State_SubmersibleReadyToDepart_a2ae474a-de65-4fde-b019-b1fdb6306acb)
		THEN
		AutoSave();
		PROC_LOW_BellyOfTheBeast_BeastmasterBoardsSubmersible();
		DB_LOW_BellyOfTheBeast_BeastmasterBoardingSubmersible(1);
		
		//ToDo: Expand on this for OB
		PROC
		PROC_LOW_BellyOfTheBeast_BeastmasterBoardsSubmersible()
		THEN
		PROC_CharacterMoveTo(S_GLO_Beastmaster_d999308c-8a20-4c31-b9e2-f89ff3ee1cd1, (TRIGGER)S_LOW_DockWarehouse_ReturnFromIronThronePos_d1a59a82-8b4b-4f0a-a382-14a997888333, "Walk", "LOW_BellyOfTheBeast_BeastmasterBoardsSubmersible");
		
		IF
		EntityEvent(_Beastmaster, "LOW_BellyOfTheBeast_BeastmasterBoardsSubmersible")
		THEN
		SetTag(_Beastmaster, (TAG)NO_LEVELTEMPLATE_TRANSFER_577229d7-a806-40c9-81fc-3e843d1955c0);
		TeleportTo(_Beastmaster, (TRIGGER)S_IRN_BeastmasterSubmersiblePosition_efa8cea9-71ca-4ac1-92bc-7bc9ecdeb474, "", 0, 0, 0, 0, 1); //ToDo: Make submersible interior playable
		NOT DB_LOW_BellyOfTheBeast_BeastmasterBoardingSubmersible(1);
		SetFlag((FLAG)LOW_BellyOfTheBeast_State_PlayersWentToIronThroneWithBeastmaster_61dd108a-9a51-4edc-b070-3da42574d0d9);
		
		//END_REGION
		
		//REGION Return from Iron Throne
		PROC
		PROC_State_Changed(_, "IRN_IronThrone", "WaveservantsAttack")
		THEN
		PROC_LOW_WaterQueensHouse_EndFuneral();
		PROC_LOW_BellyOfTheBeast_SetupWaveservants();
		
		PROC
		PROC_LOW_BellyOfTheBeast_SetupWaveservants()
		AND
		DB_LOW_BellyOfTheBeast_WaveservantAttackers(_Waveservant, _)
		AND
		NOT DB_GlobalFlag(LOW_BellyOfTheBeast_State_WaveservantsInAmbush_b5d448d1-36c9-4deb-8426-45c0fa67f9d1)
		AND
		NOT DB_Defeated(_Waveservant)
		THEN
		PROC_LOW_BellyOfTheBeast_SetupWaveservants_Ambush();
		
		PROC
		PROC_LOW_BellyOfTheBeast_SetupWaveservants_Ambush()
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)LOW_BellyOfTheBeast_State_WaveservantsInAmbush_b5d448d1-36c9-4deb-8426-45c0fa67f9d1);
		
		PROC
		PROC_LOW_BellyOfTheBeast_SetupWaveservants_Ambush()
		AND
		DB_LOW_BellyOfTheBeast_WaveservantAttackers(_Waveservant, _WarehouseBasementPos)
		AND
		NOT DB_Defeated(_Waveservant)
		THEN
		SetFaction(_Waveservant, (FACTION)ACT3_LOW_BellyOfTheBeast_WaveservantAttackers_a1e897c4-6279-43f7-8ad8-a66333c38710);
		TeleportTo(_Waveservant, _WarehouseBasementPos, "", 0, 0, 0, 0 ,1);
		SetCombatGroupID(_Waveservant, "LOW_BellyOfTheBeast_Waveservants");
		DB_GLO_DefeatCounter(_Waveservant, "LOW_BellyOfTheBeast_Waveservants");
		SetHasDialog(_Waveservant, 1);
		
		PROC
		PROC_LOW_BellyOfTheBeast_SetupWaveservants()
		THEN
		PROC_TriggerRegisterForPlayers((TRIGGER)S_LOW_WaveservantsAmbushArea_387d4a70-ca2d-483b-a0f9-07ab487b6e20);
		PROC_RemoveAllDialogEntriesForSpeaker(S_LOW_AllandraGrey_32d78583-07c6-4160-9ec7-3a24b15149c8);
		
		PROC
		PROC_CharacterRegisterCrimeHandleIgnoresAfter(_CrimeID, _, _, _, S_GLO_Beastmaster_d999308c-8a20-4c31-b9e2-f89ff3ee1cd1)
		AND
		DB_LOW_BellyOfTheBeast_WaveservantAttackers(_Waveservant, _)
		THEN
		CrimeIgnoreCrime(_CrimeID, _Waveservant);
		
		PROC
		PROC_CharacterRegisterCrimeHandleIgnoresAfter(_CrimeID, _, _, _, S_GLO_Beastmaster_d999308c-8a20-4c31-b9e2-f89ff3ee1cd1)
		THEN
		CrimeIgnoreCrime(_CrimeID, S_GLO_SocietyOfBrilliance_MindFlayer_1f9937ef-9207-4db6-a833-e4083d571f53);
		
		IF
		EnteredTrigger(_SpottedPlayer, (TRIGGER)S_LOW_WaveservantsAmbushArea_387d4a70-ca2d-483b-a0f9-07ab487b6e20)
		AND
		QRY_GetClosestAvailableCharacterTo(_SpottedPlayer, 0)
		AND
		DB_ClosestAvailableCharacterTo_PreferAvatar((CHARACTER)_Avatar, (CHARACTER)_SpottedPlayer, _Dist, 1)
		AND
		_Dist <= 15.0
		AND
		NOT QRY_SpeakerIsAvailable(S_GLO_Beastmaster_d999308c-8a20-4c31-b9e2-f89ff3ee1cd1)
		AND
		NOT DB_OnlyOnce("LOW_BellyOfTheBeast_ConfrontationDialogStarted")
		AND
		QRY_StartDialog((DIALOGRESOURCE)LOW_BellyOfTheBeast_WaveservantsConfrontation_f00cc5c0-68ef-9825-425e-5169af57ca3d, S_LOW_AllandraGrey_32d78583-07c6-4160-9ec7-3a24b15149c8, NULL_00000000-0000-0000-0000-000000000000, _Avatar)
		THEN
		DB_OnlyOnce("LOW_BellyOfTheBeast_ConfrontationDialogStarted");
		
		IF
		EnteredTrigger(_SpottedPlayer, (TRIGGER)S_LOW_WaveservantsAmbushArea_387d4a70-ca2d-483b-a0f9-07ab487b6e20)
		AND
		QRY_GetClosestAvailableCharacterTo(_SpottedPlayer, 0)
		AND
		DB_ClosestAvailableCharacterTo((CHARACTER)_Player, (CHARACTER)_SpottedPlayer, _Dist)
		AND
		_Dist <= 15.0
		AND
		NOT QRY_SpeakerIsAvailable(S_GLO_Beastmaster_d999308c-8a20-4c31-b9e2-f89ff3ee1cd1)
		AND
		NOT DB_OnlyOnce("LOW_BellyOfTheBeast_ConfrontationDialogStarted")
		AND
		QRY_StartDialog((DIALOGRESOURCE)LOW_BellyOfTheBeast_WaveservantsConfrontation_f00cc5c0-68ef-9825-425e-5169af57ca3d, S_LOW_AllandraGrey_32d78583-07c6-4160-9ec7-3a24b15149c8, NULL_00000000-0000-0000-0000-000000000000, _Player)
		THEN
		DB_OnlyOnce("LOW_BellyOfTheBeast_ConfrontationDialogStarted");
		
		IF
		EnteredTrigger(_SpottedPlayer, (TRIGGER)S_LOW_WaveservantsAmbushArea_387d4a70-ca2d-483b-a0f9-07ab487b6e20)
		AND
		QRY_GetClosestAvailableCharacterTo(_SpottedPlayer, 0)
		AND
		DB_ClosestAvailableCharacterTo_PreferAvatar((CHARACTER)_Avatar, _SpottedPlayer, _Dist, 1)
		AND
		_Dist <= 15.0
		AND
		QRY_SpeakerIsAvailable(S_GLO_Beastmaster_d999308c-8a20-4c31-b9e2-f89ff3ee1cd1)
		AND
		NOT DB_OnlyOnce("LOW_BellyOfTheBeast_ConfrontationDialogStarted")
		AND
		QRY_StartDialog((DIALOGRESOURCE)LOW_BellyOfTheBeast_WaveservantsConfrontation_f00cc5c0-68ef-9825-425e-5169af57ca3d, S_LOW_AllandraGrey_32d78583-07c6-4160-9ec7-3a24b15149c8, S_GLO_Beastmaster_d999308c-8a20-4c31-b9e2-f89ff3ee1cd1, _Avatar)
		THEN
		DB_OnlyOnce("LOW_BellyOfTheBeast_ConfrontationDialogStarted");
		
		IF
		EnteredTrigger(_SpottedPlayer, (TRIGGER)S_LOW_WaveservantsAmbushArea_387d4a70-ca2d-483b-a0f9-07ab487b6e20)
		AND
		QRY_GetClosestAvailableCharacterTo(_SpottedPlayer, 0)
		AND
		DB_ClosestAvailableCharacterTo((CHARACTER)_Player, _SpottedPlayer, _Dist)
		AND
		_Dist <= 15.0
		AND
		QRY_SpeakerIsAvailable(S_GLO_Beastmaster_d999308c-8a20-4c31-b9e2-f89ff3ee1cd1)
		AND
		NOT DB_OnlyOnce("LOW_BellyOfTheBeast_ConfrontationDialogStarted")
		AND
		QRY_StartDialog((DIALOGRESOURCE)LOW_BellyOfTheBeast_WaveservantsConfrontation_f00cc5c0-68ef-9825-425e-5169af57ca3d, S_LOW_AllandraGrey_32d78583-07c6-4160-9ec7-3a24b15149c8, S_GLO_Beastmaster_d999308c-8a20-4c31-b9e2-f89ff3ee1cd1, _Player)
		THEN
		DB_OnlyOnce("LOW_BellyOfTheBeast_ConfrontationDialogStarted");
		
		//Backup if dialog for some reason fails to start
		QRY
		QRY_SelectCustomDialog(_Waveservant, _Player)
		AND
		DB_LOW_BellyOfTheBeast_WaveservantAttackers((CHARACTER)_Waveservant, _)
		AND
		DB_State_Current(S_GLO_IronThrone_StateProgressHelper_954459bd-8fc3-4c16-8224-0343cacb1a01, "IRN_IronThrone", "WaveservantsAttack")
		AND
		NOT QRY_SpeakerIsAvailable(S_GLO_Beastmaster_d999308c-8a20-4c31-b9e2-f89ff3ee1cd1)
		AND
		QRY_StartDialog((DIALOGRESOURCE)LOW_BellyOfTheBeast_WaveservantsConfrontation_f00cc5c0-68ef-9825-425e-5169af57ca3d, S_LOW_AllandraGrey_32d78583-07c6-4160-9ec7-3a24b15149c8, NULL_00000000-0000-0000-0000-000000000000, _Player)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_SelectCustomDialog(_Waveservant, _Player)
		AND
		DB_LOW_BellyOfTheBeast_WaveservantAttackers((CHARACTER)_Waveservant, _)
		AND
		DB_State_Current(S_GLO_IronThrone_StateProgressHelper_954459bd-8fc3-4c16-8224-0343cacb1a01, "IRN_IronThrone", "WaveservantsAttack")
		AND
		QRY_SpeakerIsAvailable(S_GLO_Beastmaster_d999308c-8a20-4c31-b9e2-f89ff3ee1cd1)
		AND
		QRY_StartDialog((DIALOGRESOURCE)LOW_BellyOfTheBeast_WaveservantsConfrontation_f00cc5c0-68ef-9825-425e-5169af57ca3d, S_LOW_AllandraGrey_32d78583-07c6-4160-9ec7-3a24b15149c8, S_GLO_Beastmaster_d999308c-8a20-4c31-b9e2-f89ff3ee1cd1, _Player)
		THEN
		DB_NOOP(1);
		
		IF
		RelationChanged(_PlayerFaction, (FACTION)ACT3_LOW_BellyOfTheBeast_WaveservantAttackers_a1e897c4-6279-43f7-8ad8-a66333c38710, 0, _)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_BellyOfTheBeast_Event_WaveservantsTurnHostile_75616c87-a135-430a-870c-fbbec5951736)
		THEN
		PROC_ClearStoryMove((CHARACTER)S_GLO_Beastmaster_d999308c-8a20-4c31-b9e2-f89ff3ee1cd1); 
		PROC_GlobalSetFlagAndCache((FLAG)LOW_BellyOfTheBeast_Event_WaveservantsTurnHostile_75616c87-a135-430a-870c-fbbec5951736);
		
		IF
		FlagSet((FLAG)LOW_BellyOfTheBeast_Event_WaveservantsTurnHostile_75616c87-a135-430a-870c-fbbec5951736,_,_)
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT3_LOW_BellyOfTheBeast_Beastmaster_df47ddde-7444-42e9-a50f-3371a7b21cb8, 100);
		PROC_SetRelationToPlayers((FACTION)ACT3_LOW_BellyOfTheBeast_WaveservantAttackers_a1e897c4-6279-43f7-8ad8-a66333c38710, 0);
		PROC_SetRelationMutual((FACTION)ACT3_LOW_BellyOfTheBeast_Beastmaster_df47ddde-7444-42e9-a50f-3371a7b21cb8, (FACTION)ACT3_LOW_BellyOfTheBeast_WaveservantAttackers_a1e897c4-6279-43f7-8ad8-a66333c38710, 0);
		
		IF
		RelationChanged(_PlayerFaction, (FACTION)ACT3_LOW_BellyOfTheBeast_Beastmaster_df47ddde-7444-42e9-a50f-3371a7b21cb8, 0, _)
		AND
		DB_Players(_Player)
		AND
		GetFaction(_Player, _PlayerFaction)
		AND
		DB_GlobalFlag((FLAG)LOW_BellyOfTheBeast_Event_BeastmasterLeavesWithWaveservants_774fdae4-a02e-4a03-a820-0edf8e316cc6)
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT3_LOW_BellyOfTheBeast_WaveservantAttackers_a1e897c4-6279-43f7-8ad8-a66333c38710, 0);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)LOW_BellyOfTheBeast_Event_WaveservantsLeaveDockWarehouse_2b60d130-03d3-4867-a7d7-39b0c5447ad0)
		THEN
		PROC_State_Progress((ITEM)S_GLO_IronThrone_StateProgressHelper_954459bd-8fc3-4c16-8224-0343cacb1a01, "IRN_IronThrone", "BackInBasement");
		
		IF
		DialogStarted((DIALOGRESOURCE)LOW_BellyOfTheBeast_WaveservantsConfrontation_f00cc5c0-68ef-9825-425e-5169af57ca3d,_)
		THEN
		PROC_TriggerUnregisterForPlayers((TRIGGER)S_LOW_WaveservantAmbushArea_e90f019a-06a6-44ee-b02c-756d06550372);
		
		IF
		EnteredCombat(S_LOW_AllandraGrey_32d78583-07c6-4160-9ec7-3a24b15149c8, _CombatGUID)
		AND
		DB_GlobalFlag((FLAG)LOW_BellyOfTheBeast_Event_WaveservantsTurnHostile_75616c87-a135-430a-870c-fbbec5951736)
		THEN
		DB_LOW_BellyOfTheBeast_WaveservantAmbushCombat(_CombatGUID);
		
		IF
		CombatEnded(_CombatGUID)
		AND
		DB_LOW_BellyOfTheBeast_WaveservantAmbushCombat(_CombatGUID)
		AND
		QRY_OnlyOnce("LOW_BellyOfTheBeast_WaveservantsLeaveAfterCombat")
		AND
		NOT DB_GlobalFlag(LOW_BellyOfTheBeast_State_WaveservantsAllDefeated_a637ae1a-90f2-4556-bf60-15ab1c2b03f5)
		AND
		DB_LOW_BellyOfTheBeast_WaveservantAttackers(_Waveservant,_)
		AND
		NOT DB_PermaDefeated(_Waveservant)
		THEN
		PROC_NotifyWhenReadyToMoveOn(_Waveservant, "LOW_BellyOfTheBeast_AllandraReady");
		
		PROC
		PROC_ReadyToMoveOn(_Waveservant, "LOW_BellyOfTheBeast_AllandraReady")
		AND
		NOT DB_GlobalFlag((FLAG)LOW_BellyOfTheBeast_Event_WaveservantsLeaveDockWarehouse_2b60d130-03d3-4867-a7d7-39b0c5447ad0)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)LOW_BellyOfTheBeast_Event_WaveservantsLeaveDockWarehouse_2b60d130-03d3-4867-a7d7-39b0c5447ad0);
		PROC_State_Progress((ITEM)S_GLO_IronThrone_StateProgressHelper_954459bd-8fc3-4c16-8224-0343cacb1a01, "IRN_IronThrone", "BackInBasement");
		
		IF
		FlagSet((FLAG)LOW_BellyOfTheBeast_State_WaveservantsAllDefeated_a637ae1a-90f2-4556-bf60-15ab1c2b03f5, _, _)
		THEN
		AutoSave();
		
		IF
		FlagSet((FLAG)LOW_BellyOfTheBeast_State_WaveservantsAllDefeated_a637ae1a-90f2-4556-bf60-15ab1c2b03f5, _, _)
		AND
		DB_PermaDefeated(S_GLO_Beastmaster_d999308c-8a20-4c31-b9e2-f89ff3ee1cd1)
		THEN
		PROC_State_Progress((ITEM)S_GLO_IronThrone_StateProgressHelper_954459bd-8fc3-4c16-8224-0343cacb1a01, "IRN_IronThrone", "BackInBasement");
		
		IF
		FlagSet((FLAG)LOW_BellyOfTheBeast_State_WaveservantsAllDefeated_a637ae1a-90f2-4556-bf60-15ab1c2b03f5, _, _)
		AND
		NOT DB_PermaDefeated(S_GLO_Beastmaster_d999308c-8a20-4c31-b9e2-f89ff3ee1cd1)
		THEN
		PROC_NotifyWhenReadyToMoveOn((CHARACTER)S_GLO_Beastmaster_d999308c-8a20-4c31-b9e2-f89ff3ee1cd1, "LOW_BellyOfTheBeast_BeastmasterReady"); 
		
		PROC
		PROC_ReadyToMoveOn((CHARACTER)_Beastmaster, "LOW_BellyOfTheBeast_BeastmasterReady")
		AND
		QRY_GetClosestAvailableCharacterTo(_Beastmaster, 0)
		AND
		DB_ClosestAvailableCharacterTo_PreferAvatar((CHARACTER)_Avatar, _Beastmaster, _Dist, 1)
		AND
		_Dist <= 15.0
		AND
		NOT DB_OnlyOnce("LOW_BellyOfTheBeast_RewardDialogStarted")
		AND
		QRY_StartDialog((DIALOGRESOURCE)LOW_BellyOfTheBeast_BeastmasterReward_543627ab-c891-3d24-3b94-efca7ba2f0ff, _Beastmaster, _Avatar)
		THEN
		DB_OnlyOnce("LOW_BellyOfTheBeast_RewardDialogStarted");
		
		PROC
		PROC_ReadyToMoveOn((CHARACTER)_Beastmaster, "LOW_BellyOfTheBeast_BeastmasterReady")
		AND
		QRY_GetClosestAvailableCharacterTo(_Beastmaster, 0)
		AND
		DB_ClosestAvailableCharacterTo((CHARACTER)_Player, _Beastmaster, _Dist)
		AND
		_Dist <= 15.0
		AND
		NOT DB_OnlyOnce("LOW_BellyOfTheBeast_RewardDialogStarted")
		AND
		QRY_StartDialog((DIALOGRESOURCE)LOW_BellyOfTheBeast_BeastmasterReward_543627ab-c891-3d24-3b94-efca7ba2f0ff, _Beastmaster, _Player)
		THEN
		DB_OnlyOnce("LOW_BellyOfTheBeast_RewardDialogStarted");
		
		
		IF
		DialogEnded((DIALOGRESOURCE)LOW_BellyOfTheBeast_WaveservantsReward_27afb218-29bb-b645-63b3-7aaac5cfd200, _)
		THEN
		PROC_State_Progress((ITEM)S_GLO_IronThrone_StateProgressHelper_954459bd-8fc3-4c16-8224-0343cacb1a01, "IRN_IronThrone", "BackInBasement");
		
		IF
		DialogEnded((DIALOGRESOURCE)LOW_BellyOfTheBeast_BeastmasterReward_543627ab-c891-3d24-3b94-efca7ba2f0ff, _)
		THEN
		PROC_State_Progress((ITEM)S_GLO_IronThrone_StateProgressHelper_954459bd-8fc3-4c16-8224-0343cacb1a01, "IRN_IronThrone", "BackInBasement");
		
		PROC
		PROC_State_Changed(_, "IRN_IronThrone", "BackInBasement")
		AND
		DB_GlobalFlag((FLAG)LOW_BellyOfTheBeast_Event_WaveservantsLeaveDockWarehouse_2b60d130-03d3-4867-a7d7-39b0c5447ad0)
		AND
		DB_LOW_BellyOfTheBeast_WaveservantAttackers(_Waveservant, _)
		THEN
		PROC_CharacterMoveTo((CHARACTER)_Waveservant, TeleportTrigger_ToWarehouse_001_785189c1-e595-402c-aac7-22a07ed157f4, "Walk", "LOW_IronThrone_WaveservantLeft");
		SetHasDialog(_Waveservant, 0);
		
		PROC
		PROC_State_Changed(_, "IRN_IronThrone", "BackInBasement")
		AND
		DB_GlobalFlag((FLAG)LOW_BellyOfTheBeast_Event_WaveservantsLeaveDockWarehouse_2b60d130-03d3-4867-a7d7-39b0c5447ad0)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_BellyOfTheBeast_Event_WaveservantsTurnHostile_75616c87-a135-430a-870c-fbbec5951736)
		AND
		NOT DB_PermaDefeated((CHARACTER)S_GLO_Beastmaster_d999308c-8a20-4c31-b9e2-f89ff3ee1cd1)
		THEN
		PROC_CharacterMoveTo((CHARACTER)S_GLO_Beastmaster_d999308c-8a20-4c31-b9e2-f89ff3ee1cd1, TeleportTrigger_ToWarehouse_001_785189c1-e595-402c-aac7-22a07ed157f4, "Walk", "LOW_IronThrone_WaveservantLeft");
		
		IF
		EntityEvent(_Character, "LOW_IronThrone_WaveservantLeft")
		THEN
		PROC_SetOnStage(_Character, 0);
		
		PROC
		PROC_State_Changed(S_GLO_IronThrone_StateProgressHelper_954459bd-8fc3-4c16-8224-0343cacb1a01, "IRN_IronThrone", "Finished")
		AND
		DB_GlobalFlag((FLAG)LOW_BellyOfTheBeast_State_WaveservantsInAmbush_b5d448d1-36c9-4deb-8426-45c0fa67f9d1)
		AND
		DB_LOW_BellyOfTheBeast_WaveservantAttackers(_Waveservant, _)
		AND
		NOT DB_PermaDefeated(_Waveservant)
		THEN
		DB_LOW_BellyOfTheBeast_AtLeastOneWaveservantAlive(1);
		PROC_SetOnStage(_Waveservant, 0);
		
		PROC
		PROC_State_Changed(S_GLO_IronThrone_StateProgressHelper_954459bd-8fc3-4c16-8224-0343cacb1a01, "IRN_IronThrone", "Finished")
		AND
		DB_LOW_BellyOfTheBeast_AtLeastOneWaveservantAlive(1)
		AND
		DB_GlobalFlag((FLAG)LOW_BellyOfTheBeast_Event_BeastmasterLeavesWithWaveservants_774fdae4-a02e-4a03-a820-0edf8e316cc6)
		THEN
		PROC_SetOnStage(S_GLO_Beastmaster_d999308c-8a20-4c31-b9e2-f89ff3ee1cd1, 0);
		
		PROC
		PROC_State_Changed(S_GLO_IronThrone_StateProgressHelper_954459bd-8fc3-4c16-8224-0343cacb1a01, "IRN_IronThrone", "Finished")
		AND
		DB_LOW_BellyOfTheBeast_AtLeastOneWaveservantAlive(1)
		AND
		DB_GlobalFlag((FLAG)LOW_BellyOfTheBeast_Event_WaveservantsTurnHostile_75616c87-a135-430a-870c-fbbec5951736)
		THEN
		Die(S_GLO_Beastmaster_d999308c-8a20-4c31-b9e2-f89ff3ee1cd1, DEATHTYPE.Cold, NULL_00000000-0000-0000-0000-000000000000, 1, 1, 0.0);
		
		PROC
		PROC_State_Changed(S_GLO_IronThrone_StateProgressHelper_954459bd-8fc3-4c16-8224-0343cacb1a01, "IRN_IronThrone", "Finished")
		AND
		DB_LOW_BellyOfTheBeast_AtLeastOneWaveservantAlive(1)
		AND
		DB_GlobalFlag((FLAG)LOW_BellyOfTheBeast_State_WaveservantsInAmbush_b5d448d1-36c9-4deb-8426-45c0fa67f9d1)
		THEN
		PROC_LOW_WaterQueensHouse_ShouldReturnFromIronThrone();
		
		//END_REGION
	}
	EXIT
	{
	}
}
