		//	- Wave 1
		DB_SCL_ShadowCurse_CursedCharacters((CHARACTER)S_HAV_Wave0_Raven_Dire_ShadowCursed_007_2ad074e8-a5a4-452e-bcfe-7a946887a539);
		DB_SCL_ShadowCurse_CursedCharacters((CHARACTER)S_HAV_Wave0_Raven_Dire_ShadowCursed_012_1303ff46-5200-4986-9d73-d85ad7918ec5);
