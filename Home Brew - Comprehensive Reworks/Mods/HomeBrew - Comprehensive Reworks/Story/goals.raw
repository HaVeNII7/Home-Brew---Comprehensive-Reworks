Goal(316).Title("Act2");
Goal(316)
{
	INIT
	{
		DB_CheckLevelStart("SCL_Main_A");
		DB_CheckLevelStart("WLD_SharTemple_E");
		
		DB_RegionSafeSpot("SCL_Main_A",(TRIGGER)StartPoint_000_f968a8d3-b06d-4fc2-acf1-1e650e35e52d);
	}
	KB
	{
		IF
		LevelLoaded("SCL_Main_A")
		THEN
		GoalCompleted;
		
		IF
		DB_CheckLevelStart("SCL_Main_A")
		AND
		DB_CurrentLevel("SCL_Main_A")
		THEN
		GoalCompleted;
		
		IF
		LevelLoaded("WLD_SharTemple_E")
		THEN
		GoalCompleted;
		
		IF
		DB_CheckLevelStart("WLD_SharTemple_E")
		AND
		DB_CurrentLevel("WLD_SharTemple_E")
		THEN
		GoalCompleted;
	}
	EXIT
	{
	}
}
