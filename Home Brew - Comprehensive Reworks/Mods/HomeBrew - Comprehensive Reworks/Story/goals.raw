		DB_OriginCampFlags((CHARACTER)S_GLO_Orthon_1dc8091d-2af6-4d33-9268-998ef266d19c, (FLAG)ORTHON_d7bad33e-4308-4119-ad60-9ce95711c2f5, (FLAG)NULL_00000000-0000-0000-0000-000000000000, (FLAG)NULL_00000000-0000-0000-0000-000000000000, (FLAG)NULL_00000000-0000-0000-0000-000000000000, (FLAG)NULL_00000000-0000-0000-0000-000000000000);
		DB_OriginInPartyDialog(S_GLO_Orthon_1dc8091d-2af6-4d33-9268-998ef266d19c, (DIALOGRESOURCE)CAMP_Orthon_DiabolistHint_698c239b-4a50-95c7-c9b5-02f1adfa0098);
		
		DB_CAMP_OrthonVisit_PosTriggers("FARM", (TRIGGER)S_CAMP_FARM_Orthon_6e0e4155-a468-4339-93d4-5b43dbdc848a);
		DB_CAMP_OrthonVisit_PosTriggers("SLUMS", (TRIGGER)S_CAMP_SLUMS_Orthon_9fa37f75-35e4-4171-8af9-ce080df080ff);
		DB_CAMP_OrthonVisit_PosTriggers("ELFSONG", (TRIGGER)S_CAMP_ELFSONG_Orthon_18dc5deb-bac4-42a3-aea5-9953157575e5);
		
	}
	KB
	{
		IF
		DB_CAMP_OrthonVisit_PosTriggers(_Camp, _Trigger)
		THEN
		DB_ORI_OriginCampData(S_GLO_Orthon_1dc8091d-2af6-4d33-9268-998ef266d19c, _Camp, _Trigger);
		
		PROC
		PROC_CampNight_StartSelected()
		AND
		DB_Camp_QueuedNight((FLAG)NIGHT_OrthonVisit_0f675d1a-5b1b-4e44-99fb-628ee14016e9)
		THEN
		PurgeOsirisQueue(S_GLO_Orthon_1dc8091d-2af6-4d33-9268-998ef266d19c);
		PROC_SetAnubisConfig((CHARACTER)S_GLO_Orthon_1dc8091d-2af6-4d33-9268-998ef266d19c, "DefaultCharacter");
		SetEntityEvent(S_GLO_Orthon_1dc8091d-2af6-4d33-9268-998ef266d19c, "ClearPeaceReturn");
		PROC_ORI_SetupCamp(S_GLO_Orthon_1dc8091d-2af6-4d33-9268-998ef266d19c, 1);
		PROC_Foop(S_GLO_Orthon_1dc8091d-2af6-4d33-9268-998ef266d19c, (EFFECTRESOURCE)VFX_Script_FieryPoof_01_90e5c093-038c-34c7-3eb4-255c968f0932);
		
		IF
		DB_InCamp((CHARACTER)S_GLO_Orthon_1dc8091d-2af6-4d33-9268-998ef266d19c)
		AND
		DB_Camp_QueuedNight((FLAG)NIGHT_OrthonVisit_0f675d1a-5b1b-4e44-99fb-628ee14016e9)
		AND
		QRY_OnlyOnce("FCRD_Orthon_DiabolistHint")
		THEN
		PROC_CampRelationshipDialog((CHARACTER)S_GLO_Orthon_1dc8091d-2af6-4d33-9268-998ef266d19c,(DIALOGRESOURCE)CAMP_Orthon_DiabolistHint_698c239b-4a50-95c7-c9b5-02f1adfa0098,FCRD_Orthon_DiabolistHint_1688abb6-8a06-49b9-ad11-02ca822d438c,0);
		PROC_Try_CampRelationshipDialog((CHARACTER)S_GLO_Orthon_1dc8091d-2af6-4d33-9268-998ef266d19c,1);
		
		IF
		DialogEnded(CAMP_Orthon_DiabolistHint_698c239b-4a50-95c7-c9b5-02f1adfa0098, _)
		THEN
		PROC_SetCanFight(S_GLO_Orthon_1dc8091d-2af6-4d33-9268-998ef266d19c, 1);
		PROC_Poof(S_GLO_Orthon_1dc8091d-2af6-4d33-9268-998ef266d19c, (EFFECTRESOURCE)VFX_Script_FieryPoof_01_90e5c093-038c-34c7-3eb4-255c968f0932);
		
		QRY
		QRY_CampNight_AtLeastOneCompanionAvailableForCRD((FLAG)NIGHT_OrthonVisit_0f675d1a-5b1b-4e44-99fb-628ee14016e9)
		AND
		NOT DB_PermaDefeated(S_GLO_Orthon_1dc8091d-2af6-4d33-9268-998ef266d19c)
		AND
		NOT DB_GlobalFlag((FLAG)SHA_Orthon_State_DefeatedOnce_8dd589d6-90fc-4a3b-b369-10440bd56520)
		THEN
		DB_NOOP(1);
	}
	EXIT
	{
	}
}
