		DB_UND_Bulette_SaveTriggers((FLAG)UND_Bulette_State_Arena002_InProgress_e2fceb55-6268-4cef-9883-ae63de160b6f, (TRIGGER)S_UND_Bulette_Arena_002_SaveTrigger_001_6ef64045-20c8-4004-9e4a-1001a7dd76d3);
