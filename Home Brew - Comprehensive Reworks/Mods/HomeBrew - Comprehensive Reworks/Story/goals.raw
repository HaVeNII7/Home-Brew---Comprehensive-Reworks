		AND
		NOT DB_OnlyOnce("ORI_Shadowheart_WolfPhobiaReflection")
		THEN
		DB_ORI_Shadowheart_WolfPhobia_Queued(1);
		
		IF
		TimerFinished("ORI_Shadowheart_WolfPhobiaDelay")
		THEN
