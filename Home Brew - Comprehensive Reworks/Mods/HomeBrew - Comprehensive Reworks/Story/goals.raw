			(FLAG)WYR_Circus_Event_ClownPiecesPickedWaist_24259252-650a-49d3-85d3-ee3f7a915118,
			"GotWaist");
		DB_WYR_Circus_ClownPieces(
			(ITEM)S_WYR_Circus_DribblesBodyPart_Torso_ffb44db4-4573-4ddd-89f9-24b790e0c838,
			(FLAG)WYR_Circus_State_ClownPiecesHasTorso_a64b9be2-cb32-3475-472a-5b86129a5aea,
			(FLAG)WYR_Circus_Event_ClownPiecesPickedTorso_38e87e3f-27ca-4639-aa5e-e4c07c53d349,
			"GotTorso");
		DB_WYR_Circus_ClownPieces(
