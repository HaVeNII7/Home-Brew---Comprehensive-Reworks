		THEN
		PROC_GLO_Backgrounds_CompleteGoal(_Player, "Act3_Soldier_KillEthelAgain");
		
		IF
		DialogStarted(LOW_ParkCultistAmbush_003_b3dbcd94-1a5d-4ed7-f7bf-747e17cf7bf3, _)
		AND
		DB_Players(_Player)
		AND
