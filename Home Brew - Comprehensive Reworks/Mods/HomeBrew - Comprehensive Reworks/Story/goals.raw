		DB_TopicalGreetingEndCondition_FlagSet((FLAG)TG_CRE_ReturnedFromAstralPlane_84dfc234-0075-41da-930e-3ed14de8f4a2, (FLAG)CRE_ChainOfCommand_State_LeftInquisitorOfficeBeforeEnteringAstral_f4049c49-d505-4ddf-a790-45cc29eafabb);
		DB_TopicalGreetingEndCondition_FlagSet((FLAG)TG_CRE_ReturnedFromAstralPlane_84dfc234-0075-41da-930e-3ed14de8f4a2, (FLAG)ORI_Laezel_State_LeftCrecheAfterEverythingIsDone_8d268d89-239d-4542-94e8-85399ac64c21); //Flag is set regardless of whether Laezel is in party or recruited
		
		//Topic 30 - You blew up the creche
		DB_TopicalGreeting((FLAG)TG_CRE_PostCrecheDestruction_21fe77ff-afc6-4900-9b36-0eb8013c53db);
		DB_TopicalGreetingStartCondition_FlagSet((FLAG)TG_CRE_PostCrecheDestruction_21fe77ff-afc6-4900-9b36-0eb8013c53db, (FLAG)CRE_Lance_Event_Exploded_f7d93dd1-c30e-4ef2-87c0-0cada12f180d);
		DB_TopicalGreetingEndCondition_FlagSet((FLAG)TG_CRE_PostCrecheDestruction_21fe77ff-afc6-4900-9b36-0eb8013c53db, (FLAG)CURRENTREGION_SCL_Main_A_f76b85b5-b557-4409-98fd-cc7b22f8292b);
		DB_TopicalGreetingEndCondition_FlagSet((FLAG)TG_CRE_PostCrecheDestruction_21fe77ff-afc6-4900-9b36-0eb8013c53db, (FLAG)CURRENTREGION_WLD_Main_A_797d21c8-b2a9-4c86-a1e4-8ca3833a32ef);
		DB_TopicalGreetingEndCondition_LongRest((FLAG)TG_CRE_PostCrecheDestruction_21fe77ff-afc6-4900-9b36-0eb8013c53db);
		
		//Topic 31 - You triggered the creche destruction but stopped it
		DB_TopicalGreeting((FLAG)TG_CRE_StoppedCrecheDestruction_093ba6ef-a02e-48a9-91e5-8a5e3775db63);
		DB_TopicalGreetingEndCondition_FlagSet((FLAG)TG_CRE_StoppedCrecheDestruction_093ba6ef-a02e-48a9-91e5-8a5e3775db63, (FLAG)CURRENTREGION_SCL_Main_A_f76b85b5-b557-4409-98fd-cc7b22f8292b);
		DB_TopicalGreetingEndCondition_FlagSet((FLAG)TG_CRE_StoppedCrecheDestruction_093ba6ef-a02e-48a9-91e5-8a5e3775db63, (FLAG)CURRENTREGION_WLD_Main_A_797d21c8-b2a9-4c86-a1e4-8ca3833a32ef);
		DB_TopicalGreetingEndCondition_LongRest((FLAG)TG_CRE_StoppedCrecheDestruction_093ba6ef-a02e-48a9-91e5-8a5e3775db63);
		
		//Topic 33 - Left Creche after completing Zaithisk and Vlaakith
		DB_TopicalGreeting((FLAG)TG_CRE_LeftCrecheAfterEverythingIsDone_6c36aa25-d053-4f63-9f32-62077f16ed92);
		//Start Condition in KB section
		DB_TopicalGreetingEndCondition_FlagSet((FLAG)TG_CRE_LeftCrecheAfterEverythingIsDone_6c36aa25-d053-4f63-9f32-62077f16ed92, (FLAG)CURRENTREGION_SCL_Main_A_f76b85b5-b557-4409-98fd-cc7b22f8292b);
		DB_TopicalGreetingEndCondition_FlagSet((FLAG)TG_CRE_LeftCrecheAfterEverythingIsDone_6c36aa25-d053-4f63-9f32-62077f16ed92, (FLAG)CURRENTREGION_WLD_Main_A_797d21c8-b2a9-4c86-a1e4-8ca3833a32ef);
		DB_TopicalGreetingEndCondition_LongRest((FLAG)TG_CRE_LeftCrecheAfterEverythingIsDone_6c36aa25-d053-4f63-9f32-62077f16ed92);
		//END_REGION
		
		//REGION Colony
		DB_TopicalGreeting((FLAG)TG_COL_InColony_79d845c2-eac2-4060-a7d8-30314cb61826);
		DB_TopicalGreetingEndCondition_FlagSet((FLAG)TG_COL_InColony_79d845c2-eac2-4060-a7d8-30314cb61826,(FLAG)SCE_State_PlayerVisitedEpilogue_1c1c8a40-0862-4794-a46b-5064c54512df);
		DB_TopicalGreeting((FLAG)TG_COL_KilledKetheric_28a4ddbb-3df5-4ecf-a0ef-1a6e47b6a638);
		DB_TopicalGreetingEndCondition_FlagSet((FLAG)TG_COL_KilledKetheric_28a4ddbb-3df5-4ecf-a0ef-1a6e47b6a638,(FLAG)SCE_State_PlayerVisitedEpilogue_1c1c8a40-0862-4794-a46b-5064c54512df);
		DB_TopicalGreeting((FLAG)TG_COL_Mizora_Released_dd27e873-a592-4f5a-b769-a1206dfa6d3e);
		DB_TopicalGreetingEndCondition_FlagSet((FLAG)TG_COL_Mizora_Released_dd27e873-a592-4f5a-b769-a1206dfa6d3e,(FLAG)MOO_KethericShowdown_State_Started_33489af3-23b7-4340-bbf6-19033c9dae03);
		DB_TopicalGreeting((FLAG)TG_COL_Mizora_WyllDied_9b5f840f-fc45-42fd-9d40-4caf6e038d36);
