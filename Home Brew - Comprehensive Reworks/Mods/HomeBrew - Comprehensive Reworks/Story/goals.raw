		THEN
		RemoveStatus(_Door, _Status);
		PROC_StopLoopEffect(_Door, "LOW_CazadorsPalace_DoorVFX");
		NOT DB_LOW_CazadorsPalace_DoorsWithStatuses(_Door, _Status);
		
