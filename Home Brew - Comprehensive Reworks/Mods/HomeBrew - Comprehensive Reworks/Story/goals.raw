	KB
	{
		//REGION ORI_HighHarper - Rescue Minsc
		// ORI_HighHarper_FindMinscLair
		IF
		FlagSet((FLAG)LOW_CountingHouse_State_RobbersEscaped_16197488-9cc2-48e2-94ae-36225025d4d8, _, _)
		AND
		NOT QRY_HighHarper_FindMinscLair_NeedsStart()
		THEN
		QuestUpdate("ORI_HighHarper", "FindMinscLair");
		
		QRY
		QRY_HighHarper_FindMinscLair_NeedsStart()
		AND
		DB_Players(_Player)
		AND
		QuestIsAccepted(_Player, "ORI_HighHarper", 0)
		AND
		QRY_OnlyOnce("ORI_HighHarper_FindMinscLairStart")
		AND
		DB_Players((CHARACTER)S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a)
		THEN
		QuestUpdate(_Player, "ORI_HighHarper", "FindMinscLairStart");
		
		// LearnedGreatDoorPincode
		IF
		GameBookInterfaceClosed(S_LOW_CountingHouse_PinCodeAnswerBook_a43fbef3-8c57-4d5d-80d0-a18d01f2a0a7, _Player)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		DB_GlobalFlag((FLAG)GLO_Minsc_Knows_MinscIsStoneLord_891f3591-4121-810a-aa9d-9fb1c8cd47cd)
		THEN
		PROC_QuestDef_QuestUpdate(_Player, "ORI_HighHarper", "LearnedGreatDoorPincode");
		
		// ORI_HighHarper_FindMinscInSewers
		IF
		EnteredTrigger(_PartyMember,(TRIGGER)S_LOW_Sewers_SUB_c053f299-2919-4928-b489-d238b356cf9b)
		AND
		DB_PartyMembers(_PartyMember)
		AND
		DB_QuestIsOpened("ORI_HighHarper")
		AND
		DB_GlobalFlag((FLAG)LOW_CountingHouse_Knows_MinscHideoutInSewers_65c2faa5-bce2-4839-9c82-2ba1ab6a13ad)
		AND
		NOT QRY_QuestUpdateIsUnlockedForAny("ORI_HighHarper","FindTheStoneLordInSewers")
		AND
		DB_GlobalFlag(LOW_CountingHouse_Knows_MinscHideoutInSewers_65c2faa5-bce2-4839-9c82-2ba1ab6a13ad)
		THEN
		QuestUpdate("ORI_HighHarper","FindTheStoneLordInSewers");
		
		// ORI_HighHarper_TakeOutMinsc
		IF
		FlagSet(LOW_MinscHideout_State_ZhentLeaderEscaping_4333a451-024f-4c41-aea1-7046afdf0b4a, _, _)
		AND
		NOT QRY_HighHarper_TakeOutMinsc_NeedsStart()
		THEN
		QuestUpdate("ORI_HighHarper", "TakeOutMinsc");
		
		QRY
		QRY_HighHarper_TakeOutMinsc_NeedsStart()
		AND
		DB_Players(_Player)
		AND
		QuestIsAccepted(_Player, "ORI_HighHarper", 0)
		AND
		QRY_OnlyOnce("ORI_HighHarper_TakeOutMinscStart")
		AND
		DB_Players((CHARACTER)S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a)
		THEN
		QuestUpdate(_Player, "ORI_HighHarper", "TakeOutMinscStart");
		//END_REGION
		
		//REGION LOW_Guildhall
		// When Jaheira is in party and the HelpJaheiraFindMinsc update is unlocked, further quest updates in DB_LOW_Guildhall_JaheiraBlockedQuests will be ignored
		QRY
		QRY_LOW_Guildhall_Journal_JaheiraBlocksQuestUpdates()
		AND
		DB_Avatars(_Player)
		AND
		QuestUpdateIsUnlocked(_Player, "LOW_Guildhall", "HelpJaheiraFindMinsc", 1)
		AND
		QuestUpdateIsUnlocked(_Player, "LOW_Guildhall", "JaheiraLeftWhileRescueingMinsc", 0)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_QuestDef_BlockQuestUpdate(_, _Quest, _Update)
		AND
		DB_LOW_Guildhall_JaheiraBlockedQuests(_Quest, _Update)
		AND
		QRY_LOW_Guildhall_Journal_JaheiraBlocksQuestUpdates()
		THEN
		DB_NOOP(1);
		
		// LOW_Guildhall_FindTheStoneLordInSewers
		IF
		EnteredTrigger(_PartyMember,(TRIGGER)S_LOW_Sewers_SUB_c053f299-2919-4928-b489-d238b356cf9b)
		AND
		DB_PartyMembers(_PartyMember)
		AND
		DB_QuestIsOpened("LOW_Guildhall")
		AND
		DB_GlobalFlag((FLAG)LOW_CountingHouse_Knows_MinscHideoutInSewers_65c2faa5-bce2-4839-9c82-2ba1ab6a13ad)
		AND
		NOT QRY_QuestUpdateIsUnlockedForAny("LOW_Guildhall","FindTheStoneLordInSewers")
		AND
		DB_GlobalFlag(LOW_CountingHouse_Knows_MinscHideoutInSewers_65c2faa5-bce2-4839-9c82-2ba1ab6a13ad)
		THEN
		QuestUpdate("LOW_Guildhall","FindTheStoneLordInSewers");
		
		// LOW_Guildhall_GoToGuildhall
		IF
		FlagSet((FLAG)LOW_Guildhall_State_MinscAskedGoGuildhall_ce3c53c9-210b-b202-b558-3304d293b120, _, _)
		AND
		DB_Players(_Player)
		AND
		QuestIsAccepted(_Player, "LOW_Guildhall", 0)
		THEN
		QuestUpdate("LOW_Guildhall","MinscAsksGoGuildhall");
		
		// LOW_Guildhall_ResolveGuildhallConflict
		IF
		EnteredTrigger(_Player, S_LOW_Guildhall_SUB_adf8c225-5a74-4c9b-86ea-198aca6fabae)
		AND
		DB_Players(_Player)
		AND
		DB_GlobalFlag((FLAG)LOW_Guildhall_State_DuringCoup_6dba56a5-8220-41f4-8849-085e38b80d4e)
		AND
		QRY_OnlyOnce("Quest_Progress_ResolveGuildhallConflict")
		THEN
		QuestUpdate(_Player, "LOW_Guildhall", "ResolveGuildhallConflict");
		
		PROC
		PROC_State_Changed(_, "LOW_Guildhall_State", "LOW_Guildhall_State_DuringCoup")
		AND
		DB_Players(_Player)
		AND
		DB_InRegion(_Player, S_LOW_Guildhall_SUB_adf8c225-5a74-4c9b-86ea-198aca6fabae)
		AND
		QRY_OnlyOnce("Quest_Progress_ResolveGuildhallConflict")
		THEN
		QuestUpdate(_Player, "LOW_Guildhall", "ResolveGuildhallConflict");
		//END_REGION
	}
	EXIT
	{
	}
}
