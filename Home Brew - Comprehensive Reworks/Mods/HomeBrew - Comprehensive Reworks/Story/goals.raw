		DB_CampNight_Camp((FLAG)NIGHT_DarkUrge_ButlerIntro_e3dc106b-02f0-41ef-9642-ed7ccf971248,"SCLMAIN");
		DB_CampNight_Camp((FLAG)NIGHT_DarkUrge_ButlerIntro_e3dc106b-02f0-41ef-9642-ed7ccf971248,"SHARTEMPLE");
		DB_CampNight_Camp((FLAG)NIGHT_DarkUrge_ButlerIntro_e3dc106b-02f0-41ef-9642-ed7ccf971248,"MOONRISE");
		DB_CampNight_Camp((FLAG)NIGHT_DarkUrge_ButlerIntro_e3dc106b-02f0-41ef-9642-ed7ccf971248,"HAVEN");
		
