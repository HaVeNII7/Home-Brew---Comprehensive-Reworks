		//REGION Iron Throne debug
		DB_FlagReactionAfterDialog((FLAG)Debug_IRN_PartyPreset1_399838c9-7a2e-4676-8888-52821d0b73a8, (DIALOGRESOURCE)DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea);
		DB_FlagReactionAfterDialog((FLAG)Debug_IRN_PartyPreset2_Wyll_b7c5cde2-47d4-47a9-b0b7-fd89bced4afb, (DIALOGRESOURCE)DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea);
		DB_GlobalFlagReactionAfterDialog((FLAG)Debug_IRN_DontLoadPreset_1e5d52c2-912d-406f-aac5-154b6baf6fb0, (DIALOGRESOURCE)DebugBook_3af7dec4-4c08-9e44-9064-ec038ebad0ea);
		
