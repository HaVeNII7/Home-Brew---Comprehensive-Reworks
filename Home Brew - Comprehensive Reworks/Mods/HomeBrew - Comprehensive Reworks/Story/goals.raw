		DB_HAV_EnteringHaven_ExtraSpeaker(S_HAV_HavenOutcasts_BarricadeYeller_Ranger_b612ef5f-3381-4486-8959-84dd399fb1ae);
		DB_HAV_EnteringHaven_ExtraSpeaker(S_HAV_HavenOutcasts_FountainPatrol_Caster_ff70f59a-7d50-4e69-a768-60a97c6fb57d);
		
		DB_DialogBlockTradeButton(HAV_EnteringHaven_TadpoleCheckpoint_e51408cc-4f7a-5a5f-52e8-caf1359c1d6c);
	}
	KB
	{
		//REGION DEBUG
		//HACK: Make everyones life easier by not constantly triggering checkpoint dialog in editor, if spotted
		IF
		LevelGameplayStarted("SCL_Main_A", 1)
		AND
		QRY_OnlyOnce("HAV_EnteringHaven_Init")
		THEN
		DB_HAV_EnteringHaven_IsEditor(1);
		
		IF
		TextEvent("havchec")
		THEN
		PROC_GlobalSetFlagAndCache(DEBUG_HAV_EnteringHaven_CheckpointOn_194ea2a3-2638-072c-7761-07dc7e8eeb70);
		
		IF
		TextEvent("skiphavchec")
		THEN
		SetFlag(HAV_EnteringHaven_State_GainedAccess_07c776da-353a-9050-e9be-c42d51a99412);
		
		IF
		FlagSet(DEBUG_HAV_EnteringHaven_CheckpointOn_194ea2a3-2638-072c-7761-07dc7e8eeb70,_,_)
		AND
		DB_HAV_EnteringHaven_IsEditor(1)
		THEN
		PROC_TriggerRegisterForPlayers(S_HAV_EnteringHaven_PlayerApproach_6fff604b-3521-44f6-8e75-3203c7fb91bc);
		NOT DB_HAV_EnteringHaven_IsEditor(1);
		DB_TrespassTrigger((TRIGGER)S_HAV_EnteringHaven_ForbiddenArea_307bf271-9af2-4572-967a-e87edf41bf54,(TRIGGER)S_HAV_TrespassReturnPos_28cd1e46-be2c-44c2-810f-a6d4c6c3b25c,"HAV_EnteringHaven_ForbiddenArea");
		
		IF
		LevelGameplayStarted("SCL_Main_A", 0)
		AND
		QRY_OnlyOnce("HAV_EnteringHaven_Init")
		THEN
		PROC_TriggerRegisterForPlayers(S_HAV_EnteringHaven_PlayerApproach_6fff604b-3521-44f6-8e75-3203c7fb91bc);
		DB_TrespassTrigger((TRIGGER)S_HAV_EnteringHaven_ForbiddenArea_307bf271-9af2-4572-967a-e87edf41bf54,(TRIGGER)S_HAV_TrespassReturnPos_28cd1e46-be2c-44c2-810f-a6d4c6c3b25c,"HAV_EnteringHaven_ForbiddenArea");
		
		IF
		FlagSet((FLAG)Debug_Teleport_HAV_Inside_b6a37cf7-1a4d-01c0-37fe-cbfc8133e7d2,_Player,_DialogID)
		THEN
		PROC_GlobalSetFlagAndCache(HAV_EnteringHaven_State_GainedAccess_07c776da-353a-9050-e9be-c42d51a99412);
		PROC_HAV_EnteringHaven_Admitted();
		
		IF
		FlagSet(Debug_HAV_MolVouched_c400ba5f-13a5-2439-c206-e3592cf1b2e3, _, _)
		THEN
		DB_Children((CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925);
		Resurrect(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925);
		RemoveStatus(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, "KNOCKED_OUT", NULL_00000000-0000-0000-0000-000000000000);
		NOT DB_PermaDefeated(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925);
		ClearFlag((FLAG)MOO_FirstFloor_DukeDouble_Quest_Accepted_10d8d681-e2a3-c472-e7d9-08718f2eaea2,NULL_00000000-0000-0000-0000-000000000000,0);
		SetFlag((FLAG)DEN_AttackOnDen_State_DenVictory_71c7f23e-3ff1-c9b8-3ef5-d75fa1b42c8d,NULL_00000000-0000-0000-0000-000000000000,0);
		SetFlag((FLAG)GOB_State_LeadersAreDead_a1c5b01f-4b7f-47ab-82b0-d24d9c6d8bc6,NULL_00000000-0000-0000-0000-000000000000,0);
		PROC_GlobalSetFlagAndCache((FLAG)HAV_EnteringHaven_State_MolVouched_ff4181d3-63ff-49ea-b26e-bc96c919119e);
		TeleportTo(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925,S_HAV_EnteringHaven_MolPoint_9052d5fa-fd15-4fae-9faf-3f25544f99da);
		SetFlag((FLAG)Debug_HAV_MolsDeal_ThreeWaySetup_2b492e4d-bc82-0619-cdec-321cd55a7f41, NULL_00000000-0000-0000-0000-000000000000, 0);
		PROC_State_Progress(S_HAV_FlamingSpy_acb1dd9e-952b-4281-8e30-ec6f671493a6, "HAV_FlamingSpy", "Spy_CaptureReady");
		
		IF
		FlagSet(Debug_HAV_MarcusVouched_bbf5313e-f92b-0014-0761-a870fda3f0c5, _, _)
		AND
		NOT DB_Defeated(S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925)
		THEN
		ClearFlag((FLAG)DEN_AttackOnDen_State_DenVictory_71c7f23e-3ff1-c9b8-3ef5-d75fa1b42c8d,NULL_00000000-0000-0000-0000-000000000000,0);
		
		IF
		FlagSet(Debug_HAV_MarcusVouched_bbf5313e-f92b-0014-0761-a870fda3f0c5, _, _)
		THEN
		SetFlag((FLAG)HAV_EnteringHaven_State_FlamingSpyVouch_f3850740-f19b-44c0-a018-00fa00e87b31, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		//END_REGION
		
		//REGION Checkpoint spotters
		
		IF
		DB_HAV_CheckpointSpotters(_Character)
		THEN
		DB_SpotPlayers(_Character,"HAV_EnteringHaven_CheckpointSpot",NULL_00000000-0000-0000-0000-000000000000,(FLAG)HAV_EnteringHaven_GainedAccess_StopSpotting_a51abf96-f5df-4dca-9acd-414eee740884);
		DB_SpotPlayers_Continuous(_Character,"HAV_EnteringHaven_CheckpointSpot");
		DB_SpotPlayers_SpotTrigger(_Character,"HAV_EnteringHaven_CheckpointSpot",(TRIGGER)S_HAV_EnteringHaven_SpotTrigger_38b4a5b6-47a3-4e3c-826a-1b63c60863f7);
		DB_SpotPlayers_IncludeWildshapedPlayers(_Character, "HAV_EnteringHaven_CheckpointSpot");
		DB_SpotPlayers_SpotterIgnoreCantTalk(_Character, "HAV_EnteringHaven_CheckpointSpot");
		DB_SpotPlayers_TargetIgnoreCantTalk(_Character, "HAV_EnteringHaven_CheckpointSpot");
		DB_SpotPlayers_HasTag(_Character, "HAV_EnteringHaven_CheckpointSpot", (TAG)REALLY_HALSIN_9b8709f9-8d2a-4b4e-a465-8505c561d7f5, 0);
		
		//END_REGION
		
		//REGION Jaheira relocates
		IF
		FlagSet(HAV_EnteringHaven_State_JaheiraToGate_397c63c3-47c8-ceb4-fd12-fc848d820c3f, _, _)
		AND
		NOT DB_CantMove(S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a)
		THEN
		CharacterMoveTo((CHARACTER)S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a, S_HAV_Checkpoint_JaheiraHome2_54db1d5b-11fb-48de-b799-f5c67d02b5c7, "Walk", "");
		
		//END_REGION
		
		//REGION Dialog Start Logic
		
		//REGION Harpers Saved
		
		IF
		DB_GlobalFlag((FLAG)SCL_HarperScouts_State_ShadowsDefeated_bae50f7d-7347-4fb7-ae8a-9fda8f84fc9f)
		AND
		NOT DB_GlobalFlag((FLAG)SCL_HarperScouts_State_HarpersDefeated_40be395c-f852-49ee-a30c-6531fbacd59c)
		AND
		DB_GlobalFlag((FLAG)SCL_HarperScouts_Event_InvitedToHaven_9ade36a5-8ea6-ab0e-929c-ac323741435a)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)HAV_EnteringHaven_State_HasSavedHarpers_8d3e8576-659d-4d2b-962a-6d562fd8cb49);
		
		PROC
		PROC_SCL_Drider_HarpersWin_SidedWithHarpers()
		AND
		NOT DB_GlobalFlag(SCL_Drider_Event_PlayersWillFindCaravanAtAmbush_b3f55a3b-4cbd-4181-8c8f-ecc8ff4eaf9c)
		THEN
		DB_HAV_EnteringHaven_HarperAmbushersSaved(1);
		PROC_GlobalSetFlagAndCache((FLAG)HAV_EnteringHaven_State_HasSavedHarpers_8d3e8576-659d-4d2b-962a-6d562fd8cb49);
		
		IF
		DB_GlobalFlag((FLAG)SCL_HarperScouts_State_HarpersDefeated_40be395c-f852-49ee-a30c-6531fbacd59c)
		AND
		DB_GlobalFlag((FLAG)HAV_EnteringHaven_State_HasSavedHarpers_8d3e8576-659d-4d2b-962a-6d562fd8cb49)
		AND
		NOT DB_HAV_EnteringHaven_HarperAmbushersSaved(1)
		THEN
		PROC_GlobalClearFlagAndCache((FLAG)HAV_EnteringHaven_State_HasSavedHarpers_8d3e8576-659d-4d2b-962a-6d562fd8cb49);
		
		//END_REGION
		
		IF
		DB_HAV_EnteringHaven_Spotted(_Player)
		AND
		NOT DB_SpotPlayers_Spotted(_, "HAV_EnteringHaven_CheckpointSpot", (CHARACTER)_Player)
		THEN
		NOT DB_HAV_EnteringHaven_Spotted((GUIDSTRING)_Player);
		
		IF
		DB_SpotPlayers_Spotted(_Char,"HAV_EnteringHaven_CheckpointSpot",_Player)
		AND
		NOT DB_HAV_EnteringHaven_Spotted(_Player)
		AND
		NOT DB_HAV_EnteringHaven_ClawsActive(1)
		AND
		NOT DB_HAV_EnteringHaven_DialogStarting(1)
		AND
		NOT DB_CantTalk(_Char)
		AND
		NOT DB_HAV_EnteringHaven_IsEditor(1)
		AND
		NOT DB_DialogName(HAV_EnteringHaven_TadpoleCheckpoint_e51408cc-4f7a-5a5f-52e8-caf1359c1d6c, _)
		AND
		NOT DB_DialogPlayers(_, _Char, _)
		AND
		NOT DB_CantTalk(_Player)
		AND
		NOT DB_GLO_DefeatCounter_CountMet("HAV_EnteringHaven_ClawsDefeated")
		AND
		NOT DB_GlobalFlag(GLO_HAV_EnteringHaven_TadpoleCheckpoint_RevealedMarcus_b6d58e9d-ae50-95c5-0776-60d68fd8c71b)
		AND
		NOT DB_GlobalFlag(HAV_EnteringHaven_State_GainedAccess_07c776da-353a-9050-e9be-c42d51a99412)
		THEN
		PROC_HAV_EnteringHaven_TriggerDialog(_Player,NULL_00000000-0000-0000-0000-000000000000);
		
		//If non-speaking, try to add to existing main dialogue, failing that to existing fallback dialogue, failing that start a fallback dialogue.
		//Failing that, character will proceed, be faced with hostility, and get attacked.
		IF
		DB_SpotPlayers_Spotted(_Char,"HAV_EnteringHaven_CheckpointSpot",_Player)
		AND
		NOT DB_HAV_EnteringHaven_Spotted(_Player)
		AND
		NOT DB_HAV_EnteringHaven_ClawsActive(1)
		AND
		NOT DB_HAV_EnteringHaven_DialogStarting(1)
		AND
		NOT DB_CantTalk(_Char)
		AND
		NOT DB_HAV_EnteringHaven_IsEditor(1)
		AND
		NOT DB_DialogName(HAV_EnteringHaven_TadpoleCheckpoint_e51408cc-4f7a-5a5f-52e8-caf1359c1d6c, _)
		AND
		NOT DB_DialogRequestCache_SpeakerList_Speakers(_, _, _Player, _)
		AND
		DB_CantTalk(_Player)
		THEN
		PROC_HAV_EnteringHaven_NonSpeakingEnter(_Player);
		
		PROC
		PROC_HAV_EnteringHaven_NonSpeakingEnter((GUIDSTRING)_Player)
		AND
		DB_CantTalk(_Player)
		AND
		DB_HAV_CheckpointSpotters(_Spotter)
		AND
		NOT DB_CantAct(_Spotter)
		THEN
		LookAtEntity(_Spotter, _Player, 4.0);
		SetWeaponUnsheathed(_Spotter, 0, 0);
		
		PROC
		PROC_HAV_EnteringHaven_NonSpeakingEnter((GUIDSTRING)_Player)
		AND
		NOT QRY_HAV_EnteringHaven_AddToMuteCheckpointDialog(_Player)
		AND
		DB_HAV_CheckpointSpotters(_Spotter)
		AND
		NOT DB_CantAct(_Spotter)
		AND
		NOT DB_OnlyOnce("PROC_HAV_EnteringHaven_NonSpeakingEnter")
		AND
		NOT DB_Defeated(S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a)
		AND
		NOT DB_HAV_Arrival_Trespassers(_Player)
		AND
		QRY_StartDialog((DIALOGRESOURCE)GEB_GetOutOfHere1_01d8d9e1-bde1-0792-688b-a11f04c440dd, _Spotter, _Player)
		THEN
		DB_OnlyOnce("PROC_HAV_EnteringHaven_NonSpeakingEnter");
		
		PROC
		PROC_HAV_EnteringHaven_NonSpeakingEnter((GUIDSTRING)_Player)
		AND
		NOT QRY_HAV_EnteringHaven_AddToMuteCheckpointDialog(_Player)
		AND
		DB_HAV_CheckpointSpotters(_Spotter)
		AND
		NOT DB_CantAct(_Spotter)
		AND
		NOT DB_OnlyOnce("PROC_HAV_EnteringHaven_NonSpeakingEnter")
		AND
		DB_Defeated(S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a)
		AND
		QRY_StartDialog((DIALOGRESOURCE)GEB_HAV_EnteringHaven_Trespassing_dfd1e6a2-4c9a-1492-e88d-515a05211ffd, _Spotter, _Player)
		THEN
		DB_OnlyOnce("PROC_HAV_EnteringHaven_NonSpeakingEnter");
		
		PROC
		PROC_HAV_EnteringHaven_NonSpeakingEnter((GUIDSTRING)_Player)
		THEN
		DB_HAV_EnteringHaven_Spotted(_Player);
		NOT DB_OnlyOnce("PROC_HAV_EnteringHaven_NonSpeakingEnter");
		
		QRY
		QRY_HAV_EnteringHaven_AddToMuteCheckpointDialog((GUIDSTRING)_Player)
		AND
		QRY_OnlyOnce_Reset("HAV_EnteringHaven_AddToMuteCheckpointDialog")
		AND
		DB_DialogName(GEB_GetOutOfHere1_01d8d9e1-bde1-0792-688b-a11f04c440dd, _ID)
		AND
		DB_DialogNPCs(_ID, _Spotter, _)
		AND
		DB_HAV_CheckpointSpotters((CHARACTER)_Spotter)
		AND
		QRY_OnlyOnce("HAV_EnteringHaven_AddToMuteCheckpointDialog")
		THEN
		PROC_DialogAddListeningActor(_ID,_Player);
		
		IF
		DB_SpotPlayers_Spotted(_Char,"HAV_EnteringHaven_CheckpointSpot",_Player)
		AND
		NOT DB_HAV_EnteringHaven_Spotted(_Player)
		AND
		NOT DB_HAV_EnteringHaven_ClawsActive(1)
		AND
		NOT DB_HAV_EnteringHaven_DialogStarting(1)
		AND
		DB_DialogName(HAV_EnteringHaven_TadpoleCheckpoint_e51408cc-4f7a-5a5f-52e8-caf1359c1d6c, _ID)
		THEN
		PROC_DialogAddListeningActor(_ID,_Player);
		
		
		PROC
		PROC_DialogFlagSetup(HAV_EnteringHaven_TadpoleCheckpoint_e51408cc-4f7a-5a5f-52e8-caf1359c1d6c, _, _, _, _, _, _Player)
		THEN
		DB_HAV_EnteringHaven_Spotted(_Player);
		DB_HAV_EnteringHaven_DialogStarting(1);
		
		IF
		DB_DialogName(HAV_EnteringHaven_TadpoleCheckpoint_e51408cc-4f7a-5a5f-52e8-caf1359c1d6c, _ID)
		AND
		DB_HAV_EnteringHaven_DialogStarting(1)
		THEN
		NOT DB_HAV_EnteringHaven_DialogStarting(1);
		
		IF
		DialogRequestFailed(HAV_EnteringHaven_TadpoleCheckpoint_e51408cc-4f7a-5a5f-52e8-caf1359c1d6c, _)
		THEN
		NOT DB_HAV_EnteringHaven_DialogStarting(1);
		
		PROC
		PROC_HAV_EnteringHaven_TriggerDialog((CHARACTER)_Player, (CHARACTER)_Guard)
		THEN
		DebugText(_Player, "Starting Dialog");
		
		PROC
		PROC_HAV_EnteringHaven_TriggerDialog((CHARACTER)_Player,(CHARACTER)_Guard)
		AND
		NOT DB_GlobalFlag((FLAG)HAV_EnteringHaven_State_FlamingSpyRevealed_89e1eb87-a718-8dc2-026d-f4db8321b686)
		AND
		NOT DB_GlobalFlag((FLAG)HAV_EnteringHaven_State_WasVouchedFor_49b15dc5-9283-0937-4d7e-e66f3d8d5a11)
		AND
		QRY_HAV_EnteringHaven_GetAvailableHarper()
		AND
		DB_QRYRTN_HAV_EnteringHaven_AvailableHarper(1, _Harper1)
		AND
		DB_QRYRTN_HAV_EnteringHaven_AvailableHarper(2, _Harper2)
		AND
		NOT QRY_StartDialogCustom((DIALOGRESOURCE)HAV_EnteringHaven_TadpoleCheckpoint_e51408cc-4f7a-5a5f-52e8-caf1359c1d6c, (CHARACTER)S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a, (CHARACTER)_Harper1, _Harper2,(CHARACTER)S_HAV_EnteringHaven_Guard_f48078e6-ec51-49a2-a244-9d0a72af5257,(CHARACTER)_Guard,(CHARACTER)_Player,0, 0, 1, 1)
		THEN
		PROC_HAV_EnteringHaven_NonSpeakingEnter((GUIDSTRING)_Player);
		
		PROC
		PROC_HAV_EnteringHaven_TriggerDialog((CHARACTER)_Player, _)
		AND
		DB_GlobalFlag((FLAG)HAV_EnteringHaven_State_FlamingSpyRevealed_89e1eb87-a718-8dc2-026d-f4db8321b686)
		AND
		NOT QRY_StartDialogCustom((DIALOGRESOURCE)HAV_EnteringHaven_TadpoleCheckpoint_e51408cc-4f7a-5a5f-52e8-caf1359c1d6c, (CHARACTER)S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a, NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000,NULL_00000000-0000-0000-0000-000000000000,(CHARACTER)_Player,0, 0, 1, 1)
		THEN
		PROC_HAV_EnteringHaven_NonSpeakingEnter((GUIDSTRING)_Player);
		
		PROC
		PROC_HAV_EnteringHaven_TriggerDialog((CHARACTER)_Player, _)
		AND
		NOT DB_GlobalFlag((FLAG)HAV_EnteringHaven_State_FlamingSpyRevealed_89e1eb87-a718-8dc2-026d-f4db8321b686)
		AND
		DB_GlobalFlag((FLAG)HAV_EnteringHaven_State_WasVouchedFor_49b15dc5-9283-0937-4d7e-e66f3d8d5a11)
		AND
		NOT QRY_StartDialogCustom((DIALOGRESOURCE)HAV_EnteringHaven_TadpoleCheckpoint_e51408cc-4f7a-5a5f-52e8-caf1359c1d6c, (CHARACTER)S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a, NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000,NULL_00000000-0000-0000-0000-000000000000,(CHARACTER)_Player,0, 0, 1, 1)
		THEN
		PROC_HAV_EnteringHaven_NonSpeakingEnter((GUIDSTRING)_Player);
		
		QRY
		QRY_HAV_EnteringHaven_GetAvailableHarper()
		AND
		DB_QRYRTN_HAV_EnteringHaven_AvailableHarper(_ID, _Harper)
		THEN
		NOT DB_QRYRTN_HAV_EnteringHaven_AvailableHarper(_ID, _Harper);
		
		QRY
		QRY_HAV_EnteringHaven_GetAvailableHarper()
		THEN
		DB_QRYRTN_HAV_EnteringHaven_AvailableHarper(1, NULL_00000000-0000-0000-0000-000000000000);
		DB_QRYRTN_HAV_EnteringHaven_AvailableHarper(2, NULL_00000000-0000-0000-0000-000000000000);
		
		QRY
		QRY_HAV_EnteringHaven_GetAvailableHarper()
		AND
		DB_SCL_HarperScouts_BridgeDialogues(_Harper,_)
		AND
		DB_InRegion(_Harper, (TRIGGER)S_SCL_HarperBridge_b68e6789-b6d3-4b39-866c-78dcfb37e7f0)
		AND
		QRY_SpeakerIsAvailable(_Harper)
		AND
		DB_QRYRTN_HAV_EnteringHaven_AvailableHarper(1, NULL_00000000-0000-0000-0000-000000000000)
		THEN
		NOT DB_QRYRTN_HAV_EnteringHaven_AvailableHarper(1, NULL_00000000-0000-0000-0000-000000000000);
		DB_QRYRTN_HAV_EnteringHaven_AvailableHarper(1, _Harper);
		
		QRY
		QRY_HAV_EnteringHaven_GetAvailableHarper()
		AND
		DB_QRYRTN_HAV_EnteringHaven_AvailableHarper(1, NULL_00000000-0000-0000-0000-000000000000)
		AND
		DB_GlobalFlag(SCL_Drider_State_HarpersBackAtInn_9e0b8ee1-ccf7-4645-92da-4ec8be45508e)
		AND
		DB_GlobalFlag(SCL_Drider_State_SidedWithHarpers_a130dde9-c086-4486-9cd8-298a67fb6aee)
		AND
		NOT DB_GlobalFlag(SCL_Drider_State_HarpersLearnMissedCaravan_cd3620bc-c471-4a6a-b0e0-336806bbfce3)
		AND
		DB_SCL_Drider_HarpersGroup(_Harper, _, _)
		AND
		IsInTrigger(_Harper, S_HAV_Haven_SUB_6ac001f4-9c56-4a1b-963d-a509e158ffab, 1) //TODO: refine.
		AND
		QRY_SpeakerIsAvailable(_Harper)
		AND
		DB_QRYRTN_HAV_EnteringHaven_AvailableHarper(2, NULL_00000000-0000-0000-0000-000000000000)
		THEN
		DB_QRYRTN_HAV_EnteringHaven_AvailableHarper(2, _Harper);
		NOT DB_QRYRTN_HAV_EnteringHaven_AvailableHarper(2, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		DialogStarted((DIALOGRESOURCE)GEB_HAV_EnteringHaven_Trespassing_dfd1e6a2-4c9a-1492-e88d-515a05211ffd,_ID)
		AND
		DB_DialogNPCs(_ID,_Guard,1)
		THEN
		DB_HAV_EnteringHaven_GuardSpottedSneaker(_Guard);
		
		//Start Checkpoint dialog after the trespass crime one
		PROC
		PROC_FlagReactionAfterDialog((CHARACTER)_Player,(FLAG)HAV_EnteringHaven_TrespasserSpotted_368a6fef-ece0-a1db-f1da-146dd32a6634)
		AND
		DB_HAV_EnteringHaven_GuardSpottedSneaker(_Guard)
		AND
		NOT DB_DialogName((DIALOGRESOURCE)HAV_EnteringHaven_TadpoleCheckpoint_e51408cc-4f7a-5a5f-52e8-caf1359c1d6c,_)
		THEN
		PROC_HAV_EnteringHaven_TriggerDialog((CHARACTER)_Player,(CHARACTER)_Guard);
		TeleportTo(_Player, S_HAV_TrespassReturnPos_28cd1e46-be2c-44c2-810f-a6d4c6c3b25c, "HAV_EnteringHaven_TeleportedToCheckpoint", 1, 1, 1, 1, 1);
		CharacterStopCrime(_Player, "HAV_EnteringHaven_ForbiddenArea", NULL_00000000-0000-0000-0000-000000000000);
		NOT DB_HAV_EnteringHaven_GuardSpottedSneaker(_Guard);
		
		//Add revealed player to the ongoing checkpoint dialog after the trespass crime one
		PROC
		PROC_FlagReactionAfterDialog((CHARACTER)_Player,(FLAG)HAV_EnteringHaven_TrespasserSpotted_368a6fef-ece0-a1db-f1da-146dd32a6634)
		AND
		DB_HAV_EnteringHaven_GuardSpottedSneaker(_Guard)
		AND
		DB_DialogName((DIALOGRESOURCE)HAV_EnteringHaven_TadpoleCheckpoint_e51408cc-4f7a-5a5f-52e8-caf1359c1d6c,_ID)
		THEN
		CharacterStopCrime(_Player, "HAV_EnteringHaven_ForbiddenArea", NULL_00000000-0000-0000-0000-000000000000);
		TeleportTo(_Player, S_HAV_TrespassReturnPos_28cd1e46-be2c-44c2-810f-a6d4c6c3b25c, "HAV_EnteringHaven_TeleportedToCheckpoint", 1, 1, 1, 1, 1);
		PROC_DialogAddListeningActor(_ID,_Player);
		NOT DB_HAV_EnteringHaven_GuardSpottedSneaker(_Guard);
		
		IF
		FlagSet((FLAG)HAV_EnteringHaven_State_GainedAccess_07c776da-353a-9050-e9be-c42d51a99412,_,_)
		THEN
		PROC_HAV_EnteringHaven_Admitted();
		
		IF
		FlagSet((FLAG)HAV_EnteringHaven_Event_ClawsKilled_d3669128-2cb3-49be-8245-59cedfdc38ef,_,_)
		THEN
		PROC_HAV_EnteringHaven_Admitted();
		
		IF
		CombatStarted(_ID)
		AND
		DB_Is_InCombat(S_HAV_CrawlingClaw_000_d565aab4-ff0a-4308-b7e3-a5e5f154e7ce, _ID)
		THEN
		PROC_HAV_EnteringHaven_Admitted();
		
		
		PROC
		PROC_HAV_EnteringHaven_Admitted()
		THEN
		PROC_RemoveDBTrespassTrigger((TRIGGER)S_HAV_EnteringHaven_ForbiddenArea_307bf271-9af2-4572-967a-e87edf41bf54,(TRIGGER)S_HAV_TrespassReturnPos_28cd1e46-be2c-44c2-810f-a6d4c6c3b25c);
		PROC_TriggerUnregisterForPlayers(S_HAV_EnteringHaven_SpotTrigger_38b4a5b6-47a3-4e3c-826a-1b63c60863f7);
		PROC_GlobalSetFlagAndCache(HAV_EnteringHaven_GainedAccess_StopSpotting_a51abf96-f5df-4dca-9acd-414eee740884);
		
		PROC
		PROC_HAV_EnteringHaven_Admitted()
		AND
		DB_HAV_CheckpointSpotters(_Spotter)
		THEN
		NOT DB_SpotPlayers(_Spotter,"HAV_EnteringHaven_CheckpointSpot",NULL_00000000-0000-0000-0000-000000000000,(FLAG)HAV_EnteringHaven_GainedAccess_StopSpotting_a51abf96-f5df-4dca-9acd-414eee740884);
		NOT DB_SpotPlayers_SpotTrigger(_Spotter,"HAV_EnteringHaven_CheckpointSpot",(TRIGGER)S_HAV_EnteringHaven_SpotTrigger_38b4a5b6-47a3-4e3c-826a-1b63c60863f7);
		NOT DB_SpotPlayers_SpotTrigger_ManualRegistering(S_HAV_EnteringHaven_SpotTrigger_38b4a5b6-47a3-4e3c-826a-1b63c60863f7);
		NOT DB_HAV_CheckpointSpotters(_Spotter);
		
		PROC
		PROC_HAV_EnteringHaven_Admitted()
		AND
		DB_GlobalFlag((FLAG)HAV_EnteringHaven_State_FlamingSpyRevealed_89e1eb87-a718-8dc2-026d-f4db8321b686)
		AND
		DB_GlobalFlag(HAV_EnteringHaven_State_GainedAccess_07c776da-353a-9050-e9be-c42d51a99412)
		THEN
		PROC_HAV_TakingIsobel_TrySendingGuardToIsobel();
		
		QRY
		QRY_CRIME_BlockRegisterCrime(_Player, "HAV_EnteringHaven_ForbiddenArea", _, _, _)
		AND
		DB_GlobalFlag(HAV_EnteringHaven_State_GainedAccess_07c776da-353a-9050-e9be-c42d51a99412)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_CRIME_BlockRegisterCrime(_Player, "HAV_EnteringHaven_ForbiddenArea", _, _, _)
		AND
		DB_GlobalFlag(HAV_EnteringHaven_Event_ClawsKilled_d3669128-2cb3-49be-8245-59cedfdc38ef)
		AND
		NOT DB_GlobalFlag(HAV_EnteringHaven_State_GainedAccess_07c776da-353a-9050-e9be-c42d51a99412)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)HAV_EnteringHaven_TadpoleCheckpoint_e51408cc-4f7a-5a5f-52e8-caf1359c1d6c, _ID)
		AND
		DB_HAV_EnteringHaven_ExtraSpeaker(_Speaker)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(_Speaker, S_HAV_Checkpoint_JaheiraHome2_54db1d5b-11fb-48de-b799-f5c67d02b5c7)
		THEN
		PROC_DialogAddSpeakingActor(_ID, _Speaker);
		
		//END_REGION
		
		//REGION Dragging vouchers into dialog
		//Mol Vouch
		IF
		DB_HAV_EnteringHaven_SetupVouchers(1)
		AND
		DB_GlobalFlag(DEN_AttackOnDen_State_DenVictory_71c7f23e-3ff1-c9b8-3ef5-d75fa1b42c8d)
		AND
		DB_HAV_EnteringHaven_DenVouchers(_Voucher, 1)
		THEN
		DB_Inclusion_NPCDialog((DIALOGRESOURCE)HAV_EnteringHaven_TadpoleCheckpoint_e51408cc-4f7a-5a5f-52e8-caf1359c1d6c, _Voucher);
		
		IF
		DB_HAV_EnteringHaven_SetupVouchers(1)
		AND
		DB_GlobalFlag(GOB_State_LeadersAreDead_a1c5b01f-4b7f-47ab-82b0-d24d9c6d8bc6)
		AND
		DB_HAV_EnteringHaven_DenVouchers(_Voucher, 1)
		THEN
		DB_Inclusion_NPCDialog((DIALOGRESOURCE)HAV_EnteringHaven_TadpoleCheckpoint_e51408cc-4f7a-5a5f-52e8-caf1359c1d6c, _Voucher);
		
		QRY
		QRY_Inclusion_SpeakerIsAvailableForInclusion((DIALOGRESOURCE)HAV_EnteringHaven_TadpoleCheckpoint_e51408cc-4f7a-5a5f-52e8-caf1359c1d6c, _, (CHARACTER)S_DEN_ThiefHideoutLeader_c8ab1ca6-96bb-467e-91c9-af87bc4d3925, (CHARACTER)_MainPlayer)
		AND
		DB_HAV_EnteringHaven_DenVouchers(_Voucher, _)
		AND
		QRY_SpeakerIsAvailable(_Voucher)
		AND
		IsInTrigger(_Voucher, S_HAV_Haven_SUB_6ac001f4-9c56-4a1b-963d-a509e158ffab, 1)
		THEN
		DB_NOOP(1);
		
		
		IF
		FlagSet((FLAG)_ObjectInclusionStartEvent, _Char, _ID) // flagType: Object
		AND
		DB_DialogName((DIALOGRESOURCE)HAV_EnteringHaven_TadpoleCheckpoint_e51408cc-4f7a-5a5f-52e8-caf1359c1d6c,_ID)
		AND
		DB_Inclusion_Object((GUIDSTRING)_Voucher,(FLAG)_ObjectInclusionStartEvent,(FLAG)_)
		AND
		DB_HAV_EnteringHaven_DenVouchers((CHARACTER)_Voucher, _)
		AND
		DB_DialogNPCs(_ID, _Voucher, _)
		THEN
		CharacterMoveTo(_Voucher, (TRIGGER)S_HAV_NightsongFollowup_FlorrickPos_Square_e556932a-b14c-4b22-abea-5a4f2532762d,"Run","");
		
		
		//END_REGION
		
		//REGION Making characters tied up.
		IF
		DB_GlobalFlag((FLAG)HAV_EnteringHaven_State_Entangled_2c1ddc2f-6cdf-d804-423b-60e46f69af7c)
		AND
		DB_DialogName((DIALOGRESOURCE)HAV_EnteringHaven_TadpoleCheckpoint_e51408cc-4f7a-5a5f-52e8-caf1359c1d6c, _ID)
		AND
		DB_DialogPlayers(_ID, _Player, _)
		THEN
		ApplyStatus(_Player, "ENSNARED", 1.0, 1, S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a);
		
		IF
		FlagCleared((FLAG)HAV_EnteringHaven_State_Entangled_2c1ddc2f-6cdf-d804-423b-60e46f69af7c, _, _)
		AND
		DB_DialogName((DIALOGRESOURCE)HAV_EnteringHaven_TadpoleCheckpoint_e51408cc-4f7a-5a5f-52e8-caf1359c1d6c, _ID)
		AND
		DB_DialogPlayers(_ID, _Player, _)
		THEN
		RemoveStatus(_Player, "ENSNARED", NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		DB_GlobalFlag((FLAG)HAV_EnteringHaven_State_Entangled_2c1ddc2f-6cdf-d804-423b-60e46f69af7c)
		AND
		NOT DB_DialogName((DIALOGRESOURCE)HAV_EnteringHaven_TadpoleCheckpoint_e51408cc-4f7a-5a5f-52e8-caf1359c1d6c, _)
		THEN
		ClearFlag(HAV_EnteringHaven_State_Entangled_2c1ddc2f-6cdf-d804-423b-60e46f69af7c, NULL_00000000-0000-0000-0000-000000000000, 0);
		//END_REGION
		
		//REGION Claw Set Up
		IF
		DB_HAV_EnteringHaven_Claws(_Claw)
		THEN
		SetOnStage(_Claw, 0);
		
		QRY
		QRY_CorpseLooting_BlockMakeOwned((CHARACTER)_Claw)
		AND
		DB_HAV_EnteringHaven_Claws(_Claw)
		THEN
		DB_NOOP(1);
		//END_REGION
		
		//REGION Harper Hostility
		
		//If you attack Jaheira, make sure this ripples out to the other harpers 
		
		//This should be protected if Moonrise starts as the goal closes, but otherwise the goal doesn't seem to close, so wants checking that we're still in SCL
		
		PROC
		PROC_CharacterRegisterCrime_Success(_Player, _Crime, _, _, S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a, _)
		AND
		QRY_CRIME_IsCrimeFamilyMember(_Crime, "Assault")
		AND
		DB_Players((CHARACTER)_Player)
		AND
		DB_CurrentLevel("SCL_Main_A") 
		THEN
		PROC_GlobalSetFlagAndCache(HAV_EnteringHaven_State_AttackedJaheira_38e31278-b40b-4d39-b79b-ce56f9f973bf);
		
		PROC
		PROC_CharacterRegisterCrime_Success(_Player, _Crime, _, _, S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a, _)
		AND
		QRY_CRIME_IsCrimeFamilyMember(_Crime, "Murder")
		AND
		DB_Players((CHARACTER)_Player)
		AND
		DB_CurrentLevel("SCL_Main_A")
		THEN
		PROC_GlobalSetFlagAndCache(HAV_EnteringHaven_State_AttackedJaheira_38e31278-b40b-4d39-b79b-ce56f9f973bf);
		
		IF
		DialogAttackRequested(S_Player_Jaheira_91b6b200-7d00-4d62-8dc9-99e8339dfa1a, _Player)
		AND
		DB_Players(_Player)
		AND
		DB_CurrentLevel("SCL_Main_A")
		THEN
		PROC_GlobalSetFlagAndCache(HAV_EnteringHaven_State_AttackedJaheira_38e31278-b40b-4d39-b79b-ce56f9f973bf);
		
		IF
		DB_GlobalFlag(HAV_EnteringHaven_State_AttackedJaheira_38e31278-b40b-4d39-b79b-ce56f9f973bf)
		THEN
		PROC_SpotPlayers_StopSpotting("HAV_EnteringHaven_CheckpointSpot");
		PROC_SetRelationToPlayers((FACTION)Act2_HAV_Haven_e52bfc8c-7826-470d-a9f5-f6fae80dde82, 0);
		PROC_HAV_Haven_SetupOtherHarpers();
		
		PROC
		PROC_HAV_Haven_SetupOtherHarpers()
		AND
		DB_GlobalFlag(SCL_HarperScouts_State_ArrivedAtLastLight_a601f3de-a13e-49e4-bf7f-f51eefb3eeda)
		THEN
		PROC_SetRelationToPlayers((FACTION)Act2_SCL_HarperScouts_4581a713-8023-4ceb-b4ae-2c740e7f1e73, 0);
		
		
		PROC
		PROC_HAV_Haven_SetupOtherHarpers()
		AND
		NOT DB_GlobalFlag(SCL_Drider_State_HarpersMovingToAmbush_5bde3cff-5e95-4c86-b368-75c744e02411)
		THEN
		PROC_SetRelationToPlayers((FACTION)ACT2_SCL_HarpersAmbush_f9940d88-f049-4522-a2ae-4b8304e4563c, 0);
		
		//END_REGION
		//REGION Close goal
		
		IF
		FlagSet(MOO_Assault_State_InProgress_0f3a8f5d-7402-4220-bebb-d4b21d3db08d, _, _)
		THEN
		PROC_HAV_EnteringHaven_Admitted();
		
		PROC
		PROC_HAV_EnteringHaven_Admitted()
		THEN
		GoalCompleted;
		
		//END_REGION
	}
	EXIT
	{
		NOT DB_HAV_EnteringHaven_SetupVouchers(1);
	}
}
Goal(348).Title("Act2_HAV_General");
Goal(348)
{
	INIT
	{
		//REGION Haven Area State Manager
		DB_State_Priority(S_HAV_Haven_SUB_6ac001f4-9c56-4a1b-963d-a509e158ffab, "HAV_Area", "HAV_Area_State_BarrierIsOn", 0);
		DB_State_Priority(S_HAV_Haven_SUB_6ac001f4-9c56-4a1b-963d-a509e158ffab, "HAV_Area", "HAV_Area_State_BarrierIsOff", 0);
		DB_State_Priority(S_HAV_Haven_SUB_6ac001f4-9c56-4a1b-963d-a509e158ffab, "HAV_Area", "HAV_Area_State_CurseIsGone", 0);
		
