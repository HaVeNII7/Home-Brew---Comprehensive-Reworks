		//END_REGION
		
		//REGION Dialog
		DB_Dialogs(S_MOO_DockJumper_fd7e05e2-3d4a-4de9-baf5-2be25b21441f, (DIALOGRESOURCE)MOO_Docks_GuardJumper_67ffd8be-bf8d-04bd-1191-b055c719e9fd);
		DB_Dialogs(S_MOO_DockObserver_5d1de164-5969-4593-87b7-1fcb5b54f00f, (DIALOGRESOURCE)MOO_Docks_GuardObserver_4e2729b0-8713-5c9f-01b6-bd1b3e63e2e5);
		DB_Dialogs(S_MOO_DockPatroller_000_646fba8c-6972-4162-aa7a-f0df28bb1f51, (DIALOGRESOURCE)MOO_Docks_GuardPatroller000_e833e99e-0e76-f166-be95-ac9cac50b3cc);
		DB_Dialogs(S_MOO_DockPatroller_001_352693eb-0ef0-4949-86c5-ba78081d9fb4, (DIALOGRESOURCE)MOO_Docks_GuardPatroller001_06e6ea9a-7738-5637-a6fc-10f2c1961a5a);
		//END_REGION
		//REGION Tadpole Vats
		DB_MOO_Docks_DeadTadpoles((CHARACTER)S_MOO_DeadDockTadpole_001_cc837d6c-88ab-4511-94ed-ab7f2f5bb778);
		DB_MOO_Docks_DeadTadpoles(S_MOO_DeadDockTadpole_002_636821ae-fadf-4b30-b5ff-91508872c9b9);
		DB_MOO_Docks_DeadTadpoles(S_MOO_DeadDockTadpole_003_434023c1-0279-4096-a320-f665e6878bb7);
		
		SetOnStage(S_MOO_LivingDockTadpole_3a283ec1-9273-4a23-8412-5406fada4608, 0);
		SetOnStage(S_MOO_DeadDockTadpole_001_cc837d6c-88ab-4511-94ed-ab7f2f5bb778, 0);
		SetOnStage(S_MOO_DeadDockTadpole_002_636821ae-fadf-4b30-b5ff-91508872c9b9, 0);
		SetOnStage(S_MOO_DeadDockTadpole_003_434023c1-0279-4096-a320-f665e6878bb7, 0);
		//END_REGION
		//REGION Registers
		
		DB_ItemOwnerShipTriggers("SCL_Main_A", S_MOO_Docks_SUB_b4608370-46b8-4ba3-a3e7-192a6aa509ee, S_MOO_DockObserver_5d1de164-5969-4593-87b7-1fcb5b54f00f);
		DB_ItemOwnerShipClearItem("SCL_Main_A", S_MOO_DockDoor_ada141ae-e0a8-4915-a9c7-355093370992);
		
		TriggerRegisterForCharacter((TRIGGER)S_MOO_Docks_SUB_b4608370-46b8-4ba3-a3e7-192a6aa509ee,S_MOO_DockObserver_5d1de164-5969-4593-87b7-1fcb5b54f00f);
		TriggerRegisterForCharacter((TRIGGER)S_MOO_Docks_SUB_b4608370-46b8-4ba3-a3e7-192a6aa509ee,S_MOO_DockPatroller_000_646fba8c-6972-4162-aa7a-f0df28bb1f51);
		TriggerRegisterForCharacter((TRIGGER)S_MOO_Docks_SUB_b4608370-46b8-4ba3-a3e7-192a6aa509ee,S_MOO_DockPatroller_001_352693eb-0ef0-4949-86c5-ba78081d9fb4);
		TriggerRegisterForCharacter((TRIGGER)S_MOO_Docks_SUB_b4608370-46b8-4ba3-a3e7-192a6aa509ee,S_MOO_DockObserver_5d1de164-5969-4593-87b7-1fcb5b54f00f);
		//END_REGION
		//REGION Guards
		DB_MOO_Docks_Guards((CHARACTER)S_MOO_DockJumper_fd7e05e2-3d4a-4de9-baf5-2be25b21441f);
		DB_MOO_Docks_Guards(S_MOO_DockObserver_5d1de164-5969-4593-87b7-1fcb5b54f00f);
		DB_MOO_Docks_Guards(S_MOO_DockPatroller_000_646fba8c-6972-4162-aa7a-f0df28bb1f51);
		DB_MOO_Docks_Guards(S_MOO_DockPatroller_001_352693eb-0ef0-4949-86c5-ba78081d9fb4);
		
		DB_SpotPlayers(S_MOO_DockJumper_fd7e05e2-3d4a-4de9-baf5-2be25b21441f, "MOO_Docks_JumperGreetingSpot", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		TriggerRegisterForCharacter(S_MOO_DockJumpBox_c6d1c041-89be-47fc-8020-a638fdfb8d72, S_MOO_DockJumper_fd7e05e2-3d4a-4de9-baf5-2be25b21441f);
		//END_REGION
		//REGION Cargo
		DB_MOO_Docks_Cargo((ITEM)S_MOO_CargoFood_002_c756029f-595a-460e-be51-717b4db0ca6e);
		DB_MOO_Docks_Cargo(S_MOO_CargoFood_001_95b0fe20-8e20-45e0-bda3-5f12e293088d);
		DB_MOO_Docks_Cargo(S_MOO_CargoAlcohol_001_b0ddae61-3202-45d1-9c93-8ba741c7f75b);
		DB_MOO_Docks_Cargo(S_MOO_CargoAlcohol_000_35aefabf-915a-4368-a906-d7d620b6502f);
		DB_MOO_Docks_Cargo(S_MOO_CargoFood_000_c60c189f-207e-46bb-abb3-256a5a84f1fb);
		DB_MOO_Docks_Cargo(S_MOO_DockVat_000_f503073f-8373-483e-8955-f8b05a627a4f);
		//END_REGION
	}
	KB
	{
		//REGION Debug
		IF
		TextEvent("moodocks_spawntadpoles")
		THEN
		PROC_MOO_Docks_SpawnTadpoles();
		
		IF
		TextEvent("moodocks_jumpandreport")
		THEN
		SetFlag(MOO_Docks_Event_GuardJumped_c44a224f-3917-4438-91a8-20335d34fcdf);
		SetFlag(MOO_Docks_State_ReportJump_bb1038ca-1eba-4f1b-8803-4d47ced56d2a);
		//END_REGION
		
		//REGION Jumper
		IF
		FlagSet(MOO_Docks_Event_GuardJumped_c44a224f-3917-4438-91a8-20335d34fcdf, _, _)
		AND
		DB_MOO_Docks_Guards(_Guard)
		AND
		_Guard != S_MOO_DockJumper_fd7e05e2-3d4a-4de9-baf5-2be25b21441f
		AND
		DB_Sees(_Guard, S_MOO_DockJumper_fd7e05e2-3d4a-4de9-baf5-2be25b21441f)
		THEN
		SetFlag(MOO_Docks_State_GuardWitnessTrueSoul_d29a77f4-7148-40c6-bc97-2b10864ae998, _Guard);
		
		IF
		FlagSet(MOO_Docks_Event_GuardJumped_c44a224f-3917-4438-91a8-20335d34fcdf, _, _)
		THEN
		DB_SceneManager(S_MOO_DockJumper_fd7e05e2-3d4a-4de9-baf5-2be25b21441f, "MOO_Docks_Jumper");
		
		IF
		DB_PermaDefeated(S_MOO_DockJumper_fd7e05e2-3d4a-4de9-baf5-2be25b21441f)
		THEN
		PROC_SceneOver("MOO_Docks_Jumper");
		
		IF
		FlagSet(MOO_Docks_State_PersuasionSuccess_975a23d6-bc82-48f3-9c1a-80bd01d44249, _, _)
		AND
		DB_MOO_Docks_Cargo(_Item)
		THEN
		ClearOwnership(_Item);
		
		PROC
		PROC_SpotPlayers_Spotted(S_MOO_DockJumper_fd7e05e2-3d4a-4de9-baf5-2be25b21441f, "MOO_Docks_JumperGreetingSpot", _Player)
		AND
		DB_Players(_Player)
		AND
		GetFaction(_Player, _PlayerFaction)
		AND
		GetFaction(S_MOO_DockJumper_fd7e05e2-3d4a-4de9-baf5-2be25b21441f, _JumperFaction)
		AND
		GetRelation(_JumperFaction, _PlayerFaction, _Relation)
		AND
		_Relation >= 50
		THEN
		PROC_TryStartAD(MOO_Docks_AD_JumperGreeting_5cf7bc3d-517f-2b05-6c7b-d915a9f5485d, S_MOO_DockJumper_fd7e05e2-3d4a-4de9-baf5-2be25b21441f);
		
		IF
		EnteredTrigger(S_MOO_DockJumper_fd7e05e2-3d4a-4de9-baf5-2be25b21441f, S_MOO_DockJumpBox_c6d1c041-89be-47fc-8020-a638fdfb8d72)
		AND
		DB_GlobalFlag(MOO_Docks_Event_GuardJumped_c44a224f-3917-4438-91a8-20335d34fcdf)
		THEN
		SetFlag(MOO_Docks_Event_WitnessJump_88cbe282-918b-4fc0-a15a-9a1e24ee05ff);
		//END_REGION
		
		//REGION Tadpole Vats
		PROC
		PROC_BlockUseOfItem(_Char,S_MOO_DockVat_000_f503073f-8373-483e-8955-f8b05a627a4f)
		AND
		DB_Players(_Char)
		AND
		DB_CantTalk(_Char)
		THEN
		DB_CustomUseItemResponse(_Char,S_MOO_DockVat_000_f503073f-8373-483e-8955-f8b05a627a4f,0);
		PROC_PlayCantUseItemAD(_Char);
		
		IF
		UseStarted(_Player,S_MOO_DockVat_000_f503073f-8373-483e-8955-f8b05a627a4f)
		AND
		DB_Players(_Player)
		AND
		QRY_StartDialog_Fixed(MOO_Docks_Vat_cef338c1-19d2-9aa9-17d6-4c1354f9a956, S_MOO_DockVat_000_f503073f-8373-483e-8955-f8b05a627a4f, _Player)
		THEN
		DB_Noop(1);
		
		//This is their special box. They get really angry for hitting it.
		QRY
		QRY_CRIME_BlockRegisterCrime(_Criminal,"Vandalise",_,S_MOO_DockVat_000_f503073f-8373-483e-8955-f8b05a627a4f,_,_ID)
		AND
		DB_MOO_Docks_Guards(_Guard)
		AND
		DB_Sees(_Guard, _Criminal)
		AND
		DB_InRegion(_Guard, S_MOO_Docks_SUB_b4608370-46b8-4ba3-a3e7-192a6aa509ee)
		THEN
		SetFaction(_Guard, (FACTION)ACT2_MOO_Docks_Hostile_17f4411b-a02b-4244-a2f5-80298a21f0d7);
		
		QRY
		QRY_CRIME_BlockRegisterCrime(_Criminal,"VandaliseNoOwner",_,S_MOO_DockVat_000_f503073f-8373-483e-8955-f8b05a627a4f,_,_ID)
		AND
		DB_MOO_Docks_Guards(_Guard)
		AND
		DB_Sees(_Guard, _Criminal)
		AND
		DB_InRegion(_Guard, S_MOO_Docks_SUB_b4608370-46b8-4ba3-a3e7-192a6aa509ee)
		THEN
		SetFaction(_Guard, (FACTION)ACT2_MOO_Docks_Hostile_17f4411b-a02b-4244-a2f5-80298a21f0d7);
		
		IF
		DestroyedBy(S_MOO_DockVat_000_f503073f-8373-483e-8955-f8b05a627a4f, _, _, _)
		THEN
		SetFlag(MOO_Docks_State_VatDestroyed_d7926e38-0014-4dbb-b466-208fcb488a70);
		TeleportTo(S_MOO_VatHelper_ab6f3cf1-ad53-4f2b-b957-f61cd7f48a12, S_MOO_DockVat_000_f503073f-8373-483e-8955-f8b05a627a4f);
		PROC_MOO_Docks_SpawnTadpoles();
		
		PROC
		PROC_MOO_Docks_SpawnTadpoles()
		AND
		DB_MOO_Docks_DeadTadpoles(_Tadpole)
		THEN
		TeleportTo(_Tadpole, S_MOO_DockVat_000_f503073f-8373-483e-8955-f8b05a627a4f);
		SetOnStage(_Tadpole, 1);
		
		PROC
		PROC_MOO_Docks_SpawnTadpoles()
		THEN
		TeleportTo(S_MOO_LivingDockTadpole_3a283ec1-9273-4a23-8412-5406fada4608, S_MOO_DockVat_000_f503073f-8373-483e-8955-f8b05a627a4f);
		SetOnStage(S_MOO_LivingDockTadpole_3a283ec1-9273-4a23-8412-5406fada4608, 1);
		
		//END_REGION
		
		//REGION Docks Checkpoint
		IF
		DialogStarted(MOO_EntranceCheckpoint_1093e6c8-71d0-fdd2-3729-71325e273403, _)
		AND
		DB_MOO_DocksEntranceGuard(_Guard)
		THEN
		PROC_SpotPlayers_StopSpotting(_Guard, "MOO_Dock_Entrance");
		
		IF
		DialogStarted(MOO_EntranceCheckpoint_Drider_6ff49f36-ce1d-872e-51cc-aa8632d601dd, _)
		AND
		DB_MOO_DocksEntranceGuard(_Guard)
		THEN
		PROC_SpotPlayers_StopSpotting(_Guard, "MOO_Dock_Entrance");
		
		IF
		DialogStarted(MOO_Docks_Checkpoint_2783e81e-4167-1eaa-ca61-5131f11aa70e, _)
		AND
		DB_MOO_DocksEntranceGuard(_Guard)
		THEN
		PROC_SpotPlayers_StopSpotting(_Guard, "MOO_Dock_Entrance");
		
		PROC
		PROC_SpotPlayers_Spotted(_Guard, "MOO_Dock_Entrance", _Player)
		AND
		NOT DB_GlobalFlag(MOO_EntranceCheckpoint_State_HasEnteredInterior_13ffee84-f71d-4356-b257-8716f28c990a)
		AND
		NOT DB_CantTalk(S_MOO_DockPatroller_002_e7e5e250-5f80-4424-9c25-287d79142a1b)
		AND
		QRY_StartDialog(MOO_Docks_Checkpoint_2783e81e-4167-1eaa-ca61-5131f11aa70e, S_MOO_DockPatroller_002_e7e5e250-5f80-4424-9c25-287d79142a1b, _Player)
		THEN
		NOT DB_Dialog_AddAllNearbyPlayersAtStart((DIALOGRESOURCE)MOO_Docks_Checkpoint_2783e81e-4167-1eaa-ca61-5131f11aa70e);
		
		IF
		FlagSet(MOO_EntranceCheckpoint_State_HasEnteredInterior_13ffee84-f71d-4356-b257-8716f28c990a, _, _)
		AND
		NOT DB_DialogSpeakers(_, (CHARACTER)S_MOO_DockPatroller_002_e7e5e250-5f80-4424-9c25-287d79142a1b, _)
		THEN
		PROC_CharacterMoveTo((CHARACTER)S_MOO_DockPatroller_002_e7e5e250-5f80-4424-9c25-287d79142a1b, (ITEM)S_MOO_DockDoor_ada141ae-e0a8-4915-a9c7-355093370992, "Walk", "MOO_Docks_WalkToDoor");
		
		IF
		DialogEnded(MOO_Docks_Checkpoint_2783e81e-4167-1eaa-ca61-5131f11aa70e, _)
		THEN
		PROC_CharacterMoveTo((CHARACTER)S_MOO_DockPatroller_002_e7e5e250-5f80-4424-9c25-287d79142a1b, (ITEM)S_MOO_DockDoor_ada141ae-e0a8-4915-a9c7-355093370992, "Walk", "MOO_Docks_WalkToDoor");
		
		IF
		DialogEnded(MOO_EntranceCheckpoint_1093e6c8-71d0-fdd2-3729-71325e273403, _)
		THEN
		PROC_CharacterMoveTo((CHARACTER)S_MOO_DockPatroller_002_e7e5e250-5f80-4424-9c25-287d79142a1b, (ITEM)S_MOO_DockDoor_ada141ae-e0a8-4915-a9c7-355093370992, "Walk", "MOO_Docks_WalkToDoor");
		
		IF
		DialogEnded(MOO_EntranceCheckpoint_Drider_6ff49f36-ce1d-872e-51cc-aa8632d601dd, _)
		THEN
		PROC_CharacterMoveTo((CHARACTER)S_MOO_DockPatroller_002_e7e5e250-5f80-4424-9c25-287d79142a1b, (ITEM)S_MOO_DockDoor_ada141ae-e0a8-4915-a9c7-355093370992, "Walk", "MOO_Docks_WalkToDoor");
		
		IF
		EntityEvent(_, "MOO_Docks_WalkToDoor")
		THEN
		Use((CHARACTER)S_MOO_DockPatroller_002_e7e5e250-5f80-4424-9c25-287d79142a1b, (ITEM)S_MOO_DockDoor_ada141ae-e0a8-4915-a9c7-355093370992, "MOO_Docks_DisappearToOubliette");
		
		IF
		UseStarted((CHARACTER)S_MOO_DockPatroller_002_e7e5e250-5f80-4424-9c25-287d79142a1b, (ITEM)S_MOO_DockDoor_ada141ae-e0a8-4915-a9c7-355093370992)
		AND
		QRY_CheckOtherPlayersInTrigger(NULL_00000000-0000-0000-0000-000000000000, (TRIGGER)S_MOO_Oubliette_SUB_c6f54de0-1c8f-4cf8-bcf9-b13c8f53b05b)
		THEN
		DB_MOO_Docks_CheckpointHoldingPatternForOubliette(S_MOO_DockPatroller_002_e7e5e250-5f80-4424-9c25-287d79142a1b);
		SetOnStage(S_MOO_DockPatroller_002_e7e5e250-5f80-4424-9c25-287d79142a1b, 0);
		
		IF
		UseStarted((CHARACTER)S_MOO_DockPatroller_002_e7e5e250-5f80-4424-9c25-287d79142a1b, (ITEM)S_MOO_DockDoor_ada141ae-e0a8-4915-a9c7-355093370992)
		AND
		NOT QRY_CheckOtherPlayersInTrigger(NULL_00000000-0000-0000-0000-000000000000, (TRIGGER)S_MOO_Oubliette_SUB_c6f54de0-1c8f-4cf8-bcf9-b13c8f53b05b)
		THEN
		TeleportTo((CHARACTER)S_MOO_DockPatroller_002_e7e5e250-5f80-4424-9c25-287d79142a1b, S_MOO_Docks_EntranceGuardDeathPoint_da428a0c-4b95-4387-ab20-223583b1893c);
		Die((CHARACTER)S_MOO_DockPatroller_002_e7e5e250-5f80-4424-9c25-287d79142a1b, DEATHTYPE.Psychic, 1);
		
		IF
		LeftTrigger((CHARACTER)_Player, (TRIGGER)S_MOO_Oubliette_SUB_c6f54de0-1c8f-4cf8-bcf9-b13c8f53b05b)
		AND
		DB_MOO_Docks_CheckpointHoldingPatternForOubliette(S_MOO_DockPatroller_002_e7e5e250-5f80-4424-9c25-287d79142a1b)
		AND
		DB_Players(_Player)
		AND
		NOT QRY_CheckOtherPlayersInTrigger(NULL_00000000-0000-0000-0000-000000000000, (TRIGGER)S_MOO_Oubliette_SUB_c6f54de0-1c8f-4cf8-bcf9-b13c8f53b05b)
		THEN
		TeleportTo((CHARACTER)S_MOO_DockPatroller_002_e7e5e250-5f80-4424-9c25-287d79142a1b, S_MOO_Docks_EntranceGuardDeathPoint_da428a0c-4b95-4387-ab20-223583b1893c);
		SetOnStage(S_MOO_DockPatroller_002_e7e5e250-5f80-4424-9c25-287d79142a1b, 1);
		Die((CHARACTER)S_MOO_DockPatroller_002_e7e5e250-5f80-4424-9c25-287d79142a1b, DEATHTYPE.Psychic, 1);
		NOT DB_MOO_Docks_CheckpointHoldingPatternForOubliette(S_MOO_DockPatroller_002_e7e5e250-5f80-4424-9c25-287d79142a1b);
		
		IF
		DB_MOO_DocksEntranceGuard(_Guard)
		AND
		NOT DB_Defeated(_Guard)
		AND
		NOT DB_Is_InCombat(_Guard, _)
		THEN
		SetWeaponUnsheathed(_Guard, 1, 1);
		//END_REGION
		
		//REGION Guards in Docks are in a combat group
		
		IF
		EnteredTrigger(_Guard, S_MOO_Docks_SUB_b4608370-46b8-4ba3-a3e7-192a6aa509ee)
		AND
		DB_MOO_Docks_Guards(_Guard)
		THEN
		SetCombatGroupID(_Guard, "MOO_Docks");
		
		IF
		LeftTrigger(_Guard, S_MOO_Docks_SUB_b4608370-46b8-4ba3-a3e7-192a6aa509ee)
		AND
		DB_MOO_Docks_Guards(_Guard)
		THEN
		SetCombatGroupID(_Guard, "");
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(382).Title("Act2_MOO_EntranceCheckpoint");
Goal(382)
{
	INIT
	{
		DB_SpotPlayers(S_MOO_EntranceGuard_001_b302d246-59ff-48ee-8247-0e3bcfd4b38e, "MOO_Entrance", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		DB_SpotPlayers(S_MOO_EntranceGuard_002_2ab30cea-d3f1-4aa4-8c83-b8b700ef0048, "MOO_Entrance", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		DB_SpotPlayers_IncludeWildshapedPlayers(S_MOO_EntranceGuard_001_b302d246-59ff-48ee-8247-0e3bcfd4b38e, "MOO_Entrance");
		DB_SpotPlayers_IncludeWildshapedPlayers(S_MOO_EntranceGuard_002_2ab30cea-d3f1-4aa4-8c83-b8b700ef0048, "MOO_Entrance");
		DB_SpotPlayers_SpotTrigger(S_MOO_EntranceGuard_001_b302d246-59ff-48ee-8247-0e3bcfd4b38e, "MOO_Entrance", S_MOO_EntranceSpotBox_c61282a8-def0-4a81-8085-84f366db0a76);
		DB_SpotPlayers_SpotTrigger(S_MOO_EntranceGuard_002_2ab30cea-d3f1-4aa4-8c83-b8b700ef0048, "MOO_Entrance", S_MOO_EntranceSpotBox_c61282a8-def0-4a81-8085-84f366db0a76);
		DB_SpotPlayers_Continuous(S_MOO_EntranceGuard_001_b302d246-59ff-48ee-8247-0e3bcfd4b38e, "MOO_Entrance");
		DB_SpotPlayers_Continuous(S_MOO_EntranceGuard_002_2ab30cea-d3f1-4aa4-8c83-b8b700ef0048, "MOO_Entrance");
		
		DB_Dialogs(S_MOO_EntranceGuard_001_b302d246-59ff-48ee-8247-0e3bcfd4b38e, MOO_EntranceCheckpoint_Guard1_45c4d71d-1295-cfbb-78ca-adeb629dcc55);
		DB_Dialogs(S_MOO_EntranceGuard_002_2ab30cea-d3f1-4aa4-8c83-b8b700ef0048, MOO_EntranceCheckpoint_Guard2_d195b758-5218-6879-6914-db29b3f42bc6);
		DB_DropMutingStatussesDialog(MOO_EntranceCheckpoint_Drider_6ff49f36-ce1d-872e-51cc-aa8632d601dd);
		DB_DropMutingStatussesDialog(MOO_EntranceCheckpoint_1093e6c8-71d0-fdd2-3729-71325e273403);
		DB_Inclusion_NPCDialog(MOO_EntranceCheckpoint_Drider_6ff49f36-ce1d-872e-51cc-aa8632d601dd, S_SCL_DriderCaravan_GoblinMelee_000_c176d94a-eaa6-4869-a344-88e44b31e17d);
		
		DB_AutoSaveTrigger(S_MOO_EntranceSaveBox_ce559ee2-920f-4605-8f39-3442951e02be);
		
		DB_MOO_EntranceGuard((CHARACTER)S_MOO_EntranceGuard_001_b302d246-59ff-48ee-8247-0e3bcfd4b38e);
		DB_MOO_EntranceGuard(S_MOO_EntranceGuard_002_2ab30cea-d3f1-4aa4-8c83-b8b700ef0048);
		
		DB_MOO_EntranceCheckpoint_TowerTriggers((TRIGGER)S_MOO_MainFloorInterior_SUB_429a55cc-58d2-4469-9577-852131e1fff3);
		DB_MOO_EntranceCheckpoint_TowerTriggers((TRIGGER)S_MOO_UpperFloorInterior_SUB_93c522d3-04c4-4f71-a1dc-043478c51301);
		
		DB_Dialog_AddAllNearbyPlayersAtStart((DIALOGRESOURCE)MOO_EntranceCheckpoint_Drider_6ff49f36-ce1d-872e-51cc-aa8632d601dd);
		
		PROC_TriggerRegisterForPlayers(S_MOO_DaisyArrivalPoly_894c7ec5-0688-4727-a176-32c12ed49ada);
	}
	KB
	{
		//REGION Debug
		IF
		TextEvent("mooentrance_drider")
		THEN
		PROC_AppearOutOfSightTo((CHARACTER)S_SCL_Drider_aa59ce01-3d2e-42e8-a539-c07e0ea292ab, S_SCL_Drider_StandAtTower_4ea41e07-5b9a-4b18-9ed9-82c9a6d4281f, S_SCL_Drider_StandAtTower_4ea41e07-5b9a-4b18-9ed9-82c9a6d4281f, "SCL_Drider_ArrivedToTower");
		TeleportTo(S_SCL_DriderCaravan_GoblinMelee_000_c176d94a-eaa6-4869-a344-88e44b31e17d, S_SCL_DriderCaravan_GoblinMelee_000_AtTower_9c1ac86f-e6af-4801-aa11-53477c02e95f);
		SetFlag(SCL_Drider_Event_ArrivedToTower_e8d310c2-0b05-4e42-912b-e7199759de2a, NULL_00000000-0000-0000-0000-000000000000);
		PROC_State_Progress(S_SCL_Drider_aa59ce01-3d2e-42e8-a539-c07e0ea292ab, "SCL_TheDrider", "ReachedMoonriseTower");
		
		IF
		TextEvent("mooentrance_sided_drider")
		THEN
		SetFlag(SCL_Drider_State_FoughtInAmbushWithHarpers_229f69f4-3e03-4631-9052-32ec13fb740d);
		SetFlag(SCL_Drider_State_SidedWithCaravan_57a698da-0149-48d1-91fa-9a84a5dcc293);
		
		IF
		TextEvent("mooentrance_sided_harper")
		THEN
		SetFlag(SCL_Drider_State_FoughtInAmbushWithHarpers_229f69f4-3e03-4631-9052-32ec13fb740d);
		SetFlag(SCL_Drider_State_SidedWithHarpers_a130dde9-c086-4486-9cd8-298a67fb6aee);
		
		IF
		TextEvent("mooentrance_drider_noambush")
		THEN
		SetFlag(SCL_Drider_Event_StartCaravanEscort_26062990-9018-4845-a520-d737837fa207);
		SetFlag(SCL_Drider_State_HarpersPermaDefeated_be4a239e-0127-4916-a350-8704a86daea9);
		
		//END_REGION
		
		//REGION Dialog start
		//If the player has already entered the tower, no longer trigger dialog (unless the driders are present)
		IF
		DB_InRegion(_Player, _Trigger)
		AND
		DB_MOO_EntranceCheckpoint_TowerTriggers(_Trigger)
		AND
		DB_PartyMembers(_Player)
		AND
		NOT DB_GlobalFlag(MOO_EntranceCheckpoint_State_HasEnteredInterior_13ffee84-f71d-4356-b257-8716f28c990a)
		THEN
		PROC_GlobalSetFlagAndCache(MOO_EntranceCheckpoint_State_HasEnteredInterior_13ffee84-f71d-4356-b257-8716f28c990a);
		NOT DB_Dialog_AddAllNearbyPlayersAtStart((DIALOGRESOURCE)MOO_EntranceCheckpoint_1093e6c8-71d0-fdd2-3729-71325e273403);
		
		IF
		DialogStarted(MOO_EntranceCheckpoint_1093e6c8-71d0-fdd2-3729-71325e273403, _)
		AND
		DB_MOO_EntranceGuard(_Guard)
		THEN
		PROC_SpotPlayers_StopSpotting(_Guard, "MOO_Entrance");
		
		IF
		DialogStarted(MOO_EntranceCheckpoint_Drider_6ff49f36-ce1d-872e-51cc-aa8632d601dd, _)
		AND
		DB_MOO_EntranceGuard(_Guard)
		THEN
		PROC_SpotPlayers_StopSpotting(_Guard, "MOO_Entrance");
		
		IF
		DialogStarted(MOO_Docks_Checkpoint_2783e81e-4167-1eaa-ca61-5131f11aa70e, _)
		AND
		DB_MOO_EntranceGuard(_Guard)
		THEN
		PROC_SpotPlayers_StopSpotting(_Guard, "MOO_Dock_Entrance");
		
		IF
		DB_SpotPlayers_Spotted(_Guard, "MOO_Entrance", _Player)
		AND
		DB_State_Current(S_SCL_Drider_aa59ce01-3d2e-42e8-a539-c07e0ea292ab, "SCL_TheDrider", "ReachedMoonriseTower")
		AND
		NOT DB_CantTalk_IgnoreStatuses(S_SCL_Drider_aa59ce01-3d2e-42e8-a539-c07e0ea292ab)
		AND
		NOT DB_CantTalk_IgnoreStatuses(S_MOO_EntranceGuard_001_b302d246-59ff-48ee-8247-0e3bcfd4b38e)
		AND
		NOT DB_CantTalk_IgnoreStatuses(S_MOO_EntranceGuard_002_2ab30cea-d3f1-4aa4-8c83-b8b700ef0048)
		AND
		QRY_StartDialog(MOO_EntranceCheckpoint_Drider_6ff49f36-ce1d-872e-51cc-aa8632d601dd,S_SCL_Drider_aa59ce01-3d2e-42e8-a539-c07e0ea292ab,S_MOO_EntranceGuard_001_b302d246-59ff-48ee-8247-0e3bcfd4b38e,S_MOO_EntranceGuard_002_2ab30cea-d3f1-4aa4-8c83-b8b700ef0048,_Player)
		THEN
		DB_CRIME_Guards_RegionGuard("SCL_Main_A_MOO", "Main Prison", S_MOO_EntranceGuard_001_b302d246-59ff-48ee-8247-0e3bcfd4b38e);
		DB_CRIME_Guards_RegionGuard("SCL_Main_A_MOO", "Main Prison", S_MOO_EntranceGuard_002_2ab30cea-d3f1-4aa4-8c83-b8b700ef0048);
		NOT DB_Dialog_AddAllNearbyPlayersAtStart((DIALOGRESOURCE)MOO_EntranceCheckpoint_Drider_6ff49f36-ce1d-872e-51cc-aa8632d601dd);
		
		IF
		DB_SpotPlayers_Spotted(_Guard, "MOO_Entrance", _Player)
		AND
		NOT DB_GlobalFlag(MOO_EntranceCheckpoint_State_HasEnteredInterior_13ffee84-f71d-4356-b257-8716f28c990a)
		AND
		NOT DB_CantTalk(S_MOO_EntranceGuard_001_b302d246-59ff-48ee-8247-0e3bcfd4b38e)
		AND
		NOT DB_CantTalk(S_MOO_EntranceGuard_002_2ab30cea-d3f1-4aa4-8c83-b8b700ef0048)
		AND
		QRY_StartDialog(MOO_EntranceCheckpoint_1093e6c8-71d0-fdd2-3729-71325e273403,S_MOO_EntranceGuard_001_b302d246-59ff-48ee-8247-0e3bcfd4b38e,S_MOO_EntranceGuard_002_2ab30cea-d3f1-4aa4-8c83-b8b700ef0048,_Player)
		THEN
		DB_CRIME_Guards_RegionGuard("SCL_Main_A_MOO", "Main Prison", S_MOO_EntranceGuard_001_b302d246-59ff-48ee-8247-0e3bcfd4b38e);
		DB_CRIME_Guards_RegionGuard("SCL_Main_A_MOO", "Main Prison", S_MOO_EntranceGuard_002_2ab30cea-d3f1-4aa4-8c83-b8b700ef0048);
		NOT DB_Dialog_AddAllNearbyPlayersAtStart((DIALOGRESOURCE)MOO_EntranceCheckpoint_1093e6c8-71d0-fdd2-3729-71325e273403);
		
		IF
		FlagSet(MOO_EntranceCheckpoint_State_HasEnteredInterior_13ffee84-f71d-4356-b257-8716f28c990a, _, _)
		THEN
		DB_CRIME_Guards_RegionGuard("SCL_Main_A_MOO", "Main Prison", S_MOO_EntranceGuard_001_b302d246-59ff-48ee-8247-0e3bcfd4b38e);
		DB_CRIME_Guards_RegionGuard("SCL_Main_A_MOO", "Main Prison", S_MOO_EntranceGuard_002_2ab30cea-d3f1-4aa4-8c83-b8b700ef0048);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)MOO_EntranceCheckpoint_Drider_6ff49f36-ce1d-872e-51cc-aa8632d601dd,(INTEGER)_ID)
		AND
		DB_CheckPointGuard(_Char,_,"MOO_EntranceCheckpoint")
		AND
		NOT DB_CantTalk_IgnoreStatuses(_Char)
		THEN
		PROC_DialogAddSpeakingActor(_ID,_Char);
		
		PROC
		PROC_StartDialog_AddExtraSpeakers((DIALOGRESOURCE)MOO_EntranceCheckpoint_Drider_6ff49f36-ce1d-872e-51cc-aa8632d601dd,(INTEGER)_ID)
		AND
		NOT DB_CantTalk_IgnoreStatuses((CHARACTER)S_SCL_DriderCaravan_GoblinMelee_000_c176d94a-eaa6-4869-a344-88e44b31e17d)
		AND
		QRY_SpeakerIsInDialogRange((CHARACTER)S_SCL_DriderCaravan_GoblinMelee_000_c176d94a-eaa6-4869-a344-88e44b31e17d,S_SCL_Drider_aa59ce01-3d2e-42e8-a539-c07e0ea292ab)
		THEN
		PROC_DialogAddSpeakingActor(_ID,(CHARACTER)S_SCL_DriderCaravan_GoblinMelee_000_c176d94a-eaa6-4869-a344-88e44b31e17d);
		
		IF
		DB_MOO_EntranceGuard(_Guard)
		AND
		NOT DB_Defeated(_Guard)
		AND
		NOT DB_Is_InCombat(_Guard, _)
		THEN
		SetWeaponUnsheathed(_Guard, 1, 1);
		
		//END_REGION
		
		//REGION Autosave
		IF
		UseStarted(_Player, DOOR_Double_Big_Dungeon_Abbey_A_012_a8ea87de-3906-439f-bba3-9a375fbba4ef)
		AND
		DB_AutoSaveTrigger(S_MOO_EntranceSaveBox_ce559ee2-920f-4605-8f39-3442951e02be)
		AND
		DB_Players(_Player)
		THEN
		NOT DB_AutoSaveTrigger(S_MOO_EntranceSaveBox_ce559ee2-920f-4605-8f39-3442951e02be);
		PROC_TriggerUnregisterForPlayers(S_MOO_EntranceSaveBox_ce559ee2-920f-4605-8f39-3442951e02be);
		//END_REGION
		
		//REGION Daisy
		IF
		EnteredTrigger(_Avatar, S_MOO_DaisyArrivalPoly_894c7ec5-0688-4727-a176-32c12ed49ada)
		AND
		DB_Avatars((CHARACTER)_Avatar)
		AND
		NOT DB_DaisyAD_Played((CHARACTER)_Avatar,(DIALOGRESOURCE)MOO_EntranceCheckpoint_DaisyAD_Approach_684fb598-4a6e-4491-5d3d-5c6d7bf29341)
		THEN
		PROC_DaisyAD(_Avatar, MOO_EntranceCheckpoint_DaisyAD_Approach_684fb598-4a6e-4491-5d3d-5c6d7bf29341);
		//END_REGION 
		
		PROC
		PROC_State_Changed(S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6, "MOO", _)
		AND
		NOT QRY_State_IsBeforeState(S_MOO_MoonriseTower_SUB_14187ad9-cf83-44f9-81bf-bb46cb4cd8e6, "MOO", "MOO_State_Assault")
		THEN
		PROC_MOO_EntranceCheckpoint_CloseGoalCleanup();
		
		PROC
		PROC_MOO_EntranceCheckpoint_CloseGoalCleanup()
		AND
		DB_MOO_EntranceGuard(_Guard)
		THEN
		PROC_SpotPlayers_StopSpotting(_Guard, "MOO_Entrance");
		
		PROC
		PROC_MOO_EntranceCheckpoint_CloseGoalCleanup()
		THEN
		GoalCompleted;
		
	}
	EXIT
	{
	}
}
Goal(383).Title("Act2_MOO_Execution");
Goal(383)
{
	INIT
	{
		//REGION Execution scene
		
		DB_SceneManager((CHARACTER)S_MOO_Executioner_8e75eb3b-7551-485e-8f98-2bf2e51d3e84, "MOO_Execution");
		DB_SceneManager((CHARACTER)S_MOO_Ketheric_e9918f3e-5b87-40a3-a9bd-61545151573f, "MOO_Execution");
