		//REGION Backup gondians for Workroom
		PROC
		PROC_GLO_DefeatCounter_Notify("LOW_SteelWatchFoundry_WorkroomOriginalGondians", _, _DefeatedCount, _PermaDefeatedCount)
		AND
		IntegerSum(_DefeatedCount, _PermaDefeatedCount, _TotalDefeatedCount)
		AND
		DB_LOW_SteelWatchFoundry_DefeatedWorkroomGondianCount(_OldDefeatCount)
		THEN
		NOT DB_LOW_SteelWatchFoundry_DefeatedWorkroomGondianCount(_OldDefeatCount);
		DB_LOW_SteelWatchFoundry_DefeatedWorkroomGondianCount(_TotalDefeatedCount);
		
		PROC
		PROC_GLO_DefeatCounter_Notify("LOW_SteelWatchFoundry_WorkroomOriginalGondians", _, _DefeatedCount, _PermaDefeatedCount)
		AND
		IntegerSum(_DefeatedCount, _PermaDefeatedCount, _TotalDefeatedCount)
		AND
		NOT DB_LOW_SteelWatchFoundry_DefeatedWorkroomGondianCount(_)
		THEN
		DB_LOW_SteelWatchFoundry_DefeatedWorkroomGondianCount(_TotalDefeatedCount);
		
		//Adding surviving workroom gondians to the workroom gondians defeatcounter
		PROC
		PROC_LOW_SteelWatchFoundry_SetUpAfterIRN()
		AND
		NOT DB_GlobalFlag((FLAG)LOW_SteelWatchFoundry_State_FundangoPermadefeated_8fbcef5a-d738-4a7a-be04-58e6ae551b9b)
		AND
		DB_LOW_WorkroomGondians(_Gondian)
		AND
		NOT DB_PermaDefeated(_Gondian)
		THEN
		DB_GLO_DefeatCounter(_Gondian, "LOW_SteelWatchFoundry_WorkroomPostIRNGondians");
		
		PROC
		PROC_LOW_SteelWatchFoundry_SetUpAfterIRN()
		AND
		NOT DB_GlobalFlag((FLAG)LOW_SteelWatchFoundry_State_FundangoPermadefeated_8fbcef5a-d738-4a7a-be04-58e6ae551b9b)
		AND
		DB_LOW_SteelWatchFoundry_DefeatedWorkroomGondianCount(_DefeatCount)
		AND
		_DefeatCount>1
		THEN
		PROC_SetOnStage(S_LOW_GondianWorker_PostIRN01_a4eb6135-5656-430f-b5f6-a217feb6eb0d, 1);
		DB_LOW_Gondians(S_LOW_GondianWorker_PostIRN01_a4eb6135-5656-430f-b5f6-a217feb6eb0d);
		DB_GLO_DefeatCounter(S_LOW_GondianWorker_PostIRN01_a4eb6135-5656-430f-b5f6-a217feb6eb0d, "LOW_SteelWatchFoundry_WorkroomPostIRNGondians");
		
		PROC
		PROC_LOW_SteelWatchFoundry_SetUpAfterIRN()
		AND
		NOT DB_GlobalFlag((FLAG)LOW_SteelWatchFoundry_State_FundangoPermadefeated_8fbcef5a-d738-4a7a-be04-58e6ae551b9b)
		AND
		DB_LOW_SteelWatchFoundry_DefeatedWorkroomGondianCount(_DefeatCount)
		AND
		_DefeatCount>2
		THEN
		PROC_SetOnStage(S_LOW_GondianWorker_PostIRN02_b264c860-f30a-45a8-b35d-9f03a0d393b1, 1);
		DB_LOW_Gondians(S_LOW_GondianWorker_PostIRN02_b264c860-f30a-45a8-b35d-9f03a0d393b1);
		DB_GLO_DefeatCounter(S_LOW_GondianWorker_PostIRN02_b264c860-f30a-45a8-b35d-9f03a0d393b1, "LOW_SteelWatchFoundry_WorkroomPostIRNGondians");
		
