		THEN
		//Unequip((CHARACTER)S_LOW_MurderTribunal_Sarevok_ae9f784a-ea64-4297-95a7-8377e85231b6, S_LOW_MurderTribunal_BhaalAmulet_Sarevok_305049b2-b725-4e84-8f47-84fac8ea51f1);
