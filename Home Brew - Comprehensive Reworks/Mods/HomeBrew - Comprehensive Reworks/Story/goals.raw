		DB_DialogName((DIALOGRESOURCE)HAV_Siege_Intro_5ec5abc1-a0d5-5c4e-05bf-b65766c05b99, _ID)
		AND
		DB_DialogRequestCache_SpeakerList_Players(_, _DialogID, _Avatar, 1)
