		DB_UND_FairyRings_ColorComments((ITEM)S_HAG_FairyRings_Swamp_MushroomRing_5c1b1362-0c92-495c-85d5-caa61bb14d26, S_UND_FairyRings_Main_ColorCommentTrigger_1e6884e6-7cac-4a97-9a98-37242b34ee83);
		
		PROC_TriggerRegisterForPlayers(S_UND_FairyRings_TeleportedToUnderdarkPAD_VB_c81fd1f0-5830-4902-9722-3009d7d41820);
		
