		DB_FlagReactionAfterDialog((FLAG)DEN_Thieflings_Event_TookGruel2_cbf45767-7dac-0bdc-1f0f-8203b44798d9, (DIALOGRESOURCE)DEN_General_RefugeeChef_2a4f00f2-fbfe-93cd-119e-13a6e72582c8);
		//END_REGION
	}
	KB
	{
		//REGION Wyll Confrontation
		// Karlach and Wyll are assigned to different users
		IF
		DB_PartOfTheTeam((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c)
		AND
		DB_PartOfTheTeam((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		AND
		NOT QRY_KarlachAndWyllSameUser()
		THEN
		ClearFlag((FLAG)ORI_WyllConfrontation_State_CampMomentCanTrigger_649f5b59-54c5-4107-a482-3ea5b2758d60, NULL_00000000-0000-0000-0000-000000000000);
		SetFlag((FLAG)ORI_WyllConfrontation_State_DifferentUsers_45fabcc9-7d06-4ac5-a54e-12888151194e);
		
		IF
		CharacterReservedUserIDChanged((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c,_,_)
		AND
		NOT QRY_KarlachAndWyllSameUser()
		THEN
		ClearFlag((FLAG)ORI_WyllConfrontation_State_CampMomentCanTrigger_649f5b59-54c5-4107-a482-3ea5b2758d60, NULL_00000000-0000-0000-0000-000000000000);
		SetFlag((FLAG)ORI_WyllConfrontation_State_DifferentUsers_45fabcc9-7d06-4ac5-a54e-12888151194e);
		
		IF
		CharacterReservedUserIDChanged((CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d,_,_)
		AND
		NOT QRY_KarlachAndWyllSameUser()
		THEN
		ClearFlag((FLAG)ORI_WyllConfrontation_State_CampMomentCanTrigger_649f5b59-54c5-4107-a482-3ea5b2758d60, NULL_00000000-0000-0000-0000-000000000000);
		SetFlag((FLAG)ORI_WyllConfrontation_State_DifferentUsers_45fabcc9-7d06-4ac5-a54e-12888151194e);
		
		QRY
		QRY_KarlachAndWyllSameUser()
		AND
		NOT QRY_PreventMPDialogue((CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c,(CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d)
		THEN
		SetFlag((FLAG)ORI_WyllConfrontation_State_CampMomentCanTrigger_649f5b59-54c5-4107-a482-3ea5b2758d60, NULL_00000000-0000-0000-0000-000000000000);
		ClearFlag((FLAG)ORI_WyllConfrontation_State_DifferentUsers_45fabcc9-7d06-4ac5-a54e-12888151194e);
		
		IF
		DB_Camp_QueuedNight((FLAG)NIGHT_WyllConfrontation_2576ba4e-90a9-4da0-bb40-6f012ed4a888)
		AND
		QRY_ORI_KarlachOrWyllInCamp()
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_ORI_KarlachOrWyllInCamp()
		AND
		GetReservedUserID(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d,-65536)
		AND
		NOT GetReservedUserID(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c,-65536)
		THEN
		NOT DB_CampNight_IVB((FLAG)NIGHT_WyllConfrontation_2576ba4e-90a9-4da0-bb40-6f012ed4a888, (VOICEBARKRESOURCE)CAMP_WyllConfrontation_IVB_4d3b59af-491b-9326-4024-421e9a375ced,(CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d);
		DB_CampNight_IVB((FLAG)NIGHT_WyllConfrontation_2576ba4e-90a9-4da0-bb40-6f012ed4a888, (VOICEBARKRESOURCE)CAMP_WyllConfrontation_IVB_4d3b59af-491b-9326-4024-421e9a375ced,(CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		
		QRY
		QRY_ORI_KarlachOrWyllInCamp()
		AND
		GetReservedUserID(S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c,-65536)
		AND
		NOT GetReservedUserID(S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d,-65536)
		THEN
		NOT DB_CampNight_IVB((FLAG)NIGHT_WyllConfrontation_2576ba4e-90a9-4da0-bb40-6f012ed4a888, (VOICEBARKRESOURCE)CAMP_WyllConfrontation_IVB_4d3b59af-491b-9326-4024-421e9a375ced,(CHARACTER)S_Player_Karlach_2c76687d-93a2-477b-8b18-8a14b549304c);
		DB_CampNight_IVB((FLAG)NIGHT_WyllConfrontation_2576ba4e-90a9-4da0-bb40-6f012ed4a888, (VOICEBARKRESOURCE)CAMP_WyllConfrontation_IVB_4d3b59af-491b-9326-4024-421e9a375ced,(CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d);
		
		// Set hostility flags.
		PROC
		PROC_GlobalFlagReactionAfterDialog(ORI_WyllConfrontation_State_KarlachLeftHostile_7571e7ce-ed9c-4495-a8c7-1bba1fc01c74, _Dialog)
		AND
		DB_ORI_WyllConfrontation_CampDialogues(_Dialog)
