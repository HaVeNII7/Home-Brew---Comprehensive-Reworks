		PROC
		PROC_CAMP_GoblinHuntCelebration_SetupTieflings()
		AND
		NOT DB_Defeated(S_DEN_ParentA_d6d88c8b-6ba7-4350-b3b3-d60565a44e90)
		AND
		NOT DB_Defeated(S_DEN_ParentB_397467d4-1631-447b-a505-d44275dca78e)
		AND
		NOT DB_Defeated((CHARACTER)S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156)
		AND
		DB_GlobalFlag(DEN_ShadowDruid_State_KidDied_5b5de896-e733-47ae-81df-85a4b25ebfd1)
		AND
		DB_DEN_ShadowDruid_SnakesCourtHappened(1)
		AND
		DB_CAMP_GoblinHuntCelebration_ParentsScene(_Character, _Pos, _Dialog)
		THEN
		TeleportTo(_Character, _Pos, "CAMP_GoblinHuntCelebration_Teleported");
		LookFromTrigger(_Character, _Pos, 1);
		PROC_RemoveAllDialogEntriesForSpeaker(_Character);
		DB_Dialogs(_Character, _Dialog);
		DB_CAMP_GoblinHuntCelebration_SceneActors(_Character);
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_SetupTieflings()
		AND
		NOT DB_Defeated((CHARACTER)S_GLO_ProdigySister_44d09b0b-0568-456c-b18d-559a0a3f981d)
		AND
		NOT DB_Defeated((CHARACTER)S_GLO_ProdigyBrother_d0187724-c0e2-4019-a01d-a03ee8153f1b)
		AND
		NOT DB_Defeated((CHARACTER)S_GLO_Prodigy_b6a3a9e9-b6eb-4c19-ab3f-4c431178fe1b)
		AND
		DB_GlobalFlag((FLAG)DEN_Prodigy_State_Staying_479db0b1-cc1b-78bf-3e7b-9840747fbd4f)
		AND
		DB_CAMP_GoblinHuntCelebration_ProdigiesScene(_Character, _Pos, _Dialog)
		THEN
		TeleportTo(_Character, _Pos, "CAMP_GoblinHuntCelebration_Teleported");
		LookFromTrigger(_Character, _Pos, 1);
		PROC_RemoveAllDialogEntriesForSpeaker(_Character);
		DB_Dialogs(_Character, _Dialog);
		DB_CAMP_GoblinHuntCelebration_SceneActors(_Character);
		
		//Sleep cutscene starts
		PROC
		PROC_Camp_ForceHideAllNonPlayers() 
		AND
		DB_Camp_QueuedNight((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121)
		AND
		DB_CAMP_GoblinHuntCelebration_SceneActors(_Tiefling)
		THEN
		SetOnStage(_Tiefling, 0);
		
		PROC
		PROC_CampNight_ForceComplete((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121)
		THEN
		PROC_CAMP_GoblinHuntCelebration_RemoveTieflings();
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_RemoveTieflings()
		THEN
		SetOnStage(S_CAMP_SeatRock_003_fcfd2137-5d24-41c3-9f72-2404ce7b30e5, 0);
		SetOnStage(S_CAMP_SeatRock_004_5dfe39f6-a965-4870-8d40-59ab461a4e7e, 0);
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_RemoveTieflings()
		AND
		DB_CAMP_GoblinHuntCelebration_SceneActors(_Tiefling)
		AND
		_Tiefling != S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156
		THEN
		SetOnStage(_Tiefling, 0);
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_RemoveTieflings()
		AND
		NOT DB_GlobalFlag((FLAG)CAMP_GoblinHuntCelebration_Event_DruidLeaderKilled_b9fa0384-79c8-ab10-aae3-8ecefd8472c9)
		THEN
		SetOnStage(S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156,1);
		TeleportTo(S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156, S_DEN_AttackDruidLeaderPos_db7954ab-818d-4757-9f47-7d0726186116, "CAMP_GoblinHuntCelebration_Leave");
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_RemoveTieflings()
		AND
		DB_GlobalFlag((FLAG)CAMP_GoblinHuntCelebration_Event_DruidLeaderKilled_b9fa0384-79c8-ab10-aae3-8ecefd8472c9)
		THEN
		SetOnStage(S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156, 0);
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_RemoveTieflings()
		AND
		GetFlag(CAMP_GLO_State_InCamp_161b7223-039d-4ebe-986f-1dcd9a66733f, S_FOR_Courier_Dog_3059f69c-068d-4e28-8491-55953c027901, 1)
		THEN
		SetEntityEvent(S_FOR_Courier_Dog_3059f69c-068d-4e28-8491-55953c027901, "CAMP_GoblinHuntCelebration_ClearDog");
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_SetupHalsin()
		AND
		DB_GLO_TadpoleQuest_Druid_HalsinLeaderEntries(_Leader, "HalsinAtGrove", _Known, _Entry)
		AND
		QRY_QuestUpdateIsUnlockedForAny("GLO_Tadpole", _Entry)
		THEN
		QuestUpdate("GLO_Tadpole", "TalkedLeader_Celebrate");
		
		//Setting Halsin On/Off Stage for the Tiefling Celebration
		PROC
		PROC_CAMP_GoblinHuntCelebration_SetupHalsin()
		AND
		DB_Players(_Player)
		AND
		NOT QRY_Camp_HasMetHalsinSomewhere(_Player)
		AND
		NOT DB_Defeated(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		THEN
		SetOnStage(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 0);
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_SetupHalsin()
		AND
		DB_Players(_Player)
		AND
		QRY_Camp_HasMetHalsinSomewhere(_Player)
		AND
		NOT DB_Defeated(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		THEN
		SetOnStage(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1);
		
		//Putting Halsin back on stage
		PROC
		PROC_Camp_EveryoneWakeupEndHook()
		AND
		DB_CAMP_HalsinMorningAfterScene(1)
		AND
		IsOnStage(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 0)
		THEN
		SetOnStage(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1);
		
		
		//Normal SCO Halsin Briefing Flow
		PROC
		PROC_Camp_EveryoneWakeupEndHook()
		AND
		DB_CAMP_HalsinMorningAfterScene(1)
		AND
		DB_CurrentLevel("WLD_Main_A")
		AND
		QRY_Camp_GetPreferredPlayerForDialogs()
		AND
		DB_QRYRTN_Camp_GetPreferredPlayerForDialogs(_Player)
		AND
		QRY_Camp_HasMetHalsinSomewhere(_Player)
		AND
		QRY_StartDialogCustom_Fixed((DIALOGRESOURCE)CAMP_GoblinHuntCelebration_SCO_HalsinMorningAfter_3c5a0a46-7927-6692-d353-fc8270b47631, S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, _Player, 0, 0, 0, 0)
		THEN
		DB_GLO_Halsin_GotMorningAfterScene(1);
		NOT DB_CAMP_HalsinMorningAfterScene(1);
		
		
		//Halsins Return fallback if you never met him before
		PROC
		PROC_Camp_EveryoneWakeup()
		AND
		DB_CAMP_HalsinMorningAfterScene(1)
		AND
		DB_CurrentLevel("WLD_Main_A")
		AND
		NOT DB_Dead(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		AND
		QRY_OnlyOnce("HalsinJoinsCamp")
		THEN
		PROC_ORI_SetupCamp((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1);
		
		PROC
		PROC_Camp_EveryoneWakeupEndHook()
		AND
		DB_CAMP_HalsinMorningAfterScene(1)
		AND
		DB_CurrentLevel("WLD_Main_A")
		AND
		QRY_Camp_GetPreferredPlayerForDialogs()
		AND
		DB_QRYRTN_Camp_GetPreferredPlayerForDialogs(_Player)
		AND
		NOT QRY_Camp_HasMetHalsinSomewhere(_Player)
		AND
		NOT DB_GlobalFlag(GLO_Halsin_Knows_MoonriseBriefing_9f8afde2-9dcf-3a5e-5e85-128913b820b7)
		AND
		QRY_StartDialogCustom_Fixed((DIALOGRESOURCE)CAMP_HalsinsReturn_CFM_720f387b-ca6e-b3be-4176-bceb7512d172, S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, _Player, 0, 0, 0, 0)
		THEN
		NOT DB_CAMP_HalsinMorningAfterScene(1);
		
		//QRY to manage this
		QRY
		QRY_Camp_HasMetHalsinSomewhere((CHARACTER)_Player)
		AND
		DB_GlobalFlag(_Flag)
		AND
		DB_CAMP_Halsin_HasMetHalsinFlags(_Flag)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_Camp_HasMetHalsinSomewhere((CHARACTER)_Player)
		AND
		DB_CAMP_Halsin_HasMetHalsinFlags(_Flag)
		AND
		GetFlag(_Flag, _Player, 1)
		THEN
		DB_NOOP(1);
		
		
		//END_REGION
		
		//REGION Camp Followers setup
		IF
		TextEvent("fullcamp")
		THEN
		DB_CAMP_GoblinHuntCelebration_FullCamp(1);
		PROC_GOB_WolfPens_HalsinForceBreakoutAndLeaving();
		
		PROC
		PROC_GLO_Halsin_LeftGoblinCamp()
		AND
		DB_CAMP_GoblinHuntCelebration_FullCamp(1)
		THEN
		TeleportTo(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, S_CAMP_WLDMAIN_Halsin_2c10b7b1-eb61-444f-bf1d-aa327902770f, "");
		SetOnStage(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1);
		PROC_RemoveAllDialogEntriesForSpeaker((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		DB_Dialogs(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, (DIALOGRESOURCE)CAMP_Halsin2_c0ab0f6f-3ffc-d06d-0d6d-d1aaef70dfe4);
		LookFromTrigger(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, S_CAMP_WLDMAIN_Halsin_2c10b7b1-eb61-444f-bf1d-aa327902770f, 0);
		DB_InCamp((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_SetupHalsin()
		AND
		DB_GlobalFlag(GLO_Halsin_State_Returned_5af86099-47f9-ba69-199a-fe91292a41bd)
		AND
		NOT DB_PermaDefeated(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		THEN
		DB_Camp_StayInCampAfterLongRest(1);
		DB_CAMP_HalsinMorningAfterScene(1);
		PROC_Camp_TeleportToCamp(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, S_CAMP_WLDMAIN_Halsin_2c10b7b1-eb61-444f-bf1d-aa327902770f);
		DB_CAMP_GoblinHuntCelebration_InitialDialog(NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121, S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, (DIALOGRESOURCE)CAMP_Halsin2_c0ab0f6f-3ffc-d06d-0d6d-d1aaef70dfe4);
		PROC_RemoveAllDialogEntriesForSpeaker((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		DB_Dialogs(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, (DIALOGRESOURCE)CAMP_GoblinHuntCelebration_Halsin_13f1ee23-9785-aa5a-1c90-69d462b65090);
		LookFromTrigger(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, S_CAMP_WLDMAIN_Halsin_2c10b7b1-eb61-444f-bf1d-aa327902770f, 0);
		DB_InCamp((CHARACTER)S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		PROC_CampNight_ClearCampNight((FLAG)NIGHT_HalsinsReturn_a6ed2a44-776c-41d7-abfc-b8240209f886);
		PROC_CampNight_ClearCampNight((FLAG)NIGHT_HalsinsRevenge_55e86575-6b8c-45ab-b582-e5ed048e6a83);
		
		PROC
		PROC_CampNight_StartSelected()
		AND
		DB_Camp_QueuedNight(_Flag)
		AND
		DB_CAMP_GoblinHuntCelebration_NightFlags(_Flag)
		AND
		DB_InCamp(_Follower)
		AND
		NOT DB_Defeated(_Follower)
		AND
		NOT DB_Origins(_Follower)
		AND
		DB_CAMP_GoblinHuntCelebration_DialogsForFollowers(_Follower, _Dialog)
		THEN
		PROC_CAMP_GoblinHuntCelebration_CancelRelationshipDialog(_Follower);
		PROC_CAMP_GoblinHuntCelebration_SaveDialog(_Flag, _Follower);
		PROC_RemoveAllDialogEntriesForSpeaker(_Follower);
		DB_Dialogs(_Follower, _Dialog);
		
		// Volo and Courier dog have relationship dialog set for exclamation marks
		PROC
		PROC_CAMP_GoblinHuntCelebration_CancelRelationshipDialog((CHARACTER)_Character)
		AND
		DB_HandlingRelationshipDialog(_Character,_RelationshipDialog,_Flag,_,_,_)
		THEN
		PROC_CancelRelationshipDialog(_Character,_RelationshipDialog,_Flag);
		DB_CAMP_GoblinHuntCelebration_CanceledRelationshipDialog(_Character,_RelationshipDialog,_Flag);
		
		QRY
		QRY_SelectCustomDialog_AfterGenerics(_Companion, _Player)
		AND
		DB_Camp_QueuedNight(_Flag)
		AND
		DB_CAMP_GoblinHuntCelebration_NightFlags(_Flag)
		AND
		DB_CampNight_CRD(_Flag, (CHARACTER)_Companion, _Dialog,_)
		AND
		NOT DB_Avatars(_Companion)
		AND
		NOT QRY_CAMP_GoblinHuntCelebration_NonPersistentDialog(_Dialog)
		THEN
		DB_SelectedDialog(_Dialog, _Companion, _Player);
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_SaveDialog((FLAG)_Flag,(CHARACTER)_Character)
		AND
		DB_Dialogs(_Character, _Dialog)
		THEN
		DB_CAMP_GoblinHuntCelebration_InitialDialog(_Flag, _Character, _Dialog);
		
		QRY
		QRY_CAMP_GoblinHuntCelebration_NonPersistentDialog((DIALOGRESOURCE)_Dialog)
		AND
		1 == 0
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_RestoreDialogs((FLAG)_Flag)
		AND
		DB_CAMP_GoblinHuntCelebration_InitialDialog(_Flag, _Character, _Dialog)
		THEN
		PROC_RemoveAllDialogEntriesForSpeaker(_Character);
		DB_Dialogs(_Character, _Dialog);
		
		// Restoring exclamation marks for Volo and Courier Dog
		PROC
		PROC_CAMP_GoblinHuntCelebration_RestoreDialogs((FLAG)_Flag)
		AND
		DB_CAMP_GoblinHuntCelebration_CanceledRelationshipDialog(_Character,_RelationshipDialog,_RelationshipDialogFlag)
		THEN
		PROC_CampRelationshipDialog(_Character,_RelationshipDialog,_RelationshipDialogFlag,0);
		PROC_Try_CampRelationshipDialog(_Character,1);
		
		PROC
		PROC_CampNight_ForceComplete((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121)
		THEN
		PROC_CAMP_GoblinHuntCelebration_RestoreDialogs((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121);
		//END_REGION
		
		//REGION Sex scenes
		//If a player has already agreed to sleep with Minthara, no need to add her to SelectNight
		IF
		FlagSet(CAMP_GoblinHunt_State_DrowPartner_d60f30bb-0fca-54ec-1028-860021d6de55, _, _)
		THEN
		DB_GoblinHuntCelebration_SkipMintharaFallback(1);
		
		//Add Minthara to someone's instance of SelectNight. As long as noone has agreed before or specifically denied her.
		PROC
		PROC_StartDialog_AddExtraSpeakers(CAMP_GoblinHuntCelebration_SD_SelectNight_750df06d-5a74-8f6b-cd1f-947055afbc2e, _ID)
		AND
		DB_Camp_QueuedNight((FLAG)NIGHT_GoblinHunt_RaiderCelebration_86fee25f-1069-4f17-89fa-4c5b69f82e0b)
		AND
		NOT DB_GoblinHuntCelebration_SkipMintharaFallback(1)
		AND
		DB_DialogRequestCache_SpeakerList_Players(CAMP_GoblinHuntCelebration_SD_SelectNight_750df06d-5a74-8f6b-cd1f-947055afbc2e,_ID, _Avatar, _Index)
		AND
		GetFlag(CAMP_GoblinHunt_State_DrowRefused_2da57b53-ba8f-7514-2943-d9b35b151d3a, _Avatar, 0)
		THEN
		DB_GoblinHuntCelebration_SkipMintharaFallback(1); //Add only once
		PROC_DialogAddSpeakingActor(_ID, S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b);
		
		QRY
		QRY_Inclusion_BlockCompanionInclusion(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, CAMP_GoblinHuntCelebration_SD_SelectNight_750df06d-5a74-8f6b-cd1f-947055afbc2e)
		THEN
		DB_NOOP(1);
		
		IF
		DB_CAMP_GoblinHuntCelebration_SexScenes(_,_SexScene,_)
		THEN
		DB_DialogBlockAttackButton(_SexScene);
		
		//Partner chosen in CAMP_GoblinHuntCelebration_SD_SelectNight -> Queue the RomanceNight
		IF
		FlagSet(_Flag, (CHARACTER)_Player, _)
		AND
		DB_Players(_Player)
		AND
		DB_CAMP_GoblinHuntCelebration_SexScenes(_Flag, _Dialog, _Partner)
		AND
		DB_Camp_QueuedNight(_NightFlag)
		AND
		DB_CAMP_GoblinHuntCelebration_NightFlags(_NightFlag)
		THEN
		DB_CampNight_RomanceNight(_NightFlag,_Player,_Dialog,(FLAG)NULL_00000000-0000-0000-0000-000000000000);
		DB_Camp_QueuedRomanceNight(_Partner,_Dialog,_Player);
		
		PROC
		PROC_StateSet_Defeated((CHARACTER)S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b)
		AND
		DB_Players(_Player)
		AND
		GetFlag(CAMP_GoblinHunt_State_DrowPartner_d60f30bb-0fca-54ec-1028-860021d6de55, _Player, 1)
		THEN
		ClearFlag(CAMP_GoblinHunt_State_DrowPartner_d60f30bb-0fca-54ec-1028-860021d6de55, _Player, 0);
		
		IF
		DialogEnded((DIALOGRESOURCE)CAMP_GoblinHuntCelebration_SD_SelectNight_750df06d-5a74-8f6b-cd1f-947055afbc2e,_)
		AND
		DB_CAMP_GoblinHuntCelebration_NightFlags(_Flag)
		AND
		DB_CampNight_RomanceNight(_Flag,_,_,(FLAG)_)
		THEN
		NOT DB_CampNight_StartSleepMoments_AwaitCompletion(_Flag);
		//END_REGION
		
		//REGION Parents revenge
		
		QRY
		QRY_SelectCustomDialog(S_DEN_ParentA_d6d88c8b-6ba7-4350-b3b3-d60565a44e90, _Player)
		AND
		DB_Dialogs(S_DEN_ParentA_d6d88c8b-6ba7-4350-b3b3-d60565a44e90, CAMP_GoblinHuntCelebration_ParentA_196436a6-93b8-a050-b924-55a6460254d3)
		AND
		DB_Dialogs(S_DEN_ParentB_397467d4-1631-447b-a505-d44275dca78e, CAMP_GoblinHuntCelebration_ParentB_fe45a1b5-3899-16bb-a992-bd917b6e2920)
		AND
		QRY_OnlyOnce("CAMP_GoblinHuntCelebration_ParentsRevenge")
		THEN
		DB_SelectedDialog(CAMP_GoblinHuntCelebration_ParentsAndDruidLeader_5acd7f9f-e965-ae46-ae7e-c689c1b8db94, S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156, S_DEN_ParentA_d6d88c8b-6ba7-4350-b3b3-d60565a44e90, S_DEN_ParentB_397467d4-1631-447b-a505-d44275dca78e, _Player);
		
		QRY
		QRY_SelectCustomDialog(S_DEN_ParentB_397467d4-1631-447b-a505-d44275dca78e, _Player)
		AND
		DB_Dialogs(S_DEN_ParentA_d6d88c8b-6ba7-4350-b3b3-d60565a44e90, CAMP_GoblinHuntCelebration_ParentA_196436a6-93b8-a050-b924-55a6460254d3)
		AND
		DB_Dialogs(S_DEN_ParentB_397467d4-1631-447b-a505-d44275dca78e, CAMP_GoblinHuntCelebration_ParentB_fe45a1b5-3899-16bb-a992-bd917b6e2920)
		AND
		QRY_OnlyOnce("CAMP_GoblinHuntCelebration_ParentsRevenge")
		THEN
		DB_SelectedDialog(CAMP_GoblinHuntCelebration_ParentsAndDruidLeader_5acd7f9f-e965-ae46-ae7e-c689c1b8db94, S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156, S_DEN_ParentA_d6d88c8b-6ba7-4350-b3b3-d60565a44e90, S_DEN_ParentB_397467d4-1631-447b-a505-d44275dca78e, _Player);
		
		QRY
		QRY_SelectCustomDialog(S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156, _Player)
		AND
		DB_Dialogs(S_DEN_ParentA_d6d88c8b-6ba7-4350-b3b3-d60565a44e90, CAMP_GoblinHuntCelebration_ParentA_196436a6-93b8-a050-b924-55a6460254d3)
		AND
		DB_Dialogs(S_DEN_ParentB_397467d4-1631-447b-a505-d44275dca78e, CAMP_GoblinHuntCelebration_ParentB_fe45a1b5-3899-16bb-a992-bd917b6e2920)
		AND
		QRY_OnlyOnce("CAMP_GoblinHuntCelebration_ParentsRevenge")
		THEN
		DB_SelectedDialog(CAMP_GoblinHuntCelebration_ParentsAndDruidLeader_5acd7f9f-e965-ae46-ae7e-c689c1b8db94, S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156, S_DEN_ParentA_d6d88c8b-6ba7-4350-b3b3-d60565a44e90, S_DEN_ParentB_397467d4-1631-447b-a505-d44275dca78e, _Player);
		
		IF
		DialogStarted(CAMP_GoblinHuntCelebration_ParentsAndDruidLeader_5acd7f9f-e965-ae46-ae7e-c689c1b8db94, _)
		THEN
		SetCanTrade(S_DEN_ParentA_d6d88c8b-6ba7-4350-b3b3-d60565a44e90, 0);
		SetCanTrade(S_DEN_ParentB_397467d4-1631-447b-a505-d44275dca78e, 0);
		SetCanTrade(S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156, 0);
		
		IF
		FlagSet((FLAG)CAMP_GoblinHuntCelebration_Event_KaghaParalyzed_295cb640-b6c4-14e6-d6ca-108e2539f159, _, _)
		THEN
		DB_CAMP_GoblinHuntCelebration_KaghaParalyzed(1);
		SetHasDialog(S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156, 0);
		ApplyStatus(S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156, "CAMP_KAGHA_PARALYZED", -1.0, 1, S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156);
		
		IF
		StatusRemoved(S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156, "CAMP_KAGHA_PARALYZED", _, _)
		THEN
		SetHasDialog(S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156, 1);
		
		IF
		FlagSet(CAMP_GoblinHuntCelebration_Event_DruidLeaderKilled_b9fa0384-79c8-ab10-aae3-8ecefd8472c9, _, _)
		AND
		DB_DialogNPCs(_ID, S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156, _)
		AND
		DialogRemoveActorFromDialog(_ID, S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156, 1)
		THEN
		Die(S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156, DEATHTYPE.DoT, 1);
		
		IF
		DialogEnded(CAMP_GoblinHuntCelebration_ParentsAndDruidLeader_5acd7f9f-e965-ae46-ae7e-c689c1b8db94, _)
		THEN
		SetCanTrade(S_DEN_ParentA_d6d88c8b-6ba7-4350-b3b3-d60565a44e90, 1);
		SetCanTrade(S_DEN_ParentB_397467d4-1631-447b-a505-d44275dca78e, 1);
		SetCanTrade(S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156, 1);
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_RemoveTieflings()
		AND
		DB_CAMP_GoblinHuntCelebration_KaghaParalyzed(1)
		THEN
		RemoveStatus(S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156, "CAMP_KAGHA_PARALYZED", S_DEN_DruidLeader_95eb2b0b-a522-4ea5-8167-c5f4d1418156);
		
		IF
		DialogEnded(CAMP_GoblinHuntCelebration_ParentsAndDruidLeader_5acd7f9f-e965-ae46-ae7e-c689c1b8db94, _)
		THEN
		PROC_CAMP_GoblinHuntCelebration_EndOfRevengeScene();
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_EndOfRevengeScene()
		THEN
		TimerLaunch("CAMP_GoblintHuntCelebration_ReactionAD", 3000);
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_EndOfRevengeScene()
		THEN
		PROC_CharacterMoveTo(S_DEN_ParentA_d6d88c8b-6ba7-4350-b3b3-d60565a44e90, S_CAMP_ParentAPos2_bd9692f7-ddbd-4724-b214-7e58c739ead1, "Stroll", "");
		PROC_CharacterMoveTo(S_DEN_ParentB_397467d4-1631-447b-a505-d44275dca78e, S_CAMP_ParentBPos2_f47c3843-f929-4000-8ba4-dd73713ec456, "Stroll", "");
		
		IF
		TimerFinished("CAMP_GoblintHuntCelebration_ReactionAD")
		THEN
		PROC_TryStartAD(CAMP_GoblinHuntCelebration_AD_ParentsReact_7cbd2ab7-fa55-07f1-30f0-ca0ad0d9ce3a, S_DEN_ParentA_d6d88c8b-6ba7-4350-b3b3-d60565a44e90, S_DEN_ParentB_397467d4-1631-447b-a505-d44275dca78e);
		
		//END_REGION
		
		//REGION Prodigies
		
		QRY
		QRY_SelectCustomDialog(_ProdigyChar, _Player)
		AND
		DB_CAMP_GoblinHuntCelebration_ProdigiesScene((CHARACTER)_ProdigyChar, _, _ProdigyDialog)
		AND
		DB_Dialogs(_ProdigyChar, _ProdigyDialog)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange((CHARACTER)S_GLO_Prodigy_b6a3a9e9-b6eb-4c19-ab3f-4c431178fe1b, _Player)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange((CHARACTER)S_GLO_ProdigySister_44d09b0b-0568-456c-b18d-559a0a3f981d, _Player)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange((CHARACTER)S_GLO_ProdigyBrother_d0187724-c0e2-4019-a01d-a03ee8153f1b, _Player)
		AND
		QRY_OnlyOnce("CAMP_GoblinHuntCelebration_ProdigyScene")
		THEN
		DB_SelectedDialog(CAMP_GoblinHuntCelebration_Prodigies_3b257a0a-3fb4-3ae6-573c-1713bb2b0393, S_GLO_Prodigy_b6a3a9e9-b6eb-4c19-ab3f-4c431178fe1b, S_GLO_ProdigySister_44d09b0b-0568-456c-b18d-559a0a3f981d, S_GLO_ProdigyBrother_d0187724-c0e2-4019-a01d-a03ee8153f1b, _Player);
		
		
		//END_REGION
		
		//REGION Debug
		
		IF
		TextEvent("ghvtieflings")
		THEN
		PROC_DEN_RaidingParty_DebugResolveConfrontationNotPeaceful();
		SetFlag(DEN_AttackOnDen_State_DenVictory_71c7f23e-3ff1-c9b8-3ef5-d75fa1b42c8d, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		TextEvent("halsinden")
		THEN
		PROC_GLO_Halsin_TeleportToDen();
		
		IF
		TextEvent("ghvraiders")
		THEN
		PROC_DEN_RaidingParty_DebugResolveConfrontationNotPeaceful();
		SetFlag(DEN_AttackOnDen_State_RaiderVictory_abe1bce8-c234-4afe-a490-76210d98a078, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		PROC
		PROC_Camp_DebugQNight_ForceRequirements((FLAG)NIGHT_GoblinHunt_RaiderCelebration_86fee25f-1069-4f17-89fa-4c5b69f82e0b)
		THEN
		SetFaction(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, (FACTION)ACT1_DEN_AttackRaiders_Fighters_bfdc773b-6521-4fd1-3784-3d1404f1b2f5);
		SetEntityEvent(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, "GOB_DrowCommander_LeftGoblinCamp");
		SetEntityEvent(S_GOB_DrowCommander_25721313-0c15-4935-8176-9f134385451b, "DEN_AttackOnDen_Victory");
		PROC_SetRelationMutual((FACTION)ACT1_DEN_AttackRaiders_Fighters_bfdc773b-6521-4fd1-3784-3d1404f1b2f5, (FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, 100);
		PROC_SetRelationMutual((FACTION)ACT1_DEN_AttackRaiders_Standby_aca56eff-f292-1b69-8f22-ec96197b8d25, (FACTION)Hero_a1542c81-6895-929e-4522-10ce218bb360, 100);
		
		PROC
		PROC_Camp_DebugQNight_ForceRequirements((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121)
		AND
		DB_State_Current(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", _Current)
		THEN
		NOT DB_State_Current(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", _Current);
		DB_State_Current(S_DEN_RangerDen_SUB_50062397-bf9c-4765-9cbc-e40b5148f211, "DEN", "DEN_State_AttackOnDenVictory");
		
		PROC
		PROC_Camp_DebugQNight_ForceRequirements((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121)
		THEN
		PROC_GLO_Halsin_TeleportToDen();
		SetFlag(DEN_AttackOnDen_State_DenVictory_71c7f23e-3ff1-c9b8-3ef5-d75fa1b42c8d, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetFlag(DEN_AttackOnDen_Event_TieflingPartyInvitation_545593fd-42e6-15c1-1e96-18e0e0be0443, NULL_00000000-0000-0000-0000-000000000000, 0);
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(90).Title("Act1_CAMP_GoblinHuntCelebration_PostEA");
Goal(90)
{
	INIT
	{
		DB_CampNight_SetPosition(NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121,(CHARACTER)S_Player_Wyll_c774d764-4a17-48dc-b470-32ace9ce447d,"WLDMAIN",S_CAMP_Wyll_GoblinHuntCelebration_Pos_fb463a2e-e586-47c9-a20d-14f49b3d5892);
	}
	KB
	{
		//REGION Korrilla the Spy
		IF
		DialogEnded(CAMP_GoblinHuntCelebration_CFM_Raiders_37471826-8011-115d-6724-c12874619d95, _)
		THEN
		PROC_CAMP_GoblinHuntCelebration_KorrillaSetup();
		
		PROC
		PROC_CampNight_StartSelected()
		AND
		DB_Camp_QueuedNight((FLAG)NIGHT_GoblinHunt_TieflingCelebration_1ad8c357-2695-4d5c-b5f9-8b8c07803121)
		THEN
		PROC_CAMP_GoblinHuntCelebration_KorrillaSetup();
		
		//When the camp initializes, start a timer so she only appears mid-celebration
		PROC
		PROC_CAMP_GoblinHuntCelebration_KorrillaSetup()
		THEN
		TimerLaunch("CAMP_GoblinHuntCelebration_Korrilla_AppearTimer", 30000);
		
		//When the timer finishes, appear, and start sneaking
		IF
		TimerFinished("CAMP_GoblinHuntCelebration_Korrilla_AppearTimer")
		THEN
		PROC_CAMP_GoblinHuntCelebration_TeleportKorrillaAndWatch();
		
		//TODO: put theis movement into Anubis for Korrilla, using the partol spline
		//When arrived to end location wait and watch
		IF
		EntityEvent(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, "CAMP_GoblinHuntCelebration_KorrillaArrived")
		THEN
		ObjectTimerLaunch(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, "CAMP_GoblinHuntCelebration_Korrilla_WaitTimer", 15000, 1);
		
		IF
		ObjectTimerFinished(_, "CAMP_GoblinHuntCelebration_Korrilla_WaitTimer")
		THEN
		PROC_GLO_Warlock_TeleportOut();
		
		
		PROC
		PROC_CAMP_GoblinHuntCelebration_TeleportKorrillaAndWatch()
		AND
		QRY_State_IsBeforeState(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, "GLO_Warlock", "GLO_Warlock_Act1")
		THEN
		PROC_State_Progress(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297,"GLO_Warlock", "GLO_Warlock_Act1");
		SetVisible(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, 1);
		TeleportTo(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, S_CAMP_Korrilla_AppearSpot_3311cc3c-8af8-46bf-ac06-a4d974ce605f, "", 0, 0, 0, 0, 1);
		CharacterDisableAllCrimes(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297);
		PROC_GLO_Monitor_EntityFoop(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297);
		PROC_RemoveDialog(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297);
		DB_Dialogs((CHARACTER)S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, (DIALOGRESOURCE)CAMP_KorrillaTheSpy_Korrilla_faea3992-f6a4-e66f-27ec-384f42231194);
		SetHitpointsPercentage(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, 100.0);
		PROC_GLO_Warlock_ApplyAllStatuses();
		
		//IF Korrilla is approached by the player and she sees it, she teleports away
		IF
		StatusApplied(_Player, "TWN_KORRILLATHESPY_ISNEAR", _, _)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		DB_Sees((CHARACTER)S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, _Player)
		THEN
		PROC_GLO_Warlock_TeleportOut();
		PROC_TryStartAD(GLO_KorrillaTheSpy_PAD_KorrillaVanishesReaction_d67b6532-f773-6e07-3a4f-615aa3b949dc, _Player);
		
		IF
		DB_Sees((CHARACTER)S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, _Player)
		AND
		DB_Players((CHARACTER)_Player)
		AND
		HasActiveStatus(_Player, "TWN_KORRILLATHESPY_ISNEAR", 1)
		THEN
		PROC_GLO_Warlock_TeleportOut();
		PROC_TryStartAD(GLO_KorrillaTheSpy_PAD_KorrillaVanishesReaction_d67b6532-f773-6e07-3a4f-615aa3b949dc, _Player);
		
		IF
		DialogEnded((DIALOGRESOURCE)CAMP_KorrillaTheSpy_Korrilla_faea3992-f6a4-e66f-27ec-384f42231194, _ID)
		AND
		DB_DialogPlayers(_ID, _Player, _)
		THEN
		PROC_GLO_Warlock_TeleportOut();
		PROC_TryStartAD(GLO_KorrillaTheSpy_PAD_KorrillaVanishesReaction_d67b6532-f773-6e07-3a4f-615aa3b949dc, _Player);
		
		//Vanishing Korrilla if the Campnight ends
		PROC
		PROC_LongRest()
		AND
		DB_State_Current(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297,"GLO_Warlock", "GLO_Warlock_Act1")
		AND
		IsOnStage(S_GOB_Warlock_d432aafd-f728-4d9d-9707-732e1cdd8297, 1)
		THEN
		PROC_GLO_Warlock_TeleportOut();
		//END_REGION
		
		//REGION Cancelling Halsin's Revenge
		PROC
		PROC_CampNight_StartSelected()
		AND
		DB_Camp_QueuedNight((FLAG)NIGHT_GoblinHunt_RaiderCelebration_86fee25f-1069-4f17-89fa-4c5b69f82e0b)
		AND
		NOT DB_GlobalFlag((FLAG)GOB_WolfPens_State_HalsinIntroHappened_7d0751b9-1055-4a54-9ccd-f5e95e2a1f69)
		AND
		NOT DB_PermaDefeated(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323)
		THEN
		DB_CorpseCleanup_Ignore(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323);
		SetOnStage(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, 1);
		Die(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, DEATHTYPE.Physical, NULL_00000000-0000-0000-0000-000000000000, 0, 0);
		TeleportTo(S_GLO_Halsin_7628bc0e-52b8-42a7-856a-13a6fd413323, S_DEN_GatePlayerMoveToPoint_002_e0ee6b1c-8b40-4a09-815b-1e032855978a, "Halsin_Dead_Offscreen_Teleport", 0, 0, 0, 0, 1);
		PROC_CampNight_ClearCampNight((FLAG)NIGHT_HalsinsReturn_a6ed2a44-776c-41d7-abfc-b8240209f886);
		PROC_CampNight_ClearCampNight((FLAG)NIGHT_HalsinsRevenge_55e86575-6b8c-45ab-b582-e5ed048e6a83);
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(91).Title("Act1_CAMP_VoloOperation");
Goal(91)
{
	INIT
	{
	}
	KB
	{
		IF
		FlagSet((FLAG)GLO_Volo_LobotomyPatient_4e24982b-24d2-7107-a817-caa317dffd26, _Char, _)
		THEN
		SetFlag(GLO_Volo_Knows_Lobotomy_6f016a74-c28b-4a6a-919e-b58223cc14cb, NULL_00000000-0000-0000-0000-000000000000, 0);
		SetTag(_Char,ONEEYED_8df7d133-21cb-4e8d-92dd-9ef9394fd2d1);
		SetTag(_Char,CANTLOSEEYE_b5de40c5-edec-43a7-a918-1d85c13232de);
		
		IF
		DialogEnded((DIALOGRESOURCE)CAMP_VoloOperation_ba7c506d-c743-5dc9-7d98-eeea7b4ef2a2,_ID)
		AND
		DB_DialogPlayers(_ID,_Player,_)
		AND
		GetFlag((FLAG)GLO_Volo_LobotomyPatient_4e24982b-24d2-7107-a817-caa317dffd26,_Player,1)
		THEN
		ApplyStatus(_Player,"CAMP_VOLO_ERSATZEYE",-1.0,1,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		AddCustomMaterialOverride(_Player, "dc46662a-d909-4df5-ad12-50a524150aff");
		SetFlag((FLAG)GLO_Volo_State_LeftAfterOperation_fec19c09-93c5-40f3-a6e9-b242076e68bf);
		
		// Handling players interrupting the dialog mid-surgery
		IF
		DialogEnded(CAMP_VoloOperation_ba7c506d-c743-5dc9-7d98-eeea7b4ef2a2,_ID)
		AND
		DB_DialogPlayers(_ID,_Player,_)
		AND
		GetFlag((FLAG)GLO_Volo_LobotomyPatient_4e24982b-24d2-7107-a817-caa317dffd26,_Player,0)
		AND
		GetFlag((FLAG)GLO_Volo_StartON_72e7a848-7ca3-e519-db23-4b85170ff5b6,_Player,1)
		THEN
		SetFlag((FLAG)GLO_Volo_State_LeftAfterOperation_fec19c09-93c5-40f3-a6e9-b242076e68bf);
		
		PROC
		PROC_LongRest()
		AND
		DB_GlobalFlag(GLO_Volo_State_Researching_3b5b625e-4ac4-891f-18f5-d47db044514e)
		AND
		NOT DB_GlobalFlag(GLO_Volo_State_Researched_2cf45e20-a429-7d90-283a-47033bdbf62c)
		THEN
		SetFlag(GLO_Volo_State_Researched_2cf45e20-a429-7d90-283a-47033bdbf62c, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		IF
		FlagSet(GLO_Volo_StartON_72e7a848-7ca3-e519-db23-4b85170ff5b6, _Char, _)
		THEN
		ApplyStatus(_Char,"CAMP_VOLO_NEEDLE",12.0,1,S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa);
		
		IF
		DialogEnded(CAMP_VoloOperation_ba7c506d-c743-5dc9-7d98-eeea7b4ef2a2,_ID)
		AND
		DB_GlobalFlag((FLAG)GLO_Volo_RefusedOperation_2a42d60b-a49a-f6fa-9bc5-cc546d1526f5)
		THEN
		SetFlag((FLAG)GLO_Volo_State_LeftAfterOperation_fec19c09-93c5-40f3-a6e9-b242076e68bf);
		
		IF
		FlagSet((FLAG)GLO_Volo_State_LeftAfterOperation_fec19c09-93c5-40f3-a6e9-b242076e68bf,_,_)
		THEN
		PROC_NotifyWhenReadyToMoveOn(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"CAMP_VoloLeaving");
		
		PROC
		PROC_ReadyToMoveOn(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"CAMP_VoloLeaving")
		THEN
		PROC_DisappearOutOfSight(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"Run",1,"CAMP_VoloLeft");
		
		IF
		EntityEvent(S_GLO_Volo_2af25a85-5b9a-4794-85d3-0bd4c4d262fa,"CAMP_VoloLeft")
		THEN
		ClearFlag((FLAG)GLO_Volo_State_AtCamp_de1cadca-2eca-4cee-a3dc-e262bbb92277);
		
		PROC
