		DB_FlagReactionAfterDialog((FLAG)UND_PetrifiedDrow_Event_MemoryCrystalRejected_e29001a0-8c2b-3067-008d-06983f1ef83b, (DIALOGRESOURCE)UND_PetrifiedDrow_MemoryCrystal_320d13c5-7de7-633e-fde2-54b93865aa2a);
		
