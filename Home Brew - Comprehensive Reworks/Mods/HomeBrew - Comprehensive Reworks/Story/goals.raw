		PROC_LOW_KurwinCoffin_KoboldGang_PatchUpdate()
		AND
		DB_LOW_KurwinCoffin_KoboldGang(_OldHole, _Trigger)
		AND
		DB_LOW_KurwinCoffin_KoboldGang_Hole(_CorrespondingHole, _Trigger)
		AND
