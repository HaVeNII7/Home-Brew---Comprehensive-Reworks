	KB
	{
		//REGION Door Sentry
		PROC
		PROC_BlockUseOfItem(_Player, (ITEM)S_LOW_GriefDoor_1aa5ac36-b156-4efe-8214-2056381e5f0a)
		AND
		IsClosed((ITEM)S_LOW_GriefDoor_1aa5ac36-b156-4efe-8214-2056381e5f0a, 1)
		AND
		DB_Players(_Player)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_HouseOfGrief_State_GotPermissionToEnter_f9e76b17-2592-48aa-8546-e86e4c0efceb)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_HouseOfGrief_State_SentryMoveToDesk_5b5c91de-7305-4122-a2a8-6d0796db409d)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_LOW_DoorSentry_616de0b4-c76d-4ef4-a3f9-4e0803371a6c, S_LOW_GriefDoor_1aa5ac36-b156-4efe-8214-2056381e5f0a)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)LOW_HouseOfGrief_State_TriedToOpenDoor_d92a48b1-6ad5-4e22-8da9-50a1357f20b7);
		DB_CustomUseItemResponse(_Player, (ITEM)S_LOW_GriefDoor_1aa5ac36-b156-4efe-8214-2056381e5f0a, 0);
		PROC_LOW_HouseOfGrief_StartInterruptDialog((CHARACTER)_Player);
		 
		PROC
		PROC_LOW_HouseOfGrief_StartInterruptDialog((CHARACTER)_Player)
		AND
		NOT QRY_StartDialog_Fixed((DIALOGRESOURCE)LOW_HouseOfGrief_DoorSentry_c89b07af-ea0f-b795-b604-829b861f65ed, S_LOW_DoorSentry_616de0b4-c76d-4ef4-a3f9-4e0803371a6c, _Player)
		THEN
		PROC_GlobalClearFlagAndCache((FLAG)LOW_HouseOfGrief_State_TriedToOpenDoor_d92a48b1-6ad5-4e22-8da9-50a1357f20b7);
		
		IF
		FlagSet((FLAG)LOW_HouseOfGrief_State_GotPermissionToEnter_f9e76b17-2592-48aa-8546-e86e4c0efceb, _, _)
		THEN
		ClearOwnership((ITEM)S_LOW_GriefDoor_1aa5ac36-b156-4efe-8214-2056381e5f0a);
		
		IF
		Closed((ITEM)S_LOW_GriefDoor_1aa5ac36-b156-4efe-8214-2056381e5f0a)
		AND
		QRY_OnlyOnce("LOW_HouseOfGrief_UnlockDoor")
		THEN
		Unlock((ITEM)S_LOW_GriefDoor_1aa5ac36-b156-4efe-8214-2056381e5f0a);
		
		//END_REGION
		
		//REGION Viconia Illusion
		
		//REGION Grief Brench
		
		IF
		UseFinished(_Player, (ITEM)S_LOW_GriefBench_a282c6af-9767-4022-8a20-7cd3f6ac4754, _)
		AND
		NOT DB_GlobalFlag((FLAG)LOW_HouseOfGrief_State_PlayerHostile_dc16eca3-584a-4847-9664-c51222410abc)
		AND
		NOT DB_OnlyOnce("LOW_HouseOfGrief_MappingStarted")
		AND
		DB_Players(_Player)
		THEN
		PROC_LOW_HouseOfGrief_ViconiaAppear((CHARACTER)_Player);
		
		PROC
		PROC_LOW_HouseOfGrief_ViconiaAppear((CHARACTER)_Player)
		AND
		IsOnStage(S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f, 1)
		THEN
		PROC_LOW_HouseOfGrief_StartMapping((CHARACTER)_Player);
		
		PROC
		PROC_LOW_HouseOfGrief_ViconiaAppear((CHARACTER)_Player)
		AND
		IsOnStage(S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f, 0)
		THEN
		SetOnStage(S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f, 1);
		PROC_State_Progress(S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f, "LOW_MappingOfTheHeart", "LOW_HouseOfGrief_ViconiaVisible");
		SetHasDialog(S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f, 0);
		RemoveStatus(S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f, "INVISIBILITY"); 
		PlayEffect(S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f, (EFFECTRESOURCE)VFX_Script_SCL_Trial_Shar_Teleport_Appear_BodyFX_01_520e41d0-3515-f40c-1ebc-9b6f899ec782);
		Use((CHARACTER)S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f, (ITEM)S_LOW_GriefBench_a282c6af-9767-4022-8a20-7cd3f6ac4754, "");
		PROC_LOW_HouseOfGrief_StartMapping((CHARACTER)_Player);
		
		PROC
		PROC_LOW_HouseOfGrief_StartMapping((CHARACTER)_Player)
		AND
		NOT DB_OnlyOnce("LOW_HouseOfGrief_MappingStarted")
		AND
		QRY_StartDialog((DIALOGRESOURCE)LOW_HouseOfGrief_ViconiaMapping_81568711-7b8f-d188-ee16-e9436c7b009f, S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f, _Player)
		AND
		QRY_OnlyOnce("LOW_HouseOfGrief_MappingStarted")
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_BlockUseOfItem(_Char, (ITEM)S_LOW_GriefBench_a282c6af-9767-4022-8a20-7cd3f6ac4754)
		AND
		DB_Players(_Char)
		AND
		QRY_LOW_HouseOfGrief_CheckIfReposed()
		THEN
		DB_CustomUseItemResponse(_Char, (ITEM)S_LOW_GriefBench_a282c6af-9767-4022-8a20-7cd3f6ac4754, 0);
		
		IF
		UseStarted(S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f, (ITEM)S_LOW_GriefBench_a282c6af-9767-4022-8a20-7cd3f6ac4754)
		AND
		NOT DB_OnlyOnce("LOW_HouseOfGrief_MappingStarted")
		THEN
		PROC_State_Progress(S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f, "LOW_MappingOfTheHeart", "LOW_HouseOfGrief_ViconiaSeated");
		SetHasDialog(S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f, 1);
		
		IF
		UseStarted(S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f, (ITEM)S_LOW_GriefBench_a282c6af-9767-4022-8a20-7cd3f6ac4754)
		AND
		NOT DB_OnlyOnce("LOW_HouseOfGrief_MappingStarted")
		AND
		NOT QRY_LOW_HouseOfGrief_CheckIfReposed()
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)LOW_HouseOfGrief_AD_ViconiaIllusionSeated_595470d5-0690-5432-ba00-a593e7d55aad, S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f);
		
		QRY
		QRY_LOW_HouseOfGrief_CheckIfReposed()
		AND
		DB_Players(_Player)
		AND
		IsReposedOnEntity(_Player, (ITEM)S_LOW_GriefBench_a282c6af-9767-4022-8a20-7cd3f6ac4754, 1)
		THEN
		DB_NOOP(1);
		
		IF
		ReposeAdded(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679, S_LOW_GriefBench_a282c6af-9767-4022-8a20-7cd3f6ac4754)
		THEN
		SetFlag((FLAG)LOW_HouseOfGrief_ViconiaMapping_State_ShadowheartSitsOnBench_a6fd9b07-8e28-f2e0-3ecd-163ebe1159d4);
		
		IF
		ReposeRemoved(S_Player_ShadowHeart_3ed74f06-3c60-42dc-83f6-f034cb47c679, S_LOW_GriefBench_a282c6af-9767-4022-8a20-7cd3f6ac4754)
		THEN
		ClearFlag((FLAG)LOW_HouseOfGrief_ViconiaMapping_State_ShadowheartSitsOnBench_a6fd9b07-8e28-f2e0-3ecd-163ebe1159d4);
		//END_REGION
		
		//REGION Mapping of the Heart Test
		
		PROC
		PROC_LOW_HouseOfGrief_StartCounters()
		AND
		DB_LOW_HouseOfGrief_HeartForms(_HeartForm, _, _)
		THEN
		PROC_DeclareCounter(_HeartForm);
		
		IF //Add points to particular heartform
		FlagSet(_Flag, _, _)
		AND
		DB_LOW_HouseOfGrief_HeartMapping(_HeartForm, _Point, _Flag)
		THEN
		PROC_GlobalClearFlagAndCache(_Flag);
		PROC_IncreaseCounter(_HeartForm, _Point);
		
		IF //Determine the highest scoring heartform
		FlagSet((FLAG)LOW_HouseOfGrief_Event_DetermineHeartForm_f2f9c186-bb12-4916-a26c-7f62d1193c1b, _Player, _)
		AND
		QRY_LOW_HouseOfGrief_HighestHeartForm((CHARACTER)_Player)
		AND
		DB_QRYRTN_LOW_HouseOfGrief_HighestHeartForm(_HeartForm, _Count)
		AND
		DB_LOW_HouseOfGrief_HeartForms(_HeartForm, _, _Flag)
		THEN
		SetFlag(_Flag, _Player);
		
		//REGION //QRY_LOW_HouseOfGrief_HighestHeartForm
		QRY //Create initial DB
		QRY_LOW_HouseOfGrief_HighestHeartForm((CHARACTER)_Player)
		AND
		DB_LOW_HouseOfGrief_HeartForms(_HeartForm, _, _)
		THEN
		DB_QRYRTN_LOW_HouseOfGrief_HighestHeartForm(_HeartForm, -99);
		
		QRY //Check which heartforms rank the highest.
		QRY_LOW_HouseOfGrief_HighestHeartForm((CHARACTER)_Player)
		AND
		DB_LOW_HouseOfGrief_HeartForms(_HeartForm, _, _)
		AND
		DB_GlobalCounter(_HeartForm, _Count)
		AND
		DB_QRYRTN_LOW_HouseOfGrief_HighestHeartForm(_OtherHeartForm, _Current)
		AND
		_Count > _Current
		AND
		QRY_LOW_HouseOfGrief_HeartFormTieCheck((CHARACTER)_Player, (STRING)_HeartForm, (INTEGER)_Count, (STRING)_OtherHeartForm, (INTEGER)_Current)
		THEN
		NOT DB_QRYRTN_LOW_HouseOfGrief_HighestHeartForm(_OtherHeartForm, _Current);
		DB_QRYRTN_LOW_HouseOfGrief_HighestHeartForm(_HeartForm, _Count);
		//END_REGION
		
		//REGION //QRY_LOW_HouseOfGrief_HeartFormTieCheck
		QRY //If higher than the other then continue
		QRY_LOW_HouseOfGrief_HeartFormTieCheck((CHARACTER)_Player, (STRING)_HeartForm, (INTEGER)_Count, (STRING)_OtherHeartForm, (INTEGER)_Current)
		AND
		_Count > _Current
		THEN
		DB_NOOP(1);
		
		QRY //If equal then find the skill with the lowest skill value
		QRY_LOW_HouseOfGrief_HeartFormTieCheck((CHARACTER)_Player, (STRING)_HeartForm, (INTEGER)_Count, (STRING)_OtherHeartForm, (INTEGER)_Current)
		AND
		_Count == _Current
		AND
		_HeartForm != _OtherHeartForm
		AND
		DB_LOW_HouseOfGrief_HeartForms(_HeartForm, _Skill, _)
		AND
		CalculatePassiveSkill(_Player, _Skill, _SkillValue)
		AND
		DB_LOW_HouseOfGrief_HeartForms(_OtherHeartForm, _OtherSkill, _)
		AND
		CalculatePassiveSkill(_Player, _OtherSkill, _CurrentValue)
		AND
		_SkillValue < _CurrentValue
		THEN
		DB_NOOP(1);
		
		//END_REGION
		
		//END_REGION
		
		IF
		HitpointsChanged(S_LOW_ViconiaIllusion_dff48da6-3915-4c67-b2fa-1f8a195d1e1f, _Percentage)
		AND
		_Percentage < 100.0
		AND
