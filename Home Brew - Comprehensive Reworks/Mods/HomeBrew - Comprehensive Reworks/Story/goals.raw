		ToInventory(S_WYR_KillDirectorGortash_NetherstoneGauntlet_63ae103a-b370-45ae-8c9c-46f8f8f8d4f0, S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, 1, 0, 0);
		
		IF
		AddedTo(S_WYR_KillDirectorGortash_NetherstoneGauntlet_63ae103a-b370-45ae-8c9c-46f8f8f8d4f0, S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, _)
		THEN
		Equip((CHARACTER)S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, S_WYR_KillDirectorGortash_NetherstoneGauntlet_63ae103a-b370-45ae-8c9c-46f8f8f8d4f0, 1, 0, 0);
		SetCanBePickpocketed(S_WYR_KillDirectorGortash_NetherstoneGauntlet_63ae103a-b370-45ae-8c9c-46f8f8f8d4f0, 0);
		SetIsTradable(S_WYR_KillDirectorGortash_NetherstoneGauntlet_63ae103a-b370-45ae-8c9c-46f8f8f8d4f0, TRADABLETYPE.NonTradable);
		SetIsDroppedOnDeath(S_WYR_KillDirectorGortash_NetherstoneGauntlet_63ae103a-b370-45ae-8c9c-46f8f8f8d4f0, 1);
		
		PROC
		PROC_GLO_SetupForAct("BGO_Main_A", S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, 1)
		AND
		GetCombatGroupID(S_WYR_WyrmRock_AudienceHallGuard_001_d3dea7b0-3c9d-431b-9671-e6a00b726a9c, _CombatGroupID)
		THEN
		SetCombatGroupID(S_GLO_Gortash_b878a854-f790-4999-95c4-3f20f00f65ac, _CombatGroupID);
		
		PROC
		PROC_GLO_SetupForAct("BGO_Main_A", S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, 1)
		THEN
		PROC_GLO_SetupForAct_Place(
			(CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9,
			(TRIGGER)S_WYR_WyrmRockPrison_FlorrickDefaultPos_3f08f866-66e5-4fce-9113-8ed8bd2e2207, 
			(FACTION)ACT3_WYR_Florrick_0e29530d-a9b0-4b37-93b4-017b4b687679, 
			WYR_WyrmRockPrison_Florrick_40d9f384-7637-91b7-01aa-556a76ac20e1,
			"WYR_WyrmRockPrison_Florrick_TeleportedToAct3");
		PROC_WYR_WyrmRockPrison_RemoveFlorrickWeapon();
		Transform(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, S_GLO_Desire_Bruised_37f1bf91-106a-49f3-8c9f-16476109e885, (SHAPESHIFTRULE)DisguiseWithCustomLooks_8194cfb6-4199-46d2-9027-613c302352aa);
		SetCanSpotSneakers((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, 0);
		
		IF
		EntityEvent(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, "WYR_WyrmRockPrison_Florrick_TeleportedToAct3")
		THEN
		SetFlag((FLAG)WYR_WyrmRockPrison_State_FlorrickTeleportedToPrison_82a4cbc6-a9ac-4350-be47-043d1691e8de, NULL_00000000-0000-0000-0000-000000000000);
		//END_REGION
		
		//REGION Rivington
		//Emperor AD upon entering region
		PROC
		PROC_LevelGameplayLoadedOnce("BGO_Main_A")
		AND
		DB_Players(_Player)
		THEN
		PROC_EmperorAD((CHARACTER)_Player, WYR_EmperorAD_EnterWyrmsCrossing_a89e0e5a-fb10-0cc1-239d-95ee63b87d63);
		
		PROC
		PROC_SpotPlayers_Spotted(S_WYR_Rivington_ArmoryShopkeeper_b0caa965-537c-4d10-a672-4943825b73ea, "WYR_Rivington_ArmoryShopkeeper_WelcomeSpotting", _Player)
		THEN
		LookAtEntity(S_WYR_Rivington_ArmoryShopkeeper_b0caa965-537c-4d10-a672-4943825b73ea, _Player, 2.0);
		PROC_TryStartAD((DIALOGRESOURCE)WYR_Rivington_AD_ArmoryShopkeeper_Welcome_fa151fc4-a503-834f-7c7a-07dcc16afe0e, S_WYR_Rivington_ArmoryShopkeeper_b0caa965-537c-4d10-a672-4943825b73ea);
		//END_REGION
		
		//REGION Bridge
		PROC
		PROC_SpotPlayers_Spotted(S_WYR_Bridge_AlchemyMerchant_208167c3-e4ea-4308-b232-97236b1738ec, "WYR_Bridge_AlchemyMerchant_WelcomeSpotting", _Player)
		THEN
		PROC_TryStartAD(WYR_AlchemyMerchant_AD_Welcome_d3db878b-5789-9ffa-bfb5-ee5ecf638505, S_WYR_Bridge_AlchemyMerchant_208167c3-e4ea-4308-b232-97236b1738ec);
		//END_REGION
		
		//REGION Plays world timelines for WYR
		IF
		LevelGameplayStarted("BGO_Main_A", _)
		AND
		NOT DB_GLO_ActiveWorldTimelines(WRLD_GLO_BGO_Boats_c2669ffc-aa1c-7268-f8b0-d611103594ca, "BGO_Main_A", _)
		AND
		StartWorldTimeline(WRLD_GLO_BGO_Boats_c2669ffc-aa1c-7268-f8b0-d611103594ca, TimelineSceneTrigger_GLO_BGO_Boats_b40c56ad-2c12-44f6-86fe-012e66200316, _, _ID)
		THEN
		DB_GLO_ActiveWorldTimelines(WRLD_GLO_BGO_Boats_c2669ffc-aa1c-7268-f8b0-d611103594ca, "BGO_Main_A", _ID);
		
		//END_REGION
		
		//REGION World Learns about Gortash's Death
		PROC
		PROC_LongRest()
		AND
		DB_GlobalFlag((FLAG)GLO_Gortash_State_PermaDefeated_74dd56ff-7e00-42a6-a0f3-0d122f364769)
		AND
		NOT DB_GlobalFlag((FLAG)GLO_Gortash_State_WorldKnowsPermaDefeated_5bbc8258-a708-4486-aa3f-8757d9dce533)
		THEN
		PROC_GlobalSetFlagAndCache(GLO_Gortash_State_WorldKnowsPermaDefeated_5bbc8258-a708-4486-aa3f-8757d9dce533);
		//END_REGION
		
		//REGION Abandoned well
		IF
		EntityEvent(_, "WYR_AbandonedWell_Event_DoorOpened")
		THEN
		PROC_SetOnStage(S_WYR_AbandonedWell_DoorBlockerHelper_4ea9d275-7670-49d8-8d47-582f94df5eb5, 0);
		//END_REGION
	}
	EXIT
	{
	}
}
Goal(540).Title("Act3_WYR_Guards");
