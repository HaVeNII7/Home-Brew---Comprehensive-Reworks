		IF
		DB_GlobalFlag(GLO_DarkUrge_State_FavouriteExists_a1fbabc2-e7d7-4cb1-91ee-a24b744bef1c)
		AND
		DB_ORI_DarkUrge_FavouriteCharacter(_Character)
		AND
