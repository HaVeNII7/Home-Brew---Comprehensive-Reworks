		DB_GLO_ScryingEye_AbsoluteFactions((FACTION)ACT1_GOB_GoblinPriest_Guards_6d266e80-f605-488d-a2e0-2c4e8ea19384);
		DB_GLO_ScryingEye_AbsoluteFactions((FACTION)ACT1_GOB_GoblinPriest_Ogre_fa18e2bb-e9ea-4053-9cf1-2d9acb5bf545);
