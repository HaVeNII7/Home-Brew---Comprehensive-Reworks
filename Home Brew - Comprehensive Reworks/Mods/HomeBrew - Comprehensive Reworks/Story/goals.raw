		QRY
		QRY_OriginMoment_PreventRelaunchDialog((DIALOGRESOURCE)LOW_FlorrickFightFallback_OM_Wyll_AOM_OOM_17675941-1973-eda5-4c13-7db91f4629a4, _, _)
		THEN
