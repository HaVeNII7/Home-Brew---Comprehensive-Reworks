		DB_DiggableSecretMapMarker("LOW_DiggableSecret_BuriedMound_08", (FLAG)LOW_DiggableSecret_Kots_BaldursGateCaches_000_Show_43d2883c-c27d-4ad6-8d70-ebf777592f1d, (FLAG)LOW_DiggableSecret_Kots_BaldursGateCaches_000_Hide_5d9054a6-8c1d-4053-8ca1-db16812ea4dc, (ITEM)S_LOW_BuriedMound_08_64b5ca83-a9e7-46b6-ad32-3f158ba1ab5f);
