		//END_REGION
		
		//REGION Inside / Outside Florrick's cell
		DB_GLO_Cinematic_PositionedDialog((DIALOGRESOURCE)WYR_WyrmRockPrison_Florrick_40d9f384-7637-91b7-01aa-556a76ac20e1, "WYR_Florrick");
		DB_GLO_Cinematic_PositionFlags("WYR_Florrick", (TRIGGER)S_WYR_WyrmRockPrison_FlorricksCell_ForCinematic_d0b91948-fa3d-4398-bbaa-e499de7913c4, (FLAG)WYR_WyrmRockPrison_Florrick_State_PlayerInsideCell_733d505e-d277-436d-b668-e62be6bb91bf);
		//END_REGION
	}
	KB
	{
		//REGION Adding Prisoners to the Prison
		IF
		DB_GlobalFlag((FLAG)WYR_WyrmRockPrison_State_FlorrickTeleportedToPrison_82a4cbc6-a9ac-4350-be47-043d1691e8de)
		THEN
		AddEntryToCustomBook("WYR_WyrmRockPrison_PrisonLog", "WYR_WyrmRockPrison_PrisonLog_FlorrickEntry");
		DB_SceneManager((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, "WYR_WyrmRockPrison_Florrick");
		DB_SpotPlayers((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, "WYR_WyrmRockPrison_Florrick", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000);
		TriggerRegisterForCharacter((TRIGGER)S_WYR_Fortress_SUB_94ca5a54-0813-48b4-9f55-4cb039a63c82, (CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9);
		TriggerRegisterForCharacter((TRIGGER)S_WYR_Prison_SUB_cd67276d-52e4-44b9-a237-0e2cd45106d8, (CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9);
		TriggerRegisterForCharacter((TRIGGER)S_WYR_WyrmRockPrison_FlorricksCell_db3096d9-3177-4245-93a6-f01c8bb6889f, (CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9);
		DB_WYR_WyrmRockPrison_ForbiddenExits((ITEM)S_WYR_WyrmRock_DoorToAudienceHall_f708261f-9271-439f-aea4-6d4cdb394fde);
		DB_WYR_WyrmRockPrison_ForbiddenExits((ITEM)S_WYR_WyrmWay_DungeonEntrance_973100f8-670a-4194-9256-4bf2169bc8d5);
		
		IF
		EnteredTrigger((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, (TRIGGER)S_WYR_WyrmRockPrison_FlorricksCell_db3096d9-3177-4245-93a6-f01c8bb6889f)
		THEN
		SetFlag(WYR_WyrmRockPrison_State_FlorrickInCell_5de28954-a10e-4688-9e14-41d8e849fbd8);
		
		IF
		LeftTrigger((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, (TRIGGER)S_WYR_WyrmRockPrison_FlorricksCell_db3096d9-3177-4245-93a6-f01c8bb6889f)
		THEN
		ClearFlag(WYR_WyrmRockPrison_State_FlorrickInCell_5de28954-a10e-4688-9e14-41d8e849fbd8);
		
		IF
		DB_GlobalFlag((FLAG)WYR_MerchantsHouse_Merchant_State_InPrison_e96b73b9-1e15-75f1-e61d-af9b713d6b25)
		THEN
		AddEntryToCustomBook("WYR_WyrmRockPrison_PrisonLog", "WYR_WyrmRockPrison_PrisonLog_ToyMakerEntry");
		
		IF
		DB_GlobalFlag((FLAG)ORI_GortashConfrontation_Event_KarlachSentToPrison_f6764bce-1df3-4f81-91d0-bf986329798e)
		THEN
		AddEntryToCustomBook("WYR_WyrmRockPrison_PrisonLog", "WYR_WyrmRockPrison_PrisonLog_KarlachEntry");
		
		IF
		UseStarted(_Player, (ITEM)S_WYR_WyrmRockPrison_PrisonLog_dd5d4f50-3b9a-41dd-baca-4c4af65c06c0)
		THEN
		OpenReferencedBookUI(_Player, "WYR_WyrmRockPrison_PrisonLog", S_WYR_WyrmRockPrison_PrisonLog_dd5d4f50-3b9a-41dd-baca-4c4af65c06c0);
		
		IF
		CustomBookUIClosed(_Player, "WYR_WyrmRockPrison_PrisonLog")
		AND
		NOT DB_GlobalFlag(WYR_WyrmRockPrison_Knows_OldManInPrison_ed535416-cb28-40cd-82c0-78fbc51ca48a)
		THEN
		PROC_GlobalSetFlagAndCache(WYR_WyrmRockPrison_Knows_OldManInPrison_ed535416-cb28-40cd-82c0-78fbc51ca48a);
		
		IF
		CustomBookUIClosed(_Player, "WYR_WyrmRockPrison_PrisonLog")
		AND
		DB_GlobalFlag((FLAG)WYR_WyrmRockPrison_State_FlorrickTeleportedToPrison_82a4cbc6-a9ac-4350-be47-043d1691e8de)
		AND
		NOT DB_GlobalFlag(WYR_WyrmRockPrison_Knows_FlorrickInPrison_37416ee4-f2db-4cad-a113-eafd9ea1e0bf)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_WyrmRockPrison_Knows_FlorrickInPrison_37416ee4-f2db-4cad-a113-eafd9ea1e0bf);
		
		IF
		CustomBookUIClosed(_Player, "WYR_WyrmRockPrison_PrisonLog")
		AND
		DB_GlobalFlag((FLAG)WYR_MerchantsHouse_Merchant_State_InPrison_e96b73b9-1e15-75f1-e61d-af9b713d6b25)
		AND
		NOT DB_GlobalFlag(WYR_WyrmRock_Knows_MerchantInPrison_36b031ad-e3ad-435a-8957-a5dd4421bfec)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_WyrmRock_Knows_MerchantInPrison_36b031ad-e3ad-435a-8957-a5dd4421bfec);
		//END_REGION
		
		//REGION Entrance Guard
		// The guard is sleeping by default
		// If we attack the door we wake the guard up and register the crime after SLEEPIGN status is removed
		// If we attack the chair we do the same
		// If we destroy the chair the guard is knocked down, we wait till KNOCKED_DOWN status is removed and then register the crime
		IF
		AttackedBy(S_WYR_WyrmRockPrison_EntranceDoor_ec90dfc0-becb-4918-b003-603d6e7a3ffa, _Player, _, _, _, _, _)
		AND
		NOT DB_Defeated(S_WYR_WyrmRockPrison_EntranceGuard_3f27f04f-4041-462e-9db3-a3ba163eb0c6)
		AND
		DB_GlobalFlag(WYR_WyrmRockPrison_State_EntranceGuardSleeping_fb11ba89-ea58-49c6-b57c-f34a9f81fa0c)
		AND
		HasAppliedStatus(S_WYR_WyrmRockPrison_EntranceDoor_ec90dfc0-becb-4918-b003-603d6e7a3ffa, "SILENCED", 0)
		AND
		HasAppliedStatus(S_WYR_WyrmRockPrison_EntranceGuard_3f27f04f-4041-462e-9db3-a3ba163eb0c6, "SILENCED", 0)
		AND
		QRY_OnlyOnce("WYR_WyrmRockPrison_WakeUpGuardVandalise")
		THEN
		SetFlag(WYR_WyrmRockPrison_Event_WakeUpEntranceGuard_5495e2e7-8a6e-4d2f-8e67-307062f24e54);
		SetFlag((FLAG)WYR_WyrmRockPrison_EntranceGuard_Knows_DoorDestroyed_4d55d25e-7a22-4d19-b23d-99c9ce96cbf1);
		DB_WYR_WyrmRockPrison_EntranceGuardVandalism((ITEM)S_WYR_WyrmRockPrison_EntranceDoor_ec90dfc0-becb-4918-b003-603d6e7a3ffa, _Player);
		
		IF
		AttackedBy(S_WYR_WyrmRockPrison_EntranceGuardsChair_0ef760aa-1b4b-4498-9429-983f238cf33d, _Player, _, _, _, _, _)
		AND
		DB_GlobalFlag(WYR_WyrmRockPrison_State_EntranceGuardSleeping_fb11ba89-ea58-49c6-b57c-f34a9f81fa0c)
		AND
		QRY_OnlyOnce("WYR_WyrmRockPrison_WakeUpGuardVandalise")
		THEN
		SetFlag(WYR_WyrmRockPrison_Event_WakeUpEntranceGuard_5495e2e7-8a6e-4d2f-8e67-307062f24e54);
		DB_WYR_WyrmRockPrison_EntranceGuardVandalism((ITEM)S_WYR_WyrmRockPrison_EntranceGuardsChair_0ef760aa-1b4b-4498-9429-983f238cf33d, (CHARACTER)_Player);
		
		IF
		ReposeRemoved(S_WYR_WyrmRockPrison_EntranceGuard_3f27f04f-4041-462e-9db3-a3ba163eb0c6,S_WYR_WyrmRockPrison_EntranceGuardsChair_0ef760aa-1b4b-4498-9429-983f238cf33d)
		THEN
		SetFlag(WYR_WyrmRockPrison_Event_WakeUpEntranceGuard_5495e2e7-8a6e-4d2f-8e67-307062f24e54);
		
		IF
		StatusRemoved(S_WYR_WyrmRockPrison_EntranceGuard_3f27f04f-4041-462e-9db3-a3ba163eb0c6, "SLEEPING_SEATED", _, _)
		AND
		HasAppliedStatus(S_WYR_WyrmRockPrison_EntranceGuard_3f27f04f-4041-462e-9db3-a3ba163eb0c6, "KNOCKED_DOWN", 0)
		AND
		DB_WYR_WyrmRockPrison_EntranceGuardVandalism((ITEM)_Item, _Player)
		THEN
		NOT DB_WYR_WyrmRockPrison_EntranceGuardVandalism((ITEM)_Item, (CHARACTER)_Player);
		PROC_CrimeRegisterVandalise((ITEM)_Item, (CHARACTER)_Player, (CHARACTER)_Player);
		
		IF
		StatusRemoved(S_WYR_WyrmRockPrison_EntranceGuard_3f27f04f-4041-462e-9db3-a3ba163eb0c6, "KNOCKED_DOWN", _, _)
		AND
		DB_WYR_WyrmRockPrison_EntranceGuardVandalism((ITEM)_Item, _Player)
		THEN
		NOT DB_WYR_WyrmRockPrison_EntranceGuardVandalism((ITEM)_Item, _Player);
		PROC_CrimeRegisterVandalise((ITEM)_Item, (CHARACTER)_Player, (CHARACTER)_Player);
		
		IF
		EntityEvent(S_WYR_WyrmRockPrison_EntranceGuard_3f27f04f-4041-462e-9db3-a3ba163eb0c6, "WYR_WyrmRockPrison_EntranceGuardUsedChair")
		AND
		NOT DB_GlobalFlag(WYR_WyrmRockPrison_Event_WakeUpEntranceGuard_5495e2e7-8a6e-4d2f-8e67-307062f24e54)
		THEN
		ApplyStatus(S_WYR_WyrmRockPrison_EntranceGuard_3f27f04f-4041-462e-9db3-a3ba163eb0c6, "SLEEPING_SEATED", -1.0, 1, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		StatusApplied(S_WYR_WyrmRockPrison_EntranceGuard_3f27f04f-4041-462e-9db3-a3ba163eb0c6, "SLEEPING_SEATED", NULL_00000000-0000-0000-0000-000000000000, _)
		THEN
		SetFlag((FLAG)WYR_WyrmRockPrison_State_EntranceGuardSleeping_fb11ba89-ea58-49c6-b57c-f34a9f81fa0c, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		StatusRemoved(S_WYR_WyrmRockPrison_EntranceGuard_3f27f04f-4041-462e-9db3-a3ba163eb0c6, "SLEEPING_SEATED", _, _)
		THEN
		ClearFlag((FLAG)WYR_WyrmRockPrison_State_EntranceGuardSleeping_fb11ba89-ea58-49c6-b57c-f34a9f81fa0c, NULL_00000000-0000-0000-0000-000000000000);
		
		IF
		FlagSet((FLAG)WYR_WyrmRockPrison_Event_WakeUpEntranceGuard_5495e2e7-8a6e-4d2f-8e67-307062f24e54, NULL_00000000-0000-0000-0000-000000000000, _)
		THEN
		RemoveStatus(S_WYR_WyrmRockPrison_EntranceGuard_3f27f04f-4041-462e-9db3-a3ba163eb0c6, "SLEEPING_SEATED", NULL_00000000-0000-0000-0000-000000000000);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog((FLAG)WYR_WyrmRockPrison_EntranceGuard_Event_OpenDoor_58939bc0-3f68-42f5-800f-e874f34ae677, (DIALOGRESOURCE)WYR_WyrmRockPrison_EntranceGuard_515ae99d-86a4-6296-799d-307f8aba641c)
		THEN
		ClearOwnership((ITEM)S_WYR_WyrmRockPrison_EntranceDoor_ec90dfc0-becb-4918-b003-603d6e7a3ffa);
		PROC_CharacterMoveTo((CHARACTER)S_WYR_WyrmRockPrison_EntranceGuard_3f27f04f-4041-462e-9db3-a3ba163eb0c6, S_WYR_WyrmRockPrison_EntranceDoor_ec90dfc0-becb-4918-b003-603d6e7a3ffa, "Walk", "WYR_WyrmRockPrison_ArrivedAtDoor");
		
		IF
		EntityEvent(S_WYR_WyrmRockPrison_EntranceGuard_3f27f04f-4041-462e-9db3-a3ba163eb0c6, "WYR_WyrmRockPrison_ArrivedAtDoor")
		AND
		DB_Defeated((ITEM)S_WYR_WyrmRockPrison_EntranceDoor_ec90dfc0-becb-4918-b003-603d6e7a3ffa)
		THEN
		SetFlag((FLAG)WYR_WyrmRockPrison_EntranceGuard_Knows_DoorDestroyed_4d55d25e-7a22-4d19-b23d-99c9ce96cbf1);
		PROC_TryStartAD((DIALOGRESOURCE)WYR_WyrmRockPrison_AD_EntranceGuardAtDoor_1756b270-5d8b-f6a8-d4b6-7faf3ad4f6b5, S_WYR_WyrmRockPrison_EntranceGuard_3f27f04f-4041-462e-9db3-a3ba163eb0c6);
		
		IF
		EntityEvent(S_WYR_WyrmRockPrison_EntranceGuard_3f27f04f-4041-462e-9db3-a3ba163eb0c6, "WYR_WyrmRockPrison_ArrivedAtDoor")
		AND
		NOT DB_Defeated((ITEM)S_WYR_WyrmRockPrison_EntranceDoor_ec90dfc0-becb-4918-b003-603d6e7a3ffa)
		AND
		IsLocked((ITEM)S_WYR_WyrmRockPrison_EntranceDoor_ec90dfc0-becb-4918-b003-603d6e7a3ffa, 0)
		THEN
		SetFlag(WYR_WyrmRockPrison_Knows_DoorUnlocked_3a5f973d-2cbe-42ac-a2a8-e0f934679a20);
		PROC_TryStartAD((DIALOGRESOURCE)WYR_WyrmRockPrison_AD_EntranceGuardAtDoor_1756b270-5d8b-f6a8-d4b6-7faf3ad4f6b5, S_WYR_WyrmRockPrison_EntranceGuard_3f27f04f-4041-462e-9db3-a3ba163eb0c6);
		
		IF
		EntityEvent(S_WYR_WyrmRockPrison_EntranceGuard_3f27f04f-4041-462e-9db3-a3ba163eb0c6, "WYR_WyrmRockPrison_ArrivedAtDoor")
		AND
		NOT DB_Defeated((ITEM)S_WYR_WyrmRockPrison_EntranceDoor_ec90dfc0-becb-4918-b003-603d6e7a3ffa)
		AND
		IsLocked((ITEM)S_WYR_WyrmRockPrison_EntranceDoor_ec90dfc0-becb-4918-b003-603d6e7a3ffa, 1)
		THEN
		Use((CHARACTER)S_WYR_WyrmRockPrison_EntranceGuard_3f27f04f-4041-462e-9db3-a3ba163eb0c6, (ITEM)S_WYR_WyrmRockPrison_EntranceDoor_ec90dfc0-becb-4918-b003-603d6e7a3ffa, "WYR_WyrmRockPrison_UsedEntranceDoor");
		PROC_TryStartAD((DIALOGRESOURCE)WYR_WyrmRockPrison_AD_EntranceGuardAtDoor_1756b270-5d8b-f6a8-d4b6-7faf3ad4f6b5, S_WYR_WyrmRockPrison_EntranceGuard_3f27f04f-4041-462e-9db3-a3ba163eb0c6);
		
		IF
		EnteredCombat(S_WYR_WyrmRockPrison_EntranceGuard_3f27f04f-4041-462e-9db3-a3ba163eb0c6, _)
		AND
		HasActiveStatus(S_WYR_WyrmRockPrison_EntranceGuard_3f27f04f-4041-462e-9db3-a3ba163eb0c6, "SLEEPING_SEATED", 1)
		THEN
		RemoveStatus(S_WYR_WyrmRockPrison_EntranceGuard_3f27f04f-4041-462e-9db3-a3ba163eb0c6, "SLEEPING_SEATED");
		//END_REGION
		
		//REGION Trespass
		IF
		DB_GlobalFlag((FLAG)WYR_WyrmRockPrison_State_GainedAccess_7cd68e28-3e02-472b-ae9a-cad9f21b1aa9)
		THEN
		PROC_RemoveDBTrespassTrigger((TRIGGER)S_WYR_WyrmRockPrison_TrespassingArea_f7043b14-dbfd-4c72-a75f-c069df6bd5ca);
		ClearOwnership(S_WYR_WyrmRockPrison_EntranceDoor_ec90dfc0-becb-4918-b003-603d6e7a3ffa);
		
		// if get imprisoned we disable the trespassing crime
		// since our escape will be handled by Fugitive crime
		IF
		EntityEvent(_Player, "CRIME_TeleportedToPrison")
		AND
		IsInTrigger(_Player, S_WYR_WyrmRockPrison_PlayerCell_6792230e-f319-4870-8778-5f7bfae74489, 1)
		THEN
		PROC_RemoveDBTrespassTrigger((TRIGGER)S_WYR_WyrmRockPrison_TrespassingArea_f7043b14-dbfd-4c72-a75f-c069df6bd5ca);
		
		IF
		Unlocked(S_WYR_WyrmRockPrison_EntranceDoor_ec90dfc0-becb-4918-b003-603d6e7a3ffa, _PartyMember, _) // thieves' tools or key - doesn't matter
		AND
		DB_InRegion(_PartyMember, S_WYR_WyrmRockPrison_EntranceArea_a0883bc6-c52f-4547-a030-b3484675b1bb) // but we need to enter from the entrance area
		THEN
		PROC_RemoveDBTrespassTrigger((TRIGGER)S_WYR_WyrmRockPrison_TrespassingArea_f7043b14-dbfd-4c72-a75f-c069df6bd5ca);
		//END_REGION
		
		//REGION Prison Escape Booster
		IF
		DB_WYR_WyrmRockPrison_Guards(_Guard)
		THEN
		DB_CRIME_Guards_BlockPrisonerDialog(_Guard);
		
		// The Talking Skull starts his AD either after player spent 12 seconds in the cell or interacts with the crate
		IF
		EnteredTrigger(_Player, (TRIGGER)S_WYR_WyrmRockPrison_PlayerCell_6792230e-f319-4870-8778-5f7bfae74489)
		AND
		GetFlag(IsInPrison_c9b75b21-6eba-065e-7680-fc9a0c5838e4, _Player, 1)
		AND
		QRY_OncePerUserAndNearbyPlayers(_Player, "WYR_WyrmRockPrison_ActivateTalkingSkull")
		THEN
		TimerLaunch("WYR_WyrmRockPrison_ActivateTalkingSkull", 12000);
		DB_WYR_WyrmRockPrison_SkullTimerActive(1);
		
		IF
		UseFinished(_Player, (ITEM)S_WyrmRockPrison_Crate_7ece30d7-09cc-432a-a3ec-0df3c9014e02, _)
		AND
		DB_WYR_WyrmRockPrison_SkullTimerActive(1)
		THEN
		TimerCancel("WYR_WyrmRockPrison_ActivateTalkingSkull");
		PROC_WYR_WyrmRockPrison_ActivateTalkingSkull();
		
		IF
		DestroyedBy(S_WYR_WyrmRockPrison_Crate_7ece30d7-09cc-432a-a3ec-0df3c9014e02, _, _Player, _)
		AND
		DB_WYR_WyrmRockPrison_SkullTimerActive(1)
		THEN
		TimerCancel("WYR_WyrmRockPrison_ActivateTalkingSkull");
		PROC_WYR_WyrmRockPrison_ActivateTalkingSkull();
		
		IF
		TimerFinished("WYR_WyrmRockPrison_ActivateTalkingSkull")
		THEN
		PROC_WYR_WyrmRockPrison_ActivateTalkingSkull();
		
		PROC
		PROC_WYR_WyrmRockPrison_ActivateTalkingSkull()
		THEN
		NOT DB_WYR_WyrmRockPrison_SkullTimerActive(1);
		PROC_TryStartAD((DIALOGRESOURCE)WYR_WyrmRockPrison_TalkingSkull_AD_32c14703-64a5-f18b-beb8-240d9ebe74d0, (ITEM)S_WYR_WyrmRockPrison_TalkingSkull_4bab8c98-ebde-45cf-9709-5da620fb7fe1);
		DB_Dialogs(S_WYR_WyrmRockPrison_TalkingSkull_4bab8c98-ebde-45cf-9709-5da620fb7fe1, (DIALOGRESOURCE)WYR_WyrmRockPrison_TalkingSkull_dc88bf0d-b0da-03c3-b35f-0ff25b809ea5);
		
		IF
		DB_WYR_WyrmRockPrison_TalkingSkullSpells(_Flag, _, _)
		THEN
		DB_FlagReactionAfterDialog(_Flag, (DIALOGRESOURCE)WYR_WyrmRockPrison_TalkingSkull_dc88bf0d-b0da-03c3-b35f-0ff25b809ea5);
		
		PROC
		PROC_FlagReactionAfterDialog(_Player, _Flag)
		AND
		DB_WYR_WyrmRockPrison_TalkingSkullSpells(_Flag, _Status, _Duration)
		THEN
		ApplyStatus(_Player, _Status, _Duration, 1, S_WYR_WyrmRockPrison_TalkingSkull_4bab8c98-ebde-45cf-9709-5da620fb7fe1);
		ClearFlag(_Flag, _Player);
		PROC_WYR_WyrmRockPrison_ApplyStatusToChainedCharacters((CHARACTER)_Player, _Status, _Duration);
		
		PROC
		PROC_WYR_WyrmRockPrison_ApplyStatusToChainedCharacters((CHARACTER)_Player, (STRING)_Status, (REAL)_Duration)
		AND
		DB_PartyMembers(_PartyMember)
		AND
		_Player != _PartyMember
		AND
		InSamePartyGroup(_PartyMember, _Player, 1)
		THEN
		ApplyStatus(_PartyMember, _Status, _Duration, 1, S_WYR_WyrmRockPrison_TalkingSkull_4bab8c98-ebde-45cf-9709-5da620fb7fe1);
		
		PROC
		PROC_FlagReactionAfterDialog(_Player, (FLAG)WYR_WyrmRockPrison_TalkingSkull_Event_TeleportToChests_b906e348-36e5-4c9c-84d2-bdaf0f79463a)
		THEN
		TeleportTo(_Player, S_WYR_WyrmRockPrison_TeleportDestNearChests_61b3182c-5246-483a-8e6d-27b94dc93085, "", 1, 1, 1, 0, 1);
		ClearFlag((FLAG)WYR_WyrmRockPrison_TalkingSkull_Event_TeleportToChests_b906e348-36e5-4c9c-84d2-bdaf0f79463a, _Player);
		
		PROC
		PROC_FlagReactionAfterDialog(_Player, (FLAG)WYR_WyrmRockPrison_TalkingSkull_Event_TeleportToGuards_7c9a0b57-63d6-4132-8380-bf5da38cd06b)
		THEN
		TeleportTo(_Player, S_WYR_WyrmRockPrison_TeleportDestNearGuards_b26d010c-a2d4-4921-937b-c570b13ae9eb, "", 1, 1, 1, 0, 1);
		ClearFlag((FLAG)WYR_WyrmRockPrison_TalkingSkull_Event_TeleportToGuards_7c9a0b57-63d6-4132-8380-bf5da38cd06b, _Player);
		//END_REGION
		
		//REGION Crimes inside the prison
		QRY
		QRY_CRIME_BlockRegisterCrime((CHARACTER)_Criminal, (STRING)_Crime, (GUIDSTRING)_Evidence, (CHARACTER)_Victim, _)
		AND
		QRY_CRIME_IsCrimeFamilyMember(_Crime, "Vandalise")
		AND
		IsInTrigger(_Evidence, (TRIGGER)S_WYR_WyrmRockPrison_PlayerCell_6792230e-f319-4870-8778-5f7bfae74489, 1)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_SceneInterrupted(S_WYR_WyrmRockPrison_Prisoner_55f621e8-c702-45d8-89a7-d38d1a4ebb1d, _Player, "WYR_WyrmRockPrison_Prisoner", "Attacked")
		THEN
		PROC_SetRelationTemporaryHostile((CHARACTER)S_WYR_WyrmRockPrison_Prisoner_55f621e8-c702-45d8-89a7-d38d1a4ebb1d, _Player);
		
		PROC
		PROC_SceneInterrupted(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _Player, "WYR_WyrmRockPrison_Florrick", "Attacked")
		THEN
		PROC_SetRelationTemporaryHostile((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _Player);
		//END_REGION
		
		//REGION Florrick Escape Booster
		// When you meet Florrick in the prison she asks you to help her escape the fortress
		// When you unlock and open the door of Florrick's cell she starts a dialog with you and asks you to let her join you
		// When she joins the party a new crime is registered on her. Guards and Steel Watchers will attack her on sight with a custom AD
		// You can't use Fast Travel inside the fortress (danger zone)
		// You need to escort her outside the fortress - either via the secret exit or via killing a bunch of flaming fists & Steel Watchers and leaving via South Bridge / North Bridge
		// When you have left the fortress she will thank you, leave the party and disappear
		// Note: she should refuse to go to the second floor / wyrm way dungeon with you.
		PROC
		PROC_SpotPlayers_Spotted((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, "WYR_WyrmRockPrison_Florrick", _Player)
		THEN
		PROC_TryStartAD((DIALOGRESOURCE)WYR_WyrmRockPrison_AD_FlorrickSpottedPlayer_6fda82a4-56c3-2d67-730c-6f93163d130b, S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9);
		
		IF
		Unlocked(S_WYR_WyrmRockPrison_PrisonCell_002_Door_682d19a1-a0dc-4488-9a4d-d276e9d2062c, _Player, _)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_WyrmRockPrison_State_FlorricksDoorUnlocked_c467f549-b32e-4a88-9dc1-56f108b11175);
		
		IF
		UseFinished(_Player, S_WYR_WyrmRockPrison_PrisonCell_002_Door_682d19a1-a0dc-4488-9a4d-d276e9d2062c, 1)
		AND
		DB_GlobalFlag((FLAG)WYR_WyrmRockPrison_Florrick_Event_TookQuest_b7fcc7b4-7b90-3d1b-12da-1bc234163480)
		AND
		NOT DB_GlobalFlag(WYR_WyrmRockPrison_State_FlorrickFollowing_191938a2-5aa3-439b-b7b9-5b7485d436cd)
		AND
		DB_InRegion(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, S_WYR_WyrmRockPrison_FlorricksCell_db3096d9-3177-4245-93a6-f01c8bb6889f)
		AND
		NOT DB_InteractiveDialogSpeaker(_, S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9)
		AND
		QRY_OnlyOnce("WYR_WyrmRockPrison_AutoStartDoorOpenedDialog")
		THEN
		PROC_WYR_WyrmRockPrison_AddFlorrickToParty((CHARACTER)_Player);
		
		PROC
		PROC_FlagReactionAfterDialog(_Player, (FLAG)WYR_WyrmRockPrison_Florrick_Event_AddToParty_0ec8e632-913b-4f6f-b306-05e3fc05bd7a)
		THEN
		PROC_WYR_WyrmRockPrison_AddFlorrickToParty((CHARACTER)_Player);
		
		PROC
		PROC_WYR_WyrmRockPrison_AddFlorrickToParty((CHARACTER)_Player)
		AND
		QRY_OnlyOnce("WYR_WyrmRockPrison_EnableFlorrickEscapeInProgressDialog")
		THEN
		PROC_RemoveDialog(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9);
		DB_Dialogs(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, (DIALOGRESOURCE)WYR_WyrmRockPrison_FlorrickEscapeInProgress_db2ec9f1-a0a8-e78e-9b7b-11baf9caf816);
		PROC_SceneOver("WYR_WyrmRockPrison_Florrick");
		PROC_SetRelationToPlayers((FACTION)ACT3_WYR_Florrick_0e29530d-a9b0-4b37-93b4-017b4b687679, 100);
		SetCanSpotSneakers((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, 1);
		
		PROC
		PROC_WYR_WyrmRockPrison_AddFlorrickToParty((CHARACTER)_Player)
		THEN
		ClearFlag(WYR_WyrmRockPrison_Event_AddFlorrickToParty_0ec8e632-913b-4f6f-b306-05e3fc05bd7a, _Player);
		AddPartyFollower((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, (CHARACTER)_Player);
		PROC_GlobalSetFlagAndCache(WYR_WyrmRockPrison_State_FlorrickFollowing_191938a2-5aa3-439b-b7b9-5b7485d436cd);
		PROC_CharacterRegisterCrime((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, "WYR_WyrmRockPrison_FlorrickEscape", NULL_00000000-0000-0000-0000-000000000000, NULL_00000000-0000-0000-0000-000000000000, 0);
		
		PROC
		PROC_GlobalFlagReactionAfterDialog(WYR_WyrmRockPrison_Florrick_Event_RemoveFromParty_2e8d0994-b963-469e-a765-17b9c6761d5f)
		THEN
		PROC_GlobalClearFlagAndCache(WYR_WyrmRockPrison_Florrick_Event_RemoveFromParty_2e8d0994-b963-469e-a765-17b9c6761d5f);
		PROC_RemovePartyFollower((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9);
		PROC_GlobalClearFlagAndCache(WYR_WyrmRockPrison_State_FlorrickFollowing_191938a2-5aa3-439b-b7b9-5b7485d436cd);
		
		IF
		LeftTrigger((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, (TRIGGER)S_WYR_Fortress_SUB_94ca5a54-0813-48b4-9f55-4cb039a63c82)
		AND
		IsInTrigger(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, (TRIGGER)S_WYR_Prison_SUB_cd67276d-52e4-44b9-a237-0e2cd45106d8, 0)
		AND
		DB_GlobalFlag((FLAG)WYR_WyrmRockPrison_State_FlorrickFollowing_191938a2-5aa3-439b-b7b9-5b7485d436cd)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_WyrmRockPrison_State_FlorrickLeftFortress_0a2cfd0f-2224-4c58-8777-28672b048aa5)
		THEN
		PROC_WYR_WyrmRockPrison_FlorrickLeftFortress();
		
		IF
		LeftTrigger((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, (TRIGGER)S_WYR_Prison_SUB_cd67276d-52e4-44b9-a237-0e2cd45106d8)
		AND
		IsInTrigger(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, (TRIGGER)S_WYR_Fortress_SUB_94ca5a54-0813-48b4-9f55-4cb039a63c82, 0)
		AND
		DB_GlobalFlag((FLAG)WYR_WyrmRockPrison_State_FlorrickFollowing_191938a2-5aa3-439b-b7b9-5b7485d436cd)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_WyrmRockPrison_State_FlorrickLeftFortress_0a2cfd0f-2224-4c58-8777-28672b048aa5)
		THEN
		PROC_WYR_WyrmRockPrison_FlorrickLeftFortress();
		
		PROC
		PROC_WYR_WyrmRockPrison_FlorrickLeftFortress()
		THEN
		TriggerUnregisterForCharacter((TRIGGER)S_WYR_Fortress_SUB_94ca5a54-0813-48b4-9f55-4cb039a63c82, (CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9);
		TriggerUnregisterForCharacter((TRIGGER)S_WYR_Prison_SUB_cd67276d-52e4-44b9-a237-0e2cd45106d8, (CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9);
		PROC_RemoveDialog(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9);
		DB_Dialogs(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, (DIALOGRESOURCE)WYR_WyrmRockPrison_FlorrickOutisdeFortress_acc54e80-b695-d804-a5df-dfbc09e087fe);
		PROC_GlobalSetFlagAndCache(WYR_WyrmRockPrison_State_FlorrickLeftFortress_0a2cfd0f-2224-4c58-8777-28672b048aa5);
		
		IF
		DB_GlobalFlag((FLAG)WYR_WyrmRockPrison_State_FlorrickLeftFortress_0a2cfd0f-2224-4c58-8777-28672b048aa5)
		AND
		CharacterGetOwner((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _FlorrickOwner)
		AND
		NOT QRY_StartDialog_Fixed((DIALOGRESOURCE)WYR_WyrmRockPrison_FlorrickOutisdeFortress_acc54e80-b695-d804-a5df-dfbc09e087fe, S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _FlorrickOwner)
		THEN
		PROC_GlobalSetFlagAndCache(WYR_WyrmRockPrison_Florrick_State_EscapedDialogFailedToStart_383be339-a99b-4dec-bf3a-351e66bd1dbb);
		
		IF
		DB_GlobalFlag((FLAG)WYR_WyrmRockPrison_State_FlorrickLeftFortress_0a2cfd0f-2224-4c58-8777-28672b048aa5)
		THEN
		CharacterStopCrime((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, "WYR_WyrmRockPrison_FlorrickEscape", NULL_00000000-0000-0000-0000-000000000000);
		PROC_RemovePartyFollower((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9);
		PROC_GlobalClearFlagAndCache(WYR_WyrmRockPrison_State_FlorrickFollowing_191938a2-5aa3-439b-b7b9-5b7485d436cd);
		
		IF
		DialogEnded((DIALOGRESOURCE)WYR_WyrmRockPrison_FlorrickOutisdeFortress_acc54e80-b695-d804-a5df-dfbc09e087fe, _)
		AND
		DB_WYR_WyrmRockPrison_FlorrickEscapeDirections(_EscapeBoxTrigger, _EscapePointTrigger)
		AND
		IsInTrigger(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _EscapeBoxTrigger, 1)
		AND
		QRY_OnlyOnce("WYR_WyrmRockPrison_FlorrickDisappears")
		THEN
		//PROC_DisappearOutOfSightTo simply doesn't work correctly
		PROC_CharacterMoveTo((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _EscapePointTrigger, "Sprint", "WYR_WyrmRockPrison_FlorrickMovedToEscapePoint");
		
		IF
		EntityEvent(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, "WYR_WyrmRockPrison_FlorrickMovedToEscapePoint")
		THEN
		PROC_SetOnStage((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, 0);
		SetEntityEvent(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, "WYR_WyrmRockPrison_FlorrickEscaped");
		
		// fallback if outside all triggers
		IF
		DialogEnded((DIALOGRESOURCE)WYR_WyrmRockPrison_FlorrickOutisdeFortress_acc54e80-b695-d804-a5df-dfbc09e087fe, _)
		AND
		QRY_OnlyOnce("WYR_WyrmRockPrison_FlorrickDisappears")
		THEN
		PROC_DisappearOutOfSight((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, "Sprint", 1, "WYR_WyrmRockPrison_FlorrickEscaped");
		
		IF
		DB_PermaDefeated(_Guard)
		AND
		DB_WYR_WyrmRockPrison_Guards((CHARACTER)_Guard)
		AND
		NOT DB_GlobalFlag(WYR_WyrmRockPrison_State_NotAllGuardsOk_5f090b41-b6bf-4c32-97df-c65748ca1255)
		THEN
		PROC_GlobalSetFlagAndCache(WYR_WyrmRockPrison_State_NotAllGuardsOk_5f090b41-b6bf-4c32-97df-c65748ca1255);
		
		IF
		EntityEvent(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, "WYR_WyrmRockPrison_FlorrickEscaped")
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_WyrmRockPrison_State_FlorrickEscaped_a84a5b16-ca29-43c3-91bf-17def670ba07);
		
		IF
		FlagSet((FLAG)WYR_WyrmRockPrison_State_FlorrickEscaped_a84a5b16-ca29-43c3-91bf-17def670ba07, _, _)
		AND
		NOT DB_GlobalFlag((FLAG)WYR_WyrmRockPrison_State_NotAllGuardsOk_5f090b41-b6bf-4c32-97df-c65748ca1255)
		THEN
		PROC_WYR_WyrmRockPrison_FlorrickEscapedPeacefully();
		
		PROC
		PROC_WYR_WyrmRockPrison_FlorrickEscapedPeacefully()
		AND
		DB_WYR_WyrmRockPrison_Guards(_Guard)
		THEN
		PROC_PeacefulResolve(_Guard);
		
		IF
		DB_GlobalFlag(WYR_WyrmRockPrison_State_FlorrickEscaped_a84a5b16-ca29-43c3-91bf-17def670ba07)
		THEN
		PROC_WYR_WyrmRockPrison_ReturnFlorrickWeapon();
		
		// Florrick shouldn't go to the second floor or WyrmWay dungeon
		// When the player tries to use either exit she should start a dialog where she tells the player about this
		// If the dialog fails to start she should leave the party and wait for the player to finish their business
		// need to make sure her behavior is disabled!
		PROC
		PROC_BlockUseOfItem(_Player, _Item)
		AND
		DB_WYR_WyrmRockPrison_ForbiddenExits(_Item)
		AND
		DB_GlobalFlag((FLAG)WYR_WyrmRockPrison_State_FlorrickFollowing_191938a2-5aa3-439b-b7b9-5b7485d436cd)
		AND
		CharacterGetOwner(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _FlorrickOwner)
		AND
		QRY_WYR_WyrmRockPrison_FlorrickNeedsToStopPlayer(_Player, _FlorrickOwner)
		THEN
		DB_CustomUseItemResponse(_Player, _Item, 0);
		PROC_GlobalSetFlagAndCache((FLAG)WYR_WyrmRockPrison_State_FlorrickStoppedPlayer_7737301e-a804-4f8a-9cb8-f36ebf32b5c9);
		PROC_WYR_WyrmRockPrison_StopPlayer(_FlorrickOwner);
		
		QRY
		QRY_REALLY_BlockFastTravel(_Player)
		AND
		DB_GlobalFlag((FLAG)WYR_WyrmRockPrison_State_FlorrickFollowing_191938a2-5aa3-439b-b7b9-5b7485d436cd)
		AND
		CharacterGetOwner(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _FlorrickOwner)
		AND
		QRY_WYR_WyrmRockPrison_FlorrickNeedsToStopPlayer(_Player, _FlorrickOwner)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_WyrmRockPrison_State_FlorrickStoppedPlayer_7737301e-a804-4f8a-9cb8-f36ebf32b5c9);
		PROC_WYR_WyrmRockPrison_StopPlayer(_FlorrickOwner);
		
		QRY
		QRY_REALLY_BlockFastTravel(_Player)
		AND
		DB_GlobalFlag((FLAG)WYR_WyrmRockPrison_State_FlorrickFollowing_191938a2-5aa3-439b-b7b9-5b7485d436cd)
		AND
		DB_GLO_Follower_Reassigning(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _, _FlorrickOwner)
		AND
		QRY_WYR_WyrmRockPrison_FlorrickNeedsToStopPlayer(_Player, _FlorrickOwner)
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_WyrmRockPrison_State_FlorrickStoppedPlayer_7737301e-a804-4f8a-9cb8-f36ebf32b5c9);
		PROC_WYR_WyrmRockPrison_StopPlayer(_FlorrickOwner);
		
		QRY
		QRY_WYR_WyrmRockPrison_FlorrickNeedsToStopPlayer(NULL_00000000-0000-0000-0000-000000000000, (CHARACTER)_FlorrickOwner)
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_WYR_WyrmRockPrison_FlorrickNeedsToStopPlayer((CHARACTER)_Player, (CHARACTER)_FlorrickOwner)
		AND
		_Player == _FlorrickOwner
		THEN
		DB_NOOP(1);
		
		QRY
		QRY_WYR_WyrmRockPrison_FlorrickNeedsToStopPlayer((CHARACTER)_Player, (CHARACTER)_FlorrickOwner)
		AND
		_Player != _FlorrickOwner
		AND
		IsInPartyWith(_FlorrickOwner, _Player, 1)
		AND
		InSamePartyGroup(_FlorrickOwner, _Player, 1)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_WYR_WyrmRockPrison_StopPlayer((CHARACTER)_FlorrickOwner)
		AND
		NOT QRY_SpeakerIsAvailableAndInDialogRange(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _FlorrickOwner)
		THEN
		RemovePartyFollower((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _FlorrickOwner);
		PROC_GlobalClearFlagAndCache((FLAG)WYR_WyrmRockPrison_State_FlorrickFollowing_191938a2-5aa3-439b-b7b9-5b7485d436cd);
		PROC_GlobalSetFlagAndCache((FLAG)WYR_WyrmRockPrison_State_FlorrickWaiting_05fbdbe7-b83a-4005-accb-3d5b1550f03a);
		
		PROC
		PROC_WYR_WyrmRockPrison_StopPlayer((CHARACTER)_FlorrickOwner)
		AND
		QRY_SpeakerIsAvailableAndInDialogRange(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _FlorrickOwner)
		AND
		NOT QRY_StartDialog_Fixed((DIALOGRESOURCE)WYR_WyrmRockPrison_FlorrickEscapeInProgress_db2ec9f1-a0a8-e78e-9b7b-11baf9caf816, S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _FlorrickOwner)
		THEN
		RemovePartyFollower((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _FlorrickOwner);
		PROC_GlobalClearFlagAndCache((FLAG)WYR_WyrmRockPrison_State_FlorrickFollowing_191938a2-5aa3-439b-b7b9-5b7485d436cd);
		PROC_GlobalSetFlagAndCache((FLAG)WYR_WyrmRockPrison_State_FlorrickWaiting_05fbdbe7-b83a-4005-accb-3d5b1550f03a);
		
		PROC
		PROC_BasiliskGate_FlorrickExecution_FlorrickExecuted()
		THEN
		PROC_SceneOver("WYR_WyrmRockPrison_Florrick");
		PROC_SpotPlayers_StopSpotting("WYR_WyrmRockPrison_Florrick");
		TriggerUnregisterForCharacter((TRIGGER)S_WYR_Fortress_SUB_94ca5a54-0813-48b4-9f55-4cb039a63c82, (CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9);
		TriggerUnregisterForCharacter((TRIGGER)S_WYR_Prison_SUB_cd67276d-52e4-44b9-a237-0e2cd45106d8, (CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9);
		TriggerUnregisterForCharacter((TRIGGER)S_WYR_WyrmRockPrison_FlorricksCell_db3096d9-3177-4245-93a6-f01c8bb6889f, (CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9);
		//END_REGION
		
		//REGION Florric Weapon
		PROC
		PROC_WYR_WyrmRockPrison_RemoveFlorrickWeapon()
		AND
		GetEquippedWeapon((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _Weapon)
		THEN
		Unequip((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _Weapon);
		
		IF
		Unequipped(_Weapon, (CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9)
		THEN
		DB_WYR_WyrmRockPrison_FlorrickWeapon((ITEM)_Weapon);
		ToInventory(_Weapon, S_Debug_WYR_AsylumChest_a171f3f6-0957-4796-be62-e491b9c2b560, 1, 0, 0);
		
		PROC
		PROC_WYR_WyrmRockPrison_ReturnFlorrickWeapon()
		AND
		DB_WYR_WyrmRockPrison_FlorrickWeapon(_Weapon)
		THEN
		ToInventory(_Weapon, S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, 1, 0, 0);
		
		IF
		AddedTo((ITEM)_Weapon, S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _)
		AND
		DB_WYR_WyrmRockPrison_FlorrickWeapon(_Weapon)
		THEN
		NOT DB_WYR_WyrmRockPrison_FlorrickWeapon(_Weapon);
		Equip((CHARACTER)S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, _Weapon, 1, 0, 0);
		//END_REGION
		
		//REGION Debug
		IF
		TextEvent("wyr_imprison")
		AND
		GetHostCharacter(_Player)
		AND
		DB_RegionPrison("BGO_Main_A_WyrmRock", _PrisonCell, _PrisonSpawnPoint)
		AND
		DB_PlayerPrison(_PrisonTrigger, _, _, _FugitiveStatus)
		THEN
		PROC_CrimeTeleportCharacterToPrison((CHARACTER)S_WYR_WyrmRockPrison_PlayerCellGuard_3f27f04f-4041-462e-9db3-a3ba163eb0c6, _Player, _PrisonCell, _PrisonSpawnPoint, _FugitiveStatus);
		
		IF
		TextEvent("wyr_to_florrick")
		THEN
		PROC_GlobalSetFlagAndCache((FLAG)WYR_WyrmRockPrison_State_GainedAccess_7cd68e28-3e02-472b-ae9a-cad9f21b1aa9);
		PROC_TeleportPartiesTo((TRIGGER)S_Debug_WYR_WyrmRockPrison_FlorrickCell_f5379c9c-f5c8-4db6-9ffe-8d87d26b8d63, "");
		
		IF
		TextEvent("wyr_florrick_unlock")
		THEN
		Unlock((ITEM)S_WYR_WyrmRockPrison_EntranceDoor_ec90dfc0-becb-4918-b003-603d6e7a3ffa);
		Unlock(S_WYR_WyrmRockPrison_PrisonCell_002_Door_682d19a1-a0dc-4488-9a4d-d276e9d2062c);
		
		IF
		TextEvent("wyr_florrick_invis")
		THEN
		ApplyStatus(S_GLO_Desire_8b9fa503-7205-4ddd-bdfa-bfaa781d9ea9, "INVISIBILITY", -1.0, 1, NULL_00000000-0000-0000-0000-000000000000);
		//END_REGION
		
		//REGION Secret Exit
		IF
		EntityEvent(S_WYR_WyrmRockPrison_SecretEntrance_ac85bbb6-b546-4104-a050-59f16e147f41, "StoryReveal")
		THEN
		DB_WYR_WyrmRockPrison_SecretEntranceDiscovered(1);
		
		// if we use the secret exit from the prison, then we immediately reveal the secret entrance
		// if it hasn't been revealed yet
		IF
		UseFinished(_, S_WYR_WyrmRockPrison_SecretExit_53a99caf-ff0c-4000-946d-1db4cfbe6ac4, 1)
		AND
		NOT DB_WYR_WyrmRockPrison_SecretEntranceDiscovered(1)
		THEN
		DB_WYR_WyrmRockPrison_SecretEntranceDiscovered(1);
		SetEntityEvent((ITEM)S_WYR_WyrmRockPrison_SecretEntrance_ac85bbb6-b546-4104-a050-59f16e147f41, "StoryReveal", 1);
		//END_REGION
		
		//REGION Crime needs to be removed as soon as we leave the Prison
		IF
		DB_PlayerEscapedPrison(_Player, _, S_WYR_WyrmRockPrison_PlayerCell_6792230e-f319-4870-8778-5f7bfae74489, _, _, _, _ , _, _)
		AND
		DB_FugitiveArea((TRIGGER)S_WYR_WyrmRockPrison_PlayerCell_6792230e-f319-4870-8778-5f7bfae74489, _FugitiveArea)
		AND
		NOT DB_InRegion(_Player, _FugitiveArea)
		THEN
		PROC_CRIME_PrisonRemoveFugitiveStatuses(_Player);
		//END_REGION
		
		//REGION Debug command for Wyrms Way
		IF
		DB_Debug_WYR_WyrmRockPrison_RemoveTrespass(1)
		AND
		DB_TrespassTrigger((TRIGGER)S_WYR_WyrmRockPrison_TrespassingArea_f7043b14-dbfd-4c72-a75f-c069df6bd5ca, S_WYR_WyrmRockPrison_OutPos_fcaa384b-7c29-4836-b959-e95c68d540ea, "WYR_WyrmRockPrison_InnerAreaTrespassing")
		THEN
		PROC_GlobalSetFlagAndCache(WYR_WyrmRockPrison_State_GainedAccess_7cd68e28-3e02-472b-ae9a-cad9f21b1aa9);
		//END_REGION
	}
	EXIT
	{
	}
}
