		DB_HasItemEvent(S_GOB_SharTempleMap_f01b15a1-e670-43ac-abeb-e7ec9d5fc803, (FLAG)GOB_SharTempleEntrance_HasMap_8c35b5fe-1969-f575-7e69-218ca68f35df);
		DB_GiveItemToEvent(S_GOB_SharTempleMap_f01b15a1-e670-43ac-abeb-e7ec9d5fc803, (FLAG)GOB_SharTempleEntrance_GiveMap_8cc48f44-0038-4f68-8488-722ab13c31fe);
		//DB_GlobalFlagReactionAfterDialog(GOB_RoastingDwarf_OfferedLove_cefc5a12-ddad-404c-87f3-7242faa12bf3, GOB_Festivities_DwarfOperator000_f4cf220e-6443-7937-5f73-ff9a954b2768);
		DB_FlagReactionAfterDialog(GOB_RoastingDwarf_GavePants_e9bad0fd-452d-4443-abaf-966bffe26810, GOB_Festivities_DwarfOperator000_f4cf220e-6443-7937-5f73-ff9a954b2768);
		
		DB_GOB_RoastingDwarf_Pieces((ITEM)S_GOB_RoastingDwarf_A_000_b82d2fc8-ba9b-451c-af91-d5c7ab29eaae);
		DB_GOB_RoastingDwarf_Pieces(S_GOB_RoastingDwarf_B_000_9782a866-ac02-4494-a3a4-2598a13cb84a);
		DB_GOB_RoastingDwarf_Pieces(S_GOB_RoastingDwarf_C_000_8897e6c4-dcd7-4fe4-8669-fc9c247d4a77);
		DB_GOB_RoastingDwarf_Pieces(S_GOB_RoastingDwarf_C_001_8df1feb1-e4cd-4e22-a9d5-552a5dbc9752);
		
		TriggerRegisterForItems(S_GOB_RoastingDwarf_StealingTrigger_4ea00991-09e9-4605-b6e8-4b5c895fd154);
	}
	KB
	{
		//REGION Meat
		IF
		ItemLeftTrigger(_Piece,S_GOB_RoastingDwarf_StealingTrigger_4ea00991-09e9-4605-b6e8-4b5c895fd154,_)
		AND
		DB_GOB_RoastingDwarf_Pieces(_Piece)
		AND
		NOT QRY_GOB_RoastingDwarf_NotStolen()
		THEN
		PROC_GOB_RoastingDwarf_SetStolenFlag();
		
		IF
		ItemEnteredTrigger(_Piece,S_GOB_RoastingDwarf_StealingTrigger_4ea00991-09e9-4605-b6e8-4b5c895fd154,_)
		AND
		DB_GOB_RoastingDwarf_Pieces(_Piece)
		AND
		IsInInventory(_Piece,0)
		THEN
		PROC_GOB_RoastingDwarf_ClearStolenFlag();
		
		IF
		AddedTo(_Piece,_, _)
		AND
		DB_GOB_RoastingDwarf_Pieces((ITEM)_Piece)
		AND
		NOT QRY_GOB_RoastingDwarf_NotStolen()
		THEN
		PROC_GOB_RoastingDwarf_SetStolenFlag();
		
		IF
		DroppedBy(_Piece,_)
		AND
		DB_GOB_RoastingDwarf_Pieces((ITEM)_Piece)
		AND
		IsInTrigger(_Piece,S_GOB_RoastingDwarf_StealingTrigger_4ea00991-09e9-4605-b6e8-4b5c895fd154,1)
		THEN
		PROC_GOB_RoastingDwarf_ClearStolenFlag();
		
		QRY
		QRY_GOB_RoastingDwarf_NotStolen()
		AND
		DB_GOB_RoastingDwarf_Pieces(_Piece)
		AND
		IsInTrigger(_Piece,S_GOB_RoastingDwarf_StealingTrigger_4ea00991-09e9-4605-b6e8-4b5c895fd154,1)
		AND
		IsInInventory(_Piece,0)
		THEN
		DB_NOOP(1);
		
		PROC
		PROC_GOB_RoastingDwarf_SetStolenFlag()
		THEN
		SetFlag((FLAG)GOB_RoastingDwarf_Quest_MeatStolen_21125a9e-8852-a631-e796-930160f74869, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		
		PROC
		PROC_GOB_RoastingDwarf_ClearStolenFlag()
		THEN
		ClearFlag((FLAG)GOB_RoastingDwarf_Quest_MeatStolen_21125a9e-8852-a631-e796-930160f74869, NULL_00000000-0000-0000-0000-000000000000, 0); // flagType: Global
		//END_REGION Meat
		
	}
	EXIT
	{
	}
}
