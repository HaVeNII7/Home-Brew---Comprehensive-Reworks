		THEN
		SetHasDialog(S_LOW_AngryNoble_001_4707eca2-13b3-4912-9f5f-7a8ae5307aeb,1);
		SetHasDialog(S_LOW_AngryNoble_002_24376c44-ee3e-4131-86b1-25b738aee446,1);
