<ls:UIWidget x:Name="HB_VisualPresets"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ls="clr-namespace:ls;assembly=Code"
    xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors">
    <ls:UIWidget.Resources>
        <ResourceDictionary>
            <BitmapImage x:Key="HB_PresetFrame" UriSource="pack://application:,,,/Core;component/Assets/Messagebox/dialogBox.png"/>
            <Style x:Key="HB_PresetRowStyle" TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="True"/>
                <Setter Property="ls:MoveFocus.Focusable" Value="True"/>
                <Setter Property="Padding" Value="20,12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="entry" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="entry" Property="Background" Value="#804A3827"/>
                                    <Setter TargetName="entry" Property="BorderBrush" Value="{StaticResource LS_accent100TxtColor}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="entry" Property="Background" Value="#504A3827"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="HB_GearCompactRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource HB_PresetRowStyle}">
                <Setter Property="Padding" Value="14,5"/>
            </Style>
            <Style x:Key="HB_GearItemRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource HB_PresetRowStyle}">
                <Setter Property="Padding" Value="10,1"/>
            </Style>
        </ResourceDictionary>
    </ls:UIWidget.Resources>
    <ls:UIWidget.Template>
        <ControlTemplate TargetType="ls:UIWidget">
            <Grid>
                <Grid x:Name="HB_PresetModal" Background="{StaticResource LS_PanelBackground}" ls:MoveFocus.IsMoveFocusScope="True"
                    KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle"
                    Visibility="{Binding HB_Open, Converter={StaticResource BoolToVisibleConverter}, FallbackValue=Collapsed}">
                    <b:Interaction.Triggers>
                        <b:DataTrigger Binding="{Binding HB_Open}" Value="True">
                            <ls:SetMoveFocusAction TargetName="HB_PresetBack"/>
                        </b:DataTrigger>
                    </b:Interaction.Triggers>
                    <ls:LSNineSliceImage ImageSource="{StaticResource HB_PresetFrame}" Slices="0,196,0,224" Width="1424"
                        Padding="110,150,110,170" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{Binding HB_Title}" FontFamily="{StaticResource DefaultFont}" FontSize="{StaticResource ScaledMassiveFontSize}"
                                Foreground="{StaticResource LS_tint100}" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                            <StackPanel Visibility="{Binding HB_SaveMode, Converter={StaticResource BoolToVisibleConverter}}" Margin="80,0">
                                <TextBlock Text="Preset Name" TextAlignment="Center" FontSize="{StaticResource ScaledDefaultFontSize}" Foreground="{StaticResource LS_accent100TxtColor}" Margin="0,0,0,12"/>
                                <ls:LSTextBox x:Name="HB_PresetName" Text="{Binding HB_Name, Mode=TwoWay}" TextImmediateSourceUpdate="True" MaxLength="64"
                                    MinHeight="72" FontSize="{StaticResource ScaledDefaultFontSize}" Foreground="{StaticResource LS_baseTxtColor}"
                                    Background="Black" CaretBrush="#FFF2E4CD" SelectionBrush="#FF66543A" BorderBrush="{StaticResource LS_accent25TxtColor}" BorderThickness="1" Padding="18,8">
                                    <ls:LSTextBox.Style>
                                        <Style TargetType="ls:LSTextBox" BasedOn="{StaticResource {x:Type ls:LSTextBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HB_Confirm}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                                <DataTrigger Binding="{Binding HB_Busy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ls:LSTextBox.Style>
                                    <ls:LSTextBox.Template>
                                        <ControlTemplate TargetType="ls:LSTextBox">
                                            <Border Background="Black" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ls:LSTextBox.Template>
                                    <b:Interaction.Triggers>
                                        <b:DataTrigger Binding="{Binding HB_SaveMode}" Value="True">
                                            <noesis:SetFocusAction/>
                                        </b:DataTrigger>
                                    </b:Interaction.Triggers>
                                </ls:LSTextBox>
                            </StackPanel>
                            <StackPanel Visibility="{Binding HB_LoadMode, Converter={StaticResource BoolToVisibleConverter}}" Margin="40,0">
                                <TextBlock Text="Select a matching race, subrace, and body type to load an appearance." TextAlignment="Center" TextWrapping="Wrap"
                                    FontSize="{StaticResource ScaledDefaultFontSize}" Foreground="{StaticResource LS_accent100TxtColor}" Margin="0,0,0,16"/>
                                <ListBox x:Name="HB_PresetList" ItemsSource="{Binding HB_Rows}" SelectedIndex="{Binding HB_SelectedIndex, Mode=TwoWay}"
                                    IsEnabled="{Binding HB_DeleteConfirm, Converter={StaticResource InvertBoolConverter}}" ItemContainerStyle="{StaticResource HB_PresetRowStyle}" MaxHeight="500" MinHeight="120"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    Background="Transparent" BorderBrush="{StaticResource LS_accent25TxtColor}" BorderThickness="1">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="{StaticResource ScaledDefaultFontSize}" Foreground="{StaticResource LS_baseTxtColor}"/>
                                                <TextBlock Text="{Binding Detail}" FontSize="{StaticResource SmallFontSize}" Foreground="{StaticResource LS_accent100TxtColor}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                            <TextBlock Text="{Binding HB_Status}" TextWrapping="Wrap" TextAlignment="Center" Margin="70,20,70,0"
                                FontSize="{StaticResource ScaledDefaultFontSize}" Foreground="{StaticResource LS_accent100TxtColor}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
                                <ls:LSButton x:Name="HB_PresetBack" Content="Back" Command="{Binding HB_Back}" BoundEvent="UICancel"
                                    Style="{StaticResource BrownButtonStyle}" MinWidth="380" MinHeight="88" Margin="-5,0"/>
                                <ls:LSButton x:Name="HB_PresetSave" Command="{Binding HB_Save}" BoundEvent="UIAccept"
                                    IsEnabled="{Binding HB_CanSave}" Visibility="{Binding HB_SaveMode, Converter={StaticResource BoolToVisibleConverter}}"
                                    MinWidth="380" MinHeight="88" Margin="-5,0">
                                    <ls:LSButton.Style>
                                        <Style TargetType="ls:LSButton" BasedOn="{StaticResource BlueButtonStyle}">
                                            <Setter Property="Content" Value="Save"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HB_Confirm}" Value="True"><Setter Property="Content" Value="Replace"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ls:LSButton.Style>
                                </ls:LSButton>
                                <ls:LSButton Content="{Binding HB_DeleteLabel}" Command="{Binding HB_Delete}"
                                    IsEnabled="{Binding HB_CanDelete}" Visibility="{Binding HB_LoadMode, Converter={StaticResource BoolToVisibleConverter}}"
                                    Style="{StaticResource BrownButtonStyle}" MinWidth="380" MinHeight="88" Margin="-5,0"/>
                                <ls:LSButton x:Name="HB_PresetLoad" Content="Load" Command="{Binding HB_Load}" BoundEvent="UIAccept"
                                    IsEnabled="{Binding HB_CanLoad}" Visibility="{Binding HB_LoadMode, Converter={StaticResource BoolToVisibleConverter}}"
                                    Style="{StaticResource BlueButtonStyle}" MinWidth="380" MinHeight="88" Margin="-5,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ls:LSNineSliceImage>
                </Grid>
                <Grid x:Name="HB_GearModal"
                    Visibility="{Binding HB_Gear_Open, Converter={StaticResource BoolToVisibleConverter}, FallbackValue=Collapsed}"
                    ls:MoveFocus.IsMoveFocusScope="True"
                    KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Cycle">
                    <Grid Width="1122" Height="1835" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="400,57,0,0">
                        <Border Background="#FF090806" CornerRadius="22" BorderBrush="#FF57462E" BorderThickness="1"/>
                        <ls:LSNineSliceImage ImageSource="{StaticResource HB_PresetFrame}" Slices="0,196,0,224"
                            Padding="60,82,60,50" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,210,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="375"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Equipment Slots" FontSize="{StaticResource ScaledDefaultFontSize}"
                                        Foreground="{StaticResource LS_accent100TxtColor}" Margin="8,0,0,8"/>
                                    <ListBox ItemsSource="{Binding HB_Gear_Slots}" SelectedIndex="{Binding HB_Gear_SlotIndex, Mode=TwoWay}"
                                        ItemContainerStyle="{StaticResource HB_GearCompactRowStyle}" Height="1110"
                                        ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        Background="Transparent" BorderBrush="{StaticResource LS_accent25TxtColor}" BorderThickness="1">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource LS_baseTxtColor}"
                                                        FontSize="{StaticResource ScaledDefaultFontSize}"/>
                                                    <TextBlock Text="{Binding Choice}" Foreground="{StaticResource LS_accent100TxtColor}"
                                                        FontSize="17" Margin="0,0,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding HB_Gear_SlotTitle}" FontSize="{StaticResource ScaledDefaultFontSize}"
                                        Foreground="{StaticResource LS_accent100TxtColor}" Margin="8,0,0,8"/>
                                    <ListBox ItemsSource="{Binding HB_Gear_Items}" SelectedIndex="{Binding HB_Gear_ItemIndex, Mode=TwoWay}"
                                        ItemContainerStyle="{StaticResource HB_GearItemRowStyle}" Height="1110"
                                        ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        Background="Transparent" BorderBrush="{StaticResource LS_accent25TxtColor}" BorderThickness="1">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Width="32" Height="32" Margin="0,0,10,0">
                                                        <Image.Source>
                                                            <MultiBinding Converter="{StaticResource IconIdToSourceConverter}"
                                                                ConverterParameter="{StaticResource FallBackPassiveIconPath}">
                                                                <Binding Source="Assets/Tooltips/ItemIcons/"/>
                                                                <Binding Path="Icon"/>
                                                            </MultiBinding>
                                                        </Image.Source>
                                                    </Image>
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource LS_baseTxtColor}"
                                                        FontSize="{StaticResource ScaledDefaultFontSize}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                    <ls:LSButton Content="Select" Command="{Binding HB_Gear_Select}"
                                        Style="{StaticResource BrownButtonStyle}" MinWidth="208" Margin="0,0,105,0"/>
                                    <ls:LSButton x:Name="HB_GearBack" Content="Close" Command="{Binding HB_Gear_Close}" BoundEvent="UICancel"
                                        Style="{StaticResource BrownButtonStyle}" MinWidth="208" Margin="105,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ls:LSNineSliceImage>
                        <TextBlock Text="Change Equipment" FontFamily="{StaticResource DefaultFont}"
                            FontSize="{StaticResource ScaledMassiveFontSize}" Foreground="{StaticResource LS_tint100}"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,22,0,0"/>
                        <TextBlock Text="Choose an equipment slot, then select an item."
                            FontSize="{StaticResource ScaledDefaultFontSize}" Foreground="{StaticResource LS_accent100TxtColor}"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,132,0,0"/>
                        <TextBlock Text="{Binding HB_Gear_Warning}" TextAlignment="Center" TextWrapping="Wrap"
                            FontSize="{StaticResource ScaledDefaultFontSize}" Foreground="#FFFFBD76"
                            HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="1010" Margin="0,179,0,0"/>
                    </Grid>
                </Grid>

            </Grid>

        </ControlTemplate>
    </ls:UIWidget.Template>
</ls:UIWidget>
