<ls:UIWidget x:Name="HB_NormalGameOverBridge" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ls="clr-namespace:ls;assembly=Code"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
             ls:UIWidget.ContextName="GameMenu" Width="0" Height="0" Opacity="0"
             IsHitTestVisible="False" Focusable="False">
    <b:Interaction.Triggers>
        <b:DataTrigger Binding="{Binding Opacity, ElementName=HB_NormalGameOverBridge}" Value="1">
            <b:InvokeCommandAction Command="{Binding CustomEvent}" CommandParameter="HB_OpenNormalGameOver"/>
        </b:DataTrigger>
    </b:Interaction.Triggers>
    <ls:UIWidget.Template>
        <ControlTemplate>
            <Grid IsHitTestVisible="False"/>
        </ControlTemplate>
    </ls:UIWidget.Template>
</ls:UIWidget>
