<ls:UIWidget x:Name="HB_LevelUpBuild"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ls="clr-namespace:ls;assembly=Code"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    ls:UIWidget.UseCustomDC="True" ls:UIWidget.ContextName="HB_LevelUpBuild">
    <ls:UIWidget.Resources>
        <ResourceDictionary>
            <Style x:Key="HB_RespecBuildPresetRowStyle" TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="True"/>
                <Setter Property="ls:MoveFocus.Focusable" Value="True"/>
                <Setter Property="Padding" Value="20,12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="entry" Padding="{TemplateBinding Padding}" BorderThickness="1"
                                    BorderBrush="Transparent" Background="Transparent">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="entry" Property="Background" Value="#804A3827"/>
                                    <Setter TargetName="entry" Property="BorderBrush" Value="{StaticResource LS_accent100TxtColor}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="entry" Property="Background" Value="#504A3827"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ls:UIWidget.Resources>
    <ls:UIWidget.Template>
        <ControlTemplate TargetType="ls:UIWidget">
            <Grid>
                <!-- Fixed bottom-right anchor avoids overlapping any class progression card. -->
                <StackPanel Width="760" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,0,105">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ls:LSButton Content="Save Build" Command="{Binding HB_OpenSave}"
                            Style="{StaticResource BrownButtonStyle}" Width="230" MinWidth="0" Margin="-3,0"/>
                        <ls:LSButton Content="Builds" Command="{Binding HB_OpenLoad}"
                            Style="{StaticResource BrownButtonStyle}" Width="230" MinWidth="0" Margin="-3,0"/>
                    </StackPanel>
                    <ls:LSButton Content="Apply Build Choices" Command="{Binding HB_Apply}"
                        IsEnabled="{Binding HB_CanApply}" Style="{StaticResource BlueButtonStyle}"
                        Width="480" MinWidth="0" HorizontalAlignment="Center" Margin="0,2"/>
                    <TextBlock Text="{Binding HB_Assigned}" TextAlignment="Center" FontSize="19"
                        Foreground="{StaticResource LS_tint100}" TextTrimming="CharacterEllipsis"
                        Margin="0,3,0,0" Width="470"/>
                    <TextBlock Text="{Binding HB_Status}" TextWrapping="Wrap" TextAlignment="Center" FontSize="16"
                        Foreground="{StaticResource LS_accent100TxtColor}"
                        Width="470" Margin="0,3,0,0"/>
                </StackPanel>
                <!-- Native respec build-picker markup, with bindings to the ordinary level-up controller. -->
                <Grid Background="{StaticResource LS_PanelBackground}"
                    Visibility="{Binding HB_Open, Converter={StaticResource BoolToVisibleConverter}, FallbackValue=Collapsed}"
                    IsHitTestVisible="{Binding HB_Open, FallbackValue=False}">
                    <ls:LSNineSliceImage ImageSource="pack://application:,,,/Core;component/Assets/Messagebox/dialogBox.png"
                         Slices="0,196,0,224" Width="1470" Padding="135,140,135,165"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Width="1180" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding HB_DialogTitle}" FontFamily="{StaticResource DefaultFont}"
                                FontSize="{StaticResource ScaledHugeFontSize}" Foreground="{StaticResource LS_tint100}"
                                HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,18"/>
                            <StackPanel Visibility="{Binding HB_SaveMode, Converter={StaticResource BoolToVisibleConverter}}">
                                <TextBlock Text="Build Name" HorizontalAlignment="Center"
                                    Foreground="{StaticResource LS_tint100}" FontSize="{StaticResource ScaledDefaultFontSize}"/>
                                <ls:LSTextBox x:Name="HB_Name" Text="{Binding HB_Name, Mode=TwoWay}"
                                    TextImmediateSourceUpdate="True" MaxLength="64" MinHeight="70" Margin="160,12,160,0"
                                    FontSize="{StaticResource ScaledDefaultFontSize}" Foreground="{StaticResource LS_baseTxtColor}"
                                    Background="Black" CaretBrush="#FFF2E4CD" BorderBrush="{StaticResource LS_accent25TxtColor}"
                                    BorderThickness="1" Padding="18,8"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding HB_LoadMode, Converter={StaticResource BoolToVisibleConverter}}">
                                <TextBlock Text="Select a compatible build, then click Apply Build Choices to level up automatically."
                                    TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                                    FontSize="{StaticResource ScaledDefaultFontSize}" Foreground="{StaticResource LS_accent100TxtColor}"
                                    Margin="0,0,0,16"/>
                                <ListBox x:Name="HB_BuildList" ItemsSource="{Binding HB_Rows}"
                                    SelectedIndex="{Binding HB_Selected, Mode=TwoWay}"
                                    ItemContainerStyle="{StaticResource HB_RespecBuildPresetRowStyle}"
                                    MaxHeight="480" MinHeight="120"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    Background="Transparent" BorderBrush="{StaticResource LS_accent25TxtColor}" BorderThickness="1">
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="SelectionChanged">
                                            <b:InvokeCommandAction Command="{Binding HB_SelectionChanged}"/>
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource LS_baseTxtColor}"
                                                    FontSize="{StaticResource ScaledDefaultFontSize}"/>
                                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{StaticResource LS_accent100TxtColor}"
                                                    FontSize="{StaticResource SmallFontSize}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                            <TextBlock Text="{Binding HB_Status}" TextWrapping="Wrap" TextAlignment="Center"
                                Foreground="{StaticResource LS_accent100TxtColor}"
                                FontSize="{StaticResource ScaledDefaultFontSize}" Margin="0,18,0,2"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                                <ls:LSButton Content="Back" Command="{Binding HB_Close}"
                                    Style="{StaticResource BrownButtonStyle}" SoundID="UI_Shared_Accept" MinWidth="330" MinHeight="76" Margin="-5,0"/>
                                <ls:LSButton Content="Delete" Command="{Binding HB_Delete}"
                                    IsEnabled="{Binding HB_CanDelete}" Style="{StaticResource BrownButtonStyle}" MinWidth="330" MinHeight="76" Margin="-5,0"
                                    Visibility="{Binding HB_LoadMode, Converter={StaticResource BoolToVisibleConverter}}"/>
                                <ls:LSButton Content="{Binding HB_SaveLabel}" Command="{Binding HB_Save}"
                                    IsEnabled="{Binding HB_CanSave}" Style="{StaticResource BlueButtonStyle}"
                                    MinWidth="330" MinHeight="76" Margin="-5,0"
                                    Visibility="{Binding HB_SaveMode, Converter={StaticResource BoolToVisibleConverter}}"/>
                                <ls:LSButton Content="Assign" Command="{Binding HB_Load}"
                                    IsEnabled="{Binding HB_CanLoad}" Style="{StaticResource BlueButtonStyle}"
                                    MinWidth="330" MinHeight="76" Margin="-5,0"
                                    Visibility="{Binding HB_LoadMode, Converter={StaticResource BoolToVisibleConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </ls:LSNineSliceImage>
                </Grid>
            </Grid>
        </ControlTemplate>
    </ls:UIWidget.Template>
</ls:UIWidget>
