                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsHost}" Value="False"/>
                        <Condition Binding="{Binding IsMainMenu}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ChangeDifficultyNotice" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ConfirmBtn" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="DefaultCustom" Property="Visibility" Value="Collapsed"/>
                </MultiDataTrigger>
                
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMainMenu}" Value="False"/>
                        <Condition Binding="{Binding Metadata, ElementName=DMSettings}" Value=""/>
                        <Condition Binding="{Binding SelectedItem.AssetName, ElementName=PresetList}" Value="difficulty_07"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ConfirmBtn" Property="IsEnabled" Value="False"/>
                    <Setter TargetName="ConfirmBtn" Property="Command" Value="{x:Null}"/>
                </MultiDataTrigger>
                

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMainMenu}" Value="False"/>
                        <Condition Binding="{Binding DataContext.HB_Ready, ElementName=HB_DifficultyBrowserHost, FallbackValue=False}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="PresetList" Property="ItemsSource" Value="{Binding DataContext.HB_Presets, ElementName=HB_DifficultyBrowserHost}"/>
                    <!-- The HB cards have a different order from BG3's native Presets.
                         Do not bind their index to the original PresetSelectedIndex. -->
                    <Setter TargetName="PresetList" Property="SelectedIndex" Value="{Binding DataContext.HB_SelectedIndex, ElementName=HB_DifficultyBrowserHost, Mode=TwoWay}"/>
                    <Setter TargetName="HB_CustomOnlyView" Property="IsChecked" Value="{Binding DataContext.HB_CustomOnly, ElementName=HB_DifficultyBrowserHost}"/>
                    <Setter TargetName="HB_CustomViewMode" Property="IsChecked" Value="{Binding DataContext.HB_InCustomView, ElementName=HB_DifficultyBrowserHost}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMainMenu}" Value="False"/>
                        <Condition Binding="{Binding DataContext.HB_Ready, ElementName=HB_DifficultyBrowserHost, FallbackValue=False}" Value="True"/>
                        <Condition Binding="{Binding SelectedItem.IsCustom, ElementName=PresetList}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ConfirmBtn" Property="CommandParameter" Value="{Binding SelectedItem.HB_Native, ElementName=PresetList}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMainMenu}" Value="False"/>
                        <Condition Binding="{Binding DataContext.HB_Ready, ElementName=HB_DifficultyBrowserHost, FallbackValue=False}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="PresetList" Property="SelectedValue" Value="{Binding CurrentPreset, Mode=OneTime}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMainMenu}" Value="False"/>
                        <Condition Binding="{Binding DataContext.HB_Ready, ElementName=HB_DifficultyBrowserHost, FallbackValue=False}" Value="True"/>
                        
                        <Condition Binding="{Binding IsChecked, ElementName=HB_CustomViewMode}" Value="False"/>
                        <Condition Binding="{Binding SelectedItem.IsCustom, ElementName=PresetList}" Value="True"/>
                        <Condition Binding="{Binding SelectedItem.HB_CanApply, ElementName=PresetList, FallbackValue=False}" Value="True"/>
