                     attaches the HomeBrew ViewModel. The command itself stays disabled until ready. -->
                <DataTrigger Binding="{Binding IsMainMenu}" Value="True">
                    <Setter TargetName="HB_MCMDifficultyButton" Property="Visibility" Value="Visible"/>
