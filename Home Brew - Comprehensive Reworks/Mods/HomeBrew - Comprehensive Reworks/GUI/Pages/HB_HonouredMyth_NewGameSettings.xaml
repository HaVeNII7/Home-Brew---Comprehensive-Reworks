                    <Setter TargetName="ConfirmBtn" Property="Command" Value="{Binding DataContext.HB_OpenCustomView, ElementName=HB_DifficultyBrowserHost}"/>
                    <Setter TargetName="ConfirmBtn" Property="CommandParameter" Value="{Binding SelectedItem, ElementName=PresetList}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMainMenu}" Value="False"/>
                        <Condition Binding="{Binding DataContext.HB_Ready, ElementName=HB_DifficultyBrowserHost, FallbackValue=False}" Value="True"/>
                        <Condition Binding="{Binding IsChecked, ElementName=HB_CustomViewMode}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="CancelBtn" Property="Command" Value="{Binding DataContext.HB_CloseCustomView, ElementName=HB_DifficultyBrowserHost}"/>
                    <Setter TargetName="CancelBtn" Property="CommandParameter" Value="{x:Null}"/>
                </MultiDataTrigger>

                
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMainMenu}" Value="False"/>
                        <Condition Binding="{Binding DataContext.HB_Ready, ElementName=HB_DifficultyBrowserHost, FallbackValue=False}" Value="True"/>
                        <Condition Binding="{Binding SelectedItem.HB_CanApply, ElementName=PresetList, FallbackValue=False}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ConfirmBtn" Property="IsEnabled" Value="False"/>
                    <Setter TargetName="ConfirmBtn" Property="Command" Value="{x:Null}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMainMenu}" Value="False"/>
                        <Condition Binding="{Binding IsHost}" Value="True"/>
                        <Condition Binding="{Binding DataContext.HB_Ready, ElementName=HB_DifficultyBrowserHost, FallbackValue=False}" Value="True"/>
                        <Condition Binding="{Binding SelectedItem.HB_CanApply, ElementName=PresetList, FallbackValue=False}" Value="False"/>
                        <Condition Binding="{Binding ModifierEnabled, ElementName=HB_SettingsIronmanModifier}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="HB_DifficultyUnavailableNotice" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMainMenu}" Value="False"/>
                        <Condition Binding="{Binding IsHost}" Value="True"/>
                        <Condition Binding="{Binding SelectedItem.IsCustom, ElementName=PresetList}" Value="True"/>
                        <Condition Binding="{Binding IsChecked, ElementName=HB_CustomViewMode}" Value="False"/>
                        <Condition Binding="{Binding ModifierEnabled, ElementName=HB_SettingsIronmanModifier}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="HB_CustomDifficultyNotice" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>

                

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMainMenu}" Value="False"/>
                        <Condition Binding="{Binding ModifierEnabled, ElementName=HB_SettingsIronmanModifier}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="CustomSettingsHolder" Property="IsEnabled" Value="False"/>
                    <Setter TargetName="CustomSettingsHolder" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="ConfirmBtn" Property="IsEnabled" Value="False"/>
                    <Setter TargetName="ConfirmBtn" Property="Command" Value="{x:Null}"/>
                    <Setter TargetName="DefaultCustom" Property="IsEnabled" Value="False"/>
                    <Setter TargetName="DefaultCustom" Property="Command" Value="{x:Null}"/>
                    <Setter TargetName="DefaultCustom" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="CancelBtn" Property="Command" Value="{Binding CustomEvent, Mode=OneTime}"/>
                    <Setter TargetName="CancelBtn" Property="CommandParameter" Value="CloseWidget"/>
                    <Setter TargetName="ChangeDifficultyNotice" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="HB_SingleSaveDifficultyNotice" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="HB_DifficultyBrowserHost" Property="Tag" Value="SingleSave"/>
                    <Setter TargetName="HB_CustomViewMode" Property="IsChecked" Value="False"/>
                                    <Setter TargetName="HB_MCMDifficultyButton" Property="IsEnabled" Value="False"/>
                    <Setter TargetName="HB_MCMCustomSettingsButton" Property="IsEnabled" Value="False"/>
</MultiDataTrigger>

                

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMainMenu}" Value="True"/>
                        <Condition Binding="{Binding IsChecked, ElementName=HB_CustomViewMode}" Value="False"/>
                        <Condition Binding="{Binding DataContext.HB_Enabled, ElementName=HB_SingleSaveToggle}" Value="True"/>
                        <Condition Binding="{Binding DataContext.HB_Applied, ElementName=HB_SingleSaveToggle}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ConfirmBtn" Property="IsEnabled" Value="False"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMainMenu}" Value="True"/>
                        <Condition Binding="{Binding IsChecked, ElementName=HB_CustomViewMode}" Value="False"/>
                        <Condition Binding="{Binding DataContext.HB_Enabled, ElementName=HB_SingleSaveToggle}" Value="False"/>
                        <Condition Binding="{Binding DataContext.HB_Applied, ElementName=HB_SingleSaveToggle}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ConfirmBtn" Property="IsEnabled" Value="False"/>
                </MultiDataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMainMenu}" Value="False"/>
                        <Condition Binding="{Binding DataContext.HB_Ready, ElementName=HB_DifficultyBrowserHost, FallbackValue=False}" Value="True"/>
                        <Condition Binding="{Binding DataContext.HB_MythicConfirmation, ElementName=HB_DifficultyBrowserHost, FallbackValue=False}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="HB_MythicCustomConfirmation" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="GridRoot" Property="IsEnabled" Value="False"/>
                </MultiDataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
