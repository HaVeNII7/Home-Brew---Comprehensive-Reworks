<ls:UIWidget x:Name="DMSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ls="clr-namespace:ls;assembly=Code"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             xmlns:noesis="clr-namespace:NoesisGUIExtensions;assembly=Noesis.GUI.Extensions"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             ls:UIWidget.ContextName="DMSettings"
             d:DataContext="{d:DesignInstance {x:Type ls:DCDMSettings}, IsDesignTimeCreatable=True}"
             d:DesignHeight="2160" d:DesignWidth="3840">

    <ls:UIWidget.Template>
        <ControlTemplate>
            <ControlTemplate.Resources>
                <System:String x:Key="HB_CloseWidgetParameter">CloseWidget</System:String>
                <BitmapImage x:Key="FadeFooterImage" UriSource="pack://application:,,,/Core;component/Assets/DMSettings/fade_footer.png"/>
                <BitmapImage x:Key="FooterCenterDecorImage" UriSource="pack://application:,,,/Core;component/Assets/DMSettings/footer_centerDecors.png"/>
                <BitmapImage x:Key="FooterSideDecorImage" UriSource="pack://application:,,,/Core;component/Assets/DMSettings/footer_sideDecors.png"/>
                <BitmapImage x:Key="BackgroundBanner" UriSource="pack://application:,,,/Core;component/Assets/DMSettings/column_bg.png" />
                <BitmapImage x:Key="SelectorInactive" UriSource="pack://application:,,,/Core;component/Assets/DMSettings/selector_inactive.png" />
                <BitmapImage x:Key="BackgroundFade" UriSource="pack://application:,,,/Core;component/Assets/Shared/background_fade.png"/>
                <BitmapImage x:Key="BackgroundCarouselHeader" UriSource="pack://application:,,,/Core;component/Assets/DMSettings/fade_header_box.png"/>

                <Thickness x:Key="WidescreenMarginCustom">-2840,0,0,-100</Thickness>
                <Thickness x:Key="LetterboxMarginCustom">-2460,0,0,-100</Thickness>
                <Thickness x:Key="FullscreenMarginCustom">-2000,0,0,-100</Thickness>

                <!-- 16:10 ratios -->
                <System:Double x:Key="LetterBoxRatioSettingWidth">600</System:Double>
                <!-- 4:3 ratios -->
                <System:Double x:Key="FullscreenRatioSettingWidth">480</System:Double>

                <DataTemplate x:Key="RulesetDataTemplate" DataType="{x:Type ListBoxItem}">
                    <Grid Background="Transparent" HorizontalAlignment="Center" d:DataContext="{d:DesignInstance {x:Type ls:VMPreset}, IsDesignTimeCreatable=True}">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="MouseEnter">
                                <ls:LSPlaySound Sound="UI_Shared_Hover"/>
                            </b:EventTrigger>
                            <b:EventTrigger EventName="MouseUp">
                                <ls:LSPlaySound Sound="{Binding AssetName, StringFormat='UI_HUD_MainMenu_{0}_Selected'}"/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>

                        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" ClipToBounds="True" Margin="0,80,0,0">
                            <Image x:Name="DifficultyImage" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform/>
                                </Image.RenderTransform>
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource IconIdToSourceConverter}">
                                        <Binding Source="Assets/DMSettings/"/>
                                        <Binding Path="AssetName"/>
                                        <Binding Source="_bg_d"/>
                                    </MultiBinding>
                                </Image.Source>
                                <Image.Effect>
                                    <ls:SaturationEffect Saturation="0"/>
                                </Image.Effect>
                            </Image>

                            <Image x:Name="DifficultyImageHover" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform/>
                                </Image.RenderTransform>
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource IconIdToSourceConverter}">
                                        <Binding Source="Assets/DMSettings/"/>
                                        <Binding Path="AssetName"/>
                                        <Binding Source="_bg_h"/>
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </Grid>

                        <Image Source="{StaticResource BackgroundBanner}" Stretch="None" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                        <Image x:Name="SelectorImage" Source="{StaticResource SelectorInactive}" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,52,0,0" Opacity="0.2"/>

                        <TextBlock x:Name="Title" 
                                   Text="{Binding Title.Str}" 
                                   HorizontalAlignment="Center" 
                                   FontSize="{StaticResource ScaledHugeFontSize}" 
                                   Foreground="{StaticResource LS_accent75TxtColor}" 
                                   FontWeight="DemiBold"
                                   VerticalAlignment="Top"
                                   Margin="0,1360,0,0"/>

                        <TextBlock x:Name="Description" 
                                   Text="{Binding Description.Str}" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Top" 
                                   Margin="0,1460,0,0" 
                                   FontSize="{StaticResource ScaledIntermediateFontSize}" 
                                   Foreground="{StaticResource LS_baseTxtColor}" 
                                   FontStyle="Italic" 
                                   TextWrapping="Wrap" 
                                   FontWeight="DemiBold" 
                                   TextAlignment="Center"
                                   Width="700"/>

                        <StackPanel x:Name="HB_HonouredMythInfoButtons" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                    Visibility="Collapsed" Margin="0,0,0,114">
                            <StackPanel.LayoutTransform>
                                <ScaleTransform ScaleX="0.80" ScaleY="0.80"/>
                            </StackPanel.LayoutTransform>
                            <ls:LSButton x:Name="MoreInfoButton"
                                         Command="{Binding DataContext.CustomEvent, ElementName=DMSettings, Mode=OneTime}"
                                         CommandParameter="OpenMoreInfo"
                                         Style="{StaticResource SmallRedButtonStyle}"
                                         Content="{Binding Source='h46c00fa7gbb38g480fg9a0fgb4232bec8658', Converter={StaticResource TranslatedStringConverter}}"
                                         Width="420" MinWidth="0" Padding="18,0" Margin="0,0,24,0"/>
                            
                            <ls:LSButton x:Name="HB_HonouredMythCustomInfoButton"
                                         Command="{Binding DataContext.CustomEvent, ElementName=DMSettings, Mode=OneTime}"
                                         CommandParameter="HB_OpenHonouredMythCustomInfo"
                                         Style="{StaticResource SmallRedButtonStyle}"
                                         Content="{Binding Source='h6f72b6bdg1e53g4d1cgad09gd69298171330', Converter={StaticResource TranslatedStringConverter}}" Width="420" MinWidth="0" Padding="18,0"/>
                        </StackPanel>

                        <!-- Deific gets independently-instantiated controls. Setting CommandParameter
                             directly is essential: a DataTemplate trigger cannot override
                             a local CommandParameter on the shared Heroic buttons. -->
                        <StackPanel x:Name="HB_DeificInfoButtons" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                    Visibility="Collapsed" Margin="0,0,0,114">
                            <StackPanel.LayoutTransform>
                                <ScaleTransform ScaleX="0.80" ScaleY="0.80"/>
                            </StackPanel.LayoutTransform>
                            <ls:LSButton x:Name="HB_DeificHallInfoButton"
                                         Command="{Binding DataContext.CustomEvent, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                         CommandParameter="HB_OpenDeificHallInfo"
                                         Style="{StaticResource SmallRedButtonStyle}"
                                         Content="{Binding Source='ha7b56d19gf9e2g5af1gad0egf886932db2fc', Converter={StaticResource TranslatedStringConverter}}"
                                         Width="420" MinWidth="0" Padding="18,0" Margin="0,0,24,0"/>
                            <ls:LSButton x:Name="HB_DeificCustomInfoButton"
                                         Command="{Binding DataContext.CustomEvent, RelativeSource={RelativeSource AncestorType={x:Type ls:UIWidget}}}"
                                         CommandParameter="HB_OpenDeificCustomInfo"
                                         Style="{StaticResource SmallRedButtonStyle}"
                                         Content="{Binding Source='h1f7c76e4g9432g52d3gb970g48a1bcb00a9e', Converter={StaticResource TranslatedStringConverter}}"
                                         Width="420" MinWidth="0" Padding="18,0"/>
                        </StackPanel>

                        <ls:LSButton x:Name="MythicInfoButton"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Bottom"
                                     Visibility="Collapsed"
                                     Command="{Binding DataContext.CustomEvent, ElementName=DMSettings, Mode=OneTime}"
                                     CommandParameter="HB_OpenMythicMechanicsInfo"
                                     Style="{StaticResource SmallRedButtonStyle}"
                                     Content="{Binding Source='h8120eae4g4931g40ecgb253g63f8279401dc', Converter={StaticResource TranslatedStringConverter}}"
                                     Margin="0,0,0,106"/>
                    </Grid>

                    <DataTemplate.Triggers>

                        
                        <!-- Heroic and Deific have separate button instances and click routes. -->
                        <DataTrigger Binding="{Binding AssetName}" Value="difficulty_05">
                            <Setter TargetName="HB_HonouredMythInfoButtons" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding AssetName}" Value="difficulty_07">
                            <Setter TargetName="HB_DeificInfoButtons" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        
                        <DataTrigger Binding="{Binding AssetName}" Value="difficulty_06">
                            <Setter TargetName="MythicInfoButton" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SelectorImage" Property="Opacity" Value="0.4"/>
                            <Setter TargetName="Title" Property="Foreground" Value="{StaticResource LS_tint100}"/>
                            <Setter TargetName="Description" Property="Foreground" Value="{StaticResource LS_accent75TxtColor}"/>
                        </Trigger>

                        <!-- Any difficulty animation (in selection) -->
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Mode=TemplatedParent}}" Value="True">
                            <Setter TargetName="SelectorImage" Property="Source" Value="pack://application:,,,/Core;component/Assets/DMSettings/selector_active.png"/>
                            <Setter TargetName="SelectorImage" Property="Margin" Value="0,36,0,0"/>
                            <Setter TargetName="SelectorImage" Property="Opacity" Value="1"/>
                            <Setter TargetName="Title" Property="Foreground" Value="{StaticResource LS_tint100}"/>
                            <Setter TargetName="Description" Property="Foreground" Value="{StaticResource LS_accent75TxtColor}"/>

                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="ImageHover" Storyboard="{StaticResource NewGameCard.ImageHover}"/>
                                <StopStoryboard BeginStoryboardName="ImageDefault"/>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard x:Name="ImageDefault" Storyboard="{StaticResource NewGameCard.ImageDefault}"/>
                                <StopStoryboard BeginStoryboardName="ImageHover"/>
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, ElementName=HB_CustomViewMode}" Value="True"/>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Mode=TemplatedParent}}" Value="False"/>
                            </MultiDataTrigger.Conditions>

                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="DifficultyFadeOut">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                                <StopStoryboard BeginStoryboardName="DifficultyFadeIn"/>
                            </MultiDataTrigger.EnterActions>

                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard x:Name="DifficultyFadeIn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                                <StopStoryboard BeginStoryboardName="DifficultyFadeOut"/>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                    </DataTemplate.Triggers>
                </DataTemplate>

                <DataTemplate x:Key="CarouselButtonDataTemplate" DataType="{x:Type ls:LSButton}">
                    <DataTemplate.Resources>
                        <BitmapImage x:Key="DefaultButtonImage" UriSource="pack://application:,,,/Core;component/Assets/CharacterCreation/input_arrow_d.png"/>
                    </DataTemplate.Resources>

                    <Image x:Name="img" Stretch="None" Source="{StaticResource DefaultButtonImage}"/>

                    <DataTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="img" Property="Source" Value="pack://application:,,,/Core;component/Assets/CharacterCreation/input_arrow_h.png"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="img" Property="Opacity" Value="{StaticResource DisabledOpacity}"/>
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ControlTemplate.Resources>


            <Grid x:Name="HB_SettingsRoot">
            <Grid x:Name="GridRoot" Background="{StaticResource LS_PopUpBackgroundColor}">
                

                <ls:LSToggleButton x:Name="HB_CustomViewMode" Width="0" Height="0"
                                   Visibility="Collapsed" IsHitTestVisible="False" Focusable="False">
                        <ls:LSToggleButton.Style>
                            <Style TargetType="ls:LSToggleButton">
                                <Setter Property="IsChecked" Value="{Binding IsInCustomMode, Mode=OneWay}"/>
                            </Style>
                        </ls:LSToggleButton.Style>
                    </ls:LSToggleButton>
                <ls:LSToggleButton x:Name="HB_CustomOnlyView" Width="0" Height="0"
                                   Visibility="Collapsed" IsHitTestVisible="False" Focusable="False">
                        <ls:LSToggleButton.Style>
                            <Style TargetType="ls:LSToggleButton">
                                <Setter Property="IsChecked" Value="{Binding CanOnlyChangeCustomMode, Mode=OneWay}"/>
                            </Style>
                        </ls:LSToggleButton.Style>
                    </ls:LSToggleButton>
                <Control x:Name="HB_DifficultyBrowserHost" DataContext="{x:Null}"
                         Width="0" Height="0" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False">
                    <Control.Style>
                        <Style TargetType="Control">
                            <Setter Property="Tag" Value="{x:Null}"/>
                        </Style>
                    </Control.Style>
                </Control>
                <!-- Native-XAML visibility gate. The underlying native cards are never
                     painted in-game before the complete HomeBrew collection is attached. -->
                <Control x:Name="HB_NativeDifficultyFallback" Tag="Waiting"
                         Width="0" Height="0" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False"/>
                <Control x:Name="HB_SingleSaveHost" DataContext="{x:Null}"
                         Width="0" Height="0" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False"/>
                <b:Interaction.Behaviors>
                    <ls:RuleSetModifierValueBehavior x:Name="HB_SettingsIronmanModifier" Modifiers="{Binding Data.CurrentRuleSetModifiers}" ModifierName="IRONMAN_MODE"/>
                </b:Interaction.Behaviors>
                <Grid.RowDefinitions>
                    <RowDefinition Height="{StaticResource PageHeaderHeight}"/>
                    <RowDefinition/>
                    <RowDefinition Height="{StaticResource PageFooterHeight}"/>
                </Grid.RowDefinitions>

                <b:Interaction.Triggers>
                    <b:PropertyChangedTrigger Binding="{Binding SelectedItem, ElementName=PresetList}">
                        <b:InvokeCommandAction Command="{Binding DataContext.HB_SelectSingleSave, ElementName=HB_SingleSaveHost}"
                                               CommandParameter="{Binding SelectedItem, ElementName=PresetList}"/>
                        <b:InvokeCommandAction Command="{Binding DataContext.HB_SelectionChanged, ElementName=HB_DifficultyBrowserHost}"
                                               CommandParameter="{Binding SelectedItem, ElementName=PresetList}"/>
                    </b:PropertyChangedTrigger>
                    <b:DataTrigger Binding="{Binding IsChecked, ElementName=HB_CustomViewMode}" Value="False">
                        <b:Interaction.Behaviors>
                            <b:ConditionBehavior><b:ConditionalExpression>
                                <b:ComparisonCondition LeftOperand="{Binding DataContext.HB_Ready, ElementName=HB_DifficultyBrowserHost, FallbackValue=False}" Operator="Equal" RightOperand="True"/>
                            </b:ConditionalExpression></b:ConditionBehavior>
                        </b:Interaction.Behaviors>
                        <b:ChangePropertyAction TargetName="carouselClipper" PropertyName="Margin" Value="0,0,0,-100"/>
                    </b:DataTrigger>
                    <b:DataTrigger Binding="{Binding DataContext.HB_Ready, ElementName=HB_DifficultyBrowserHost, FallbackValue=False}" Value="True">
                        <b:Interaction.Behaviors>
                            <b:ConditionBehavior><b:ConditionalExpression>
                                <b:ComparisonCondition LeftOperand="{Binding IsChecked, ElementName=HB_CustomViewMode}" Operator="Equal" RightOperand="False"/>
                            </b:ConditionalExpression></b:ConditionBehavior>
                        </b:Interaction.Behaviors>
                        <b:ChangePropertyAction TargetName="carouselClipper" PropertyName="Margin" Value="0,0,0,-100"/>
                    </b:DataTrigger>
                    <b:EventTrigger EventName="Loaded">
                        <ls:LSPlaySound Sound="UI_HUD_NewGameSettings_Open"/>
                    </b:EventTrigger>

                    <b:DataTrigger Binding="{Binding IsChecked, ElementName=HB_CustomOnlyView}" Value="True">
                        <b:ChangePropertyAction TargetName="PresetList" PropertyName="SelectedIndex" Value="{Binding Items.Count, ElementName=PresetList, Converter={StaticResource AddConverter}, ConverterParameter=-1}"/>
                        <b:ChangePropertyAction TargetName="carouselClipper" PropertyName="Margin" Value="{StaticResource WidescreenMarginCustom}"/>
                        <b:ChangePropertyAction TargetName="CustomSettingsHolder" PropertyName="Opacity" Value="1"/>
                    </b:DataTrigger>

                    <b:DataTrigger Binding="{Binding IsChecked, ElementName=HB_CustomOnlyView}" Value="True">
                        <b:Interaction.Behaviors>
                            <b:ConditionBehavior>
                                <b:ConditionalExpression>
                                    <b:ComparisonCondition LeftOperand="{Binding Data.AspectRatio}" Operator="GreaterThanOrEqual" RightOperand="0.625"/>
                                </b:ConditionalExpression>
                            </b:ConditionBehavior>
                        </b:Interaction.Behaviors>
                        <b:ChangePropertyAction TargetName="carouselClipper" PropertyName="Margin" Value="{StaticResource LetterboxMarginCustom}"/>
                    </b:DataTrigger>

                    <b:DataTrigger Binding="{Binding IsChecked, ElementName=HB_CustomOnlyView}" Value="True">
                        <b:Interaction.Behaviors>
                            <b:ConditionBehavior>
                                <b:ConditionalExpression>
                                    <b:ComparisonCondition LeftOperand="{Binding Data.AspectRatio}" Operator="GreaterThanOrEqual" RightOperand="0.75"/>
                                </b:ConditionalExpression>
                            </b:ConditionBehavior>
                        </b:Interaction.Behaviors>
                        <b:ChangePropertyAction TargetName="carouselClipper" PropertyName="Margin" Value="{StaticResource FullscreenMarginCustom}"/>
                    </b:DataTrigger>
                </b:Interaction.Triggers>

                <ls:LSNineSliceImage Grid.Row="0" Grid.RowSpan="3" x:Name="CurrentGameBackground" ImageSource="{StaticResource BackgroundFade}" Slices="0" IconWidth="3740" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"/>
                <Image Grid.Row="0" Grid.RowSpan="3" Source="{StaticResource FadeFooterImage}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Stretch="None"/>

                <Control Grid.Row="0" x:Name="TitleText" Template="{StaticResource PageHeader}" Tag="{Binding Source='h57a5735eg7213g4c3cg914cgbd1b5af276cc', Converter={StaticResource TranslatedStringConverter}}"/>

                <Grid Grid.Row="0" x:Name="CarouselHeader" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                    <Image Source="{StaticResource BackgroundCarouselHeader}" Stretch="None"/>
                    <ls:LSButton x:Name="PreviousDifficultyButton"
                                 ContentTemplate="{StaticResource CarouselButtonDataTemplate}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Margin="48,0,0,0"
                                 BoundEvent="UILeft">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="LSButtonPressed">
                                <b:ChangePropertyAction TargetName="PresetList" PropertyName="SelectedIndex" Value="{Binding SelectedIndex, ElementName=PresetList, Converter={StaticResource AddConverter}, ConverterParameter=-1}"/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                        <ls:LSButton.IsEnabled>
                            <Binding Path="SelectedIndex" ElementName="PresetList" Converter="{StaticResource GreaterThanConverter}" ConverterParameter="0"/>
                        </ls:LSButton.IsEnabled>
                    </ls:LSButton>
                    <TextBlock Text="{Binding SelectedItem.Title.Str, ElementName=PresetList}"  HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource ScaledDefaultFontSize}" Foreground="{StaticResource LS_tint100}" FontWeight="DemiBold"/>
                    <ls:LSButton x:Name="NextDifficultyButton"
                                 ContentTemplate="{StaticResource CarouselButtonDataTemplate}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 Margin="0,0,48,0"
                                 BoundEvent="UIRight"
                                 RenderTransformOrigin="0.5, 0.5">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="LSButtonPressed">
                                <b:ChangePropertyAction TargetName="PresetList" PropertyName="SelectedIndex" Value="{Binding SelectedIndex, ElementName=PresetList, Converter={StaticResource AddConverter}, ConverterParameter=1}"/>
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                        <ls:LSButton.RenderTransform>
                            <ScaleTransform ScaleX="-1"/>
                        </ls:LSButton.RenderTransform>
                        <ls:LSButton.IsEnabled>
                            <MultiBinding Converter="{StaticResource LessThanOrEqualMultiConverter}">
                                <Binding Path="SelectedIndex" ElementName="PresetList"/>
                                <!-- -2 because the count is 1 higher, and another one due to the "equal" part -->
                                <Binding Path="Items.Count" ElementName="PresetList" Converter="{StaticResource AddConverter}" ConverterParameter="-2"/>
                            </MultiBinding>
                        </ls:LSButton.IsEnabled>
                    </ls:LSButton>
                </Grid>

                <Grid Grid.Row="1" x:Name="carouselClipper" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,-100" Width="3840">
                    <Grid.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <LinearGradientBrush.GradientStops>
                                <GradientStop Offset="0" Color="Transparent"/>
                                <GradientStop Offset="0.05" Color="White"/>
                                <GradientStop Offset="0.95" Color="White"/>
                                <GradientStop Offset="1" Color="Transparent"/>
                            </LinearGradientBrush.GradientStops>
                        </LinearGradientBrush>
                    </Grid.OpacityMask>
                    <ListBox x:Name="PresetList" 
                             ItemTemplate="{StaticResource RulesetDataTemplate}">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                <Setter Property="ItemsSource" Value="{Binding Presets}"/>
                                <Setter Property="SelectedIndex" Value="{Binding PresetSelectedIndex, Mode=TwoWay}"/>
                            </Style>
                        </ListBox.Style>
                        <b:Interaction.Behaviors>
                            <ls:SelectedIndexScrollBehavior ScrollThreshold="2"/>
                        </b:Interaction.Behaviors>
                            <ListBox.Resources>
                            <System:Double x:Key="IndexSizeModifier">980</System:Double>
                            <System:Double x:Key="LeftMarginSize">0</System:Double>
                        </ListBox.Resources>
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ls:LSScrollViewer x:Name="DifficultyScrollList" 
                                                   HorizontalScrollBarVisibility="Hidden" 
                                                   VerticalScrollBarVisibility="Disabled" 
                                                   CanContentScroll="False" 
                                                   HorizontalScrollOffset="{Binding SelectedIndex, ElementName=PresetList, Converter={StaticResource MultiplierConverter}, ConverterParameter={StaticResource IndexSizeModifier}}">
                                    <ItemsPresenter Margin="1430,0"/>

                                    <b:Interaction.Triggers>
                                        <!-- Animate sideways to selected item unless it starts in custom mode (from Lobby) -->
                                        <b:PropertyChangedTrigger Binding="{Binding Path=SelectedItem, ElementName=PresetList}">
                                            <b:Interaction.Behaviors>
                                                <b:ConditionBehavior>
                                                    <b:ConditionalExpression>
                                                        <b:ComparisonCondition LeftOperand="{Binding Metadata, ElementName=DMSettings}" Operator="NotEqual" RightOperand="Lobby"/>
                                                    </b:ConditionalExpression>
                                                </b:ConditionBehavior>
                                            </b:Interaction.Behaviors>
                                            <b:ControlStoryboardAction ControlStoryboardOption="Play">
                                                <b:ControlStoryboardAction.Storyboard>
                                                    <!-- Not using FillBehavior="Stop" to keep scrolling working when clicking on the difficulty cards themselves -->
                                                    <Storyboard TargetName="DifficultyScrollList" TargetProperty="(ls:LSScrollViewer.HorizontalScrollOffset)">
                                                        <DoubleAnimation Duration="0:0:0.2" AccelerationRatio="0.25" DecelerationRatio="0.25">
                                                            <DoubleAnimation.To>
                                                                <MultiBinding Converter="{StaticResource AddMultipleConverter}">
                                                                    <Binding ElementName="PresetList" Path="SelectedIndex" Converter="{StaticResource MultiplierConverter}" ConverterParameter="{StaticResource IndexSizeModifier}"/>
                                                                    <Binding Source="{StaticResource LeftMarginSize}"/>
                                                                </MultiBinding>
                                                            </DoubleAnimation.To>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </b:ControlStoryboardAction.Storyboard>
                                            </b:ControlStoryboardAction>
                                        </b:PropertyChangedTrigger>
                                    </b:Interaction.Triggers>
                                </ls:LSScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel x:Name="itemsPanel" IsItemsHost="True" Orientation="Horizontal" Background="Transparent"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Margin" Value="-8,0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>

                <Control Grid.Row="1" x:Name="CustomSettingsHolder" VerticalAlignment="Center" Opacity="0"/>

                <TextBlock Grid.Row="2" x:Name="HB_DifficultyUnavailableNotice" Visibility="Collapsed"
                           Text="{Binding SelectedItem.HB_UnavailableText, ElementName=PresetList}"
                           HorizontalAlignment="Center" Margin="0,-40,0,40"
                           Foreground="{StaticResource LS_accent100TxtColor}" FontSize="{StaticResource ScaledDefaultFontSize}"
                           TextWrapping="Wrap" MaxWidth="1800" IsHitTestVisible="False"/>

                <TextBlock Grid.Row="2" x:Name="HB_CustomDifficultyNotice" Visibility="Collapsed"
                           Text="Changing to a Custom difficulty is permanent. You cannot return to a preset difficulty once confirmed."
                           HorizontalAlignment="Center" Margin="0,-40,0,40"
                           Foreground="{StaticResource LS_accent100TxtColor}" FontSize="{StaticResource ScaledDefaultFontSize}"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1800" IsHitTestVisible="False"/>

                <TextBlock Grid.Row="2" x:Name="HB_SingleSaveDifficultyNotice" Visibility="Collapsed"
                           Text="Difficulty is locked while Honour Mode is enabled."
                           HorizontalAlignment="Center" Margin="0,-40,0,40"
