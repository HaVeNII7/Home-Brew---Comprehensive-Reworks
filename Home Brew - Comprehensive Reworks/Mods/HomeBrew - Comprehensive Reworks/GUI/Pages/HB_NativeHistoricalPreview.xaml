<ls:UIWidget x:Name="HB_NativeHistoricalPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ls="clr-namespace:ls;assembly=Code"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    ls:UIWidget.UseCustomDC="True" ls:UIWidget.ContextName="HB_NativeHistoricalPreview">
  <ls:UIWidget.Template>
    <ControlTemplate TargetType="ls:UIWidget">
      <Grid>
        <Grid.Resources>
          <!-- Built from BG3's actual Options screen slider assets/template
               (sliderBox_wide, input_arrow, hudNav and scrubber). -->
          <ControlTemplate x:Key="HB_HistorySliderArrow" TargetType="ls:LSRepeatButton">
            <Grid>
              <Ellipse Fill="Transparent" Width="60" Height="60"/>
              <Image x:Name="arrowIcon" Stretch="None" Source="pack://application:,,,/Core;component/Assets/CharacterCreation/input_arrow_d.png"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="arrowIcon" Property="Source" Value="pack://application:,,,/Core;component/Assets/CharacterCreation/input_arrow_h.png"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="arrowIcon" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
          <Style x:Key="HB_HistorySliderThumb" TargetType="ls:LSThumb">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="SoundID" Value="UI_HUD_Shared_Slider_Thumb"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                  <Grid>
                    <Image x:Name="thumbFrame" Source="pack://application:,,,/Core;component/Assets/Buttons/btn_hudNav_d.png" Stretch="None"/>
                    <Image x:Name="thumbIcon" Source="pack://application:,,,/Core;component/Assets/Options/ico_scrubber_d.png" Stretch="None"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="thumbFrame" Property="Source" Value="pack://application:,,,/Core;component/Assets/Buttons/btn_hudNav_h.png"/>
                      <Setter TargetName="thumbIcon" Property="Source" Value="pack://application:,,,/Core;component/Assets/Options/ico_scrubber_h.png"/>
                    </Trigger>
                    <Trigger Property="IsDragging" Value="True">
                      <Setter TargetName="thumbFrame" Property="Source" Value="pack://application:,,,/Core;component/Assets/Buttons/btn_hudNav_p.png"/>
                      <Setter TargetName="thumbIcon" Property="Source" Value="pack://application:,,,/Core;component/Assets/Options/ico_scrubber_h.png"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <ControlTemplate x:Key="HB_HistoryOptionsSlider" TargetType="Slider">
            <Grid HorizontalAlignment="Center">
              <!-- Native Options slider background is 868px wide and has 106px
                   cap slices: at this smaller HUD width its caps overlap.
                   One rounded track prevents the double-oval end artifact. -->
              <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                  Width="{TemplateBinding Width}" Height="44" CornerRadius="22"
                  Background="#F0120D08" BorderBrush="#A77B49" BorderThickness="2"/>
              <ls:LSRepeatButton x:Name="PART_DecreaseRepeatButton" HorizontalAlignment="Left"
                  Template="{StaticResource HB_HistorySliderArrow}"
                  SoundID="UI_HUD_Shared_Slider_LeftButton" Command="Slider.DecreaseLarge"/>
              <ls:LSRepeatButton x:Name="PART_IncreaseRepeatButton" HorizontalAlignment="Right"
                  Template="{StaticResource HB_HistorySliderArrow}"
                  SoundID="UI_HUD_Shared_Slider_RightButton" Command="Slider.IncreaseLarge" RenderTransformOrigin="0.5,0.5">
                <ls:LSRepeatButton.RenderTransform><ScaleTransform ScaleX="-1"/></ls:LSRepeatButton.RenderTransform>
              </ls:LSRepeatButton>
              <Track x:Name="PART_Track" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                  Margin="82,0" Height="{TemplateBinding Height}">
                <Track.DecreaseRepeatButton>
                  <ls:LSRepeatButton Command="Slider.DecreaseLarge" Opacity="0"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb><ls:LSThumb Style="{StaticResource HB_HistorySliderThumb}"/></Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <ls:LSRepeatButton Command="Slider.IncreaseLarge" Opacity="0"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Grid.Resources>
        <Grid Visibility="Collapsed">
        <!-- Occupies the original character progression pane; the game's
             native selection ViewModel and Confirm button are untouched. -->
        <Border Background="#F014110E" BorderBrush="#9D7550" BorderThickness="2"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Width="1030" Margin="400,130,0,0" Padding="24,18,24,20">
          <StackPanel>
            <TextBlock Text="HISTORICAL CHARACTER BUILD" HorizontalAlignment="Center" TextAlignment="Center"
                FontSize="{StaticResource SmallFontSize}" Foreground="{StaticResource LS_accent100TxtColor}" Margin="0,0,0,9"/>
            <TextBlock Text="{Binding HB_NativeTitle}" HorizontalAlignment="Center"
                FontSize="{StaticResource ScaledMediumFontSize}" Foreground="{StaticResource LS_tint100}" Margin="0,0,0,8"/>
            <ls:LSSlider Minimum="1" Maximum="{Binding HB_NativeMaxLevel}"
                Value="{Binding HB_NativeSelectedLevel, Mode=TwoWay}"
                SmallChange="1" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="True"
                Width="885" Margin="0,0,0,17" HorizontalAlignment="Center">
              <ls:LSSlider.Style>
                <Style TargetType="ls:LSSlider" BasedOn="{StaticResource Slider.StyleDisplayValue}">
                  <Setter Property="IsEnabled" Value="True"/>
                </Style>
              </ls:LSSlider.Style>
              <b:Interaction.Triggers>
                <b:EventTrigger EventName="ValueChanged">
                  <b:InvokeCommandAction Command="{Binding HB_NativeSliderChanged}"/>
                </b:EventTrigger>
              </b:Interaction.Triggers>
            </ls:LSSlider>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
              <ls:LSButton Content="Open Historical Editor" Command="{Binding HB_NativeHistoricalStart}"
                  Style="{StaticResource BlueButtonStyle}" Margin="-4,0"/>
            </StackPanel>
            <TextBlock Text="{Binding HB_NativeHostTestReport}" HorizontalAlignment="Center"
                TextWrapping="Wrap" FontSize="{StaticResource SmallFontSize}"
                Foreground="{StaticResource LS_accent100TxtColor}" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding HB_NativePanelTitle}" HorizontalAlignment="Center" TextAlignment="Center"
                FontSize="{StaticResource ScaledMediumFontSize}" Foreground="{StaticResource LS_tint100}"
                Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,9">
              <ls:LSButton Content="◀" Command="{Binding HB_PassiveGroupPrevious}"
                  IsEnabled="{Binding HB_PassiveCanPrevious}"
                  Style="{StaticResource BrownButtonStyle}" MinWidth="70" Margin="-4,0"/>
              <TextBlock Text="{Binding HB_PassiveGroupName}" Width="755" VerticalAlignment="Center"
                  TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource LS_extraspecialTxtColor}"
                  FontSize="{StaticResource ScaledDefaultFontSize}"/>
              <ls:LSButton Content="▶" Command="{Binding HB_PassiveGroupNext}"
                  IsEnabled="{Binding HB_PassiveCanNext}"
                  Style="{StaticResource BrownButtonStyle}" MinWidth="70" Margin="-4,0"/>
            </StackPanel>
            <TextBlock Text="{Binding HB_PassiveGuide}" TextAlignment="Center" TextWrapping="Wrap"
                FontSize="{StaticResource ScaledDefaultFontSize}"
                Foreground="{StaticResource LS_accent100TxtColor}" Margin="8,0,8,12"/>
            <ListBox x:Name="HB_HistoricalChoices" ItemsSource="{Binding HB_PassiveRows}"
                SelectedIndex="{Binding HB_PassiveSelectedIndex, Mode=TwoWay}"
                Height="995" BorderThickness="0" Background="#C314100C"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#47361F" BorderThickness="0,0,0,1" Padding="8,9">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Mark}" Width="50" FontSize="{StaticResource ScaledDefaultFontSize}"
                          Foreground="{StaticResource LS_extraspecialTxtColor}"/>
                      <TextBlock Text="{Binding Name}" Width="585" FontSize="{StaticResource ScaledDefaultFontSize}"
                          Foreground="{StaticResource LS_tint100}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Detail}" Width="260" FontSize="{StaticResource SmallFontSize}"
                          Foreground="{StaticResource LS_accent100TxtColor}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
              <b:Interaction.Triggers>
                <b:EventTrigger EventName="SelectionChanged">
                  <b:InvokeCommandAction Command="{Binding HB_PassiveChoiceClicked}"/>
                </b:EventTrigger>
              </b:Interaction.Triggers>
            </ListBox>
            <TextBlock Text="{Binding HB_PassiveFeedback}" HorizontalAlignment="Center" TextAlignment="Center"
                TextWrapping="Wrap" FontSize="{StaticResource ScaledDefaultFontSize}"
                Foreground="{StaticResource LS_extraspecialTxtColor}" Margin="8,15,8,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,4">
              <ls:LSButton Content="Choose Highlighted" Command="{Binding HB_PassiveChooseSelected}"
                  Style="{StaticResource BrownButtonStyle}" Margin="-5,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
              <ls:LSButton Content="Review Changes" Command="{Binding HB_NativeEdit}"
                  Style="{StaticResource BlueButtonStyle}" SoundID="UI_Shared_Accept" Margin="-5,0"/>
              <ls:LSButton Content="Back" Command="{Binding HB_NativeBack}"
                  Style="{StaticResource BrownButtonStyle}" SoundID="UI_Shared_Accept" Margin="-5,0"/>
            </StackPanel>
          </StackPanel>
        </Border>
        </Grid>
        <!-- The only custom historical control. Put it beneath the always-present
             native left selection pane instead of above BG3's Confirm/pending
             banner. Leave the native Confirm and Choices Pending UI untouched. -->
        <StackPanel Visibility="{Binding HB_NativeHostTestActive, Converter={StaticResource BoolToVisibleConverter}, FallbackValue=Collapsed}"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
            Width="940">
          <!-- Shift farther under the native left pane; a wider scrubber
               makes twelve-plus historical levels easier to navigate. -->
          <StackPanel.RenderTransform><TranslateTransform X="-955"/></StackPanel.RenderTransform>
          <Slider x:Name="HB_LiveHistoricalSlider" Minimum="1" Maximum="{Binding HB_NativeMaxLevel}"
              Visibility="{Binding HB_NativeNormalLevelLabelVisible, Converter={StaticResource BoolToVisibleConverter}, FallbackValue=Visible}"
              IsEnabled="{Binding HB_NativeSliderEnabled, FallbackValue=True}"
              Value="{Binding HB_NativeSelectedLevel, Mode=TwoWay}"
              SmallChange="1" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="True"
              Width="900" HorizontalAlignment="Center"
              Template="{StaticResource HB_HistoryOptionsSlider}">
            <b:Interaction.Triggers><b:EventTrigger EventName="ValueChanged">
              <b:InvokeCommandAction Command="{Binding HB_NativeSliderChanged}"/>
            </b:EventTrigger></b:Interaction.Triggers>
          </Slider>
          <!-- Level count belongs underneath the slider, clear of the
               native selection pane and Choices Pending banner. -->
          <!-- Separate boxes avoid a Noesis Border.Style width trigger that
               clipped the warning at both ends in the native UI. -->
          <Border Width="365" Height="44" HorizontalAlignment="Center"
              Visibility="{Binding HB_NativeNormalLevelLabelVisible, Converter={StaticResource BoolToVisibleConverter}, FallbackValue=Visible}"
              Background="#EC211810" BorderBrush="#B48A58" BorderThickness="1"
              CornerRadius="6" Margin="0,4,0,0" Padding="12,2">
            <TextBlock Text="{Binding HB_NativeTitle}" HorizontalAlignment="Center"
                VerticalAlignment="Center" TextAlignment="Center"
                Foreground="{StaticResource LS_tint100}"
                FontSize="{StaticResource ScaledDefaultFontSize}"/>
          </Border>
          <Border Width="860" Height="76" HorizontalAlignment="Center"
              Visibility="{Binding HB_NativeFullRespecChanged, Converter={StaticResource BoolToVisibleConverter}, FallbackValue=Collapsed}"
              Background="#EC211810" BorderBrush="#B48A58" BorderThickness="1"
              CornerRadius="6" Margin="0,4,0,0" Padding="16,3">
            <TextBlock Text="Class/Subclass Changed - Switching to Full Respec"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                TextAlignment="Center" TextWrapping="Wrap"
                Foreground="{StaticResource LS_tint100}"
                FontSize="{StaticResource ScaledDefaultFontSize}"/>
          </Border>
          <!-- Operational errors from failed commits are still exposed, but
               intentionally incomplete passive slots disable native Confirm. -->
          <TextBlock Visibility="{Binding HB_NativeCommitErrorVisible, Converter={StaticResource BoolToVisibleConverter}, FallbackValue=Collapsed}"
              Text="{Binding HB_NativeCommitError}" TextWrapping="Wrap" TextAlignment="Center"
              FontSize="{StaticResource SmallFontSize}" Foreground="{StaticResource LS_alertTxtColor}" Margin="0,3,0,0"/>
        </StackPanel>
        <!-- BG3 level one is owned by the original C++ CharacterCreation VM,
             whose IsCharacterComplete is read-only. Unlike levels 2+, its
             native Confirm cannot observe HomeBrew's displaced history.
             While a later spell slot is empty, visibly signal that state
             and intercept clicks over the vanilla Confirm region. Keep this
             limited to the uncommitted Choice Respec L1 page; never affect
             normal respecs, class-changing Full Respec or other screens. -->
        <!-- Warning and genuine clickable shield occupy *the same area* over
             BG3's Confirm, not the far-right empty margin. Horizontal offset
             measured from live BG3 screen: UI transform units are twice the
             screenshot pixels at the captured HUD scale. Reduced height
             places the warning directly at the native button's elevation. -->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Width="530" Height="132" Margin="0,0,0,0" IsHitTestVisible="True"
            Visibility="{Binding HB_NativeLevelOneChoicesPending, Converter={StaticResource BoolToVisibleConverter}, FallbackValue=Collapsed}">
          <Grid.RenderTransform><TranslateTransform X="-1170"/></Grid.RenderTransform>
          <!-- A real enabled command control swallows mouse/controller clicks.
               IsEnabled=false would permit platform hit testing to fall through
               to the native FinishCreating button. No gameplay action runs. -->
          <ls:LSButton x:Name="HB_LevelOneConfirmBlocker"
              Command="{Binding HB_NativePendingConfirmBlock}" IsEnabled="True"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Focusable="False" IsHitTestVisible="True">
            <ls:LSButton.Template>
              <ControlTemplate TargetType="ls:LSButton">
                <Border Background="#18000000"/>
              </ControlTemplate>
            </ls:LSButton.Template>
          </ls:LSButton>
          <!-- Visuals never consume pointer hits; the LSButton underneath
               receives every click across the covered Confirm region. -->
          <Border HorizontalAlignment="Center" VerticalAlignment="Top"
              Width="500" Height="72" CornerRadius="9"
              IsHitTestVisible="False"
              BorderBrush="#DB6C52" BorderThickness="2"
              Background="#EE241017">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="!" Foreground="Red" FontSize="31"
                  VerticalAlignment="Center" Margin="0,0,12,0"/>
              <TextBlock Text="{Binding HB_NativeLevelOnePendingWarning}"
                  TextWrapping="Wrap" TextAlignment="Center" FontSize="24"
                  VerticalAlignment="Center" Foreground="#FF6D79"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </ControlTemplate>
  </ls:UIWidget.Template>
</ls:UIWidget>
